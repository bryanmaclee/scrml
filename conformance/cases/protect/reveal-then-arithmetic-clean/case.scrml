<program auth="none" db="app.db">
  <schema>
    ?{`CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, passwordHash TEXT, pin INTEGER)`}
  </schema>
  <db src="app.db" protect="passwordHash, pin" tables="users">
    ${
      function getUser(id) {
        let u = ?{`SELECT * FROM users WHERE id = ${id}`}.get()
        const r = u.reveal("pin")
        return r.pin * 3
      }
    }
  </db>
  <total> = 0
  <button id="load" onclick={ @total = getUser(1) !{ .Transport(t) :> { return } } }>load</button>
</program>
