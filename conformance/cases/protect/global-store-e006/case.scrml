<program auth="none" db="app.db">
  <schema>
    ?{`CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, passwordHash TEXT)`}
  </schema>
  <db src="app.db" protect="passwordHash" tables="users">
    ${
      function stash(id) {
        let u = ?{`SELECT * FROM users WHERE id = ${id}`}.get()
        process.env.LAST_HASH = u.passwordHash
        return 1
      }
      function peek() {
        let n = ?{`SELECT id FROM users WHERE id = 1`}.get()
        return process.env.LAST_HASH
      }
    }
  </db>
  <out> = not
  <button id="stash" onclick={ @out = stash(1) !{ .Transport(t) :> { return } } }>stash</button>
  <button id="peek" onclick={ @out = peek() !{ .Transport(t) :> { return } } }>peek</button>
</program>
