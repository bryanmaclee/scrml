<program auth="none" db="app.db">
  <schema>
    ?{`CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, passwordHash TEXT)`}
  </schema>
  <db src="app.db" protect="passwordHash" tables="users">
    ${
      function getUser(id) {
        const v = ?{`SELECT * FROM USERS WHERE id = ${id}`}.get()
        return v.passwordHash
      }
    }
  </db>
  <user> = not
  <button id="load" onclick={ @user = getUser(1) !{ .Transport(t) :> { return } } }>load</button>
</program>
