${
    <rows> = [{ id: 1, name: "Alice", on: true }, { id: 2, name: "Bob", on: true }]
    function hide(id: number) {
        @rows = @rows.map(r => {
            if (r.id == id) {
                return { ...r, on: false }
            }
            return r
        })
    }
}
<ul id="list">${
    for (let it of @rows) {
        lift <li class="row" data-id=it.id if=it.on><span class="nm">${it.name}</span></li>
    }
}</ul>
<button id="hide1" onclick=hide(1)>hide1</button>
