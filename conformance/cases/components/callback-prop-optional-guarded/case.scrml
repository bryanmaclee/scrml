<program>
<log> = ""
${ function h() { @log = @log + "h" } }
const C = <div class="c" props={ onGo?: () => void }>
    <button class="a" onclick=${() => onGo && onGo()}>a</button>
    <button class="b" onclick=${() => { if (onGo is some) { onGo() } }}>b</button>
    <button class="c2" onclick=${() => onGo ? onGo() : 0}>c</button>
    <button class="s" onclick=${ if (onGo) { onGo() } }>s</button>
</>
const D = <div class="d" props={ onGo?: () => void }>
    ${ function f() { if (onGo) { onGo() } } }
    <button class="f" onclick=f()>f</button>
</>
<div id="none"><C/></div>
<div id="some"><C onGo=${() => h()}/></div>
<div id="fn"><D onGo=${() => h()}/></div>
<p id="o">${@log}</p>
</program>
