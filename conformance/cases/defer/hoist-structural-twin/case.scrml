${
    <trace> = ""

    function add(s: string) {
        @trace = @trace + s + ";"
    }

    // No-defer twin of hoist-structural: each deferred call is written as the
    // last statement of its block instead.
    function destructObj() {
        let a = "OUTER"
        if (true) {
            const { a } = { a: "INNER" }
            function show() {
                return a
            }
            add(show())
            add("D1")
        }
    }

    function destructArr() {
        const [p, q] = [1, 2]
        add("sum" + sum())
        function sum() {
            return p + q
        }
        add("D2")
    }

    function shadowed() {
        add(helper())
        let kind = "tail"
        add(kind)
        function helper() {
            let kind = "local"
            let o = { kind: 1 }
            return kind + o.kind + "kind"
        }
        add("D3")
    }

    function go() {
        destructObj()
        destructArr()
        shadowed()
    }
}
<program>
    <button id="go" onclick=go()>Go</>
    <p id="out">${@trace}</p>
</program>
