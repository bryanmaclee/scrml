${
    type CloseError:enum = {
        Busy
    }

    <trace> = ""

    function closeAll()! -> CloseError {
        fail CloseError.Busy
    }

    function work() {
        defer closeAll() !{
            | ::Busy :> @trace = @trace + "close-failed;"
        }
        @trace = @trace + "work;"
    }
}
<program>
    <button id="go" onclick=work()>go</>
    <p id="out">${@trace}</p>
</program>
