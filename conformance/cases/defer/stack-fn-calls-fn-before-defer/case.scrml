${
    <trace> = ""
    <out> = ""

    function D(s: string) {
        @trace = @trace + s
    }

    function n2() {
        let r = first()
        defer D("e;")
        function first() {
            return second() + "1"
        }
        function second() {
            return "2"
        }
        return r
    }

    function go() {
        @out = n2()
    }
}
<program>
    <button id="go" onclick=go()>Go</>
    <p id="out">${@out}</p>
    <p id="trace">${@trace}</p>
</program>
