// §42.4 statement 2 — a bare `T | not` is the presence test as a WHOLE condition: an `if` test and a ternary test.
<program>
    function pick(a: string | not) -> int {
        if (a) { return 1 }
        return 0
    }
    function pickT(n: int | not) -> int {
        return n ? 1 : 0
    }
    <main><p>x</p></main>
</program>
