<program db="sqlite:./app.db">
${
  < Account authority="server" table="users">
    id: number
    name: string
  </>
  <Account> @accounts

  <ready>: bool = false

  function init() {
    @ready = true
  }

  init()
}
<p id="panel" show=@ready>module-init flips this cell TRUE before boot</p>
<ul><each in=@accounts key=@.id as a><li class="row">${a.name}</li></each></ul>
</program>
