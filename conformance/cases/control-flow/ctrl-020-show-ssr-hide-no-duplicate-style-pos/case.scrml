<program db="sqlite:./app.db">
${
  < Account authority="server" table="users">
    id: number
    name: string
  </>
  <Account> @accounts

  <hidden>: bool = false

  const Card = <div show=@hidden props={ title: string }>
    <h3>${title}</>
  </>
}
<div>
  <Card title="Secret">
    #{
      color: #111;
    }
  </>
</>
<ul><each in=@accounts key=@.id as a><li class="row">${a.name}</li></each></ul>
</program>
