${
    <n>: int = 5
    <phase>: string = "idle"

    type LoadError:enum = {
        NotFound(id: string)
    }

    function step1(v: int) { return v + 1 }
    function record(v: int) { return v }

    function load(id: string)! LoadError {
        if (id == "missing") fail LoadError.NotFound(id)
        return id
    }

    function tildeReadInArm() {
        step1(2)
        const label = if (@n > 0) {
            record(~)
            lift "ok"
        } else {
            lift "neg"
        }
        return label
    }

    function tildeReadInElseArm() {
        step1(6)
        const label = if (@n < 0) {
            lift "pos"
        } else {
            record(~)
            lift "else-ok"
        }
        return label
    }

    function liftReadsTildeInArm() {
        step1(40)
        const label = if (@n > 0) {
            lift ~
        } else {
            lift 0
        }
        return label
    }

    function liftLiteralInArm() {
        step1(40)
        const label = if (@n > 0) {
            lift 41
        } else {
            lift 0
        }
        return label
    }

    function bindlessRecoveryInArm() {
        const label = if (@n > 0) {
            load("ok") !{
                | .NotFound(mid) :> @phase = mid
            }
            lift "found"
        } else {
            lift "neg"
        }
        return label
    }
}

<div id="out-read">${tildeReadInArm()}</>
<div id="out-read-else">${tildeReadInElseArm()}</>
<div id="out-lift-tilde">${liftReadsTildeInArm()}</>
<div id="out-lift-literal">${liftLiteralInArm()}</>
<div id="out-recovery">${bindlessRecoveryInArm()}</>
