${
    type Mode:enum = { Off, On }
    <shown> = false
    <ticks> = 0
    function toOn() { @mode = .On }
}
<engine for=Mode initial=.Off if=@shown>
    <Off rule=.On>
        <onTransition to=.On>${ @ticks = @ticks + 1 }</>
        <p id="arm-off">OFF</>
    </>
    <On rule=.Off>
        <p id="arm-on">ON</>
    </>
</>
<program>
<button id="to-on" onclick=toOn()>On</>
<p id="cell">Mode: ${@mode}</>
<p id="ticks">Ticks: ${@ticks}</>
</program>
