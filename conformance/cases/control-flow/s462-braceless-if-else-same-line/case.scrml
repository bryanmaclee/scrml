<r> = ""
${
    function pick(c: boolean) {
        let s = ""
        if (c) s = "yes" else s = "no"
        return s
    }
    function go() {
        if (@r == "") @r = pick(false) else @r = "ran-twice"
        @r = @r + "|" + pick(true)
    }
}
<button id="go" onclick=go()>go</button>
<p id="out">${@r}</p>
