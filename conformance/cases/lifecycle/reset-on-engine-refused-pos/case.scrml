// §6.8.4 rule 6 — .Shipped and .Delivered refuse the reset target .Draft.
<program>
  type Order:enum = { Draft, Placed, Shipped, Delivered }
  <customer> = 0
  <order:Order=.Draft single reset-on=[@customer]>
    <Draft rule=.Placed/>
    <Placed rule=(.Shipped | .Draft)/>
    <Shipped rule=.Delivered/>
    <Delivered/>
  </>
  <p>${@customer}</p>
</program>
