${
    type User:struct = { id: number, name: string }
    <userData> : User | not = not
    function loadUser() : User | not {
        rows = ?{`SELECT id, name FROM users LIMIT 1`} !{ _ :> [] }
        return rows[0]
    }
}
<page>
    <request id="userReq">
        ${ @userData = loadUser() }
    </>
    <button id="btn" disabled=${<#userReq>.data is given}>go</>
    <div id="box" class=${<#userReq>.data is given ? "ready" : "wait"}>box</>
    <input id="fld" type="text" value=${<#userReq>.data is given} />
    <div id="cd" class:on=${<#userReq>.data is given}>cd</>
    <span id="nm">${@userData?.name}</span>
</page>
