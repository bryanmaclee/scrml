<program db="./app.db">
${
    type User:struct = { id: number, name: string }
    <userId> = 1
    <userData> : User | not = not
    function loadUser(id: number) : User | not {
        return ?{`SELECT id, name FROM users WHERE id = ${id}`}.get() !{ _ :> not }
    }
    function pick(id: number) : User | not {
        return loadUser(id)
    }
}
<request id="userReq">
    ${ @userData = pick(@userId) }
</>
<button id="setid" onclick=${@userId = 2}>user 2</>
<p id="who">${@userData?.name}</>
<p id="loading">${<#userReq>.loading}</>
</program>
