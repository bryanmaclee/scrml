${
    type LoadError:enum = {
        NotFound(reason: string)
        Empty
    }

    function risky(n: number)! -> LoadError {
        if (n == 0) { fail LoadError.NotFound("was-zero") }
        return "ok"
    }

    <result> = "init"

    function go() {
        @result = risky(0) !{
            ::NotFound(reason) :> "recovered: " + reason
            ::Empty            :> "was-empty"
        }
    }
}
<program>
    <button id="go" onclick=go()>Go</>
    <p id="out">${@result}</p>
</program>
