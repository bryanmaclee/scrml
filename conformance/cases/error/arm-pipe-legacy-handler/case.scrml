// §19.4.5 (S452) — the SOFT-DEPRECATED `|`-led `!{}` handler arm, kept in the legacy form ON
// PURPOSE: during the §63 window it parses identically to the §18.2 match arm and surfaces one
// W-ARM-PIPE-LEGACY per `|`-led arm. Do NOT run `scrml fix` over this case.
${
    type LoadError:enum = {
        NotFound(reason: string)
        Empty
    }

    function risky()! -> LoadError {
        fail LoadError.NotFound("was-zero")
    }

    <result> = "init"

    function go() {
        @result = risky() !{
            | .NotFound reason :> "recovered: " + reason
            | .Empty           :> "was-empty"
        }
    }
}
<program>
    <button id="go" onclick=go()>Go</>
    <p id="out">${@result}</p>
</program>
