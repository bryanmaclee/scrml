<program db="./app.db">
    <schema>
        orders {
            id: integer primary key
            name: text
        }
    </schema>
    function bulkInsert(a: string, b: string) {
        transaction {
            ?{`INSERT INTO orders (name) VALUES (${a})`}.run()
            ?{`INSERT INTO orders (name) VALUES (${b})`}.run()
        }
    }
    <p>x</p>
</program>
