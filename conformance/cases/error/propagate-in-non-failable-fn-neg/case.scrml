${
    type LoadError:enum = { Empty }
    function risky()! -> LoadError { fail LoadError::Empty }
    function caller()! -> LoadError { const r = risky()?; return r }
    <msg> = ""
}
<program>
<p id="s">propagate ${@msg}</p>
<button id="b" onclick={ caller() !{ .Empty :> @msg = "empty" } }>go</button>
</program>
