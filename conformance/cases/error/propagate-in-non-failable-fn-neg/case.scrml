${
    type LoadError:enum = { Empty }
    function risky(n: number)! -> LoadError { if (n == 0) { fail LoadError::Empty; } return n; }
    function caller()! -> LoadError { const r = risky(0)?; return r; }
    <msg> = ""
}
<program>
<p id="s">propagate ${@msg}</p>
<button id="b" onclick={ caller() !{ .Empty :> @msg = "empty" }; }>go</button>
</program>
