${
    type Level:enum = { Low, High }
    <level>: Level = .Low

    // Derived cell — a nested bare assignment writes the OUTER binding.
    const <derivedAssign> = match @level {
        .Low :> { let a = 0; for (const i of [1, 2]) { a = 1 } a }
        _    :> 99
    }

    // Derived cell — SELF-REFERENCING nested assignment.
    const <derivedSelfRef> = match @level {
        .Low :> { let a = 10; for (const i of [1, 2]) { a = a + 1 } a }
        _    :> 99
    }

    // Return position — nested self-referencing assignment inside an `if`.
    fn retSelfRef(k: int) -> int {
        return match k {
            1 :> { let a = 20; if (k > 0) { a = a + 1 } a }
            _ :> 99
        }
    }

    // Multi-scrutinee decl — nested bare assignment.
    fn multiAssign(x: int, y: int) -> int {
        const r = match (x, y) {
            (1, 2) :> { let a = 0; for (const i of [1, 2]) { a = 30 } a }
            _ :> 99
        }
        return r
    }

    // Plain local decl inside `fn` — nested self-referencing assignment.
    fn localSelfRef(k: int) -> int {
        const r = match k {
            1 :> { let a = 40; for (const i of [1, 2]) { a = a + 1 } a }
            _ :> 99
        }
        return r
    }

    // Plain local decl inside `function` — the structured-body route, both forms.
    function fnLocalAssign(k: int) -> int {
        const r = match k {
            1 :> { let a = 0; for (const i of [1, 2]) { a = 50 } a }
            _ :> 99
        }
        return r
    }

    function fnLocalSelfRef(k: int) -> int {
        const r = match k {
            1 :> { let a = 60; for (const i of [1, 2]) { a = a + 1 } a }
            _ :> 99
        }
        return r
    }
}
<page><main>
<p id="derived-assign">${@derivedAssign}</p>
<p id="derived-self-ref">${@derivedSelfRef}</p>
<p id="ret-self-ref">${ retSelfRef(1) }</p>
<p id="multi-assign">${ multiAssign(1, 2) }</p>
<p id="local-self-ref">${ localSelfRef(1) }</p>
<p id="fn-local-assign">${ fnLocalAssign(1) }</p>
<p id="fn-local-self-ref">${ fnLocalSelfRef(1) }</p>
</main></page>
