// §55.17.3 — a declaration's validated child field bound inside its form gates that form; the compound's surface reads it.
<program>
    <let calls:int=0/>
    <signup note:string="n">
        <let email:string="" req/>
        renders <input id="email" type="email" bind:value=@email/>
    </>
    renders <form id="f" onsubmit=save()>
        <*email/>
        <button id="go" type="submit">Save</button>
    </form>

    function save() { @calls = @calls + 1 }

    <main>
        <*signup/>
        <p id="calls">${@calls}</p>
        <p id="surface">${@signup.isValid}|${@signup.submitted}|${@signup.email.touched}</p>
    </main>
</program>
