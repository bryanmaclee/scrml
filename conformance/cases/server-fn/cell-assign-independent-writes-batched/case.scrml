${
    <a> : number = 0
    <b> : number = 0
    <seen> : string = ""
    server fn one(n: number) : number {
        return n
    }
    server fn two(n: number) : number {
        return n
    }
    function indep() {
        @a = one(1)
        @b = two(2)
        @seen = "indep:" + @a + "," + @b
    }
}
<button id="indep" onclick=indep()>i</>
<p id="seen">${@seen}</>
