type Phase:enum = { Idle, Loading }

<ph>: Phase = .Idle
<log> = ""
<n> = 0
<s> = "a;b"
<items> = [{ id: 1, name: "r" }]

${ function t(x) { @log = @log + x + "," } }

<p id="out">${@log}</p>

<button id="top" onclick={ t("T1") // one
            t("T2") // two
        }>top</button>

<engine for=Phase initial=.Idle>
    <Idle>
        <button id="eng" onclick={ t("E1") // one
            t("E2") // two
        }>engine</button>
    </>
    <Loading : "Loading…">
</>

<match on=@ph>
    <Idle>
        <button id="mat" onclick={ t("M1") // one
            t("M2") // two
        }>match</button>
    </>
    <Loading><p>Loading…</p></>
</>

<ul>
    <each in=@items key=@.id>
        <li><button class="row" onclick={ t("R1") // one
            t("R2") // two
        }>${@.name}</button></li>
    </each>
</ul>
