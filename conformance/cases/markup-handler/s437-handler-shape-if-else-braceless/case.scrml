type Phase:enum = { Idle, Loading }

<ph>: Phase = .Idle
<log> = ""
<n> = 0
<s> = "a;b"
<items> = [{ id: 1, name: "r" }]

${ function t(x) { @log = @log + x + "," } }

<p id="out">${@log}</p>

<button id="top" onclick={ if (@n > 5) t("Ta"); else t("Tb")
            t("T") }>top</button>

<engine for=Phase initial=.Idle>
    <Idle>
        <button id="eng" onclick={ if (@n > 5) t("Ea"); else t("Eb")
            t("E") }>engine</button>
    </>
    <Loading : "Loading…">
</>

<match on=@ph>
    <Idle>
        <button id="mat" onclick={ if (@n > 5) t("Ma"); else t("Mb")
            t("M") }>match</button>
    </>
    <Loading><p>Loading…</p></>
</>

<ul>
    <each in=@items key=@.id>
        <li><button class="row" onclick={ if (@n > 5) t("Ra"); else t("Rb")
            t("R") }>${@.name}</button></li>
    </each>
</ul>
