type Phase:enum = { Idle, Loading }

<ph>: Phase = .Idle
<log> = ""
<n> = 0
<items> = [{ id: 1, name: "r" }]

<p id="out">${@log}</p>

<button id="top" onclick=${ @log = @log + "T"
            + "," }>top</button>

<engine for=Phase initial=.Idle>
    <Idle>
        <button id="eng" onclick=${ @log = @log + "E"
            + "," }>engine</button>
    </>
    <Loading : "Loading…">
</>

<match on=@ph>
    <Idle>
        <button id="mat" onclick=${ @log = @log + "M"
            + "," }>match</button>
    </>
    <Loading><p>Loading…</p></>
</>

<ul>
    <each in=@items key=@.id>
        <li><button class="row" onclick=${ @log = @log + "R"
            + "," }>${@.name}</button></li>
    </each>
</ul>
