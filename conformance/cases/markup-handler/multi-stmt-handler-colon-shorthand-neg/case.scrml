type Phase:enum = { Idle, Running, Done }

<count> = 0

${ function startGame() -> string {
    let label = "Idle";
    label = label + ": press start";
    return label;
} }

<p>Count: ${@count}</>

<engine for=Phase initial=.Idle>
    <Idle : startGame()>
    <Running : "Running…">
    <Done : "Finished.">
</>
