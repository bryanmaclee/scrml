type Phase:enum = { Idle, Loading }

<ph>: Phase = .Idle
<log> = ""
<n> = 0
<s> = "a;b"
<items> = [{ id: 1, name: "r" }]

${ function t(x) { @log = @log + x + "," } }

<p id="out">${@log}</p>

<button id="top" onclick=${ // note
            t("T1"); t("T2") }>top</button>

<engine for=Phase initial=.Idle>
    <Idle>
        <button id="eng" onclick=${ // note
            t("E1"); t("E2") }>engine</button>
    </>
    <Loading : "Loading…">
</>

<match on=@ph>
    <Idle>
        <button id="mat" onclick=${ // note
            t("M1"); t("M2") }>match</button>
    </>
    <Loading><p>Loading…</p></>
</>

<ul>
    <each in=@items key=@.id>
        <li><button class="row" onclick=${ // note
            t("R1"); t("R2") }>${@.name}</button></li>
    </each>
</ul>
