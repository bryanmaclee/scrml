type Phase:enum = { Idle, Loading }

<ph>: Phase = .Idle
<log> = ""
<n> = 0
<s> = "a;b"
<items> = [{ id: 1, name: "r" }]

${ function t(x) { @log = @log + x + "," } }

<p id="out">${@log}</p>

<button id="top" onclick={
            // first
            t("T1")
            // second
            t("T2")
            // done
        }>top</button>

<engine for=Phase initial=.Idle>
    <Idle>
        <button id="eng" onclick={
            // first
            t("E1")
            // second
            t("E2")
            // done
        }>engine</button>
    </>
    <Loading : "Loading…">
</>

<match on=@ph>
    <Idle>
        <button id="mat" onclick={
            // first
            t("M1")
            // second
            t("M2")
            // done
        }>match</button>
    </>
    <Loading><p>Loading…</p></>
</>

<ul>
    <each in=@items key=@.id>
        <li><button class="row" onclick={
            // first
            t("R1")
            // second
            t("R2")
            // done
        }>${@.name}</button></li>
    </each>
</ul>
