type Phase:enum = { Idle, Loading }

<ph>: Phase = .Idle
<log> = ""
<n> = 0
<s> = "a;b"
<items> = [{ id: 1, name: "r" }]

${ function t(x) { @log = @log + x + "," } }

<p id="out">${@log}</p>

<button id="top" onclick={ for (const x of [1, 2]) { t("T" + x) } t("T9") }>top</button>

<engine for=Phase initial=.Idle>
    <Idle>
        <button id="eng" onclick={ for (const x of [1, 2]) { t("E" + x) } t("E9") }>engine</button>
    </>
    <Loading : "Loading…">
</>

<match on=@ph>
    <Idle>
        <button id="mat" onclick={ for (const x of [1, 2]) { t("M" + x) } t("M9") }>match</button>
    </>
    <Loading><p>Loading…</p></>
</>

<ul>
    <each in=@items key=@.id>
        <li><button class="row" onclick={ for (const x of [1, 2]) { t("R" + x) } t("R9") }>${@.name}</button></li>
    </each>
</ul>
