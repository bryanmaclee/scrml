type Phase:enum = { Idle, Loading }

<ph>: Phase = .Idle
<log> = ""
<n> = 0
<s> = "a;b"
<items> = [{ id: 1, name: "r" }]

${ function t(x) { @log = @log + x + "," } }

<p id="out">${@log}</p>

<button id="top" onclick={ @s = "T"
            .concat("x")
            t(@s) }>top</button>

<engine for=Phase initial=.Idle>
    <Idle>
        <button id="eng" onclick={ @s = "E"
            .concat("x")
            t(@s) }>engine</button>
    </>
    <Loading : "Loading…">
</>

<match on=@ph>
    <Idle>
        <button id="mat" onclick={ @s = "M"
            .concat("x")
            t(@s) }>match</button>
    </>
    <Loading><p>Loading…</p></>
</>

<ul>
    <each in=@items key=@.id>
        <li><button class="row" onclick={ @s = "R"
            .concat("x")
            t(@s) }>${@.name}</button></li>
    </each>
</ul>
