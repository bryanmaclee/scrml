type Doc:enum = { Empty, Note(note: string) }

<cur> = Doc.Note("hi")
<c> = true
<x> = 0
<y> = 0
<z> = 0
<w> = 0

server function save() { return 10 }

<p id="out">${@y} ${@z} ${@w}</p>

<button id="nif" onclick=${ if (@c) { @x = save(); @y = @x + 1 } }>if</button>
<button id="nchain" onclick=${ if (!@c) { @z = 0 } else if (@c) { @x = save(); @z = @x + 2 } else { @z = 5 } }>chain</button>
<button id="nmatch" onclick=${ match (@cur) { .Note(t) => { @x = save(); @w = @x + 3 } .Empty => { @w = 0 } } }>match</button>
