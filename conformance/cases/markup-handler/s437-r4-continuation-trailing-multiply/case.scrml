type Phase:enum = { Idle, Loading }

<ph>: Phase = .Idle
<log> = ""
<n> = 0
<items> = [{ id: 1, name: "r" }]

<p id="out">${@log}</p>

<button id="top" onclick={ @log = @log + "T" + 2 *
            3 + "," }>top</button>

<engine for=Phase initial=.Idle>
    <Idle>
        <button id="eng" onclick={ @log = @log + "E" + 2 *
            3 + "," }>engine</button>
    </>
    <Loading : "Loading…">
</>

<match on=@ph>
    <Idle>
        <button id="mat" onclick={ @log = @log + "M" + 2 *
            3 + "," }>match</button>
    </>
    <Loading><p>Loading…</p></>
</>

<ul>
    <each in=@items key=@.id>
        <li><button class="row" onclick={ @log = @log + "R" + 2 *
            3 + "," }>${@.name}</button></li>
    </each>
</ul>
