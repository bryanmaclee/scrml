<program db="./app.db">
${
    type User:struct = { id: number, name: string }
    type Post:struct = { id: number, title: string }
    <users> : User[] = []
    <posts> : Post[] = []
    function loadUsers() : User[] {
        return ?{`SELECT id, name FROM users`}.all() !{ _ :> [] }
    }
    function loadPosts() : Post[] {
        return ?{`SELECT id, title FROM posts`}.all() !{ _ :> [] }
    }
}
<button id="lu" onclick={ @users = loadUsers() !{ .Transport(_) :> { return } } }>LoadUsers</>
<button id="lp" onclick={ @posts = loadPosts() !{ .Transport(_) :> { return } } }>LoadPosts</>
<p id="uc">${@users.length}</>
<p id="pc">${@posts.length}</>
</program>
