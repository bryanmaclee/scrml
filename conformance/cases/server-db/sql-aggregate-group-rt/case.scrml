<program db="./app.db">
${
    <totals> = []
    function regionTotals() {
        return ?{`SELECT region, SUM(amount) AS total FROM sales GROUP BY region ORDER BY region`}.all() !{ _ :> [] }
    }
    function onLoad() {
        @totals = regionTotals() !{ .Transport(_) :> { return } }
    }
}
<button id="load" onclick=onLoad()>Region totals</>
<p if=@totals id="g">grouped</>
</program>
