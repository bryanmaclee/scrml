<count> = 0
<program db="sqlite:./app.db">
<schema>
  items { id: integer primary key, name: text }
</>
${
    function loadAndSet() {
        const rows = ?{ select id from items } !{ _ :> [] }
        @count = rows.length
    }
}
<p id="s">${@count}</p>
<button id="b" onclick=loadAndSet()>go</button>
</program>
