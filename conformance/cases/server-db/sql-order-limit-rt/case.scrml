<program db="./app.db">
${
    <top> = []
    function topTwo() {
        return ?{`SELECT player, points FROM scores ORDER BY points DESC LIMIT 2`}.all()
    }
    function onLoad() {
        @top = topTwo() !{ .Transport(t) :> { return } }
    }
}
<button id="load" onclick=onLoad()>Top two</>
<p if=@top id="p">top</>
</program>
