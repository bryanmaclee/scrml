<program db="./app.db">
${
    type User:struct = { id: number, name: string }
    <current> = not
    function loadOne() : User {
        return ?{`SELECT id, name FROM users`}.get() !{ _ :> not }
    }
}
<button id="load" onclick={ @current = loadOne() !{ .Transport(_) :> { return } } }>Load</>
</program>
