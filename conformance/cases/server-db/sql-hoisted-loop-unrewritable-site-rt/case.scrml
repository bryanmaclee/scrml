<program db="./app.db">
    <schema>
        notes {
            id: integer primary key
            body: text
        }
    </schema>
    <found> = "init"
    // §8.10: a loop whose single keyed read the hoist cannot rewrite into a Map
    // lookup — here `return ?{…}.get()` inside an `if` — is NOT hoisted: it keeps
    // its per-iteration query. It is never emitted as a `null` read.
    function firstOn(items) {
        for (const it of items) {
            if (it.on) {
                return ?{`SELECT id, body FROM notes WHERE id = ${it.id}`}.get()
            }
        }
        return not
    }
    function go() {
        const row = firstOn([{ id: 8, on: false }, { id: 7, on: true }]) !{ _ :> not }
        @found = row is not ? "none" : row.body
    }
    <button id="go" onclick=go()>go</button>
    <p id="found">${@found}</p>
</program>
