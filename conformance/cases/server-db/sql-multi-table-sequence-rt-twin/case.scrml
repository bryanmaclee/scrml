// §66 twin of server-db/sql-multi-table-sequence-rt — the same program, seed, clicks and asserted values in the dialect the bootstrap parses.
<program db="./app.db">
    type User:struct = { id: int, name: string }
    type Post:struct = { id: int, title: string }
    <users:User[replace]=([])/>
    <posts:Post[replace]=([])/>
    function loadUsers() -> User[] {
        return ?{`SELECT id, name FROM users`}.all() !{ _ :> [] }
    }
    function loadPosts() -> Post[] {
        return ?{`SELECT id, title FROM posts`}.all() !{ _ :> [] }
    }
    <main>
        <button id="lu" onclick={ @users = loadUsers() !{ .Transport(t) :> return } }>LoadUsers</button>
        <button id="lp" onclick={ @posts = loadPosts() !{ .Transport(t) :> return } }>LoadPosts</button>
        <p id="uc">${@users.length}</p>
        <p id="pc">${@posts.length}</p>
    </main>
</program>
