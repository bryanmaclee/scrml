// §66 twin of server-db/sql-all-array-shape-rt — the same program, seed, clicks and asserted values in the dialect the bootstrap parses.
<program db="./app.db">
    type Widget:struct = { id: int, label: string }
    <rows:Widget[replace]=([])/>
    function loadAll() -> Widget[] {
        return ?{`SELECT id, label FROM widgets`}.all() !{ _ :> [] }
    }
    <main>
        <button id="load" onclick={ @rows = loadAll() !{ .Transport(t) :> return } }>Load</button>
        <p id="count">${@rows.length}</p>
    </main>
</program>
