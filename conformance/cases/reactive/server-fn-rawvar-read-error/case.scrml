${
    <price> = 10
    function saveOrder() : number {
        result = ?{`INSERT INTO orders (amount) VALUES (${@price}) RETURNING id`} !{ _ :> [] }
        return result
    }
}
<button id="save" onclick={ @price = saveOrder() !{ .Transport(_) :> { return } } }>Save</>
<p id="p">Price: ${@price}</>
