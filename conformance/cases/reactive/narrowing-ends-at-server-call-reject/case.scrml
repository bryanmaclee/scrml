<program>
type User:struct = { name: string }
<user>: User | not = { name: "a" }
<out> = ""
${
    server function save() -> int { return 1 }
    function show() {
        if (@user is given) {
            const r = save()
            @out = @user.name
        }
    }
}
<button id="b" onclick=show()>go</button>
<p id="o">${@out}</p>
</program>
