${
    <groups> = [{ id: 1, name: "one" }, { id: 2, name: "two" }]
    function replaceFirst() {
        @groups.splice(0, 1, { id: 1, name: "S" })
    }
    function addTag() {
        @groups.push({ id: 3, name: "tag" })
    }
}
<button id="rep" onclick=replaceFirst()>rep</>
<button id="add" onclick=addTag()>add</>
<ul>
    <each in=@groups key=@.id as g>
        <li class="g">${g.name}</li>
    </each>
</ul>
