<program>
type User:struct = { name: string }
<user>: User | not = { name: "a" }
<out> = ""
${
    function show() {
        if (@user is given) {
            const k = Math.max(1, 2)
            const t = String(k).trim()
            @out = @user.name
        }
    }
}
<button id="b" onclick=show()>go</button>
<p id="o">${@out}</p>
</program>
