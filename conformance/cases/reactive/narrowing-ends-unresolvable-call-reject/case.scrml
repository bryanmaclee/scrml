<program>
type User:struct = { name: string }
<user>: User | not = { name: "a" }
<out> = ""
${
    function show(cb: () -> void) {
        if (@user is given) {
            cb()
            @out = @user.name
        }
    }
    function noop() { }
}
<button id="b" onclick=show(noop)>go</button>
<p id="o">${@out}</p>
</program>
