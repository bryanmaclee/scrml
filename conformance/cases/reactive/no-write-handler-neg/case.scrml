// S449 item 3 — an event handler is NOT a render position: it runs on the user's action and may write.
<program>
    <let hits:int=0/>
    function bump() -> int {
        @hits = @hits + 1
        return 1
    }
    function label() -> string {
        @hits = @hits + 1
        return "x"
    }
    <let q:string=""/>
    <main>
        <button onclick=bump()>a</button>
        <button onclick={ @hits = @hits + 1 }>b</button>
        <input bind:value=@q/>
        <p>${@hits}</p>
    </main>
</program>
