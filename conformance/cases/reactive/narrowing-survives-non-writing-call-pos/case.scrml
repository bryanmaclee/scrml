<program>
type User:struct = { name: string }
<user>: User | not = { name: "a" }
<out> = ""
${
    function bump() { @out = @out + "." }
    function show() {
        if (@user is given) {
            bump()
            @out = @user.name
        }
    }
}
<button id="b" onclick=show()>go</button>
<p id="o">${@out}</p>
</program>
