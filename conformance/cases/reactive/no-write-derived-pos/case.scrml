// §6.15 (S449 item 3) — a derived formula calls a function that writes a cell (it would run on every read): a compile error at the source.
<program>
    let <hits:int=0/>
    function bump() -> int {
        @hits = @hits + 1
        return 1
    }
    function label() -> string {
        @hits = @hits + 1
        return "x"
    }
    let <n:int=0/>
    <d:int=(@n + bump())/>
    <main>
        <p>${@d}</p>
        <button onclick=(@n = @n + 1)>+</button>
    </main>
</program>
