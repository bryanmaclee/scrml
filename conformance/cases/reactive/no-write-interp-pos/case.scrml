// §6.15 (S449 item 3) — a markup interpolation calls a function that writes a cell (the render self-write): a compile error at the source.
<program>
    <let hits:int=0/>
    function bump() -> int {
        @hits = @hits + 1
        return 1
    }
    function label() -> string {
        @hits = @hits + 1
        return "x"
    }
    <main>
        <p>${bump()}</p>
    </main>
</program>
