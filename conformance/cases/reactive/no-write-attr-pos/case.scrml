// §6.15 (S449 item 3) — an attribute value interpolation calls a function that writes a cell: a compile error at the source.
<program>
    let <hits:int=0/>
    function bump() -> int {
        @hits = @hits + 1
        return 1
    }
    function label() -> string {
        @hits = @hits + 1
        return "x"
    }
    <main>
        <p title=(label())>x</p>
    </main>
</program>
