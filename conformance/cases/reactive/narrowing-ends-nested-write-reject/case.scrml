<program>
type User:struct = { name: string }
<user>: User | not = { name: "a" }
<out> = ""
${
    function show(c: bool) {
        if (@user is given) {
            if (c) { @user = not }
            @out = @user.name
        }
    }
}
<button id="b" onclick=show(true)>go</button>
<p id="o">${@out}</p>
</program>
