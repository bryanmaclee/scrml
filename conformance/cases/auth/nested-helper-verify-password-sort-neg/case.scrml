<program>
${
  import { verifyPassword } from 'scrml:auth'
}
server function rankHashes(pw: string, hashes: string[]) {
  function matches(h: string) { return verifyPassword(pw, h) }
  return hashes.sort((a, b) => matches(a) ? -1 : 1)
}
function go() {
  const r = rankHashes("pw", ["a", "b"]) !{ .Transport(_) :> return }
  console.log(r)
}
<button onclick=go()>go</button>
</program>
