<program db="sqlite:./notes.db" auth="required">
function saveNote(body: string) {
    ?{`INSERT INTO notes (sid, body) VALUES (${session.userId}, ${body})`}.run()
}
function logout() {
    @session.destroy()
}
<p id="who">${@session.current}</p>
<button id="save" onclick={ saveNote("hi") !{ .Transport(_) :> { return } } }>Save</>
<button id="out" onclick=logout()>Log out</>
</program>
