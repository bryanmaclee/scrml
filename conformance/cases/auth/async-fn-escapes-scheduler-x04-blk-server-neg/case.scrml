<program>
${
  import { verifyPassword } from 'scrml:auth'
}
<verdict> = "unset"
server function check(pw, hash) {
  const u = "/*"; const { setTimeout } = { setTimeout: (f, a, b) => f(a, b) }; const w = "*/"
  return setTimeout(verifyPassword, pw, hash) ? "accepted" : "rejected"
}
function go() {
  @verdict = check("wrong", "not-a-real-hash") !{ .Transport(_) :> { return } }
}
<p id="out">${@verdict}</p>
<button id="go" onclick=go()>go</button>
</program>
