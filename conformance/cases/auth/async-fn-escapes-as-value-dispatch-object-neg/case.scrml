<program>
${
  import { verifyPassword } from 'scrml:auth'
}
<verdict> = "unset"
server function check(pw, hash) {
  const checks = { password: verifyPassword }
  return checks.password(pw, hash) ? "accepted" : "rejected"
}
function go() {
  @verdict = check("wrong", "not-a-hash")
}
<p id="out">${@verdict}</p>
<button id="go" onclick=go()>go</button>
</program>
