<program>
${
  import { verifyPassword } from 'scrml:auth';
}
<verdict> = "unset"
server function check(pw: string, hash: string) {
  function matches(h: string) { return verifyPassword(pw, h) }
  function drive(f) { return f(hash) }
  return drive(matches) ? "accepted" : "rejected"
}
function go() {
  @verdict = check("wrong", "not-a-hash") !{ .Transport(_) :> return }
}
<p id="out">${@verdict}</p>
<button id="go" onclick=go()>go</button>
</program>
