<program db="sqlite:./app.db">
<db src="sqlite:./app.db" tables="orders">
  ${
    ?{`CREATE TABLE IF NOT EXISTS orders (id INTEGER PRIMARY KEY, item TEXT)`}.run()
    <orders server> = ?{`SELECT * FROM orders`}.prepare()
  }
  <main><ul><each in=@orders key=@.id><li : @.item></each></ul></main>
</db>
</program>
