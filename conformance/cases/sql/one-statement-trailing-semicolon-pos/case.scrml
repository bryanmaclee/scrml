<program db="./app.db">
    // One statement per ?{} — a single trailing ; (and a comment after it) is allowed, and a ;
    // inside a string literal is data, not a separator (§8.1.2). Two writes that belong together
    // are two ?{}s in a transaction block.
    ${
        function record() {
            ?{`INSERT INTO log (msg) VALUES ('a;b'); -- one statement`}.run()
            transaction {
                ?{`INSERT INTO log (msg) VALUES ('c');`}.run()
                ?{`INSERT INTO log (msg) VALUES ('d')`}.run()
            }
            return 1
        }
    }
    <button onclick=${ record() }>record</button>
</program>
