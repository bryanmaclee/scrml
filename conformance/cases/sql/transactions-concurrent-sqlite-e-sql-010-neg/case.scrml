<program db="./ledger.db" transactions="concurrent">
    ${
        function record(note) {
            ?{`INSERT INTO entries (note) VALUES (${note})`}.run() !{ _ :> {} }
            return 1
        }
    }
    <button id="add" onclick={ record("hello") !{ .Transport(_) :> { return } } }>Add</>
</program>
