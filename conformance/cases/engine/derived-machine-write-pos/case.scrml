${ type Light:enum = { Red, Green } }
${ type Lamp:enum  = { Off, On } }
<program>
< machine name=Signal for=Light>
  .Red => .Green
  .Green => .Red
</>
<sig>: Signal = .Red
< machine name=Proj for=Lamp derived=@sig>
  .Red => .Off
  .Green => .On
</>
${ function touch() { @proj = .On } }
<p id="s">${@sig}</p>
<button id="b" onclick=touch()>touch</button>
</program>
