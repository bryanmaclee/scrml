<program>
<items> = [{ id: 1, code: "go()", url: "/one", t: "tip" }]
const Btn = <button>b</button>
const Link = <a>l</a>
const Tip = <span>t</span>
const DBtn = <button class="d" props={ onClick: string }>b</button>
const DLink = <a class="d" props={ href: string }>l</a>
const DTip = <span class="d" props={ title: string }>t</span>
<ul id="b">${ for (const it of @items) { lift <li><Btn onClick=it.code/></li> } }</ul>
<ul id="e"><each in=@items key=@.id as it><li><Btn onClick=it.code/></li></each></ul>
<ul id="h">${ for (const it of @items) { lift <li><Link href=it.url/></li> } }</ul>
<ul id="t"><each in=@items key=@.id as it><li><Tip title=it.t/></li></each></ul>
<ul id="bd">${ for (const it of @items) { lift <li><DBtn onClick=it.code/></li> } }</ul>
<ul id="hd">${ for (const it of @items) { lift <li><DLink href=it.url/></li> } }</ul>
<ul id="td"><each in=@items key=@.id as it><li><DTip title=it.t/></li></each></ul>
</program>
