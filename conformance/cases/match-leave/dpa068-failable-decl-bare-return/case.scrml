${
    type E:enum = { Boom(msg: string), Other }
    type E2:enum = { Wrapped(msg: string) }
    <out> : string = "none"
    <seen> : string = "none"
    <after> : string = "not-run"
    function risky(n: number)! E {
        if (n < 0) { fail E.Boom("neg") }
        return n
    }
    function calc(n: number) -> string {
        const v = match risky(n) {
            .Ok(x) :> "ok"
            .Boom(m) :> return "early:" + m
            .Other :> "other"
        }
        return "got:" + v
    }
    function go() {
        @out = calc(-1)
    }
}
<button id="go" onclick=go()>go</>
<p id="out">${@out}</>
