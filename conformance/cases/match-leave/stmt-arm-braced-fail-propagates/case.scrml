${
    type E:enum = { Boom(msg: string), Other }
    type E2:enum = { Wrapped(msg: string) }
    type K:enum = { A, B, C }
    <out> : string = "none"
    <seen> : string = "none"
    <after> : string = "not-run"
    function risky(n: number)! E {
        if (n < 0) { fail E.Boom("neg") }
        return n
    }
    function chk(k: K)! E {
        match k {
            .A :> { fail .Boom("a") }
            .B :> @seen = "b"
            .C :> @seen = "c"
        }
        @after = "ran"
    }
    function go() {
        chk(K.A) !{
            .Boom(m) :> @seen = "boom:" + m
            .Other :> @seen = "other"
        }
    }
}
<button id="go" onclick=go()>go</>
<p id="after">${@after}</>
