${
    type E:enum = { Boom(msg: string), Other }
    type E2:enum = { Wrapped(msg: string) }
    type K:enum = { A, B, C }
    <out> : string = "none"
    <seen> : string = "none"
    <after> : string = "not-run"
    function risky(n: number)! E {
        if (n < 0) { fail E.Boom("neg") }
        return n
    }
}
<button id="go" onclick={ risky(-1) !{
    .Boom(m) :> return
    .Other :> @seen = "other"
}
@after = "ran" }>go</>
<p id="after">${@after}</>
