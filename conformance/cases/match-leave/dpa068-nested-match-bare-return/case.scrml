${
    type E:enum = { Boom(msg: string), Other }
    type E2:enum = { Wrapped(msg: string) }
    type K:enum = { A, B, C }
    <out> : string = "none"
    <seen> : string = "none"
    <after> : string = "not-run"
    function risky(n: number)! E {
        if (n < 0) { fail E.Boom("neg") }
        return n
    }
    function nest(k: K, j: K) -> string {
        const y = match k {
            .A :> match j {
                .A :> return "early"
                .B :> "ab"
                .C :> "ac"
            }
            .B :> "b"
            .C :> "c"
        }
        return "got:" + y
    }
    function go() {
        @out = nest(K.A, K.A)
    }
}
<button id="go" onclick=go()>go</>
<p id="out">${@out}</>
