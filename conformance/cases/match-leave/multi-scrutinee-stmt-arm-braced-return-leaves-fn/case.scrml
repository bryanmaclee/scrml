${
    type K:enum = { A, B }
    <after> : string = "not-run"
    <seen> : string = "none"
    function pick(a: K, b: K) {
        match (a, b) {
            (.A, .A) :> { return }
            (.A, .B) :> { @seen = "ab" }
            _ :> @seen = "other"
        }
        @after = "ran"
    }
    function go() {
        pick(K.A, K.A)
    }
}
<button id="go" onclick=go()>go</>
<p id="after">${@after}</>
<p id="seen">${@seen}</>
