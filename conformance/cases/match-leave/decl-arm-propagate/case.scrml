${
    type E:enum = { Boom(msg: string), Other }
    type E2:enum = { Wrapped(msg: string) }
    type K:enum = { A, B, C }
    <out> : string = "none"
    <seen> : string = "none"
    <after> : string = "not-run"
    function risky(n: number)! E {
        if (n < 0) { fail E.Boom("neg") }
        return n
    }
    function viaQ(k: K, n: number)! E {
        const r = match k {
            .A :> risky(n)?
            .B :> 0
            .C :> 1
        }
        @out = "r=" + r
    }
    function go() {
        viaQ(K.A, -1) !{
            .Boom(m) :> @seen = "boom:" + m
            .Other :> @seen = "other"
        }
    }
}
<button id="go" onclick=go()>go</>
<p id="seen">${@seen}</>
