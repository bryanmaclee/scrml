${
    type E:enum = { Boom(msg: string), Other }
    type E2:enum = { Wrapped(msg: string) }
    type K:enum = { A, B, C }
    <out> : string = "none"
    <seen> : string = "none"
    <after> : string = "not-run"
    function risky(n: number)! E {
        if (n < 0) { fail E.Boom("neg") }
        return n
    }
    function count() -> number {
        let n = 0
        const ks: K[] = [K.C, K.A, K.C, K.B, K.C]
        for (const x of ks) {
            const k: K = x
            match k {
                .A :> { continue }
                .B :> { break }
                .C :> { n = n + 1 }
            }
        }
        return n
    }
    function go() {
        @out = "n=" + count()
    }
}
<button id="go" onclick=go()>go</>
<p id="out">${@out}</>
