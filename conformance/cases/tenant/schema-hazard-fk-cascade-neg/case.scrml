<program db="./app.db">
    <schema>
        ?{`CREATE TABLE config (k TEXT PRIMARY KEY, v TEXT)`}
        ?{`CREATE TABLE assets (id INTEGER PRIMARY KEY, name TEXT, cfg TEXT REFERENCES config(k) ON DELETE CASCADE, tenant_id TEXT)`}
    </>
    // The delete names no tenant table; the cascade reaches one.
    ${
        function go() {
            ?{`DELETE FROM config WHERE k = 'c'`}.run()
            return "ok"
        }
    }
    <button onclick=${ go() }>go</button>
</program>
