<program db="./app.db">
    <schema>
        ?{`CREATE TABLE assets (id INTEGER PRIMARY KEY, name TEXT, tenant_id TEXT)`}
    </>
    // A view in a program body is off the closed allow-list, whatever its columns:
    // the compiler does not judge what it creates — it is declared in <schema> or refused.
    ${
        function setup() {
            ?{`CREATE VIEW recent AS SELECT id, name FROM assets`}.acrossTenants().run()
            return 1
        }
    }
    <button onclick=${ setup() }>setup</button>
</program>
