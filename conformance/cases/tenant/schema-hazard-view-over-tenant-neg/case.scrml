<program db="./app.db">
    <schema>
        ?{`CREATE TABLE assets (id INTEGER PRIMARY KEY, name TEXT, cost INTEGER, tenant_id TEXT)`}
        ?{`CREATE VIEW all_assets AS SELECT * FROM assets`}
        ?{`CREATE VIEW asset_names AS SELECT name FROM all_assets`}
    </>
    // Reading a view is never scoped to the active tenant.
    ${
        function go() {
            return ?{`SELECT id, name FROM all_assets`}.all()
        }
    }
    <button onclick=${ go() }>go</button>
</program>
