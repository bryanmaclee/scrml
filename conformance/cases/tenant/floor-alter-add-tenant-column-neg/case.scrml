<program db="./app.db">
    <schema>
        ?{`CREATE TABLE notes (id INTEGER PRIMARY KEY, body TEXT)`}
        ?{`ALTER TABLE notes ADD COLUMN tenant_id TEXT`}
        ?{`CREATE VIEW all_notes AS SELECT * FROM notes`}
    </>
    // A view over the ALTER-scoped `notes` would serve every tenant's notes.
    ${
        function everyone() {
            return ?{`SELECT body FROM all_notes`}.all()
        }
    }
    <button onclick=${ everyone() }>all</button>
</program>
