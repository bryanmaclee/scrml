${
    type L:struct = { u: string, n: number(>0) }
    type P:struct = { a: number(>0)[], b: number(>5)[] }
    <m>: number = -5
    <t>: number = 3
    <y>: number(>5)[] = [6, 7]
    <x>: number(>0)[] = [1]
    <rows>: L[] = [{ u: "a", n: 1 }, { u: "b", n: 2 }]
    <p>: P = { a: [6, 7], b: [8] }
    <mm>: number(>0)[][] = [[1], [2]]
    function sharedPush() {
        @x = @y
        @y.push(@t)
    }
    function sharedPushViaX() { @x.push(@t) }
    function pathField() { @rows[1].n = @m }
    function pathRow() { @rows[0] = { u: "q", n: @m } }
    function twoPositions() {
        @p.b = @p.a
        @p.a.push(@t)
    }
    function nestedPush() { @mm[1].push(@m) }
}
<program>
<button id="shared" onclick=sharedPush()>a</button>
<button id="sharedx" onclick=sharedPushViaX()>b</button>
<button id="field" onclick=pathField()>c</button>
<button id="row" onclick=pathRow()>d</button>
<button id="two" onclick=twoPositions()>e</button>
<button id="nested" onclick=nestedPush()>f</button>
<p id="out">${@y.length} ${@rows.length} ${@p.a.length} ${@mm.length}</p>
</program>
