<program>
${
    // ---------------------------------------------------------------------------
    // scrml:http — HTTP client utilities
    //
    // Typed fetch wrapper with timeout, retry, and response normalization.
    //
    // All functions return a normalized response object:
    //   { ok: boolean, status: number, data: asIs, headers: Headers, raw: Response }
    //
    //   ok     — true if status is 2xx
    //   data   — parsed JSON if Content-Type includes "application/json", else string
    //   raw    — the original Response object
    //
    // Errors: network failures throw. HTTP 4xx/5xx does NOT throw — check ok.
    //
    // Options: { timeout?, headers?, retry?, retryDelay? }
    //   timeout   — abort after N ms (default: 10000)
    //   retry     — retry count on network errors only (default: 0)
    //   retryDelay — base delay ms, exponential: delay * attempt (default: 1000)
    //
    // IMPORTANT: Intended for server-classified function bodies. fetch is
    // available server-side in Bun. Do not call from client-side reactive code.
    //
    // Clients (S462): `withBaseUrl` / `withAuth` / `withDefaults` return an
    // HttpClient — a plain config STRUCT, not an object of functions (a function
    // is never stored in a value, §14.3). Pass the client as the FIRST argument
    // of the same request functions:
    //   get(url, opts)              get(client, path, opts)
    //   post(url, body, opts)       post(client, path, body, opts)
    //   put / del / patch           — same two shapes
    //
    // Usage:
    //   ${ import { get, post, withBaseUrl, isOk } from 'scrml:http' }
    //
    //   const api = withAuth(token, "Bearer", withBaseUrl("https://api.example.com"))
    //   const res = get(api, "/users/42")
    // ---------------------------------------------------------------------------

    // De-leak the retry-jitter through scrml:random — the sanctioned
    // non-deterministic source (closes the stdlib-ouroboros, §41.20).
    import { random } from 'scrml:random'

    async function _request(url, options) {
        const opts = options || {}
        const timeout = opts.timeout is given ? opts.timeout : 10000
        const retryCount = opts.retry || 0
        const retryDelay = opts.retryDelay is given ? opts.retryDelay : 1000
        const extraHeaders = opts.headers || {}

        const fetchOptions = {
            method: opts.method || "GET",
            headers: {}
        }
        for (const [k, v] of Object.entries(extraHeaders)) {
            fetchOptions.headers[k] = v
        }
        if (opts.body is given) {
            if (typeof opts.body == "string") {
                fetchOptions.body = opts.body
            } else {
                fetchOptions.body = JSON.stringify(opts.body)
                if (!fetchOptions.headers["Content-Type"] && !fetchOptions.headers["content-type"]) {
                    fetchOptions.headers["Content-Type"] = "application/json"
                }
            }
        }

        let lastError = not
        for (let attempt = 0; attempt <= retryCount; attempt++) {
            if (attempt > 0) {
                await new Promise(resolve => setTimeout(resolve, retryDelay * attempt))
            }
            let timeoutId = not
            // safeCallAsync-gap: await fetch() and await raw.json()/text() are
            // async-throwing JS-host calls. synchronous safeCall cannot catch
            // async throws. This try/catch is retained until safeCallAsync is
            // available. The whole _request function should be refactored to
            // failable once safeCallAsync lands. Tracked as Phase 3a partial.
            try {
                const controller = new AbortController()
                fetchOptions.signal = controller.signal
                if (timeout > 0) {
                    timeoutId = setTimeout(() => controller.abort(), timeout)
                }
                const raw = await fetch(url, fetchOptions)
                if (timeoutId) clearTimeout(timeoutId)
                const contentType = raw.headers.get("content-type") || ""
                let data
                if (contentType.includes("application/json")) {
                    data = await raw.json()
                } else {
                    data = await raw.text()
                }
                return { ok: raw.ok, status: raw.status, data, headers: raw.headers, raw }
            } catch(err) {
                if (timeoutId) clearTimeout(timeoutId)
                if (err.name == "AbortError") {
                    throw new Error(`[scrml:http] Request timed out after ${timeout}ms: ${url}`)
                }
                lastError = err
                if (attempt == retryCount) throw lastError
            }
        }
        throw lastError
    }

    // -- Clients (S462) --------------------------------------------------------
    // An HttpClient is DATA: a base URL, default request options, and an
    // Authorization header value. The request functions read it; it holds no
    // functions of its own.
    //
    //   baseUrl       — prefix for relative paths ("" = none)
    //   defaults      — options merged under every call's options
    //                   ({ headers?, timeout?, retry?, retryDelay? })
    //   authorization — full Authorization header value, or `not`

    export type HttpClient:struct = {
        baseUrl: string,
        defaults: asIs,
        authorization: string | not
    }

    const _NO_CLIENT = Object.freeze({ baseUrl: "", defaults: Object.freeze({}), authorization: not })

    // Build a client that OWNS its defaults: a fresh copy (headers included),
    // frozen all the way down. Two clients never share a mutable `defaults`,
    // and a wrapper never aliases the wrapped client's, so a write to one
    // client's headers cannot leak into another client's requests.
    function _makeClient(baseUrl, defaults, authorization) {
        const own = _mergeOptions(defaults, not)
        if (own.headers) Object.freeze(own.headers)
        return Object.freeze({
            baseUrl: baseUrl || "",
            defaults: Object.freeze(own),
            authorization: authorization
        })
    }

    // A request target is either a URL or an HttpClient. A client is an
    // object that HAS a `baseUrl` field (whatever its `defaults` hold).
    function _isClient(target) {
        return target is given && typeof target == "object" && Object.hasOwn(target, "baseUrl")
    }

    // The URL-first form keeps the pre-S462 behaviour for what fetch accepts
    // as its input — a string, a URL object, or a Request. Anything else is
    // refused rather than stringified into fetch("[object Object]").
    function _assertUrlTarget(target, fnName) {
        if (typeof target == "string") return
        if (target instanceof URL || target instanceof Request) return
        throw new TypeError(`[scrml:http] ${fnName}: the first argument must be a URL (string, URL or Request) or an HttpClient from withBaseUrl / withAuth / withDefaults`)
    }

    // Resolve a path against the client's base URL. Absolute URLs pass through.
    function _clientUrl(client, path) {
        if (!client.baseUrl) return path
        if (path.startsWith("http://") || path.startsWith("https://")) return path
        const base = client.baseUrl.replace(/\/$/, "")
        const p = path.startsWith("/") ? path : "/" + path
        return base + p
    }

    // Merge two option objects: `over` wins key by key; headers merge by key.
    function _mergeOptions(under, over) {
        const u = under || {}
        const o = over || {}
        const merged = Object.assign({}, u, o)
        if (u.headers || o.headers) {
            merged.headers = Object.assign({}, u.headers || {}, o.headers || {})
        }
        return merged
    }

    // The options a client contributes to one call: its defaults under the
    // call's own options, then its Authorization header over both (a client's
    // credential is not overridden by a per-call header).
    function _clientOptions(client, options) {
        const merged = _mergeOptions(client.defaults, options)
        if (client.authorization is given) {
            merged.headers = Object.assign({}, merged.headers || {}, { Authorization: client.authorization })
        }
        return merged
    }

    /**
     * Perform a GET request.
     *   get(url, options?)
     *   get(client, path, options?)
     * Example: const res = get("/api/users")
     *          const res = get(api, "/users/42")
     */
    export async function get(target, pathOrOptions, options) {
        if (_isClient(target)) {
            return _request(_clientUrl(target, pathOrOptions), { ..._clientOptions(target, options), method: "GET" })
        }
        _assertUrlTarget(target, "get")
        return _request(target, { ...pathOrOptions, method: "GET" })
    }

    /**
     * Perform a POST request. Object body is JSON-serialized automatically.
     *   post(url, body, options?)
     *   post(client, path, body, options?)
     * Example: const res = post("/api/users", { name: "Alice" })
     */
    export async function post(target, a, b, c) {
        if (_isClient(target)) {
            return _request(_clientUrl(target, a), { ..._clientOptions(target, c), method: "POST", body: b })
        }
        _assertUrlTarget(target, "post")
        return _request(target, { ...b, method: "POST", body: a })
    }

    /**
     * Perform a PUT request.
     *   put(url, body, options?)
     *   put(client, path, body, options?)
     */
    export async function put(target, a, b, c) {
        if (_isClient(target)) {
            return _request(_clientUrl(target, a), { ..._clientOptions(target, c), method: "PUT", body: b })
        }
        _assertUrlTarget(target, "put")
        return _request(target, { ...b, method: "PUT", body: a })
    }

    /**
     * Perform a DELETE request. Named `del` — `delete` is a reserved keyword.
     *   del(url, options?)
     *   del(client, path, options?)
     */
    export async function del(target, pathOrOptions, options) {
        if (_isClient(target)) {
            return _request(_clientUrl(target, pathOrOptions), { ..._clientOptions(target, options), method: "DELETE" })
        }
        _assertUrlTarget(target, "del")
        return _request(target, { ...pathOrOptions, method: "DELETE" })
    }

    /**
     * Perform a PATCH request.
     *   patch(url, body, options?)
     *   patch(client, path, body, options?)
     */
    export async function patch(target, a, b, c) {
        if (_isClient(target)) {
            return _request(_clientUrl(target, a), { ..._clientOptions(target, c), method: "PATCH", body: b })
        }
        _assertUrlTarget(target, "patch")
        return _request(target, { ...b, method: "PATCH", body: a })
    }

    /**
     * Create an HTTP client with a fixed base URL.
     *
     * Relative paths are prefixed with baseUrl. Absolute URLs pass through.
     *
     * Example:
     *   const api = withBaseUrl("https://api.example.com")
     *   const user = get(api, "/users/42")
     *
     * @param baseUrl — the URL prefix
     * @param wrapped — optional existing client whose defaults + auth are kept
     */
    export function withBaseUrl(baseUrl, wrapped) {
        const base = wrapped is given ? wrapped : _NO_CLIENT
        return _makeClient(baseUrl, base.defaults, base.authorization)
    }

    /**
     * Check if a response indicates success (2xx status).
     */
    export function isOk(response) {
        return response && response.ok == true
    }

    /**
     * Check if a response indicates a client or server error (4xx or 5xx).
     */
    export function isError(response) {
        return response && response.status >= 400
    }

    // -- Client composition (S57 Tier 3; config structs since S462) -----------
    // Each `with...` returns a NEW HttpClient built from an optional `wrapped`
    // client, so they compose by nesting:
    //   withAuth(token, "Bearer", withDefaults({ timeout: 30000 }, withBaseUrl(url)))

    /**
     * Create a client that adds an Authorization header to every request.
     * The header beats a per-call `headers.Authorization`; wrapping a client
     * that already has one REPLACES it (the outermost withAuth wins).
     *
     * Examples:
     *   const api = withAuth("my-jwt-token")              // → "Bearer my-jwt-token"
     *   const api = withAuth("creds", "Basic")            // → "Basic creds"
     *   const api = withAuth("xyz", "Bearer", baseClient) // wrap an existing client
     *
     * @param token   — token string (will be prefixed with the scheme)
     * @param scheme  — auth scheme ("Bearer" default; "Basic", "Token", etc.)
     * @param wrapped — optional existing client whose base URL + defaults are kept
     */
    export function withAuth(token, scheme, wrapped) {
        const sch = scheme || "Bearer"
        const base = wrapped is given ? wrapped : _NO_CLIENT
        return _makeClient(base.baseUrl, base.defaults, `${sch} ${token}`)
    }

    /**
     * Create a client that injects default options (headers, timeout, retry,
     * retryDelay) into every request. Per-call options override the defaults;
     * headers merge by key. Wrapping a client merges these defaults OVER its
     * own.
     *
     * Example:
     *   const api = withDefaults({ timeout: 30000, retry: 3, retryDelay: 500 })
     *   get(api, "/slow-endpoint")  // gets the 30s timeout + 3 retries
     *
     * @param defaults — option object merged into every call's opts
     * @param wrapped  — optional existing client whose base URL + auth are kept
     */
    export function withDefaults(defaults, wrapped) {
        const base = wrapped is given ? wrapped : _NO_CLIENT
        return _makeClient(base.baseUrl, _mergeOptions(base.defaults, defaults), base.authorization)
    }

    /**
     * Generic retry-with-exponential-backoff-and-jitter for any async function.
     *
     * Useful when the operation is NOT a single HTTP call (use the built-in
     * `retry` option for that) — e.g., a multi-step transaction, a chain of
     * dependent fetches, or a non-HTTP async operation.
     *
     * Backoff: delay = baseDelay * (factor ^ attempt) ± jitter%.
     *
     * @param fn          — async function to execute (called with no args)
     * @param opts        — data only: { maxRetries: 3, baseDelay: 200, factor: 2, jitter: 0.2 }
     * @param shouldRetry — optional function (err) → boolean; false stops retrying.
     *                      A positional argument, not an options field (S462: a
     *                      function is passed, never stored in a value). An
     *                      `opts.shouldRetry` is refused rather than ignored.
     *
     * Example:
     *   retry(() => syncOrder(id), { maxRetries: 5 }, (err) => err.name != "AuthError")
     * @returns the resolved value of fn, or rethrows the last error after exhaustion
     *
     * safeCallAsync-gap: await fn() is an async-throwing call. synchronous
     * safeCall cannot catch async throws. This try/catch is retained until
     * safeCallAsync is available. Tracked as Phase 3a partial.
     */
    export async function retry(fn, opts, shouldRetry) {
        const o = opts || {}
        if (o.shouldRetry is given) {
            throw new Error("[scrml:http] retry: shouldRetry is the third argument — retry(fn, opts, shouldRetry) — not an opts field")
        }
        if (shouldRetry is given && typeof shouldRetry != "function") {
            throw new TypeError("[scrml:http] retry: shouldRetry must be a function (err) => boolean — retry(fn, opts, shouldRetry)")
        }
        const maxRetries = o.maxRetries is given ? o.maxRetries : 3
        const baseDelay  = o.baseDelay  is given ? o.baseDelay  : 200
        const factor     = o.factor     is given ? o.factor     : 2
        const jitter     = o.jitter     is given ? o.jitter     : 0.2

        let lastErr = not
        for (let attempt = 0; attempt <= maxRetries; attempt++) {
            try {
                return await fn()
            } catch (err) {
                lastErr = err
                if (attempt == maxRetries) break
                if (shouldRetry is given && !shouldRetry(err)) break
                const base = baseDelay * Math.pow(factor, attempt)
                const jitterAmt = base * jitter * (random() * 2 - 1)
                const delay = Math.max(0, base + jitterAmt)
                await new Promise(r => setTimeout(r, delay))
            }
        }
        throw lastErr
    }

    /**
     * Build a multipart/form-data body suitable for `fetch()`.
     *
     * Returns a FormData object — the fetch() Content-Type header will be
     * set automatically (with the correct boundary) when FormData is the body.
     *
     * Examples:
     *   const body = multipart({ name: "alice", file: fileBlob })
     *   await post("/upload", body)   // do NOT set Content-Type yourself
     *
     * @param fields — object { fieldName: value }; values can be strings,
     *                 numbers, Blobs, or Files
     */
    export function multipart(fields) {
        const fd = new FormData()
        for (const [k, v] of Object.entries(fields || {})) {
            if (v is not) continue
            if (v instanceof Blob || v instanceof File) {
                fd.append(k, v)
            } else {
                fd.append(k, String(v))
            }
        }
        return fd
    }

    /**
     * Upload a file via multipart/form-data POST. Convenience wrapper.
     *
     * @param url     — destination URL
     * @param file    — Blob or File
     * @param opts    — { fieldName: "file", extraFields: {...}, ...request opts }
     */
    export async function uploadFile(url, file, opts) {
        const o = opts || {}
        const fieldName = o.fieldName || "file"
        const extras = o.extraFields || {}
        const fields = Object.assign({}, extras, { [fieldName]: file })
        const body = multipart(fields)
        const requestOpts = Object.assign({}, o, { body, fieldName: not, extraFields: not })
        return await _request(url, Object.assign({ method: "POST" }, requestOpts))
    }

    ~{
        import { assertEqual, assertTruthy, assertFalsy } from 'scrml:test'

        assertTruthy(isOk({ ok: true, status: 200 }))
        assertFalsy(isOk({ ok: false, status: 404 }))
        assertFalsy(isOk(not))
        assertTruthy(isError({ ok: false, status: 400 }))
        assertTruthy(isError({ ok: false, status: 500 }))
        assertFalsy(isError({ ok: true, status: 200 }))

        // -- Clients are config structs (S462) --------------------------------
        const client = withBaseUrl("https://api.example.com/")
        assertEqual(client.baseUrl, "https://api.example.com/")
        assertTruthy(_isClient(client))
        assertFalsy(_isClient("https://api.example.com"))
        assertEqual(_clientUrl(client, "/users/42"), "https://api.example.com/users/42")
        assertEqual(_clientUrl(client, "users"), "https://api.example.com/users")
        assertEqual(_clientUrl(client, "https://other.com/p"), "https://other.com/p")

        // withAuth — sets the Authorization header value; outermost wins
        const auth = withAuth("token-xyz")
        assertEqual(auth.authorization, "Bearer token-xyz")
        assertEqual(withAuth("new", "Bearer", auth).authorization, "Bearer new")
        const authOpts = _clientOptions(auth, { headers: { Authorization: "x", "X-A": "1" } })
        assertEqual(authOpts.headers.Authorization, "Bearer token-xyz")
        assertEqual(authOpts.headers["X-A"], "1")

        // withDefaults — per-call options override; headers merge by key
        const defaults = withDefaults({ timeout: 5000, headers: { "X-A": "1" } }, client)
        assertEqual(defaults.baseUrl, "https://api.example.com/")
        const callOpts = _clientOptions(defaults, { timeout: 100, headers: { "X-B": "2" } })
        assertEqual(callOpts.timeout, 100)
        assertEqual(callOpts.headers["X-A"], "1")
        assertEqual(callOpts.headers["X-B"], "2")

        // multipart returns a FormData
        const fd = multipart({ name: "alice", count: 3 })
        assertTruthy(fd instanceof FormData)
    }
}
</program>
