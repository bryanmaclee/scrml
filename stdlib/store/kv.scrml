<program>
${
    // ---------------------------------------------------------------------------
    // scrml:store/kv — SQLite-backed key-value store
    //
    // A simple persistent key-value store using bun:sqlite.
    // All operations are synchronous (SQLite is synchronous in Bun).
    //
    // IMPORTANT: These functions use bun:sqlite, which is a server-side only
    // dependency. They escalate to server by §12.2 inference (the bun:sqlite
    // import + the `?{}` SQL contexts they invoke). No keyword annotation
    // is required at the call site.
    //
    // Schema:
    //   CREATE TABLE IF NOT EXISTS kv_store (
    //     namespace TEXT NOT NULL,
    //     key TEXT NOT NULL,
    //     value TEXT NOT NULL,
    //     expires_at INTEGER,
    //     PRIMARY KEY (namespace, key)
    //   )
    //
    // TTL: entries with expires_at set are expired lazily on get().
    // ---------------------------------------------------------------------------

    import Database from "bun:sqlite"
    import { safeCall, HostError } from 'scrml:host'

    /**
     * KvError — error type for scrml:store/kv failable operations.
     *
     * ParseFailed is produced by get(store, key) when the stored JSON value is
     * malformed and JSON.parse throws.
     */
    export type KvError:enum = {
        ParseFailed(message: string)
    }

    function _initDb(db) {
        db.run(`
            CREATE TABLE IF NOT EXISTS kv_store (
                namespace TEXT NOT NULL,
                key TEXT NOT NULL,
                value TEXT NOT NULL,
                expires_at INTEGER,
                PRIMARY KEY (namespace, key)
            )
        `)
    }

    /**
     * KvStore — a key-value store handle (S462: a config/state STRUCT, not an
     * object of methods; a function is never stored in a value, §14.3).
     *
     *   namespace  — key-isolation prefix
     *   db         — the bun:sqlite Database
     *   statements — the prepared statements the free functions below run
     *
     * Pass it as the first argument of get / set / del / has / keys / clear /
     * close / purgeExpired (and, for a counter, increment / decrement / count /
     * resetCount).
     */
    export type KvStore:struct = {
        namespace: string,
        db: asIs,
        statements: asIs
    }

    /**
     * Create a key-value store backed by a SQLite file.
     *
     * @param dbPath    — file path for SQLite DB, or ":memory:" for in-memory
     * @param namespace — optional prefix for key isolation (default: "default")
     * @returns KvStore
     *
     * Example:
     *   const store = createStore("./data/app.db")
     *   set(store, "user:1", { name: "Alice" })
     *   const user = get(store, "user:1") !{ .ParseFailed(m) :> not }
     *
     *   // With TTL (auto-expires after 60 seconds):
     *   set(store, "session:abc", { userId: 1 }, 60)
     */
    export function createStore(dbPath, namespace) {
        const ns = namespace || "default"
        const db = new Database(dbPath)
        _initDb(db)

        const statements = {
            get: db.prepare(
                "SELECT value, expires_at FROM kv_store WHERE namespace = ? AND key = ?"
            ),
            set: db.prepare(
                "INSERT OR REPLACE INTO kv_store (namespace, key, value, expires_at) VALUES (?, ?, ?, ?)"
            ),
            delete: db.prepare(
                "DELETE FROM kv_store WHERE namespace = ? AND key = ?"
            ),
            keys: db.prepare(
                "SELECT key FROM kv_store WHERE namespace = ? AND (expires_at IS NULL OR expires_at > ?)"
            ),
            keysPrefix: db.prepare(
                "SELECT key FROM kv_store WHERE namespace = ? AND substr(key, 1, length(?)) = ? AND (expires_at IS NULL OR expires_at > ?)"
            ),
            clear: db.prepare(
                "DELETE FROM kv_store WHERE namespace = ?"
            ),
            deleteExpired: db.prepare(
                "DELETE FROM kv_store WHERE namespace = ? AND expires_at IS NOT NULL AND expires_at <= ?"
            )
        }

        return { namespace: ns, db: db, statements: statements }
    }

    /**
     * Get a value by key.
     * Returns parsed JSON value, or `not` if not found or expired.
     * Fails with KvError::ParseFailed if the stored value is malformed JSON.
     */
    export function get(store, key) ! -> KvError {
        const now = Date.now()
        const row = store.statements.get.get(store.namespace, key)
        if (!row) return not
        if (row.expires_at is some && row.expires_at <= now) {
            store.statements.delete.run(store.namespace, key)
            return not
        }
        return safeCall(() => JSON.parse(row.value)) !{
            .Thrown(msg, name) :> {
                fail KvError::ParseFailed(msg)
            }
        }
    }

    /**
     * Set a value by key.
     * @param ttl — time to live in seconds (optional)
     */
    export function set(store, key, value, ttl) {
        const expiresAt = ttl ? Date.now() + ttl * 1000 : not
        store.statements.set.run(store.namespace, key, JSON.stringify(value), expiresAt)
    }

    /**
     * Delete a key. Named `del` — `delete` is a reserved keyword.
     */
    export function del(store, key) {
        store.statements.delete.run(store.namespace, key)
    }

    /**
     * Check if a key exists and has not expired.
     */
    export function has(store, key) {
        const now = Date.now()
        const row = store.statements.get.get(store.namespace, key)
        if (!row) return false
        if (row.expires_at is some && row.expires_at <= now) {
            store.statements.delete.run(store.namespace, key)
            return false
        }
        return true
    }

    /**
     * List all non-expired keys, optionally filtered by a prefix.
     */
    export function keys(store, prefix) {
        const now = Date.now()
        if (prefix) {
            // Exact, case-SENSITIVE prefix match (LIKE is case-insensitive in SQLite).
            const rows = store.statements.keysPrefix.all(store.namespace, prefix, prefix, now)
            return rows.map(r => r.key)
        }
        const rows = store.statements.keys.all(store.namespace, now)
        return rows.map(r => r.key)
    }

    /**
     * Remove all keys in this store's namespace.
     */
    export function clear(store) {
        store.statements.clear.run(store.namespace)
    }

    /**
     * Close the database connection.
     */
    export function close(store) {
        store.db.close()
    }

    /**
     * Remove all expired entries from this namespace (maintenance).
     * Normally not needed — get() lazily removes expired entries on access.
     */
    export function purgeExpired(store) {
        store.statements.deleteExpired.run(store.namespace, Date.now())
    }

    /**
     * Create a session-scoped store (namespace = "session").
     * Convenience wrapper for createStore with session isolation.
     *
     * Example:
     *   const sessions = createSessionStore("./data/sessions.db")
     *   set(sessions, sessionId, { userId: 42 }, 3600)  // expires in 1 hour
     */
    export function createSessionStore(dbPath) {
        return createStore(dbPath, "session")
    }

    /**
     * Create an atomic counter store — a KvStore in the "counters" namespace
     * (by default) whose values are integers. Use increment / decrement /
     * count / resetCount on it; close() closes it like any store.
     *
     * @param dbPath    — file path for SQLite DB, or ":memory:" for in-memory
     * @param namespace — optional namespace (default: "counters")
     *
     * Example:
     *   const counters = createCounter("./data/counters.db")
     *   increment(counters, "page_views")   // → 1
     *   increment(counters, "page_views")   // → 2
     *   count(counters, "page_views")       // → 2
     */
    export function createCounter(dbPath, namespace) {
        return createStore(dbPath, namespace || "counters")
    }

    /**
     * Increment a counter by `by` (default: 1). Returns the new value.
     */
    export function increment(counter, key, by) {
        const current = get(counter, key) !{ .ParseFailed(m) :> 0 } || 0
        const next = current + (by is some ? by : 1)
        set(counter, key, next)
        return next
    }

    /**
     * Decrement a counter by `by` (default: 1). Returns the new value.
     */
    export function decrement(counter, key, by) {
        const current = get(counter, key) !{ .ParseFailed(m) :> 0 } || 0
        const next = current - (by is some ? by : 1)
        set(counter, key, next)
        return next
    }

    /**
     * Get the current value of a counter (0 if not set).
     */
    export function count(counter, key) {
        return get(counter, key) !{ .ParseFailed(m) :> 0 } || 0
    }

    /**
     * Set a counter back to 0. Named `resetCount` — `reset` is a reserved
     * scrml keyword (§6.8).
     */
    export function resetCount(counter, key) {
        set(counter, key, 0)
    }

    ~{
        import { assertEqual, assertTruthy, assertFalsy } from 'scrml:test'

        // Use :memory: for tests — no filesystem side effects
        const store = createStore(":memory:")

        // set + get — get is failable, handle with !{}
        set(store, "hello", "world")
        assertEqual(get(store, "hello") !{ .ParseFailed(m) :> not }, "world")

        // JSON value
        set(store, "user", { name: "Alice", age: 30 })
        const user = get(store, "user") !{ .ParseFailed(m) :> not }
        assertEqual(user.name, "Alice")
        assertEqual(user.age, 30)

        // has
        assertTruthy(has(store, "hello"))
        assertFalsy(has(store, "nonexistent"))

        // del
        del(store, "hello")
        assertFalsy(has(store, "hello"))
        assertFalsy(get(store, "hello") !{ .ParseFailed(m) :> not } is some)

        // keys
        set(store, "a", 1)
        set(store, "b", 2)
        set(store, "c", 3)
        const allKeys = keys(store)
        assertTruthy(allKeys.includes("a"))
        assertTruthy(allKeys.includes("b"))

        // keys with prefix
        set(store, "prefix:one", 1)
        set(store, "prefix:two", 2)
        set(store, "other", 3)
        const prefixKeys = keys(store, "prefix:")
        assertTruthy(prefixKeys.includes("prefix:one"))
        assertTruthy(prefixKeys.includes("prefix:two"))
        assertFalsy(prefixKeys.includes("other"))

        // clear
        clear(store)
        assertEqual(keys(store).length, 0)
        close(store)

        // createCounter
        const counter = createCounter(":memory:")
        assertEqual(count(counter, "hits"), 0)
        assertEqual(increment(counter, "hits"), 1)
        assertEqual(increment(counter, "hits"), 2)
        assertEqual(increment(counter, "hits", 5), 7)
        assertEqual(decrement(counter, "hits", 2), 5)
        resetCount(counter, "hits")
        assertEqual(count(counter, "hits"), 0)
        close(counter)
    }
}
</program>
