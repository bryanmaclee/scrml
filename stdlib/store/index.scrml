<program>
${
    // ---------------------------------------------------------------------------
    // scrml:store — SQLite-backed key-value store and counters
    //
    // Re-exports all functions from kv.scrml.
    //
    // A store is a KvStore config/state STRUCT (S462) — pass it as the first
    // argument of the free functions; it holds no functions of its own.
    //
    // Usage:
    //   ${ import { createStore, set, get } from 'scrml:store' }
    //
    //   function saveSession(id, data) {
    //       const sessions = createStore("./data/sessions.db", "sessions")
    //       set(sessions, id, data, 3600)  // expires in 1 hour
    //   }
    // ---------------------------------------------------------------------------

    export { KvError, KvStore } from './kv.scrml'
    export { createStore, createSessionStore, createCounter } from './kv.scrml'
    export { get, set, del, has, keys, clear, close, purgeExpired } from './kv.scrml'
    export { increment, decrement, count, resetCount } from './kv.scrml'
}
</program>
