<program>
${
    // ---------------------------------------------------------------------------
    // scrml:data/validate — validation rules as DATA, and the schema validator
    //
    // A rule is a value of the `Rule` enum. A schema is plain data: an object
    // mapping each field name to an array of rules. `validate` matches on each
    // rule. No rule holds a function (S462 — "no value holds a function").
    //
    // Returns a ValidationResult: { [fieldName]: string[] } where each field
    // maps to an array of error messages. Empty object = all valid.
    //
    // Usage:
    //   import { validate, isValid, Rule } from 'scrml:data'
    //
    //   const errors = validate(
    //       { email: @email, password: @password },
    //       { email: [Rule.Req, Rule.Email], password: [Rule.Req, Rule.MinLength(8)] }
    //   )
    //   if (!isValid(errors)) { @formErrors = errors }
    //
    // A developer-defined check is a NAMED rule, `Rule.Custom(tag)`, plus ONE
    // check function PASSED to `validate` as its third argument. `validate`
    // calls it as `check(tag, value, data)`; it returns `true` (valid) or a
    // string (the error message), and any other result reads "Invalid value".
    // The function is passed at the call, never stored in the schema.
    //
    //   function checkOrder(tag, value, data) {
    //       if (tag == "sku") { return isSku(value) ? true : "Not a valid SKU" }
    //       return true
    //   }
    //   const errors = validate(@order, { sku: [Rule.Req, Rule.Custom("sku")] }, checkOrder)
    //
    // A `Rule.Custom` with no check function passed FAILS, with a message that
    // names the missing check. It never passes silently.
    // ---------------------------------------------------------------------------

    /**
     * Rule — one validation predicate, as data.
     *
     * The variants that overlap the SPEC §55.1 universal-core vocabulary carry
     * its words: `Req` (§55.1 `req`), `Pattern` (`pattern`), `Min` (`min`),
     * `Max` (`max`), `OneOf` (`oneOf`). The rest belong to this library:
     *
     *   MinLength / MaxLength / ExactLength — string length bounds
     *   Matches(field)     — equals another field of the same data object
     *   Email / Url        — format checks
     *   Numeric / Integer  — number-shape checks
     *   Custom(tag)        — a developer check, run by the `check` argument of
     *                        `validate` (mirrors §55.9 `ValidationError.Custom`)
     *   WithMessage(rule, message) — `rule`, with `message` replacing its
     *                        failure message (an empty message keeps the rule's
     *                        own)
     *
     * `Pattern`, the three length rules, `Email`, `Url`, `Numeric` and `Integer`
     * pass an EMPTY value — pair them with `Rule.Req` to require the field.
     */
    export type Rule:enum = {
        Req,
        Pattern(re: regex),
        Min(threshold: number),
        Max(threshold: number),
        OneOf(set: array),
        MinLength(len: number),
        MaxLength(len: number),
        ExactLength(len: number),
        Matches(field: string),
        Email,
        Url,
        Numeric,
        Integer,
        Custom(tag: string),
        WithMessage(rule: Rule, message: string)
    }

    /**
     * Run every rule of a schema against a data object.
     *
     * @param data   - Object of field values { fieldName: value }
     * @param schema - Object of rule arrays { fieldName: [Rule, Rule, ...] }
     * @param check  - Optional. Runs the `Rule.Custom(tag)` rules:
     *                 `check(tag, value, data)` returns `true` or a message.
     * @returns { [fieldName]: string[] } — empty object if all valid
     */
    export function validate(data, schema, check) {
        const errors = {}
        for (const field of Object.keys(schema)) {
            const value = data[field]
            for (const rule of schema[field]) {
                const message = ruleFailure(rule, value, data, check)
                if (message is not) { continue }
                errors[field] = errors[field] || []
                errors[field].push(message)
            }
        }
        return errors
    }

    /**
     * Check if a validation result has any errors.
     * Useful as a guard before form submission.
     */
    export function isValid(result) {
        return Object.keys(result).length == 0
    }

    /**
     * Get the first error for a field, or `not` if valid.
     * Convenient for displaying single-error UIs.
     */
    export function firstError(result, field) {
        const errs = result[field]
        return errs && errs.length > 0 ? errs[0] : not
    }

    // ---------------------------------------------------------------------------
    // Rule evaluation — the failure message of one rule, or `not` when it passes
    // ---------------------------------------------------------------------------

    function isEmpty(value) {
        return value is not || value == ""
    }

    function ruleFailure(rule: Rule, value, data, check) {
        return match rule {
            .Req :> messageUnless(!isEmpty(value), "This field is required")
            .Pattern(re) :> messageUnless(!value || re.test(String(value)), "Invalid format")
            .Min(threshold) :> messageUnless(Number(value) >= threshold, `Must be at least ${threshold}`)
            .Max(threshold) :> messageUnless(Number(value) <= threshold, `Must be at most ${threshold}`)
            .OneOf(set) :> messageUnless(set.includes(value), `Must be one of: ${set.join(", ")}`)
            .MinLength(len) :> messageUnless(!value || String(value).length >= len, `Must be at least ${len} characters`)
            .MaxLength(len) :> messageUnless(!value || String(value).length <= len, `Must be at most ${len} characters`)
            .ExactLength(len) :> messageUnless(!value || String(value).length == len, `Must be exactly ${len} characters`)
            .Matches(field) :> messageUnless(value == data[field], `Must match ${field}`)
            .Email :> messageUnless(!value || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(value)), "Enter a valid email address")
            .Url :> messageUnless(!value || URL.canParse(String(value)), "Enter a valid URL")
            .Numeric :> messageUnless(isEmpty(value) || !isNaN(Number(value)), "Must be a number")
            .Integer :> messageUnless(isEmpty(value) || Number.isInteger(Number(value)), "Must be a whole number")
            .Custom(tag) :> customFailure(tag, value, data, check)
            .WithMessage(inner, message) :> overrideMessage(ruleFailure(inner, value, data, check), message)
        }
    }

    function messageUnless(passes, message) {
        if (passes) { return not }
        return message
    }

    function customFailure(tag, value, data, check) {
        if (check is not) {
            return `No check function was passed to validate() for Rule.Custom("${tag}")`
        }
        const result = check(tag, value, data)
        if (result == true) { return not }
        return typeof result == "string" ? result : "Invalid value"
    }

    function overrideMessage(failure, message) {
        if (failure is not) { return not }
        return isEmpty(message) ? failure : message
    }

    // ---------------------------------------------------------------------------
    // Bridging external schema libraries (zod, valibot, arktype, etc.)
    // ---------------------------------------------------------------------------
    //
    // scrml does NOT ship a curated zod / standard-schema stdlib adapter. The
    // `Rule.Custom(tag)` + `check` slot above absorbs the bridge in a few
    // lines. Per SPEC §53.14.4 (synonym-detection canon) and design-insight 28
    // (2026-05-09): a curated stdlib export would be a synonym for the custom
    // check slot, not a sliver — closed by the synonym-detection rule.
    //
    // Pattern (verbatim, paste into your scrml file):
    //
    //     ${
    //         import { z } from 'zod'  // or valibot, arktype, etc.
    //         import { validate, Rule } from 'scrml:data'
    //
    //         const EmailSchema = z.string().email()
    //
    //         function bridged(tag, value) {
    //             if (tag == "email") {
    //                 const r = EmailSchema.safeParse(value)
    //                 return r.success ? true : r.error.issues[0].message
    //             }
    //             return true
    //         }
    //
    //         const errors = validate(@signup, { email: [Rule.Custom("email")] }, bridged)
    //     }
    //
    // For Standard-Schema-shaped libraries, swap `safeParse` for the
    // `~standard.validate` interop call. See standardschema.dev.
    //
    // Trade-offs (these apply to ANY bridged validator, not just zod):
    //
    //   - Bridged validators do NOT lower to schema-column DDL. SPEC §39.5.8
    //     CHECK constraints cannot call JS. A field declared with a bridged
    //     validator gets cell-level + refinement-level enforcement only;
    //     DBMS-level enforcement stays scrml-native or absent.
    //
    //   - Bridged validators do NOT inform HTML attribute inference.
    //     SPEC §53.7 native predicates auto-emit `min=`, `maxlength=`,
    //     `pattern=`, `required` etc. on bindable cells. Bridged schemas
    //     are opaque to scrml's compiler; their constraints stay runtime-
    //     only. You lose free HTML validation.
    //
    //   - Bridged errors land as `ValidationError::Custom(message)` per
    //     SPEC §55.9, not as structured-payload variants like
    //     `.MinFailed(threshold)`. Programmatic access to the threshold
    //     (e.g., to render a numeric input's `min=` attribute) is lost.
    //
    //   - Cross-locus consistency (L4) breaks at bridged validators —
    //     same shape as any custom check. The docs page is the
    //     mitigation regardless of bridge-or-not.
    //
    // For fields that need cross-locus enforcement (cell + refinement +
    // schema column + HTML), use scrml-native predicates (`length`,
    // `pattern`, `min`, `max`, named shapes). For sum-type boundary
    // parsing of incoming JSON (different mechanism, different locus),
    // see `parseVariant(json, EnumType)` per SPEC §41.13.
    //
    // Re-debate trigger (design-insight 28 OQ-bridge-2): if ≥3 adopters
    // report the bridge above as friction-felt at scale, the bridge
    // question reopens. Elevate the Standard-Schema-via-custom-check
    // type-dispatch shape on re-fire — NOT the per-library shape.

    // ---------------------------------------------------------------------------
    // Convenience: pre-built rule sets for common fields (plain data)
    // ---------------------------------------------------------------------------

    /**
     * Standard email field rules: required + email format.
     */
    export function emailField() {
        return [Rule.Req, Rule.Email]
    }

    /**
     * Standard password field rules: required + minimum 8 chars.
     */
    export function passwordField(minLen) {
        return [Rule.Req, Rule.MinLength(minLen || 8)]
    }

    /**
     * Standard password confirmation rules: required + matches "password" field.
     */
    export function passwordConfirmField(fieldName) {
        return [Rule.Req, Rule.WithMessage(Rule.Matches(fieldName || "password"), "Passwords must match")]
    }

    ~{
        import { assertEqual, assertTruthy } from 'scrml:test'

        // Req
        assertEqual(validate({ a: "" }, { a: [Rule.Req] }), { a: ["This field is required"] })
        assertEqual(validate({ a: not }, { a: [Rule.Req] }), { a: ["This field is required"] })
        assertEqual(validate({ a: "hello" }, { a: [Rule.Req] }), {})

        // Email — an empty value passes; pair with Rule.Req
        assertEqual(validate({ a: "test@example.com" }, { a: [Rule.Email] }), {})
        assertEqual(validate({ a: "notanemail" }, { a: [Rule.Email] }), { a: ["Enter a valid email address"] })
        assertEqual(validate({ a: "" }, { a: [Rule.Email] }), {})

        // MinLength
        assertEqual(validate({ a: "ab" }, { a: [Rule.MinLength(3)] }), { a: ["Must be at least 3 characters"] })
        assertEqual(validate({ a: "abc" }, { a: [Rule.MinLength(3)] }), {})

        // validate() over a whole schema
        const errors = validate(
            { email: "", password: "ab" },
            { email: [Rule.Req, Rule.Email], password: [Rule.Req, Rule.MinLength(8)] }
        )
        assertEqual(errors.email, ["This field is required"])
        assertEqual(errors.password, ["Must be at least 8 characters"])

        const clean = validate(
            { email: "a@b.com", password: "secure123" },
            { email: [Rule.Req, Rule.Email], password: [Rule.Req, Rule.MinLength(8)] }
        )
        assertTruthy(isValid(clean))

        // Matches + WithMessage
        const confirm = [Rule.WithMessage(Rule.Matches("password"), "Passwords must match")]
        assertEqual(validate({ password: "x", confirm: "x" }, { confirm: confirm }), {})
        assertEqual(validate({ password: "x", confirm: "y" }, { confirm: confirm }), { confirm: ["Passwords must match"] })

        // OneOf
        assertEqual(validate({ role: "admin" }, { role: [Rule.OneOf(["admin", "user"])] }), {})
        assertEqual(validate({ role: "root" }, { role: [Rule.OneOf(["admin", "user"])] }), { role: ["Must be one of: admin, user"] })

        // Custom — the check function is passed at the call, never stored
        function checkSku(tag, value) {
            return value == "SKU-1" ? true : "Not a known SKU"
        }
        assertEqual(validate({ sku: "SKU-1" }, { sku: [Rule.Custom("sku")] }, checkSku), {})
        assertEqual(validate({ sku: "nope" }, { sku: [Rule.Custom("sku")] }, checkSku), { sku: ["Not a known SKU"] })

        // firstError helper
        const res = validate({ name: "" }, { name: [Rule.Req] })
        assertEqual(firstError(res, "name"), "This field is required")
        assertEqual(firstError(res, "email"), not)
    }
}
</program>
