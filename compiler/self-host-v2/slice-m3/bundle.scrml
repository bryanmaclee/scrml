// =============================================================================
// self-host-v2 / slice-m3 / bundle.scrml — the compile ENTRY for the M3 ingest
// harness (the same device as slice-m1/bundle.scrml, progress.md F1 / F11):
// impl#1 lowers the library modules' `match` through its real emitter only
// when the compile set contains a `<program>` entry. This one imports the
// ingest shim and the M1 back end (check · print). It renders nothing.
// =============================================================================
<program>
    import { mkSym } from "../core.scrml"
    import { allNodes } from "../walk.scrml"
    import { printProgram } from "../print.scrml"
    import { checkCore } from "../check.scrml"
    import { countNodes } from "../measure.scrml"
    import { ingest, footprint } from "../ingest.scrml"

    fn bundleProbe() -> int { return mkSym(0, "probe").id }
</program>
