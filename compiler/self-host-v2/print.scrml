// =============================================================================
// self-host-v2 / print.scrml — Core → JS tree + HTML tree → text (slice M1).
//
// dpa-051 §3.3 / §3.6 / §5:
//   - Emitted text is WRITE-ONLY. This module builds JsStmt / HNode trees and
//     prints each once (js.scrml / html.scrml). No step reads emitted text; no
//     step calls a parser. Every decision comes from a Core fact.
//   - Names come from ONE NameSupply (names.scrml), planned before printing.
//     Printer-internal locals contain `$` and are derived from tree position.
//   - Per declaration (§5.2): a descriptor, edge tables (§5.4), a FACTORY
//     `mk_<decl>(inst$, …attrs)` that seeds an instance record, a RENDER
//     `render_<decl>(inst$, scope$, anchor$, slot$)` that registers every
//     effect/listener into the scope it is given, and a SHARED getter emitted
//     only if `.Shared(decl)` appears in Core.
//   - A field with a write capability (Field.wcap) becomes a writable Cell; a
//     field without one becomes a read-only Derived. The runtime shadow of the
//     Core fact: a locked/derived field has no setter to call.
//
// Views print as <template> content (compact HTML) + client code that clones a
// template, looks up every hole by child-index path FIRST (from the HNode tree
// this module built), then wires holes. Nested arms / rows / slots are their own
// templates, rendered into their own child scopes by the runtime.
//
// impl#1 workaround: F11 (named payload binding everywhere). (F12 — a non-first
// `|` alternation arm — and F13 — a ≥5-field payload arm — are fixed in impl#1
// by #1119; Stmt.Write / View.Each are bound in one arm again, S440.)
// =============================================================================
${
    import { Sym, Type, DeclKind, TypeDef, FieldDef, VariantDef, TransitionGraph, FieldRef, InstRef, Place, Literal, PrimOp, Pattern, Expr, MatchArm,
             HostCall, SeqFn, BindKind,
             EditKind, Check, Stmt, Block, Attr, ConstructAttr, CondArm, View, EffectDep, FieldRole, Field,
             Decl, Fn, CoreProgram, CapOwner, SurfaceProp, ValidityOf, Validator, Persist, PersistStore,
             Failable, OkArm, ErrArm, ServerFn,
             findDecl, findTypeDef, typeDefSym, capOwner, findFn, findServerFn } from "./core.scrml"
    import { Node, allNodes, sharedRefs, boundSyms, assignedSyms } from "./walk.scrml"
    import { JsOp, JsUnOp, JsExpr, JsProp, JsStmt,
             jid, jstr, jnum, jmember, jcall, jmcall, jthunk, sexpr, printModule } from "./js.scrml"
    import { HAttr, HNode, Page, printPage } from "./html.scrml"
    import { NameKey, NameTable, emptyNames, mint, nameOf } from "./names.scrml"
    import { WireTable, wireBuild, wireTableJs } from "./codec.scrml"
    import { emitCss } from "./css.scrml"

    export type Template:struct = { id: string, nodes: HNode[] }
    // s451 (U1a): `refused` — why the printer emitted NOTHING (empty `js` /
    // `html`); empty when it printed.
    // s454 (U1b): the printer emits the CLIENT artifact of a program with server
    // functions (design Item 4: "print the CLIENT artifact + manifest only");
    // `routes` is the manifest — every server function the client calls, by
    // name, and the route path its client call POSTs to. The server artifact
    // (the route handlers, the server half of the §57 codec) is unit U1c's.
    export type RouteOut:struct = { fn: string, path: string }
    export type Output:struct = { js: string, html: string, refused: string[], routes: RouteOut[] }

    type HandleLoc:struct = { sym: int, js: JsExpr }
    type SharedLoc:struct = { decl: int, js: JsExpr }

    // The print environment: how each InstRef / local / handle is reached from
    // the code being printed. A value, extended by copy — never mutated.
    type Ctx:struct = {
        p: CoreProgram,
        names: NameTable,
        lexical: JsExpr[],
        handles: HandleLoc[],
        shared: SharedLoc[],
        rows: int[],
        slot: JsExpr,
        prebuilt: boolean,
        // s454 (U1b): "" — ordinary code; else the name of the RESOLVE function a
        // waiting function's body returns through (`return ret$(v)`, below).
        ret: string,
    }

    type Rendered:struct = { stmts: JsStmt[], templates: Template[] }
    type Hole:struct = { path: int[], v: View }
    type Built:struct = { nodes: HNode[], holes: Hole[] }

    // -------------------------------------------------------------------------
    // Naming.
    // -------------------------------------------------------------------------
    fn planNames(p: CoreProgram) -> NameTable {
        let t: NameTable = mint(emptyNames(), NameKey.Runtime, "rt")
        for (const d of p.decls) {
            const h: string = d.sym.hint
            t = mint(t, NameKey.DeclInfo(d.sym.id), "decl_" + h)
            t = mint(t, NameKey.Factory(d.sym.id), "mk_" + h)
            t = mint(t, NameKey.Render(d.sym.id), "render_" + h)
            t = mint(t, NameKey.SharedGet(d.sym.id), "shared_" + h)
            let i = 0
            for (const f of d.fields) {
                if (f.graph is some) t = mint(t, NameKey.Edges(d.sym.id, i), h + "_" + f.sym.hint + "_edges")
                i = i + 1
            }
        }
        for (const f of p.fns) { t = mint(t, NameKey.OfSym(f.sym.id), f.sym.hint) }
        for (const s of boundSyms(Node.NProgram(p))) { t = mint(t, NameKey.OfSym(s.id), s.hint) }
        return t
    }

    fn symName(ctx: Ctx, s: Sym) -> string { return nameOf(ctx.names, NameKey.OfSym(s.id)) }
    fn rtName(ctx: Ctx) -> string { return nameOf(ctx.names, NameKey.Runtime) }
    fn rtCall(ctx: Ctx, f: string, args: JsExpr[]) -> JsExpr { return jcall(jmember(jid(rtName(ctx)), f), args) }

    fn pathText(path: int[]) -> string {
        const s: string = path.join("_")
        return s
    }
    fn nodeVar(path: int[]) -> string { return "n$" + pathText(path) }

    fn hasInt(xs: int[], x: int) -> boolean {
        for (const y of xs) { if (y == x) return true }
        return false
    }

    // -------------------------------------------------------------------------
    // Type-directed names read from Core (never re-derived from text).
    // -------------------------------------------------------------------------
    fn fieldHint(d: Decl, idx: int) -> string {
        if (idx < d.fields.length) return d.fields[idx].sym.hint
        return "field" + idx
    }

    // The property name of field `idx` of `owner` (a struct type or a declaration).
    fn memberName(ctx: Ctx, owner: Sym, idx: int) -> string {
        const t: TypeDef | not = findTypeDef(ctx.p, owner)
        if (t is some) return typeDefMember(t, idx)
        const d: Decl | not = findDecl(ctx.p, owner)
        if (d is some) return fieldHint(d, idx)
        return "field" + idx
    }

    fn typeDefMember(t: TypeDef, idx: int) -> string {
        return match t {
            .StructDef(fields: fs) :> memberAt(fs, idx)
            .EnumDef :> "field" + idx
        }
    }

    fn memberAt(fs: FieldDef[], idx: int) -> string {
        if (idx < fs.length) return fs[idx].sym.hint
        return "field" + idx
    }

    // The runtime tag of a variant (its declared name — data layout, not a minted name).
    fn variantTag(ctx: Ctx, enumSym: Sym, idx: int) -> string {
        const t: TypeDef | not = findTypeDef(ctx.p, enumSym)
        if (t is not) return "variant" + idx
        return enumVariantTag(t, idx)
    }

    fn enumVariantTag(t: TypeDef, idx: int) -> string {
        return match t {
            .EnumDef(variants: vs) :> variantAt(vs, idx)
            .StructDef :> "variant" + idx
        }
    }

    fn variantAt(vs: VariantDef[], idx: int) -> string {
        if (idx < vs.length) return vs[idx].sym.hint
        return "variant" + idx
    }

    fn variantHasFields(ctx: Ctx, enumSym: Sym, idx: int) -> boolean {
        const t: TypeDef | not = findTypeDef(ctx.p, enumSym)
        if (t is not) return false
        return enumVariantArity(t, idx) > 0
    }

    fn enumVariantArity(t: TypeDef, idx: int) -> int {
        return match t {
            .EnumDef(variants: vs) :> variantArity(vs, idx)
            .StructDef :> 0
        }
    }

    fn variantArity(vs: VariantDef[], idx: int) -> int {
        if (idx < vs.length) return vs[idx].fields.length
        return 0
    }

    fn variantFieldName(ctx: Ctx, enumSym: Sym, idx: int, j: int) -> string {
        const t: TypeDef | not = findTypeDef(ctx.p, enumSym)
        if (t is not) return "field" + j
        return enumVariantField(t, idx, j)
    }

    fn enumVariantField(t: TypeDef, idx: int, j: int) -> string {
        return match t {
            .EnumDef(variants: vs) :> variantFieldAt(vs, idx, j)
            .StructDef :> "field" + j
        }
    }

    fn variantFieldAt(vs: VariantDef[], idx: int, j: int) -> string {
        if (idx < vs.length) return memberAt(vs[idx].fields, j)
        return "field" + j
    }

    // -------------------------------------------------------------------------
    // Instances, handles, places.
    // -------------------------------------------------------------------------
    fn instJs(ctx: Ctx, i: InstRef) -> JsExpr {
        return match i {
            .Shared(decl: d) :> sharedJs(ctx, d)
            .Lexical(depth: k) :> lexicalJs(ctx, k)
            .Alias(sym: s) :> jmcall(handleJs(ctx, s), "get", [])
            .Narrowed(sym: s) :> jid(symName(ctx, s))
        }
    }

    fn lexicalJs(ctx: Ctx, k: int) -> JsExpr {
        if (k < ctx.lexical.length) return ctx.lexical[k]
        return jid("unboundLexical$" + k)
    }

    fn sharedJs(ctx: Ctx, d: Sym) -> JsExpr {
        for (const s of ctx.shared) {
            if (s.decl == d.id) return s.js
        }
        return jcall(jid(nameOf(ctx.names, NameKey.SharedGet(d.id))), [])
    }

    // Where the cell of `as=` handle `s` lives: the enclosing row / renders
    // environment, else the owning `single` declaration's shared instance.
    fn handleJs(ctx: Ctx, s: Sym) -> JsExpr {
        for (const h of ctx.handles) {
            if (h.sym == s.id) return h.js
        }
        for (const d of ctx.p.decls) {
            let k = 0
            for (const hs of d.handles) {
                if (hs.id == s.id) return handleSlot(sharedJs(ctx, d.sym), k, hs.hint)
                k = k + 1
            }
        }
        return jid("unboundHandle$" + s.id)
    }

    fn handleSlot(inst: JsExpr, k: int, hint: string) -> JsExpr {
        return JsExpr.JIndex(jmember(inst, "handles"), JsExpr.JAnnot(jnum(k), hint))
    }

    // `inst.fields[i /* name */]` — the field's signal.
    fn fieldCell(inst: JsExpr, d: Decl, idx: int) -> JsExpr {
        return JsExpr.JIndex(jmember(inst, "fields"), JsExpr.JAnnot(jnum(idx), fieldHint(d, idx)))
    }

    fn localRead(ctx: Ctx, s: Sym) -> JsExpr {
        if (hasInt(ctx.rows, s.id)) return jmcall(jid(symName(ctx, s)), "get", [])
        return jid(symName(ctx, s))
    }

    fn pathMembers(ctx: Ctx, base: JsExpr, path: FieldRef[], from: int) -> JsExpr {
        let e: JsExpr = base
        let i: int = from
        while (i < path.length) {
            e = jmember(e, memberName(ctx, path[i].owner, path[i].idx))
            i = i + 1
        }
        return e
    }

    fn placeJs(ctx: Ctx, pl: Place) -> JsExpr {
        return match pl {
            .Cell(decl: d, inst: i, path: path) :> cellReadJs(ctx, d, i, path)
            .LocalPath(sym: s, path: path) :> pathMembers(ctx, localRead(ctx, s), path, 0)
        }
    }

    fn cellReadJs(ctx: Ctx, dsym: Sym, i: InstRef, path: FieldRef[]) -> JsExpr {
        if (path.length == 0) return rtCall(ctx, "snapshot", [instJs(ctx, i)])
        const d: Decl | not = findDecl(ctx.p, dsym)
        if (d is not) return jid("unboundDecl$" + dsym.id)
        const sig: JsExpr = fieldCell(instJs(ctx, i), d, path[0].idx)
        return pathMembers(ctx, jmcall(sig, "get", []), path, 1)
    }

    // -------------------------------------------------------------------------
    // Expressions.
    // -------------------------------------------------------------------------
    fn exprsJs(ctx: Ctx, es: Expr[]) -> JsExpr[] {
        let out: JsExpr[] = []
        for (const e of es) { out = out.concat([exprJs(ctx, e)]) }
        return out
    }

    fn exprJs(ctx: Ctx, e: Expr) -> JsExpr {
        return match e {
            .Lit(lit: l) :> litJs(ctx, l)
            .Local(sym: s) :> localRead(ctx, s)
            .Read(place: pl) :> placeJs(ctx, pl)
            .Call(callee: f, args: args) :> callJs(ctx, f, args)
            .Prim(op: op, args: args) :> primJs(ctx, op, exprsJs(ctx, args))
            .Match(scrut: s, arms: arms) :> matchJs(ctx, s, arms)
            .ArrayOf(elems: es) :> JsExpr.JArray(exprsJs(ctx, es))
            .StructOf(ty: ty, fields: fs) :> structJs(ctx, ty, fs)
            .Handle(inst: i) :> instJs(ctx, i)
            .InitOf(decl: d, inst: i, idx: x) :> rtCall(ctx, "initial", [instJs(ctx, i), JsExpr.JAnnot(jnum(x), memberName(ctx, d, x))])
            .Host(call: c) :> hostJs(c)
            .Lambda(params: ps, body: b) :> JsExpr.JArrowE(symNames(ctx, ps), exprJs(ctx, b))
            .SeqCall(op: o, seq: sq, f: f) :> jmcall(exprJs(ctx, sq), seqFnName(o), [exprJs(ctx, f)])
            .Validity(of: v, prop: pr) :> jmcall(surfaceJs(ctx, v), surfaceMethod(pr), [])
            .ServerCall(fn: f, args: args) :> rtCall(ctx, "call", [jid(routeName(f)), JsExpr.JArray(exprsJs(ctx, args)), jid("task$")])
        }
    }

    // s454 (U1b) — a call of a WAITING client function (Fn.waits, §13.2 async
    // colour) hands it the caller's task first: its continuations run in that
    // task, so a cancelled caller cancels them too (design §2.3 "an
    // async-colored Fn invocation (inherits its caller's task)"). It stands only
    // as a Suspend's `on` (check.scrml C-S7 / C12), so `task$` is bound there.
    fn callJs(ctx: Ctx, f: Sym, args: Expr[]) -> JsExpr {
        const fd: Fn | not = findFn(ctx.p, f)
        if (fd is some) {
            if (fd.waits) return jcall(jid(symName(ctx, f)), [jid("task$")].concat(exprsJs(ctx, args)))
        }
        return jcall(jid(symName(ctx, f)), exprsJs(ctx, args))
    }

    // s454 (U1b) — the module constant describing server function `f`'s route
    // (path + the §57 wire tables its client call encodes / decodes with).
    fn routeName(f: Sym) -> string { return "route$" + f.hint.replaceAll("$", "_") }

    // s449 — the validity surface (§55.5 / §55.6): `rt.validity(inst, i)` is
    // field i's record, `rt.compound(inst)` the declaration's; a property is
    // a tracked read (`.isValid()`, `.errors()`, `.touched()`, `.submitted()`).
    fn surfaceJs(ctx: Ctx, v: ValidityOf) -> JsExpr {
        return match v {
            .OfField(decl: d, inst: i, idx: x) :> rtCall(ctx, "validity", [instJs(ctx, i), JsExpr.JAnnot(jnum(x), memberName(ctx, d, x))])
            .OfDecl(decl: d, inst: i) :> rtCall(ctx, "compound", [instJs(ctx, i)])
        }
    }

    fn surfacesJs(ctx: Ctx, fs: ValidityOf[]) -> JsExpr[] {
        let out: JsExpr[] = []
        for (const f of fs) { out = out.concat([surfaceJs(ctx, f)]) }
        return out
    }

    fn surfaceMethod(pr: SurfaceProp) -> string {
        return match pr {
            .IsValid :> "isValid"
            .Errors :> "errors"
            .Touched :> "touched"
            .Submitted :> "submitted"
        }
    }

    // s444 — the host calls Core admits, printed as the host spells them
    // (`Date` is a reserved name: no minted name shadows it, names.scrml).
    fn hostJs(c: HostCall) -> JsExpr {
        return match c {
            .DateNow :> jcall(jmember(jid("Date"), "now"), [])
        }
    }

    fn seqFnName(o: SeqFn) -> string {
        return match o {
            .Filter :> "filter"
            .Map :> "map"
        }
    }

    fn symNames(ctx: Ctx, ss: Sym[]) -> string[] {
        let out: string[] = []
        for (const s of ss) { out = out.concat([symName(ctx, s)]) }
        return out
    }

    fn litJs(ctx: Ctx, l: Literal) -> JsExpr {
        return match l {
            .Int(v: v) :> jnum(v)
            .Num(v: v) :> JsExpr.JNum("" + v)
            .Str(v: v) :> jstr(v)
            .Bool(v: v) :> JsExpr.JBool(v)
            .Variant(enumSym: es, idx: idx) :> jstr(variantTag(ctx, es, idx))
            .Absent :> JsExpr.JNull
        }
    }

    fn bin(op: JsOp, a: JsExpr[]) -> JsExpr { return JsExpr.JBin(op, a[0], a[1]) }

    fn primJs(ctx: Ctx, op: PrimOp, a: JsExpr[]) -> JsExpr {
        return match op {
            .Add :> bin(JsOp.Plus, a)
            .Sub :> bin(JsOp.Minus, a)
            .Mul :> bin(JsOp.Times, a)
            .Div :> bin(JsOp.Div, a)
            .Mod :> bin(JsOp.Mod, a)
            .Neg :> JsExpr.JUn(JsUnOp.Neg, a[0])
            .Not :> JsExpr.JUn(JsUnOp.Not, a[0])
            .And :> bin(JsOp.And, a)
            .Or :> bin(JsOp.Or, a)
            .Lt :> bin(JsOp.Lt, a)
            .Le :> bin(JsOp.Le, a)
            .Gt :> bin(JsOp.Gt, a)
            .Ge :> bin(JsOp.Ge, a)
            .EqPrim :> bin(JsOp.StrictEq, a)
            .NeqPrim :> bin(JsOp.StrictNe, a)
            .EqStruct :> rtCall(ctx, "eq", a)
            .NeqStruct :> JsExpr.JUn(JsUnOp.Not, rtCall(ctx, "eq", a))
            .IsSome :> JsExpr.JBin(JsOp.LooseNe, a[0], JsExpr.JNull)
            .IsNot :> JsExpr.JBin(JsOp.LooseEq, a[0], JsExpr.JNull)
            .Concat :> bin(JsOp.Plus, a)
            .Length :> jmember(a[0], "length")
        }
    }

    fn structJs(ctx: Ctx, ty: Sym, fs: Expr[]) -> JsExpr {
        let props: JsProp[] = []
        let i = 0
        for (const f of fs) {
            props = props.concat([{ key: memberName(ctx, ty, i), value: exprJs(ctx, f) }])
            i = i + 1
        }
        return JsExpr.JObject(props)
    }

    // 1 = `true` literal pattern, 0 = `false`, -1 = anything else.
    fn patBool(p: Pattern) -> int {
        return match p {
            .PLit(lit: l) :> litBool(l)
            .PVariant :> -1
            .PWild :> -1
        }
    }

    fn litBool(l: Literal) -> int {
        return match l {
            .Bool(v: v) :> boolInt(v)
            .Int :> -1
            .Num :> -1
            .Str :> -1
            .Variant :> -1
            .Absent :> -1
        }
    }

    fn boolInt(b: boolean) -> int {
        if (b) return 1
        return 0
    }

    // A match over a boolean with exactly a `true` and a `false` arm is a JS
    // conditional (the lowering of `c ? a : b` / if-as-expression). Any other
    // match is an arrow applied to the scrutinee, one `if` per arm, the last
    // arm unconditional (Core matches are exhaustive).
    fn matchJs(ctx: Ctx, scrut: Expr, arms: MatchArm[]) -> JsExpr {
        if (arms.length == 2) {
            const a: int = patBool(arms[0].pat)
            const b: int = patBool(arms[1].pat)
            if (a == 1 && b == 0) return JsExpr.JCond(exprJs(ctx, scrut), exprJs(ctx, arms[0].body), exprJs(ctx, arms[1].body))
            if (a == 0 && b == 1) return JsExpr.JCond(exprJs(ctx, scrut), exprJs(ctx, arms[1].body), exprJs(ctx, arms[0].body))
        }
        let body: JsStmt[] = []
        let i = 0
        for (const arm of arms) {
            const ret: JsStmt[] = patBinds(ctx, arm.pat, jid("m$")).concat([JsStmt.SReturn(exprJs(ctx, arm.body))])
            if (i == arms.length - 1) {
                body = body.concat(ret)
            } else {
                body = body.concat([JsStmt.SIf(patTest(ctx, arm.pat, jid("m$")), ret, [])])
            }
            i = i + 1
        }
        return jcall(JsExpr.JArrow(["m$"], body), [exprJs(ctx, scrut)])
    }

    // A pattern's test / binders against the scrutinee `on` (`m$` in a match
    // arrow; `<raw>.error` in an Attempt — s451 Ue).
    fn patTest(ctx: Ctx, p: Pattern, on: JsExpr) -> JsExpr {
        return match p {
            .PVariant(enumSym: es, idx: idx) :> variantTest(ctx, es, idx, on)
            .PLit(lit: l) :> JsExpr.JBin(JsOp.StrictEq, on, litJs(ctx, l))
            .PWild :> JsExpr.JBool(true)
        }
    }

    // s451 (Ue, review HIGH-1) — THE ENUM VALUE SHAPE. A nullary variant is its
    // name (a string); a payload variant is `{ variant: "V", data: [v0, v1, …] }`
    // — the payload POSITIONAL, in declared field order. No field name ever
    // becomes a key next to the discriminant (a field named `tag`, `variant`,
    // `data` or `__proto__` cannot overwrite or reroute anything): the shape
    // holds by construction. The R8 wire form (§19.9.1 / §57.8) is
    // `{"variant": "V", "data": {<field>: …}}` — the same discriminant key; the
    // codec maps `data` index i ↔ declared field i (s454: runtime.js
    // `encEnum` / `decEnum`, against codec.scrml's `WireVariant` field list). (The runtime's own ValidationError records — §55, read
    // only by the runtime — keep their `{ tag, … }` shape; no Core pattern
    // reads them.)
    fn variantTest(ctx: Ctx, es: Sym, idx: int, on: JsExpr) -> JsExpr {
        const tag: JsExpr = jstr(variantTag(ctx, es, idx))
        if (variantHasFields(ctx, es, idx)) return JsExpr.JBin(JsOp.StrictEq, jmember(on, "variant"), tag)
        return JsExpr.JBin(JsOp.StrictEq, on, tag)
    }

    fn patBinds(ctx: Ctx, p: Pattern, on: JsExpr) -> JsStmt[] {
        return match p {
            .PVariant(enumSym: es, idx: idx, binds: binds) :> variantBinds(ctx, es, idx, binds, on)
            .PLit :> []
            .PWild :> []
        }
    }

    fn variantBinds(ctx: Ctx, es: Sym, idx: int, binds: Sym[], on: JsExpr) -> JsStmt[] {
        let out: JsStmt[] = []
        let j = 0
        for (const b of binds) {
            out = out.concat([JsStmt.SConst(symName(ctx, b), JsExpr.JIndex(jmember(on, "data"), JsExpr.JAnnot(jnum(j), variantFieldName(ctx, es, idx, j))))])
            j = j + 1
        }
        return out
    }

    // -------------------------------------------------------------------------
    // Statements.
    // -------------------------------------------------------------------------
    fn blockJs(ctx: Ctx, b: Block) -> JsStmt[] {
        const assigned: int[] = assignedSyms(Node.NBlock(b))
        let out: JsStmt[] = []
        for (const s of b.stmts) { out = out.concat(stmtJs(ctx, s, assigned)) }
        if (holdsDefer(b)) return deferBlockJs(ctx, out)    // s451
        return out
    }

    // s451 — `defer` (§19.16.6, the informative shape): a block that holds a
    // Defer gets its own stack and is wrapped — whole, in place — in a
    // `try { … } finally { rt.runDefers(defers$) }`. Each Defer pushes its
    // body as a closure where it stands, so a Defer never reached registers
    // nothing; the closure is evaluated at exit and sees the bindings in scope
    // at the `defer`; a `return`'s value is computed before the `finally`
    // runs; the runtime runs the stack last-first and rethrows the first host
    // error after all have run (§19.16.2). An inner block's `defers$` shadows
    // the outer one — a deferred body holds no Defer (C16), so no closure
    // ever needs the outer stack from inside an inner block.
    fn holdsDefer(b: Block) -> boolean {
        for (const s of b.stmts) {
            if (isDefer(s)) return true
        }
        return false
    }

    fn isDefer(s: Stmt) -> boolean {
        return match s {
            .Defer(body: x) :> true
            .Let(sym: x) :> false
            .Assign(local: x) :> false
            .Write(cap: x) :> false
            .Commit(writes: x) :> false
            .If(cond: x) :> false
            .Return(e: x) :> false
            .Eval(e: x) :> false
            .Suspend(bind: x) :> false
            .ResetSurface(of: x) :> false
            .Unpersist(decl: x) :> false
            .Attempt(result: x) :> false
            .Fail(err: x) :> false
            .Join(k: x) :> false
            .Jump(k: x) :> false
        }
    }

    fn deferBlockJs(ctx: Ctx, body: JsStmt[]) -> JsStmt[] {
        return [
            JsStmt.SConst("defers$", JsExpr.JArray([])),
            JsStmt.STry(body, [sexpr(rtCall(ctx, "runDefers", [jid("defers$")]))]),
        ]
    }

    fn deferJs(ctx: Ctx, body: Block) -> JsStmt {
        return sexpr(jmcall(jid("defers$"), "push", [JsExpr.JArrow([], blockJs(ctx, body))]))
    }

    fn stmtJs(ctx: Ctx, s: Stmt, assigned: int[]) -> JsStmt[] {
        return match s {
            .Let(sym: sym, init: init) :> [letJs(ctx, sym, init, assigned)]
            .Assign(local: l, value: v) :> [JsStmt.SAssign(jid(symName(ctx, l)), exprJs(ctx, v))]
            .Write(cap: cap, inst: inst, edit: edit, value: v, check: ck) :> [writeJs(ctx, cap, inst, edit, v, ck)]
            .Commit(writes: ws) :> commitJs(ctx, ws)
            .If(cond: c, thenB: t, elseB: e) :> [JsStmt.SIf(exprJs(ctx, c), blockJs(ctx, t), elseJs(ctx, e))]
            .Return(e: e) :> [returnJs(ctx, exprJs(ctx, e))]
            .Eval(e: e) :> [sexpr(exprJs(ctx, e))]
            .Suspend(bind: b, on: on, then: t) :> [suspendJs(ctx, b, on, t)]
            .ResetSurface(of: v) :> [sexpr(jmcall(surfaceJs(ctx, v), "reset", []))]
            .Defer(body: d) :> [deferJs(ctx, d)]
            .Unpersist(decl: d, inst: i, idx: x) :> [unpersistJs(ctx, d, i, x)]
            .Attempt(result: r, call: c, err: e, ok: ok, arms: arms) :> attemptJs(ctx, r, c, ok, arms, assigned)
            .Fail(err: e, idx: i, args: args) :> [returnJs(ctx, rtCall(ctx, "failure", [variantValueJs(ctx, e, i, args)]))]
            .Join(k: k, body: b) :> [JsStmt.SConst(symName(ctx, k), JsExpr.JArrow([], blockJs(ctx, b)))]
            .Jump(k: k) :> [sexpr(jcall(jid(symName(ctx, k)), []))]
        }
    }

    // s454 (U1b) — `return v`. In a WAITING function (ctx.ret is its resolve
    // function) the value settles the function's Promise: `return ret$(v);` —
    // also from inside a continuation, where a plain `return` would only leave
    // the continuation.
    fn returnJs(ctx: Ctx, v: JsExpr) -> JsStmt {
        if (ctx.ret == "") return JsStmt.SReturn(v)
        return JsStmt.SReturn(jcall(jid(ctx.ret), [v]))
    }

    // -------------------------------------------------------------------------
    // s451 (Ue) — the error model (§19). A failure is a runtime-private
    // `Failure` object around the error value (`rt.failure(e)`); `rt.failed(r)`
    // tells it apart from ANY success value (no scrml value is one). An
    // Attempt binds the call's raw result to `ok.bind`:
    //   let result;                       // only when the Attempt has one
    //   const v = f(…);
    //   if (rt.failed(v)) { if (<arm 1 test on v.error>) { … } else … }
    //   else { <ok body>; result = <ok value>; }
    // The arms are total (check.scrml C-E2), so the last — or a wildcard —
    // needs no test. The patterns test `v.error` (the raw result's local is a
    // minted, unique name), so an Attempt nested in an arm never collides.
    // -------------------------------------------------------------------------
    fn attemptJs(ctx: Ctx, result: Sym | not, call: Failable, ok: OkArm, arms: ErrArm[], assigned: int[]) -> JsStmt[] {
        let out: JsStmt[] = []
        if (result is some) out = out.concat([JsStmt.SDecl(symName(ctx, result))])
        const raw: string = symName(ctx, ok.bind)
        out = out.concat([JsStmt.SConst(raw, failableJs(ctx, call))])
        const errB: JsStmt[] = errArmsJs(ctx, jmember(jid(raw), "error"), arms, 0, result)
        const okB: JsStmt[] = blockJs(ctx, ok.body).concat(resultJs(ctx, result, ok.value))
        return out.concat([JsStmt.SIf(rtCall(ctx, "failed", [jid(raw)]), errB, okB)])
    }

    fn failableJs(ctx: Ctx, c: Failable) -> JsExpr {
        return match c {
            .FCall(fn: f, args: args) :> jcall(jid(symName(ctx, f)), exprsJs(ctx, args))
            .FSql(q: q) :> JsExpr.JNull     // unreachable: a query stands only in a ServerFn (C-S2), which the client artifact omits
            .FSettled(outcome: o) :> localRead(ctx, o)   // s454 (U1b): the Suspend's settled outcome
        }
    }

    fn errArmsJs(ctx: Ctx, err: JsExpr, arms: ErrArm[], i: int, result: Sym | not) -> JsStmt[] {
        if (i >= arms.length) return []
        const a: ErrArm = arms[i]
        const body: JsStmt[] = wholeBind(ctx, a.whole, err).concat(patBinds(ctx, a.pat, err)).concat(blockJs(ctx, a.body)).concat(resultJs(ctx, result, a.value))
        if (i == arms.length - 1 || isWildPat(a.pat)) return body
        return [JsStmt.SIf(patTest(ctx, a.pat, err), body, errArmsJs(ctx, err, arms, i + 1, result))]
    }

    // s452 — the whole-error binder (`| _ err :>`, §18.6.1): the arm's local
    // holds the error value itself — the enum value, variant and payload.
    fn wholeBind(ctx: Ctx, whole: Sym | not, err: JsExpr) -> JsStmt[] {
        if (whole is not) return []
        return [JsStmt.SConst(symName(ctx, whole), err)]
    }

    fn isWildPat(p: Pattern) -> boolean {
        return match p {
            .PWild :> true
            .PVariant :> false
            .PLit :> false
        }
    }

    // s452 r2: a branch with a value never holds a `defer` (analyze refuses a
    // `defer` directly in a value-position arm — E-DEFER-UNSUPPORTED-SITE,
    // §19.16.2), so its block is never wrapped in a `try` and the result
    // assignment after it reads the block's locals in the same JS block.
    fn resultJs(ctx: Ctx, result: Sym | not, v: Expr | not) -> JsStmt[] {
        if (result is not) return []
        if (v is not) return []
        return [JsStmt.SAssign(jid(symName(ctx, result)), exprJs(ctx, v))]
    }

    // An enum value as the runtime holds it (THE ENUM VALUE SHAPE, above):
    // a nullary variant is its name; a payload variant `{ variant, data: […] }`.
    fn variantValueJs(ctx: Ctx, es: Sym, idx: int, args: Expr[]) -> JsExpr {
        const tag: JsExpr = jstr(variantTag(ctx, es, idx))
        if (!variantHasFields(ctx, es, idx)) return tag
        let vals: JsExpr[] = []
        let j = 0
        for (const a of args) {
            vals = vals.concat([JsExpr.JAnnot(exprJs(ctx, a), variantFieldName(ctx, es, idx, j))])
            j = j + 1
        }
        return JsExpr.JObject([{ key: "variant", value: tag }, { key: "data", value: JsExpr.JArray(vals) }])
    }

    // s449 — `rt.suspend(task$, <on>, (x) => { <then> })`: the CPS split
    // (§19.9.8). The continuation never runs if the effect that owns `task$`
    // was re-run (newest run wins) or torn down while the value was pending.
    // C12 puts a Suspend only at the tail of an effect body, whose arrow binds
    // `task$`.
    fn suspendJs(ctx: Ctx, b: Sym, on: Expr, t: Block) -> JsStmt {
        return sexpr(rtCall(ctx, "suspend", [jid("task$"), exprJs(ctx, on), JsExpr.JArrow([symName(ctx, b)], blockJs(ctx, t))]))
    }

    fn letJs(ctx: Ctx, sym: Sym, init: Expr, assigned: int[]) -> JsStmt {
        if (hasInt(assigned, sym.id)) return JsStmt.SLet(symName(ctx, sym), exprJs(ctx, init))
        return JsStmt.SConst(symName(ctx, sym), exprJs(ctx, init))
    }

    fn elseJs(ctx: Ctx, e: Block | not) -> JsStmt[] {
        if (e is not) return []
        return blockJs(ctx, e)
    }

    // A write through a capability: the capability names the declaration and
    // field; the instance reference says which instance's signal is set.
    fn writeJs(ctx: Ctx, cap: Sym, inst: InstRef, edit: EditKind, value: Expr, check: Check) -> JsStmt {
        const owner: CapOwner | not = capOwner(ctx.p, cap)
        if (owner is not) return sexpr(jid("danglingWriteCapability$" + cap.id))
        const target: JsExpr = fieldCell(instJs(ctx, inst), owner.decl, owner.idx)
        const v: JsExpr = exprJs(ctx, value)
        return sexpr(editJs(ctx, target, owner, edit, v, check))
    }

    // An all-or-nothing group of writes (Stmt.Commit, RULED S440): first every
    // runtime contract check (a RuntimeEdge transition's edge), then every
    // write. A refused check throws before anything is written. Each write's
    // edge is already proven by then, so it is emitted as a Static write.
    // The values are Locals (check.scrml C7): reading one twice is free.
    // The writes run inside ONE `rt.batch`: a `.set` outside a batch flushes
    // its observers synchronously (a Commit reached from a render hole or an
    // effect runs at batch depth 0), and an observer running between two
    // writes would see — and could act on — the half-applied value. In the
    // batch, observers run once, after the last write. The checks stay OUTSIDE
    // the batch: they are pure reads (`peek`), nothing can run between them and
    // the batch, and a refusal throws before any batch bookkeeping begins.
    fn commitJs(ctx: Ctx, ws: Stmt[]) -> JsStmt[] {
        let checks: JsStmt[] = []
        let writes: JsStmt[] = []
        for (const s of ws) {
            checks = checks.concat(commitCheckJs(ctx, s))
            writes = writes.concat(commitWriteJs(ctx, s))
        }
        return checks.concat([sexpr(rtCall(ctx, "batch", [JsExpr.JArrow([], writes)]))])
    }

    fn commitCheckJs(ctx: Ctx, s: Stmt) -> JsStmt[] {
        return match s {
            .Write(cap: cap, inst: inst, edit: edit, value: v, check: ck) :> edgeCheckJs(ctx, cap, inst, edit, v, ck)
            .Commit :> []
            .Let :> []
            .Assign :> []
            .If :> []
            .Return :> []
            .Eval :> []
            .Suspend :> []
            .ResetSurface :> []
            .Defer :> []
            .Unpersist :> []
            .Attempt :> []
            .Fail :> []
            .Join :> []
            .Jump :> []
        }
    }

    fn commitWriteJs(ctx: Ctx, s: Stmt) -> JsStmt[] {
        return match s {
            .Write(cap: cap, inst: inst, edit: edit, value: v) :> [writeJs(ctx, cap, inst, edit, v, Check.Static)]
            .Commit :> []
            .Let :> []
            .Assign :> []
            .If :> []
            .Return :> []
            .Eval :> []
            .Suspend :> []
            .ResetSurface :> []
            .Defer :> []
            .Unpersist :> []
            .Attempt :> []
            .Fail :> []
            .Join :> []
            .Jump :> []
        }
    }

    // The edge check alone (no write) for a RuntimeEdge transition; nothing
    // for a write the Core already proves.
    fn edgeCheckJs(ctx: Ctx, cap: Sym, inst: InstRef, edit: EditKind, value: Expr, check: Check) -> JsStmt[] {
        if (!isTransitionEdit(edit) || !isRuntimeEdge(check)) return []
        const owner: CapOwner | not = capOwner(ctx.p, cap)
        if (owner is not) return [sexpr(jid("danglingWriteCapability$" + cap.id))]
        const target: JsExpr = fieldCell(instJs(ctx, inst), owner.decl, owner.idx)
        const edges: JsExpr = jid(nameOf(ctx.names, NameKey.Edges(owner.decl.sym.id, owner.idx)))
        return [sexpr(rtCall(ctx, "checkEdge", [target, edges, exprJs(ctx, value)]))]
    }

    fn isTransitionEdit(k: EditKind) -> boolean {
        return match k {
            .Transition :> true
            .Replace :> false
            .Append :> false
            .Prepend :> false
            .Anywhere :> false
            .PositionWrite :> false
            .FieldAt :> false
            .RemoveEnd :> false
            .RemoveFront :> false
            .RemoveAnywhere :> false
            .ElemAt(index: x) :> false
        }
    }

    fn isRuntimeEdge(c: Check) -> boolean {
        return match c {
            .RuntimeEdge :> true
            .Static :> false
        }
    }

    fn editJs(ctx: Ctx, target: JsExpr, owner: CapOwner, edit: EditKind, v: JsExpr, check: Check) -> JsExpr {
        return match edit {
            .Replace :> jmcall(target, "set", [v])
            .Append :> rtCall(ctx, "append", [target, v])
            .Prepend :> rtCall(ctx, "prepend", [target, v])
            .Anywhere :> jmcall(target, "set", [v])
            .PositionWrite :> jmcall(target, "set", [v])
            .FieldAt(path: path) :> rtCall(ctx, "setIn", [target, fieldPathJs(ctx, path), v])
            .Transition :> transitionJs(ctx, target, owner, v, check)
            .RemoveEnd :> rtCall(ctx, "removeEnd", [target, v])
            .RemoveFront :> rtCall(ctx, "removeFront", [target, v])
            .RemoveAnywhere :> jmcall(target, "set", [v])
            .ElemAt(index: ix, path: path) :> rtCall(ctx, "setAt", [target, exprJs(ctx, ix), fieldPathJs(ctx, path), v])
        }
    }

    fn fieldPathJs(ctx: Ctx, path: FieldRef[]) -> JsExpr {
        let out: JsExpr[] = []
        for (const r of path) { out = out.concat([jstr(memberName(ctx, r.owner, r.idx))]) }
        return JsExpr.JArray(out)
    }

    fn transitionJs(ctx: Ctx, target: JsExpr, owner: CapOwner, v: JsExpr, check: Check) -> JsExpr {
        return match check {
            .Static :> jmcall(target, "set", [v])
            .RuntimeEdge :> rtCall(ctx, "transition", [target, jid(nameOf(ctx.names, NameKey.Edges(owner.decl.sym.id, owner.idx))), v])
        }
    }

    // -------------------------------------------------------------------------
    // Views → template HNodes + holes.
    // -------------------------------------------------------------------------
    fn emptyBuilt() -> Built { return { nodes: [], holes: [] } }

    fn joinBuilt(a: Built, b: Built) -> Built {
        return { nodes: a.nodes.concat(b.nodes), holes: a.holes.concat(b.holes) }
    }

    fn buildNodes(ctx: Ctx, views: View[], base: int[]) -> Built {
        let out: Built = emptyBuilt()
        let i = 0
        for (const v of views) {
            out = joinBuilt(out, buildNode(ctx, v, base.concat([i])))
            i = i + 1
        }
        return out
    }

    fn hole(n: HNode, path: int[], v: View) -> Built {
        return { nodes: [n], holes: [{ path: path, v: v }] }
    }

    fn textBuilt(t: string) -> Built { return { nodes: [HNode.HText(t)], holes: [] } }

    fn buildNode(ctx: Ctx, v: View, path: int[]) -> Built {
        return match v {
            .El(tag: tag, attrs: attrs, kids: ks) :> buildEl(ctx, v, tag, attrs, ks, path)
            .Text(text: t) :> textBuilt(t)
            .Dyn :> hole(HNode.HComment(""), path, v)
            .Cond :> hole(HNode.HComment("if"), path, v)
            .Each :> hole(HNode.HComment("each"), path, v)
            .Instance(decl: d) :> hole(HNode.HComment(d.hint), path, v)
            .Slot :> hole(HNode.HComment("slot"), path, v)
            .Star(decl: d) :> hole(HNode.HComment("*" + d.hint), path, v)
            // s449: an `<effect>` renders no DOM; its comment keeps child-index paths positional
            .Effect :> hole(HNode.HComment("effect"), path, v)
            .ResetOn :> hole(HNode.HComment("reset-on"), path, v)
            .Errors :> hole(HNode.HComment("errors"), path, v)
        }
    }

    fn buildEl(ctx: Ctx, v: View, tag: string, attrs: Attr[], ks: View[], path: int[]) -> Built {
        const inner: Built = buildNodes(ctx, ks, path)
        const node: HNode = HNode.HElem(tag, staticAttrs(attrs), inner.nodes)
        if (hasWiredAttr(attrs)) return { nodes: [node], holes: [{ path: path, v: v }].concat(inner.holes) }
        return { nodes: [node], holes: inner.holes }
    }

    fn staticAttrs(attrs: Attr[]) -> HAttr[] {
        let out: HAttr[] = []
        for (const a of attrs) { out = out.concat(staticAttr(a)) }
        return out
    }

    fn staticAttr(a: Attr) -> HAttr[] {
        return match a {
            .Static(name: n, value: v) :> [{ name: n, value: v }]
            .Bound :> []
            .Show :> []
            .On :> []
            .Bind :> []
            .Gate(values: vs) :> gatedMarker(vs)
        }
    }

    // §55.17.6: `data-scrml-gated` on a GATED form only (a form whose listener
    // only records the submit, §55.7, gates nothing).
    fn gatedMarker(vs: string[]) -> HAttr[] {
        if (vs.length == 0) return []
        return [{ name: "data-scrml-gated", value: vs.join(" ") }]
    }

    fn hasWiredAttr(attrs: Attr[]) -> boolean {
        for (const a of attrs) {
            if (isWired(a)) return true
        }
        return false
    }

    // F16: every arm binds a field — a match over an IMPORTED payload enum whose
    // arms bind nothing compiles to `a === "On"` and never matches.
    fn isWired(a: Attr) -> boolean {
        return match a {
            .Static(name: n) :> false
            .Bound(name: n) :> true
            .Show(test: t) :> true
            .On(event: ev) :> true
            .Bind(kind: k) :> true
            .Gate(values: vs) :> true
        }
    }

    // -------------------------------------------------------------------------
    // Views → client code.
    // -------------------------------------------------------------------------
    fn scopeVar() -> JsExpr { return jid("scope$") }

    fn renderViews(ctx: Ctx, views: View[], tid: string) -> Rendered {
        const built: Built = buildNodes(ctx, views, [])
        let stmts: JsStmt[] = [JsStmt.SConst("root$", rtCall(ctx, "template", [jstr(tid)]))]
        for (const h of built.holes) {
            if (holeNeedsNode(h.v)) {
                let args: JsExpr[] = [jid("root$")]
                for (const i of h.path) { args = args.concat([jnum(i)]) }
                stmts = stmts.concat([JsStmt.SConst(nodeVar(h.path), rtCall(ctx, "at", args))])
            }
        }
        let templates: Template[] = [{ id: tid, nodes: built.nodes }]
        // Instance holes are numbered in document order — the order in which
        // the factory created them (mountedInstances) when this is a
        // declaration's own renders (ctx.prebuilt, L12 (b)).
        let kid = 0
        for (const h of built.holes) {
            const w: Rendered = wireHole(ctx, h, tid, kid)
            if (isInstanceView(h.v)) kid = kid + 1
            stmts = stmts.concat(w.stmts)
            templates = templates.concat(w.templates)
        }
        stmts = stmts.concat([sexpr(rtCall(ctx, "insert", [scopeVar(), jid("root$"), jid("anchor$")]))])
        return { stmts: stmts, templates: templates }
    }

    fn only(stmts: JsStmt[]) -> Rendered { return { stmts: stmts, templates: [] } }

    // A nested region (a conditional arm, an <each> row, slot content) creates
    // its instances when it mounts: those are the conditional ones (§66.7.5).
    fn nested(ctx: Ctx) -> Ctx {
        return { p: ctx.p, names: ctx.names, lexical: ctx.lexical, handles: ctx.handles, shared: ctx.shared,
                 rows: ctx.rows, slot: ctx.slot, prebuilt: false, ret: ctx.ret }
    }

    // F16: one arm binds a field (a match over an imported payload enum).
    fn isInstanceView(v: View) -> boolean {
        return match v {
            .Instance(decl: d) :> true
            .El :> false
            .Text :> false
            .Dyn :> false
            .Cond :> false
            .Each :> false
            .Slot :> false
            .Star :> false
            .Effect :> false
            .ResetOn :> false
            .Errors :> false
        }
    }

    // s449: an `<effect>` hole is wired from its Core alone — it has no node to look up.
    fn holeNeedsNode(v: View) -> boolean {
        return match v {
            .Effect(deps: ds) :> false
            .ResetOn(triggers: ds) :> false
            .El(tag: t) :> true
            .Text(text: t) :> true
            .Dyn(e: e) :> true
            .Cond(arms: a) :> true
            .Each(src: s) :> true
            .Instance(decl: d) :> true
            .Slot :> true
            .Star(decl: d) :> true
            .Errors(of: x) :> true
        }
    }

    // The instances a renders mounts UNCONDITIONALLY — reached through element
    // children only, never through a conditional arm, an <each> row or slot
    // content — in document order (the hole order of buildNodes). L12 (b): these
    // are created with the declaration's record, before anything renders.
    fn mountedInstances(views: View[]) -> View[] {
        let out: View[] = []
        for (const v of views) { out = out.concat(mountedIn(v)) }
        return out
    }

    fn mountedIn(v: View) -> View[] {
        return match v {
            .El(kids: ks) :> mountedInstances(ks)
            .Instance(decl: d) :> [v]
            .Text :> []
            .Dyn :> []
            .Cond :> []
            .Each :> []
            .Slot :> []
            .Star :> []
            .Effect :> []
            .ResetOn :> []
            .Errors :> []
        }
    }

    fn wireHole(ctx: Ctx, h: Hole, tid: string, kid: int) -> Rendered {
        const node: JsExpr = jid(nodeVar(h.path))
        const v: View = h.v
        return match v {
            .El(attrs: attrs) :> only(attrsJs(ctx, attrs, node))
            .Text :> only([])
            .Dyn(e: e) :> only([sexpr(rtCall(ctx, "text", [scopeVar(), node, jthunk(exprJs(ctx, e))]))])
            .Cond(arms: arms) :> condJs(nested(ctx), arms, node, tid + "/" + pathText(h.path))
            .Each(src: src, bind: bind, key: key, handles: hs, row: row) :> eachJs(ctx, src, bind, key, hs, row, node, tid + "/" + pathText(h.path))
            .Instance(decl: d, attrs: attrs, slot: slot, alias: alias) :> instanceJs(ctx, d, attrs, slot, alias, node, h.path, tid, kid)
            .Slot :> only([sexpr(rtCall(ctx, "slot", [scopeVar(), node, ctx.slot]))])
            .Star(decl: d, inst: i) :> starJs(ctx, d, i, node)
            .Effect(deps: ds, body: b) :> effectJs(ctx, ds, b)
            .ResetOn(triggers: ds, reset: b, rank: r) :> resetOnJs(ctx, ds, b, r)
            .Errors(of: x, all: a) :> only([sexpr(rtCall(ctx, "errors", [scopeVar(), node, jthunk(jmcall(surfaceJs(ctx, x), "messages", [])), JsExpr.JBool(a)]))])
        }
    }

    // s449 — `rt.resetOn(scope$, [<trigger cells>], () => { <the reset write> }, rank)`
    // (§6.8.4): the cell resets itself in the flush of the triggering write,
    // a chain in rank order, before any render or effect reads it.
    fn resetOnJs(ctx: Ctx, triggers: EffectDep[], reset: Block, rank: int) -> Rendered {
        return only([sexpr(rtCall(ctx, "resetOn", [scopeVar(), JsExpr.JArray(depCells(ctx, triggers)), JsExpr.JArrow([], blockJs(ctx, reset)), jnum(rank)]))])
    }

    fn depCells(ctx: Ctx, deps: EffectDep[]) -> JsExpr[] {
        let cells: JsExpr[] = []
        for (const dep of deps) {
            const d: Decl | not = findDecl(ctx.p, dep.decl)
            if (d is some) {
                cells = cells.concat([fieldCell(instJs(ctx, dep.inst), d, dep.idx)])
            } else {
                cells = cells.concat([jid("unboundDecl$" + dep.decl.id)])
            }
        }
        return cells
    }

    // s449 — `rt.effectOn(scope$, [<dependency cells>], (task$) => { <body> })`
    // (§6.7.4): registered into the scope this view list renders into, so it is
    // unregistered with that scope (teardown step 1). The dependencies are the
    // cells themselves — the effect subscribes to exactly those. `task$` is
    // bound only when the body suspends (C12).
    fn effectJs(ctx: Ctx, deps: EffectDep[], body: Block) -> Rendered {
        let params: string[] = []
        if (suspends(body)) params = ["task$"]
        return only([sexpr(rtCall(ctx, "effectOn", [scopeVar(), JsExpr.JArray(depCells(ctx, deps)), JsExpr.JArrow(params, blockJs(ctx, body))]))])
    }

    // s454 (U1b): a Suspend at ANY depth (a Join body, an If branch after a
    // Join, a Suspend's continuation) — the body needs its task.
    fn suspends(b: Block) -> boolean {
        for (const n of allNodes(Node.NBlock(b))) {
            if (nodeIsSuspend(n)) return true
        }
        return false
    }

    fn nodeIsSuspend(n: Node) -> boolean {
        return match n {
            .NStmt(s: s) :> isSuspend(s)
            .NExpr(e: x) :> false
            .NProgram(p: x) :> false
            .NDecl(d: x) :> false
            .NField(f: x) :> false
            .NFn(f: x) :> false
            .NServerFn(f: x) :> false
            .NBlock(b: x) :> false
            .NPlace(pl: x) :> false
            .NInst(i: x) :> false
            .NPattern(pat: x) :> false
            .NEdit(k: x) :> false
            .NView(v: x) :> false
            .NAttr(a: x) :> false
        }
    }

    fn isSuspend(s: Stmt) -> boolean {
        return match s {
            .Suspend(bind: b) :> true
            .Let(sym: x) :> false
            .Assign(local: x) :> false
            .Write(cap: x) :> false
            .Commit(writes: x) :> false
            .If(cond: x) :> false
            .Return(e: x) :> false
            .Eval(e: x) :> false
            .ResetSurface(of: x) :> false
            .Defer(body: x) :> false
            .Unpersist(decl: x) :> false
            .Attempt(result: x) :> false
            .Fail(err: x) :> false
            .Join(k: x) :> false
            .Jump(k: x) :> false
        }
    }

    // s444 — `<*x/>` (§66.6.2): the EXISTING instance, rendered with x's
    // renders into THIS scope (so its view effects are disposed with this
    // site, while the instance itself lives on). Nothing is constructed.
    fn starJs(ctx: Ctx, d: Sym, i: InstRef, node: JsExpr) -> Rendered {
        return only([sexpr(jcall(jid(nameOf(ctx.names, NameKey.Render(d.id))), [instJs(ctx, i), scopeVar(), node, JsExpr.JNull]))])
    }

    // s449: a form's submit gate is registered BEFORE every other listener of
    // the element (§55.17.3: it runs before any author handler) — whatever the
    // attribute order.
    fn attrsJs(ctx: Ctx, attrs: Attr[], node: JsExpr) -> JsStmt[] {
        let gates: JsStmt[] = []
        let out: JsStmt[] = []
        for (const a of attrs) {
            if (isGate(a)) {
                gates = gates.concat(attrJs(ctx, a, node))
            } else {
                out = out.concat(attrJs(ctx, a, node))
            }
        }
        return gates.concat(out)
    }

    fn isGate(a: Attr) -> boolean {
        return match a {
            .Gate(values: vs) :> true
            .Static(name: n) :> false
            .Bound(name: n) :> false
            .Show(test: t) :> false
            .On(event: ev) :> false
            .Bind(kind: k) :> false
        }
    }

    // s454 (U1b) — a handler whose body suspends runs in a TASK the runtime
    // makes for each invocation (rt.on passes it first): teardown of the
    // element's scope cancels it; a second event does not cancel the first
    // (design §2.3 reading — supersede is `<request>` semantics, not a handler's).
    fn handlerParams(body: Block) -> string[] {
        if (suspends(body)) return ["task$"]
        return []
    }

    fn attrJs(ctx: Ctx, a: Attr, node: JsExpr) -> JsStmt[] {
        return match a {
            .Static :> []
            .Bound(name: n, e: e) :> [sexpr(rtCall(ctx, "attr", [scopeVar(), node, jstr(n), jthunk(exprJs(ctx, e))]))]
            .Show(test: t) :> [sexpr(rtCall(ctx, "visibility", [scopeVar(), node, jthunk(exprJs(ctx, t))]))]
            .On(event: ev, body: body) :> [sexpr(rtCall(ctx, "on", [scopeVar(), node, jstr(ev), JsExpr.JArrow(handlerParams(body), blockJs(ctx, body))]))]
            .Bind(kind: k, read: r, sink: sk, write: w) :> [sexpr(rtCall(ctx, "bind", [scopeVar(), node, jstr(bindProp(k)), jthunk(exprJs(ctx, r)), JsExpr.JArrow([symName(ctx, sk)], blockJs(ctx, w))].concat(bindSurface(ctx, r))))]
            .Gate(values: vs, fields: fs) :> [sexpr(rtCall(ctx, "gate", [scopeVar(), node, JsExpr.JArrowE([], JsExpr.JArray(surfacesJs(ctx, fs)))]))]
        }
    }

    // s449 — the validity record a bind marks `touched` and a gate reads
    // (§55.7, §55.17.3): a bind of a field's WHOLE value, when the field has a
    // surface — every field of a user declaration (§55.6), a top-level value
    // only when it carries validators (§55.5.1 rule 2).
    fn bindSurface(ctx: Ctx, read: Expr) -> JsExpr[] {
        return match read {
            .Read(place: pl) :> placeSurface(ctx, pl)
            .Lit(lit: x) :> []
            .Local(sym: x) :> []
            .Call(callee: x) :> []
            .Prim(op: x) :> []
            .Match(scrut: x) :> []
            .ArrayOf(elems: x) :> []
            .StructOf(ty: x) :> []
            .Handle(inst: x) :> []
            .InitOf(decl: x) :> []
            .Host(call: x) :> []
            .Lambda(params: x) :> []
            .SeqCall(op: x) :> []
            .Validity(of: x) :> []
            .ServerCall(fn: x) :> []
        }
    }

    fn placeSurface(ctx: Ctx, pl: Place) -> JsExpr[] {
        return match pl {
            .Cell(decl: d, inst: i, path: path) :> cellSurface(ctx, d, i, path)
            .LocalPath(sym: s) :> []
        }
    }

    fn cellSurface(ctx: Ctx, dsym: Sym, i: InstRef, path: FieldRef[]) -> JsExpr[] {
        if (path.length != 1) return []
        const d: Decl | not = findDecl(ctx.p, dsym)
        if (d is not) return []
        const idx: int = path[0].idx
        if (idx >= d.fields.length) return []
        if (!hasSurface(d, d.fields[idx])) return []
        return [rtCall(ctx, "validity", [instJs(ctx, i), JsExpr.JAnnot(jnum(idx), fieldHint(d, idx))])]
    }

    fn hasSurface(d: Decl, f: Field) -> boolean {
        const k: DeclKind = d.kind
        return match k {
            .User :> true
            .Program :> f.vals.length > 0
            .Predefined :> false
        }
    }

    // s444 — the element property a bind shows and reads back (§5.4).
    fn bindProp(k: BindKind) -> string {
        return match k {
            .Value :> "value"
            .Checked :> "checked"
        }
    }

    fn condJs(ctx: Ctx, arms: CondArm[], node: JsExpr, tid: string) -> Rendered {
        let objs: JsExpr[] = []
        let templates: Template[] = []
        let k = 0
        for (const arm of arms) {
            const r: Rendered = renderViews(ctx, arm.body, tid + "." + k)
            objs = objs.concat([JsExpr.JObject([
                { key: "test", value: jthunk(exprJs(ctx, arm.test)) },
                { key: "render", value: JsExpr.JArrow(["scope$", "anchor$"], r.stmts) },
            ])])
            templates = templates.concat(r.templates)
            k = k + 1
        }
        return { stmts: [sexpr(rtCall(ctx, "cond", [scopeVar(), node, JsExpr.JArray(objs)]))], templates: templates }
    }

    fn eachJs(ctx: Ctx, src: Expr, bind: Sym, key: Expr | not, handles: Sym[], row: View[], node: JsExpr, tid: string) -> Rendered {
        const bindName: string = symName(ctx, bind)
        let rowHandles: HandleLoc[] = ctx.handles
        let decls: JsStmt[] = []
        for (const h of handles) {
            rowHandles = rowHandles.concat([{ sym: h.id, js: jid(symName(ctx, h)) }])
            decls = decls.concat([JsStmt.SConst(symName(ctx, h), rtCall(ctx, "handle", []))])
        }
        const rowCtx: Ctx = {
            p: ctx.p, names: ctx.names, lexical: ctx.lexical, handles: rowHandles,
            shared: ctx.shared, rows: ctx.rows.concat([bind.id]), slot: ctx.slot, prebuilt: false, ret: ctx.ret,
        }
        const r: Rendered = renderViews(rowCtx, row, tid)
        const keyFn: JsExpr = keyJs(ctx, bindName, key)
        const render: JsExpr = JsExpr.JArrow(["scope$", bindName, "anchor$"], decls.concat(r.stmts))
        return {
            stmts: [sexpr(rtCall(ctx, "each", [scopeVar(), node, jthunk(exprJs(ctx, src)), keyFn, render]))],
            templates: r.templates,
        }
    }

    // The key function reads the row binding as the plain ITEM value (not the
    // row's cell); an unkeyed <each> keys by position (null → index).
    fn keyJs(ctx: Ctx, bindName: string, key: Expr | not) -> JsExpr {
        if (key is not) return JsExpr.JNull
        return JsExpr.JArrowE([bindName], exprJs(ctx, key))
    }

    fn isAttribute(f: Field) -> boolean {
        const r: FieldRole = f.role
        return match r {
            .Attribute :> true
            .Child :> false
        }
    }

    // F16: the `.JId(name: n)` binding forces tag comparison (see isWired).
    fn isUndefined(e: JsExpr) -> boolean {
        return match e {
            .JUndefined :> true
            .JId(name: n) :> false
            .JNum :> false
            .JStr :> false
            .JBool :> false
            .JNull :> false
            .JMember :> false
            .JIndex :> false
            .JCall :> false
            .JArrow :> false
            .JArrowE :> false
            .JBin :> false
            .JUn :> false
            .JCond :> false
            .JArray :> false
            .JObject :> false
            .JAnnot :> false
        }
    }

    fn constructValue(attrs: ConstructAttr[], field: int) -> Expr | not {
        for (const a of attrs) {
            if (a.field == field) return a.value
        }
        return not
    }

    // A field the factory takes a parameter for: every ATTRIBUTE (use-site
    // construction, §66.14 rule 4), and a CHILD field some use constructs (the
    // ratified O60 example `<dropdown open=(@x)/>`; ⚑ O43). Decided from Core.
    fn isParam(p: CoreProgram, d: Decl, idx: int, f: Field) -> boolean {
        if (isAttribute(f)) return true
        for (const n of allNodes(Node.NProgram(p))) {
            if (constructsField(n, d.sym, idx)) return true
        }
        return false
    }

    fn constructsField(n: Node, ds: Sym, idx: int) -> boolean {
        return match n {
            .NView(v: v) :> viewConstructs(v, ds, idx)
            .NProgram(p: q) :> false
            .NDecl(d: d) :> false
            .NField(f: f) :> false
            .NFn(f: f) :> false
            .NServerFn(f: f) :> false
            .NBlock(b: b) :> false
            .NStmt(s: s) :> false
            .NExpr(e: e) :> false
            .NPlace(pl: pl) :> false
            .NInst(i: i) :> false
            .NPattern(pat: pat) :> false
            .NEdit(k: k) :> false
            .NAttr(a: a) :> false
        }
    }

    fn viewConstructs(v: View, ds: Sym, idx: int) -> boolean {
        return match v {
            .Instance(decl: d, attrs: attrs) :> d.id == ds.id && constructValue(attrs, idx) is some
            .El(tag: t) :> false
            .Text(text: t) :> false
            .Dyn(e: e) :> false
            .Cond(arms: a) :> false
            .Each(src: s) :> false
            .Slot :> false
            .Star(decl: d) :> false
            .Effect(deps: ds) :> false
            .ResetOn(triggers: ds) :> false
            .Errors(of: x) :> false
        }
    }

    // `mk_<decl>(rt.instance(decl_<decl>, scope), …)` — a new instance of `d`
    // owned by `scope`: the new record, then one initializer thunk per factory
    // parameter (isParam) or `undefined` for its default.
    fn createJs(ctx: Ctx, d: Decl, attrs: ConstructAttr[], scope: JsExpr) -> JsExpr {
        let args: JsExpr[] = [rtCall(ctx, "instance", [jid(nameOf(ctx.names, NameKey.DeclInfo(d.sym.id))), scope])]
        let k = 0
        for (const f of d.fields) {
            if (isParam(ctx.p, d, k, f)) {
                const v: Expr | not = constructValue(attrs, k)
                if (v is some) {
                    args = args.concat([jthunk(exprJs(ctx, v))])
                } else {
                    args = args.concat([JsExpr.JUndefined])
                }
            }
            k = k + 1
        }
        while (args.length > 1 && isUndefined(args[args.length - 1])) { args = args.slice(0, args.length - 1) }
        return jcall(jid(nameOf(ctx.names, NameKey.Factory(d.sym.id))), args)
    }

    // `inst$.kids[k /* decl */]` — an instance the factory already created.
    fn kidSlot(ctx: Ctx, k: int, hint: string) -> JsExpr {
        return JsExpr.JIndex(jmember(lexicalJs(ctx, 0), "kids"), JsExpr.JAnnot(jnum(k), hint))
    }

    // An instance hole. In a declaration's own renders (ctx.prebuilt) the
    // instance was created with the record (L12 (b)) and is only MOUNTED here;
    // in a nested region it is created now, as the region mounts.
    fn instanceJs(ctx: Ctx, dsym: Sym, attrs: ConstructAttr[], slot: View[], alias: Sym | not, node: JsExpr, path: int[], tid: string, kid: int) -> Rendered {
        const d: Decl | not = findDecl(ctx.p, dsym)
        if (d is not) return only([sexpr(jid("unboundDecl$" + dsym.id))])
        const iv: string = "i$" + pathText(path)
        let stmts: JsStmt[] = []
        if (ctx.prebuilt) {
            stmts = [JsStmt.SConst(iv, kidSlot(ctx, kid, dsym.hint))]
        } else {
            stmts = [JsStmt.SConst(iv, createJs(ctx, d, attrs, scopeVar()))]
            if (alias is some) {
                stmts = stmts.concat([sexpr(rtCall(ctx, "bindHandle", [handleJs(ctx, alias), jid(iv)]))])
            }
        }
        let templates: Template[] = []
        // s444: a prebuilt kid renders into the scope THIS render was given —
        // the parent instance's scope for a new instance (the same lifetime as
        // the kid's own), the `<*x/>` site's scope for a Star render (so the
        // view is disposed with the site, never left in the kid's scope).
        let renderScope: JsExpr = jmember(jid(iv), "scope")
        if (ctx.prebuilt) renderScope = scopeVar()
        if (d.renders is some) {
            let slotFn: JsExpr = JsExpr.JNull
            if (slot.length > 0) {
                const r: Rendered = renderViews(nested(ctx), slot, tid + "/" + pathText(path) + ".slot")
                slotFn = JsExpr.JArrow(["scope$", "anchor$"], r.stmts)
                templates = r.templates
            }
            stmts = stmts.concat([sexpr(jcall(jid(nameOf(ctx.names, NameKey.Render(dsym.id))),
                [jid(iv), renderScope, node, slotFn]))])
        }
        return { stmts: stmts, templates: templates }
    }

    // -------------------------------------------------------------------------
    // Declarations (§5.2).
    // -------------------------------------------------------------------------
    fn baseCtx(p: CoreProgram, names: NameTable) -> Ctx {
        return { p: p, names: names, lexical: [], handles: [], shared: [], rows: [], slot: JsExpr.JNull, prebuilt: false, ret: "" }
    }

    fn instCtx(ctx: Ctx, d: Decl) -> Ctx {
        let hs: HandleLoc[] = []
        let k = 0
        for (const h of d.handles) {
            hs = hs.concat([{ sym: h.id, js: handleSlot(jid("inst$"), k, h.hint) }])
            k = k + 1
        }
        return { p: ctx.p, names: ctx.names, lexical: [jid("inst$")], handles: hs, shared: [], rows: [], slot: jid("slot$"), prebuilt: true, ret: "" }
    }

    fn declJs(ctx: Ctx, d: Decl, sharedUsed: Sym[]) -> Rendered {
        const h: string = d.sym.hint
        let stmts: JsStmt[] = [
            JsStmt.SBlank,
            JsStmt.SComment(declComment(d)),
            JsStmt.SConst(nameOf(ctx.names, NameKey.DeclInfo(d.sym.id)),
                rtCall(ctx, "declare", [jstr(h), JsExpr.JArray(fieldNamesJs(d))].concat(declOptsJs(ctx, d)))),
        ]
        stmts = stmts.concat(edgeTablesJs(ctx, d))
        stmts = stmts.concat([factoryJs(ctx, d)])
        let templates: Template[] = []
        const views: View[] | not = d.renders
        if (views is some) {
            const r: Rendered = renderViews(instCtx(ctx, d), views, "scrml:" + h)
            stmts = stmts.concat([JsStmt.SFunc(nameOf(ctx.names, NameKey.Render(d.sym.id)),
                ["inst$", "scope$", "anchor$", "slot$"], r.stmts)])
            templates = r.templates
        }
        if (symIn(sharedUsed, d.sym)) {
            stmts = stmts.concat([JsStmt.SFunc(nameOf(ctx.names, NameKey.SharedGet(d.sym.id)), [], [
                JsStmt.SReturn(rtCall(ctx, "shared", [jid(nameOf(ctx.names, NameKey.DeclInfo(d.sym.id))),
                    jid(nameOf(ctx.names, NameKey.Factory(d.sym.id)))])),
            ])])
        }
        return { stmts: stmts, templates: templates }
    }

    fn declComment(d: Decl) -> string {
        const k: DeclKind = d.kind
        return match k {
            .Program :> "the program — a `single` declaration whose fields are the top-level cells"
            .User :> declUserComment(d)
            .Predefined :> "predefined declaration <" + d.sym.hint + ">"
        }
    }

    fn declUserComment(d: Decl) -> string {
        if (d.single) return "declaration <" + d.sym.hint + "> (single)"
        return "declaration <" + d.sym.hint + ">"
    }

    fn symIn(xs: Sym[], s: Sym) -> boolean {
        for (const x of xs) { if (x.id == s.id) return true }
        return false
    }

    // s449 — the validators of each field (§55.1), when any field carries one:
    // `{ checks: [[…], …] }`, plus `topLevel: true` for the program, whose
    // fields are top-level values with their own `submitted` (§55.5.1).
    fn declOptsJs(ctx: Ctx, d: Decl) -> JsExpr[] {
        let any = false
        let perField: JsExpr[] = []
        for (const f of d.fields) {
            if (f.vals.length > 0) any = true
            perField = perField.concat([JsExpr.JArray(validatorsJs(ctx, f.vals))])
        }
        if (!any) return []
        let props: JsProp[] = []
        if (isProgramDecl(d)) props = [{ key: "topLevel", value: JsExpr.JBool(true) }]
        props = props.concat([{ key: "checks", value: JsExpr.JArray(perField) }])
        return [JsExpr.JObject(props)]
    }

    fn isProgramDecl(d: Decl) -> boolean {
        const k: DeclKind = d.kind
        return match k {
            .Program :> true
            .User :> false
            .Predefined :> false
        }
    }

    fn validatorsJs(ctx: Ctx, vs: Validator[]) -> JsExpr[] {
        let out: JsExpr[] = []
        for (const v of vs) { out = out.concat([validatorJs(ctx, v)]) }
        return out
    }

    fn checkCall(ctx: Ctx, name: string, args: JsExpr[]) -> JsExpr {
        return jcall(jmember(jmember(jid(rtName(ctx)), "check"), name), args)
    }

    fn validatorJs(ctx: Ctx, v: Validator) -> JsExpr {
        return match v {
            .Req :> checkCall(ctx, "req", [])
            .LengthCmp(op: op, n: n) :> checkCall(ctx, "length", [jstr(op), jnum(n)])
            .Min(n: n) :> checkCall(ctx, "min", [JsExpr.JNum("" + n)])
            .Max(n: n) :> checkCall(ctx, "max", [JsExpr.JNum("" + n)])
            .Pattern(source: src) :> checkCall(ctx, "pattern", [jstr(src)])
        }
    }

    fn fieldNamesJs(d: Decl) -> JsExpr[] {
        let out: JsExpr[] = []
        for (const f of d.fields) { out = out.concat([jstr(f.sym.hint)]) }
        return out
    }

    fn structFieldDefs(t: TypeDef) -> FieldDef[] {
        return match t {
            .StructDef(fields: fs) :> fs
            .EnumDef(variants: vs) :> []
        }
    }

    fn edgeTableJs(ctx: Ctx, g: TransitionGraph) -> JsExpr {
        let props: JsProp[] = []
        for (const e of g.edges) {
            let targets: JsExpr[] = []
            for (const t of e.targets) { targets = targets.concat([jstr(variantTag(ctx, g.enumSym, t))]) }
            props = props.concat([{ key: variantTag(ctx, g.enumSym, e.origin), value: JsExpr.JArray(targets) }])
        }
        return rtCall(ctx, "edges", [JsExpr.JObject(props)])
    }

    fn edgeTablesJs(ctx: Ctx, d: Decl) -> JsStmt[] {
        let out: JsStmt[] = []
        let i = 0
        for (const f of d.fields) {
            const g: TransitionGraph | not = f.graph
            if (g is some) {
                let props: JsProp[] = []
                for (const e of g.edges) {
                    let targets: JsExpr[] = []
                    for (const t of e.targets) { targets = targets.concat([jstr(variantTag(ctx, g.enumSym, t))]) }
                    props = props.concat([{ key: variantTag(ctx, g.enumSym, e.origin), value: JsExpr.JArray(targets) }])
                }
                out = out.concat([JsStmt.SConst(nameOf(ctx.names, NameKey.Edges(d.sym.id, i)),
                    rtCall(ctx, "edges", [JsExpr.JObject(props)]))])
            }
            i = i + 1
        }
        return out
    }

    // mk_<decl>(inst$, <attr>$ …): seed every field of a fresh instance record.
    // A field with a write capability is a Cell seeded once (untracked); a
    // field without one is a Derived that recomputes (constant if its
    // initializer reads no cells).
    fn factoryJs(ctx: Ctx, d: Decl) -> JsStmt {
        const fctx: Ctx = instCtx(ctx, d)
        let params: string[] = ["inst$"]
        let body: JsStmt[] = []
        let i = 0
        for (const f of d.fields) {
            let init: JsExpr = defaultThunk(fctx, d, f)
            if (isParam(ctx.p, d, i, f)) {
                const pn: string = f.sym.hint.replaceAll("$", "_") + "$"
                params = params.concat([pn])
                init = JsExpr.JBin(JsOp.Nullish, jid(pn), init)
            }
            // D15: an initializer something re-evaluates (`InitOf`, a reset) is
            // kept on the record, so the instance's OWN initializer is re-run.
            if (reinitUsed(ctx.p, d.sym, i)) {
                const slot: JsExpr = JsExpr.JIndex(jmember(jid("inst$"), "inits"), JsExpr.JAnnot(jnum(i), fieldHint(d, i)))
                body = body.concat([JsStmt.SAssign(slot, init)])
                init = slot
            }
            body = body.concat([JsStmt.SAssign(fieldCell(jid("inst$"), d, i), fieldCtor(fctx, f, init))])
            i = i + 1
        }
        let k = 0
        for (const h of d.handles) {
            body = body.concat([JsStmt.SAssign(handleSlot(jid("inst$"), k, h.hint), rtCall(ctx, "handle", []))])
            k = k + 1
        }
        body = body.concat(kidsJs(fctx, d))
        const run: JsExpr = rtCall(ctx, "construct", [jid("inst$"), JsExpr.JArrow([], body)])
        return JsStmt.SFunc(nameOf(ctx.names, NameKey.Factory(d.sym.id)), params, [JsStmt.SReturn(run)])
    }

    // Does any `InitOf(d, _, idx)` appear in the program?
    fn reinitUsed(p: CoreProgram, d: Sym, idx: int) -> boolean {
        for (const n of allNodes(Node.NProgram(p))) {
            if (isInitOf(n, d, idx)) return true
        }
        return false
    }

    fn isInitOf(n: Node, d: Sym, idx: int) -> boolean {
        return match n {
            .NExpr(e: e) :> exprIsInitOf(e, d, idx)
            .NProgram(p: q) :> false
            .NDecl(d: x) :> false
            .NField(f: f) :> false
            .NFn(f: f) :> false
            .NServerFn(f: f) :> false
            .NBlock(b: b) :> false
            .NStmt(s: s) :> false
            .NPlace(pl: pl) :> false
            .NInst(i: i) :> false
            .NPattern(pat: pat) :> false
            .NEdit(k: k) :> false
            .NView(v: v) :> false
            .NAttr(a: a) :> false
        }
    }

    fn exprIsInitOf(e: Expr, d: Sym, idx: int) -> boolean {
        return match e {
            .InitOf(decl: s, idx: x) :> s.id == d.id && x == idx
            .Lit(lit: l) :> false
            .Local(sym: s) :> false
            .Read(place: pl) :> false
            .Call(callee: c) :> false
            .Prim(op: o) :> false
            .Match(scrut: s) :> false
            .ArrayOf(elems: es) :> false
            .StructOf(ty: t) :> false
            .Handle(inst: i) :> false
            .Host(call: c) :> false
            .Lambda(params: ps) :> false
            .SeqCall(op: o) :> false
            .Validity(of: x) :> false
            .ServerCall(fn: x) :> false
        }
    }

    // L12 (b): the instances d's renders mounts unconditionally are created
    // with d's record, in document order, and their `as=` handles bound — so an
    // unconditional handle names a live instance before any render or user code.
    fn kidsJs(fctx: Ctx, d: Decl) -> JsStmt[] {
        const views: View[] | not = d.renders
        if (views is not) return []
        if (!fctx.prebuilt) return []
        let out: JsStmt[] = []
        let k = 0
        for (const v of mountedInstances(views)) {
            out = out.concat(kidJs(fctx, v, k))
            k = k + 1
        }
        return out
    }

    fn kidJs(fctx: Ctx, v: View, k: int) -> JsStmt[] {
        return match v {
            .Instance(decl: ds, attrs: attrs, alias: alias) :> kidCreate(fctx, ds, attrs, alias, k)
            .El :> []
            .Text :> []
            .Dyn :> []
            .Cond :> []
            .Each :> []
            .Slot :> []
            .Star :> []
            .Effect :> []
            .ResetOn :> []
            .Errors :> []
        }
    }

    fn kidCreate(fctx: Ctx, ds: Sym, attrs: ConstructAttr[], alias: Sym | not, k: int) -> JsStmt[] {
        const kd: Decl | not = findDecl(fctx.p, ds)
        if (kd is not) return [sexpr(jid("unboundDecl$" + ds.id))]
        const slotE: JsExpr = kidSlot(fctx, k, ds.hint)
        let out: JsStmt[] = [JsStmt.SAssign(slotE, createJs(fctx, kd, attrs, jmember(jid("inst$"), "scope")))]
        if (alias is some) out = out.concat([sexpr(rtCall(fctx, "bindHandle", [handleJs(fctx, alias), slotE]))])
        return out
    }

    fn defaultThunk(ctx: Ctx, d: Decl, f: Field) -> JsExpr {
        const init: Expr | not = f.init
        if (init is some) return jthunk(exprJs(ctx, init))
        return jthunk(rtCall(ctx, "noDefault", [jstr("<" + d.sym.hint + "> attribute `" + f.sym.hint + "`")]))
    }

    fn fieldCtor(ctx: Ctx, f: Field, init: JsExpr) -> JsExpr {
        const ps: Persist | not = f.persist
        if (ps is some && f.wcap is some) return persistedJs(ctx, f, ps, init)
        if (f.wcap is some) return rtCall(ctx, "seeded", [init])
        return rtCall(ctx, "derived", [jmember(jid("inst$"), "scope"), init])
    }

    // s451 — a `persist=` field (§6.14.2):
    // `rt.persisted(inst$.scope, <default thunk>, "local" | "session", <key>, <wire table>)`
    // — a seeded cell whose construction value is the stored value decoded
    // against the field's type (the §57 descriptor below), or the default; it
    // is written on change and (`"local"`) synced across tabs. C17 guarantees
    // the descriptor exists; `unwireable$` marks a Core that skipped check.
    fn persistedJs(ctx: Ctx, f: Field, ps: Persist, init: JsExpr) -> JsExpr {
        const wt: WireTable | not = wireBuild(ctx.p, f.ty).table
        let wire: JsExpr = jid("unwireable$" + f.sym.id)
        if (wt is some) wire = wireTableJs(wt)
        const where: PersistStore = ps.store
        const store: string = match where {
            .Local :> "local"
            .Session :> storeSession()
        }
        return rtCall(ctx, "persisted", [jmember(jid("inst$"), "scope"), init, jstr(store), jstr(ps.key), wire])
    }

    // The runtime's name for sessionStorage, spelled in pieces: impl#1 escalates
    // a function whose body holds the bare word to the SERVER, string literals
    // included (route-inference.ts, `/(?<!@)\bsession\b/` — see analyze.scrml
    // `sessionWord`).
    fn storeSession() -> string { return "sess" + "ion" }

    // s451 — the storage half of a reset (§6.14.2 rule 9): `rt.unpersist(<cell>)`
    // removes the key and cancels the store the reset's Write queued.
    fn unpersistJs(ctx: Ctx, dsym: Sym, inst: InstRef, idx: int) -> JsStmt {
        const d: Decl | not = findDecl(ctx.p, dsym)
        if (d is not) return sexpr(jid("unboundDecl$" + dsym.id))
        return sexpr(rtCall(ctx, "unpersist", [fieldCell(instJs(ctx, inst), d, idx)]))
    }

    // -------------------------------------------------------------------------
    // Functions.
    // -------------------------------------------------------------------------
    fn dedupe(xs: Sym[]) -> Sym[] {
        let out: Sym[] = []
        for (const x of xs) { if (!symIn(out, x)) out = out.concat([x]) }
        return out
    }

    fn fnJs(ctx: Ctx, f: Fn) -> JsStmt {
        // Prologue: one local per shared instance the body references.
        let prologue: JsStmt[] = []
        let shared: SharedLoc[] = []
        for (const d of dedupe(sharedRefs(Node.NFn(f)))) {
            const local: string = d.hint.replaceAll("$", "_") + "$"
            prologue = prologue.concat([JsStmt.SConst(local, jcall(jid(nameOf(ctx.names, NameKey.SharedGet(d.id))), []))])
            shared = shared.concat([{ decl: d.id, js: jid(local) }])
        }
        let ret: string = ""
        if (f.waits) ret = "ret$"
        const fctx: Ctx = { p: ctx.p, names: ctx.names, lexical: [], handles: [], shared: shared, rows: [], slot: JsExpr.JNull, prebuilt: false, ret: ret }
        let params: string[] = []
        for (const p of f.params) { params = params.concat([symName(ctx, p.sym)]) }
        if (!f.waits) return JsStmt.SFunc(symName(ctx, f.sym), params, prologue.concat(blockJs(fctx, f.body)))
        // s454 (U1b) — a WAITING function (Fn.waits, §13.2 async colour; design
        // §2.3 "a return continuation"): it takes its caller's task first and
        // returns a Promise its body settles — `return ret$(v)` on every exit,
        // from the body or from any continuation (lower ends every path that
        // falls off with an explicit Return). `rt.waiting` never rejects through
        // a scrml failure: a `fail` resolves with the Failure value.
        return JsStmt.SFunc(symName(ctx, f.sym), ["task$"].concat(params),
            prologue.concat([JsStmt.SReturn(rtCall(ctx, "waiting", [JsExpr.JArrow(["ret$"], blockJs(fctx, f.body))]))]))
    }

    // -------------------------------------------------------------------------
    // The program.
    // -------------------------------------------------------------------------
    // s451 (U1a) — THE SERVER REFUSAL. Route inference now places functions on
    // the server (§12.2) and a ServerFn reaches Core, but the bootstrap prints
    // only the CLIENT artifact. A program with server functions printed without
    // them would be the client half of a program whose server half does not
    // exist — §12.3 obliges a route handler and a client fetch call for EVERY
    // server-escalated function. So the whole program is refused, naming the
    // slice that lifts it, rather than printed incomplete.
    // the SQL sigil for messages, in two pieces (parse.scrml sqlSigil)
    fn sqlSigil() -> string { return "?" + "{" }

    // s454 (U1b): the refusal of a program WITH server functions is lifted —
    // the client artifact is printed, its server half omitted (U1c). A query
    // anywhere but a server function is still refused (C-S2 makes it
    // unrepresentable; this keeps the printer fail-closed on a bad Core).
    fn serverRefusal(p: CoreProgram) -> string[] {
        let out: string[] = []
        if (holdsQuery(p) && p.server.length == 0) {
            out = out.concat(["E-BOOTSTRAP-UNSUPPORTED: this program holds a `" + sqlSigil() + "}` query outside a server function — the client printer has no SQL (unit U1c)"])
        }
        return out
    }

    fn holdsQuery(p: CoreProgram) -> boolean {
        for (const n of allNodes(Node.NProgram(p))) {
            if (nodeIsQuery(n)) return true
        }
        return false
    }

    fn nodeIsQuery(n: Node) -> boolean {
        return match n {
            .NStmt(s: s) :> stmtIsQuery(s)
            .NExpr(e: x) :> false
            .NProgram(p: x) :> false
            .NDecl(d: x) :> false
            .NField(f: x) :> false
            .NFn(f: x) :> false
            .NServerFn(f: x) :> false
            .NBlock(b: x) :> false
            .NPlace(pl: x) :> false
            .NInst(i: x) :> false
            .NPattern(pat: x) :> false
            .NEdit(k: x) :> false
            .NView(v: x) :> false
            .NAttr(a: x) :> false
        }
    }

    fn stmtIsQuery(s: Stmt) -> boolean {
        return match s {
            .Attempt(call: c) :> failableIsQuery(c)
            .Let(sym: x) :> false
            .Assign(local: x) :> false
            .Write(cap: x) :> false
            .Commit(writes: x) :> false
            .If(cond: x) :> false
            .Return(e: x) :> false
            .Eval(e: x) :> false
            .Suspend(bind: x) :> false
            .ResetSurface(of: x) :> false
            .Defer(body: x) :> false
            .Unpersist(decl: x) :> false
            .Fail(err: x) :> false
            .Join(k: x) :> false
            .Jump(k: x) :> false
        }
    }

    fn failableIsQuery(c: Failable) -> boolean {
        return match c {
            .FSql(q: x) :> true
            .FCall(fn: x) :> false
            .FSettled(outcome: x) :> false
        }
    }

    export fn printProgram(p: CoreProgram, jsFile: string, runtimeFile: string) -> Output {
        const refused: string[] = serverRefusal(p)
        if (refused.length > 0) return { js: "", html: "", refused: refused, routes: [] }
        const names: NameTable = planNames(p)
        const ctx: Ctx = baseCtx(p, names)
        const rt: string = rtName(ctx)
        const sharedUsed: Sym[] = dedupe(sharedRefs(Node.NProgram(p)).concat([p.program]))
        let body: JsStmt[] = [
            JsStmt.SComment(jsFile + " — generated by the scrml bootstrap printer (self-host-v2, slice M1). Do not edit."),
            JsStmt.SImportAll(rt, "./" + runtimeFile),
        ]
        let templates: Template[] = []
        for (const d of p.decls) {
            const r: Rendered = declJs(ctx, d, sharedUsed)
            body = body.concat(r.stmts)
            templates = templates.concat(r.templates)
        }
        // s454 (U1b): the routes of the server functions the client calls
        const called: ServerFn[] = calledServerFns(p)
        let routes: RouteOut[] = []
        if (called.length > 0) body = body.concat([JsStmt.SBlank, JsStmt.SComment("server routes (the client half of each call — the server artifact is unit U1c)")])
        for (const sf of called) {
            body = body.concat([routeJs(p, sf)])
            routes = routes.concat([{ fn: sf.sym.hint, path: routePath(sf.sym) }])
        }
        // s454 (U1b): a function whose calls reach a server function IN PLACE
        // (§12.2 Trigger 5 — server-placed by inheritance) is server code: it
        // is not in the client artifact.
        const serverOnly: int[] = serverOnlyFns(p)
        let clientFns: Fn[] = []
        for (const f of p.fns) { if (!hasInt(serverOnly, f.sym.id)) clientFns = clientFns.concat([f]) }
        if (clientFns.length > 0) body = body.concat([JsStmt.SBlank, JsStmt.SComment("functions")])
        for (const f of clientFns) { body = body.concat([fnJs(ctx, f)]) }
        // Boot: render the program's shared instance at the end of <body>.
        const progLocal: string = p.program.hint.replaceAll("$", "_") + "$"
        body = body.concat([
            JsStmt.SBlank,
            JsStmt.SComment("boot"),
            JsStmt.SConst(progLocal, jcall(jid(nameOf(names, NameKey.SharedGet(p.program.id))), [])),
            sexpr(jcall(jid(nameOf(names, NameKey.Render(p.program.id))), [
                jid(progLocal), jmember(jid(progLocal), "scope"),
                rtCall(ctx, "mount", [jmember(jid("document"), "body")]), JsExpr.JNull,
            ])),
        ])
        let head: HNode[] = [HNode.HElem("script", [{ name: "type", value: "module" }, { name: "src", value: jsFile }], [])]
        // s451 — §65.3.4: the built-in reset, its own bottom `@layer`, unless
        // `<program reset="none">`. The fixed reset text holds no `<` / `&`, so
        // the escaping text node prints it verbatim inside `<style>`.
        if (p.reset) {
            const css: string = emitCss({ charsets: [], imports: [], reset: true, tokens: [], global: [], scopes: [] })
            head = [HNode.HElem("style", [], [HNode.HText(css)])].concat(head)
        }
        for (const t of templates) {
            head = head.concat([HNode.HElem("template", [{ name: "id", value: t.id }], t.nodes)])
        }
        const page: Page = { title: p.program.hint, head: head, body: [] }
        return { js: printModule(body), html: printPage(page), refused: [], routes: routes }
    }

    // =========================================================================
    // s454 (U1b) — THE CLIENT HALF OF A SERVER CALL'S ROUTE (design Item 3).
    // One module constant per server function the client calls:
    //   const route$saveNote = { path, params: [<table>…], result, error };
    // `params`: the §57 wire table of each parameter (the request body is a
    // JSON ARRAY of the encoded arguments, in parameter order — Item 3.1);
    // `result`: the declared return type's table, `null` for a function that
    // yields no value (the 204 contract — Item 3.2; analyze refuses a client
    // call of a server function that yields a value it does not declare);
    // `error`: the declared error enum's table (the §57.8 `fail` envelope is
    // decoded against it, strictly), `null` for a function not declared `!`.
    // The path is compiler-internal, minted from the Sym (U1 design §4: "never
    // the name") — both ends are one compile.
    // =========================================================================
    export fn routePath(s: Sym) -> string { return "/_scrml/call/" + s.id }

    fn routeJs(p: CoreProgram, sf: ServerFn) -> JsStmt {
        let params: JsExpr[] = []
        for (const prm of sf.params) { params = params.concat([wireOrNull(p, prm.ty)]) }
        let result: JsExpr = JsExpr.JNull
        const rt: Type | not = sf.ret
        if (rt is some) result = wireOrNull(p, rt)
        let error: JsExpr = JsExpr.JNull
        const e: Sym | not = sf.err
        if (e is some) error = wireOrNull(p, Type.Named(e))
        return JsStmt.SConst(routeName(sf.sym), JsExpr.JObject([
            { key: "path", value: jstr(routePath(sf.sym)) },
            { key: "params", value: JsExpr.JArray(params) },
            { key: "result", value: result },
            { key: "error", value: error },
        ]))
    }

    // (C-S4: every routed type has a descriptor, so `null` here is unreachable on a checked Core.)
    fn wireOrNull(p: CoreProgram, t: Type) -> JsExpr {
        const wt: WireTable | not = wireBuild(p, t).table
        if (wt is some) return wireTableJs(wt)
        return JsExpr.JNull
    }

    // The ServerFns a ServerCall names, in program order, each once.
    fn calledServerFns(p: CoreProgram) -> ServerFn[] {
        let ids: int[] = []
        for (const n of allNodes(Node.NProgram(p))) {
            const s: Sym | not = nodeServerCall(n)
            if (s is some) { if (!hasInt(ids, s.id)) ids = ids.concat([s.id]) }
        }
        let out: ServerFn[] = []
        for (const sf of p.server) { if (hasInt(ids, sf.sym.id)) out = out.concat([sf]) }
        return out
    }

    fn nodeServerCall(n: Node) -> Sym | not {
        return match n {
            .NExpr(e: e) :> exprServerCall(e)
            .NStmt(s: x) :> not
            .NProgram(p: x) :> not
            .NDecl(d: x) :> not
            .NField(f: x) :> not
            .NFn(f: x) :> not
            .NServerFn(f: x) :> not
            .NBlock(b: x) :> not
            .NPlace(pl: x) :> not
            .NInst(i: x) :> not
            .NPattern(pat: x) :> not
            .NEdit(k: x) :> not
            .NView(v: x) :> not
            .NAttr(a: x) :> not
        }
    }

    fn exprServerCall(e: Expr) -> Sym | not {
        return match e {
            .ServerCall(fn: f) :> f
            .Lit(lit: x) :> not
            .Local(sym: x) :> not
            .Read(place: x) :> not
            .Call(callee: x) :> not
            .Prim(op: x) :> not
            .Match(scrut: x) :> not
            .ArrayOf(elems: x) :> not
            .StructOf(ty: x) :> not
            .Handle(inst: x) :> not
            .InitOf(decl: x) :> not
            .Host(call: x) :> not
            .Lambda(params: x) :> not
            .SeqCall(op: x) :> not
            .Validity(of: x) :> not
        }
    }

    // The Fns that call a server function IN PLACE — a plain Call of a ServerFn,
    // directly or through a Fn that does (a fixed point). check.scrml C-S3
    // guarantees no client root reaches one, so they are server code.
    fn serverOnlyFns(p: CoreProgram) -> int[] {
        let out: int[] = []
        let changed = true
        while (changed) {
            changed = false
            for (const f of p.fns) {
                if (!hasInt(out, f.sym.id)) {
                    let hit = false
                    for (const n of allNodes(Node.NFn(f))) {
                        const c: Sym | not = nodePlainCallee(n)
                        if (c is some) {
                            if (findServerFn(p, c) is some || hasInt(out, c.id)) hit = true
                        }
                    }
                    if (hit) {
                        out = out.concat([f.sym.id])
                        changed = true
                    }
                }
            }
        }
        return out
    }

    // The callee of a plain Call node (an Expr.Call, or an Attempt's FCall), else not.
    fn nodePlainCallee(n: Node) -> Sym | not {
        return match n {
            .NExpr(e: e) :> exprPlainCallee(e)
            .NStmt(s: s) :> stmtFCallee(s)
            .NProgram(p: x) :> not
            .NDecl(d: x) :> not
            .NField(f: x) :> not
            .NFn(f: x) :> not
            .NServerFn(f: x) :> not
            .NBlock(b: x) :> not
            .NPlace(pl: x) :> not
            .NInst(i: x) :> not
            .NPattern(pat: x) :> not
            .NEdit(k: x) :> not
            .NView(v: x) :> not
            .NAttr(a: x) :> not
        }
    }

    fn exprPlainCallee(e: Expr) -> Sym | not {
        return match e {
            .Call(callee: f) :> f
            .ServerCall(fn: x) :> not
            .Lit(lit: x) :> not
            .Local(sym: x) :> not
            .Read(place: x) :> not
            .Prim(op: x) :> not
            .Match(scrut: x) :> not
            .ArrayOf(elems: x) :> not
            .StructOf(ty: x) :> not
            .Handle(inst: x) :> not
            .InitOf(decl: x) :> not
            .Host(call: x) :> not
            .Lambda(params: x) :> not
            .SeqCall(op: x) :> not
            .Validity(of: x) :> not
        }
    }

    fn stmtFCallee(s: Stmt) -> Sym | not {
        return match s {
            .Attempt(call: c) :> failableCallee(c)
            .Let(sym: x) :> not
            .Assign(local: x) :> not
            .Write(cap: x) :> not
            .Commit(writes: x) :> not
            .If(cond: x) :> not
            .Return(e: x) :> not
            .Eval(e: x) :> not
            .Suspend(bind: x) :> not
            .ResetSurface(of: x) :> not
            .Defer(body: x) :> not
            .Unpersist(decl: x) :> not
            .Fail(err: x) :> not
            .Join(k: x) :> not
            .Jump(k: x) :> not
        }
    }

    fn failableCallee(c: Failable) -> Sym | not {
        return match c {
            .FCall(fn: f) :> f
            .FSql(q: x) :> not
            .FSettled(outcome: x) :> not
        }
    }
}
