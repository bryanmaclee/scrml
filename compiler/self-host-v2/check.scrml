// =============================================================================
// self-host-v2 / check.scrml — Core well-formedness: the printer's precondition
// and M2's gate on `lower`'s output.
//
// "Grants are symbols": a field has a write capability Sym (Field.wcap) iff its
// contract grants some write, and every `Stmt.Write` names a capability. So a
// write to a locked or derived field is not a checked-and-rejected Core node —
// there is no capability Sym for it to name (see core.scrml, THE BINDER'S
// OBLIGATION). What this module checks:
//   C1  wcap is some  ⟺  the field grants a write (replace, an edit, a graph)
//   C2  every Write's `cap` is some field's wcap (else: a dangling capability)
//   C3  the Write's edit is granted by that field's contract (§66.11, §66.12):
//       `replace` subsumes the sequence edits (§66.11.3); a Transition needs a
//       graph; a FieldAt(path) must be a well-typed struct path whose TARGET
//       field grants a write (per-field `let`) — or the outer field grants
//       `replace` AND no field on the path carries a non-replace contract (a
//       replace may not bypass a contract the equivalent direct edit would have
//       to follow). A genuine `.Replace` is NOT bounded by sub-field contracts
//       (O58 = (b), ruled S437 — see the Replace arm).
//   C4  the Write's instance reference resolves to the capability's OWN
//       declaration (Shared(X) → X; Lexical(k) → the k-th enclosing declaration;
//       Alias(h) → the declaration of the use that binds h; Narrowed(c) → what
//       `c` was bound to)
//   C5  every cell READ is well-formed the same way (its InstRef resolves to its
//       declaration; its first path step is a field of that declaration)
//   C6  a Write's `check` is sound: RuntimeEdge only on a Transition; a
//       transition's value, when literal, is a variant of the graph's enum; and
//       `Static` only when the Core itself proves the edge — the value is a
//       literal variant that every state may move to (or already is: a self-write
//       is a no-op, §51.0.F.1). No flow facts exist in Core, so a from-state
//       "proven by a dominating test" is NOT provable here: lower must emit
//       RuntimeEdge for it (L8).
//   C7  a Commit (all-or-nothing spread edit, RULED S440) holds ≥ 2 Writes and
//       nothing else, each storing a Local (the snapshot its Let evaluated)
//   C8  (s444) a Bind writes exactly its event-value sink, once, to the place
//       its `read` reads (Replace or FieldAt of that field)
//   C9  (s444) a removal's value: RemoveEnd / RemoveFront carry an Int count
//       ≥ 1; RemoveAnywhere carries `SeqCall(Filter, <the field itself>, λ)`
//   C10 (s444) a Star's instance resolves to its declaration (C4's rule), and
//       that declaration has a renders
//   C11 (s446) a When's dep-list is non-empty, every dep resolves (C4's rule)
//       to a MUTABLE field (one with a write capability — E-LIFECYCLE-007), and
//       the body writes no dep (E-LIFECYCLE-006)
//   C12 (s446) a Suspend stands only at the tail of an effect body (a When
//       body, or the `then` of another Suspend) — the CPS split point
//   (C3 covers the s444 edits: the removals by the field's grants; ElemAt by
//   the ELEMENT field's own contract, dpa-052 Q3.)
// A diagnostic is a message string (§4 permits strings as text).
// =============================================================================
${
    import { Sym, Type, TypeDef, FieldDef, VariantDef, FieldRef, InstRef, Place, Literal, Expr, SeqFn, Attr, Block,
             EditKind, Check, Stmt, View, WhenDep, Field, Decl, CoreProgram, CapOwner, TransitionGraph,
             capOwner, grantsAnyWrite, findDecl, findTypeDef } from "./core.scrml"
    import { Node, allNodes } from "./walk.scrml"

    export fn checkCore(p: CoreProgram) -> string[] {
        let out: string[] = []
        for (const d of p.decls) {
            for (const f of d.fields) { out = out.concat(checkField(d, f)) }
        }
        // Context = the lexically enclosing declarations (index 0 = nearest). In
        // Core, declarations do not nest (a child declaration is a Field), so a
        // node inside declaration d's initializers/renders has context [d], and a
        // function body has none.
        for (const d of p.decls) {
            for (const n of allNodes(Node.NDecl(d))) { out = out.concat(checkNode(p, [d], n)) }
        }
        for (const f of p.fns) {
            for (const n of allNodes(Node.NFn(f))) { out = out.concat(checkNode(p, [], n)) }
        }
        for (const s of p.server) {
            for (const n of allNodes(Node.NServerFn(s))) { out = out.concat(checkNode(p, [], n)) }
        }
        return out.concat(checkSuspends(p))
    }

    fn checkField(d: Decl, f: Field) -> string[] {
        const has: boolean = f.wcap is some
        const grants: boolean = grantsAnyWrite(f) || f.graph is some
        if (has && !grants) return ["C1: <" + d.sym.hint + ">." + f.sym.hint + " has a write capability but grants no write"]
        if (!has && grants) return ["C1: <" + d.sym.hint + ">." + f.sym.hint + " grants a write but has no write capability"]
        return []
    }

    fn checkNode(p: CoreProgram, encl: Decl[], n: Node) -> string[] {
        return match n {
            .NStmt(s: s) :> checkStmt(p, encl, s)
            .NPlace(pl: pl) :> checkPlace(p, encl, pl)
            .NExpr(e: e) :> checkExpr(p, encl, e)
            .NProgram(p: q) :> []
            .NDecl(d: d) :> []
            .NField(f: f) :> []
            .NFn(f: f) :> []
            .NServerFn(f: f) :> []
            .NBlock(b: b) :> []
            .NInst(i: i) :> []
            .NPattern(pat: pat) :> []
            .NEdit(k: k) :> []
            .NView(v: v) :> checkView(p, encl, v)
            .NAttr(a: a) :> checkAttr(p, encl, a)
        }
    }

    // -------------------------------------------------------------------------
    // C8 (s444) — a Bind is ONE capability-checked write of its event-value
    // sink to the place its `read` reads: `write` is exactly
    // [Write(cap, inst, Replace | FieldAt(path), Local(sink), _)], and `read` is
    // Read(Cell(<cap's declaration>, inst, [<cap's field>] ++ path)) — so the
    // value shown and the value written are the same place.
    // -------------------------------------------------------------------------
    fn checkAttr(p: CoreProgram, encl: Decl[], a: Attr) -> string[] {
        return match a {
            .Bind(kind: k, read: r, sink: sk, write: w) :> checkBind(p, r, sk, w)
            .Static(name: x) :> []
            .Bound(name: x) :> []
            .On(event: x) :> []
        }
    }

    fn checkBind(p: CoreProgram, read: Expr, sink: Sym, write: Block) -> string[] {
        if (write.stmts.length != 1) return ["C8: a bind writes " + write.stmts.length + " statement(s); it is exactly one Write of its sink"]
        const w: Stmt = write.stmts[0]
        return match w {
            .Write(cap: cap, inst: inst, edit: edit, value: v) :> bindWrite(p, read, sink, cap, inst, edit, v)
            .Let(sym: x) :> ["C8: a bind's write is not a Write"]
            .Assign(local: x) :> ["C8: a bind's write is not a Write"]
            .Commit(writes: x) :> ["C8: a bind's write is not a Write"]
            .If(cond: x) :> ["C8: a bind's write is not a Write"]
            .Return(e: x) :> ["C8: a bind's write is not a Write"]
            .Eval(e: x) :> ["C8: a bind's write is not a Write"]
            .Suspend(bind: x) :> ["C8: a bind's write is not a Write"]
        }
    }

    fn bindWrite(p: CoreProgram, read: Expr, sink: Sym, cap: Sym, inst: InstRef, edit: EditKind, v: Expr) -> string[] {
        let out: string[] = []
        if (!isLocalOf(v, sink)) out = out.concat(["C8: a bind's Write stores something other than its sink `" + sink.hint + "`"])
        const owner: CapOwner | not = capOwner(p, cap)
        if (owner is not) return out                     // C2 reports it
        let want: FieldRef[] = [{ owner: owner.decl.sym, idx: owner.idx }]
        const extra: FieldRef[] | not = bindEditPath(edit)
        if (extra is not) return out.concat(["C8: a bind's Write is not a replace of its place (Replace or FieldAt)"])
        want = want.concat(extra)
        const got: string = readKey(read)
        const exp: string = placeKeyOf(owner.decl.sym, inst, want)
        if (got != exp) out = out.concat(["C8: a bind reads " + got + " but writes " + exp])
        return out
    }

    fn bindEditPath(k: EditKind) -> FieldRef[] | not {
        return match k {
            .Replace :> []
            .FieldAt(path: path) :> path
            .Append :> not
            .Prepend :> not
            .Anywhere :> not
            .PositionWrite :> not
            .Transition :> not
            .RemoveEnd :> not
            .RemoveFront :> not
            .RemoveAnywhere :> not
            .ElemAt(index: x) :> not
        }
    }

    fn isLocalOf(e: Expr, s: Sym) -> boolean {
        return match e {
            .Local(sym: x) :> x.id == s.id
            .Lit(lit: x) :> false
            .Read(place: x) :> false
            .Call(callee: x) :> false
            .Prim(op: x) :> false
            .Match(scrut: x) :> false
            .ArrayOf(elems: x) :> false
            .StructOf(ty: x) :> false
            .Handle(inst: x) :> false
            .InitOf(decl: x) :> false
            .Host(call: x) :> false
            .Lambda(params: x) :> false
            .SeqCall(op: x) :> false
        }
    }

    // A cell read's identity, as text of ids.
    fn readKey(e: Expr) -> string {
        return match e {
            .Read(place: pl) :> cellKey(pl)
            .Lit(lit: x) :> "(not a cell read)"
            .Local(sym: x) :> "(not a cell read)"
            .Call(callee: x) :> "(not a cell read)"
            .Prim(op: x) :> "(not a cell read)"
            .Match(scrut: x) :> "(not a cell read)"
            .ArrayOf(elems: x) :> "(not a cell read)"
            .StructOf(ty: x) :> "(not a cell read)"
            .Handle(inst: x) :> "(not a cell read)"
            .InitOf(decl: x) :> "(not a cell read)"
            .Host(call: x) :> "(not a cell read)"
            .Lambda(params: x) :> "(not a cell read)"
            .SeqCall(op: x) :> "(not a cell read)"
        }
    }

    fn cellKey(pl: Place) -> string {
        return match pl {
            .Cell(decl: d, inst: i, path: path) :> placeKeyOf(d, i, path)
            .LocalPath(sym: s) :> "(a local path)"
        }
    }

    fn placeKeyOf(d: Sym, i: InstRef, path: FieldRef[]) -> string {
        let k: string = "<" + d.hint + "#" + d.id + ">@" + instIdKey(i)
        for (const r of path) { k = k + "." + r.owner.id + ":" + r.idx }
        return k
    }

    fn instIdKey(i: InstRef) -> string {
        return match i {
            .Shared(decl: d) :> "S" + d.id
            .Lexical(depth: k) :> "L" + k
            .Alias(sym: s) :> "A" + s.id
            .Narrowed(sym: s) :> "N" + s.id
        }
    }

    // -------------------------------------------------------------------------
    // C10 (s444) — a Star renders an EXISTING instance with its declaration's
    // renders: the instance resolves to that declaration (C4's rule), and the
    // declaration has a renders.
    // -------------------------------------------------------------------------
    fn checkView(p: CoreProgram, encl: Decl[], v: View) -> string[] {
        return match v {
            .Star(decl: d, inst: i) :> checkStar(p, encl, d, i)
            .When(deps: ds, body: b) :> checkWhen(p, encl, ds, b)
            .El(tag: x) :> []
            .Text(text: x) :> []
            .Dyn(e: x) :> []
            .Cond(arms: x) :> []
            .Each(src: x) :> []
            .Instance(decl: x) :> []
            .Slot :> []
        }
    }

    // -------------------------------------------------------------------------
    // C11 (s446) — a When (§6.7.4): its dep-list is non-empty; every dep
    // resolves (C4's rule) to a field of its declaration that has a write
    // capability — a locked or derived field has no change event
    // (E-LIFECYCLE-007); and the body writes no dep through the dep's own
    // instance (E-LIFECYCLE-006 — the effect would re-trigger itself).
    // -------------------------------------------------------------------------
    fn checkWhen(p: CoreProgram, encl: Decl[], deps: WhenDep[], body: Block) -> string[] {
        let out: string[] = []
        if (deps.length == 0) out = out.concat(["C11: a When has an empty dep-list (§6.7.4: at least one entry)"])
        for (const dep of deps) { out = out.concat(checkWhenDep(p, encl, dep)) }
        for (const n of allNodes(Node.NBlock(body))) { out = out.concat(depWriteProblems(p, deps, n)) }
        return out
    }

    fn checkWhenDep(p: CoreProgram, encl: Decl[], dep: WhenDep) -> string[] {
        const d: Decl | not = findDecl(p, dep.decl)
        if (d is not) return ["C11: a When dep names declaration `" + dep.decl.hint + "`, which does not exist"]
        const target: Decl | not = resolveInst(p, encl, dep.inst)
        if (target is not) return ["C11: a When dep of <" + d.sym.hint + "> goes through " + instText(dep.inst) + ", which does not resolve"]
        if (target.sym.id != d.sym.id) return ["C11: a When dep of <" + d.sym.hint + "> goes through " + instText(dep.inst) + ", an instance of <" + target.sym.hint + ">"]
        if (dep.idx < 0 || dep.idx >= d.fields.length) return ["C11: a When dep names field " + dep.idx + " of <" + d.sym.hint + ">, which has no such field"]
        const f: Field = d.fields[dep.idx]
        if (f.wcap is not) return ["C11: a When dep <" + d.sym.hint + ">." + f.sym.hint + " is not a mutable cell (no write capability — a locked or derived field has no change event)"]
        return []
    }

    fn depWriteProblems(p: CoreProgram, deps: WhenDep[], n: Node) -> string[] {
        return match n {
            .NStmt(s: s) :> stmtDepWrite(p, deps, s)
            .NProgram(p: q) :> []
            .NDecl(d: d) :> []
            .NField(f: f) :> []
            .NFn(f: f) :> []
            .NServerFn(f: f) :> []
            .NBlock(b: b) :> []
            .NExpr(e: e) :> []
            .NPlace(pl: pl) :> []
            .NInst(i: i) :> []
            .NPattern(pat: pat) :> []
            .NEdit(k: k) :> []
            .NView(v: v) :> []
            .NAttr(a: a) :> []
        }
    }

    fn stmtDepWrite(p: CoreProgram, deps: WhenDep[], s: Stmt) -> string[] {
        return match s {
            .Write(cap: cap, inst: inst) :> writesDep(p, deps, cap, inst)
            .Let(sym: x) :> []
            .Assign(local: x) :> []
            .Commit(writes: x) :> []
            .If(cond: x) :> []
            .Return(e: x) :> []
            .Eval(e: x) :> []
            .Suspend(bind: x) :> []
        }
    }

    fn writesDep(p: CoreProgram, deps: WhenDep[], cap: Sym, inst: InstRef) -> string[] {
        const owner: CapOwner | not = capOwner(p, cap)
        if (owner is not) return []                     // C2 reports it
        for (const dep of deps) {
            if (dep.decl.id == owner.decl.sym.id && dep.idx == owner.idx && instIdKey(dep.inst) == instIdKey(inst)) {
                return ["C11: a When body writes its own dep <" + owner.decl.sym.hint + ">." + owner.decl.fields[owner.idx].sym.hint + " (E-LIFECYCLE-006: the effect would re-trigger itself)"]
            }
        }
        return []
    }

    // -------------------------------------------------------------------------
    // C12 (s446) — a Suspend is a CPS split point: its continuation is its
    // `then`, so nothing may follow it in its block, and in U0 it stands only
    // at the TAIL of an effect body — a When body, or (a chain) the `then` of
    // another Suspend. In an If branch the statements after the If would run
    // before the branch's continuation; in a function, handler or bind there
    // is no owning effect to cancel it on teardown (U1 widens this).
    // -------------------------------------------------------------------------
    fn checkSuspends(p: CoreProgram) -> string[] {
        let total: int = 0
        let legal: int = 0
        for (const n of allNodes(Node.NProgram(p))) {
            total = total + suspendAt(n)
            legal = legal + whenTails(n)
        }
        if (total == legal) return []
        return ["C12: " + (total - legal) + " Suspend(s) stand outside the tail of an effect body (a When body or a Suspend's continuation, and last in that block)"]
    }

    fn suspendAt(n: Node) -> int {
        return match n {
            .NStmt(s: s) :> suspendThenCount(s)
            .NProgram(p: q) :> 0
            .NDecl(d: d) :> 0
            .NField(f: f) :> 0
            .NFn(f: f) :> 0
            .NServerFn(f: f) :> 0
            .NBlock(b: b) :> 0
            .NExpr(e: e) :> 0
            .NPlace(pl: pl) :> 0
            .NInst(i: i) :> 0
            .NPattern(pat: pat) :> 0
            .NEdit(k: k) :> 0
            .NView(v: v) :> 0
            .NAttr(a: a) :> 0
        }
    }

    fn suspendThenCount(s: Stmt) -> int {
        const t: Block | not = suspendThen(s)
        if (t is some) return 1
        return 0
    }

    fn suspendThen(s: Stmt) -> Block | not {
        return match s {
            .Suspend(then: t) :> t
            .Let(sym: x) :> not
            .Assign(local: x) :> not
            .Write(cap: x) :> not
            .Commit(writes: x) :> not
            .If(cond: x) :> not
            .Return(e: x) :> not
            .Eval(e: x) :> not
        }
    }

    fn whenTails(n: Node) -> int {
        return match n {
            .NView(v: v) :> viewWhenTails(v)
            .NProgram(p: q) :> 0
            .NDecl(d: d) :> 0
            .NField(f: f) :> 0
            .NFn(f: f) :> 0
            .NServerFn(f: f) :> 0
            .NBlock(b: b) :> 0
            .NStmt(s: s) :> 0
            .NExpr(e: e) :> 0
            .NPlace(pl: pl) :> 0
            .NInst(i: i) :> 0
            .NPattern(pat: pat) :> 0
            .NEdit(k: k) :> 0
            .NAttr(a: a) :> 0
        }
    }

    fn viewWhenTails(v: View) -> int {
        return match v {
            .When(body: b) :> tailChain(b)
            .El(tag: x) :> 0
            .Text(text: x) :> 0
            .Dyn(e: x) :> 0
            .Cond(arms: x) :> 0
            .Each(src: x) :> 0
            .Instance(decl: x) :> 0
            .Slot :> 0
            .Star(decl: x) :> 0
        }
    }

    // The legally placed Suspends of a chain: the block's LAST statement, if a
    // Suspend, and those of its continuation.
    fn tailChain(b: Block) -> int {
        if (b.stmts.length == 0) return 0
        const t: Block | not = suspendThen(b.stmts[b.stmts.length - 1])
        if (t is not) return 0
        return 1 + tailChain(t)
    }

    fn checkStar(p: CoreProgram, encl: Decl[], dsym: Sym, i: InstRef) -> string[] {
        const d: Decl | not = findDecl(p, dsym)
        if (d is not) return ["C10: a Star names declaration `" + dsym.hint + "`, which does not exist"]
        const target: Decl | not = resolveInst(p, encl, i)
        if (target is not) return ["C10: a Star of <" + d.sym.hint + "> goes through " + instText(i) + ", which does not resolve"]
        if (target.sym.id != d.sym.id) return ["C10: a Star of <" + d.sym.hint + "> goes through " + instText(i) + ", an instance of <" + target.sym.hint + ">"]
        if (d.renders is not) return ["C10: a Star of <" + d.sym.hint + ">, which has no renders"]
        return []
    }

    fn checkStmt(p: CoreProgram, encl: Decl[], s: Stmt) -> string[] {
        return match s {
            .Write(cap: cap, inst: inst, edit: edit, value: v, check: ck) :> checkWrite(p, encl, cap, inst, edit, v, ck)
            .Commit(writes: ws) :> checkCommit(ws)
            .Let(sym: sym) :> []
            .Assign(local: l) :> []
            .If(cond: c) :> []
            .Return(e: e) :> []
            .Eval(e: e) :> []
            .Suspend(bind: b) :> []
        }
    }

    // C7: a Commit (an all-or-nothing spread edit, RULED S440) groups two or
    // more Writes and nothing else, and every Write's value is a Local — the
    // snapshot its Let evaluated — so the printer may read a value once to
    // check it and again to apply it. Its Writes themselves are checked by
    // C2–C6 as every Write is (walk visits them as ordinary statements).
    fn checkCommit(ws: Stmt[]) -> string[] {
        let out: string[] = []
        if (ws.length < 2) out = out.concat(["C7: a Commit groups " + ws.length + " write(s); one write is already all-or-nothing — it must be a plain Write"])
        for (const w of ws) {
            const problem: string = commitMember(w)
            if (problem != "") out = out.concat(["C7: " + problem])
        }
        return out
    }

    fn commitMember(s: Stmt) -> string {
        return match s {
            .Write(value: v) :> commitValue(v)
            .Commit(writes: x) :> "a Commit nested in a Commit"
            .Let(sym: x) :> "a Let inside a Commit (its Lets come before it)"
            .Assign(local: x) :> "an Assign inside a Commit"
            .If(cond: x) :> "an If inside a Commit"
            .Return(e: x) :> "a Return inside a Commit"
            .Eval(e: x) :> "an Eval inside a Commit"
            .Suspend(bind: x) :> "a Suspend inside a Commit"
        }
    }

    fn commitValue(v: Expr) -> string {
        return match v {
            .Local(sym: x) :> ""
            .Lit(lit: x) :> "a Commit write's value is not a Local (the snapshot)"
            .Read(place: x) :> "a Commit write's value is not a Local (the snapshot)"
            .Call(callee: x) :> "a Commit write's value is not a Local (the snapshot)"
            .Prim(op: x) :> "a Commit write's value is not a Local (the snapshot)"
            .Match(scrut: x) :> "a Commit write's value is not a Local (the snapshot)"
            .ArrayOf(elems: x) :> "a Commit write's value is not a Local (the snapshot)"
            .StructOf(ty: x) :> "a Commit write's value is not a Local (the snapshot)"
            .Handle(inst: x) :> "a Commit write's value is not a Local (the snapshot)"
            .InitOf(decl: x) :> "a Commit write's value is not a Local (the snapshot)"
            .Host(call: x) :> "a Commit write's value is not a Local (the snapshot)"
            .Lambda(params: x) :> "a Commit write's value is not a Local (the snapshot)"
            .SeqCall(op: x) :> "a Commit write's value is not a Local (the snapshot)"
        }
    }

    fn checkWrite(p: CoreProgram, encl: Decl[], cap: Sym, inst: InstRef, edit: EditKind, value: Expr, check: Check) -> string[] {
        const owner: CapOwner | not = capOwner(p, cap)
        if (owner is not) return ["C2: a write names sym " + cap.id + " (`" + cap.hint + "`), which is not a write capability"]
        const d: Decl = owner.decl
        const f: Field = d.fields[owner.idx]
        const where: string = "<" + d.sym.hint + ">." + f.sym.hint
        let out: string[] = []
        const target: Decl | not = resolveInst(p, encl, inst)
        if (target is not) {
            out = out.concat(["C4: the write to " + where + " goes through an instance reference that does not resolve (" + instText(inst) + ")"])
        } else {
            if (target.sym.id != d.sym.id) {
                out = out.concat(["C4: the write to " + where + " goes through " + instText(inst) + ", an instance of <" + target.sym.hint + ">"])
            }
        }
        const problem: string = editProblem(p, f, edit)
        if (problem != "") out = out.concat(["C3: " + where + ": " + problem])
        const cp: string = checkProblem(p, f, edit, value, check)
        if (cp != "") out = out.concat(["C6: " + where + ": " + cp])
        const rv: string = removalValueProblem(d.sym, owner.idx, edit, value)
        if (rv != "") out = out.concat(["C9: " + where + ": " + rv])
        return out
    }

    // C9 (s444) — a removal's value: RemoveEnd / RemoveFront carry the COUNT
    // removed (an Int literal >= 1); RemoveAnywhere carries the new value, which
    // must be `SeqCall(Filter, <this field>, f)` — a filter of the field itself,
    // so a shrink grant can never carry an arbitrary replace.
    fn removalValueProblem(d: Sym, idx: int, edit: EditKind, value: Expr) -> string {
        return match edit {
            .RemoveEnd :> countProblem(value)
            .RemoveFront :> countProblem(value)
            .RemoveAnywhere :> filterProblem(d, idx, value)
            .Replace :> ""
            .Append :> ""
            .Prepend :> ""
            .Anywhere :> ""
            .PositionWrite :> ""
            .FieldAt(path: x) :> ""
            .Transition :> ""
            .ElemAt(index: x) :> ""
        }
    }

    fn countProblem(v: Expr) -> string {
        const l: Literal | not = exprLiteral(v)
        if (l is not) return "a removal's count is not a literal"
        if (intAtLeastOne(l)) return ""
        return "a removal's count is not an int >= 1"
    }

    fn intAtLeastOne(l: Literal) -> boolean {
        return match l {
            .Int(v: n) :> n >= 1
            .Num(v: x) :> false
            .Str(v: x) :> false
            .Bool(v: x) :> false
            .Variant(enumSym: x) :> false
            .Absent :> false
        }
    }

    fn filterProblem(d: Sym, idx: int, v: Expr) -> string {
        return match v {
            .SeqCall(op: op, seq: sq) :> filterOf(d, idx, op, sq)
            .Lit(lit: x) :> "a shrink-anywhere's value is not a filter of the field"
            .Local(sym: x) :> "a shrink-anywhere's value is not a filter of the field"
            .Read(place: x) :> "a shrink-anywhere's value is not a filter of the field"
            .Call(callee: x) :> "a shrink-anywhere's value is not a filter of the field"
            .Prim(op: x) :> "a shrink-anywhere's value is not a filter of the field"
            .Match(scrut: x) :> "a shrink-anywhere's value is not a filter of the field"
            .ArrayOf(elems: x) :> "a shrink-anywhere's value is not a filter of the field"
            .StructOf(ty: x) :> "a shrink-anywhere's value is not a filter of the field"
            .Handle(inst: x) :> "a shrink-anywhere's value is not a filter of the field"
            .InitOf(decl: x) :> "a shrink-anywhere's value is not a filter of the field"
            .Host(call: x) :> "a shrink-anywhere's value is not a filter of the field"
            .Lambda(params: x) :> "a shrink-anywhere's value is not a filter of the field"
        }
    }

    fn filterOf(d: Sym, idx: int, op: SeqFn, sq: Expr) -> string {
        const isFilter: boolean = op == SeqFn.Filter
        if (!isFilter) return "a shrink-anywhere's value is a map, not a filter"
        const k: string = readKey(sq)
        const pre: string = "<" + d.hint + "#" + d.id + ">@"
        const tail: string = "." + d.id + ":" + idx
        if (k.indexOf(pre) != 0 || k.substring(k.length - tail.length) != tail) return "a shrink-anywhere filters " + k + ", not the field it writes"
        return ""
    }

    fn instText(i: InstRef) -> string {
        return match i {
            .Shared(decl: d) :> "Shared(" + d.hint + ")"
            .Lexical(depth: k) :> "Lexical(" + k + ")"
            .Alias(sym: s) :> "Alias(" + s.hint + ")"
            .Narrowed(sym: s) :> "Narrowed(" + s.hint + ")"
        }
    }

    // -------------------------------------------------------------------------
    // C3 — is the edit granted?  "" = granted, else the reason.
    // -------------------------------------------------------------------------
    fn editProblem(p: CoreProgram, f: Field, edit: EditKind) -> string {
        return match edit {
            .Transition :> transitionGranted(f)
            // O58 = (b) (RULED S437, user-voice "O58 b"): a GENUINE replace — a
            // non-spread value, `reset`, a server reload — is AUTHORITATIVE and is
            // not checked against sub-field contracts (`reset` restores the
            // declared initial state; a reload takes the server's state). The
            // spread spelling `@x = { ...@x, f: v }` is not a Replace: lower emits
            // it as FieldAt edits, judged by `f`'s own contract (C3/C6). O57 = no:
            // a contract-free sub-field bounds nothing.
            .Replace :> granted(f.grants.replace, "`replace` is not granted")
            .Append :> granted(f.grants.replace || hasEdit(f, EditKind.Append), "an end-append is not granted")
            .Prepend :> granted(f.grants.replace || hasEdit(f, EditKind.Prepend), "a front-prepend is not granted")
            .Anywhere :> granted(f.grants.replace || hasEdit(f, EditKind.Anywhere), "an anywhere-edit is not granted")
            .PositionWrite :> granted(f.grants.replace || hasEdit(f, EditKind.PositionWrite), "a position write is not granted")
            .FieldAt(path: path) :> fieldAtProblem(p, f, path)
            .RemoveEnd :> granted(f.grants.replace || hasEdit(f, EditKind.RemoveEnd), "a removal at the end is not granted")
            .RemoveFront :> granted(f.grants.replace || hasEdit(f, EditKind.RemoveFront), "a removal at the front is not granted")
            .RemoveAnywhere :> granted(f.grants.replace || hasEdit(f, EditKind.RemoveAnywhere), "a shrink-anywhere is not granted")
            .ElemAt(index: ix, path: path) :> elemAtProblem(p, f, path)
        }
    }

    // s444 — `@xs[i].f = v` (dpa-052 Q3, RULED S440): the path walks the
    // ELEMENT struct of the field's sequence type, and the write is granted
    // iff the TARGET element field grants `replace` (its own contract — not a
    // position replace, not the outer field's grants).
    fn elemAtProblem(p: CoreProgram, f: Field, path: FieldRef[]) -> string {
        if (path.length == 0) return "an empty ElemAt path (a whole-element write is a position write)"
        const et: Type | not = seqElemOf(f.ty)
        if (et is not) return "ElemAt on a field whose value is not a sequence"
        let ty: Type = et
        let targetGrants = false
        let i = 0
        for (const step of path) {
            const s: Sym | not = namedSym(ty)
            if (s is not) return "ElemAt step " + i + " steps into a value that is not a struct"
            if (s.id != step.owner.id) return "ElemAt step " + i + " names owner `" + step.owner.hint + "` but the value there is a `" + s.hint + "`"
            const td: TypeDef | not = findTypeDef(p, s)
            if (td is not) return "ElemAt step " + i + ": `" + s.hint + "` is not a declared type"
            const fs: FieldDef[] | not = structFields(td)
            if (fs is not) return "ElemAt step " + i + ": `" + s.hint + "` is not a struct"
            if (step.idx < 0 || step.idx >= fs.length) return "ElemAt step " + i + ": `" + s.hint + "` has no field " + step.idx
            targetGrants = fs[step.idx].grants.replace
            ty = fs[step.idx].ty
            i = i + 1
        }
        if (targetGrants) return ""
        return "the target element field grants no write (its own contract, dpa-052 Q3)"
    }

    fn seqElemOf(t: Type) -> Type | not {
        return match t {
            .Seq(elem: e) :> e
            .Named(sym: s) :> not
            .Maybe(inner: i) :> not
            .Int :> not
            .Num :> not
            .Str :> not
            .Bool :> not
        }
    }

    fn granted(ok: boolean, why: string) -> string {
        if (ok) return ""
        return why
    }

    fn transitionGranted(f: Field) -> string {
        if (f.graph is some) return ""
        return "a transition needs a `rule=` graph; this field has none"
    }

    fn hasEdit(f: Field, k: EditKind) -> boolean {
        for (const e of f.grants.edits) {
            if (e == k) return true
        }
        return false
    }

    fn namedSym(t: Type) -> Sym | not {
        return match t {
            .Named(sym: s) :> s
            .Seq(elem: e) :> not
            .Maybe(inner: i) :> not
            .Int :> not
            .Num :> not
            .Str :> not
            .Bool :> not
        }
    }

    fn structFields(t: TypeDef) -> FieldDef[] | not {
        return match t {
            .StructDef(sym: s, fields: fs) :> fs
            .EnumDef(sym: s) :> not
        }
    }

    // A FieldAt path walks STRUCT fields of the field's value. Each step must
    // name the struct type of the value it steps into. (A step into a sequence
    // position is not representable by FieldRef in M1 Core — a position write is
    // `.PositionWrite` on the field; `@rows[i].qty = v` needs a dynamic-index
    // Core form, recorded for M2.)
    fn fieldAtProblem(p: CoreProgram, f: Field, path: FieldRef[]) -> string {
        if (path.length == 0) return "an empty FieldAt path (a whole-field write is `.Replace`)"
        let ty: Type = f.ty
        let contractInside = false
        let targetGrants = false
        let i = 0
        for (const step of path) {
            const s: Sym | not = namedSym(ty)
            if (s is not) return "FieldAt step " + i + " steps into a value that is not a struct"
            if (s.id != step.owner.id) return "FieldAt step " + i + " names owner `" + step.owner.hint + "` but the value there is a `" + s.hint + "`"
            const td: TypeDef | not = findTypeDef(p, s)
            if (td is not) return "FieldAt step " + i + ": `" + s.hint + "` is not a declared type"
            const fs: FieldDef[] | not = structFields(td)
            if (fs is not) return "FieldAt step " + i + ": `" + s.hint + "` is not a struct"
            if (step.idx < 0 || step.idx >= fs.length) return "FieldAt step " + i + ": `" + s.hint + "` has no field " + step.idx
            const fd: FieldDef = fs[step.idx]
            if (fd.grants.edits.length > 0) contractInside = true
            targetGrants = fd.grants.replace
            ty = fd.ty
            i = i + 1
        }
        if (targetGrants) return ""
        if (f.grants.replace && !contractInside) return ""
        if (f.grants.replace) return "the path reaches a field with its own non-replace contract; an outer `replace` may not bypass it"
        return "the target struct field grants no write, and the field does not grant `replace`"
    }

    // -------------------------------------------------------------------------
    // C4 / C5 — which declaration does an instance reference name?
    // -------------------------------------------------------------------------
    fn resolveInst(p: CoreProgram, encl: Decl[], i: InstRef) -> Decl | not {
        return match i {
            .Shared(decl: d) :> findDecl(p, d)
            .Lexical(depth: k) :> lexicalDecl(encl, k)
            .Alias(sym: h) :> aliasDecl(p, h)
            .Narrowed(sym: c) :> narrowedDecl(p, encl, c)
        }
    }

    fn lexicalDecl(encl: Decl[], k: int) -> Decl | not {
        if (k >= 0 && k < encl.length) return encl[k]
        return not
    }

    // The declaration of the use that binds `as=` handle h.
    fn aliasDecl(p: CoreProgram, h: Sym) -> Decl | not {
        for (const n of allNodes(Node.NProgram(p))) {
            const d: Sym | not = aliasOf(n, h)
            if (d is some) return findDecl(p, d)
        }
        return not
    }

    fn aliasOf(n: Node, h: Sym) -> Sym | not {
        return match n {
            .NView(v: v) :> viewAlias(v, h)
            .NProgram(p: q) :> not
            .NDecl(d: d) :> not
            .NField(f: f) :> not
            .NFn(f: f) :> not
            .NServerFn(f: f) :> not
            .NBlock(b: b) :> not
            .NStmt(s: s) :> not
            .NExpr(e: e) :> not
            .NPlace(pl: pl) :> not
            .NInst(i: i) :> not
            .NPattern(pat: pat) :> not
            .NEdit(k: k) :> not
            .NAttr(a: a) :> not
        }
    }

    fn viewAlias(v: View, h: Sym) -> Sym | not {
        return match v {
            .Instance(decl: d, alias: a) :> sameAlias(a, h, d)
            .El(tag: t) :> not
            .Text(text: t) :> not
            .Dyn(e: e) :> not
            .Cond(arms: a) :> not
            .Each(src: s) :> not
            .Slot :> not
            .Star(decl: d) :> not
            .When(deps: ds) :> not
        }
    }

    fn sameAlias(a: Sym | not, h: Sym, d: Sym) -> Sym | not {
        if (a is not) return not
        if (a.id == h.id) return d
        return not
    }

    // `.Narrowed(c)`: c must be bound by a Let whose initializer is an instance
    // Handle; it names whatever that handle names.
    fn narrowedDecl(p: CoreProgram, encl: Decl[], c: Sym) -> Decl | not {
        for (const n of allNodes(Node.NProgram(p))) {
            const i: InstRef | not = letHandle(n, c)
            if (i is some) return resolveInst(p, encl, i)
        }
        return not
    }

    fn letHandle(n: Node, c: Sym) -> InstRef | not {
        return match n {
            .NStmt(s: s) :> stmtLetHandle(s, c)
            .NProgram(p: q) :> not
            .NDecl(d: d) :> not
            .NField(f: f) :> not
            .NFn(f: f) :> not
            .NServerFn(f: f) :> not
            .NBlock(b: b) :> not
            .NExpr(e: e) :> not
            .NPlace(pl: pl) :> not
            .NInst(i: i) :> not
            .NPattern(pat: pat) :> not
            .NEdit(k: k) :> not
            .NView(v: v) :> not
            .NAttr(a: a) :> not
        }
    }

    fn stmtLetHandle(s: Stmt, c: Sym) -> InstRef | not {
        return match s {
            .Let(sym: sym, init: init) :> letInitHandle(sym, init, c)
            .Assign(local: l) :> not
            .Write(cap: x) :> not
            .Commit(writes: x) :> not
            .If(cond: x) :> not
            .Return(e: x) :> not
            .Eval(e: x) :> not
            .Suspend(bind: x) :> not
        }
    }

    fn letInitHandle(sym: Sym, init: Expr, c: Sym) -> InstRef | not {
        if (sym.id != c.id) return not
        return exprHandle(init)
    }

    fn exprHandle(e: Expr) -> InstRef | not {
        return match e {
            .Handle(inst: i) :> i
            .InitOf(decl: x) :> not
            .Lit(lit: x) :> not
            .Local(sym: x) :> not
            .Read(place: x) :> not
            .Call(callee: x) :> not
            .Prim(op: x) :> not
            .Match(scrut: x) :> not
            .ArrayOf(elems: x) :> not
            .StructOf(ty: x) :> not
            .Host(call: x) :> not
            .Lambda(params: x) :> not
            .SeqCall(op: x) :> not
        }
    }

    // C5 for `InitOf`: the instance is one of `decl`, and `idx` is its field.
    fn checkExpr(p: CoreProgram, encl: Decl[], e: Expr) -> string[] {
        return match e {
            .InitOf(decl: d, inst: i, idx: x) :> checkCellRead(p, encl, d, i, [{ owner: d, idx: x }])
            .Lit(lit: l) :> []
            .Local(sym: s) :> []
            .Read(place: pl) :> []
            .Call(callee: c) :> []
            .Prim(op: o) :> []
            .Match(scrut: s) :> []
            .ArrayOf(elems: es) :> []
            .StructOf(ty: t) :> []
            .Handle(inst: i) :> []
            .Host(call: c) :> []
            .Lambda(params: ps) :> []
            .SeqCall(op: o) :> []
        }
    }

    fn checkPlace(p: CoreProgram, encl: Decl[], pl: Place) -> string[] {
        return match pl {
            .Cell(decl: d, inst: i, path: path) :> checkCellRead(p, encl, d, i, path)
            .LocalPath(sym: s) :> []
        }
    }

    fn checkCellRead(p: CoreProgram, encl: Decl[], dsym: Sym, i: InstRef, path: FieldRef[]) -> string[] {
        const d: Decl | not = findDecl(p, dsym)
        if (d is not) return ["C5: a read names declaration `" + dsym.hint + "`, which does not exist"]
        const target: Decl | not = resolveInst(p, encl, i)
        if (target is not) return ["C5: a read of <" + d.sym.hint + "> goes through " + instText(i) + ", which does not resolve"]
        if (target.sym.id != d.sym.id) return ["C5: a read of <" + d.sym.hint + "> goes through " + instText(i) + ", an instance of <" + target.sym.hint + ">"]
        if (path.length > 0) {
            if (path[0].owner.id != d.sym.id || path[0].idx < 0 || path[0].idx >= d.fields.length) {
                return ["C5: a read of <" + d.sym.hint + "> names field " + path[0].idx + " of `" + path[0].owner.hint + "`"]
            }
        }
        return []
    }

    // -------------------------------------------------------------------------
    // C6 — is the write's `check` sound?  "" = sound, else the reason.
    // -------------------------------------------------------------------------
    fn isTransition(k: EditKind) -> boolean {
        return match k {
            .Transition :> true
            .FieldAt(path: x) :> false
            .Replace :> false
            .Append :> false
            .Prepend :> false
            .Anywhere :> false
            .PositionWrite :> false
            .RemoveEnd :> false
            .RemoveFront :> false
            .RemoveAnywhere :> false
            .ElemAt(index: x) :> false
        }
    }

    fn isStatic(c: Check) -> boolean {
        return match c {
            .Static :> true
            .RuntimeEdge :> false
        }
    }

    // The literal behind a `Lit` expression, else not.
    fn exprLiteral(e: Expr) -> Literal | not {
        return match e {
            .Lit(lit: l) :> l
            .Handle(inst: x) :> not
            .InitOf(decl: x) :> not
            .Local(sym: x) :> not
            .Read(place: x) :> not
            .Call(callee: x) :> not
            .Prim(op: x) :> not
            .Match(scrut: x) :> not
            .ArrayOf(elems: x) :> not
            .StructOf(ty: x) :> not
            .Host(call: x) :> not
            .Lambda(params: x) :> not
            .SeqCall(op: x) :> not
        }
    }

    // -1 = not a variant of `es`; else the variant index.
    fn variantIdx(l: Literal, es: Sym) -> int {
        return match l {
            .Variant(enumSym: s, idx: idx) :> variantIdxOf(s, idx, es)
            .Int(v: x) :> -1
            .Num(v: x) :> -1
            .Str(v: x) :> -1
            .Bool(v: x) :> -1
            .Absent :> -1
        }
    }

    fn variantIdxOf(s: Sym, idx: int, es: Sym) -> int {
        if (s.id == es.id) return idx
        return -1
    }

    fn enumSize(p: CoreProgram, es: Sym) -> int {
        const t: TypeDef | not = findTypeDef(p, es)
        if (t is not) return 0
        return enumVariantCount(t)
    }

    fn enumVariantCount(t: TypeDef) -> int {
        return match t {
            .EnumDef(sym: s, variants: vs) :> vs.length
            .StructDef(sym: s) :> 0
        }
    }

    fn targetsOf(g: TransitionGraph, origin: int) -> int[] {
        for (const e of g.edges) {
            if (e.origin == origin) return e.targets
        }
        return []
    }

    fn hasInt(xs: int[], x: int) -> boolean {
        for (const y of xs) { if (y == x) return true }
        return false
    }

    // Every state either IS `to` (a self-write no-op) or has an edge to `to`.
    fn reachableFromEveryState(g: TransitionGraph, n: int, to: int) -> boolean {
        let v = 0
        while (v < n) {
            if (v != to && !hasInt(targetsOf(g, v), to)) return false
            v = v + 1
        }
        return true
    }

    fn checkProblem(p: CoreProgram, f: Field, edit: EditKind, value: Expr, check: Check) -> string {
        if (isTransition(edit)) {
            const g: TransitionGraph | not = f.graph
            if (g is not) return ""                              // already C3
            return graphCheckProblem(p, g, value, check)
        }
        if (isStatic(check)) return ""
        return "a RuntimeEdge check on a write that is not a transition"
    }

    // A write along graph `g`: a literal value must be one of its variants;
    // `Static` only when Core proves the edge (every state is the target or has
    // an edge to it); otherwise the edge is checked at runtime (RuntimeEdge).
    fn graphCheckProblem(p: CoreProgram, g: TransitionGraph, value: Expr, check: Check) -> string {
        const n: int = enumSize(p, g.enumSym)
        const lit: Literal | not = exprLiteral(value)
        if (lit is some) {
            const to: int = variantIdx(lit, g.enumSym)
            if (to < 0 || to >= n) return "the transition value is not a variant of `" + g.enumSym.hint + "`"
            if (!isStatic(check)) return ""
            if (reachableFromEveryState(g, n, to)) return ""
            return "a Static transition to a variant not reachable from every state; the edge needs a RuntimeEdge check"
        }
        if (isStatic(check)) return "a Static transition to a non-literal value is not provable in Core; use RuntimeEdge"
        return ""
    }
}
