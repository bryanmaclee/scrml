// =============================================================================
// self-host-v2 / check.scrml — Core well-formedness: the printer's precondition
// and M2's gate on `lower`'s output.
//
// "Grants are symbols": a field has a write capability Sym (Field.wcap) iff its
// contract grants some write, and every `Stmt.Write` names a capability. So a
// write to a locked or derived field is not a checked-and-rejected Core node —
// there is no capability Sym for it to name (see core.scrml, THE BINDER'S
// OBLIGATION). What this module checks:
//   C1  wcap is some  ⟺  the field grants a write (replace, an edit, a graph)
//   C2  every Write's `cap` is some field's wcap (else: a dangling capability)
//   C3  the Write's edit is granted by that field's contract (§66.11, §66.12):
//       `replace` subsumes the sequence edits (§66.11.3); a Transition needs a
//       graph; a FieldAt(path) must be a well-typed struct path whose TARGET
//       field grants a write (per-field `let`) — or the outer field grants
//       `replace` AND no field on the path carries a non-replace contract (a
//       replace may not bypass a contract the equivalent direct edit would have
//       to follow). A genuine `.Replace` is NOT bounded by sub-field contracts
//       (O58 = (b), ruled S437 — see the Replace arm).
//   C4  the Write's instance reference resolves to the capability's OWN
//       declaration (Shared(X) → X; Lexical(k) → the k-th enclosing declaration;
//       Alias(h) → the declaration of the use that binds h; Narrowed(c) → what
//       `c` was bound to)
//   C5  every cell READ is well-formed the same way (its InstRef resolves to its
//       declaration; its first path step is a field of that declaration)
//   C6  a Write's `check` is sound: RuntimeEdge only on a Transition; a
//       transition's value, when literal, is a variant of the graph's enum; and
//       `Static` only when the Core itself proves the edge — the value is a
//       literal variant that every state may move to (or already is: a self-write
//       is a no-op, §51.0.F.1). No flow facts exist in Core, so a from-state
//       "proven by a dominating test" is NOT provable here: lower must emit
//       RuntimeEdge for it (L8).
//   C7  a Commit (all-or-nothing spread edit, RULED S440) holds ≥ 2 Writes and
//       nothing else, each storing a Local (the snapshot its Let evaluated)
//   C8  (s444) a Bind writes exactly its event-value sink, once, to the place
//       its `read` reads (Replace or FieldAt of that field)
//   C9  (s444) a removal's value: RemoveEnd / RemoveFront carry an Int count
//       ≥ 1; RemoveAnywhere carries `SeqCall(Filter, <the field itself>, λ)`
//   C10 (s444) a Star's instance resolves to its declaration (C4's rule), and
//       that declaration has a renders
//   C11 (s449) an Effect's dependency list is non-empty, every dependency
//       resolves (C4's rule) to a MUTABLE field (one with a write capability
//       — E-LIFECYCLE-007), and its body writes NO cell: no Write / Commit in
//       the body or its continuations, and no Call of a function that writes,
//       transitively (§6.7.4 the no-write rule — E-EFFECT-WRITES-STATE)
//   C12 (s449) a Suspend stands only at the tail of an effect body (an Effect
//       body, or the `then` of another Suspend) — the CPS split point
//   C13 (s449) a ResetOn has ≥ 1 trigger, each a MUTABLE field (C11's rule);
//       its reset is exactly ONE Write, to a cell that is not one of its own
//       triggers (§6.8.4 rules 1-3; C3 / C6 judge that Write's contract)
//   C14 (s449) a validity surface (an Expr.Validity read, a View.Errors, a
//       Stmt.ResetSurface) resolves (C4's rule) to its declaration; a field
//       surface names a field of it, and a field of the PROGRAM has a surface
//       only when it carries validators (§55.5.1 rule 2); a compound surface
//       names a USER declaration (the program has no compound surface — its
//       fields are top-level values, §55.5.1); `errors` is read only by an
//       Errors view (§55.8)
//   C15 (s449) a Gate stands only on a `form` element, at most once (§55.17.3)
//   C16 (s451) a Defer stands only in a function body (not in a declaration's
//       initializers / renders / handlers / effects — §19.16.3 rule 4), and
//       its body holds no Return, no Defer and no Suspend at any depth
//       (§19.16.3 rules 1-2; a Suspend would split the block's exit)
//   C17 (s451) a `persist=` field is a writable field of the program whose type
//       has a wire descriptor (no FIXED-length sequence); `Local` needs a
//       `replace` grant and no `rule=` graph (O-061-5); an Unpersist names a
//       persisted field and follows its reset Write (§6.14.2 rule 9)
//   (C3 covers the s444 edits: the removals by the field's grants; ElemAt by
//   the ELEMENT field's own contract, dpa-052 Q3.)
// A diagnostic is a message string (§4 permits strings as text).
// =============================================================================
${
    import { Sym, Type, TypeDef, FieldDef, VariantDef, FieldRef, InstRef, Place, Literal, Expr, SeqFn, Attr, Block,
             EditKind, Check, Stmt, View, EffectDep, Field, Decl, Fn, CoreProgram, CapOwner, TransitionGraph,
             DeclKind, SurfaceProp, ValidityOf, Persist, PersistStore, ServerFn, SqlQuery, Db,
             capOwner, grantsAnyWrite, findDecl, findTypeDef, findFn, findServerFn, findDb } from "./core.scrml"
    import { Node, allNodes } from "./walk.scrml"
    import { WireBuild, WireTable, wireBuild, hasFixedLength } from "./codec.scrml"

    // s451: the SQL sigil for messages, in two pieces (impl#1 rewrites a
    // literal sigil inside a string — parse.scrml sqlSigil).
    fn sqlSigil() -> string { return "?" + "{" }

    export fn checkCore(p: CoreProgram) -> string[] {
        let out: string[] = []
        for (const d of p.decls) {
            for (const f of d.fields) { out = out.concat(checkField(d, f)).concat(checkPersist(p, d, f)) }
        }
        // Context = the lexically enclosing declarations (index 0 = nearest). In
        // Core, declarations do not nest (a child declaration is a Field), so a
        // node inside declaration d's initializers/renders has context [d], and a
        // function body has none.
        for (const d of p.decls) {
            for (const n of allNodes(Node.NDecl(d))) { out = out.concat(checkNode(p, [d], n)) }
        }
        for (const f of p.fns) {
            for (const n of allNodes(Node.NFn(f))) { out = out.concat(checkNode(p, [], n)) }
        }
        for (const s of p.server) {
            for (const n of allNodes(Node.NServerFn(s))) { out = out.concat(checkNode(p, [], n)) }
        }
        return out.concat(checkSuspends(p)).concat(checkServer(p))
    }

    // =========================================================================
    // s451 (U1a) — THE SERVER BOUNDARY IN CORE. Placement lives in the shape of
    // Core (a ServerFn vs a Fn); these are the shape's invariants:
    //   C-SQL1 a query's text and values line up: `chunks.length ==
    //          slots.length + 1`, every slot indexes `params`, every param is
    //          bound by a slot, and `db` names one of the program's Dbs
    //          (checkSqlQuery — §8.1/§8.2: a value is only ever a bound slot)
    //   C-S1   a ServerFn touches no client state: no cell read (Place.Cell),
    //          no Write / Commit, no instance Handle / InitOf, no validity
    //          surface, no Suspend — directly, or through a Fn it calls
    //          (transitively). Cells are client-held (§6.6.9); a server body
    //          awaits in place. (§12.4 R2's E-ROUTE-002, restated over Core.)
    //   C-S2   an Expr.Sql stands only in a ServerFn body — never in a Fn (a
    //          pure `fn` included) or a declaration's initializers / views
    //   C-S3   client code (a Fn, a declaration) never calls a ServerFn as a
    //          plain Call — a client→server call is a suspension (unit U1b)
    //   C-S4   every ServerFn's parameter and declared return types have a
    //          §57 wire descriptor (codec.scrml — E-ROUTE-003 / E-ROUTE-004 are
    //          analyze's reports; this is their Core restatement)
    // =========================================================================
    fn checkSqlQuery(p: CoreProgram, q: SqlQuery) -> string[] {
        let out: string[] = []
        if (q.chunks.length != q.slots.length + 1) {
            out = out.concat(["C-SQL1: a query has " + q.chunks.length + " SQL text runs for " + q.slots.length + " bound values (a template has one more run than values)"])
        }
        let used: int[] = []
        for (const s of q.slots) {
            if (s < 0 || s >= q.params.length) {
                out = out.concat(["C-SQL1: a query slot names parameter #" + s + " of " + q.params.length])
            } else {
                used = used.concat([s])
            }
        }
        let i: int = 0
        while (i < q.params.length) {
            if (used.indexOf(i) < 0) out = out.concat(["C-SQL1: a query's parameter #" + i + " is bound by no slot"])
            i = i + 1
        }
        if (findDb(p, q.db) is not) out = out.concat(["C-SQL1: a query runs on `" + q.db.hint + "`, which is not one of the program's databases"])
        return out
    }

    fn checkServer(p: CoreProgram) -> string[] {
        let out: string[] = []
        const touching: int[] = clientTouchingFns(p)
        for (const s of p.server) {
            for (const n of allNodes(Node.NServerFn(s))) {
                const what: string = clientStateIn(n)
                if (what != "") out = out.concat(["C-S1: server function " + s.sym.hint + "() " + what])
                const callee: Sym | not = nodeCallee(n)
                if (callee is some && touching.indexOf(callee.id) >= 0) {
                    out = out.concat(["C-S1: server function " + s.sym.hint + "() calls " + callee.hint + "(), which touches client state"])
                }
            }
            for (const prm of s.params) {
                if (wireBuild(p, prm.ty).table is not) out = out.concat(["C-S4: server function " + s.sym.hint + "()'s parameter " + prm.sym.hint + " has no wire descriptor"])
            }
            const rt: Type | not = s.ret
            if (rt is some) {
                if (wireBuild(p, rt).table is not) out = out.concat(["C-S4: server function " + s.sym.hint + "()'s return type has no wire descriptor"])
            }
        }
        for (const d of p.decls) {
            out = out.concat(clientSide(p, Node.NDecl(d), "<" + d.sym.hint + ">"))
        }
        for (const f of p.fns) {
            out = out.concat(clientSide(p, Node.NFn(f), f.sym.hint + "()"))
        }
        return out
    }

    // C-S2 / C-S3 over one client-side root.
    fn clientSide(p: CoreProgram, root: Node, where: string) -> string[] {
        let out: string[] = []
        for (const n of allNodes(root)) {
            if (nodeIsSql(n)) out = out.concat(["C-S2: a `" + sqlSigil() + "}` query in client code (" + where + ") — a query stands only in a server function"])
            const callee: Sym | not = nodeCallee(n)
            if (callee is some) {
                if (findServerFn(p, callee) is some) out = out.concat(["C-S3: client code (" + where + ") calls the server function " + callee.hint + "() as a plain call"])
            }
        }
        return out
    }

    // The Fns that touch client state, directly or through a Fn they call (a
    // fixed point; recursion closes because the set only grows).
    fn clientTouchingFns(p: CoreProgram) -> int[] {
        let out: int[] = []
        for (const f of p.fns) {
            let direct = false
            for (const n of allNodes(Node.NFn(f))) {
                if (clientStateIn(n) != "") direct = true
            }
            if (direct) out = out.concat([f.sym.id])
        }
        let changed = true
        while (changed) {
            changed = false
            for (const f of p.fns) {
                if (out.indexOf(f.sym.id) < 0) {
                    let reaches = false
                    for (const n of allNodes(Node.NFn(f))) {
                        const c: Sym | not = nodeCallee(n)
                        if (c is some && out.indexOf(c.id) >= 0) reaches = true
                    }
                    if (reaches) {
                        out = out.concat([f.sym.id])
                        changed = true
                    }
                }
            }
        }
        return out
    }

    // What client state node `n` touches ("" — none).
    fn clientStateIn(n: Node) -> string {
        return match n {
            .NPlace(pl: pl) :> placeIsCell(pl)
            .NStmt(s: s) :> stmtTouchesClient(s)
            .NExpr(e: e) :> exprTouchesClient(e)
            .NProgram(p: x) :> ""
            .NDecl(d: x) :> ""
            .NField(f: x) :> ""
            .NFn(f: x) :> ""
            .NServerFn(f: x) :> ""
            .NBlock(b: x) :> ""
            .NInst(i: x) :> ""
            .NPattern(pat: x) :> ""
            .NEdit(k: x) :> ""
            .NView(v: x) :> "holds a view"
            .NAttr(a: x) :> "holds a markup attribute"
        }
    }

    fn placeIsCell(pl: Place) -> string {
        return match pl {
            .Cell(decl: d) :> "reads a cell of <" + d.hint + ">"
            .LocalPath(sym: x) :> ""
        }
    }

    fn stmtTouchesClient(s: Stmt) -> string {
        return match s {
            .Write(cap: c) :> "writes a cell (capability " + c.hint + ")"
            .Commit(writes: x) :> "commits cell writes"
            .Suspend(bind: x) :> "suspends (a server body awaits in place)"
            .ResetSurface(of: x) :> "resets a validity surface"
            .Unpersist(decl: x) :> "removes a persisted cell's storage"
            .Let(sym: x) :> ""
            .Assign(local: x) :> ""
            .If(cond: x) :> ""
            .Return(e: x) :> ""
            .Eval(e: x) :> ""
            .Defer(body: x) :> ""
        }
    }

    fn exprTouchesClient(e: Expr) -> string {
        return match e {
            .Handle(inst: x) :> "names an instance"
            .InitOf(decl: d) :> "re-evaluates an initializer of <" + d.hint + ">"
            .Validity(of: x) :> "reads a validity surface"
            .Lit(lit: x) :> ""
            .Local(sym: x) :> ""
            .Read(place: x) :> ""
            .Call(callee: x) :> ""
            .Prim(op: x) :> ""
            .Match(scrut: x) :> ""
            .ArrayOf(elems: x) :> ""
            .StructOf(ty: x) :> ""
            .Host(call: x) :> ""
            .Lambda(params: x) :> ""
            .SeqCall(op: x) :> ""
            .Sql(q: x) :> ""
        }
    }

    fn nodeIsSql(n: Node) -> boolean {
        return match n {
            .NExpr(e: e) :> exprIsSql(e)
            .NProgram(p: x) :> false
            .NDecl(d: x) :> false
            .NField(f: x) :> false
            .NFn(f: x) :> false
            .NServerFn(f: x) :> false
            .NBlock(b: x) :> false
            .NStmt(s: x) :> false
            .NPlace(pl: x) :> false
            .NInst(i: x) :> false
            .NPattern(pat: x) :> false
            .NEdit(k: x) :> false
            .NView(v: x) :> false
            .NAttr(a: x) :> false
        }
    }

    fn exprIsSql(e: Expr) -> boolean {
        return match e {
            .Sql(q: x) :> true
            .Lit(lit: x) :> false
            .Local(sym: x) :> false
            .Read(place: x) :> false
            .Call(callee: x) :> false
            .Prim(op: x) :> false
            .Match(scrut: x) :> false
            .ArrayOf(elems: x) :> false
            .StructOf(ty: x) :> false
            .Handle(inst: x) :> false
            .InitOf(decl: x) :> false
            .Host(call: x) :> false
            .Lambda(params: x) :> false
            .SeqCall(op: x) :> false
            .Validity(of: x) :> false
        }
    }

    fn nodeCallee(n: Node) -> Sym | not {
        return match n {
            .NExpr(e: e) :> exprCallee(e)
            .NProgram(p: x) :> not
            .NDecl(d: x) :> not
            .NField(f: x) :> not
            .NFn(f: x) :> not
            .NServerFn(f: x) :> not
            .NBlock(b: x) :> not
            .NStmt(s: x) :> not
            .NPlace(pl: x) :> not
            .NInst(i: x) :> not
            .NPattern(pat: x) :> not
            .NEdit(k: x) :> not
            .NView(v: x) :> not
            .NAttr(a: x) :> not
        }
    }

    fn exprCallee(e: Expr) -> Sym | not {
        return match e {
            .Call(callee: c) :> c
            .Lit(lit: x) :> not
            .Local(sym: x) :> not
            .Read(place: x) :> not
            .Prim(op: x) :> not
            .Match(scrut: x) :> not
            .ArrayOf(elems: x) :> not
            .StructOf(ty: x) :> not
            .Handle(inst: x) :> not
            .InitOf(decl: x) :> not
            .Host(call: x) :> not
            .Lambda(params: x) :> not
            .SeqCall(op: x) :> not
            .Validity(of: x) :> not
            .Sql(q: x) :> not
        }
    }

    fn checkField(d: Decl, f: Field) -> string[] {
        const has: boolean = f.wcap is some
        const grants: boolean = grantsAnyWrite(f) || f.graph is some
        if (has && !grants) return ["C1: <" + d.sym.hint + ">." + f.sym.hint + " has a write capability but grants no write"]
        if (!has && grants) return ["C1: <" + d.sym.hint + ">." + f.sym.hint + " grants a write but has no write capability"]
        return []
    }

    fn checkNode(p: CoreProgram, encl: Decl[], n: Node) -> string[] {
        return match n {
            .NStmt(s: s) :> checkStmt(p, encl, s)
            .NPlace(pl: pl) :> checkPlace(p, encl, pl)
            .NExpr(e: e) :> checkExpr(p, encl, e)
            .NProgram(p: q) :> []
            .NDecl(d: d) :> []
            .NField(f: f) :> []
            .NFn(f: f) :> []
            .NServerFn(f: f) :> []
            .NBlock(b: b) :> checkUnpersistOrder(p, b)
            .NInst(i: i) :> []
            .NPattern(pat: pat) :> []
            .NEdit(k: k) :> []
            .NView(v: v) :> checkView(p, encl, v)
            .NAttr(a: a) :> checkAttr(p, encl, a)
        }
    }

    // -------------------------------------------------------------------------
    // C8 (s444) — a Bind is ONE capability-checked write of its event-value
    // sink to the place its `read` reads: `write` is exactly
    // [Write(cap, inst, Replace | FieldAt(path), Local(sink), _)], and `read` is
    // Read(Cell(<cap's declaration>, inst, [<cap's field>] ++ path)) — so the
    // value shown and the value written are the same place.
    // -------------------------------------------------------------------------
    fn checkAttr(p: CoreProgram, encl: Decl[], a: Attr) -> string[] {
        return match a {
            .Bind(kind: k, read: r, sink: sk, write: w) :> checkBind(p, r, sk, w)
            .Static(name: x) :> []
            .Bound(name: x) :> []
            .On(event: x) :> []
            .Gate(values: x, fields: fs) :> checkGateFields(p, encl, fs)
        }
    }

    // C14 for a gate's statically named fields: each a field surface that resolves.
    fn checkGateFields(p: CoreProgram, encl: Decl[], fs: ValidityOf[]) -> string[] {
        let out: string[] = []
        for (const f of fs) { out = out.concat(checkGateField(p, encl, f)) }
        return out
    }

    fn checkGateField(p: CoreProgram, encl: Decl[], f: ValidityOf) -> string[] {
        return match f {
            .OfField(decl: d, inst: i, idx: x) :> checkFieldSurface(p, encl, d, i, x)
            .OfDecl(decl: d) :> ["C15: a gate names a compound <" + d.hint + ">, not a bound field"]
        }
    }

    fn checkBind(p: CoreProgram, read: Expr, sink: Sym, write: Block) -> string[] {
        if (write.stmts.length != 1) return ["C8: a bind writes " + write.stmts.length + " statement(s); it is exactly one Write of its sink"]
        const w: Stmt = write.stmts[0]
        return match w {
            .Write(cap: cap, inst: inst, edit: edit, value: v) :> bindWrite(p, read, sink, cap, inst, edit, v)
            .Let(sym: x) :> ["C8: a bind's write is not a Write"]
            .Assign(local: x) :> ["C8: a bind's write is not a Write"]
            .Commit(writes: x) :> ["C8: a bind's write is not a Write"]
            .If(cond: x) :> ["C8: a bind's write is not a Write"]
            .Return(e: x) :> ["C8: a bind's write is not a Write"]
            .Eval(e: x) :> ["C8: a bind's write is not a Write"]
            .Suspend(bind: x) :> ["C8: a bind's write is not a Write"]
            .ResetSurface(of: x) :> ["C8: a bind's write is not a Write"]
            .Defer(body: x) :> ["C8: a bind's write is not a Write"]
            .Unpersist(decl: x) :> ["C8: a bind's write is not a Write"]
        }
    }

    fn bindWrite(p: CoreProgram, read: Expr, sink: Sym, cap: Sym, inst: InstRef, edit: EditKind, v: Expr) -> string[] {
        let out: string[] = []
        if (!isLocalOf(v, sink)) out = out.concat(["C8: a bind's Write stores something other than its sink `" + sink.hint + "`"])
        const owner: CapOwner | not = capOwner(p, cap)
        if (owner is not) return out                     // C2 reports it
        let want: FieldRef[] = [{ owner: owner.decl.sym, idx: owner.idx }]
        const extra: FieldRef[] | not = bindEditPath(edit)
        if (extra is not) return out.concat(["C8: a bind's Write is not a replace of its place (Replace or FieldAt)"])
        want = want.concat(extra)
        const got: string = readKey(read)
        const exp: string = placeKeyOf(owner.decl.sym, inst, want)
        if (got != exp) out = out.concat(["C8: a bind reads " + got + " but writes " + exp])
        return out
    }

    fn bindEditPath(k: EditKind) -> FieldRef[] | not {
        return match k {
            .Replace :> []
            .FieldAt(path: path) :> path
            .Append :> not
            .Prepend :> not
            .Anywhere :> not
            .PositionWrite :> not
            .Transition :> not
            .RemoveEnd :> not
            .RemoveFront :> not
            .RemoveAnywhere :> not
            .ElemAt(index: x) :> not
        }
    }

    fn isLocalOf(e: Expr, s: Sym) -> boolean {
        return match e {
            .Local(sym: x) :> x.id == s.id
            .Lit(lit: x) :> false
            .Read(place: x) :> false
            .Call(callee: x) :> false
            .Prim(op: x) :> false
            .Match(scrut: x) :> false
            .ArrayOf(elems: x) :> false
            .StructOf(ty: x) :> false
            .Handle(inst: x) :> false
            .InitOf(decl: x) :> false
            .Host(call: x) :> false
            .Lambda(params: x) :> false
            .SeqCall(op: x) :> false
            .Validity(of: x) :> false
            .Sql(q: x) :> false
        }
    }

    // A cell read's identity, as text of ids.
    fn readKey(e: Expr) -> string {
        return match e {
            .Read(place: pl) :> cellKey(pl)
            .Lit(lit: x) :> "(not a cell read)"
            .Local(sym: x) :> "(not a cell read)"
            .Call(callee: x) :> "(not a cell read)"
            .Prim(op: x) :> "(not a cell read)"
            .Match(scrut: x) :> "(not a cell read)"
            .ArrayOf(elems: x) :> "(not a cell read)"
            .StructOf(ty: x) :> "(not a cell read)"
            .Handle(inst: x) :> "(not a cell read)"
            .InitOf(decl: x) :> "(not a cell read)"
            .Host(call: x) :> "(not a cell read)"
            .Lambda(params: x) :> "(not a cell read)"
            .SeqCall(op: x) :> "(not a cell read)"
            .Validity(of: x) :> "(not a cell read)"
            .Sql(q: x) :> "(not a cell read)"
        }
    }

    fn cellKey(pl: Place) -> string {
        return match pl {
            .Cell(decl: d, inst: i, path: path) :> placeKeyOf(d, i, path)
            .LocalPath(sym: s) :> "(a local path)"
        }
    }

    fn placeKeyOf(d: Sym, i: InstRef, path: FieldRef[]) -> string {
        let k: string = "<" + d.hint + "#" + d.id + ">@" + instIdKey(i)
        for (const r of path) { k = k + "." + r.owner.id + ":" + r.idx }
        return k
    }

    fn instIdKey(i: InstRef) -> string {
        return match i {
            .Shared(decl: d) :> "S" + d.id
            .Lexical(depth: k) :> "L" + k
            .Alias(sym: s) :> "A" + s.id
            .Narrowed(sym: s) :> "N" + s.id
        }
    }

    // -------------------------------------------------------------------------
    // C10 (s444) — a Star renders an EXISTING instance with its declaration's
    // renders: the instance resolves to that declaration (C4's rule), and the
    // declaration has a renders.
    // -------------------------------------------------------------------------
    fn checkView(p: CoreProgram, encl: Decl[], v: View) -> string[] {
        return match v {
            .Star(decl: d, inst: i) :> checkStar(p, encl, d, i)
            .Effect(deps: ds, body: b) :> checkEffect(p, encl, ds, b)
            .ResetOn(triggers: ds, reset: b) :> checkResetOn(p, encl, ds, b)
            .Errors(of: x) :> checkSurface(p, encl, x)
            .El(tag: t, attrs: attrs) :> checkGates(t, attrs)
            .Text(text: x) :> []
            .Dyn(e: x) :> []
            .Cond(arms: x) :> []
            .Each(src: x) :> []
            .Instance(decl: x) :> []
            .Slot :> []
        }
    }

    // -------------------------------------------------------------------------
    // C14 (s449) — a validity surface resolves to its declaration (C4's rule):
    // a field surface names one of its fields — of the program, only a field
    // that carries validators (§55.5.1 rule 2: a top-level value with none has
    // no surface); a compound surface names a user declaration (§55.5).
    // -------------------------------------------------------------------------
    fn checkSurface(p: CoreProgram, encl: Decl[], v: ValidityOf) -> string[] {
        return match v {
            .OfField(decl: d, inst: i, idx: x) :> checkFieldSurface(p, encl, d, i, x)
            .OfDecl(decl: d, inst: i) :> checkDeclSurface(p, encl, d, i)
        }
    }

    fn checkFieldSurface(p: CoreProgram, encl: Decl[], dsym: Sym, i: InstRef, idx: int) -> string[] {
        const read: string[] = checkCellRead(p, encl, dsym, i, [{ owner: dsym, idx: idx }])
        if (read.length > 0) return ["C14: a validity surface — " + read[0]]
        const d: Decl | not = findDecl(p, dsym)
        if (d is not) return []
        if (isProgramKind(d.kind) && d.fields[idx].vals.length == 0) {
            return ["C14: the top-level value `" + d.fields[idx].sym.hint + "` carries no validators — it has no validity surface (§55.5.1 rule 2)"]
        }
        return []
    }

    fn checkDeclSurface(p: CoreProgram, encl: Decl[], dsym: Sym, i: InstRef) -> string[] {
        const d: Decl | not = findDecl(p, dsym)
        if (d is not) return ["C14: a compound surface names declaration `" + dsym.hint + "`, which does not exist"]
        if (!isUserKind(d.kind)) return ["C14: <" + d.sym.hint + "> is not a user declaration — only a user declaration has a compound surface (§55.5)"]
        const target: Decl | not = resolveInst(p, encl, i)
        if (target is not) return ["C14: a compound surface of <" + d.sym.hint + "> goes through " + instText(i) + ", which does not resolve"]
        if (target.sym.id != d.sym.id) return ["C14: a compound surface of <" + d.sym.hint + "> goes through " + instText(i) + ", an instance of <" + target.sym.hint + ">"]
        return []
    }

    fn isProgramKind(k: DeclKind) -> boolean {
        return match k {
            .Program :> true
            .User :> false
            .Predefined :> false
        }
    }

    fn isUserKind(k: DeclKind) -> boolean {
        return match k {
            .User :> true
            .Program :> false
            .Predefined :> false
        }
    }

    // A read of a surface property: C14's resolution, and `errors` only through
    // an Errors view (§55.8) — a value read of the ValidationError array has no
    // type in the bootstrap's Core.
    fn checkSurfaceRead(p: CoreProgram, encl: Decl[], v: ValidityOf, pr: SurfaceProp) -> string[] {
        const isErrors: boolean = pr == SurfaceProp.Errors
        if (isErrors) return ["C14: `errors` is read as a value — the bootstrap reads it only through `<errors of=…/>` (§55.8)"]
        return checkSurface(p, encl, v)
    }

    // C15 (s449) — a Gate stands only on a `form`, at most once (§55.17.3).
    fn checkGates(tag: string, attrs: Attr[]) -> string[] {
        let n = 0
        for (const a of attrs) {
            if (attrIsGate(a)) n = n + 1
        }
        if (n > 0 && tag != "form") return ["C15: a submit gate on `<" + tag + ">` — only a `<form>` is gated (§55.17.5)"]
        if (n > 1) return ["C15: a `<form>` carries " + n + " submit gates; it has one"]
        return []
    }

    fn attrIsGate(a: Attr) -> boolean {
        return match a {
            .Gate(values: vs) :> true
            .Static(name: x) :> false
            .Bound(name: x) :> false
            .On(event: x) :> false
            .Bind(kind: x) :> false
        }
    }

    // -------------------------------------------------------------------------
    // C11 (s449) — an Effect (§6.7.4): its dependency list is non-empty; every
    // dependency resolves (C4's rule) to a field of its declaration that has a
    // write capability — a locked or derived field has no change event
    // (E-LIFECYCLE-007); and its body writes no reactive cell, directly or
    // through a called function (the no-write rule, E-EFFECT-WRITES-STATE): no
    // Write or Commit anywhere in the body (continuations included — they are
    // nested Blocks), and no Call of a function whose body writes, closed over
    // its own calls. The front end decides this first, from source (the write
    // summary in analyze.scrml); C11 states it again over Core, where a
    // function value cannot exist outside a SeqCall's Lambda (whose body the
    // walk below already enters).
    // -------------------------------------------------------------------------
    fn checkEffect(p: CoreProgram, encl: Decl[], deps: EffectDep[], body: Block) -> string[] {
        let out: string[] = []
        if (deps.length == 0) out = out.concat(["C11: an Effect has an empty dependency list (§6.7.4: at least one entry)"])
        for (const dep of deps) { out = out.concat(checkEffectDep(p, encl, dep)) }
        const w: string = blockWriteWitness(p, body, [])
        if (w != "") out = out.concat(["C11: an Effect body writes reactive state — " + w + " (§6.7.4: an effect may not write any reactive cell, directly or through a called function)"])
        return out
    }

    // -------------------------------------------------------------------------
    // C13 (s449) — a ResetOn (§6.8.4): at least one trigger (rule 2, "an empty
    // list … is the same error"); every trigger a mutable cell (C11's rule —
    // rule 2's E-LIFECYCLE-007 condition); the reset is exactly ONE Write
    // (rule 1: "performs exactly one write — reset(@self)"), and its cell is
    // not among its own triggers (rule 3: "a cell listing itself" is a cycle).
    // The Write's contract — replace granted, or a Static transition every
    // state admits (rules 5-6) — is C3 / C6's, as for any Write.
    // -------------------------------------------------------------------------
    fn checkResetOn(p: CoreProgram, encl: Decl[], triggers: EffectDep[], reset: Block) -> string[] {
        let out: string[] = []
        if (triggers.length == 0) out = out.concat(["C13: a ResetOn has no trigger (§6.8.4 rule 2)"])
        for (const t of triggers) {
            for (const m of checkEffectDep(p, encl, t)) { out = out.concat([m.replace("C11: an Effect dependency", "C13: a ResetOn trigger")]) }
        }
        // s449: a validated cell's reset also clears its surface (§55.13 — a
        // `reset-on=` reset IS `reset(@x)`): the Write may be followed by ONE
        // ResetSurface of that same field.
        // s451: a persisted cell's reset then removes its storage key
        // (§6.14.2 rule 9) — ONE Unpersist, last.
        const n: int = reset.stmts.length
        if (n < 1 || n > 3) return out.concat(["C13: a ResetOn's reset is " + n + " statements — it is exactly one Write (§6.8.4 rule 1), its surface's reset (§55.13) and its storage key's removal (§6.14.2 rule 9)"])
        let k = 1
        if (k < n && isResetSurface(reset.stmts[k])) k = k + 1
        if (k < n && isUnpersist(reset.stmts[k])) k = k + 1
        if (k != n) return out.concat(["C13: a ResetOn's reset is " + n + " statements — one Write, then something other than its surface's reset and its storage key's removal (§6.8.4 rule 1, §55.13, §6.14.2 rule 9)"])
        const cap: Sym | not = writeCapOf(reset.stmts[0])
        if (cap is not) return out.concat(["C13: a ResetOn's reset is not a Write (§6.8.4 rule 1)"])
        const o: CapOwner | not = capOwner(p, cap)
        if (o is not) return out
        for (const t of triggers) {
            if (t.decl.id == o.decl.sym.id && t.idx == o.idx) out = out.concat(["C13: a ResetOn on <" + o.decl.sym.hint + ">." + o.decl.fields[o.idx].sym.hint + " lists its own cell as a trigger (§6.8.4 rule 3, a cycle)"])
        }
        return out
    }

    fn isResetSurface(s: Stmt) -> boolean {
        return match s {
            .ResetSurface(of: v) :> true
            .Unpersist(decl: x) :> false
            .Write(cap: x) :> false
            .Let(sym: x) :> false
            .Assign(local: x) :> false
            .Commit(writes: x) :> false
            .If(cond: x) :> false
            .Return(e: x) :> false
            .Eval(e: x) :> false
            .Suspend(bind: x) :> false
            .Defer(body: x) :> false
        }
    }

    fn isUnpersist(s: Stmt) -> boolean {
        return match s {
            .Unpersist(decl: x) :> true
            .ResetSurface(of: v) :> false
            .Write(cap: x) :> false
            .Let(sym: x) :> false
            .Assign(local: x) :> false
            .Commit(writes: x) :> false
            .If(cond: x) :> false
            .Return(e: x) :> false
            .Eval(e: x) :> false
            .Suspend(bind: x) :> false
            .Defer(body: x) :> false
        }
    }

    // -------------------------------------------------------------------------
    // C17 (s451) — `persist=` (§6.14). A persisted field is a field of the
    // PROGRAM (§6.14.1 rule 3 — the bootstrap persists program cells; a
    // declaration's per-instance persistence is O-061-9) with a write
    // capability (a locked or derived cell is refused: no rule decides it,
    // O-061-10), whose type has a §57 wire descriptor with no FIXED-length
    // sequence (restore is construction; no rule fixes a stored length).
    // `Local` also needs a contract that grants `replace` and no `rule=` graph:
    // a cross-tab value is applied as one whole-value write, and whether a
    // contract that refuses one judges it is O-061-5 (OPEN).
    // An Unpersist resolves (C4's rule) to a persisted field, and stands right
    // after the reset Write of that same field (and its ResetSurface).
    // -------------------------------------------------------------------------
    fn checkPersist(p: CoreProgram, d: Decl, f: Field) -> string[] {
        const ps: Persist | not = f.persist
        if (ps is not) return []
        const at: string = "C17: <" + d.sym.hint + ">." + f.sym.hint + " is persisted (key \"" + ps.key + "\")"
        if (!isProgramKind(d.kind)) return [at + " but is not a field of the program (§6.14.1 rule 3)"]
        if (f.wcap is not) return [at + " but has no write capability (a locked or derived cell)"]
        let out: string[] = []
        const local: boolean = ps.store == PersistStore.Local
        if (local && (f.graph is some || !f.grants.replace)) out = out.concat([at + " in localStorage, but its contract refuses a whole-value write — a cross-tab value is one (O-061-5)"])
        const wb: WireBuild = wireBuild(p, f.ty)
        const wt: WireTable | not = wb.table
        if (wt is not) return out.concat([at + " but its type has no wire descriptor: " + wb.why.join("; ")])
        if (hasFixedLength(wt)) out = out.concat([at + " but its type holds a FIXED-length sequence"])
        return out
    }

    fn checkUnpersist(p: CoreProgram, encl: Decl[], dsym: Sym, i: InstRef, idx: int) -> string[] {
        const read: string[] = checkCellRead(p, encl, dsym, i, [{ owner: dsym, idx: idx }])
        if (read.length > 0) return ["C17: an Unpersist — " + read[0]]
        const d: Decl | not = findDecl(p, dsym)
        if (d is not) return []
        if (d.fields[idx].persist is not) return ["C17: an Unpersist of <" + d.sym.hint + ">." + d.fields[idx].sym.hint + ", which is not persisted"]
        return []
    }

    // C17: each Unpersist in `b` follows the Write of its own field (with
    // that field's ResetSurface, if any, between them).
    fn checkUnpersistOrder(p: CoreProgram, b: Block) -> string[] {
        let out: string[] = []
        let i = 0
        for (const s of b.stmts) {
            const key: string = unpersistKey(s)
            if (key != "") {
                let j: int = i - 1
                if (j >= 0 && isResetSurface(b.stmts[j])) j = j - 1
                let prev: string = ""
                if (j >= 0) prev = writeKey(p, b.stmts[j])
                if (prev != key) out = out.concat(["C17: an Unpersist of " + key + " does not follow the reset Write of that field (§6.14.2 rule 9)"])
            }
            i = i + 1
        }
        return out
    }

    fn unpersistKey(s: Stmt) -> string {
        return match s {
            .Unpersist(decl: d, idx: x) :> d.hint + "#" + d.id + "." + x
            .ResetSurface(of: v) :> ""
            .Write(cap: x) :> ""
            .Let(sym: x) :> ""
            .Assign(local: x) :> ""
            .Commit(writes: x) :> ""
            .If(cond: x) :> ""
            .Return(e: x) :> ""
            .Eval(e: x) :> ""
            .Suspend(bind: x) :> ""
            .Defer(body: x) :> ""
        }
    }

    fn writeKey(p: CoreProgram, s: Stmt) -> string {
        const cap: Sym | not = writeCapOf(s)
        if (cap is not) return ""
        const o: CapOwner | not = capOwner(p, cap)
        if (o is not) return ""
        return o.decl.sym.hint + "#" + o.decl.sym.id + "." + o.idx
    }

    fn writeCapOf(s: Stmt) -> Sym | not {
        return match s {
            .Write(cap: c) :> c
            .Let(sym: x) :> not
            .Assign(local: x) :> not
            .Commit(writes: x) :> not
            .If(cond: x) :> not
            .Return(e: x) :> not
            .Eval(e: x) :> not
            .Suspend(bind: x) :> not
            .ResetSurface(of: x) :> not
            .Defer(body: x) :> not
            .Unpersist(decl: x) :> not
        }
    }

    fn checkEffectDep(p: CoreProgram, encl: Decl[], dep: EffectDep) -> string[] {
        const d: Decl | not = findDecl(p, dep.decl)
        if (d is not) return ["C11: an Effect dependency names declaration `" + dep.decl.hint + "`, which does not exist"]
        const target: Decl | not = resolveInst(p, encl, dep.inst)
        if (target is not) return ["C11: an Effect dependency of <" + d.sym.hint + "> goes through " + instText(dep.inst) + ", which does not resolve"]
        if (target.sym.id != d.sym.id) return ["C11: an Effect dependency of <" + d.sym.hint + "> goes through " + instText(dep.inst) + ", an instance of <" + target.sym.hint + ">"]
        if (dep.idx < 0 || dep.idx >= d.fields.length) return ["C11: an Effect dependency names field " + dep.idx + " of <" + d.sym.hint + ">, which has no such field"]
        const f: Field = d.fields[dep.idx]
        if (f.wcap is not) return ["C11: an Effect dependency <" + d.sym.hint + ">." + f.sym.hint + " is not a mutable cell (no write capability — a locked or derived field has no change event)"]
        return []
    }

    // The first write a block performs, directly or through a called function
    // (closed over calls; `seen` stops recursion), as a message ("" — none).
    fn blockWriteWitness(p: CoreProgram, b: Block, seen: int[]) -> string {
        for (const n of allNodes(Node.NBlock(b))) {
            const w: string = nodeWriteWitness(p, n, seen)
            if (w != "") return w
        }
        return ""
    }

    fn nodeWriteWitness(p: CoreProgram, n: Node, seen: int[]) -> string {
        return match n {
            .NStmt(s: s) :> stmtWriteWitness(p, s)
            .NExpr(e: e) :> callWriteWitness(p, e, seen)
            .NProgram(p: q) :> ""
            .NDecl(d: d) :> ""
            .NField(f: f) :> ""
            .NFn(f: f) :> ""
            .NServerFn(f: f) :> ""
            .NBlock(b: b) :> ""
            .NPlace(pl: pl) :> formulaWriteWitness(p, pl, seen)
            .NInst(i: i) :> constructWriteWitness(p, i, seen)
            .NPattern(pat: pat) :> ""
            .NEdit(k: k) :> ""
            .NView(v: v) :> ""
            .NAttr(a: a) :> ""
        }
    }

    // A read through `.Shared(d)` may CONSTRUCT d's shared instance (first
    // reference, §66.6.4): its field initializers run, and the instances its
    // renders uses are built with it (L12 (b); every use counted — the
    // front end's construction summary, restated over Core).
    fn constructWriteWitness(p: CoreProgram, i: InstRef, seen: int[]) -> string {
        const ds: Sym | not = sharedDeclOf(i)
        if (ds is not) return ""
        if (ds.id == p.program.id || seen.indexOf(ds.id) >= 0) return ""
        const d: Decl | not = findDecl(p, ds)
        if (d is not) return ""
        const inner: string = declConstructWitness(p, d, seen.concat([ds.id]))
        if (inner == "") return ""
        return "through the construction of <" + ds.hint + ">: " + inner
    }

    fn declConstructWitness(p: CoreProgram, d: Decl, seen: int[]) -> string {
        for (const f of d.fields) {
            for (const n of allNodes(Node.NField(f))) {
                const w: string = nodeWriteWitness(p, n, seen)
                if (w != "") return w
            }
        }
        const r: View[] | not = d.renders
        if (r is not) return ""
        for (const v of r) {
            for (const n of allNodes(Node.NView(v))) {
                const used: Sym | not = instanceDeclOf(n)
                if (used is some) {
                    const w2: string = constructWriteWitness(p, InstRef.Shared(used), seen)
                    if (w2 != "") return w2
                }
            }
        }
        return ""
    }

    // fix round (HIGH-1): a read of a field with no write capability RUNS its
    // initializer (the printer makes it a `rt.derived`, lazily pulled) — the
    // program's own derived cells included.
    fn formulaWriteWitness(p: CoreProgram, pl: Place, seen: int[]) -> string {
        const ref: FieldRef | not = cellFieldOf(pl)
        if (ref is not) return ""
        const d: Decl | not = findDecl(p, ref.owner)
        if (d is not || ref.idx < 0 || ref.idx >= d.fields.length) return ""
        const f: Field = d.fields[ref.idx]
        if (f.wcap is some) return ""
        if (seen.indexOf(f.sym.id) >= 0) return ""
        const init: Expr | not = f.init
        if (init is not) return ""
        for (const n of allNodes(Node.NExpr(init))) {
            const w: string = nodeWriteWitness(p, n, seen.concat([f.sym.id]))
            if (w != "") return "through the formula of <" + d.sym.hint + ">." + f.sym.hint + ": " + w
        }
        return ""
    }

    fn cellFieldOf(pl: Place) -> FieldRef | not {
        return match pl {
            .Cell(decl: d, inst: i, path: path) :> firstRef(d, path)
            .LocalPath(sym: s) :> not
        }
    }

    fn firstRef(d: Sym, path: FieldRef[]) -> FieldRef | not {
        if (path.length == 0) return not
        return { owner: d, idx: path[0].idx }
    }

    fn sharedDeclOf(i: InstRef) -> Sym | not {
        return match i {
            .Shared(decl: d) :> d
            .Lexical(depth: n) :> not
            .Alias(sym: s) :> not
            .Narrowed(sym: s) :> not
        }
    }

    fn instanceDeclOf(n: Node) -> Sym | not {
        return match n {
            .NView(v: v) :> viewInstanceDecl(v)
            .NProgram(p: q) :> not
            .NDecl(d: d) :> not
            .NField(f: f) :> not
            .NFn(f: f) :> not
            .NServerFn(f: f) :> not
            .NBlock(b: b) :> not
            .NStmt(s: s) :> not
            .NExpr(e: e) :> not
            .NPlace(pl: pl) :> not
            .NInst(i: i) :> not
            .NPattern(pat: pat) :> not
            .NEdit(k: k) :> not
            .NAttr(a: a) :> not
        }
    }

    fn viewInstanceDecl(v: View) -> Sym | not {
        return match v {
            .Instance(decl: d) :> d
            .El(tag: x) :> not
            .Text(text: x) :> not
            .Dyn(e: x) :> not
            .Cond(arms: x) :> not
            .Each(src: x) :> not
            .Slot :> not
            .Star(decl: x) :> not
            .Effect(deps: x) :> not
            .ResetOn(triggers: x) :> not
            .Errors(of: x) :> not
        }
    }

    fn stmtWriteWitness(p: CoreProgram, s: Stmt) -> string {
        return match s {
            .Write(cap: cap) :> "a Write of " + capText(p, cap)
            .Commit(writes: ws) :> "a Commit of " + ws.length + " write(s)"
            .Let(sym: x) :> ""
            .Assign(local: x) :> ""
            .If(cond: x) :> ""
            .Return(e: x) :> ""
            .Eval(e: x) :> ""
            .Suspend(bind: x) :> ""
            .ResetSurface(of: x) :> ""
            .Defer(body: x) :> ""
            .Unpersist(decl: x) :> ""
        }
    }

    fn capText(p: CoreProgram, cap: Sym) -> string {
        const o: CapOwner | not = capOwner(p, cap)
        if (o is not) return "capability `" + cap.hint + "`"
        return "<" + o.decl.sym.hint + ">." + o.decl.fields[o.idx].sym.hint
    }

    fn callWriteWitness(p: CoreProgram, e: Expr, seen: int[]) -> string {
        const callee: Sym | not = calledSym(e)
        if (callee is not) return ""
        if (seen.indexOf(callee.id) >= 0) return ""
        const f: Fn | not = findFn(p, callee)
        if (f is not) return ""                       // C2 reports an unknown callee
        const inner: string = blockWriteWitness(p, f.body, seen.concat([callee.id]))
        if (inner == "") return ""
        return "through `" + callee.hint + "()`: " + inner
    }

    fn calledSym(e: Expr) -> Sym | not {
        return match e {
            .Call(callee: c) :> c
            .Lit(lit: x) :> not
            .Local(sym: x) :> not
            .Read(place: x) :> not
            .Prim(op: x) :> not
            .Match(scrut: x) :> not
            .ArrayOf(elems: x) :> not
            .StructOf(ty: x) :> not
            .Handle(inst: x) :> not
            .InitOf(decl: x) :> not
            .Host(call: x) :> not
            .Lambda(params: x) :> not
            .SeqCall(op: x) :> not
            .Validity(of: x) :> not
            .Sql(q: x) :> not
        }
    }

    // -------------------------------------------------------------------------
    // C12 (s449) — a Suspend is a CPS split point: its continuation is its
    // `then`, so nothing may follow it in its block, and it stands only at the
    // TAIL of an effect body — an Effect body, or (a chain) the `then` of
    // another Suspend. In an If branch the statements after the If would run
    // before the branch's continuation; in a function, handler or bind there is
    // no owning effect task to cancel it on teardown or re-run.
    // -------------------------------------------------------------------------
    fn checkSuspends(p: CoreProgram) -> string[] {
        let total: int = 0
        let legal: int = 0
        for (const n of allNodes(Node.NProgram(p))) {
            total = total + suspendAt(n)
            legal = legal + effectTails(n)
        }
        if (total == legal) return []
        return ["C12: " + (total - legal) + " Suspend(s) stand outside the tail of an effect body (an Effect body or a Suspend's continuation, and last in that block)"]
    }

    fn suspendAt(n: Node) -> int {
        return match n {
            .NStmt(s: s) :> suspendThenCount(s)
            .NProgram(p: q) :> 0
            .NDecl(d: d) :> 0
            .NField(f: f) :> 0
            .NFn(f: f) :> 0
            .NServerFn(f: f) :> 0
            .NBlock(b: b) :> 0
            .NExpr(e: e) :> 0
            .NPlace(pl: pl) :> 0
            .NInst(i: i) :> 0
            .NPattern(pat: pat) :> 0
            .NEdit(k: k) :> 0
            .NView(v: v) :> 0
            .NAttr(a: a) :> 0
        }
    }

    fn suspendThenCount(s: Stmt) -> int {
        const t: Block | not = suspendThen(s)
        if (t is some) return 1
        return 0
    }

    fn suspendThen(s: Stmt) -> Block | not {
        return match s {
            .Suspend(then: t) :> t
            .ResetSurface(of: x) :> not
            .Unpersist(decl: x) :> not
            .Let(sym: x) :> not
            .Assign(local: x) :> not
            .Write(cap: x) :> not
            .Commit(writes: x) :> not
            .If(cond: x) :> not
            .Return(e: x) :> not
            .Eval(e: x) :> not
            .Defer(body: x) :> not
        }
    }

    fn effectTails(n: Node) -> int {
        return match n {
            .NView(v: v) :> viewEffectTails(v)
            .NProgram(p: q) :> 0
            .NDecl(d: d) :> 0
            .NField(f: f) :> 0
            .NFn(f: f) :> 0
            .NServerFn(f: f) :> 0
            .NBlock(b: b) :> 0
            .NStmt(s: s) :> 0
            .NExpr(e: e) :> 0
            .NPlace(pl: pl) :> 0
            .NInst(i: i) :> 0
            .NPattern(pat: pat) :> 0
            .NEdit(k: k) :> 0
            .NAttr(a: a) :> 0
        }
    }

    fn viewEffectTails(v: View) -> int {
        return match v {
            .Effect(body: b) :> tailChain(b)
            .ResetOn(triggers: x) :> 0
            .Errors(of: x) :> 0
            .El(tag: x) :> 0
            .Text(text: x) :> 0
            .Dyn(e: x) :> 0
            .Cond(arms: x) :> 0
            .Each(src: x) :> 0
            .Instance(decl: x) :> 0
            .Slot :> 0
            .Star(decl: x) :> 0
        }
    }

    // The legally placed Suspends of a chain: the block's LAST statement, if a
    // Suspend, and those of its continuation.
    fn tailChain(b: Block) -> int {
        if (b.stmts.length == 0) return 0
        const t: Block | not = suspendThen(b.stmts[b.stmts.length - 1])
        if (t is not) return 0
        return 1 + tailChain(t)
    }

    fn checkStar(p: CoreProgram, encl: Decl[], dsym: Sym, i: InstRef) -> string[] {
        const d: Decl | not = findDecl(p, dsym)
        if (d is not) return ["C10: a Star names declaration `" + dsym.hint + "`, which does not exist"]
        const target: Decl | not = resolveInst(p, encl, i)
        if (target is not) return ["C10: a Star of <" + d.sym.hint + "> goes through " + instText(i) + ", which does not resolve"]
        if (target.sym.id != d.sym.id) return ["C10: a Star of <" + d.sym.hint + "> goes through " + instText(i) + ", an instance of <" + target.sym.hint + ">"]
        if (d.renders is not) return ["C10: a Star of <" + d.sym.hint + ">, which has no renders"]
        return []
    }

    fn checkStmt(p: CoreProgram, encl: Decl[], s: Stmt) -> string[] {
        return match s {
            .Write(cap: cap, inst: inst, edit: edit, value: v, check: ck) :> checkWrite(p, encl, cap, inst, edit, v, ck)
            .Commit(writes: ws) :> checkCommit(ws)
            .Let(sym: sym) :> []
            .Assign(local: l) :> []
            .If(cond: c) :> []
            .Return(e: e) :> []
            .Eval(e: e) :> []
            .Suspend(bind: b) :> []
            .ResetSurface(of: v) :> checkSurface(p, encl, v)
            .Defer(body: d) :> checkDefer(encl, d)
            .Unpersist(decl: d, inst: i, idx: x) :> checkUnpersist(p, encl, d, i, x)
        }
    }

    // C16 (s451): `encl` is non-empty exactly inside a declaration (checkCore),
    // which is never a function body.
    fn checkDefer(encl: Decl[], body: Block) -> string[] {
        let out: string[] = []
        if (encl.length > 0) out = out.concat(["C16: a Defer inside <" + encl[0].sym.hint + "> — a Defer stands only in a function body (§19.16.3 rule 4)"])
        for (const n of allNodes(Node.NBlock(body))) {
            const what: string = deferForbidden(n)
            if (what != "") out = out.concat(["C16: a Defer's body holds " + what + " (§19.16.3)"])
        }
        return out
    }

    fn deferForbidden(n: Node) -> string {
        return match n {
            .NStmt(s: s) :> deferForbiddenStmt(s)
            .NProgram(p: q) :> ""
            .NDecl(d: d) :> ""
            .NField(f: f) :> ""
            .NFn(f: f) :> ""
            .NServerFn(f: f) :> ""
            .NBlock(b: b) :> ""
            .NExpr(e: e) :> ""
            .NPlace(pl: pl) :> ""
            .NInst(i: i) :> ""
            .NPattern(pat: pat) :> ""
            .NEdit(k: k) :> ""
            .NView(v: v) :> ""
            .NAttr(a: a) :> ""
        }
    }

    fn deferForbiddenStmt(s: Stmt) -> string {
        return match s {
            .Return(e: x) :> "a Return"
            .Defer(body: x) :> "a Defer"
            .Suspend(bind: x) :> "a Suspend"
            .Let(sym: x) :> ""
            .Assign(local: x) :> ""
            .Write(cap: x) :> ""
            .Commit(writes: x) :> ""
            .If(cond: x) :> ""
            .Eval(e: x) :> ""
            .ResetSurface(of: x) :> ""
            .Unpersist(decl: x) :> ""
        }
    }

    // C7: a Commit (an all-or-nothing spread edit, RULED S440) groups two or
    // more Writes and nothing else, and every Write's value is a Local — the
    // snapshot its Let evaluated — so the printer may read a value once to
    // check it and again to apply it. Its Writes themselves are checked by
    // C2–C6 as every Write is (walk visits them as ordinary statements).
    fn checkCommit(ws: Stmt[]) -> string[] {
        let out: string[] = []
        if (ws.length < 2) out = out.concat(["C7: a Commit groups " + ws.length + " write(s); one write is already all-or-nothing — it must be a plain Write"])
        for (const w of ws) {
            const problem: string = commitMember(w)
            if (problem != "") out = out.concat(["C7: " + problem])
        }
        return out
    }

    fn commitMember(s: Stmt) -> string {
        return match s {
            .Write(value: v) :> commitValue(v)
            .Commit(writes: x) :> "a Commit nested in a Commit"
            .Let(sym: x) :> "a Let inside a Commit (its Lets come before it)"
            .Assign(local: x) :> "an Assign inside a Commit"
            .If(cond: x) :> "an If inside a Commit"
            .Return(e: x) :> "a Return inside a Commit"
            .Eval(e: x) :> "an Eval inside a Commit"
            .Suspend(bind: x) :> "a Suspend inside a Commit"
            .ResetSurface(of: x) :> "a ResetSurface inside a Commit"
            .Defer(body: x) :> "a Defer inside a Commit"
            .Unpersist(decl: x) :> "an Unpersist inside a Commit"
        }
    }

    fn commitValue(v: Expr) -> string {
        return match v {
            .Local(sym: x) :> ""
            .Lit(lit: x) :> "a Commit write's value is not a Local (the snapshot)"
            .Read(place: x) :> "a Commit write's value is not a Local (the snapshot)"
            .Call(callee: x) :> "a Commit write's value is not a Local (the snapshot)"
            .Prim(op: x) :> "a Commit write's value is not a Local (the snapshot)"
            .Match(scrut: x) :> "a Commit write's value is not a Local (the snapshot)"
            .ArrayOf(elems: x) :> "a Commit write's value is not a Local (the snapshot)"
            .StructOf(ty: x) :> "a Commit write's value is not a Local (the snapshot)"
            .Handle(inst: x) :> "a Commit write's value is not a Local (the snapshot)"
            .InitOf(decl: x) :> "a Commit write's value is not a Local (the snapshot)"
            .Host(call: x) :> "a Commit write's value is not a Local (the snapshot)"
            .Lambda(params: x) :> "a Commit write's value is not a Local (the snapshot)"
            .SeqCall(op: x) :> "a Commit write's value is not a Local (the snapshot)"
            .Validity(of: x) :> "a Commit write's value is not a Local (the snapshot)"
            .Sql(q: x) :> "a Commit write's value is not a Local (the snapshot)"
        }
    }

    fn checkWrite(p: CoreProgram, encl: Decl[], cap: Sym, inst: InstRef, edit: EditKind, value: Expr, check: Check) -> string[] {
        const owner: CapOwner | not = capOwner(p, cap)
        if (owner is not) return ["C2: a write names sym " + cap.id + " (`" + cap.hint + "`), which is not a write capability"]
        const d: Decl = owner.decl
        const f: Field = d.fields[owner.idx]
        const where: string = "<" + d.sym.hint + ">." + f.sym.hint
        let out: string[] = []
        const target: Decl | not = resolveInst(p, encl, inst)
        if (target is not) {
            out = out.concat(["C4: the write to " + where + " goes through an instance reference that does not resolve (" + instText(inst) + ")"])
        } else {
            if (target.sym.id != d.sym.id) {
                out = out.concat(["C4: the write to " + where + " goes through " + instText(inst) + ", an instance of <" + target.sym.hint + ">"])
            }
        }
        const problem: string = editProblem(p, f, edit)
        if (problem != "") out = out.concat(["C3: " + where + ": " + problem])
        const cp: string = checkProblem(p, f, edit, value, check)
        if (cp != "") out = out.concat(["C6: " + where + ": " + cp])
        const rv: string = removalValueProblem(d.sym, owner.idx, edit, value)
        if (rv != "") out = out.concat(["C9: " + where + ": " + rv])
        return out
    }

    // C9 (s444) — a removal's value: RemoveEnd / RemoveFront carry the COUNT
    // removed (an Int literal >= 1); RemoveAnywhere carries the new value, which
    // must be `SeqCall(Filter, <this field>, f)` — a filter of the field itself,
    // so a shrink grant can never carry an arbitrary replace.
    fn removalValueProblem(d: Sym, idx: int, edit: EditKind, value: Expr) -> string {
        return match edit {
            .RemoveEnd :> countProblem(value)
            .RemoveFront :> countProblem(value)
            .RemoveAnywhere :> filterProblem(d, idx, value)
            .Replace :> ""
            .Append :> ""
            .Prepend :> ""
            .Anywhere :> ""
            .PositionWrite :> ""
            .FieldAt(path: x) :> ""
            .Transition :> ""
            .ElemAt(index: x) :> ""
        }
    }

    fn countProblem(v: Expr) -> string {
        const l: Literal | not = exprLiteral(v)
        if (l is not) return "a removal's count is not a literal"
        if (intAtLeastOne(l)) return ""
        return "a removal's count is not an int >= 1"
    }

    fn intAtLeastOne(l: Literal) -> boolean {
        return match l {
            .Int(v: n) :> n >= 1
            .Num(v: x) :> false
            .Str(v: x) :> false
            .Bool(v: x) :> false
            .Variant(enumSym: x) :> false
            .Absent :> false
        }
    }

    fn filterProblem(d: Sym, idx: int, v: Expr) -> string {
        return match v {
            .SeqCall(op: op, seq: sq) :> filterOf(d, idx, op, sq)
            .Lit(lit: x) :> "a shrink-anywhere's value is not a filter of the field"
            .Local(sym: x) :> "a shrink-anywhere's value is not a filter of the field"
            .Read(place: x) :> "a shrink-anywhere's value is not a filter of the field"
            .Call(callee: x) :> "a shrink-anywhere's value is not a filter of the field"
            .Prim(op: x) :> "a shrink-anywhere's value is not a filter of the field"
            .Match(scrut: x) :> "a shrink-anywhere's value is not a filter of the field"
            .ArrayOf(elems: x) :> "a shrink-anywhere's value is not a filter of the field"
            .StructOf(ty: x) :> "a shrink-anywhere's value is not a filter of the field"
            .Handle(inst: x) :> "a shrink-anywhere's value is not a filter of the field"
            .InitOf(decl: x) :> "a shrink-anywhere's value is not a filter of the field"
            .Host(call: x) :> "a shrink-anywhere's value is not a filter of the field"
            .Lambda(params: x) :> "a shrink-anywhere's value is not a filter of the field"
            .Validity(of: x) :> "a shrink-anywhere's value is not a filter of the field"
            .Sql(q: x) :> "a shrink-anywhere's value is not a filter of the field"
        }
    }

    fn filterOf(d: Sym, idx: int, op: SeqFn, sq: Expr) -> string {
        const isFilter: boolean = op == SeqFn.Filter
        if (!isFilter) return "a shrink-anywhere's value is a map, not a filter"
        const k: string = readKey(sq)
        const pre: string = "<" + d.hint + "#" + d.id + ">@"
        const tail: string = "." + d.id + ":" + idx
        if (k.indexOf(pre) != 0 || k.substring(k.length - tail.length) != tail) return "a shrink-anywhere filters " + k + ", not the field it writes"
        return ""
    }

    fn instText(i: InstRef) -> string {
        return match i {
            .Shared(decl: d) :> "Shared(" + d.hint + ")"
            .Lexical(depth: k) :> "Lexical(" + k + ")"
            .Alias(sym: s) :> "Alias(" + s.hint + ")"
            .Narrowed(sym: s) :> "Narrowed(" + s.hint + ")"
        }
    }

    // -------------------------------------------------------------------------
    // C3 — is the edit granted?  "" = granted, else the reason.
    // -------------------------------------------------------------------------
    fn editProblem(p: CoreProgram, f: Field, edit: EditKind) -> string {
        return match edit {
            .Transition :> transitionGranted(f)
            // O58 = (b) (RULED S437, user-voice "O58 b"): a GENUINE replace — a
            // non-spread value, `reset`, a server reload — is AUTHORITATIVE and is
            // not checked against sub-field contracts (`reset` restores the
            // declared initial state; a reload takes the server's state). The
            // spread spelling `@x = { ...@x, f: v }` is not a Replace: lower emits
            // it as FieldAt edits, judged by `f`'s own contract (C3/C6). O57 = no:
            // a contract-free sub-field bounds nothing.
            .Replace :> granted(f.grants.replace, "`replace` is not granted")
            .Append :> granted(f.grants.replace || hasEdit(f, EditKind.Append), "an end-append is not granted")
            .Prepend :> granted(f.grants.replace || hasEdit(f, EditKind.Prepend), "a front-prepend is not granted")
            .Anywhere :> granted(f.grants.replace || hasEdit(f, EditKind.Anywhere), "an anywhere-edit is not granted")
            .PositionWrite :> granted(f.grants.replace || hasEdit(f, EditKind.PositionWrite), "a position write is not granted")
            .FieldAt(path: path) :> fieldAtProblem(p, f, path)
            .RemoveEnd :> granted(f.grants.replace || hasEdit(f, EditKind.RemoveEnd), "a removal at the end is not granted")
            .RemoveFront :> granted(f.grants.replace || hasEdit(f, EditKind.RemoveFront), "a removal at the front is not granted")
            .RemoveAnywhere :> granted(f.grants.replace || hasEdit(f, EditKind.RemoveAnywhere), "a shrink-anywhere is not granted")
            .ElemAt(index: ix, path: path) :> elemAtProblem(p, f, path)
        }
    }

    // s444 — `@xs[i].f = v` (dpa-052 Q3, RULED S440): the path walks the
    // ELEMENT struct of the field's sequence type, and the write is granted
    // iff the TARGET element field grants `replace` (its own contract — not a
    // position replace, not the outer field's grants).
    fn elemAtProblem(p: CoreProgram, f: Field, path: FieldRef[]) -> string {
        if (path.length == 0) return "an empty ElemAt path (a whole-element write is a position write)"
        const et: Type | not = seqElemOf(f.ty)
        if (et is not) return "ElemAt on a field whose value is not a sequence"
        let ty: Type = et
        let targetGrants = false
        let i = 0
        for (const step of path) {
            const s: Sym | not = namedSym(ty)
            if (s is not) return "ElemAt step " + i + " steps into a value that is not a struct"
            if (s.id != step.owner.id) return "ElemAt step " + i + " names owner `" + step.owner.hint + "` but the value there is a `" + s.hint + "`"
            const td: TypeDef | not = findTypeDef(p, s)
            if (td is not) return "ElemAt step " + i + ": `" + s.hint + "` is not a declared type"
            const fs: FieldDef[] | not = structFields(td)
            if (fs is not) return "ElemAt step " + i + ": `" + s.hint + "` is not a struct"
            if (step.idx < 0 || step.idx >= fs.length) return "ElemAt step " + i + ": `" + s.hint + "` has no field " + step.idx
            targetGrants = fs[step.idx].grants.replace
            ty = fs[step.idx].ty
            i = i + 1
        }
        if (targetGrants) return ""
        return "the target element field grants no write (its own contract, dpa-052 Q3)"
    }

    fn seqElemOf(t: Type) -> Type | not {
        return match t {
            .Seq(elem: e) :> e
            .Named(sym: s) :> not
            .Maybe(inner: i) :> not
            .Int :> not
            .Num :> not
            .Str :> not
            .Bool :> not
        }
    }

    fn granted(ok: boolean, why: string) -> string {
        if (ok) return ""
        return why
    }

    fn transitionGranted(f: Field) -> string {
        if (f.graph is some) return ""
        return "a transition needs a `rule=` graph; this field has none"
    }

    fn hasEdit(f: Field, k: EditKind) -> boolean {
        for (const e of f.grants.edits) {
            if (e == k) return true
        }
        return false
    }

    fn namedSym(t: Type) -> Sym | not {
        return match t {
            .Named(sym: s) :> s
            .Seq(elem: e) :> not
            .Maybe(inner: i) :> not
            .Int :> not
            .Num :> not
            .Str :> not
            .Bool :> not
        }
    }

    fn structFields(t: TypeDef) -> FieldDef[] | not {
        return match t {
            .StructDef(sym: s, fields: fs) :> fs
            .EnumDef(sym: s) :> not
        }
    }

    // A FieldAt path walks STRUCT fields of the field's value. Each step must
    // name the struct type of the value it steps into. (A step into a sequence
    // position is not representable by FieldRef in M1 Core — a position write is
    // `.PositionWrite` on the field; `@rows[i].qty = v` needs a dynamic-index
    // Core form, recorded for M2.)
    fn fieldAtProblem(p: CoreProgram, f: Field, path: FieldRef[]) -> string {
        if (path.length == 0) return "an empty FieldAt path (a whole-field write is `.Replace`)"
        let ty: Type = f.ty
        let contractInside = false
        let targetGrants = false
        let i = 0
        for (const step of path) {
            const s: Sym | not = namedSym(ty)
            if (s is not) return "FieldAt step " + i + " steps into a value that is not a struct"
            if (s.id != step.owner.id) return "FieldAt step " + i + " names owner `" + step.owner.hint + "` but the value there is a `" + s.hint + "`"
            const td: TypeDef | not = findTypeDef(p, s)
            if (td is not) return "FieldAt step " + i + ": `" + s.hint + "` is not a declared type"
            const fs: FieldDef[] | not = structFields(td)
            if (fs is not) return "FieldAt step " + i + ": `" + s.hint + "` is not a struct"
            if (step.idx < 0 || step.idx >= fs.length) return "FieldAt step " + i + ": `" + s.hint + "` has no field " + step.idx
            const fd: FieldDef = fs[step.idx]
            if (fd.grants.edits.length > 0) contractInside = true
            targetGrants = fd.grants.replace
            ty = fd.ty
            i = i + 1
        }
        if (targetGrants) return ""
        if (f.grants.replace && !contractInside) return ""
        if (f.grants.replace) return "the path reaches a field with its own non-replace contract; an outer `replace` may not bypass it"
        return "the target struct field grants no write, and the field does not grant `replace`"
    }

    // -------------------------------------------------------------------------
    // C4 / C5 — which declaration does an instance reference name?
    // -------------------------------------------------------------------------
    fn resolveInst(p: CoreProgram, encl: Decl[], i: InstRef) -> Decl | not {
        return match i {
            .Shared(decl: d) :> findDecl(p, d)
            .Lexical(depth: k) :> lexicalDecl(encl, k)
            .Alias(sym: h) :> aliasDecl(p, h)
            .Narrowed(sym: c) :> narrowedDecl(p, encl, c)
        }
    }

    fn lexicalDecl(encl: Decl[], k: int) -> Decl | not {
        if (k >= 0 && k < encl.length) return encl[k]
        return not
    }

    // The declaration of the use that binds `as=` handle h.
    fn aliasDecl(p: CoreProgram, h: Sym) -> Decl | not {
        for (const n of allNodes(Node.NProgram(p))) {
            const d: Sym | not = aliasOf(n, h)
            if (d is some) return findDecl(p, d)
        }
        return not
    }

    fn aliasOf(n: Node, h: Sym) -> Sym | not {
        return match n {
            .NView(v: v) :> viewAlias(v, h)
            .NProgram(p: q) :> not
            .NDecl(d: d) :> not
            .NField(f: f) :> not
            .NFn(f: f) :> not
            .NServerFn(f: f) :> not
            .NBlock(b: b) :> not
            .NStmt(s: s) :> not
            .NExpr(e: e) :> not
            .NPlace(pl: pl) :> not
            .NInst(i: i) :> not
            .NPattern(pat: pat) :> not
            .NEdit(k: k) :> not
            .NAttr(a: a) :> not
        }
    }

    fn viewAlias(v: View, h: Sym) -> Sym | not {
        return match v {
            .Instance(decl: d, alias: a) :> sameAlias(a, h, d)
            .El(tag: t) :> not
            .Text(text: t) :> not
            .Dyn(e: e) :> not
            .Cond(arms: a) :> not
            .Each(src: s) :> not
            .Slot :> not
            .Star(decl: d) :> not
            .Effect(deps: ds) :> not
            .ResetOn(triggers: ds) :> not
            .Errors(of: ds) :> not
        }
    }

    fn sameAlias(a: Sym | not, h: Sym, d: Sym) -> Sym | not {
        if (a is not) return not
        if (a.id == h.id) return d
        return not
    }

    // `.Narrowed(c)`: c must be bound by a Let whose initializer is an instance
    // Handle; it names whatever that handle names.
    fn narrowedDecl(p: CoreProgram, encl: Decl[], c: Sym) -> Decl | not {
        for (const n of allNodes(Node.NProgram(p))) {
            const i: InstRef | not = letHandle(n, c)
            if (i is some) return resolveInst(p, encl, i)
        }
        return not
    }

    fn letHandle(n: Node, c: Sym) -> InstRef | not {
        return match n {
            .NStmt(s: s) :> stmtLetHandle(s, c)
            .NProgram(p: q) :> not
            .NDecl(d: d) :> not
            .NField(f: f) :> not
            .NFn(f: f) :> not
            .NServerFn(f: f) :> not
            .NBlock(b: b) :> not
            .NExpr(e: e) :> not
            .NPlace(pl: pl) :> not
            .NInst(i: i) :> not
            .NPattern(pat: pat) :> not
            .NEdit(k: k) :> not
            .NView(v: v) :> not
            .NAttr(a: a) :> not
        }
    }

    fn stmtLetHandle(s: Stmt, c: Sym) -> InstRef | not {
        return match s {
            .Let(sym: sym, init: init) :> letInitHandle(sym, init, c)
            .Assign(local: l) :> not
            .Write(cap: x) :> not
            .Commit(writes: x) :> not
            .If(cond: x) :> not
            .Return(e: x) :> not
            .Eval(e: x) :> not
            .Suspend(bind: x) :> not
            .ResetSurface(of: x) :> not
            .Defer(body: x) :> not
            .Unpersist(decl: x) :> not
        }
    }

    fn letInitHandle(sym: Sym, init: Expr, c: Sym) -> InstRef | not {
        if (sym.id != c.id) return not
        return exprHandle(init)
    }

    fn exprHandle(e: Expr) -> InstRef | not {
        return match e {
            .Handle(inst: i) :> i
            .InitOf(decl: x) :> not
            .Lit(lit: x) :> not
            .Local(sym: x) :> not
            .Read(place: x) :> not
            .Call(callee: x) :> not
            .Prim(op: x) :> not
            .Match(scrut: x) :> not
            .ArrayOf(elems: x) :> not
            .StructOf(ty: x) :> not
            .Host(call: x) :> not
            .Lambda(params: x) :> not
            .SeqCall(op: x) :> not
            .Validity(of: x) :> not
            .Sql(q: x) :> not
        }
    }

    // C5 for `InitOf`: the instance is one of `decl`, and `idx` is its field.
    fn checkExpr(p: CoreProgram, encl: Decl[], e: Expr) -> string[] {
        return match e {
            .InitOf(decl: d, inst: i, idx: x) :> checkCellRead(p, encl, d, i, [{ owner: d, idx: x }])
            .Lit(lit: l) :> []
            .Local(sym: s) :> []
            .Read(place: pl) :> []
            .Call(callee: c) :> []
            .Prim(op: o) :> []
            .Match(scrut: s) :> []
            .ArrayOf(elems: es) :> []
            .StructOf(ty: t) :> []
            .Handle(inst: i) :> []
            .Host(call: c) :> []
            .Lambda(params: ps) :> []
            .SeqCall(op: o) :> []
            .Validity(of: v, prop: pr) :> checkSurfaceRead(p, encl, v, pr)
            .Sql(q: q) :> checkSqlQuery(p, q)
        }
    }

    fn checkPlace(p: CoreProgram, encl: Decl[], pl: Place) -> string[] {
        return match pl {
            .Cell(decl: d, inst: i, path: path) :> checkCellRead(p, encl, d, i, path)
            .LocalPath(sym: s) :> []
        }
    }

    fn checkCellRead(p: CoreProgram, encl: Decl[], dsym: Sym, i: InstRef, path: FieldRef[]) -> string[] {
        const d: Decl | not = findDecl(p, dsym)
        if (d is not) return ["C5: a read names declaration `" + dsym.hint + "`, which does not exist"]
        const target: Decl | not = resolveInst(p, encl, i)
        if (target is not) return ["C5: a read of <" + d.sym.hint + "> goes through " + instText(i) + ", which does not resolve"]
        if (target.sym.id != d.sym.id) return ["C5: a read of <" + d.sym.hint + "> goes through " + instText(i) + ", an instance of <" + target.sym.hint + ">"]
        if (path.length > 0) {
            if (path[0].owner.id != d.sym.id || path[0].idx < 0 || path[0].idx >= d.fields.length) {
                return ["C5: a read of <" + d.sym.hint + "> names field " + path[0].idx + " of `" + path[0].owner.hint + "`"]
            }
        }
        return []
    }

    // -------------------------------------------------------------------------
    // C6 — is the write's `check` sound?  "" = sound, else the reason.
    // -------------------------------------------------------------------------
    fn isTransition(k: EditKind) -> boolean {
        return match k {
            .Transition :> true
            .FieldAt(path: x) :> false
            .Replace :> false
            .Append :> false
            .Prepend :> false
            .Anywhere :> false
            .PositionWrite :> false
            .RemoveEnd :> false
            .RemoveFront :> false
            .RemoveAnywhere :> false
            .ElemAt(index: x) :> false
        }
    }

    fn isStatic(c: Check) -> boolean {
        return match c {
            .Static :> true
            .RuntimeEdge :> false
        }
    }

    // The literal behind a `Lit` expression, else not.
    fn exprLiteral(e: Expr) -> Literal | not {
        return match e {
            .Lit(lit: l) :> l
            .Handle(inst: x) :> not
            .InitOf(decl: x) :> not
            .Local(sym: x) :> not
            .Read(place: x) :> not
            .Call(callee: x) :> not
            .Prim(op: x) :> not
            .Match(scrut: x) :> not
            .ArrayOf(elems: x) :> not
            .StructOf(ty: x) :> not
            .Host(call: x) :> not
            .Lambda(params: x) :> not
            .SeqCall(op: x) :> not
            .Validity(of: x) :> not
            .Sql(q: x) :> not
        }
    }

    // -1 = not a variant of `es`; else the variant index.
    fn variantIdx(l: Literal, es: Sym) -> int {
        return match l {
            .Variant(enumSym: s, idx: idx) :> variantIdxOf(s, idx, es)
            .Int(v: x) :> -1
            .Num(v: x) :> -1
            .Str(v: x) :> -1
            .Bool(v: x) :> -1
            .Absent :> -1
        }
    }

    fn variantIdxOf(s: Sym, idx: int, es: Sym) -> int {
        if (s.id == es.id) return idx
        return -1
    }

    fn enumSize(p: CoreProgram, es: Sym) -> int {
        const t: TypeDef | not = findTypeDef(p, es)
        if (t is not) return 0
        return enumVariantCount(t)
    }

    fn enumVariantCount(t: TypeDef) -> int {
        return match t {
            .EnumDef(sym: s, variants: vs) :> vs.length
            .StructDef(sym: s) :> 0
        }
    }

    fn targetsOf(g: TransitionGraph, origin: int) -> int[] {
        for (const e of g.edges) {
            if (e.origin == origin) return e.targets
        }
        return []
    }

    fn hasInt(xs: int[], x: int) -> boolean {
        for (const y of xs) { if (y == x) return true }
        return false
    }

    // Every state either IS `to` (a self-write no-op) or has an edge to `to`.
    fn reachableFromEveryState(g: TransitionGraph, n: int, to: int) -> boolean {
        let v = 0
        while (v < n) {
            if (v != to && !hasInt(targetsOf(g, v), to)) return false
            v = v + 1
        }
        return true
    }

    fn checkProblem(p: CoreProgram, f: Field, edit: EditKind, value: Expr, check: Check) -> string {
        if (isTransition(edit)) {
            const g: TransitionGraph | not = f.graph
            if (g is not) return ""                              // already C3
            return graphCheckProblem(p, g, value, check)
        }
        if (isStatic(check)) return ""
        return "a RuntimeEdge check on a write that is not a transition"
    }

    // A write along graph `g`: a literal value must be one of its variants;
    // `Static` only when Core proves the edge (every state is the target or has
    // an edge to it); otherwise the edge is checked at runtime (RuntimeEdge).
    fn graphCheckProblem(p: CoreProgram, g: TransitionGraph, value: Expr, check: Check) -> string {
        const n: int = enumSize(p, g.enumSym)
        const lit: Literal | not = exprLiteral(value)
        if (lit is some) {
            const to: int = variantIdx(lit, g.enumSym)
            if (to < 0 || to >= n) return "the transition value is not a variant of `" + g.enumSym.hint + "`"
            if (!isStatic(check)) return ""
            if (reachableFromEveryState(g, n, to)) return ""
            return "a Static transition to a variant not reachable from every state; the edge needs a RuntimeEdge check"
        }
        if (isStatic(check)) return "a Static transition to a non-literal value is not provable in Core; use RuntimeEdge"
        return ""
    }
}
