// §18 / §42: the `not` arm; the arm after it reads the subject narrowed to `T`.
<program>
    let <name:string | not=not/>
    <main>
        <button id="in" onclick={ @name = "bryan"; }>in</button>
        <p id="who">${match @name { not :> "nobody", else :> "hi " + @name, }}</p>
    </main>
</program>
