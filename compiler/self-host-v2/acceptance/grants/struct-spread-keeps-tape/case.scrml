// a spread that keeps the tape field is an edit of `title` only.
<program>
    type Entry:struct = { at: int, action: string }
    type Box:struct = { title: string, xs: Entry[free, append] }
    let <b:Box=({ title: "log", xs: [] })/>
    function go() {
        @b = { ...@b, title: "renamed" };
    }
    <main>
        <button id="go" onclick=go()>go</button>
        <p id="out">${@b.title}</p>
    </main>
</program>
