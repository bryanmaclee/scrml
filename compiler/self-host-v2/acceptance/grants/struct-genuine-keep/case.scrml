// a genuine replace that leaves the tape field as it was.
<program>
    type Entry:struct = { at: int, action: string }
    type Box:struct = { title: string, xs: Entry[free, append] }
    let <b:Box=({ title: "log", xs: [] })/>
    function go() {
        @b = { title: "rebuilt", xs: @b.xs };
    }
    <main>
        <button id="go" onclick=go()>go</button>
        <p id="out">${@b.title}</p>
    </main>
</program>
