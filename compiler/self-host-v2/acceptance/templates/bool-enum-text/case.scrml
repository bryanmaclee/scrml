// §20.7.2: a bool's text is true / false; a unit enum value's is its variant name.
<program>
    type Color:enum = { Red, Green, Blue }
    let <c:Color=.Red/>
    let <flag:bool=false/>
    fn describe(k: Color, b: bool) -> string {
        return `${k} is ${b}`
    }
    <main>
        <button id="go" onclick={ @c = .Blue
            @flag = true }>go</button>
        <p id="out">${describe(@c, @flag)}</p>
    </main>
</program>
