// §14.13.1: a number passed to a `string` parameter is written as a template.
<program>
    type P:struct = { name: string, age: int }
    let <p:P=({ name: "Ada", age: 36 })/>
    fn greet(s: string) -> string {
        return `hi, ${s}!`;
    }
    <main>
        <p id="field">${greet(`${@p.name} (${@p.age})`)}</p>
        <p id="num">${greet(`${@p.age}`)}</p>
    </main>
</program>
