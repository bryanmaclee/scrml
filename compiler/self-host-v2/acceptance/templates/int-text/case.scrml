// §14.13.3: a logic backtick template is a `string`; an `int` slot is its digits.
<program>
    let <n:int=3/>
    fn label(k: int) -> string {
        return `typed ${k} chars`;
    }
    <main>
        <button id="inc" onclick={ @n = @n + 1; }>+</button>
        <p id="a">${label(@n)}</p>
        <p id="neg">${label(0 - 42)}</p>
        <p id="big">${label(9007199254740991)}</p>
    </main>
</program>
