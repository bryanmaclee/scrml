// §7.2.2 rule 10 (S469 "Keyword at statement start"): `defer⏎stmt` defers the statement on the next line.
<program>
    let <out:string=""/>
    function go() {
        @out = @out + "a";
        defer
            @out = @out + "1";
        @out = @out + "b";
    }
    <main>
        <button id="go" onclick=go()>go</button>
        <p id="out">${@out}</p>
    </main>
</program>
