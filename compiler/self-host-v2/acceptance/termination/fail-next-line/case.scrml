// §7.2.2 rule 10 (S469 "Keyword at statement start"): `fail` is the keyword at statement start whenever the next token can begin its operand, regardless of line.
<program>
    type LoadError:enum = { NotFound(id: string), Timeout }
    let <out:string=""/>
    function load(id: string)! LoadError {
        if (id == "x") fail
            LoadError.NotFound(id);
        if (id == "y") fail
            .Timeout;
        return id;
    }
    function x() { @out = load("x") !{ .NotFound(m) :> "nf:" + m, .Timeout :> "to" }; }
    function y() { @out = load("y") !{ .NotFound(m) :> "nf:" + m, .Timeout :> "to" }; }
    <main>
        <button id="x" onclick=x()>x</button>
        <button id="y" onclick=y()>y</button>
        <p id="out">${@out}</p>
    </main>
</program>
