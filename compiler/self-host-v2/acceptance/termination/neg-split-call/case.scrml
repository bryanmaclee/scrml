// §7.2.2 rule 5 (F4 (ii), S469 "Build both"): an expression may not continue into a line that starts with `(` — E-STMT-SPLIT-CONTINUATION, not the call `a(a + 1)`.
<program>
    let <n:int=0/>
    function go(a: int) -> int {
        let b = a
        (a + 1);
        return b;
    }
    <main>
        <p id="n">${go(@n)}</p>
    </main>
</program>
