// dpa-073 F2 — a comma list: a `,` after the first arm and none after the second is refused (E-MATCH-ARM-SEPARATOR at the missing `,`).
<program>
    type LoadError:enum = { NotFound(id: string), Timeout, Gone }
    let <out:string=""/>
    function load(id: string)! LoadError {
        if (id == "x") fail LoadError.NotFound(id);
        return id;
    }
    function f() {
        @out = load("x") !{
            .NotFound(m) :> "nf",
            .Timeout :> "to"
            .Gone :> "g"
        };
    }
    <main><p>${@out}</p></main>
</program>
