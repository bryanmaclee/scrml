// dpa-073 F2 — one list, one spelling: `,` after the first arm and a newline after the second is refused.
<program>
    type LoadError:enum = { NotFound(id: string), Timeout, Gone }
    let <out:string=""/>
    function load(id: string)! LoadError {
        if (id == "x") fail LoadError.NotFound(id)
        return id
    }
    function f() {
        @out = load("x") !{
            .NotFound(m) :> "nf",
            .Timeout :> "to"
            .Gone :> "g"
        }
    }
    <main><p>${@out}</p></main>
</program>
