// §18.5 (S469 "block arms yield with `lift`"): a `!{}` block arm whose value is used yields with `lift`.
<program>
    type LoadError:enum = { NotFound(id: string), Timeout }
    let <out:string=""/>
    let <n:int=0/>
    function load(id: string)! LoadError {
        if (id == "x") fail LoadError.NotFound(id);
        if (id == "y") fail LoadError.Timeout;
        return id;
    }
    function v() {
        @out = load("x") !{
            .NotFound(m) :> {
                @n = @n + 1;
                lift "nf:" + m;
            },
            .Timeout :> "to",
        };
    }
    function w() {
        @out = load("y") !{
            .NotFound(m) :> { lift m; },
            .Timeout :> {
                @n = @n + 10;
                lift "to";
            },
        };
    }
    <main>
        <button id="v" onclick=v()>v</button>
        <button id="w" onclick=w()>w</button>
        <p id="out">${@out}</p>
        <p id="n">${@n}</p>
    </main>
</program>
