// §14.13.4: `E.parse(s)` — the variant whose name is `s` exactly, else `not`; `E.toEnum` is the same path.
<program>
    type Guess:enum = { Yes, No }
    function show(g: Guess | not) -> string {
        return match g {
            .Yes :> "Yes",
            .No :> "No",
            not :> "not"
        };
    }
    <main>
        <p id="a">${show(Guess.parse("Yes"))} ${show(Guess.parse("No"))} ${show(Guess.parse("yes"))} ${show(Guess.parse("constructor"))}</p>
        <p id="b">${show(Guess.toEnum("No"))} ${show(Guess.toEnum("x"))}</p>
    </main>
</program>
