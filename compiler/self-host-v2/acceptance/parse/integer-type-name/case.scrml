// §14.13.6: `integer` and `boolean` are `int` and `bool` in type position (the §63 window is not open: no warning).
<program>
    let <n:integer=41/>
    let <b:boolean=true/>
    function inc(x: integer) -> int { return x + 1; }
    <main>
        <p id="n">${inc(@n)}</p>
        <p id="b">${@b}</p>
    </main>
</program>
