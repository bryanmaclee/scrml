// a literal-arm match on a string decides a login: anything but the password → deny.
<program>
    let <wrong:string=""/>
    let <right:string=""/>
    let <empty:string=""/>
    function attempt(pw: string) -> string {
        return match pw {
            "hunter2" :> "welcome",
            else :> "denied"
        };
    }
    function login() {
        @wrong = attempt("hunter3");
        @right = attempt("hunter2");
        @empty = attempt("");
    }
    <main>
        <button id="go" onclick=login()>go</button>
        <p id="wrong">${@wrong}</p>
        <p id="right">${@right}</p>
        <p id="empty">${@empty}</p>
    </main>
</program>
