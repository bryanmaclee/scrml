// a literal match with no `else`: a wrong password takes NO arm (`not`) — it never falls into the last (admin) arm.
<program>
    let <wrong:string="unset"/>
    function grant(pw: string) -> string | not {
        return match pw {
            "guest" :> "guest-view",
            "hunter2" :> "admin-view"
        };
    }
    function login() {
        @wrong = match grant("hunter3") { not :> "denied", else :> "granted", };
    }
    <main>
        <button id="go" onclick=login()>go</button>
        <p id="wrong">${@wrong}</p>
    </main>
</program>
