// the same login with `return not`: the wrong password takes the `not` arm.
<program>
    let <wrong:string=""/>
    let <right:string=""/>
    type User:struct = { name: string }
    function find(pw: string) -> User | not {
        const u: User = { name: "bryan" }
        if (pw == "hunter2") return u
        return not
    }
    function attempt(pw: string) -> string {
        let m: string = "denied"
        match find(pw) {
            not :> m = "denied"
            _ :> m = "welcome"
        }
        return m
    }
    function login() {
        @wrong = attempt("hunter3")
        @right = attempt("hunter2")
    }
    <main>
        <button id="go" onclick=login()>go</button>
        <p id="wrong">${@wrong}</p>
        <p id="right">${@right}</p>
    </main>
</program>
