// a `void` pass-through wrapper read as a value: refused (E-TYPE-001 — `void` is not a value).
<program>
    let <wrong:string=""/>
    let <right:string=""/>
    function nothing(pw: string) {
        if (pw == "") return
    }
    function w(pw: string) {
        return nothing(pw)
    }
    function attempt(pw: string) -> string {
        const s: string = w(pw)
        if (s == "") return "denied"
        return "welcome"
    }
    function login() {
        @wrong = attempt("hunter3")
        @right = attempt("hunter2")
    }
    <main>
        <button id="go" onclick=login()>go</button>
        <p id="wrong">${@wrong}</p>
        <p id="right">${@right}</p>
    </main>
</program>
