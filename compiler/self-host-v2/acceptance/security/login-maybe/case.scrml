// a statement match on `User | not` decides a login: no user → the deny (`not`) arm.
<program>
    type User:struct = { name: string }
    let <wrong:string=""/>
    let <right:string=""/>
    function find(pw: string) -> User | not {
        const u: User = { name: "bryan" }
        if (pw == "hunter2") return u
        return not
    }
    function attempt(pw: string) {
        let msg: string = ""
        match find(pw) {
            not :> msg = "denied"
            else :> msg = "welcome"
        }
        return msg
    }
    function login() {
        @wrong = attempt("")
        @right = attempt("hunter2")
    }
    <main>
        <button id="go" onclick=login()>go</button>
        <p id="wrong">${@wrong}</p>
        <p id="right">${@right}</p>
    </main>
</program>
