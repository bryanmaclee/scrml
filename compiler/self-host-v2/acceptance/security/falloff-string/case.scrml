// a login whose finder (`string | not`, `not` / `_` arms) falls off the end on a wrong password: refused.
<program>
    let <wrong:string=""/>
    let <right:string=""/>
    function find(pw: string) -> string | not {
        if (pw == "hunter2") return "bryan"
    }
    function attempt(pw: string) -> string {
        let m: string = "denied"
        match find(pw) {
            not :> m = "denied"
            _ :> m = "welcome"
        }
        return m
    }
    function login() {
        @wrong = attempt("hunter3")
        @right = attempt("hunter2")
    }
    <main>
        <button id="go" onclick=login()>go</button>
        <p id="wrong">${@wrong}</p>
        <p id="right">${@right}</p>
    </main>
</program>
