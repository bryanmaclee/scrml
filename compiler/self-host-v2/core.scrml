// =============================================================================
// self-host-v2 / core.scrml — the Core IR (bootstrap impl#2, slice M1).
//
// Design authority: dpa-051 §3.2 (the proposal), §3.3–§3.6, §4, §5, §6 — R2
// (thin Core) ruled S437. Everything in this file is DATA: enums and structs,
// plus pure constructor/lookup `fn`s. There are no methods and no classes
// (S430 P1), no module state (§3.5), and every traversal elsewhere is a total
// `match` with NO default arm (§3.4 — enforced by
// scripts/lint-no-default-arm.js).
//
// The §4 invariant: `string` appears ONLY in literal values (Literal.Str,
// Attr.Static.value, View.Text.text), identifiers (Sym.hint, El.tag,
// Attr names, On.event) — never as a body, an expression, or a code fragment.
// Every body is a Block or a View list.
//
// Deviations from the §3.2 proposal are listed in
// compiler/self-host-v2/slice-m1/progress.md ("§3.2 deviations").
//
// impl#1 workarounds used here: F11 — every `match` on a payload variant uses
// NAMED binding (`.Lit(lit: l)`), because positional binding over an enum
// imported from another file is silently dropped.
// =============================================================================
${
    // -------------------------------------------------------------------------
    // Identity. A Sym is minted by the binder (analyze) — Core holds Syms,
    // never names (§3.3). `hint` is the source identifier; the printer's ONE
    // NameSupply turns hints into emitted names. Sym ids are dense per program.
    //
    // THE BINDER'S OBLIGATION (unforgeability of write capabilities). A Sym id
    // is only meaningful because the binder is the ONLY minter of Syms: every
    // id is issued once, from one counter, to one declaration site. Write
    // capabilities (Field.wcap) rest on that: a data IR cannot stop a pass from
    // constructing `Stmt.Write` with an integer it made up, so `analyze`/`lower`
    // MUST NOT construct a Sym except through the binder, and MUST NOT reuse a
    // field's read Sym as a capability. check.scrml's C2 catches a capability
    // that no field owns; it cannot catch a pass that mints a capability for a
    // field whose contract grants nothing AND edits that field's `wcap` — that
    // is C1's job, and C1 is only as good as the Field record. By design
    // (review F6): unforgeability is binder discipline, not a type-system fact.
    //
    // A NodeId keys analyze side-tables (DepSet, certification); M1 needs no
    // side-table, so no Core node carries one yet (see progress.md).
    // -------------------------------------------------------------------------
    export type Sym:struct = { id: int, hint: string }
    export type NodeId:struct = { n: int }

    // -------------------------------------------------------------------------
    // Types. Permissions live on the TYPE (§66.12.3): a sequence type carries
    // its axis grants. Named(sym) names a TypeDef or a declaration (every
    // declaration registers a type, §66.8.1).
    // -------------------------------------------------------------------------
    export type SeqAt:enum = { End, Front, Anywhere }
    export type LengthGrant:enum = { Fixed, Bounded(min: int, max: int), Free }
    // `at` = the places the sequence may GROW, `shrink` = the places it may
    // SHRINK (RULED S442 grow/shrink split: `append`/`pop`, `prepend`/`shift`,
    // `insert`/`remove`; s444: shrink joined Core when removals became edits).
    // `replace` (s469-boot-tape-grants): the type's own `replace` token —
    // §66.12.3 "Permissions live on the TYPE", so a tape held by a local or a
    // parameter carries it too (before, only a declaration field's GrantSet did).
    export type SeqGrants:struct = { length: LengthGrant, at: SeqAt[], shrink: SeqAt[], positionsWritable: boolean, replace: boolean }

    export type Type:enum = {
        Int,
        Num,
        Str,
        Bool,
        Named(sym: Sym),
        Seq(elem: Type, grants: SeqGrants),
        Maybe(inner: Type),
    }

    // A struct field carries its OWN write contract (O3 ruled: struct fields take
    // per-field `let`; §66.11.4: a field with no contract is fixed). Variant
    // payload fields carry `noGrants()` (a payload is a value, never written in
    // place). A `rule=` graph lives on a DECLARATION field (Field.graph); no
    // source form declares one on a `type … :struct` field, so FieldDef has none
    // (the M2 fix round removed the unfillable `FieldDef.graph` — progress.md).
    export type FieldDef:struct   = { sym: Sym, ty: Type, grants: GrantSet }
    export type VariantDef:struct = { sym: Sym, fields: FieldDef[] }
    export type TypeDef:enum = {
        EnumDef(sym: Sym, variants: VariantDef[]),
        StructDef(sym: Sym, fields: FieldDef[]),
    }

    // -------------------------------------------------------------------------
    // Places. A path step names the struct/declaration that owns the field, so
    // the printer never needs a type environment to turn an index into a
    // property name (§3.2 had `path:[FieldIdx]`).
    // -------------------------------------------------------------------------
    export type FieldRef:struct = { owner: Sym, idx: int }

    // Which instance a cell read/write addresses (§5.2): the lazily-created
    // shared instance of a declaration; the lexically enclosing instance
    // (depth 0 = nearest, O54 (a)); an `as=` handle; or a `given`-narrowed
    // local holding an instance identity (O56 narrow).
    export type InstRef:enum = {
        Shared(decl: Sym),
        Lexical(depth: int),
        Alias(sym: Sym),
        Narrowed(sym: Sym),
    }

    // A read location. `Cell.path` empty = the whole instance value (a struct
    // snapshot, §66.7.1); `path[0]` indexes the declaration's fields; later
    // steps index into struct values. `LocalPath.path` is NON-EMPTY — a whole
    // local is `Expr.Local` (one spelling per shape).
    export type Place:enum = {
        Cell(decl: Sym, inst: InstRef, path: FieldRef[]),
        LocalPath(sym: Sym, path: FieldRef[]),
    }

    // -------------------------------------------------------------------------
    // Expressions.
    // -------------------------------------------------------------------------
    // A nullary enum variant is `Variant(enumSym, idx)` — the tag is data.
    export type Literal:enum = {
        Int(v: int),
        Num(v: number),
        Str(v: string),
        Bool(v: boolean),
        Variant(enumSym: Sym, idx: int),
        Absent,
    }

    // Primitive operators, RESOLVED by analyze: `==` on scalars/nullary enums
    // is EqPrim, on structs/sequences EqStruct (§45) — the printer never
    // re-derives an operand's type.
    export type PrimOp:enum = {
        Add, Sub, Mul, Div, Mod, Neg,
        Not, And, Or,
        Lt, Le, Gt, Ge,
        EqPrim, NeqPrim, EqStruct, NeqStruct,
        IsSome, IsNot,
        Concat, Length,
        // s469 (strings + tape methods) — typed built-in method calls; `args[0]`
        // is the receiver. Each makes a NEW value (R3). String positions count
        // CODE POINTS — everywhere (S469, bryan: "code points everywhere,
        // `.length` included"): StrLength(s) is a string's `.length` (a tape's
        // stays Length), StrSlice(s, from[, to]), StrCharAt(s, i), StrSplit(s,
        // sep) with `""` splitting into code points; StrIncludes / StrStartsWith
        // / StrEndsWith / StrSplit match only on code-point boundaries. SortNum / SortStr are a tape's natural
        // order (S469: numbers numerically, strings by code point); Reverse a
        // reversed copy; Join(xs, sep) a string tape joined.
        StrUpper, StrLower, StrTrim, StrSlice, StrCharAt, StrLength,
        StrIncludes, StrStartsWith, StrEndsWith, StrSplit,
        SortNum, SortStr, Reverse, Join,
        // s469 (§49.13) — reading a tape by position. `IndexRead` is `xs[i]`
        // (args: the tape, the index, and a Str literal naming the source
        // location): the element when `0 <= i < xs.length`, else the
        // E-INDEX-OUT-OF-RANGE-RT trap (§19.17) — never `undefined`, never
        // `not`. `AtRead` is `xs.at(i)` (args: the tape, the index): the
        // element, or `not` when `i` is out of range (a negative `i` included).
        IndexRead, AtRead,
        // s469 (S469 "more string methods admitted") — the admitted additions,
        // `args[0]` the receiver, every position and width in CODE POINTS:
        // StrIndexOf / StrLastIndexOf(s, t) are `int | not` (never -1);
        // StrReplace / StrReplaceAll(s, find, with) take plain strings and put
        // `with` in literally (no `$&` patterns); StrPadStart / StrPadEnd(s,
        // width[, fill]) and StrRepeat(s, n) trap on a negative width / count
        // (E-INDEX-OUT-OF-RANGE-RT — no negative positions, S469); StrTrimStart
        // / StrTrimEnd are the host's (they change no position).
        StrIndexOf, StrLastIndexOf, StrReplace, StrReplaceAll,
        StrPadStart, StrPadEnd, StrRepeat, StrTrimStart, StrTrimEnd,
        // s469 (§14.13.4, `T.parse(s)`) — strict whole-string text → `T | not`
        // (args: the string only; there is no receiver value): ParseInt — an
        // optional `-` and ASCII digits, within ±(2^53−1); ParseNum — adds a
        // `.` fraction and an exponent, FINITE results only (NaN, ±∞ and an
        // overflow are `not`); ParseBool — exactly "true" / "false". An enum's
        // `E.parse` is a Core `match` (lower.scrml toEnumExpr), not an op.
        ParseInt, ParseNum, ParseBool,
        // s469 (§14.13.3, logic templates) — Text(x): the one honest text of a
        // primitive (§20.7.2) — an `int` / `number` as ECMAScript
        // Number::toString, a `bool` as `true` / `false`, a unit enum value as
        // its variant name. `x` is never a `string` (lower leaves those as they
        // are) and never anything but a primitive (the typer refuses the rest,
        // E-TEXT-NON-PRIMITIVE / E-OPERAND-NOT-NARROWED).
        Text,
    }

    export type Pattern:enum = {
        PVariant(enumSym: Sym, idx: int, binds: Sym[]),
        PLit(lit: Literal),
        PWild,
    }

    // s444 — the host calls Core admits (a CLOSED set; see progress.md
    // "host call surface"): `Date.now()` only — the §66.19.5 timestamp.
    // s469 r3 (F1) — `Unreadable`: what lower makes of a parse placeholder
    // (AExprK.Recovered). Never a program's meaning: checkCore refuses any Core
    // that holds one (C-R1), so a placeholder can never print as a silent `null`.
    export type HostCall:enum = { DateNow, Unreadable }
    // s444 — the sequence functions a lambda is admitted as the argument of.
    // Each makes a NEW sequence value (R3: values are immutable).
    // s469: SortBy — `xs.sort((a, b) => n)`, a new tape ordered by the
    // comparator (its two parameters are the element type; it returns a number).
    export type SeqFn:enum = { Filter, Map, SortBy }

    // s449 — the §55 validity surface. A surface is the reactive validity
    // state the compiler synthesizes for a value that carries validators
    // (§55.5.1 — a top-level value), for every child field of a user
    // declaration (§55.6, Edge B: a field with no validators reads trivially
    // valid) and for a user declaration as a whole (§55.5 — the compound). It
    // is READ-ONLY by construction: nothing here names a write capability, so
    // no Write can target it (§55.7, E-SYNTHESIZED-WRITE). `OfField` is field
    // `idx` of `decl` through `inst`; `OfDecl` is the compound of the
    // instance `inst` of user declaration `decl`.
    export type SurfaceProp:enum = { IsValid, Errors, Touched, Submitted }
    export type ValidityOf:enum = {
        OfField(decl: Sym, inst: InstRef, idx: int),
        OfDecl(decl: Sym, inst: InstRef),
    }

    // s449 — one validator a field carries (§55.1), as the bootstrap admits it
    // (the predicates whose meaning it evaluates; analyze refuses the rest).
    // Declaration order is kept (§55.12: errors are reported in source order).
    // `LengthCmp.op` is the comparison as written (`>=`, `>`, `<=`, `<`, `==`)
    // and `n` its int literal; `Min` / `Max` carry the numeric literal;
    // `Pattern` carries the regex source (no flags — analyze admits only an
    // exact, flag-free pattern).
    export type Validator:enum = {
        Req,
        LengthCmp(op: string, n: int),
        Min(n: number),
        Max(n: number),
        Pattern(source: string),
    }

    export type Expr:enum = {
        Lit(lit: Literal),
        Local(sym: Sym),
        Read(place: Place),
        Call(callee: Sym, args: Expr[]),
        Prim(op: PrimOp, args: Expr[]),
        Match(scrut: Expr, arms: MatchArm[]),
        ArrayOf(elems: Expr[]),
        StructOf(ty: Sym, fields: Expr[]),
        Handle(inst: InstRef),
        // D15 (M2 fix round, F-B): the value field `idx` of `inst` was
        // CONSTRUCTED with — that instance's own initializer (a use-site value,
        // L6 / §66.9, else the declared default), evaluated again now. What
        // `reset(@x.f)` writes (L4) when the instance may have had a use site.
        InitOf(decl: Sym, inst: InstRef, idx: int),
        // s444: a host call (the closed HostCall set; never in a pure `fn`).
        Host(call: HostCall),
        // s444: a function value — its parameters are binder-minted locals;
        // the body is ONE expression. Only as a SeqCall's argument.
        Lambda(params: Sym[], body: Expr),
        // s444: `seq.filter(f)` / `seq.map(f)` — a new sequence value.
        SeqCall(op: SeqFn, seq: Expr, f: Expr),
        // s449: a read of the validity surface (§55.5 / §55.6) — read-only.
        Validity(of: ValidityOf, prop: SurfaceProp),
        // s454 (U1b) — a CLIENT call of a server function (§12.3 "a client fetch
        // call", §19.9.10): `fn` names a ServerFn, `args` its arguments (encoded
        // by the §57 codec against its parameter types). Legal ONLY as the `on`
        // of a Suspend in client code (check.scrml C-S3): the call is a round
        // trip the client waits on, and its outcome — a value, or a failure of
        // the call's failure enum (§19.9.10) — is inspected by the Attempt that
        // begins the Suspend's `then` (C-S7), never read raw.
        ServerCall(fn: Sym, args: Expr[]),
        // s468 (U1c) — a `?{}` QUERY (§8; U1a's SqlQuery). Legal ONLY as the `on`
        // of a Suspend in a server-side body (check.scrml C-S2 / C-SQL2): a query
        // is a wait (§13.8 item 2 — "a `?{}` query"), and the S467 §13 gate makes
        // every server-side wait a Suspend, so the printer's ONE `await` rule
        // ("await exactly at each Suspend") covers it. Its outcome — the rows, or a
        // `SqlError` failure (§19.8.1) — is inspected by the Attempt that begins
        // the Suspend's `then` (C-S7), never read raw. Its values are `q.params`
        // — Exprs, never text: E-SQL-001 (§8.1) stays unrepresentable.
        Query(q: SqlQuery),
    }
    export type MatchArm:struct = { pat: Pattern, body: Expr }

    // -------------------------------------------------------------------------
    // s451 (Ue) — the error model (SPEC §19). A FAILABLE is something whose
    // result may be a failure (§19.4.2 "a tagged union of the success type and
    // the error type"): a call of a function declared `!` (§19.4), or a `?{}`
    // query (§19.8.3, S451 R11: "a failable expression everywhere"). A
    // failable exists in Core ONLY as the `call` of a Stmt.Attempt — the node
    // that inspects its result with arms total over its error enum — so an
    // unhandled failable is unrepresentable (§19.4.3 "SHALL NOT be ignored"):
    // an Expr.Call never names a function whose `err` is some (check.scrml
    // C-E1) — except as the `on` of a Suspend whose `then` begins with the
    // Attempt that inspects it (C-S7) — and a query (an Expr.Query) stands only
    // as such an `on`.
    //
    // s468 (U1c): a query is no longer a Failable. Ue's `FSql(q)` (an Attempt
    // that ran the query in place) became `Suspend(o, Expr.Query(q), [Attempt(…,
    // FSettled(o), SqlError, …) …])` — the S467 §13 gate: a server-side wait is a
    // Suspend, so "a query not awaited" is unrepresentable, by the same two
    // checks as a client call of a server function (C-S7 + the count of
    // Query-as-`on`). The unhandled query stays unrepresentable: a Query stands
    // only as a Suspend's `on`, and that Suspend's `then` begins with its Attempt.
    // -------------------------------------------------------------------------
    // s454 (U1b) — FSettled: the SETTLED outcome of the enclosing Suspend
    // (`outcome` = that Suspend's `bind`) — a server call's (design §2.1 "Suspend
    // waits, Attempt inspects"), or a waiting client function's that is declared
    // `!`. Only as the call of the Attempt that is the first statement of the
    // Suspend's `then`, and the outcome is read nowhere else (check.scrml C-S7):
    // a raw outcome (a value or a Failure) reaches no other expression.
    export type Failable:enum = {
        FCall(fn: Sym, args: Expr[]),
        FSettled(outcome: Sym),
    }
    // The success branch: the result is bound to `bind`, `body` runs, and
    // `value` is the branch's value (when the Attempt has a `result`).
    export type OkArm:struct = { bind: Sym, body: Block, value: Expr | not }
    // A failure branch: `pat` matches the error value (a variant of the
    // Attempt's `err` enum, or PWild), its payload bound positionally.
    // s452 — `whole`: the local bound to the WHOLE error value (variant and
    // payload) — the whole-error binder `| _ err :>` (SPEC §18.6.1). Only on a
    // PWild arm (check.scrml C-E2): the binder is the wildcard's; a whole-value
    // binder is not a Pattern, because §18's MatchArm shares Pattern and an
    // ordinary `match` arm binds no whole value (§18.6).
    export type ErrArm:struct = { pat: Pattern, body: Block, value: Expr | not, whole: Sym | not }

    // -------------------------------------------------------------------------
    // s451 (U1a) — SQL (SPEC §8, §44). A query is the ONE place SQL lives in
    // Core, and its facts are recorded ONCE, at analysis, from the literal SQL
    // text (a foreign language — never scrml source): what it does (`kind`),
    // which tables it reads and writes, and what it selects. Later passes
    // (READ classification §6.7.7.1, cache invalidation §6.7.7.2, batching
    // §19.9.6) read these facts; nobody rescans SQL. Every fact FAILS CLOSED:
    // a query not provably a pure SELECT is `SqlWrite`; a table set not
    // provably known is `TablesUnknown` (= every table).
    //
    // `chunks` are the literal SQL runs; `slots[i]` is the parameter the i-th
    // `${…}` binds — `chunks.length == slots.length + 1`, every slot indexes
    // `params` (check.scrml C-SQL1). §8.2: "If the same expression appears more
    // than once in a single SQL template, the compiler SHALL assign it a single
    // positional parameter slot" — so `params` holds each DISTINCT expression
    // once (structurally equal Core Exprs are one parameter, evaluated once).
    // `db` names the CoreProgram.dbs entry the query runs on (§8.1.1).
    // `site`: the `?{}` node (its NodeId), for diagnostics and later passes.
    // -------------------------------------------------------------------------
    export type SqlMode:enum = { All, Get, Run }
    export type SqlKind:enum = { SqlSelect, SqlWrite }
    export type SqlTables:enum = { TablesKnown(names: string[]), TablesUnknown }
    // What a query's rows carry: `*` (ColsAll), a list of result names
    // (ColsListed), no rows (ColsNone — a write without RETURNING), or not
    // provable (ColsUnknown). Recorded for column provenance (protect=, later).
    export type SqlColumns:enum = { ColsAll, ColsListed(names: string[]), ColsNone, ColsUnknown }
    export type SqlQuery:struct = {
        db: Sym,
        chunks: string[],
        params: Expr[],
        slots: int[],
        mode: SqlMode,
        kind: SqlKind,
        reads: SqlTables,
        writes: SqlTables,
        columns: SqlColumns,
        nobatch: boolean,
        site: NodeId,
    }

    // s451 (U1a) — a database a program's queries run on (§8.1.1, §44.2):
    // `<program db=…>`. `target` is the connection value with any `sqlite:`
    // prefix removed (a SQLite path, `:memory:`, or the forwarded URL); `file`
    // is the declaring file a relative SQLite path resolves against (§8.1.1
    // "Resolution base"); `owner`: that file declares schema for it — a query
    // in it creates a table (§8.1.1 "Ownership").
    export type Driver:enum = { Sqlite, Postgres, Mysql }
    export type Db:struct = { sym: Sym, driver: Driver, target: string, file: string, owner: boolean }

    // -------------------------------------------------------------------------
    // Statements. `Let` and `Assign` are DIFFERENT nodes (§3.3 — the
    // `const n = n + 1` family is unrepresentable). A cell write is a `Write`
    // naming a WRITE CAPABILITY symbol (`cap`): a field has a capability iff its
    // contract grants some write (Field.wcap). A locked or derived field has no
    // capability symbol, so no Write can name it — see progress.md "grants are
    // symbols".
    // -------------------------------------------------------------------------
    // s444: the SHRINK edits (a Write's value is the COUNT removed, an Int
    // literal, for RemoveEnd / RemoveFront — `pop()` / `shift()` remove 1; the
    // NEW whole value, `SeqCall(Filter, <the field>, λ)`, for RemoveAnywhere —
    // `@x = @x.filter(λ)`), and ElemAt: a write of struct path `path` inside the
    // element at position `index` (`@xs[i].f = v`, dpa-052 Q3 — judged by the
    // ELEMENT field's own contract). In a GrantSet, an element-field grant is
    // listed as `FieldAt(path)` over the element struct (it names no index).
    export type EditKind:enum = {
        Replace,
        Append,
        Prepend,
        Anywhere,
        PositionWrite,
        FieldAt(path: FieldRef[]),
        Transition,
        RemoveEnd,
        RemoveFront,
        RemoveAnywhere,
        ElemAt(index: Expr, path: FieldRef[]),
    }
    // RuntimeEdge: a `rule=` edge whose from-state is not statically known
    // (§6.3). The invariant hook (O36) is deliberately absent until O36 rules.
    export type Check:enum = { Static, RuntimeEdge }

    // Commit: an ALL-OR-NOTHING group of Writes — the spread-override field
    // edit `@x = { ...@x, f: v, g: w }` (§66.11.3 item 1; RULED S440: "Should a
    // spread write be all-or-nothing on a runtime refusal? Yes."). Every
    // Write's contract is checked first; only if every check passes are the
    // Writes applied, in order; on a refusal NONE is applied. Its Writes' values
    // are Locals — the one snapshot, evaluated by the Lets before it (check.scrml
    // C7), so checking and applying never re-evaluate a value.
    // s449 — Suspend: the CPS suspension point (§19.9.8: "the canonical scrml
    // async surface is the body-split / CPS mechanism"; §13.2: the compiler
    // inserts the await). Evaluate `on`; suspend; when it settles with a value,
    // bind it to `bind` and run `then` — unless the effect that owns the
    // suspension was re-run (newest run wins) or torn down meanwhile, in which
    // case `then` never runs. The continuation is EXPLICIT: nothing follows a
    // Suspend in its block (check.scrml C12).
    // s454 (U1b): on the client its `on` is a ServerCall or a call of a waiting
    // client Fn. s468 (U1c, the S467 §13 gate): in a SERVER-side body (a ServerFn,
    // or a Fn only server functions reach — §12.2 Trigger 5) it is THE wait: its
    // `on` is a Query or an in-place Call of a function that waits on the server,
    // and the server printer prints it as `const bind = await on;` followed by
    // `then` — `await` exactly at each Suspend and nowhere else. There is no task
    // on the server (no cell, no batch, nothing to cancel), so nothing is dropped.
    export type Stmt:enum = {
        Let(sym: Sym, init: Expr),
        Assign(local: Sym, value: Expr),
        Write(cap: Sym, inst: InstRef, edit: EditKind, value: Expr, check: Check),
        Commit(writes: Stmt[]),
        If(cond: Expr, thenB: Block, elseB: Block | not),
        Return(e: Expr),
        Eval(e: Expr),
        Suspend(bind: Sym, on: Expr, then: Block),
        // s449 — the surface half of `reset(@x)` (§55.13): it follows the
        // reset's Write of the value. `touched` reverts to false; a validated
        // top-level value's `submitted` reverts too (S447 call 6 (ii)); a child
        // field's compound `submitted` is unchanged (§55.13 row 2). Writes no
        // cell a program can name (the surface is read-only to programs).
        ResetSurface(of: ValidityOf),
        // s451 — `defer` (§19.16): register `body` against the ENCLOSING block;
        // when that block is left — falling off its end, a `return` (after the
        // value is evaluated), or a host error passing through — every body
        // its executed Defers registered runs once, last registered first
        // (§19.16.2). A Defer stands only in a function body, and its body holds
        // no Return / Defer / Suspend (check.scrml C16; §19.16.3 rules 1-2).
        Defer(body: Block),
        // s451 — the storage half of `reset(@x)` on a `persist=` field
        // (§6.14.2 rule 9: the reset "SHALL write the reset value to the cell
        // … and SHALL **remove** the cell's storage key instead of storing
        // that value"). It follows the reset's Write (and its ResetSurface)
        // of that same field: the key is removed and the store the Write
        // queued is cancelled. Writes no cell (check.scrml C17).
        Unpersist(decl: Sym, inst: InstRef, idx: int),
        // s451 (Ue) — run the failable `call`. Success: bind its value to
        // `ok.bind`, run `ok.body`. Failure: run the FIRST arm whose pattern
        // matches the error value (a value of enum `err`), its payload bound.
        // When `result` is some, it is bound to the taken branch's `value`
        // and is in scope after the Attempt. Every handling form lowers to
        // this one node — `!{}` (§19.4.3 item 3), a `match` on the result
        // (§19.7.1; `.Ok` is the success arm), `?` (§19.5.2: one arm per
        // callee variant re-failing as the enclosing enum's same-named
        // variant) and the implicit propagation of a `?{}` in a `!` function
        // (§19.8.2). check.scrml C-E2 / C-E3: the arms are total over `err`;
        // with a `result`, every branch has a value or diverges.
        Attempt(result: Sym | not, call: Failable, err: Sym, ok: OkArm, arms: ErrArm[]),
        // s451 (Ue) — `fail Err.V(args)` (§19.3): return the failure whose
        // error value is variant `idx` of enum `err` built from `args` — "it
        // returns the error variant value to its caller exactly as if a
        // `return` statement had been used" (§19.3.2). The ONLY construction of
        // an error value: no failure value exists in Core outside a Fail.
        // Legal only in a function whose `err` is this enum (check.scrml C-E4).
        Fail(err: Sym, idx: int, args: Expr[]),
        // s454 (U1b) — the if-join continuation (U1 design §1, design §2.2
        // "inside an `If` branch with statements after the `If`"): `body` is the
        // rest of the block after an If one of whose branches suspends; it runs
        // when a branch reaches its Jump(k). Join stands immediately before that
        // If, which is the last statement of its block; every path through the
        // If that does not leave ends in Jump(k) — after the suspension, inside
        // the Suspend's `then` (check.scrml C12).
        Join(k: Sym, body: Block),
        Jump(k: Sym),
        // s469 — the ONE loop (§49, "one `for`"). `label` is a binder-minted
        // Sym naming THIS loop; a Break / Continue names the loop it leaves /
        // re-enters by it, and stands only inside that loop's body, in the same
        // owner (check.scrml C19 — §49.4.3: no crossing a function boundary).
        // Every head binds per iteration (§49.3.7). A loop body holds no
        // Suspend and no Defer (C19: the CPS split and the deferred exit do not
        // reach loops yet).
        Loop(label: Sym, head: LoopHead, body: Block),
        Break(target: Sym),
        Continue(target: Sym),
    }
    export type Block:struct = { stmts: Stmt[] }

    // s469 — a loop head (§49.2.4, §49.3):
    //   Forever       `for { … }` / `for (;;)` — until a Break / Return / Fail
    //   While(cond)   `for (cond)` — `cond` before each iteration
    //   Counted       `for (init; cond; step)` — `init` once (Lets, or Assigns of
    //                 outer locals; C19), `cond` (`not`: true) before each
    //                 iteration, `step` (Assigns only) after each and on Continue
    //   Each          `for (x of xs)` — the iterable evaluated once; `bind` each
    //                 element in position order (a string: each code point)
    //   Range         `for (i of lo..hi)` / `lo..=hi` — the bounds evaluated
    //                 once, `lo` first, `hi` into `end`; `bind` (an int) runs
    //                 lo, lo + 1, … up to `end` (excluded, unless `inclusive`).
    //                 `counter`: the loop's own count when `bind` is a `let` the
    //                 body may rebind (§49.3.5: "writing it changes the binder,
    //                 never the iterable"); `not` when `bind` is the count.
    export type EachHead:struct = { bind: Sym, src: Expr }
    export type RangeHead:struct = { bind: Sym, counter: Sym | not, end: Sym, lo: Expr, hi: Expr, inclusive: boolean }
    export type LoopHead:enum = {
        Forever,
        While(cond: Expr),
        Counted(init: Stmt[], cond: Expr | not, step: Stmt[]),
        Each(h: EachHead),
        Range(h: RangeHead),
    }

    // -------------------------------------------------------------------------
    // Views. Every child position is a View LIST (no Fragment variant).
    // Events are attributes of their element (§3.2 had View.On).
    // -------------------------------------------------------------------------
    // s444 — a two-way bind (§5.4): `read` is shown in the element's `value`
    // / `checked` property; on the element's input / change event its property
    // value is bound to `sink` (a binder-minted local) and `write` runs — ONE
    // capability-checked Write of `Local(sink)` to the place `read` reads
    // (check.scrml C8). The event-value round trip, with no expression text.
    export type BindKind:enum = { Value, Checked }

    export type Attr:enum = {
        Static(name: string, value: string),
        Bound(name: string, e: Expr),
        // s451 — `show=` (§17.2): "The element EXISTS in the DOM regardless of
        // `expr`. When `expr` evaluates to false, the element is hidden. The
        // compiler generates a CSS `display: none` toggle." While `test` is
        // false the element's inline `display` is `none`; while true it is the
        // element's own (its static `style`'s `display`, else none set).
        Show(test: Expr),
        On(event: string, body: Block),
        Bind(kind: BindKind, read: Expr, sink: Sym, write: Block),
        // s449 — the form's submit listener for the §55 surface, on every
        // `<form>` whose composed subtree (§55.17.2 rule 1) binds a field that
        // has a surface. It runs BEFORE any author handler and synchronously.
        //  - It sets `submitted` (§55.7: "the first submit of a `<form>` that
        //    binds the value — for a compound, a form that binds any of its
        //    fields") on every bound value with a surface.
        //  - When `values` is non-empty the form is GATED (§55.17.3): it also
        //    marks `touched` on every bound validated value and, if any is
        //    invalid, cancels the submission and runs no author handler; a
        //    `formnovalidate` submitter bypasses the touch and the block
        //    (§55.17.4). `values` names the gating values in source order (a
        //    top-level value by its name, a child field by `decl.field`) — the
        //    `data-scrml-gated` marker (§55.17.6).
        // `fields` are the bound surfaced fields the composed subtree NAMES —
        // through the form's own markup, `if=` / state-view arms (mounted or
        // not: §55.17.3 reach is the static subtree), slot content written
        // here and `<*x/>` Stars. A field the subtree cannot name statically
        // (an instance a use, an `<each>` row or a slot creates) is found on
        // the live form, through the control that binds it.
        Gate(values: string[], fields: ValidityOf[]),
    }
    export type ConstructAttr:struct = { field: int, value: Expr }
    export type CondArm:struct = { test: Expr, body: View[] }

    // s449 — one `deps=` entry of an `<effect>` (§6.7.4: `'@' identifier`): ONE
    // cell, field `idx` of `decl` through `inst`. A whole instance, a member
    // path or a computed value is unrepresentable here; that the field is a
    // MUTABLE cell (has a write capability) is check.scrml C11.
    export type EffectDep:struct = { decl: Sym, inst: InstRef, idx: int }

    export type View:enum = {
        El(tag: string, attrs: Attr[], kids: View[]),
        Text(text: string),
        // s468 — the text of a `<pre>` / `<code>` raw-content body (SPEC §4.17):
        // DISPLAY text written with `<` and `>` encoded and `&` NOT encoded ("An
        // author entity … still decodes at render time and displays as the
        // character it names; an entity never builds an element"). Never markup:
        // the printer has no path that writes it unencoded.
        RawText(text: string),
        Dyn(e: Expr),
        Cond(arms: CondArm[]),
        Each(src: Expr, bind: Sym, key: Expr | not, handles: Sym[], row: View[]),
        Instance(decl: Sym, attrs: ConstructAttr[], slot: View[], alias: Sym | not),
        Slot,
        // s444 — `<*x/>` (§66.6.2): the EXISTING instance `inst` of `decl`,
        // rendered with decl's renders; constructs nothing (M1 D4 closed).
        Star(decl: Sym, inst: InstRef),
        // s449 — `<effect deps=[…]>${ body }</>` (§6.7.4): a reactive effect on
        // the outside world, OWNED BY THE SCOPE THIS VIEW LIST RENDERS INTO (a
        // declaration's render, a Cond arm, an Each row — its position in the
        // tree) and unregistered when that scope is destroyed (teardown step
        // 1). It renders no DOM. It runs `body` when a listed cell changes,
        // never on mount; unlisted reads are not triggers. The body writes no
        // reactive cell, directly or through a called function (check.scrml
        // C11). Nesting is unrepresentable (a body is a Block; no Stmt holds a
        // View).
        Effect(deps: EffectDep[], body: Block),
        // s449 — `reset-on=[@a, @b]` on a program cell (§6.8.4): when any
        // `triggers` cell changes, run `reset` — exactly ONE Write of the cell's
        // reset value to the cell (its initializer; a transition for a cell with
        // a `rule=` graph) — in the SAME flush as the triggering write, before
        // any render or effect reads the cell. `rank` is the cell's depth in the
        // static reset-on graph (0 = no trigger is itself reset); a chain applies
        // in rank order, so a reset chain is one change for every dependent. The
        // graph is acyclic by construction (E-RESET-ON-CYCLE), so a chain
        // terminates without any runtime bound. Registered with the program's
        // scope; renders no DOM.
        ResetOn(triggers: EffectDep[], reset: Block, rank: int),
        // s449 — `<errors of=expr/>` (§55.8): the errors of the surface `of`,
        // each rendered as `<p class="scrml-error">message</p>` (the first
        // only, or all when `all`); when there are none it renders NO DOM.
        // The message is the §55.10 Level-3 English default for the
        // ValidationError tag and the field's name.
        Errors(of: ValidityOf, all: boolean),
    }

    // -------------------------------------------------------------------------
    // Declarations (§5). The program is itself a `single` declaration (R4):
    // top-level cells are its fields; its `renders` is the page view.
    // -------------------------------------------------------------------------
    export type FieldMode:enum = { Locked, Let, Derived, Seeded }
    // Attribute = constructible at a use site (§66.14 rule 4); Child = a child
    // declaration (use-site value setting is O43, not ruled).
    export type FieldRole:enum = { Attribute, Child }

    // A resolved grant set: `replace` (from `let`, §66.9) plus the non-replace
    // edits the field's type/contract grants (sequence axes, a transition graph).
    export type GrantSet:struct = { replace: boolean, edits: EditKind[] }

    // A `rule=` graph over an enum's variants, by variant index (§66.13.2).
    export type Edge:struct = { origin: int, targets: int[] }
    export type TransitionGraph:struct = { enumSym: Sym, edges: Edge[] }

    // s451 — `persist="local" | "session"` + `key=` (§6.14): browser
    // persistence is a LIFETIME property of a client-owned cell (§6.14 — not a
    // §52 authority value). `Local` = Web localStorage (restored, written on
    // change, synced across tabs — §6.14.2 rules 1-5), `Session` = Web
    // sessionStorage (no cross-tab sync, rule 5). `key` is the author's
    // external storage contract (§6.14.1 rule 2 — never derived). The value is
    // encoded / decoded with the §57 codec against the field's type (codec.scrml).
    export type PersistStore:enum = { Local, Session }
    export type Persist:struct = { store: PersistStore, key: string }

    // `init` is `not` for an attribute declared without a default (O33).
    export type Field:struct = {
        sym: Sym,
        ty: Type,
        init: Expr | not,
        mode: FieldMode,
        role: FieldRole,
        grants: GrantSet,
        graph: TransitionGraph | not,
        exported: boolean,
        wcap: Sym | not,
        // s449: the validators the field carries (§55.1), in declaration order.
        vals: Validator[],
        // s451: its browser persistence (§6.14) — only on a field of the
        // PROGRAM that has a write capability (check.scrml C17).
        persist: Persist | not,
    }

    export type DeclKind:enum = { Program, User, Predefined }
    // O8 (ruled): a function-typed attribute is wiring, not a field.
    export type WiringAttr:struct = { sym: Sym, ty: Type }

    // `handles` = the `as=` aliases whose cells live on THIS declaration's
    // instances (aliases inside an `<each>` row live on the row: Each.handles).
    export type Decl:struct = {
        sym: Sym,
        kind: DeclKind,
        single: boolean,
        fields: Field[],
        renders: View[] | not,
        wiring: WiringAttr[],
        handles: Sym[],
    }

    export type Param:struct    = { sym: Sym, ty: Type }
    // s451 (Ue): `err` — the error enum of a function declared `!` (§19.4: the
    // declared `! E`, or the built-in `Error` for a bare `!`); `not` for a
    // function that cannot fail. A call of a function with an `err` exists only
    // as an Attempt's call (check.scrml C-E1); a Fail only in its body (C-E4).
    // s454 (U1b): `waits` — the function is ASYNC-COLOURED on the client (§13.2:
    // it calls, directly or transitively, a server function): its body holds a
    // Suspend at some depth (check.scrml C-S8), so a call of it is itself a
    // suspension point (a caller's Suspend `on: Call(fn, …)`). Attached by
    // lower from the effect summary's `waits` (design §2.5); check re-verifies.
    export type Fn:struct       = { sym: Sym, params: Param[], body: Block, pure: boolean, err: Sym | not, waits: boolean }
    // s451 (U1a): a function route inference placed on the SERVER (§12.2) — its
    // body holds the program's SQL and no client state (check.scrml C-S1/C-S2);
    // `ret` is its declared return type (`not`: none written). Placement lives
    // in the SHAPE of Core — a ServerFn, not a Fn with a flag — so no later pass
    // re-derives it. `err`: as Fn's (Ue).
    // s468 (U1c) — `waits`: the S467 §13 gate's Core fact. The function WAITS on
    // the server iff its body holds a Suspend (a Query, or an in-place call of a
    // function that waits) — check.scrml C-S8s re-verifies it against the body,
    // and a call of a waiting ServerFn stands only as a Suspend's `on`. The
    // server printer prints `async function` iff `waits` (Fn.waits likewise for
    // a server-only Fn). Attached by lower from the effect summary's `swaits`.
    export type ServerFn:struct = { sym: Sym, params: Param[], ret: Type | not, body: Block, err: Sym | not, waits: boolean }

    // One CoreProgram per linked program (a library's declarations appear in
    // the consumer's Core). `program` names the program declaration.
    // s451 (U1a): `dbs` — the databases its queries run on (SqlQuery.db).
    export type CoreProgram:struct = {
        program: Sym,
        decls: Decl[],
        types: TypeDef[],
        fns: Fn[],
        server: ServerFn[],
        dbs: Db[],
        // s451 — §65.3.4: the built-in reset layer ships unless the top-level
        // program opts out with `<program reset="none">`.
        reset: boolean,
        // s451 (Ue): the built-in `SqlError` enum (§19.8.1) — the error type
        // of every query (the Attempt over a Query's settled outcome); `not` when the program has none.
        sqlError: Sym | not,
        // s454 (U1b): the built-in `ServerCallError` enum (§19.9.10) — the
        // payload of every client call's `Transport` variant; `not` when no
        // client call is made.
        serverCallError: Sym | not,
        // s469 (s469-boot-css): the program's author stylesheet (its `#{}`
        // blocks, §9.1 / §65) and the §25.7 CSS-variable bridges it reads;
        // `not` when the program writes no author CSS (the reset alone is
        // `reset` above). The sheet's own `reset` agrees with `reset`.
        css: CoreCss | not,
    }

    // s469 — §25.7: a `@name` of a program cell in a `#{}` value is
    // `var(--scrml-<name>)`; at run time the cell's value is written to that
    // custom property on `:root`, now and on every change, through the
    // runtime's value guard (only a safe CSS value is ever written — the CSS
    // injection boundary). `read` reads the cell (the shared program instance).
    export type CssVar:struct = { cell: Sym, read: Expr }
    export type CoreCss:struct = { sheet: CssUnit, vars: CssVar[] }

    // -------------------------------------------------------------------------
    // Constructors — pure shorthands used by the hand-built Core oracles and
    // (in M2) by `lower`. Qualified variant construction resolves in every
    // position under impl#1; these exist for readability, not as a workaround.
    // -------------------------------------------------------------------------
    export fn mkSym(id: int, hint: string) -> Sym { return { id: id, hint: hint } }

    export fn block(stmts: Stmt[]) -> Block { return { stmts: stmts } }
    export fn noGrants() -> GrantSet { return { replace: false, edits: [] } }
    export fn replaceGrant() -> GrantSet { return { replace: true, edits: [] } }

    export fn litInt(v: int) -> Expr { return Expr.Lit(Literal.Int(v)) }
    export fn litStr(v: string) -> Expr { return Expr.Lit(Literal.Str(v)) }
    export fn litBool(v: boolean) -> Expr { return Expr.Lit(Literal.Bool(v)) }
    export fn litVariant(enumSym: Sym, idx: int) -> Expr { return Expr.Lit(Literal.Variant(enumSym, idx)) }

    export fn fref(owner: Sym, idx: int) -> FieldRef { return { owner: owner, idx: idx } }

    // A read of field `idx` of declaration `decl` through `inst`.
    export fn readField(decl: Sym, inst: InstRef, idx: int) -> Expr {
        return Expr.Read(Place.Cell(decl, inst, [fref(decl, idx)]))
    }

    // A read of struct field `idx` (of struct type `owner`) of a local.
    export fn readLocalField(local: Sym, owner: Sym, idx: int) -> Expr {
        return Expr.Read(Place.LocalPath(local, [fref(owner, idx)]))
    }

    export fn prim2(op: PrimOp, a: Expr, b: Expr) -> Expr { return Expr.Prim(op, [a, b]) }
    export fn prim1(op: PrimOp, a: Expr) -> Expr { return Expr.Prim(op, [a]) }
    export fn call0(callee: Sym) -> Expr { return Expr.Call(callee, []) }

    export fn el(tag: string, attrs: Attr[], kids: View[]) -> View { return View.El(tag, attrs, kids) }
    export fn textView(t: string) -> View { return View.Text(t) }
    export fn dyn(e: Expr) -> View { return View.Dyn(e) }
    export fn staticAttr(name: string, value: string) -> Attr { return Attr.Static(name, value) }
    export fn onEvent(event: string, stmts: Stmt[]) -> Attr { return Attr.On(event, block(stmts)) }
    export fn construct(field: int, value: Expr) -> ConstructAttr { return { field: field, value: value } }

    // -------------------------------------------------------------------------
    // Lookups — pure, derived from the program (never hand-kept lists).
    // -------------------------------------------------------------------------
    export fn sameSym(a: Sym, b: Sym) -> boolean { return a.id == b.id }

    export fn findDecl(p: CoreProgram, s: Sym) -> Decl | not {
        for (const d of p.decls) {
            if (d.sym.id == s.id) return d
        }
        return not
    }

    export fn findTypeDef(p: CoreProgram, s: Sym) -> TypeDef | not {
        for (const t of p.types) {
            if (typeDefSym(t).id == s.id) return t
        }
        return not
    }

    export fn typeDefSym(t: TypeDef) -> Sym {
        return match t {
            .EnumDef(sym: s, variants: vs)  :> s
            .StructDef(sym: s, fields: fs)  :> s
        }
    }

    export fn findFn(p: CoreProgram, s: Sym) -> Fn | not {
        for (const f of p.fns) {
            if (f.sym.id == s.id) return f
        }
        return not
    }

    // s451 (U1a)
    export fn findServerFn(p: CoreProgram, s: Sym) -> ServerFn | not {
        for (const f of p.server) {
            if (f.sym.id == s.id) return f
        }
        return not
    }

    export fn findDb(p: CoreProgram, s: Sym) -> Db | not {
        for (const d of p.dbs) {
            if (d.sym.id == s.id) return d
        }
        return not
    }

    // The declaration + field index a write capability belongs to.
    export type CapOwner:struct = { decl: Decl, idx: int }

    export fn capOwner(p: CoreProgram, cap: Sym) -> CapOwner | not {
        for (const d of p.decls) {
            let i = 0
            for (const f of d.fields) {
                const w: Sym | not = f.wcap
                if (w is given) {
                    if (w.id == cap.id) return { decl: d, idx: i }
                }
                i = i + 1
            }
        }
        return not
    }

    // s449 — the declaration and instance reference a surface is reached through.
    export fn validityDecl(v: ValidityOf) -> Sym {
        return match v {
            .OfField(decl: d, inst: i, idx: x) :> d
            .OfDecl(decl: d, inst: i) :> d
        }
    }
    export fn validityInst(v: ValidityOf) -> InstRef {
        return match v {
            .OfField(decl: d, inst: i, idx: x) :> i
            .OfDecl(decl: d, inst: i) :> i
        }
    }

    // Does a field's contract grant ANY write? (the wcap invariant, §66.11.1)
    export fn grantsAnyWrite(f: Field) -> boolean {
        if (f.grants.replace) return true
        return f.grants.edits.length > 0
    }

    // -------------------------------------------------------------------------
    // CSS (s440-bootstrap-css-theme-t3; dpa-051 §8.4 step 1). The per-file
    // STYLESHEET Core — a root of its own, NOT a CoreProgram field: FileOutput.css
    // is an independent sub-seam (dpa-051 §8.4), so the stylesheet pass (css.scrml)
    // consumes only this. Its strings are CSS-language LITERALS (a selector's
    // names, an attribute test, a declaration's literal text) or identifiers;
    // every `@` reference is a node (TokenVar / CellVar), never text the emitter
    // re-reads (§3.6, §4).
    // -------------------------------------------------------------------------
    export type SimpleSel:enum = {
        Universal,
        TagSel(name: string),
        ClassSel(name: string),
        IdSel(name: string),
        AttrSel(test: string),                        // the text between `[` and `]`
        PseudoClass(name: string, arg: string | not), // `:hover`, `:not(.a)` (arg = `.a`)
        PseudoElement(name: string),                  // `::before`
    }
    export type Combinator:enum = { Descendant, DirectChild, NextSibling, LaterSibling }
    export type Compound:struct = { parts: SimpleSel[] }
    export type SelLink:struct = { comb: Combinator, target: Compound }
    // One arm of a selector list: `head (combinator compound)*`.
    export type ComplexSel:struct = { head: Compound, links: SelLink[] }

    // A declaration value: literal CSS text, with the `@` references resolved.
    export type CssPart:enum = {
        CssText(text: string),
        TokenVar(token: Sym),   // §65.3.2 / §25.7: `@name` of a theme token → var(--name)
        CellVar(cell: Sym),     // §25.7: `@name` of a reactive cell → var(--scrml-name)
    }
    export type CssDecl:struct = { prop: string, value: CssPart[] }
    export type StyleRule:struct = { sel: ComplexSel[], decls: CssDecl[] }

    // §66.17 (T3) — a theme token is a LOCKED declaration (`<theme>` is a marker).
    // Its initializer decides its CSS:
    //   Constant     — a literal (item 2) → static `:root { --t: v }`.
    //   OnVariant    — a `match` over an enum-typed cell, every arm a constant
    //                  (item 3, RECOGNIZED) → one `:root[data-scrml-theme-<cell>="<V>"]`
    //                  block per arm; `otherwise` = a wildcard arm (→ `:root`).
    //   ScriptWrites — a `match` over an enum cell NOT recognized (item 7) → per-token
    //                  `:root` writes from script; NO stylesheet contribution.
    // A reactive token of any other shape is O47 (OPEN) and has no variant here:
    // the producer reports it not-yet.
    export type TokenArm:struct = { variant: string, value: CssPart[] }
    export type TokenInit:enum = {
        Constant(value: CssPart[]),
        OnVariant(cell: Sym, arms: TokenArm[], otherwise: CssPart[] | not),
        ScriptWrites(cell: Sym),
    }
    export type ThemeToken:struct = { sym: Sym, init: TokenInit }

    export type CssImport:struct = { url: string, conditions: string }
    export type ScopeSheet:struct = { component: string, rules: StyleRule[] }

    // One file's stylesheet. `reset` = the §65.3.4 built-in reset is on (opt out:
    // `<program reset="none">`). `global` = program-level `#{}` rules (§9.1, the
    // §65.5 `global` layer); `scopes` = component-scope `#{}` rules (§9.1 DQ-7).
    export type CssUnit:struct = {
        charsets: string[],
        imports: CssImport[],
        reset: boolean,
        tokens: ThemeToken[],
        global: StyleRule[],
        scopes: ScopeSheet[],
    }
}
