// =============================================================================
// self-host-v2 / print-server.scrml — the SERVER artifact printer (unit U1c).
//
// Design authority: scrml-support/docs/deep-dives/bootstrap-u1-server-boundary-
// design-2026-10-03.md §4 ("Server artifact = a factory, not a module with
// globals"), §2 ("Trigger 5 is emission, not inference"), §5 ("Lower (U1c)")
// and the BINDING §13 amendment (S467) "U1c gate: the server half awaits by
// construction". The wire contract is the U1b design's Item 3; its client half
// is print.scrml's `route$<fn>` constants + runtime.js `call`.
//
// What it prints, from Core and nothing else:
//
//   import * as rt from "./scrml-server-runtime.js";
//   export const manifest = { routes: [ { fn, path, value }, … ] };
//   const route$f = { path, params, result, error };   // print.scrml routeJs — the SAME tables the client uses
//   const sql$12 = rt.sqlText(["SELECT … WHERE id = ", ""]);   // a query site's literal runs, frozen at load
//   export function createServer(host$) {
//     const db$7 = rt.connection(host$, { driver, target, file });   // one per database, injected by the host
//     async function f(…) { … const o = await rt.query(db$7, "get", sql$12, [v0], [0]); … }
//     function helper(…) { … }
//     return rt.server(host$, [ rt.route(route$f, (args$) => f(args$[0], …)) ]);
//   }
//
// - ROUTED IFF REACHED FROM A CLIENT ROOT (design §4): one route per server
//   function a ServerCall names — the client artifact's own manifest
//   (print.scrml `calledServerFns`); the path is minted from the Sym, never the
//   name (§12.3).
// - TRIGGER 5 IS EMISSION (design §2): the artifact holds the transitive
//   closure, over Core Call Syms, of every routed server function — the server
//   functions it calls in place (§13.4: no extra route), the server-only
//   helpers (Trigger 5) and the ambient functions it reaches. An ambient
//   function the client also calls is printed in BOTH artifacts (§13.4 "TWO
//   representations"); one only the server reaches is in this one only.
// - THE §13 GATE: this printer decides nothing about waiting. A function is
//   `async` iff Core says it waits (Fn.waits / ServerFn.waits — check.scrml
//   C-S8 / C-S8s: the body holds a Suspend), and `await` is printed at a
//   Suspend and NOWHERE ELSE (print.scrml server mode). A call of a waiting
//   function stands only as a Suspend's `on` (C-S8 / C-S8s), so a waiting call
//   left unawaited is not a program this printer can be handed by a checked Core.
// - Nothing client-side is here: no cell, no view, no handler. check.scrml
//   C-S1 keeps every server-reached body free of client state; a ServerCall
//   reaching this printer (only a Core that checkCore rejects holds one there)
//   is REFUSED, never printed.
//
// impl#1 workaround: F11 — every `match` on a payload variant uses NAMED
// binding (positional binding over an imported enum is silently dropped).
// =============================================================================
${
    import { Sym, Expr, Stmt, Failable, Fn, ServerFn, CoreProgram, Db, Driver, SqlQuery, Param,
             findFn, findServerFn, findDb } from "./core.scrml"
    import { Node, allNodes } from "./walk.scrml"
    import { JsExpr, JsStmt, JsProp, jid, jstr, jnum, jcall, jmember, printModule } from "./js.scrml"
    import { RouteOut, Ctx, serverCtx, serverFnJs, symNameOf, routeJs, routeName, routePath, calledServerFns,
             sqlTextName, dbVarName } from "./print.scrml"

    export type ServerOutput:struct = { js: string, refused: string[], routes: RouteOut[] }

    // The server artifact of `p`. `js` is "" when the program routes nothing (it
    // has no server half to serve); `refused` names anything this printer will
    // not print (fail closed — nothing is printed then).
    export fn printServer(p: CoreProgram, jsFile: string, runtimeFile: string) -> ServerOutput {
        const refused: string[] = serverPrintRefusal(p)
        if (refused.length > 0) return { js: "", refused: refused, routes: [] }
        const routed: ServerFn[] = calledServerFns(p)
        if (routed.length == 0) return { js: "", refused: [], routes: [] }
        const ctx: Ctx = serverCtx(p)
        const reach: int[] = serverReach(p, routed)

        let body: JsStmt[] = [
            JsStmt.SComment(jsFile + " — generated by the scrml bootstrap printer (self-host-v2, unit U1c). Do not edit."),
            JsStmt.SImportAll("rt", "./" + runtimeFile),
            JsStmt.SBlank,
        ]
        // the manifest — the routes, by the scrml-source function name (the harness and
        // the client's own `Output.routes` key on it; the path is compiler-internal)
        let routes: RouteOut[] = []
        let manifest: JsExpr[] = []
        for (const sf of routed) {
            const r: RouteOut = { fn: sf.sym.hint, path: routePath(sf.sym), value: sf.ret is given }
            routes = routes.concat([r])
            manifest = manifest.concat([JsExpr.JObject([
                { key: "fn", value: jstr(r.fn) }, { key: "path", value: jstr(r.path) }, { key: "value", value: JsExpr.JBool(r.value) },
            ])])
        }
        body = body.concat([
            JsStmt.SComment("the routes this server answers — one per server function the client calls (paths are compiler-internal, §12.3)"),
            JsStmt.SExportConst("manifest", JsExpr.JObject([{ key: "routes", value: JsExpr.JArray(manifest) }])),
            JsStmt.SBlank,
            JsStmt.SComment("each route's wire contract — the same §57 tables the client artifact encodes and decodes with"),
        ])
        for (const sf of routed) { body = body.concat([routeJs(p, sf)]) }

        // the SQL text of every query site the server reaches, frozen once at load (§8.1:
        // a query's text is the literal runs only; every value is a bound parameter)
        const queries: SqlQuery[] = queriesIn(p, reach)
        if (queries.length > 0) body = body.concat([JsStmt.SBlank, JsStmt.SComment("query text (literal runs only — every value is a bound parameter, §8.1)")])
        for (const q of queries) {
            let runs: JsExpr[] = []
            for (const c of q.chunks) { runs = runs.concat([jstr(c)]) }
            body = body.concat([JsStmt.SConst(sqlTextName(q.site.n), jcall(jmember(jid("rt"), "sqlText"), [JsExpr.JArray(runs)]))])
        }

        // createServer(host$): the databases, the functions, the routes
        let inner: JsStmt[] = []
        for (const d of dbsOf(p, queries)) {
            inner = inner.concat([JsStmt.SConst(dbVarName(d.sym), jcall(jmember(jid("rt"), "connection"), [jid("host$"), dbJs(d)]))])
        }
        for (const sf of p.server) {
            if (reach.indexOf(sf.sym.id) >= 0) inner = inner.concat([serverFnJs(ctx, sf.sym, sf.params, sf.body, sf.waits)])
        }
        for (const f of p.fns) {
            if (reach.indexOf(f.sym.id) >= 0) inner = inner.concat([serverFnJs(ctx, f.sym, f.params, f.body, f.waits)])
        }
        let routeExprs: JsExpr[] = []
        for (const sf of routed) { routeExprs = routeExprs.concat([routeEntry(ctx, sf)]) }
        inner = inner.concat([JsStmt.SReturn(jcall(jmember(jid("rt"), "server"), [jid("host$"), JsExpr.JArray(routeExprs)]))])
        body = body.concat([
            JsStmt.SBlank,
            JsStmt.SComment("createServer(host$) — host$.connect(desc) supplies each database's driver (Bun.SQL by default); host$.log the server log"),
            JsStmt.SExportFunc("createServer", ["host$"], inner),
        ])
        return { js: printModule(body), refused: [], routes: routes }
    }

    // `rt.route(route$f, (args$) => f(args$[0], args$[1]))` — the arguments arrive
    // decoded (strictly, against route$f.params) in parameter order.
    fn routeEntry(ctx: Ctx, sf: ServerFn) -> JsExpr {
        let args: JsExpr[] = []
        let i: int = 0
        for (const prm of sf.params) {
            args = args.concat([JsExpr.JIndex(jid("args$"), jnum(i))])
            i = i + 1
        }
        const call: JsExpr = jcall(jid(symNameOf(ctx, sf.sym)), args)
        return jcall(jmember(jid("rt"), "route"), [jid(routeName(sf.sym)), JsExpr.JArrowE(["args$"], call)])
    }

    // `{ driver: "sqlite", target: "./app.db", file: "app.scrml" }` — §8.1.1 / §44.2.
    fn dbJs(d: Db) -> JsExpr {
        return JsExpr.JObject([
            { key: "driver", value: jstr(driverName(d.driver)) },
            { key: "target", value: jstr(d.target) },
            { key: "file", value: jstr(d.file) },
        ])
    }

    fn driverName(d: Driver) -> string {
        return match d {
            .Sqlite :> "sqlite"
            .Postgres :> "postgres"
            .Mysql :> "mysql"
        }
    }

    // ---- reach: the functions the server artifact holds ------------------------
    // The routed server functions and everything they call, transitively (Fns and
    // ServerFns by Sym — a Call's callee, an Attempt's FCall).
    fn serverReach(p: CoreProgram, routed: ServerFn[]) -> int[] {
        let out: int[] = []
        let todo: int[] = []
        for (const sf of routed) {
            out = out.concat([sf.sym.id])
            todo = todo.concat([sf.sym.id])
        }
        while (todo.length > 0) {
            const id: int = todo[0]
            todo = todo.slice(1)
            for (const c of calleesOf(p, id)) {
                if (out.indexOf(c) < 0) {
                    out = out.concat([c])
                    todo = todo.concat([c])
                }
            }
        }
        return out
    }

    fn calleesOf(p: CoreProgram, id: int) -> int[] {
        let ns: Node[] = []
        for (const sf of p.server) { if (sf.sym.id == id) ns = allNodes(Node.NServerFn(sf)) }
        for (const f of p.fns) { if (f.sym.id == id) ns = allNodes(Node.NFn(f)) }
        let out: int[] = []
        for (const n of ns) {
            const c: Sym | not = nodeCallee(n)
            if (c is given) {
                if (findFn(p, c) is given || findServerFn(p, c) is given) out = out.concat([c.id])
            }
        }
        return out
    }

    fn nodeCallee(n: Node) -> Sym | not {
        return match n {
            .NExpr(e: e) :> exprCallee(e)
            .NStmt(s: s) :> stmtCallee(s)
            .NProgram(p: x) :> not
            .NDecl(d: x) :> not
            .NField(f: x) :> not
            .NFn(f: x) :> not
            .NServerFn(f: x) :> not
            .NBlock(b: x) :> not
            .NPlace(pl: x) :> not
            .NInst(i: x) :> not
            .NPattern(pat: x) :> not
            .NEdit(k: x) :> not
            .NView(v: x) :> not
            .NAttr(a: x) :> not
        }
    }

    fn exprCallee(e: Expr) -> Sym | not {
        return match e {
            .Call(callee: f) :> f
            .ServerCall(fn: x) :> not
            .Lit(lit: x) :> not
            .Local(sym: x) :> not
            .Read(place: x) :> not
            .Prim(op: x) :> not
            .Match(scrut: x) :> not
            .ArrayOf(elems: x) :> not
            .StructOf(ty: x) :> not
            .Handle(inst: x) :> not
            .InitOf(decl: x) :> not
            .Host(call: x) :> not
            .Lambda(params: x) :> not
            .SeqCall(op: x) :> not
            .Validity(of: x) :> not
            .Query(q: x) :> not
        }
    }

    fn stmtCallee(s: Stmt) -> Sym | not {
        return match s {
            .Attempt(call: c) :> failableCallee(c)
            .Let(sym: x) :> not
            .Assign(local: x) :> not
            .Write(cap: x) :> not
            .Commit(writes: x) :> not
            .If(cond: x) :> not
            .Return(e: x) :> not
            .Eval(e: x) :> not
            .Suspend(bind: x) :> not
            .ResetSurface(of: x) :> not
            .Defer(body: x) :> not
            .Unpersist(decl: x) :> not
            .Fail(err: x) :> not
            .Join(k: x) :> not
            .Jump(k: x) :> not
        }
    }

    fn failableCallee(c: Failable) -> Sym | not {
        return match c {
            .FCall(fn: f) :> f
            .FSettled(outcome: x) :> not
        }
    }

    // ---- queries and databases -------------------------------------------------
    // Every query the reached functions hold, in program order, each site once.
    fn queriesIn(p: CoreProgram, reach: int[]) -> SqlQuery[] {
        let roots: Node[] = []
        for (const sf of p.server) { if (reach.indexOf(sf.sym.id) >= 0) roots = roots.concat([Node.NServerFn(sf)]) }
        for (const f of p.fns) { if (reach.indexOf(f.sym.id) >= 0) roots = roots.concat([Node.NFn(f)]) }
        let out: SqlQuery[] = []
        let seen: int[] = []
        for (const r of roots) {
            for (const n of allNodes(r)) {
                const q: SqlQuery | not = nodeQuery(n)
                if (q is given) {
                    if (seen.indexOf(q.site.n) < 0) {
                        seen = seen.concat([q.site.n])
                        out = out.concat([q])
                    }
                }
            }
        }
        return out
    }

    fn nodeQuery(n: Node) -> SqlQuery | not {
        return match n {
            .NExpr(e: e) :> exprQuery(e)
            .NStmt(s: x) :> not
            .NProgram(p: x) :> not
            .NDecl(d: x) :> not
            .NField(f: x) :> not
            .NFn(f: x) :> not
            .NServerFn(f: x) :> not
            .NBlock(b: x) :> not
            .NPlace(pl: x) :> not
            .NInst(i: x) :> not
            .NPattern(pat: x) :> not
            .NEdit(k: x) :> not
            .NView(v: x) :> not
            .NAttr(a: x) :> not
        }
    }

    fn exprQuery(e: Expr) -> SqlQuery | not {
        return match e {
            .Query(q: q) :> q
            .Lit(lit: x) :> not
            .Local(sym: x) :> not
            .Read(place: x) :> not
            .Call(callee: x) :> not
            .Prim(op: x) :> not
            .Match(scrut: x) :> not
            .ArrayOf(elems: x) :> not
            .StructOf(ty: x) :> not
            .Handle(inst: x) :> not
            .InitOf(decl: x) :> not
            .Host(call: x) :> not
            .Lambda(params: x) :> not
            .SeqCall(op: x) :> not
            .Validity(of: x) :> not
            .ServerCall(fn: x) :> not
        }
    }

    // The databases those queries run on, in program order (C-SQL1: every query's
    // `db` is one of the program's).
    fn dbsOf(p: CoreProgram, qs: SqlQuery[]) -> Db[] {
        let out: Db[] = []
        for (const d of p.dbs) {
            let used = false
            for (const q of qs) { if (q.db.id == d.sym.id) used = true }
            if (used) out = out.concat([d])
        }
        return out
    }

    // ---- fail closed -----------------------------------------------------------
    // A client call of a server function inside a server-placed body. Core that
    // checkCore accepts never holds one (C-S1: a ServerFn makes no client call;
    // C-S3: no client root reaches a server-only Fn), but this printer is
    // fail-closed on its own: such a body would print a client fetch on the server.
    fn serverPrintRefusal(p: CoreProgram) -> string[] {
        let out: string[] = []
        for (const s of p.server) {
            for (const n of allNodes(Node.NServerFn(s))) {
                if (nodeIsServerCall(n)) out = out.concat(["E-BOOTSTRAP-UNSUPPORTED: server function " + s.sym.hint + "() holds a client call of a server function (a server body calls in place, §13.4) — the Core is ill-formed (check.scrml C-S1)"])
            }
        }
        return out
    }

    fn nodeIsServerCall(n: Node) -> boolean {
        return match n {
            .NExpr(e: e) :> exprIsServerCall(e)
            .NStmt(s: x) :> false
            .NProgram(p: x) :> false
            .NDecl(d: x) :> false
            .NField(f: x) :> false
            .NFn(f: x) :> false
            .NServerFn(f: x) :> false
            .NBlock(b: x) :> false
            .NPlace(pl: x) :> false
            .NInst(i: x) :> false
            .NPattern(pat: x) :> false
            .NEdit(k: x) :> false
            .NView(v: x) :> false
            .NAttr(a: x) :> false
        }
    }

    fn exprIsServerCall(e: Expr) -> boolean {
        return match e {
            .ServerCall(fn: x) :> true
            .Lit(lit: x) :> false
            .Local(sym: x) :> false
            .Read(place: x) :> false
            .Call(callee: x) :> false
            .Prim(op: x) :> false
            .Match(scrut: x) :> false
            .ArrayOf(elems: x) :> false
            .StructOf(ty: x) :> false
            .Handle(inst: x) :> false
            .InitOf(decl: x) :> false
            .Host(call: x) :> false
            .Lambda(params: x) :> false
            .SeqCall(op: x) :> false
            .Validity(of: x) :> false
            .Query(q: x) :> false
        }
    }
}
