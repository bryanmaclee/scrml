            "E-PARSE-001" :> Severity.Error
            "E-PERSIST-KEY-REQUIRED" :> Severity.Error
            "E-PERSIST-STORAGE-UNKNOWN" :> Severity.Error
            "E-PERSIST-WITH-SERVER" :> Severity.Error
            "E-PREPAINT-WITHOUT-PERSIST" :> Severity.Error
            "E-PROGRAM-002" :> Severity.Error
            "E-PROGRAM-NESTED-ATTR" :> Severity.Error
            "E-PROGRAM-NESTED-AUTH" :> Severity.Error
            "E-PROGRAM-NESTED-SESSION" :> Severity.Error
            "E-REACTIVE-003" :> Severity.Error
            "E-RESET-ON-CYCLE" :> Severity.Error
            "E-RESET-ON-ENGINE-REFUSED" :> Severity.Error
            "E-RESET-ON-INVALID-ENTRY" :> Severity.Error
            "E-RESET-ON-NOT-WRITABLE" :> Severity.Error
