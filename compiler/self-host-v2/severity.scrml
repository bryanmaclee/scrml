            "E-DEFER-LATER-SHADOW" :> Severity.Error
            "E-DEFER-NESTED" :> Severity.Error
            "E-DEFER-OUTSIDE-FUNCTION" :> Severity.Error
            "E-DEFER-UNHANDLED-FAILABLE" :> Severity.Error
            "E-DEFER-UNSUPPORTED-SITE" :> Severity.Error
            "E-DERIVED-VALUE-MUTATE" :> Severity.Error
            "E-DERIVED-WITH-VALIDATORS" :> Severity.Error
            "E-DERIVED-WRITE" :> Severity.Error
            "E-EACH-NOT-SEQUENCE" :> Severity.Error
            "E-EFFECT-NO-DEPS" :> Severity.Error
            "E-EFFECT-WRITE-UNPROVEN" :> Severity.Error
            "E-EFFECT-WRITES-STATE" :> Severity.Error
            "E-ERROR-001" :> Severity.Error
            "E-ERROR-002" :> Severity.Error
            "E-ERROR-003" :> Severity.Error
            "E-ERROR-004" :> Severity.Error
            "E-ERROR-009" :> Severity.Error
            "E-ERROR-010" :> Severity.Error
            "E-ERROR-011" :> Severity.Error
            "E-ERROR-012" :> Severity.Error
            "E-ERROR-013" :> Severity.Error
            "E-ERROR-014" :> Severity.Error
            "E-ERROR-015" :> Severity.Error
            "E-ERRORS-001" :> Severity.Error
