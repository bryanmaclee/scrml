${
    export type Severity:enum = { Error, Warning, Info }

    // The §34 severity of a diagnostic code. A code with no usable §34 row is an
    // Error (fail closed): an uncatalogued diagnostic never lets an artifact through.
    export fn severityOf(code: string) -> Severity {
        return match code {
            // §34 Severity: Warning
            "W-ATTR-001" :> Severity.Warning
            "W-DEPRECATED-SERVER-MODIFIER" :> Severity.Warning
            "W-LIFECYCLE-010" :> Severity.Warning
            "W-PROGRAM-TITLE-NESTED" :> Severity.Warning
            "W-STORY-ON-TOP-LEVEL" :> Severity.Warning
            "W-WHEN-EFFECT-DEPRECATED" :> Severity.Warning
            // §34 Severity: Info
            "I-FORM-SUBMIT-GATED" :> Severity.Info
            "W-ARM-PIPE-LEGACY" :> Severity.Info
            "W-GIVEN-PRESENCE-DEPRECATED" :> Severity.Info
            "W-MATCH-ARROW-LEGACY" :> Severity.Info
            // §34 Severity: Error
            "E-ATTR-010" :> Severity.Error
            "E-ATTR-011" :> Severity.Error
            "E-ATTR-WRITER-CONFLICT" :> Severity.Error
            "E-AUTH-ATTR-INVALID" :> Severity.Error
            "E-CALL-ARITY" :> Severity.Error
            "E-CHANNEL-OUTSIDE-PROGRAM" :> Severity.Error
            "E-CLOSER-001" :> Severity.Error
            "E-COLON-SHORTHAND-ON-VOID" :> Severity.Error
            "E-COMPONENT-ENGINE-SCOPE" :> Severity.Error
            "E-COND-NOT-BOOLEAN" :> Severity.Error
            "E-CTRL-001" :> Severity.Error
            "E-CTRL-002" :> Severity.Error
            "E-CTRL-003" :> Severity.Error
            "E-CTRL-005" :> Severity.Error
            "E-CTX-001" :> Severity.Error
