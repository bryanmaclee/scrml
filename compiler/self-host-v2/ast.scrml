// =============================================================================
// self-host-v2 / ast.scrml — FileAst: the parser's output (bootstrap impl#2,
// slice M2). The S233 re-cut: `[Token] → FileAst → TypedProgram → CoreProgram`.
//
// Design authority: dpa-051 §3.1, §3.3, §4 (R1 (a), ruled S437).
//
//   - EVERY node is a struct `{ nid, span, … }`: `nid` is its NodeId (dense
//     per LINKED program — the driver gives each file a disjoint id range), the
//     key every analyze side-table uses (§3.5). `span` is a byte range of the
//     node's source file.
//   - §4 invariant (bodies are trees): `string` appears ONLY in literal values
//     (`Str.v`, `Num.raw`, `Text.text`, `Quoted.v`, `Import.from`),
//     identifiers (names, tags, attribute names, grant words) and spans. No
//     expression, statement, handler, arm or markup body is ever text.
//   - Comments are trivia: the parser drops them (the whitespace around them
//     stays content — L13 retired, dpa-045 follow-up 4, RULED S442).
//   - The FileAst is SYNTAX. Whether `@x` names a field, a handle or a shared
//     instance, whether `open` in a renders is a bare projection, what `.Closed`
//     is a variant of — all of that is analyze's (side-tables by nid).
//
// Every payload variant here has at most 3 fields, and the big node kinds carry
// ONE struct payload (first shaped around impl#1's F13 — a ≥5-field payload arm
// — which #1119 fixed; the shape is kept on its own merits, S440). impl#1
// workaround: F15 — no helper fn in this file shares a name with a field.
// =============================================================================
${
    import { Severity, severityOf } from "./severity.scrml"
    import { ComplexSel } from "./core.scrml"

    export type ASpan:struct = { start: int, end: int }

    // -------------------------------------------------------------------------
    // Expressions (logic).
    // -------------------------------------------------------------------------
    export type BinOp:enum = { Add, Sub, Mul, Div, Mod, Lt, Le, Gt, Ge, Eq, Ne, And, Or, Pipe }
    // s460: `IsGiven` / `IsNot` — the POSTFIX presence tests `x is given` /
    // `x is not` (§42.2.2, §42.2.4; ruled S460 "a′, go": "the explicit pair
    // for value positions / compounds"). Each is a `bool`.
    export type UnOp:enum = { Not, Neg, IsGiven, IsNot }

    export type AExpr:struct = { nid: int, span: ASpan, k: AExprK }
    // An object-literal entry: `name: value`, or `...value` (spread = true, name "").
    export type AProp:struct = { nid: int, span: ASpan, spread: boolean, name: string, value: AExpr }

    export type AExprK:enum = {
        Name(name: string),                          // a bare identifier
        At(name: string),                            // @name
        AtItem,                                      // @.  — the current <each> item (§17.7.3)
        Num(raw: string),
        Str(v: string),
        Bool(v: boolean),
        NotLit,                                      // not
        Recovered,                                   // a parse-error placeholder: the parser reported it; nothing downstream types or checks it
        Variant(name: string),                       // .Name — a bare variant
        Member(obj: AExpr, name: string),
        Call(callee: AExpr, args: AExpr[]),
        Unary(op: UnOp, e: AExpr),
        Binary(op: BinOp, l: AExpr, r: AExpr),
        Ternary(test: AExpr, yes: AExpr, no: AExpr),
        Assign(target: AExpr, value: AExpr),         // statement position only (analyze checks)
        ArrayLit(elems: AExpr[]),
        ObjectLit(props: AProp[]),
        // s442 (§66.19.5): an array element `...e` (an object literal's spread is
        // AProp.spread); `a[i]`; an arrow function `x => e` / `(a, b) => e`
        // (expression body). Each is legal only where analyze recognizes it
        // (an edit shape, §66.11.2) — Core has no spread, index or function value.
        Spread(e: AExpr),
        Index(obj: AExpr, idx: AExpr),
        Lambda(params: string[], body: AExpr),
        // s451 (U1a) — a `?{ `…` }` SQL context (§8.1, §44.8), its call chain
        // absorbed (ASql). Placement, the database, the failable rule and the
        // query's facts are analyze's.
        Sql(q: ASql),
        // s451 (Ue) — a failable result HANDLED (§19.4.3): `e?` (§19.5),
        // `e !{ arms }` (item 3), or `match e { arms }` (§19.7.1). Whether
        // `e` is failable, which enum the arms name, and what each binds are
        // analyze's.
        Handled(h: AHandled),
        // s469 — a logic backtick template (§14.13.3): `quasis` the static
        // text runs (escapes decoded, a line break read as LF), one more than
        // `slots`; `slots` the `${…}` expressions, each a TEXT SINK (§14.13.1).
        // A `string`. What each slot may hold (a primitive) is analyze's.
        Template(quasis: string[], slots: AExpr[]),
    }

    // s451 (Ue) — the handling forms. `subject` is the failable (a call of a
    // `!` function, or a `?{}` query).
    export type AHow:enum = {
        Propagate,                  // `subject?`
        Guard(arms: AArm[]),        // `subject !{ | .V(a) :> … | _ :> … }`
        MatchOn(arms: AArm[]),      // `match subject { .Ok(v) :> …  .V :> … }`
    }
    export type AHandled:struct = { subject: AExpr, how: AHow }
    // One arm. `legacy`: written with a deprecated `=>` / `->` separator
    // (W-MATCH-ARROW-LEGACY — the `!{}` arms share the match rule, §19).
    // s469 — `lifted`: the arm is a `{ … }` block whose LAST statement was written
    // `lift <expr>` (§18.5, RULED S469 "block arms yield with `lift`"). The
    // block then ends in `Eval(expr)` — the arm's value — and the flag records
    // that it was yielded explicitly; a value-position block arm of two or more
    // statements whose last is a BARE expression (not lifted) is
    // E-ARM-TAIL-VALUE (analyze). The bootstrap reads `lift` nowhere else.
    export type AArm:struct = { nid: int, span: ASpan, pat: APat, body: AArmBody, legacy: boolean, lifted: boolean }
    // `.V` / `::V` with its positional binders (`parens`: written `(…)`),
    // or the wildcard (`_` / `else`, §19 alias note).
    // s452: `PWhole` — the wildcard carrying one binder, `_ err` (§18.6.1, the
    // whole-error binder; `viaElse`: written `else err`, which §18.6.1 makes
    // E-MATCH-BARE-BINDER); `PBare` — a bare identifier as the WHOLE pattern
    // (`err :>`, §18.2 E-MATCH-BARE-BINDER). Both are syntax: whether the arm is
    // legal (a failable site or not) is analyze's.
    // s469 — the §18 plain-value `match` patterns: `PNot`, the absence arm
    // `not :>` (§18.2 "`not` is the absence arm (§42)", §42.2.3); `PLit`, a
    // literal arm (§18.16) — `e` is the literal as written (a Str, a Num —
    // `-1` folded into its raw text — or a Bool). Whether either is legal for
    // the subject's type is analyze's.
    export type APat:enum = {
        PName(name: string, binds: ABind[], parens: boolean, qual: string),   // s469: `qual` — the `E` of a qualified `E.V` / `E::V` (§18.13), "" bare
        PWild,
        PWhole(bind: ABind, viaElse: boolean),
        PBare(bind: ABind),
        PNot,
        PLit(e: AExpr),
    }
    // A binder: a name, or `_` (binds nothing).
    export type ABind:struct = { nid: int, span: ASpan, name: string }
    // An arm's body: an expression (a value, or a statement such as a write),
    // or a braced block.
    export type AArmBody:enum = {
        ArmExpr(e: AExpr),
        ArmBlock(b: ABlock),
    }

    // s451 (Ue) — `fail E.V(args)` / `fail E::V` / `fail .V(args)` /
    // `fail ::V` (§19.3.1). `enumName` "" = the bare form (resolved against the
    // function's declared error type, §19.3.3). `target`: a `fail` whose
    // target is not a variant at all (`fail "x"`) — kept, so analyze reports
    // E-ERROR-009 ("a `fail` target that is not an enum variant").
    // s469 — `split`: the operand was read from a line after `fail` (§7.2.2 rule 10), noted on E-ERROR-009.
    export type AFail:struct = { enumName: string, variant: string, args: AExpr[], target: AExpr | not, split: boolean }

    // s451 (U1a) — the terminator of a `?{}` chain (§8.3): `.all()` (or none
    // written — "`.all()` (or bare `?{}`)"), `.get()`, `.run()`.
    export type ASqlMode:enum = { SqlAll, SqlGet, SqlRun }
    // s451 (U1a) — a SQL context. `chunks` are the template's literal text runs
    // (cooked; a foreign language's literal, never scrml source), `params` the
    // `${…}` expressions between them, in order — `chunks.length ==
    // params.length + 1`, so a value can only ever be a BOUND parameter (§8.1:
    // "SHALL NOT be compiled to string interpolation under any circumstance").
    // `nobatch`: `.nobatch()` was written (§8.9.5). `handled`: the query is
    // the subject of a handling form (`?`, `!{}`, `match` — AExprK.Handled), so
    // analyze does not call it unhandled (E-ERROR-002, §19.8.3).
    export type ASql:struct = { chunks: string[], params: AExpr[], mode: ASqlMode, nobatch: boolean, handled: boolean }

    // -------------------------------------------------------------------------
    // Statements.
    // -------------------------------------------------------------------------
    export type AStmt:struct = { nid: int, span: ASpan, k: AStmtK }
    export type ABlock:struct = { nid: int, span: ASpan, stmts: AStmt[] }

    // s449 — a reactive effect (SPEC §6.7.4): `<effect deps=[@a, @b]>${ body }</>`,
    // or its soft-deprecated keyword spelling `when @a changes { body }` /
    // `when (@a, @b) changes { body }` (`keyword` = true; §6.7.4 "Parses
    // identically"). `deps` are the entries as written — analyze decides what
    // each names (E-LIFECYCLE-007 for anything but a mutable cell); an empty
    // list on the markup form is E-EFFECT-NO-DEPS (the keyword form's empty
    // list is a parse error). A self-closing `<effect …/>` has an empty body.
    export type AEffect:struct = { nid: int, span: ASpan, deps: AExpr[], body: ABlock, keyword: boolean }

    export type AStmtK:enum = {
        Eval(e: AExpr),                                     // an expression statement (incl. an assignment)
        Local(name: string, mutable: boolean, ty: AType | not, init: AExpr), // let / const [: T]
        Return(e: AExpr | not),
        If(cond: AExpr, thenB: ABlock, elseB: ABlock | not),
        Given(name: string, subject: AExpr, body: ABlock),  // given c = @h :> { … }
        // s449: an effect written where a STATEMENT stands (a function or
        // handler body, another effect's body). Parsed so analyze can name it
        // (E-LIFECYCLE-016 inside an effect body); an effect where markup
        // stands is ANodeK.Effect.
        EffectStmt(w: AEffect),
        // s451 — `defer <stmt>` / `defer { … }` (§19.16.1; `defer` is a
        // contextual keyword — parse.scrml `deferAhead`). `body` is the
        // deferred statement(s). `arrayLead`: the single-statement form was led
        // by a `[` (§19.16.1 E-DEFER-AMBIGUOUS-LEAD when a binding named `defer`
        // is visible). `bare`: the defer is the whole UNBRACED arm of an
        // `if` / `else` (§19.16.2 E-DEFER-UNSUPPORTED-SITE).
        Defer(body: ABlock, arrayLead: boolean, bare: boolean),
        // s451 (Ue) — `fail …` (§19.3).
        Fail(f: AFail),
        // s469 — the ONE loop (§49, "one `for`"): a `for` statement with its
        // head, and `break` / `continue` with their optional label ("" — none).
        // Which loop a `break` leaves, and whether that is legal (E-LOOP-001 …
        // -006), is analyze's (the loop-control pass).
        For(f: AFor),
        Break(label: string),
        Continue(label: string),
    }

    // s469 — a `for` (§49.2.1). `label` is its `label:` prefix ("" — none).
    // The four heads (§49.2.4): no parentheses / `(;;)` is HForever; two
    // top-level `;` is HCounted (`init` holds `let` declarations or assignments,
    // as statements; `cond` `not` = empty, i.e. true; `step` the comma-listed
    // step expressions); `binder of iterable` is HIter; anything else HCond.
    // HIter's `mutable` is a `let` binder (§49.3.5: keywordless and `const` are
    // const). A range is ONLY an iterable (§49.2.5: "A range is not a value"),
    // so it is IterRange here and no expression kind can hold one.
    export type AIterSrc:enum = {
        IterOf(e: AExpr),
        IterRange(lo: AExpr, hi: AExpr, inclusive: boolean),
    }
    export type AForHead:enum = {
        HForever,
        HCond(cond: AExpr),
        HCounted(init: AStmt[], cond: AExpr | not, step: AExpr[]),
        HIter(bind: ABind, mutable: boolean, src: AIterSrc),
    }
    export type AFor:struct = { nid: int, span: ASpan, label: string, head: AForHead, body: ABlock }

    // -------------------------------------------------------------------------
    // Type expressions and type declarations.
    // -------------------------------------------------------------------------
    export type AType:struct = { nid: int, span: ASpan, k: ATypeK }
    export type ATypeK:enum = {
        TName(name: string),                   // int · string · bool · number · struct · Line · Openness …
        TSeq(elem: AType, grants: string[]),   // T[] or T[g1, g2] (O10 spelling, ruled S469)
        TMaybe(inner: AType),                  // T | not
    }

    export type ATypeField:struct = { nid: int, span: ASpan, isLet: boolean, name: string, ty: AType }
    export type AVariant:struct   = { nid: int, span: ASpan, name: string, fields: ATypeField[] }
    export type ATypeBody:enum = {
        EnumBody(variants: AVariant[]),
        StructBody(fields: ATypeField[]),
    }
    export type ATypeDecl:struct = { nid: int, span: ASpan, exported: boolean, name: string, body: ATypeBody }

    // -------------------------------------------------------------------------
    // Functions and imports.
    // -------------------------------------------------------------------------
    export type AParam:struct = { nid: int, span: ASpan, name: string, ty: AType | not }
    // `pure` = declared with `fn` (§48.3); `function` otherwise.
    // s451 (U1a): `server` = written with the DEPRECATED `server` modifier
    // (§12.2 Trigger 4, §52.10 — analyze warns W-DEPRECATED-SERVER-MODIFIER);
    // `failable` = declared `!` (§19.4.1); `err` (s451 Ue) = the error type
    // written after it (`! E` / `! -> E`), `not` for a bare `!` (the built-in
    // `Error`, §19.4.2). A failable function has no success-type slot (§19.4.1),
    // so its `ret` is `not`.
    export type AFn:struct = {
        nid: int, span: ASpan, exported: boolean, pure: boolean,
        name: string, params: AParam[], ret: AType | not, body: ABlock,
        server: boolean, failable: boolean, err: AType | not,
    }
    export type AImportName:struct = { nid: int, span: ASpan, name: string }
    export type AImport:struct = { nid: int, span: ASpan, names: AImportName[], from: string }

    // -------------------------------------------------------------------------
    // Markup: attributes, elements, text, interpolation.
    // -------------------------------------------------------------------------
    // An attribute value, by its spelling (§66.2.4 cares which one was written).
    export type AAttrValue:enum = {
        NoValue,
        Quoted(v: string),       // "…"
        Bare(e: AExpr),          // an unquoted value: a literal, a name, @ref, a call, a member path
        Paren(e: AExpr),         // ( expr )
        Braced(b: ABlock),       // { stmts }
    }
    // `name` includes a namespace when written (`bind:value`, `class:active`).
    export type AAttr:struct = { nid: int, span: ASpan, name: string, value: AAttrValue }

    // A markup element: an HTML element or a USE of a declaration (§66.6.1);
    // `star` = `<*x …>`, the existing instance (§66.6.2).
    export type AElem:struct = { nid: int, span: ASpan, star: boolean, tag: string, attrs: AAttr[], kids: ANode[] }

    export type ANode:struct = { nid: int, span: ASpan, k: ANodeK }
    export type ANodeK:enum = {
        Elem(e: AElem),
        Text(text: string),        // verbatim (comments removed; whitespace-only runs kept — L13 retired, dpa-045 fu4)
        Interp(e: AExpr),          // ${ expr }
        DeclNode(d: ADecl),        // a declaration where markup may stand (a program body)
        // s449: a reactive effect where markup stands — owned, by its position in
        // the tree, by the nearest enclosing element scope (§6.7.4 "Scope and
        // teardown"): the program, an `if=` element, an `<each>` row.
        Effect(w: AEffect),
        // s469 — a `#{…}` CSS block where markup stands (§9.1, §65): its rules,
        // parsed (css-syntax.scrml). It renders nothing where it stands; WHICH
        // stylesheet it feeds — the program-global layer, a component's
        // `@scope`, or the inline `style=` of a constructor root — is decided by
        // its position (analyze, cssPass).
        Css(c: ACss),
    }

    // -------------------------------------------------------------------------
    // s469 — CSS (§9.1, §25, §65). CSS is a foreign language: the parser reads
    // it structurally (css-syntax.scrml) — a selector is a Core selector tree
    // (core.scrml SimpleSel …: a selector names nothing scrml binds, so it is
    // final at parse); a declaration value is literal CSS text with its `@name`
    // references as nodes (which cell or token each names is analyze's).
    // -------------------------------------------------------------------------
    export type ACssRef:struct = { nid: int, span: ASpan, name: string }
    export type ACssPart:enum = {
        CText(text: string),
        CRef(r: ACssRef),
    }
    // `prop: value` — `prop` as written (a property name, or `--name`, a §25.2
    // `name = value` definition included).
    export type ACssDecl:struct = { nid: int, span: ASpan, prop: string, value: ACssPart[] }
    export type ACssRule:struct = { nid: int, span: ASpan, sel: ComplexSel[], decls: ACssDecl[] }
    export type ACssItem:enum = {
        CssRule(r: ACssRule),
        CssFlat(d: ACssDecl),                          // a bare declaration, no selector (§9.1 flat block)
        CssCharset(span: ASpan, encoding: string),     // `@charset "…";` (§65.8)
        CssImport(span: ASpan, url: string, conditions: string),   // `@import …;` (§65.8)
    }
    export type ACss:struct = { nid: int, span: ASpan, items: ACssItem[] }

    // -------------------------------------------------------------------------
    // Declarations (§66.1–§66.5, §66.13).
    // -------------------------------------------------------------------------
    // A typed attribute of a declaration opener: `[export] [let] name:Type[=default]`.
    export type ADeclAttr:struct = {
        nid: int, span: ASpan, exported: boolean, isLet: boolean,
        name: string, ty: AType, dflt: AAttrValue,
    }
    // A state-child (O52 ruled): a tag in a declaration body with neither an own
    // value nor a typed attribute — it names a variant of the enclosing field.
    // `body` = that variant's markup (O5 RULED (1i): "a state-child's body is
    // that variant's markup, rendered wherever the field renders"): the one
    // Interp node of a `:`-shorthand body (§4.14, `<Idle rule=.X : "Ready">`),
    // the children of a bare body (`<Idle rule=.X>…</>`), or none (void).
    export type AStateChild:struct = { nid: int, span: ASpan, name: string, attrs: AAttr[], body: ANode[] }

    export type ADeclChild:enum = {
        ChildField(d: ADecl),
        StateChild(s: AStateChild),
    }

    // s444 Phase B (dpa-058) — a validator in a declaration opener (§55.1, §66.4
    // rule 3: it binds that declaration's own value), by its argument shape:
    // `req` (NoArgs) · `length(>=5)` (Cmp: the comparison and its operand) ·
    // `min(0)` / `eq(@x)` / `oneOf([…])` / `req("msg")` (Exprs) · `pattern(/re/i)`
    // (Regex: the source between the slashes and the flags).
    export type AValArg:enum = {
        NoArgs,
        Cmp(op: string, e: AExpr),
        Exprs(es: AExpr[]),
        Regex(source: string, flags: string),
    }
    export type AValidator:struct = { nid: int, span: ASpan, name: string, arg: AValArg }

    // `ty` = the own type (`name:Type`); `own` = the own value (NoValue = none);
    // `mods` = the opener's other words (`single`, …); `validators` = its
    // validators, in source order (§55.12: error order is declaration order).
    export type ADecl:struct = {
        nid: int, span: ASpan, exported: boolean, isLet: boolean,
        name: string, ty: AType | not, own: AAttrValue,
        attrs: ADeclAttr[], mods: AAttr[], body: ADeclChild[], renders: AElem | not,
        validators: AValidator[],
    }

    // -------------------------------------------------------------------------
    // Files.
    // -------------------------------------------------------------------------
    export type AProgram:struct = { nid: int, span: ASpan, attrs: AAttr[], items: AItem[] }

    export type AItem:struct = { nid: int, span: ASpan, k: AItemK }
    export type AItemK:enum = {
        ImportItem(i: AImport),
        TypeItem(t: ATypeDecl),
        FnItem(f: AFn),
        DeclItem(d: ADecl),
        MarkupItem(n: ANode),
        ProgramItem(p: AProgram),
    }

    // `path` is the file's path as the driver names it (an identifier of the
    // file, used to resolve import sources).
    // `errs`: the spans the parser reported an error at — a declaration or
    // signature containing one is not trusted by the typer (no check against it).
    // s454 (U1b): `lines` — the offset where each line starts (lines[0] = 0), so a
    // diagnostic can name "file and line" (§19.9.10 the client-caller cause).
    export type FileAst:struct = { path: string, items: AItem[], errs: ASpan[], lines: int[] }

    // A diagnostic: a code, its §34 severity, a message, where. (§4 permits
    // message text.)
    // `severity` (s451) is the CODE's §34 row — §34: "A code whose Severity
    // column reads **Error** fails the compile … **Warning** and **Info** codes
    // do not fail the compile." It is never a call site's choice: build every
    // Diag with `newDiag`, which reads the generated §34 table (severity.scrml).
    export type Diag:struct = { code: string, severity: Severity, message: string, file: string, span: ASpan }

    // The ONE Diag constructor (s451): the severity is derived from the code.
    export fn newDiag(code: string, message: string, file: string, span: ASpan) -> Diag {
        return { code: code, severity: severityOf(code), message: message, file: file, span: span }
    }

    export fn mkSpan(start: int, end: int) -> ASpan { return { start: start, end: end } }
}
