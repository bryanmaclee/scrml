// =============================================================================
// self-host-v2 / analyze.scrml — FileAst[] → TypedProgram (bootstrap impl#2,
// slice M2). The S233 re-cut's third phase: `TypedProgram = FileAst + NodeId
// side-tables` (dpa-051 §3.1, R1 (a) ruled S437).
//
//   - NAMES ARE SYMBOLS (§3.3). This module is THE BINDER: the only minter of
//     Syms (core.scrml, THE BINDER'S OBLIGATION). Every identifier the program
//     uses is bound here — to a declaration, a field (with the InstRef that
//     reaches it, L1/L2/L10/L11/L12), a write capability (L3), a type, a
//     variant, a function, a parameter, a local, an `as=` handle or an `<each>`
//     row binding.
//   - ONE TABLES RECORD (§3.5): every fact `lower` needs is either a
//     declaration/type/function record or a node fact keyed by the NodeId it
//     is about — one side-table per FACT FAMILY (names, values, effects,
//     binders, elements, attributes; M3 item 2), each reached through ONE
//     NodeId index in O(1). Tables are built once, never mutated (each step
//     returns a new value), and `lower` consumes them without re-deciding
//     anything.
//   - THE EDIT CLASSIFIER (§6.2, §66.11.2) runs here: every write becomes a
//     `WriteFact { cap, inst, edit, check }` or a diagnostic —
//     E-DERIVED-WRITE, E-WRITE-NOT-GRANTED, E-DECL-HANDLE-NOT-NARROWED,
//     E-FIELD-PRIVATE-WRITE, E-DECL-RENDERS-BARE-WRITE, E-ENGINE-INVALID-TRANSITION
//     (§66.20). The spread `@x = { ...@x, f: v }` is a FIELD EDIT (O58 (b)).
//   - Two passes then READ the binder's tables (M3 item 1): THE SCOPE PASS
//     (a scope binds each name once — E-SCOPE-010, E-SCOPE-REDECLARE) and
//     THE TYPER (a type per expression node in `Tables.typing`; writes,
//     initializers, call arity, `<each in=>`, conditions and operator
//     operands checked — E-TYPE-031, E-TYPE-041, E-CALL-ARITY,
//     E-EACH-NOT-SEQUENCE, and the S440-ruled E-COND-NOT-BOOLEAN (SPEC
//     §42.4, S460), E-OPERATOR-OPERAND-TYPE, E-OPERAND-NOT-NARROWED,
//     E-INT-DIVISION — named in SPEC §66.20, S442). Where neither a
//     ruling nor the SPEC names a rule they use bootstrap-local
//     `E-BOOTSTRAP-*` codes; see each section's header for the sentences.
//
// Scope of slice M2: the §66 subset §66.19.1 (counter) and §66.19.3 (dropdown)
// use. A construct outside it is reported (`E-BOOTSTRAP-UNSUPPORTED`), never
// guessed.
//
// impl#1 workarounds: F4 (qualified variants), F5 (typed host results), F11
// (named payload binding), F15 (no fn named like a
// payload field of an enum declared in this file), F16 (≥ 1 binding arm over an
// imported payload enum).
// =============================================================================
${
    import { Sym, Type, SeqAt, LengthGrant, SeqGrants, FieldDef, VariantDef, TypeDef, FieldRef, InstRef,
             Literal, PrimOp, EditKind, Check, FieldMode, FieldRole, GrantSet, Edge, TransitionGraph,
             DeclKind, HostCall, SeqFn, BindKind, Validator, SurfaceProp, ValidityOf, Persist, PersistStore, CoreProgram,
             SqlKind, SqlTables, SqlColumns, Db, Driver,
             mkSym, noGrants, replaceGrant, typeDefSym, validityInst, validityDecl } from "./core.scrml"
    import { ASpan, BinOp, UnOp, AExpr, AProp, AExprK, AStmt, ABlock, AStmtK, AEffect, AType, ATypeK,
             ATypeField, AVariant, ATypeBody, ATypeDecl, AParam, AFn, AImportName, AImport,
             AAttrValue, AAttr, AElem, ANode, ANodeK, ADeclAttr, AStateChild, ADeclChild, ADecl, AValArg, AValidator,
             AProgram, AItem, AItemK, FileAst, Diag, ASql,
             AHow, AHandled, AArm, APat, ABind, AArmBody, AFail, mkSpan, newDiag } from "./ast.scrml"
    import { Severity } from "./severity.scrml"
    import { WireBuild, WireTable, wireBuild, hasFixedLength } from "./codec.scrml"
    import { SqlFacts, sqlFacts, txControl, txControlAware } from "./sql.scrml"
    import { FxAtom, ownAtom, closeDim, witnessOf, atomChain } from "./effects.scrml"

    // =========================================================================
    // THE TABLES (exported — `lower` consumes them).
    // =========================================================================
    // One field of a declaration (Core `Field` minus the lowered initializer;
    // `init` is the syntax lower lowers, with the facts below).
    // `span` / `annotated` (M3 typer): where the field is declared, and whether
    // its type was WRITTEN (`name:Type`) rather than inferred from a literal —
    // §7.5.1's initializer rule applies to an annotation only.
    // `trusted`: its TYPE EXPRESSION parsed cleanly (no parser error inside
    // the type's own span) — the typer checks nothing against a type that
    // failed to parse. A diagnostic anywhere else (the initializer, a
    // sibling, the body) does not untrust the type. `typeSpan`: the written
    // type (`not` when the type is inferred).
    export type FieldInfo:struct = {
        nid: int,
        span: ASpan,
        annotated: boolean,
        trusted: boolean,
        typeSpan: ASpan | not,
        sym: Sym,
        ty: Type,
        mode: FieldMode,
        role: FieldRole,
        grants: GrantSet,
        graph: TransitionGraph | not,
        exported: boolean,
        wcap: Sym | not,
        init: AAttrValue,
        reads: string[],
        shrink: SeqAt[],        // s442: the SHRINK places its sequence type grants (RULED S442 grow/shrink split)
        vals: ValInfo[],        // s444 Phase B: its validators, as the bootstrap honors them (their HTML-native lowering)
        valsWritten: int,       // s449: how many validators the source wrote (a refused one is absent from `vals`)
    }

    // s444 Phase B (dpa-058, RULED S442 (2)) — one validator of a field and its
    // HTML-native lowering (`required`, `minlength` / `maxlength`, `min` /
    // `max`, `pattern` only when exact): the attributes that land on every
    // native input / textarea / select whose `bind:` targets the field's value.
    export type HtmlAttrPair:struct = { name: string, value: string }
    // `core` (s449): the validator as Core carries it — what the §55 surface evaluates.
    export type ValInfo:struct = { name: string, span: ASpan, attrs: HtmlAttrPair[], core: Validator }

    // `nid` = the ADecl (user) / AProgram node. `file` = the defining file (E2).
    export type DeclInfo:struct = {
        nid: int,
        span: ASpan,
        sym: Sym,
        kind: DeclKind,
        single: boolean,
        file: string,
        fields: FieldInfo[],
        handles: Sym[],
    }

    // An `as=` handle (L10): where its cell lives (`owner` = the declaration or
    // `<each>` element nid), the declaration of the instance it names, and
    // whether that instance is conditionally mounted (§66.7.5 → `T | not`).
    // `span` / `file`: the `as=` attribute that binds it (the scope pass's diagnostics).
    export type HandleInfo:struct = { sym: Sym, name: string, target: Sym, owner: int, conditional: boolean,
                                      span: ASpan, file: string }

    export type TypeInfo:struct = { nid: int, span: ASpan, name: string, file: string, exported: boolean, def: TypeDef }
    // `arity`: its parameter count (the bootstrap has no default parameters);
    // -1 when the signature did not parse cleanly or a parameter is untyped
    // (no arity check against it). `ret`: the declared return type (`-> T`),
    // resolved here; `not` when none is written (or `-> void`), or when the
    // signature did not parse.
    // s451 (Ue): `failable` — declared `!` (§19.4); `err` — its error enum
    // (the declared `! E`, or the built-in `Error` for a bare `!`, §19.4.2);
    // `not` when it cannot fail, or when the declared type is not an enum
    // (E-ERROR-011 — then nothing is checked against it).
    // s454 (U1b): `serverOwn` — its OWN body places it on the server (§12.2 T1 /
    // T4: a `?{}` in it, or the deprecated `server` modifier) — syntactic, known
    // in phase A, before any body is bound (design §2.5: "compute the
    // own-trigger fact … ONCE in phaseA per function"); a Split function
    // (§19.9.5) has it too. `rerr` — the failure enum of a CLIENT call of it
    // (§19.9.10 "The failure set of a client call"): its declared enum plus ONE
    // variant `Transport(t: ServerCallError)` (minted `E + Transport`; `E`
    // itself when it already declares exactly that variant), or the shared
    // `Transport` enum for a callee not declared `!`. `not`: not serverOwn, or
    // its enum has a `Transport` variant of another shape (E-ERROR-016 at each
    // client call site), or its error type is not an enum (E-ERROR-011).
    export type FnInfo:struct = { nid: int, span: ASpan, sym: Sym, name: string, file: string, exported: boolean,
                                  pure: boolean, arity: int, ret: Type | not, failable: boolean, err: Sym | not,
                                  serverOwn: boolean, rerr: Sym | not }

    // A classified write (§6.2): the capability, the instance, the edit, the check.
    export type WriteFact:struct = { cap: Sym, inst: InstRef, edit: EditKind, check: Check }
    // One override of a spread write `@x = { ...@x, f: v }` (O58 (b)): a
    // FieldAt edit whose value is the object literal's prop number `prop`.
    // `tmp` is the local that value is evaluated into BEFORE any override is
    // written: the literal is one value built from one snapshot (§66.10 item 1),
    // so `{ ...@p, x: @p.y, y: @p.x }` swaps exactly as the genuine replace
    // `{ x: @p.y, y: @p.x }` does (§66.11.3 item 1 — legality and meaning never
    // depend on spelling). Minted here so `lower` still decides nothing. A
    // non-spread write viewed as one override (the typer's `oneWrite`, prop -1)
    // has no local: `tmp` is `not`.
    export type SpreadWrite:struct = { w: WriteFact, prop: int, tmp: Sym | not }
    // One per-field snapshot local of a spread's target (RULED S440 strict
    // snapshot; see spreadEffect): the field (`ref`) and the local it is read
    // into when an override value reads it.
    export type SnapField:struct = { ref: FieldRef, local: Sym }
    // r2 (RULED S442 "sequence spreads use one snapshot"): the one snapshot of a
    // sequence shape's target — field `idx` of `decl` — read into `local` before
    // any element is evaluated; every `@x` read inside the elements reads it.
    export type SeqSnap:struct = { local: Sym, decl: Sym, idx: int }

    // How an attribute of an element is used.
    export type AttrKind:enum = {
        AStatic,                  // a plain HTML attribute with a literal value
        ABound,                   // a plain HTML attribute bound to an expression
        AOn(event: string),       // an event handler (onclick → "click")
        AIf,                      // if= (L5)
        AShow,                    // s451: show= (§17.2) — a visibility condition on an HTML element
        AConstruct(field: int),   // a use-site construction value (§66.14 rule 4)
        AAs,                      // as= on a use (the handle is on the element's MUse)
        AEachIn,
        AEachKey,
        AEachAs,
        // s444: a two-way bind (§5.4) — the write it performs (the place's own
        // contract, as `@x = v` / `@x.f = v`), the declaration field it
        // targets (`decl` / `idx`, the Phase-B validator join) and the
        // event-value local (`sink`, minted here).
        ABind(kind: BindKind, w: WriteFact, decl: Sym, idx: int, sink: Sym, vattrs: HtmlAttrPair[]),
    }

    // ---- THE NODE FACTS, by family (M3 item 2) --------------------------------
    // A node's fact lives in the side-table of its FAMILY — chosen by which
    // consumer asks, so each consumer's `match` is total over a few variants
    // (plus `not`: no fact) instead of one enum of every fact:
    //   names   — what a name / `@x` / `@.` / member / callee DENOTES
    //             (lower's reads, member steps and calls; the typer's value types)
    //   values  — a constant or an operator the binder resolved
    //             (lower's literals / variants / struct values / primitives)
    //   effects — what a statement-position assignment or edit call DOES
    //             (lower's writes; the typer's write checks)
    //   binds   — the Sym a `let` / function / parameter / `given` binds
    //   elems   — what an element IS (HTML, a use, an `<each>`, a slot)
    //   attrs   — how an attribute is used (AttrKind)
    export type NameFact:enum = {
        NLocal(sym: Sym),                                // a local / parameter / row binding
        NField(decl: Sym, inst: InstRef, idx: int),       // a read of a declaration field
        NInst(decl: Sym, inst: InstRef),                  // an instance (a whole-value read, or a handle)
        NStruct(owner: Sym, idx: int),                    // a struct-field step
        NFn(sym: Sym),                                    // a function
        NLength,                                          // `.length` of a sequence or a string (a primitive read)
        NSurface(of: ValidityOf, prop: SurfaceProp),      // s449: a read of the validity surface (§55.5 / §55.6) — read-only
    }
    export type ValueFact:enum = {
        VLit(lit: Literal),                               // a literal (int vs number resolved)
        VVariant(enumSym: Sym, idx: int),                 // a bare variant
        VOp(op: PrimOp),                                  // a unary / binary operator, resolved (§45)
        VStructOf(ty: Sym, order: int[]),                 // an object literal: prop index per declared field
        VHost(call: HostCall),                            // s444: a host call (`Date.now()`) — the closed HostCall set
        VSeqCall(op: SeqFn),                              // s444: `seq.filter(λ)` / `seq.map(λ)` — a call node
        VLambda(params: Sym[]),                           // s444: `x => e` as a SeqCall's argument — its parameter locals
    }
    export type EffectFact:enum = {
        EWrite(w: WriteFact),                             // an assignment / an edit call
        ESpread(ws: SpreadWrite[], inst: Sym, snap: Sym, fields: SnapField[]), // a spread assignment: FieldAt edits (O58 (b)); the instance + snapshot locals
        EReset(w: WriteFact, decl: Sym, idx: int),        // reset(@x): a replace with x's initializer (L4)
        EAssignLocal(sym: Sym),                           // a `let` local rebinding (§66.11.5)
        EEdits(w: WriteFact, elems: AExpr[], tmps: Sym[], snap: SeqSnap), // s442: `@x = [...@x, a, b]` — one edit per element (§66.11.2); r1: each element evaluated into `tmps[i]` first; r2: reads of `@x` see `snap`
        ERemove(w: WriteFact),                            // s444: `@x.pop()` / `@x.shift()` — a removal of one element (RemoveEnd / RemoveFront)
        EElemAt(cap: Sym, inst: InstRef, index: AExpr, path: FieldRef[]), // s444: `@xs[i].f = v` — an element-field write (Core ElemAt; dpa-052 Q3)
    }
    export type BindFact:enum = {
        BBind(sym: Sym),                                  // a binder: a local statement, a function
        BParam(sym: Sym, ty: Type),                       // a function parameter and its (annotated) type
        BGiven(sym: Sym, inst: InstRef),                  // given c = @handle (L11)
    }
    export type ElemFact:enum = {
        MHtml,
        MUse(decl: Sym, alias: Sym | not),                // an element that is a USE of a declaration
        MEach(bind: Sym, handles: Sym[]),                 // an <each> element
        MSlot,
        MStateView(v: StateView),                         // `<*f/>` of a graph field: its state-child bodies (O5 (1i))
        MInline(v: InlineView),                           // `<*x/>` rendered by inlining its markup (s442)
        MStar(decl: Sym, inst: InstRef),                  // s444: `<*x/>` of a user declaration's EXISTING instance (Core View.Star)
        MErrors(of: ValidityOf, all: boolean),            // s449: `<errors of=…/>` (§55.8) — the surface whose errors it renders
        MDb,                                              // s452: a `<db src=…>` state block (§4, §8.1.1) — its children render in place
    }
    // s442 — `<*x/>` (§66.6.2, "the existing one") rendered by INLINING markup
    // that is already resolved in the right context: a child field's own
    // `renders` inside its declaration's renders (`<*email/>`, `subst` = not —
    // the current instance is already Lexical(0)), or a user declaration's
    // `renders` for its shared instance at program top level (`<*signup/>`,
    // `subst` = Shared(x): the renders' `.Lexical(0)` means that instance).
    // Core has no View.Star (M1 D4; core.scrml is outside this slice), so the
    // inline form is restricted to markup that constructs nothing (no use, no
    // `as=`, no `<slot/>`) — every node reads / writes the ONE existing instance.
    export type InlineView:struct = { nodes: ANode[], subst: InstRef | not }
    // s442 — `<*f/>` of a field whose value carries a `rule=` graph with
    // state-child BODIES: O5 RULED (1i) "a state-child's body is that
    // variant's markup, rendered wherever the field renders". One arm per
    // state-child that has a body: shown while the field (`decl`/`inst`/`idx`)
    // holds variant `variant` of `enumSym`. The bodies are syntax (resolved in
    // the declaring declaration's context, like its renders); lower lowers them.
    export type StateArm:struct = { variant: int, body: ANode[] }
    export type StateView:struct = { decl: Sym, inst: InstRef, idx: int, enumSym: Sym, arms: StateArm[] }

    // A family's side-table: its facts in the order the binder recorded them,
    // `nids[i]` the node `facts[i]` is about, and `at` — the NodeId index:
    // `at[nid]` is the position of node `nid`'s fact, -1 (or past the end)
    // when the family has none. O(1). Built once, when the binder is done
    // (`indexed`); a node has one fact (the binder resolves each node once —
    // tables.test.js checks), and were there two, the first would answer, as
    // the linear scan this replaces did.
    // s451 (Ue) — THE ERROR-MODEL FACTS (lower reads them; it decides nothing).
    //   FHandled — a handling form (`?` / `!{}` / `match`, keyed by its
    //     AExprK.Handled node), or a `?{}` a `!` function propagates
    //     implicitly (keyed by its Sql node, §19.8.2): see HandledFact.
    //   FArm — an arm of a `!{}` / `match` (keyed by its AArm nid): the
    //     variant index it matches; -1 the wildcard (`_` / `else`); -2 `.Ok`.
    //   FFail — a `fail` statement (keyed by its AStmt nid): variant `idx` of
    //     enum `err` (§19.3).
    // HandledFact: `err` — the error enum of the failable; `result` — the local
    // its value is read from after the Attempt (an AExprK.Handled reads as
    // it); `ok` — the local the raw result is bound to; `stmt` — the form
    // stands as a statement (its arms yield no value); `into` / `retag` — for
    // propagation (`?`, an implicit `?{}`), the enclosing function's error enum
    // and, per variant of `err`, the variant of `into` it re-fails as with
    // the payload locals it binds (§19.5.2: "`::ErrorVariant(args) :> fail
    // EnclosingErrorType::ErrorVariant(args)`").
    export type Retag:struct = { from: int, to: int, binds: Sym[] }
    // s454 (U1b): `outcome` — the local a Suspend binds the call's SETTLED
    // outcome to, when the call suspends (a client call of a server function, a
    // call of a waiting client function — the suspension plan decides; design
    // §2.1 "Suspend waits, Attempt inspects"); `remote` — the call names a
    // server-triggered function from a site that is (or may be) on the client:
    // then `err` is the CLIENT call's failure set (FnInfo.rerr) and RemoteFact
    // says what the call is when the site turns out server→server.
    export type HandledFact:struct = { err: Sym, result: Sym, ok: Sym, stmt: boolean, into: Sym | not, retag: Retag[],
                                       outcome: Sym, remote: RemoteFact | not }
    // s454 (U1b) — `callee`: the server function; `caller`: the enclosing
    // function's Sym id (-1: an event handler / effect body — a client site by
    // position); `local`: the callee's own error enum (`not`: not declared `!`)
    // — the Attempt's `err` when the call is server→server; `retagT`: for `?`,
    // the re-fail of the client set's trailing `Transport` (owed only by a
    // client call; `retag` holds the callee's own variants).
    export type RemoteFact:struct = { callee: Sym, caller: int, local: Sym | not, retagT: Retag[] }
    export type FailFact:enum = {
        FHandled(h: HandledFact),
        FArm(idx: int),
        FFail(err: Sym, idx: int),
    }
    export type FailTable:struct = { facts: FailFact[], nids: int[], at: int[] }

    export type NameTable:struct = { facts: NameFact[], nids: int[], at: int[] }
    export type ValueTable:struct = { facts: ValueFact[], nids: int[], at: int[] }
    export type EffectTable:struct = { facts: EffectFact[], nids: int[], at: int[] }
    export type BindTable:struct = { facts: BindFact[], nids: int[], at: int[] }
    export type ElemTable:struct = { facts: ElemFact[], nids: int[], at: int[] }
    export type AttrTable:struct = { facts: AttrKind[], nids: int[], at: int[] }

    // THE TYPER'S TABLE (M3 item 1). `exprs`: the type of every expression
    // node the typer walked, keyed by NodeId (`at`, built once when the typer
    // settles; of two entries for one node the first answers). A value's
    // type is what the typer can PROVE: `Known(t)`, the absence literal `not`
    // (`Absent`, §42), or `Unknown` (inference stopped — no check ever fires
    // on an Unknown).
    export type VType:enum = { Known(t: Type), Absent, Unknown }
    export type ExprType:struct = { nid: int, vt: VType }
    // `presence`: the condition nodes (`if`, `if=`, a ternary test) whose
    // value is a `T | not` — a PRESENCE TEST (RULED S440, truthiness Q1: "a
    // bare `@x` of type `T | not` IS a presence test … the compiler emits an
    // absence check, never JS truthiness"). `lower` wraps each in `IsSome`.
    export type Typing:struct = { exprs: ExprType[], at: int[], presence: int[] }
    // r8 — Rule C for NAMES: a declared type that did not resolve (E-TYPE-UNKNOWN
    // answers with a placeholder type) is never checked against. `params`: the
    // parameter nids whose type did not resolve; `fields`: the struct FieldDef
    // Sym ids whose type did not resolve. (A declaration field records it on
    // FieldInfo.trusted; a local's annotation and a return type are left unset.)
    export type Unresolved:struct = { params: int[], fields: int[] }
    // A local's WRITTEN type (`let a: T = …`), by its Sym (the binder's).
    export type LocalAnnot:struct = { sym: Sym, ty: Type }

    export type Tables:struct = {
        program: Sym,
        types: TypeInfo[],
        decls: DeclInfo[],
        fns: FnInfo[],
        handles: HandleInfo[],
        names: NameTable,
        values: ValueTable,
        effects: EffectTable,
        binds: BindTable,
        elems: ElemTable,
        attrs: AttrTable,
        fails: FailTable,       // s451 (Ue): the error-model facts (FailFact)
        annots: LocalAnnot[],
        unresolved: Unresolved,
        typing: Typing,
        novalidate: int[],      // s444 Phase B (RULED S442 (3)): the `<form>` elements the compiler adds `novalidate` to
        resets: ResetOnInfo[],  // s449: the program cells' accepted `reset-on=` rules (§6.8.4)
        gated: GateInfo[],      // s449: the `<form>` elements that bind a surfaced value (§55.7), and the values that gate each (§55.17.3)
        persists: PersistInfo[], // s451: the program cells' accepted `persist=` (§6.14)
        server: ServerFacts,    // s451 (U1a): route placement + the program's queries and databases (placePass)
    }

    // s451 (U1a) — what route inference and the SQL pass decided (placePass).
    // `servers`: the Sym ids of the functions placed on the SERVER (§12.2) —
    // lower makes each a Core ServerFn. `sqls`: one fact per `?{}` node (by
    // NodeId) — the database it runs on and what its SQL does (recorded once,
    // from the literal text — sql.scrml). `dbs`: the program's databases.
    // `places`: every function's placement (§12.1/§12.2 — design §2's table:
    // Ambient = no server trigger and no client access, emitted on every side
    // that reaches it; Client; Server; Split = a server trigger + a reactive
    // write, split across the boundary — refused until U1d).
    export type SqlInfo:struct = { nid: int, db: Sym, kind: SqlKind, reads: SqlTables, writes: SqlTables, columns: SqlColumns }
    export type PlaceK:enum = { Ambient, Client, Server, Split }

    // The SQL sigil for messages, in two pieces: impl#1 (which compiles this
    // file) rewrites a literal sigil inside a string literal into its own SQL
    // placeholder (parse.scrml sqlSigil).
    fn sqlSigil() -> string { return "?" + "{" }
    export type PlaceFact:struct = { sym: int, name: string, place: PlaceK }
    // s454 (U1b): `inherited` — the functions server-placed by inheritance
    // (§12.2 Trigger 5): their calls of server functions are made in place;
    // `plan` — the suspension plan (planPass) lower reads.
    export type ServerFacts:struct = { servers: int[], sqls: SqlInfo[], dbs: Db[], places: PlaceFact[], inherited: int[], plan: SuspendPlan }

    export fn noServerFacts() -> ServerFacts { return { servers: [], sqls: [], dbs: [], places: [], inherited: [], plan: noPlan() } }

    // s454 (U1b): is a call made in function `caller` (-1: a handler / effect body)
    // a CLIENT call — the caller is not server-placed, by its own body or by
    // inheritance (§19.9.10 "placement is whole-program")?
    export fn remoteCaller(t: Tables, caller: int) -> boolean {
        if (caller < 0) return true
        for (const p of t.server.places) {
            if (p.sym == caller && p.place == PlaceK.Server) return false
        }
        return t.server.inherited.indexOf(caller) < 0
    }

    export fn sqlInfo(t: Tables, nid: int) -> SqlInfo | not {
        for (const s of t.server.sqls) {
            if (s.nid == nid) return s
        }
        return not
    }

    export fn isServerPlaced(t: Tables, s: Sym) -> boolean { return t.server.servers.indexOf(s.id) >= 0 }

    // s451 — one accepted `persist=` program cell (§6.14): field `sym` of the
    // program and its storage + key. `lower` sets Core Field.persist from it.
    export type PersistInfo:struct = { sym: Sym, persist: Persist }

    // s449 — a form whose composed subtree binds a value with a surface: its
    // submit sets `submitted` (§55.7). `values`: the bound values that carry
    // validators, in source order, named as §55.17.6 names them (a top-level
    // value `email`, a child field `signup.email`) — non-empty = GATED
    // (§55.17.3); empty = the form only records the submit.
    // `span` / `file`: the form's opener, where I-FORM-SUBMIT-GATED reports.
    export type GateInfo:struct = { form: int, values: string[], span: ASpan, file: string }

    // `infos` (s449): the non-fatal I- notes — SPEC §55.17.6 "As an `I-` code it
    // is non-fatal and reports in the warnings stream" — kept apart from
    // `diags`, so a program with a gated form still compiles clean.
    export type TypedProgram:struct = { files: FileAst[], tables: Tables, diags: Diag[], infos: Diag[] }

    // s449 — one `reset-on=[…]` rule of a program cell (§6.8.4), as the
    // analysis accepted it: field `target` of the program resets when any field
    // in `triggers` changes; `rank` is its depth in the static reset-on graph
    // (the order a chain is applied in). `lower` turns it into View.ResetOn.
    export type ResetOnInfo:struct = { target: int, triggers: int[], rank: int }

    // ---- the NodeId index ------------------------------------------------------
    // The position `at` holds for `nid` (-1: none).
    fn slotOf(at: int[], nid: int) -> int {
        if (nid < 0 || nid >= at.length) return -1
        return at[nid]
    }

    // The index over a key column: `at[nid]` = the position of the FIRST
    // entry for `nid`, -1 for none. Built in one pass into a FRESH local
    // array — with typingOf, the only array position writes in the
    // bootstrap: nothing
    // else holds `at` yet (a position write into a shared array would change
    // a value another holder already has — every AS the binder threads, a
    // discarded speculative one included, shares its arrays), and a write per
    // entry keeps the build O(nodes + entries) where appending is quadratic.
    fn nidIndex(nids: int[]) -> int[] {
        let top: int = -1
        for (const n of nids) {
            if (n > top) top = n
        }
        let at: int[] = minusOnes(top + 1)
        let i: int = nids.length - 1
        while (i >= 0) {
            // backwards: a node's first entry is written last, and stays
            if (nids[i] >= 0) at[nids[i]] = i
            i = i - 1
        }
        return at
    }

    // `n` × -1 (by doubling: O(n)).
    fn minusOnes(n: int) -> int[] {
        if (n <= 0) return []
        let out: int[] = [-1]
        while (out.length + out.length <= n) { out = out.concat(out) }
        return out.concat(minusOnes(n - out.length))
    }

    // The fact about node `nid` in each family (`not` when that family has
    // none — analyze reported an error on the node, or its fact is another
    // family's, or no consumer asks about it).
    export fn nameFact(t: NameTable, nid: int) -> NameFact | not {
        const i: int = slotOf(t.at, nid)
        if (i < 0) return not
        return t.facts[i]
    }

    export fn valueFact(t: ValueTable, nid: int) -> ValueFact | not {
        const i: int = slotOf(t.at, nid)
        if (i < 0) return not
        return t.facts[i]
    }

    export fn effectFact(t: EffectTable, nid: int) -> EffectFact | not {
        const i: int = slotOf(t.at, nid)
        if (i < 0) return not
        return t.facts[i]
    }

    export fn failFact(t: FailTable, nid: int) -> FailFact | not {
        const i: int = slotOf(t.at, nid)
        if (i < 0) return not
        return t.facts[i]
    }

    export fn bindFact(t: BindTable, nid: int) -> BindFact | not {
        const i: int = slotOf(t.at, nid)
        if (i < 0) return not
        return t.facts[i]
    }

    export fn elemFact(t: ElemTable, nid: int) -> ElemFact | not {
        const i: int = slotOf(t.at, nid)
        if (i < 0) return not
        return t.facts[i]
    }

    export fn attrFact(t: AttrTable, nid: int) -> AttrKind | not {
        const i: int = slotOf(t.at, nid)
        if (i < 0) return not
        return t.facts[i]
    }

    export fn declInfo(t: Tables, s: Sym) -> DeclInfo | not {
        for (const d of t.decls) {
            if (d.sym.id == s.id) return d
        }
        return not
    }

    // =========================================================================
    // Analyze state: the facts and diagnostics so far, and the Sym counter.
    // A family table grows by appending (`at` stays empty); `indexed` builds
    // every index once, when the binder is done.
    // =========================================================================
    type NodeFacts:struct = { names: NameTable, values: ValueTable, effects: EffectTable, binds: BindTable,
                              elems: ElemTable, attrs: AttrTable, fails: FailTable }
    // `bad`: the declared types that did not resolve (r8 — see Unresolved).
    // `effects` (s449): the reactive effects the binder accepted in an element
    // scope, in order, with their file — the input of the no-write pass
    // (effectPass), which runs once every function body is bound.
    type EffectSrc:struct = { w: AEffect, file: string }
    // `pend` (s452, dpa-066 M3): the binder's decisions that need the effect
    // summary — recorded where the binder meets them, decided by rulesPass.
    type AS:struct = { facts: NodeFacts, diags: Diag[], nextSym: int, annots: LocalAnnot[], bad: Unresolved, effects: EffectSrc[], pend: Pending[] }
    type RSym:struct = { s: Sym, st: AS }

    fn noFacts() -> NodeFacts {
        return { names: { facts: [], nids: [], at: [] }, values: { facts: [], nids: [], at: [] },
                 effects: { facts: [], nids: [], at: [] }, binds: { facts: [], nids: [], at: [] },
                 elems: { facts: [], nids: [], at: [] }, attrs: { facts: [], nids: [], at: [] },
                 fails: { facts: [], nids: [], at: [] } }
    }

    fn indexed(fs: NodeFacts) -> NodeFacts {
        return {
            names: { facts: fs.names.facts, nids: fs.names.nids, at: nidIndex(fs.names.nids) },
            values: { facts: fs.values.facts, nids: fs.values.nids, at: nidIndex(fs.values.nids) },
            effects: { facts: fs.effects.facts, nids: fs.effects.nids, at: nidIndex(fs.effects.nids) },
            binds: { facts: fs.binds.facts, nids: fs.binds.nids, at: nidIndex(fs.binds.nids) },
            elems: { facts: fs.elems.facts, nids: fs.elems.nids, at: nidIndex(fs.elems.nids) },
            attrs: { facts: fs.attrs.facts, nids: fs.attrs.nids, at: nidIndex(fs.attrs.nids) },
            fails: { facts: fs.fails.facts, nids: fs.fails.nids, at: nidIndex(fs.fails.nids) },
        }
    }

    fn mint(st: AS, hint: string) -> RSym {
        return { s: mkSym(st.nextSym, hint), st: { facts: st.facts, diags: st.diags, nextSym: st.nextSym + 1, annots: st.annots, bad: st.bad, effects: st.effects, pend: st.pend } }
    }

    fn withFacts(st: AS, fs: NodeFacts) -> AS {
        return { facts: fs, diags: st.diags, nextSym: st.nextSym, annots: st.annots, bad: st.bad, effects: st.effects, pend: st.pend }
    }

    fn addName(st: AS, nid: int, f: NameFact) -> AS {
        const fs: NodeFacts = st.facts
        const t: NameTable = { facts: fs.names.facts.concat([f]), nids: fs.names.nids.concat([nid]), at: [] }
        return withFacts(st, { names: t, values: fs.values, effects: fs.effects, binds: fs.binds, elems: fs.elems, attrs: fs.attrs, fails: fs.fails })
    }

    fn addValue(st: AS, nid: int, f: ValueFact) -> AS {
        const fs: NodeFacts = st.facts
        const t: ValueTable = { facts: fs.values.facts.concat([f]), nids: fs.values.nids.concat([nid]), at: [] }
        return withFacts(st, { names: fs.names, values: t, effects: fs.effects, binds: fs.binds, elems: fs.elems, attrs: fs.attrs, fails: fs.fails })
    }

    fn addEffect(st: AS, nid: int, f: EffectFact) -> AS {
        const fs: NodeFacts = st.facts
        const t: EffectTable = { facts: fs.effects.facts.concat([f]), nids: fs.effects.nids.concat([nid]), at: [] }
        return withFacts(st, { names: fs.names, values: fs.values, effects: t, binds: fs.binds, elems: fs.elems, attrs: fs.attrs, fails: fs.fails })
    }

    fn addBind(st: AS, nid: int, f: BindFact) -> AS {
        const fs: NodeFacts = st.facts
        const t: BindTable = { facts: fs.binds.facts.concat([f]), nids: fs.binds.nids.concat([nid]), at: [] }
        return withFacts(st, { names: fs.names, values: fs.values, effects: fs.effects, binds: t, elems: fs.elems, attrs: fs.attrs, fails: fs.fails })
    }

    fn addElem(st: AS, nid: int, f: ElemFact) -> AS {
        const fs: NodeFacts = st.facts
        const t: ElemTable = { facts: fs.elems.facts.concat([f]), nids: fs.elems.nids.concat([nid]), at: [] }
        return withFacts(st, { names: fs.names, values: fs.values, effects: fs.effects, binds: fs.binds, elems: t, attrs: fs.attrs, fails: fs.fails })
    }

    fn addAttr(st: AS, nid: int, k: AttrKind) -> AS {
        const fs: NodeFacts = st.facts
        const t: AttrTable = { facts: fs.attrs.facts.concat([k]), nids: fs.attrs.nids.concat([nid]), at: [] }
        return withFacts(st, { names: fs.names, values: fs.values, effects: fs.effects, binds: fs.binds, elems: fs.elems, attrs: t, fails: fs.fails })
    }
    // s451 (Ue)
    fn addFail(st: AS, nid: int, f: FailFact) -> AS {
        const fs: NodeFacts = st.facts
        const t: FailTable = { facts: fs.fails.facts.concat([f]), nids: fs.fails.nids.concat([nid]), at: [] }
        return withFacts(st, { names: fs.names, values: fs.values, effects: fs.effects, binds: fs.binds, elems: fs.elems, attrs: fs.attrs, fails: t })
    }

    fn addDiag(st: AS, file: string, span: ASpan, code: string, msg: string) -> AS {
        const d: Diag = newDiag(code, msg, file, span)
        return withDiag(st, d)
    }

    fn withDiag(st: AS, d: Diag) -> AS {
        return { facts: st.facts, diags: st.diags.concat([d]), nextSym: st.nextSym, annots: st.annots, bad: st.bad, effects: st.effects, pend: st.pend }
    }

    // s452 (dpa-066 M3): a decision for rulesPass, at the place in the
    // diagnostic list where the binder used to make it.
    fn addPending(st: AS, r: PendRule) -> AS {
        return { facts: st.facts, diags: st.diags, nextSym: st.nextSym, annots: st.annots, bad: st.bad, effects: st.effects,
                 pend: st.pend.concat([{ at: st.diags.length, rule: r }]) }
    }

    fn addAnnot(st: AS, s: Sym, ty: Type) -> AS {
        return { facts: st.facts, diags: st.diags, nextSym: st.nextSym, annots: st.annots.concat([{ sym: s, ty: ty }]), bad: st.bad, effects: st.effects, pend: st.pend }
    }

    fn badParam(st: AS, nid: int) -> AS {
        return { facts: st.facts, diags: st.diags, nextSym: st.nextSym, annots: st.annots,
                 bad: { params: st.bad.params.concat([nid]), fields: st.bad.fields }, effects: st.effects, pend: st.pend }
    }

    fn badField(st: AS, id: int) -> AS {
        return { facts: st.facts, diags: st.diags, nextSym: st.nextSym, annots: st.annots,
                 bad: { params: st.bad.params, fields: st.bad.fields.concat([id]) }, effects: st.effects, pend: st.pend }
    }

    // s449: record an effect the binder accepted (the no-write pass's input).
    fn addEffectSrc(st: AS, w: AEffect, file: string) -> AS {
        return { facts: st.facts, diags: st.diags, nextSym: st.nextSym, annots: st.annots, bad: st.bad,
                 effects: st.effects.concat([{ w: w, file: file }]), pend: st.pend }
    }

    // =========================================================================
    // Phase A — the program's shape: types, declarations, functions, fields,
    // handles. (Everything a body may name, before any body is resolved.)
    // =========================================================================
    // A declaration together with its syntax (for Phase B).
    type DeclSrc:struct = { info: DeclInfo, file: string, isProgram: boolean, d: ADecl | not, p: AProgram | not }
    type FnSrc:struct = { info: FnInfo, f: AFn }

    type Globals:struct = {
        program: Sym,
        entry: string,
        te: TypeEnv,
        types: TypeInfo[],
        decls: DeclSrc[],
        fns: FnSrc[],
        handles: HandleInfo[],
        files: FileAst[],
        errorSym: Sym,          // s451 (Ue): the built-in `Error` enum (§19.4.2 — a bare `!`'s error type)
        sqlErrorSym: Sym,       // s451 (Ue): the built-in `SqlError` enum (§19.8.1 — every query's error type)
        sceSym: Sym,            // s454 (U1b): the built-in `ServerCallError` enum (§19.9.10)
    }

    type RTypeInfos:struct = { ts: TypeInfo[], st: AS }

    // ---- types ---------------------------------------------------------------
    // A1: mint every type's Sym (and its variants' / fields' Syms). The field
    // TYPES are resolved in A2, once every type name is known.
    type TypeStub:struct = { nid: int, name: string, file: string, exported: boolean, sym: Sym,
                             isEnum: boolean, members: Sym[], src: ATypeDecl }

    type RStubs:struct = { stubs: TypeStub[], st: AS }

    fn typeStubs(files: FileAst[], st0: AS) -> RStubs {
        let st: AS = st0
        let out: TypeStub[] = []
        for (const f of files) {
            for (const td of typeItems(f.items)) {
                const rs: RSym = mint(st, td.name)
                st = rs.st
                let members: Sym[] = []
                let isEnum = false
                const body: ATypeBody = td.body
                const names: string[] = typeMemberNames(body)
                isEnum = isEnumBody(body)
                for (const n of names) {
                    const rm: RSym = mint(st, n)
                    st = rm.st
                    members = members.concat([rm.s])
                }
                out = out.concat([{ nid: td.nid, name: td.name, file: f.path, exported: td.exported, sym: rs.s,
                                    isEnum: isEnum, members: members, src: td }])
            }
        }
        // s451 (Ue): the built-in error enums, AFTER every user type (a user
        // `Error` is found first by name — it shadows the built-in, whose Sym
        // the bare `!` default still names; a user `SqlError` is refused,
        // builtinRedeclares).
        for (const bd of builtinTypeDecls()) {
            const rb: RSym = mint(st, bd.name)
            st = rb.st
            let bms: Sym[] = []
            for (const n of typeMemberNames(bd.body)) {
                const rm2: RSym = mint(st, n)
                st = rm2.st
                bms = bms.concat([rm2.s])
            }
            out = out.concat([{ nid: -1, name: bd.name, file: builtinFile(), exported: false, sym: rb.s,
                                isEnum: true, members: bms, src: bd }])
        }
        return { stubs: out, st: st }
    }

    // s451 (Ue) — the built-in error enums, written as the SPEC writes them:
    // §19.4.2 "`!` without `-> ErrorType` uses a built-in default error enum:
    // `Error`, which has a single variant `Error::Generic(message: string)`";
    // §19.8.1 `type SqlError:enum = { QueryFailed(message: string)
    // ConstraintViolation(field: string) ConnectionLost }` (their `renders`
    // clauses display a variant inside an `<errorBoundary>` / `<render of=>`,
    // neither of which is in the bootstrap). §8.9.4's `BatchPrepareFailed`
    // arrives with batch coalescing (not in the bootstrap — §19.8.4 "The
    // compiler MAY add additional variants").
    export fn builtinFile() -> string { return "scrml:builtin" }

    // s454 (U1b) — §19.9.10 "The error type — `ServerCallError` (S454)": "The
    // three kinds are carried by one built-in enum, **`ServerCallError`**. It is
    // provided by the compiler, as `SqlError` is (§19.8.1): the developer SHALL
    // NOT redefine it, it SHALL have at least the four variants below" —
    // `Unreachable`, `Refused(status: int)`, `ServerFault(status: int)`,
    // `Malformed(reason: string)`. Each variant's `renders` clause (§19.2) is
    // not modelled: the bootstrap's AST carries no `renders` on a variant (as for
    // `SqlError`), and the one route that displays one — the `<formFor>` submit
    // dispatch (§19.6.6) into an `<errorBoundary>` — is not in the bootstrap.
    export fn serverCallErrorName() -> string { return "ServerCallError" }

    fn builtinTypeDecls() -> ATypeDecl[] {
        return [
            builtinEnum("Error", [builtinVariant("Generic", ["message"])]),
            builtinEnum("SqlError", [builtinVariant("QueryFailed", ["message"]), builtinVariant("ConstraintViolation", ["field"]), builtinVariant("ConnectionLost", [])]),
            builtinEnum(serverCallErrorName(), [builtinTyped("Unreachable", "", ""), builtinTyped("Refused", "status", "int"),
                                                builtinTyped("ServerFault", "status", "int"), builtinTyped("Malformed", "reason", "string")]),
        ]
    }

    // A built-in variant with at most one field, of the named type ("" — none).
    fn builtinTyped(name: string, field: string, ty: string) -> AVariant {
        let fs: ATypeField[] = []
        if (field != "") {
            const at: AType = { nid: -1, span: mkSpan(0, 0), k: ATypeK.TName(ty) }
            fs = [{ nid: -1, span: mkSpan(0, 0), isLet: false, name: field, ty: at }]
        }
        return { nid: -1, span: mkSpan(0, 0), name: name, fields: fs }
    }

    fn builtinEnum(name: string, vs: AVariant[]) -> ATypeDecl {
        return { nid: -1, span: mkSpan(0, 0), exported: false, name: name, body: ATypeBody.EnumBody(vs) }
    }

    fn builtinVariant(name: string, fields: string[]) -> AVariant {
        let fs: ATypeField[] = []
        for (const f of fields) {
            const ty: AType = { nid: -1, span: mkSpan(0, 0), k: ATypeK.TName("string") }
            fs = fs.concat([{ nid: -1, span: mkSpan(0, 0), isLet: false, name: f, ty: ty }])
        }
        return { nid: -1, span: mkSpan(0, 0), name: name, fields: fs }
    }

    fn builtinSym(stubs: TypeStub[], name: string) -> Sym {
        for (const s of stubs) {
            if (s.file == builtinFile() && s.name == name) return s.sym
        }
        return mkSym(-1, name)
    }

    fn isEnumBody(b: ATypeBody) -> boolean {
        return match b {
            .EnumBody(variants: vs) :> true
            .StructBody(fields: fs) :> false
        }
    }

    fn typeMemberNames(b: ATypeBody) -> string[] {
        return match b {
            .EnumBody(variants: vs) :> variantNames(vs)
            .StructBody(fields: fs) :> typeFieldNames(fs)
        }
    }

    fn variantNames(vs: AVariant[]) -> string[] {
        let out: string[] = []
        for (const v of vs) { out = out.concat([v.name]) }
        return out
    }

    fn typeFieldNames(fs: ATypeField[]) -> string[] {
        let out: string[] = []
        for (const f of fs) { out = out.concat([f.name]) }
        return out
    }

    // Every TypeItem of a file, the program's included.
    fn typeItems(items: AItem[]) -> ATypeDecl[] {
        let out: ATypeDecl[] = []
        for (const it of items) { if (!isLaterProgram(items, it)) out = out.concat(typeItemOf(it)) }   // s451: a second top-level program is E-PROGRAM-002, not read
        return out
    }

    fn typeItemOf(it: AItem) -> ATypeDecl[] {
        const k: AItemK = it.k
        return match k {
            .TypeItem(t: t) :> [t]
            .ProgramItem(p: p) :> typeItems(p.items)
            .ImportItem(i: i) :> []
            .FnItem(f: f) :> []
            .DeclItem(d: d) :> []
            .MarkupItem(n: n) :> []
        }
    }

    // ---- resolving a type expression ------------------------------------------
    type TypeEnv:struct = { stubs: TypeStub[], declNames: string[], declSyms: Sym[], file: string }
    // `unresolved`: the TYPE itself did not resolve — a name in it is unknown
    // (E-TYPE-UNKNOWN; `t` then holds a placeholder). A diagnostic about the
    // type's GRANTS (E-GRANT-UNKNOWN) leaves the type resolved: the element type
    // is real and is checked against (S444 review, fail-closed).
    type RType:struct = { t: Type, st: AS, unresolved: boolean }

    fn stubNamed(te: TypeEnv, name: string) -> TypeStub | not {
        for (const s of te.stubs) {
            if (s.name == name) return s
        }
        return not
    }

    fn resolveType(te: TypeEnv, at: AType, st: AS) -> RType {
        const k: ATypeK = at.k
        return match k {
            .TName(name: n) :> resolveTypeName(te, at, n, st)
            .TSeq(elem: e, grants: gs) :> resolveSeqType(te, at, e, gs, st)
            .TMaybe(inner: i) :> resolveMaybe(te, i, st)
        }
    }

    fn resolveMaybe(te: TypeEnv, inner: AType, st: AS) -> RType {
        const r: RType = resolveType(te, inner, st)
        return { t: Type.Maybe(r.t), st: r.st, unresolved: r.unresolved }
    }

    fn resolveTypeName(te: TypeEnv, at: AType, n: string, st: AS) -> RType {
        if (n == "int") return { t: Type.Int, st: st, unresolved: false }
        if (n == "number") return { t: Type.Num, st: st, unresolved: false }
        if (n == "string") return { t: Type.Str, st: st, unresolved: false }
        if (n == "bool" || n == "boolean") return { t: Type.Bool, st: st, unresolved: false }
        const s: TypeStub | not = stubNamed(te, n)
        if (s is given) return { t: Type.Named(s.sym), st: st, unresolved: false }
        let i = 0
        while (i < te.declNames.length) {
            if (te.declNames[i] == n) return { t: Type.Named(te.declSyms[i]), st: st, unresolved: false }
            i = i + 1
        }
        return { t: Type.Str, st: addDiag(st, te.file, at.span, "E-TYPE-UNKNOWN", "unknown type `" + n + "`"), unresolved: true }
    }

    // ---- the grant words (the ONE place a grant SPELLING is read) -------------
    // RULED S442 (user-voice "the tape 'where it changes' axis splits grow from
    // shrink; `anywhere` covers end/front", and "spellings are fine" for the six
    // tokens): grow and shrink are SEPARATE grants at each place —
    //   end:      `append` (grow) · `pop` (shrink)
    //   front:    `prepend` (grow) · `shift` (shrink)
    //   anywhere: `insert` (grow) · `remove` (shrink) — and anywhere COVERS end
    //             and front (an insert grant admits appends and prepends, a
    //             remove grant pops and shifts).
    // The retired bare place tokens `end` / `front` / `anywhere` are refused,
    // naming both halves (never guessing which was meant). The rest of O10 — the
    // bracket-list form, `free` / `writable` / `replace`, the bounded-length
    // token — is still OPEN; a respelling is an edit here only.
    type GrantAxis:enum = { GFree, GWritable, GReplace, GGrow(at: SeqAt), GShrink(at: SeqAt), GRetired(grow: string, shrink: string), GUnknown }

    fn grantAxis(w: string) -> GrantAxis {
        return match w {
            "free"     :> GrantAxis.GFree
            "writable" :> GrantAxis.GWritable
            "replace"  :> GrantAxis.GReplace
            "append"   :> GrantAxis.GGrow(SeqAt.End)
            "pop"      :> GrantAxis.GShrink(SeqAt.End)
            "prepend"  :> GrantAxis.GGrow(SeqAt.Front)
            "shift"    :> GrantAxis.GShrink(SeqAt.Front)
            "insert"   :> GrantAxis.GGrow(SeqAt.Anywhere)
            "remove"   :> GrantAxis.GShrink(SeqAt.Anywhere)
            "end"      :> GrantAxis.GRetired("append", "pop")
            "front"    :> GrantAxis.GRetired("prepend", "shift")
            "anywhere" :> GrantAxis.GRetired("insert", "remove")
            _          :> GrantAxis.GUnknown
        }
    }

    // `T[g, …]` (⚑ O10 bracket form): the grant words are permission AXES
    // (§66.12.2). Core's SeqGrants.at holds the GROW places, SeqGrants.shrink
    // the SHRINK places (s444: Core's RemoveEnd / RemoveFront / RemoveAnywhere
    // edits; FieldInfo.shrink stays the analyze-side copy the classifier reads).
    fn resolveSeqType(te: TypeEnv, at: AType, elem: AType, gs: string[], st0: AS) -> RType {
        const re: RType = resolveType(te, elem, st0)
        let st: AS = re.st
        let length: LengthGrant = LengthGrant.Fixed
        let where: SeqAt[] = []
        let shrinks: SeqAt[] = []
        let writable = false
        let seen: string[] = []
        for (const g of gs) {
            const ax: GrantAxis = grantAxis(g)
            // r2 N3: a grant named twice is refused (E-GRANT-UNKNOWN: the list
            // is a SET of axis values; a repeat is not a value of any axis)
            if (seen.indexOf(g) >= 0) {
                st = addDiag(st, te.file, at.span, "E-GRANT-UNKNOWN", "`" + g + "` is granted twice — a grant list names each permission once (§66.12.2)")
            }
            seen = seen.concat([g])
            if (ax == GrantAxis.GFree) {
                length = LengthGrant.Free
            } else if (ax == GrantAxis.GWritable) {
                writable = true
            } else if (ax == GrantAxis.GReplace) {
                // carried on the field's grant set (seqReplace), not on SeqGrants
            } else {
                const gp: SeqAt | not = growAt(ax)
                const sp: SeqAt | not = shrinkAt(ax)
                if (gp is given) {
                    where = where.concat([gp])
                } else if (sp is given) {
                    shrinks = shrinks.concat([sp])
                } else {
                    st = addDiag(st, te.file, at.span, "E-GRANT-UNKNOWN", grantUnknownMessage(g, ax))
                }
            }
        }
        return { t: Type.Seq(re.t, { length: length, at: where, shrink: shrinks, positionsWritable: writable }), st: st, unresolved: re.unresolved }
    }

    fn growAt(ax: GrantAxis) -> SeqAt | not {
        return match ax {
            .GGrow(at: a) :> a
            .GShrink(at: a) :> not
            .GRetired(grow: g) :> not
            .GFree :> not
            .GWritable :> not
            .GReplace :> not
            .GUnknown :> not
        }
    }

    fn shrinkAt(ax: GrantAxis) -> SeqAt | not {
        return match ax {
            .GShrink(at: a) :> a
            .GGrow(at: a) :> not
            .GRetired(grow: g) :> not
            .GFree :> not
            .GWritable :> not
            .GReplace :> not
            .GUnknown :> not
        }
    }

    fn grantUnknownMessage(g: string, ax: GrantAxis) -> string {
        return match ax {
            .GRetired(grow: gw, shrink: sw) :> "`" + g + "` no longer names a grant: growing and shrinking are separate grants at each place (RULED S442) — write `" + gw + "` (grow), `" + sw + "` (shrink), or both"
            .GGrow(at: a) :> ""
            .GShrink(at: a) :> ""
            .GFree :> ""
            .GWritable :> ""
            .GReplace :> ""
            .GUnknown :> "`" + g + "` is not a permission axis value (§66.12.2; there is no `any` / `all`, §66.12.4)"
        }
    }

    // The SHRINK places a written sequence type grants (`pop` / `shift` / `remove`).
    fn shrinkOf(aty: AType | not) -> SeqAt[] {
        if (aty is not) return []
        return shrinkWords(aty)
    }

    fn shrinkWords(aty: AType) -> SeqAt[] {
        const k: ATypeK = aty.k
        return match k {
            .TSeq(elem: e, grants: gs) :> shrinkList(gs)
            .TName(name: n) :> []
            .TMaybe(inner: i) :> []
        }
    }

    fn shrinkList(gs: string[]) -> SeqAt[] {
        let out: SeqAt[] = []
        for (const g of gs) {
            const a: SeqAt | not = shrinkAt(grantAxis(g))
            if (a is given) out = out.concat([a])
        }
        return out
    }

    // A removal at `place` is granted by a shrink grant there or `remove` (anywhere covers end / front).
    fn shrinkGranted(shrink: SeqAt[], place: SeqAt) -> boolean {
        for (const a of shrink) {
            if (a == place || a == SeqAt.Anywhere) return true
        }
        return false
    }

    // Does a sequence type expression grant `replace` in its brackets?
    fn seqReplace(at: AType) -> boolean {
        const k: ATypeK = at.k
        return match k {
            .TSeq(elem: e, grants: gs) :> gs.indexOf("replace") >= 0
            .TName(name: n) :> false
            .TMaybe(inner: i) :> false
        }
    }

    // The edit grants a (resolved) type carries (§66.12.2 axes → EditKinds).
    fn typeEdits(t: Type) -> EditKind[] {
        return match t {
            .Seq(elem: e, grants: g) :> seqEdits(g)
            .Int :> []
            .Num :> []
            .Str :> []
            .Bool :> []
            .Named(sym: s) :> []
            .Maybe(inner: i) :> []
        }
    }

    fn seqEdits(g: SeqGrants) -> EditKind[] {
        let out: EditKind[] = []
        for (const a of g.at) { out = out.concat([seqAtEdit(a)]) }
        // RULED S442: an anywhere-grow (`insert`) grant admits appends and prepends
        if (hasEditKind(out, EditKind.Anywhere)) {
            if (!hasEditKind(out, EditKind.Append)) out = out.concat([EditKind.Append])
            if (!hasEditKind(out, EditKind.Prepend)) out = out.concat([EditKind.Prepend])
        }
        if (g.positionsWritable) out = out.concat([EditKind.PositionWrite])
        // s444: the SHRINK edits; RULED S442 "anywhere COVERS end and front" —
        // a `remove` grant pops and shifts
        for (const a of g.shrink) { out = addEditOnce(out, seqShrinkEdit(a)) }
        if (hasEditKind(out, EditKind.RemoveAnywhere)) {
            out = addEditOnce(out, EditKind.RemoveEnd)
            out = addEditOnce(out, EditKind.RemoveFront)
        }
        return out
    }

    fn addEditOnce(es: EditKind[], k: EditKind) -> EditKind[] {
        if (hasEditKind(es, k)) return es
        return es.concat([k])
    }

    fn seqShrinkEdit(a: SeqAt) -> EditKind {
        return match a {
            .End :> EditKind.RemoveEnd
            .Front :> EditKind.RemoveFront
            .Anywhere :> EditKind.RemoveAnywhere
        }
    }

    fn seqAtEdit(a: SeqAt) -> EditKind {
        return match a {
            .End :> EditKind.Append
            .Front :> EditKind.Prepend
            .Anywhere :> EditKind.Anywhere
        }
    }

    // A2: the TypeDefs.
    fn typeInfos(stubs: TypeStub[], te: TypeEnv, st0: AS) -> RTypeInfos {
        let st: AS = st0
        let out: TypeInfo[] = []
        for (const s of stubs) {
            const fte: TypeEnv = { stubs: te.stubs, declNames: te.declNames, declSyms: te.declSyms, file: s.file }
            const body: ATypeBody = s.src.body
            const r: RTypeDef = typeDefOf(fte, s, body, st)
            st = r.st
            out = out.concat([{ nid: s.nid, span: s.src.span, name: s.name, file: s.file, exported: s.exported, def: r.def }])
        }
        return { ts: out, st: st }
    }

    type RTypeDef:struct = { def: TypeDef, st: AS }

    fn typeDefOf(te: TypeEnv, s: TypeStub, body: ATypeBody, st: AS) -> RTypeDef {
        return match body {
            .EnumBody(variants: vs) :> enumDefOf(te, s, vs, st)
            .StructBody(fields: fs) :> structDefOf(te, s, fs, st)
        }
    }

    fn enumDefOf(te: TypeEnv, s: TypeStub, vs: AVariant[], st0: AS) -> RTypeDef {
        let st: AS = st0
        let out: VariantDef[] = []
        let i = 0
        for (const v of vs) {
            const r: RFieldDefs = fieldDefsOf(te, v.fields, [], st, true)
            st = r.st
            out = out.concat([{ sym: s.members[i], fields: r.fs }])
            i = i + 1
        }
        return { def: TypeDef.EnumDef(s.sym, out), st: st }
    }

    fn structDefOf(te: TypeEnv, s: TypeStub, fs: ATypeField[], st0: AS) -> RTypeDef {
        const r: RFieldDefs = fieldDefsOf(te, fs, s.members, st0, false)
        return { def: TypeDef.StructDef(s.sym, r.fs), st: r.st }
    }

    type RFieldDefs:struct = { fs: FieldDef[], st: AS }

    // Payload fields (variants) are values: no grants. Struct fields take their
    // own `let` (O3) and their type's edit grants. `syms` = the member Syms minted
    // with the type (struct fields); payload fields are minted here.
    fn fieldDefsOf(te: TypeEnv, fs: ATypeField[], syms: Sym[], st0: AS, payload: boolean) -> RFieldDefs {
        let st: AS = st0
        let out: FieldDef[] = []
        let i = 0
        for (const f of fs) {
            const rt: RType = resolveType(te, f.ty, st)
            const unresolved: boolean = rt.unresolved
            st = rt.st
            let grants: GrantSet = noGrants()
            if (!payload) grants = { replace: f.isLet || seqReplace(f.ty), edits: typeEdits(rt.t) }
            let fsym: Sym = mkSym(0, f.name)
            if (i < syms.length) {
                fsym = syms[i]
            } else {
                const rm: RSym = mint(st, f.name)
                fsym = rm.s
                st = rm.st
            }
            if (unresolved) st = badField(st, fsym.id)     // r8: never checked against
            out = out.concat([{ sym: fsym, ty: rt.t, grants: grants }])
            i = i + 1
        }
        return { fs: out, st: st }
    }

    // ---- lookups over the global shape ------------------------------------------
    fn typeInfoNamed(ts: TypeInfo[], name: string) -> TypeInfo | not {
        for (const t of ts) {
            if (t.name == name) return t
        }
        return not
    }

    fn typeInfoOf(ts: TypeInfo[], s: Sym) -> TypeInfo | not {
        for (const t of ts) {
            if (typeDefSym(t.def).id == s.id) return t
        }
        return not
    }

    fn enumVariants(td: TypeDef) -> VariantDef[] {
        return match td {
            .EnumDef(sym: s, variants: vs) :> vs
            .StructDef(sym: s) :> []
        }
    }

    fn structFieldDefs(td: TypeDef) -> FieldDef[] | not {
        return match td {
            .StructDef(sym: s, fields: fs) :> fs
            .EnumDef(sym: s) :> not
        }
    }

    // The index of variant `name` in enum `s`, else -1.
    fn variantIndex(ts: TypeInfo[], s: Sym, name: string) -> int {
        const t: TypeInfo | not = typeInfoOf(ts, s)
        if (t is not) return -1
        let i = 0
        for (const v of enumVariants(t.def)) {
            if (v.sym.hint == name) return i
            i = i + 1
        }
        return -1
    }

    fn isEnumType(ts: TypeInfo[], t: Type) -> Sym | not {
        const s: Sym | not = namedOf(t)
        if (s is not) return not
        const ti: TypeInfo | not = typeInfoOf(ts, s)
        if (ti is not) return not
        if (enumVariants(ti.def).length == 0) {
            const fs: FieldDef[] | not = structFieldDefs(ti.def)
            if (fs is given) return not
        }
        return s
    }

    fn namedOf(t: Type) -> Sym | not {
        return match t {
            .Named(sym: s) :> s
            .Int :> not
            .Num :> not
            .Str :> not
            .Bool :> not
            .Seq(elem: e) :> not
            .Maybe(inner: i) :> not
        }
    }

    fn seqElem(t: Type) -> Type | not {
        return match t {
            .Seq(elem: e) :> e
            .Named(sym: s) :> not
            .Int :> not
            .Num :> not
            .Str :> not
            .Bool :> not
            .Maybe(inner: i) :> not
        }
    }

    fn findDeclSrc(g: Globals, s: Sym) -> DeclSrc | not {
        for (const d of g.decls) {
            if (d.info.sym.id == s.id) return d
        }
        return not
    }

    fn declNamed(g: Globals, name: string) -> DeclSrc | not {
        for (const d of g.decls) {
            if (!d.isProgram && d.info.sym.hint == name) return d
        }
        return not
    }

    fn fieldIndex(d: DeclInfo, name: string) -> int {
        let i = 0
        for (const f of d.fields) {
            if (f.sym.hint == name) return i
            i = i + 1
        }
        return -1
    }

    fn fnNamed(g: Globals, name: string) -> FnInfo | not {
        for (const f of g.fns) {
            if (f.info.name == name) return f.info
        }
        return not
    }

    // ---- declarations -----------------------------------------------------------
    // The program (the entry file's `<program>`) and every user declaration
    // (a top-level `<x …>` with typed attributes / a `renders`, in any file).
    type DeclStub:struct = { sym: Sym, file: string, isProgram: boolean, d: ADecl | not, p: AProgram | not, nid: int }
    type RDeclStubs:struct = { ds: DeclStub[], st: AS }

    fn declStubs(files: FileAst[], entry: string, st0: AS) -> RDeclStubs {
        let st: AS = st0
        let out: DeclStub[] = []
        for (const f of files) {
            for (const it of f.items) {
                const k: AItemK = it.k
                const r: RDeclStubs = isLaterProgram(f.items, it) ? noStubs(st) : declStubOf(k, f.path, entry, st)
                out = out.concat(r.ds)
                st = r.st
            }
        }
        return { ds: out, st: st }
    }

    fn declStubOf(k: AItemK, file: string, entry: string, st: AS) -> RDeclStubs {
        return match k {
            .DeclItem(d: d) :> userDeclStub(d, file, st)
            .ProgramItem(p: p) :> withNestedStubs(programStub(p, file, entry, st), p, file)
            .ImportItem(i: i) :> noStubs(st)
            .TypeItem(t: t) :> noStubs(st)
            .FnItem(f: f) :> noStubs(st)
            .MarkupItem(n: n) :> noStubs(st)
        }
    }

    fn noStubs(st: AS) -> RDeclStubs { return { ds: [], st: st } }

    // Where a declaration is written: its `<x …>` opener / its `<program>`.
    fn declSpan(ds: DeclStub) -> ASpan {
        const d: ADecl | not = ds.d
        if (d is given) return d.span
        const p: AProgram | not = ds.p
        if (p is given) return p.span
        return mkSpan(0, 0)
    }

    fn userDeclStub(d: ADecl, file: string, st: AS) -> RDeclStubs {
        const r: RSym = mint(st, d.name)
        return { ds: [{ sym: r.s, file: file, isProgram: false, d: d, p: not, nid: d.nid }], st: r.st }
    }

    // s442: a declaration with typed attributes or a `renders` written inside
    // `<program>` is a USER declaration (a multi-instance type, §66.1) — the
    // §66.19.6 `<card title:string>` — not a program field. Its instances come
    // from its uses; the declaration itself renders nothing where it is
    // written (the §66.19 programs render instances only through uses and
    // `<*x/>`; ⚑ O38 — whether a program-level declaration is in "a markup
    // position" — is not decided here). A declaration with neither stays a
    // program field (R4), `single` or not.
    // S447 (§66.4 rule 6): attributes are always locked data, so a declaration
    // whose writable fields were attributes now holds them as CHILD
    // declarations under a `:struct` opener — the marker that replaces its
    // typed attributes (§66.2.2). `<x:struct>` is therefore a user declaration
    // too (it was the same kind before the respelling).
    fn isNestedUserDecl(d: ADecl) -> boolean {
        return d.attrs.length > 0 || d.renders is given || ownTypeName(d) == "struct"
    }

    fn withNestedStubs(r: RDeclStubs, p: AProgram, file: string) -> RDeclStubs {
        let st: AS = r.st
        let out: DeclStub[] = r.ds
        for (const it of p.items) {
            for (const d of declsOfItem(it)) {
                if (isNestedUserDecl(d)) {
                    const n: RDeclStubs = userDeclStub(d, file, st)
                    out = out.concat(n.ds)
                    st = n.st
                }
            }
        }
        return { ds: out, st: st }
    }

    fn programStub(p: AProgram, file: string, entry: string, st: AS) -> RDeclStubs {
        let st2: AS = st
        if (file != entry) st2 = addDiag(st, file, p.span, "E-BOOTSTRAP-UNSUPPORTED", "a `<program>` outside the entry file")
        const r: RSym = mint(st2, "program")
        return { ds: [{ sym: r.s, file: file, isProgram: true, d: not, p: p, nid: p.nid }], st: r.st }
    }

    // ---- s451: the program shape (fail closed) ---------------------------------------
    // Before s451 every `<program>` attribute was parsed and never read, a
    // second top-level `<program>` silently won (phaseA kept the LAST), a
    // `<program>` in a program body was ignored, and markup at a file's top
    // level, outside any `<program>`, was dropped. Each now gets the SPEC's code
    // where the rule is static and cheap, else E-BOOTSTRAP-UNSUPPORTED naming
    // it. The governing sentences are quoted in
    // docs/changes/s451-boot-program-shape/progress.md.

    // Is this item the second (or later) top-level `<program>` of its file?
    // §40.8: "A second (or later) top-level `<program>` in the SAME file …
    // SHALL be `E-PROGRAM-002`" — it is reported (programShapeDiags), and no
    // stub is minted for it, so its body is not analyzed as the program.
    fn isLaterProgram(items: AItem[], it: AItem) -> boolean {
        let seen = 0
        for (const x of items) {
            if (x.nid == it.nid) return seen > 0 && programOfItem(x) is given
            if (programOfItem(x) is given) seen = seen + 1
        }
        return false
    }

    fn programOfItem(it: AItem) -> AProgram | not {
        const k: AItemK = it.k
        return match k {
            .ProgramItem(p: p) :> p
            .DeclItem(d: d) :> not
            .ImportItem(i: i) :> not
            .TypeItem(t: t) :> not
            .FnItem(f: f) :> not
            .MarkupItem(n: n) :> not
        }
    }

    fn markupOfItem(it: AItem) -> ANode | not {
        const k: AItemK = it.k
        return match k {
            .MarkupItem(n: n) :> n
            .ProgramItem(p: p) :> not
            .DeclItem(d: d) :> not
            .ImportItem(i: i) :> not
            .TypeItem(t: t) :> not
            .FnItem(f: f) :> not
        }
    }

    fn topElemOf(n: ANode) -> AElem | not {
        const k: ANodeK = n.k
        return match k {
            .Elem(e: e) :> e
            .Text(text: t) :> not
            .Interp(e: x) :> not
            .DeclNode(d: d) :> not
            .Effect(w: w) :> not
        }
    }

    // Every file: a second+ top-level `<program>` (E-PROGRAM-002), file-top
    // markup outside any `<program>`, and — for the entry file's program —
    // its attributes and the `<program>`s nested in its body.
    fn programShapeDiags(files: FileAst[], entry: string, st0: AS) -> AS {
        let st: AS = st0
        for (const f of files) {
            let programs = 0
            for (const it of f.items) {
                if (programOfItem(it) is given) programs = programs + 1
            }
            let seen = 0
            for (const it of f.items) {
                const p: AProgram | not = programOfItem(it)
                if (p is given) {
                    seen = seen + 1
                    if (seen > 1) {
                        st = addDiag(st, f.path, p.span, "E-PROGRAM-002", "a second top-level `<program>` in this file — a file declares its top-level `<program>` exactly once (§40.8), so which program's `auth=`, cookie and middleware settings govern it cannot be told; merge them into one `<program>`, or put a worker / sidecar / scoped-db program INSIDE the first (without `auth=` or cookie attributes)")
                    } else if (f.path == entry) {
                        st = topProgramAttrDiags(f.path, p, st)
                        st = nestedProgramDiags(f.path, p.items, st)
                    }
                }
                const n: ANode | not = markupOfItem(it)
                if (n is given) st = outsideProgramDiag(f.path, n, programs > 0, st)
            }
        }
        return st
    }

    // Markup at a file's top level, outside any `<program>`. §38.1, §20.8.1
    // and §23.6 name three shapes; for the rest the SPEC names no rule (§40.8:
    // "The file top level outside any `<program>` / `<page>` / `<channel>` is
    // NOT this locus"), so it is refused — never dropped.
    fn outsideProgramDiag(file: string, n: ANode, fileHasProgram: boolean, st: AS) -> AS {
        const e: AElem | not = topElemOf(n)
        // a file-top `<effect>` is already refused by `strayEffects` (s449)
        if (e is not) return st
        const t: string = e.tag.toLowerCase()
        if (t == "channel" && fileHasProgram) return addDiag(st, file, e.span, "E-CHANNEL-OUTSIDE-PROGRAM", "`<channel>` outside `<program>` in a file that has a `<program>` (§38.1) — move it inside the `<program>`")
        if (t == "outlet") return addDiag(st, file, e.span, "E-OUTLET-OUTSIDE-SHELL", "`<outlet>` outside a `<program>` shell (§20.8.1) — an outlet is the shell's route-content region; move it inside the `<program>`")
        if (t == "foreign" && fileHasProgram && attrNamed(e.attrs, "lang") is given) return addDiag(st, file, e.span, "E-FOREIGN-LANG-IN-PROGRAM", "`<foreign lang>` in a file that also declares a top-level `<program>` (§23.6) — `<foreign lang>` is the library-file surface; remove it and set `lang=` on the `<program>`")
        return addDiag(st, file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`<" + e.tag + ">` at a file's top level, outside any `<program>`, is not in the bootstrap — the SPEC names no rule for what it renders as (§40.8); move it inside the `<program>`")
    }

    // The `<program>` attribute set (§52.13.3: a closed set — "unknown
    // attribute names emit `W-ATTR-001`"): the names §4.12.2, §20.5.1, §23.5,
    // §40.2, §40.7, §43, §58.8, §64 and §65.3.4 give it.
    fn isProgramAttrName(a: string) -> boolean {
        if (isCookieAttr(a)) return true
        return match a {
            "kind" :> true
            "serve" :> true
            "db" :> true
            "tables" :> true
            "html" :> true
            "name" :> true
            "auth" :> true
            "loginRedirect" :> true
            "csrf" :> true
            "title" :> true
            "description" :> true
            "version" :> true
            "author" :> true
            "license" :> true
            "cors" :> true
            "cors-max-age" :> true
            "log" :> true
            "headers" :> true
            "ratelimit" :> true
            "idempotency-store" :> true
            "idempotency-ttl" :> true
            "transactions" :> true
            "batch-in-list-cap" :> true
            "channel-reconnect" :> true
            "lang" :> true
            "mode" :> true
            "callchar" :> true
            "build" :> true
            "port" :> true
            "health" :> true
            "route" :> true
            "protect" :> true
            "story" :> true
            "capabilities" :> true
            "autostart" :> true
            "restart" :> true
            "max-restarts" :> true
            "within" :> true
            "mcp" :> true
            "reset" :> true
            _ :> false
        }
    }

    // A name outside the closed `<program>` set (§52.13.3: "unknown attribute
    // names emit `W-ATTR-001`"). s451 fix round (S239 MED): a CASE VARIANT of a
    // `<program>` attribute or of a scrml control attribute (`RESET=`,
    // `Auth=`, `loginredirect=`, `SHOW=`) is not an unknown name to warn past
    // — it is a known one the bootstrap would not read, so it is refused (the
    // SPEC names no rule for attribute-name case). A case-variant repeat
    // (`reset` + `RESET`) lands here too.
    fn unknownProgramAttrDiag(file: string, a: AAttr, st: AS) -> AS {
        const lower: string = a.name.toLowerCase()
        if (isProgramAttrName(lower) || lower == "loginredirect" || lower == "sessionexpiry" || (lower != a.name && isControlAttrName(lower))) {
            return addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "` on `<program>` is a case variant of a `<program>` / scrml attribute name — the bootstrap reads attribute names exactly, so it would be ignored; write the exact name")
        }
        return addDiag(st, file, a.span, "W-ATTR-001", "`" + a.name + "` is not a `<program>` attribute (§52.13.3: `<program>` has a closed attribute set)")
    }

    // §4.12.2's table: what a NESTED `<program>` may carry.
    fn isNestedProgramAttr(a: string) -> boolean {
        return match a {
            "name" :> true
            "lang" :> true
            "db" :> true
            "mode" :> true
            "build" :> true
            "port" :> true
            "health" :> true
            "route" :> true
            "protect" :> true
            "callchar" :> true
            "story" :> true
            "capabilities" :> true
            "autostart" :> true
            "restart" :> true
            "max-restarts" :> true
            "within" :> true
            _ :> false
        }
    }

    // The two §20.5.1 cookie attributes (`sessionExpiry=` and the `-secure`
    // one). The second name is assembled, and no string here holds the bare
    // word: impl#1's route inference scans raw source for /\bsession\b/
    // (route-inference.ts SERVER_ONLY_PATTERNS) — a string literal included —
    // and would place this function, and every function it calls, on the server.
    fn isCookieAttr(a: string) -> boolean {
        return a == "sessionExpiry" || a == "sess" + "ion-secure"
    }

    fn isDocumentaryAttr(a: string) -> boolean {
        return a == "title" || a == "description" || a == "version" || a == "author" || a == "license"
    }

    // The value as written, for a message.
    fn attrValueText(v: AAttrValue) -> string {
        return match v {
            .Quoted(v: s) :> "\"" + s + "\""
            .NoValue :> "no value (a bare attribute)"
            .Bare(e: x) :> "a non-literal value"
            .Paren(e: x) :> "a non-literal value"
            .Braced(b: b) :> "a non-literal value"
        }
    }

    fn quotedAttrText(v: AAttrValue) -> string | not {
        return match v {
            .Quoted(v: s) :> s
            .NoValue :> not
            .Bare(e: x) :> not
            .Paren(e: x) :> not
            .Braced(b: b) :> not
        }
    }

    // The entry file's top-level `<program>`: no attribute is read by the
    // bootstrap's build, so each one is checked to its SPEC rule where that
    // rule is static, and otherwise refused.
    fn topProgramAttrDiags(file: string, p: AProgram, st0: AS) -> AS {
        let st: AS = st0
        for (const a of p.attrs) {
            if (a.name == "auth") {
                st = topAuthDiag(file, a, st)
            } else if (a.name == "ratelimit") {
                st = ratelimitDiag(file, a, st)
            } else if (a.name == "capabilities") {
                st = capabilitiesDiags(file, a, st)
            } else if (a.name == "story") {
                st = addDiag(st, file, a.span, "W-STORY-ON-TOP-LEVEL", "`story=` on the top-level `<program>` is ignored — the top-level program's build story is `[story] default` in `scrml.toml`; per-`<program>` build stories are for nested programs (§58.8, §4.12.2)")
            } else if (a.name == "reset") {
                st = resetAttrDiag(file, a, st)
            } else if (a.name == "db") {
                // s451 (U1a): read — the program's database (§8.1.1, §44.2);
                // placePass's dbsPass checks it (E-SQL-005) and makes it a Core Db
            } else if (a.name == "name") {
                st = addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`name=` on the top-level `<program>` — \"The top-level `<program>` MUST NOT have a `name=` attribute\" (§4.12.2), and the SPEC names no code for it; remove it")
            } else if (isProgramAttrName(a.name)) {
                st = addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`<program " + a.name + "=…>` is not in the bootstrap — it reads no `<program>` attribute, and never ignores one it does not implement")
            } else {
                st = unknownProgramAttrDiag(file, a, st)
            }
        }
        return st
    }

    // §65.3.4: "Opt out via `<program reset=\"none\">` — drops the whole `reset`
    // layer." `"none"` is implemented (lower: CoreProgram.reset = false; print
    // emits no reset layer). §65.3.4 names no other value and no code for one,
    // so any other value is refused rather than given a meaning.
    fn resetAttrDiag(file: string, a: AAttr, st: AS) -> AS {
        const v: string | not = quotedAttrText(a.value)
        if (v is given) {
            if (v == "none") return st
        }
        return addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`reset=` is " + attrValueText(a.value) + " — §65.3.4 names one value, \"none\" (drop the built-in reset layer); the bootstrap gives no other value a meaning")
    }

    // §52.13.2 (S449): exactly one of the three literals, else E-AUTH-ATTR-INVALID.
    // A legal value is REFUSED: the bootstrap emits no server and no login
    // gate, so compiling it would serve the program ungated.
    fn topAuthDiag(file: string, a: AAttr, st: AS) -> AS {
        const v: string | not = quotedAttrText(a.value)
        if (v is given) {
            if (v == "required" || v == "optional" || v == "none") return addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`<program auth=\"" + v + "\">` is not in the bootstrap — it emits no server and no login gate (§52.13, §40.2), so the program is refused rather than compiled ungated")
        }
        return addDiag(st, file, a.span, "E-AUTH-ATTR-INVALID", "`auth=` on `<program>` is " + attrValueText(a.value) + " — it must be exactly one of the literals \"required\", \"optional\", \"none\" (§52.13.2)")
    }

    // §39.2.4: `N/unit`, unit ∈ { sec, min, hour }, else E-MW-002. A valid
    // value is refused: the bootstrap emits no request pipeline.
    fn ratelimitDiag(file: string, a: AAttr, st: AS) -> AS {
        const v: string | not = quotedAttrText(a.value)
        if (v is given) {
            if (isRatelimitForm(v)) return addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`<program ratelimit=\"" + v + "\">` is not in the bootstrap — it emits no request pipeline (§40.2), so the limit would be dropped")
        }
        return addDiag(st, file, a.span, "E-MW-002", "`ratelimit=` is " + attrValueText(a.value) + " — it must be `N/unit` with unit one of sec, min, hour (e.g. ratelimit=\"100/min\", §39.2.4)")
    }

    fn isRatelimitForm(v: string) -> boolean {
        const slash: int = v.indexOf("/")
        if (slash < 1) return false
        let i = 0
        while (i < slash) {
            if ("0123456789".indexOf(v.substring(i, i + 1)) < 0) return false
            i = i + 1
        }
        const unit: string = v.substring(slash + 1, v.length)
        return unit == "sec" || unit == "min" || unit == "hour"
    }

    // §23.5.2 / §23.5.3: `capabilities=[tok, …]` over the closed vocabulary.
    // An unknown token is E-FOREIGN-CAPABILITY-UNKNOWN; a value outside the
    // §23.5.2 grammar is refused. A valid list is accepted: in v1.0 it is
    // advisory and governs only foreign code (§23.5.1), which the bootstrap
    // refuses everywhere — so there is nothing for it to change here.
    type CapTok:struct = { name: string, ok: boolean }

    fn capabilitiesDiags(file: string, a: AAttr, st0: AS) -> AS {
        let st: AS = st0
        const v: AAttrValue = a.value
        const es: AExpr[] | not = match v {
            .Bare(e: x) :> capList(x)
            .Paren(e: x) :> not
            .Quoted(v: s) :> not
            .NoValue :> not
            .Braced(b: b) :> not
        }
        if (es is not) return addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`capabilities=` is not a bracketed capability list `[tok, …]` (§23.5.2)")
        for (const e of es) {
            const t: CapTok = capToken(e)
            if (t.name != "" && !isCapability(t.name)) {
                st = addDiag(st, file, e.span, "E-FOREIGN-CAPABILITY-UNKNOWN", "`" + t.name + "` is not a capability — the v1 vocabulary is { network, fs-read, fs-write, spawn, env, db } (§23.5.3)")
            } else if (t.name == "" || !t.ok || (t.name == "db" && capHasArgs(e))) {
                st = addDiag(st, file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "this `capabilities=` entry is outside the §23.5.2 grammar (a token, `tok(\"…\", …)` with string-literal arguments, or a bare `db`)")
            }
        }
        return st
    }

    fn capList(e: AExpr) -> AExpr[] | not {
        const k: AExprK = e.k
        return match k {
            .ArrayLit(elems: xs) :> xs
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: s) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .Assign(target: t) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Index(obj: o) :> not
            .Lambda(params: ps) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
        }
    }

    fn isCapability(n: string) -> boolean {
        return n == "network" || n == "fs-read" || n == "fs-write" || n == "spawn" || n == "env" || n == "db"
    }

    // A capability token, read back from the expression the attribute value
    // parsed as: `spawn` (a name), `network("a")` (a call), `fs-read("p")`
    // (`fs - read("p")`: a subtraction whose right side is the call). name ""
    // = not a token shape; ok = false = arguments that are not string literals.
    fn capToken(e: AExpr) -> CapTok {
        const k: AExprK = e.k
        return match k {
            .Name(name: n) :> { name: n, ok: true }
            .Call(callee: c, args: args) :> { name: capHyphenName(c), ok: allStrLits(args) }
            .Binary(op: o, l: l, r: r) :> capHyphenTok(o, l, r)
            .At(name: n) :> { name: "", ok: false }
            .AtItem :> { name: "", ok: false }
            .Num(raw: r) :> { name: "", ok: false }
            .Str(v: s) :> { name: "", ok: false }
            .Bool(v: b) :> { name: "", ok: false }
            .NotLit :> { name: "", ok: false }
            .Recovered :> { name: "", ok: false }
            .Variant(name: n) :> { name: "", ok: false }
            .Member(obj: o) :> { name: "", ok: false }
            .Unary(op: o) :> { name: "", ok: false }
            .Ternary(test: t) :> { name: "", ok: false }
            .Assign(target: t) :> { name: "", ok: false }
            .ArrayLit(elems: xs) :> { name: "", ok: false }
            .ObjectLit(props: ps) :> { name: "", ok: false }
            .Spread(e: x) :> { name: "", ok: false }
            .Index(obj: o) :> { name: "", ok: false }
            .Lambda(params: ps) :> { name: "", ok: false }
            .Sql(q: q) :> { name: "", ok: false }
            .Handled(h: x) :> { name: "", ok: false }
        }
    }

    fn capHyphenTok(o: BinOp, l: AExpr, r: AExpr) -> CapTok {
        if (o != BinOp.Sub) return { name: "", ok: false }
        const left: string = capHyphenName(l)
        if (left == "") return { name: "", ok: false }
        const t: CapTok = capToken(r)
        if (t.name == "") return t
        return { name: left + "-" + t.name, ok: t.ok }
    }

    // `a` or `a-b-…` (a chain of subtractions of names) → "a" / "a-b-…".
    fn capHyphenName(e: AExpr) -> string {
        const k: AExprK = e.k
        return match k {
            .Name(name: n) :> n
            .Binary(op: o, l: l, r: r) :> capHyphenPair(o, l, r)
            .At(name: n) :> ""
            .AtItem :> ""
            .Num(raw: x) :> ""
            .Str(v: s) :> ""
            .Bool(v: b) :> ""
            .NotLit :> ""
            .Recovered :> ""
            .Variant(name: n) :> ""
            .Member(obj: x) :> ""
            .Call(callee: c) :> ""
            .Unary(op: x) :> ""
            .Ternary(test: t) :> ""
            .Assign(target: t) :> ""
            .ArrayLit(elems: xs) :> ""
            .ObjectLit(props: ps) :> ""
            .Spread(e: x) :> ""
            .Index(obj: x) :> ""
            .Lambda(params: ps) :> ""
            .Sql(q: q) :> ""
            .Handled(h: x) :> ""
        }
    }

    fn capHyphenPair(o: BinOp, l: AExpr, r: AExpr) -> string {
        if (o != BinOp.Sub) return ""
        const a: string = capHyphenName(l)
        const b: string = capHyphenName(r)
        if (a == "" || b == "") return ""
        return a + "-" + b
    }

    fn allStrLits(args: AExpr[]) -> boolean {
        for (const x of args) {
            if (!isStrLitExpr(x)) return false
        }
        return true
    }

    fn isStrLitExpr(e: AExpr) -> boolean {
        const k: AExprK = e.k
        return match k {
            .Str(v: s) :> true
            .Name(name: n) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Num(raw: r) :> false
            .Bool(v: b) :> false
            .NotLit :> false
            .Recovered :> false
            .Variant(name: n) :> false
            .Member(obj: o) :> false
            .Call(callee: c) :> false
            .Unary(op: o) :> false
            .Binary(op: o) :> false
            .Ternary(test: t) :> false
            .Assign(target: t) :> false
            .ArrayLit(elems: xs) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: x) :> false
            .Index(obj: o) :> false
            .Lambda(params: ps) :> false
            .Sql(q: q) :> false
            .Handled(h: x) :> false
        }
    }

    // `db(…)`: `db` is presence-only (§23.5.2 grammar: 'db' takes no arguments).
    fn capHasArgs(e: AExpr) -> boolean {
        const k: AExprK = e.k
        return match k {
            .Call(callee: c) :> true
            .Name(name: n) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Num(raw: r) :> false
            .Str(v: s) :> false
            .Bool(v: b) :> false
            .NotLit :> false
            .Recovered :> false
            .Variant(name: n) :> false
            .Member(obj: o) :> false
            .Unary(op: o) :> false
            .Binary(op: o) :> false
            .Ternary(test: x) :> false
            .Assign(target: x) :> false
            .ArrayLit(elems: xs) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: x) :> false
            .Index(obj: o) :> false
            .Lambda(params: ps) :> false
            .Sql(q: q) :> false
            .Handled(h: x) :> false
        }
    }

    // A `<program>` in a program body is NESTED (§4.12) — an execution
    // context (worker / sidecar / scoped db) the bootstrap does not build, so
    // it is refused; its attributes still get §4.12.2's codes (each is an
    // error whatever the bootstrap builds), and its own body is walked for
    // deeper programs.
    fn nestedProgramDiags(file: string, items: AItem[], st0: AS) -> AS {
        let st: AS = st0
        for (const it of items) {
            const p: AProgram | not = programOfItem(it)
            if (p is given) {
                st = addDiag(st, file, p.span, "E-BOOTSTRAP-UNSUPPORTED", "a nested `<program>` (§4.12 — a worker, sidecar or scoped-db execution context) is not in the bootstrap")
                st = nestedProgramAttrDiags(file, p, st)
                st = nestedProgramDiags(file, p.items, st)
            }
        }
        return st
    }

    fn nestedProgramAttrDiags(file: string, p: AProgram, st0: AS) -> AS {
        let st: AS = st0
        for (const a of p.attrs) {
            if (a.name == "auth") {
                st = addDiag(st, file, a.span, "E-PROGRAM-NESTED-AUTH", "`auth=` on a nested `<program>` — a nested program is not an auth scope (§4.12.2); put `auth=` on the top-level `<program>` or on the `<page>` that needs it")
            } else if (isCookieAttr(a.name)) {
                st = addDiag(st, file, a.span, "E-PROGRAM-NESTED-SESSION", "`" + a.name + "=` on a nested `<program>` — the login cookie belongs to the whole application (§4.12.2, §20.5.1)")
            } else if (isDocumentaryAttr(a.name)) {
                st = addDiag(st, file, a.span, "W-PROGRAM-TITLE-NESTED", "`" + a.name + "=` on a nested `<program>` is head metadata with no effect there (§40.7)")
            } else if (a.name == "capabilities") {
                st = capabilitiesDiags(file, a, st)
            } else if (a.name == "kind" || a.name == "serve") {
                st = addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "=` on a nested `<program>` (§64) is not in the bootstrap")
            } else if (isNestedProgramAttr(a.name)) {
                // §4.12.2's table: valid here (the nested program itself is refused above)
            } else if (isProgramAttrName(a.name)) {
                st = addDiag(st, file, a.span, "E-PROGRAM-NESTED-ATTR", "`" + a.name + "=` is application-level and not valid on a nested `<program>` (§4.12.2 lists what a nested program may carry)")
            } else {
                st = unknownProgramAttrDiag(file, a, st)
            }
        }
        return st
    }

    // ---- fields -------------------------------------------------------------------
    // Does an initializer read cells (§66.9: derived when locked, seeded when
    // `let`)? A call counts: a function may read cells.
    fn valueReads(v: AAttrValue) -> string[] {
        return match v {
            .Bare(e: e) :> exprReads(e)
            .Paren(e: e) :> exprReads(e)
            .NoValue :> []
            .Quoted(v: s) :> []
            .Braced(b: b) :> []
        }
    }

    // The `@names` an expression reads ("()" for a call), for E-DERIVED-WRITE's message.
    fn exprReads(e: AExpr) -> string[] {
        const k: AExprK = e.k
        return match k {
            .At(name: n) :> ["@" + n]
            .AtItem :> ["@."]
            .Member(obj: o) :> exprReads(o)
            .Call(callee: c, args: args) :> ["()"].concat(listReads(args))
            .Unary(op: o, e: x) :> exprReads(x)
            .Binary(op: o, l: l, r: r) :> exprReads(l).concat(exprReads(r))
            .Ternary(test: t, yes: y, no: n) :> exprReads(t).concat(exprReads(y)).concat(exprReads(n))
            .Assign(target: t, value: v) :> exprReads(v)
            .ArrayLit(elems: es) :> listReads(es)
            .ObjectLit(props: ps) :> propReads(ps)
            .Spread(e: x) :> exprReads(x)
            .Index(obj: o, idx: i) :> exprReads(o).concat(exprReads(i))
            .Lambda(params: ps2, body: b) :> exprReads(b)
            .Sql(q: q) :> ["" + sqlSigil() + "}"].concat(listReads(q.params))      // s451: a query reads (like a call)
            .Handled(h: h) :> listReads(handledKids(h))      // s451 (Ue): the subject and the arms' values
            .Name(name: n) :> []
            .Num(raw: r) :> []
            .Str(v: s) :> []
            .Bool(v: b) :> []
            .NotLit :> []
            .Recovered :> []
            .Variant(name: n) :> []
        }
    }

    fn listReads(es: AExpr[]) -> string[] {
        let out: string[] = []
        for (const e of es) { out = out.concat(exprReads(e)) }
        return out
    }

    fn propReads(ps: AProp[]) -> string[] {
        let out: string[] = []
        for (const p of ps) { out = out.concat(exprReads(p.value)) }
        return out
    }

    // An own-value type from its literal when no annotation is written (§66.3 rule 3).
    type RMaybeType:struct = { t: Type | not, st: AS }

    fn inferredType(v: AAttrValue) -> Type | not {
        return match v {
            .Bare(e: e) :> literalType(e)
            .Paren(e: e) :> literalType(e)
            .Quoted(v: s) :> Type.Str
            .NoValue :> not
            .Braced(b: b) :> not
        }
    }

    fn literalType(e: AExpr) -> Type | not {
        const k: AExprK = e.k
        return match k {
            .Num(raw: r) :> numType(r)
            .Str(v: s) :> Type.Str
            .Bool(v: b) :> Type.Bool
            .Unary(op: o, e: x) :> literalType(x)
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Call(callee: c) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .Assign(target: t) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: sx) :> not
            .Index(obj: ix) :> not
            .Lambda(params: lp) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
        }
    }

    // L19: an integer literal infers `int`; a non-integer numeric literal `number`.
    // A hex / binary / octal literal (`0xFE`, `0b101`, `0o17`) is an integer
    // literal whatever its digits (s442 r2 F4: `0xE`'s `E` is a hex digit, not
    // an exponent). SPEC: "An integer literal infers `int`".
    fn numType(raw: string) -> Type {
        if (isRadixLiteral(raw)) return Type.Int
        if (raw.indexOf(".") >= 0 || raw.indexOf("e") >= 0 || raw.indexOf("E") >= 0) return Type.Num
        return Type.Int
    }

    fn isRadixLiteral(raw: string) -> boolean {
        if (raw.length < 3) return false
        if (raw.substring(0, 1) != "0") return false
        const p: string = raw.substring(1, 2)
        return p == "x" || p == "X" || p == "b" || p == "B" || p == "o" || p == "O"
    }

    fn hasFlag(mods: AAttr[], name: string) -> boolean {
        for (const m of mods) {
            if (m.name == name) return true
        }
        return false
    }

    type RFields:struct = { fs: FieldInfo[], st: AS }
    type RField:struct = { f: FieldInfo, st: AS }

    // One field: its type, mode (§66.9), grants (L3/L18, §66.12), graph, capability.
    // `vals` / `where` (s444 Phase B): the field's validators, and where the
    // field stands — 0 an attribute (it has none, §66.4 rule 1), 1 a child
    // field of a user declaration, 2 a program cell (a top-level value — it
    // has the surface, §55.5.1, S447). Both 1 and 2 are honored.
    fn fieldOf(te: TypeEnv, g: TypeInfo[], nid: int, span: ASpan, name: string, isLet: boolean, exported: boolean,
               aty: AType | not, init: AAttrValue, body: ADeclChild[], role: FieldRole, vals: AValidator[], where: int, st0: AS) -> RField {
        let st: AS = st0
        const rs: RSym = mint(st, name)
        st = rs.st
        let ty: Type = Type.Str
        let seqRep = false
        let resolved = true
        if (aty is given) {
            const rt: RType = resolveType(te, aty, st)
            ty = rt.t
            resolved = !rt.unresolved     // r8: an unknown type name → untrusted
            st = rt.st
            seqRep = seqReplace(aty)
        } else {
            const inf: Type | not = inferredType(init)
            if (inf is given) {
                ty = inf
            } else {
                st = addDiag(st, te.file, span, "E-TYPE-ANNOTATION-REQUIRED", "`" + name + "` needs a type annotation (`" + name + ":Type=…`) — its value is not a literal the type can be inferred from (§66.3, ⚑ O35)")
            }
        }
        if (isLet && seqElem(ty) is given) {
            st = addDiag(st, te.file, span, "E-GRANT-LET-ON-SEQUENCE", "`let` on a sequence — write `replace` in the type's grants (O3 ruled)")
        }
        const rg: RGraph = graphOf(te, g, ty, body, st)
        st = rg.st
        let edits: EditKind[] = typeEdits(ty)
        if (rg.graph is given) edits = edits.concat([EditKind.Transition])
        // s444: a sequence of structs whose element fields carry their own
        // `let` grants an ELEMENT-field write (`@xs[i].f = v`, dpa-052 Q3) —
        // listed as FieldAt(path) over the element struct (Core EditKind note)
        let elemEdits: EditKind[] = []
        const et: Type | not = seqElem(ty)
        if (et is given) elemEdits = subFieldEdits(g, et)
        const grants: GrantSet = { replace: isLet || seqRep, edits: edits.concat(subFieldEdits(g, ty)).concat(elemEdits) }
        const reads: string[] = valueReads(init)
        let mode: FieldMode = FieldMode.Locked
        if (isLet) {
            if (reads.length > 0) {
                mode = FieldMode.Seeded
            } else {
                mode = FieldMode.Let
            }
        } else if (rg.graph is not && reads.length > 0) {
            mode = FieldMode.Derived
        }
        let wcap: Sym | not = not
        if (grants.replace || grants.edits.length > 0) {
            const rw: RSym = mint(st, name)
            wcap = rw.s
            st = rw.st
        }
        // s449 — §55.5.3 case 1: "`isValid`, `errors`, `touched` and `submitted`
        // SHALL NOT be used as … the name of a child field (child declaration) or
        // an attribute of any declaration — every compound has the surface (Edge
        // B), so a field by one of these names would shadow it." A top-level
        // value's own name is "Not affected" (where 2). Case 2 (a field of a
        // validated value's STRUCT type) cannot arise here: the bootstrap admits
        // validators only on string / number values (fieldVals).
        if (where != 2 && isSurfaceProp(name)) {
            st = addDiag(st, te.file, span, "E-VALIDITY-RESERVED-NAME", "`" + name + "` is a reserved validity-surface name — a field or attribute by this name would hide the declaration's synthesized `." + name + "` (§55.5.3); rename it")
        }
        const rv: RVals = fieldVals(te.file, name, ty, mode, vals, where, st)
        st = rv.st
        const f: FieldInfo = {
            nid: nid, span: span, annotated: aty is given, trusted: resolved, typeSpan: typeSpanOf(aty), sym: rs.s, ty: ty, mode: mode, role: role, grants: grants, graph: rg.graph,
            exported: exported, wcap: wcap, init: init, reads: reads, shrink: shrinkOf(aty), vals: rv.vs, valsWritten: vals.length,
        }
        return { f: f, st: st }
    }

    // =========================================================================
    // s444 Phase B — VALIDATORS (dpa-058, RULED S442); s449 — evaluated by the
    // §55 surface and enforced by the §55.17 gate. The bootstrap's runtime
    // evaluates `req` on a string, `length` of a string against an int literal,
    // `min` / `max` against a numeric literal, and a `pattern` whose HTML
    // `pattern` form is exact; each also lowers to its HTML-native attribute
    // (RULED S442 (2), §55.17.1) on the controls that bind the value. Any other
    // validator is not evaluated yet, so it is refused (E-BOOTSTRAP-UNSUPPORTED)
    // — never kept inert (g-bootstrap-validity-errors-value-and-messages-unbuilt).
    // =========================================================================
    type RVals:struct = { vs: ValInfo[], st: AS }
    type RVal:struct = { v: ValInfo | not, st: AS }

    fn fieldVals(file: string, name: string, ty: Type, mode: FieldMode, vals: AValidator[], where: int, st0: AS) -> RVals {
        let st: AS = st0
        if (vals.length == 0) return { vs: [], st: st }
        if (where != 1 && where != 2) return { vs: [], st: addDiag(st, file, vals[0].span, "E-BOOTSTRAP-UNSUPPORTED", "validators here are not in the bootstrap (only on a top-level value or a child field of a declaration)") }
        const isDerived: boolean = mode == FieldMode.Derived
        if (isDerived) {
            return { vs: [], st: addDiag(st, file, vals[0].span, "E-DERIVED-WITH-VALIDATORS", "`" + name + "` is derived (a locked declaration whose initializer reads cells) — validators on a derived value are rejected (§55.14); constrain it with a refinement type instead") }
        }
        let out: ValInfo[] = []
        for (const v of vals) {
            const r: RVal = valInfoOf(file, ty, v, st)
            st = r.st
            const vi: ValInfo | not = r.v
            if (vi is given) out = out.concat([vi])
        }
        return { vs: out, st: st }
    }

    // s449 — B3 is RULED (S447, user-voice "validated top-level cells get a
    // validity surface (Edge A reversed)" item 1; SPEC §55.5.1): a top-level
    // value that carries validators has the surface, bound or not, and its
    // validators lower onto every control that binds it (§55.17.1) — the
    // former `topLevelValidatorsLower()` switch is gone: a program cell's
    // validators take the same path as a child field's. Dead is §55.5.2
    // (validatorPass).

    fn noSurfaceMsg(what: string) -> string {
        return what + " — the bootstrap's validity surface does not evaluate this validator yet (it evaluates `req` on a string, `length` of a string against an int literal, `min` / `max` against a numeric literal, and an exact `pattern`, §55.1); it is refused rather than left inert"
    }

    fn pair(n: string, v: string) -> HtmlAttrPair { return { name: n, value: v } }

    fn valOk(v: AValidator, attrs: HtmlAttrPair[], core: Validator, st: AS) -> RVal {
        return { v: { name: v.name, span: v.span, attrs: attrs, core: core }, st: st }
    }

    fn valBad(file: string, v: AValidator, code: string, msg: string, st: AS) -> RVal {
        return { v: not, st: addDiag(st, file, v.span, code, msg) }
    }

    fn isStrLike(t: Type) -> boolean {
        const mi: Type | not = maybeInner(t)
        if (mi is given) return mi == Type.Str
        return t == Type.Str
    }

    fn isNumLike(t: Type) -> boolean {
        let x: Type = t
        const mi: Type | not = maybeInner(t)
        if (mi is given) x = mi
        return x == Type.Int || x == Type.Num
    }

    fn valInfoOf(file: string, ty: Type, v: AValidator, st: AS) -> RVal {
        const a: AValArg = v.arg
        return match a {
            .NoArgs :> bareVal(file, ty, v, st)
            .Cmp(op: op, e: x) :> cmpVal(file, ty, v, op, x, st)
            .Exprs(es: es) :> exprsVal(file, ty, v, es, st)
            .Regex(source: src, flags: fl) :> regexVal(file, ty, v, src, fl, st)
        }
    }

    // `req` (§55.1: `""` fails, `not` fails) → `required` on a STRING value: HTML
    // `required` fails exactly the empty value. On a boolean it would mean
    // "checked" (not exact); on a number / sequence / struct there is no form.
    fn bareVal(file: string, ty: Type, v: AValidator, st: AS) -> RVal {
        if (v.name != "req") return valBad(file, v, "E-PARSE-ATTR", "`" + v.name + "` needs its argument: `" + v.name + "(…)` (§55.1)", st)
        if (isStrLike(ty)) return valOk(v, [pair("required", "")], Validator.Req, st)
        return valBad(file, v, "E-BOOTSTRAP-UNSUPPORTED", noSurfaceMsg("`req` on a `" + typeName(ty) + "` value"), st)
    }

    // `length(>=N)` / `(<=N)` / `(>N)` / `(<N)` / `(==N)` on a string, N an int
    // literal → `minlength` / `maxlength` (integer lengths: `> N` is `>= N+1`).
    fn cmpVal(file: string, ty: Type, v: AValidator, op: string, x: AExpr, st: AS) -> RVal {
        if (v.name != "length") return valBad(file, v, "E-PARSE-ATTR", "`" + v.name + "(" + op + " …)` — only `length` takes a comparison (§55.1)", st)
        if (!isStrLike(ty) && seqElem(ty) is not) return valBad(file, v, "E-TYPE-031", "`length(…)` applies to a string or a sequence, and this value is `" + typeName(ty) + "` (§55.1)", st)
        const n: int = intLit(x)
        if (!isStrLike(ty) || n < 0) return valBad(file, v, "E-BOOTSTRAP-UNSUPPORTED", noSurfaceMsg("`length(" + op + " …)` here (not a string's length against an int literal)"), st)
        const lc: Validator = Validator.LengthCmp(op, n)
        if (op == ">=") return valOk(v, [pair("minlength", "" + n)], lc, st)
        if (op == ">") return valOk(v, [pair("minlength", "" + (n + 1))], lc, st)
        if (op == "<=") return valOk(v, [pair("maxlength", "" + n)], lc, st)
        if (op == "<" && n >= 1) return valOk(v, [pair("maxlength", "" + (n - 1))], lc, st)
        if (op == "==") return valOk(v, [pair("minlength", "" + n), pair("maxlength", "" + n)], lc, st)
        return valBad(file, v, "E-BOOTSTRAP-UNSUPPORTED", noSurfaceMsg("`length(" + op + " " + n + ")`"), st)
    }

    // `min(n)` / `max(n)` on a number, n a numeric literal → `min` / `max`. A
    // Level-1 message (`req("…")`, §55.10) has no reader in the bootstrap (no
    // `messageFor`, no `<errors>`). The rest of §55.1 has no HTML form.
    fn exprsVal(file: string, ty: Type, v: AValidator, es: AExpr[], st: AS) -> RVal {
        if (v.name == "req") return valBad(file, v, "E-BOOTSTRAP-UNSUPPORTED", "`req(\"…\")` — a Level-1 message (§55.10): the bootstrap's `<errors of=…/>` renders only the Level-3 default messages, so the inline message would be dropped; write `req` and let the default message render", st)
        if (v.name == "length") return valBad(file, v, "E-PARSE-ATTR", "`length(…)` takes a comparison: `length(>=N)` (§55.1)", st)
        if (v.name == "pattern") return valBad(file, v, "E-PARSE-ATTR", "`pattern(…)` takes a regex literal: `pattern(/…/)` (§55.1)", st)
        if (v.name == "min" || v.name == "max") {
            if (!isNumLike(ty)) return valBad(file, v, "E-TYPE-031", "`" + v.name + "(…)` applies to a number, and this value is `" + typeName(ty) + "` (§55.1)", st)
            const lit: string = numLitText(es)
            if (lit == "") return valBad(file, v, "E-BOOTSTRAP-UNSUPPORTED", noSurfaceMsg("`" + v.name + "(…)` with a non-literal bound"), st)
            const bound: number = Number(lit)
            let mc: Validator = Validator.Max(bound)
            if (v.name == "min") mc = Validator.Min(bound)
            return valOk(v, [pair(v.name, lit)], mc, st)
        }
        return valBad(file, v, "E-BOOTSTRAP-UNSUPPORTED", noSurfaceMsg("`" + v.name + "(…)`"), st)
    }

    // `pattern(/re/)` on a string → `pattern="re"` ONLY WHEN EXACT (RULED S442
    // (2), dpa-058 D6): no flags, anchored `^…$`, no top-level alternation, and
    // written in the subset that reads the same under HTML's `v`-mode regex.
    fn regexVal(file: string, ty: Type, v: AValidator, src: string, flags: string, st: AS) -> RVal {
        if (v.name != "pattern") return valBad(file, v, "E-PARSE-ATTR", "`" + v.name + "(…)` does not take a regex (§55.1)", st)
        if (!isStrLike(ty)) return valBad(file, v, "E-TYPE-031", "`pattern(…)` applies to a string, and this value is `" + typeName(ty) + "` (§55.1)", st)
        if (flags != "" || !exactPattern(src)) {
            return valBad(file, v, "E-BOOTSTRAP-UNSUPPORTED", noSurfaceMsg("`pattern(/" + src + "/" + flags + ")` — a pattern is admitted only when its HTML `pattern` attribute says the same (no flags, `^…$` anchoring, no top-level `|`, plain characters / classes), so the browser's attribute and the surface agree"), st)
        }
        return valOk(v, [pair("pattern", src)], Validator.Pattern(src), st)
    }

    // The value of a non-negative int literal (-1: not one).
    fn intLit(x: AExpr) -> int {
        const k: AExprK = x.k
        return match k {
            .Num(raw: r) :> intOfRaw(r)
            .Name(name: n) :> -1
            .At(name: n) :> -1
            .AtItem :> -1
            .Str(v: s) :> -1
            .Bool(v: b) :> -1
            .NotLit :> -1
            .Recovered :> -1
            .Variant(name: n) :> -1
            .Member(obj: o) :> -1
            .Call(callee: c) :> -1
            .Unary(op: o) :> -1
            .Binary(op: o) :> -1
            .Ternary(test: t) :> -1
            .Assign(target: t) :> -1
            .ArrayLit(elems: es) :> -1
            .ObjectLit(props: ps) :> -1
            .Spread(e: sx) :> -1
            .Index(obj: ix) :> -1
            .Lambda(params: lp) :> -1
            .Sql(q: q) :> -1
            .Handled(h: x) :> -1
        }
    }

    fn intOfRaw(r: string) -> int {
        if (numType(r) != Type.Int || isRadixLiteral(r)) return -1
        const n: number = Number(r)
        return n
    }

    // The text of the one numeric literal argument (`-` allowed) — "" otherwise.
    fn numLitText(es: AExpr[]) -> string {
        if (es.length != 1) return ""
        const k: AExprK = es[0].k
        return match k {
            .Num(raw: r) :> decimalText(r)
            .Unary(op: o, e: x) :> negText(o, x)
            .Name(name: n) :> ""
            .At(name: n) :> ""
            .AtItem :> ""
            .Str(v: s) :> ""
            .Bool(v: b) :> ""
            .NotLit :> ""
            .Recovered :> ""
            .Variant(name: n) :> ""
            .Member(obj: o) :> ""
            .Call(callee: c) :> ""
            .Binary(op: o) :> ""
            .Ternary(test: t) :> ""
            .Assign(target: t) :> ""
            .ArrayLit(elems: xs) :> ""
            .ObjectLit(props: ps) :> ""
            .Spread(e: sx) :> ""
            .Index(obj: ix) :> ""
            .Lambda(params: lp) :> ""
            .Sql(q: q) :> ""
            .Handled(h: x) :> ""
        }
    }

    fn decimalText(r: string) -> string {
        if (isRadixLiteral(r)) return ""
        return r
    }

    fn negText(o: UnOp, x: AExpr) -> string {
        const isNeg: boolean = o == UnOp.Neg
        if (!isNeg) return ""
        const t: string = numLitText([x])
        if (t == "") return ""
        return "-" + t
    }

    // EXACT as HTML's `pattern` (compiled `^(?:p)$` with the `v` flag): anchored
    // `^…$`, no `|` outside a group, and only the plain subset — letters,
    // digits, `_`, space, `.`, `*`, `+`, `?`, `@`, `-` (outside a class),
    // groups `(…)` / `(?:…)`, `{n}` / `{n,m}`, the escapes `\d \w \s \D \W \S`
    // and escaped syntax characters, and classes of letters / digits / `_` /
    // ranges / those escapes. Anything else is not claimed exact.
    fn exactPattern(src: string) -> boolean {
        if (src.length < 2) return false
        if (src.substring(0, 1) != "^") return false
        if (src.substring(src.length - 1) != "$") return false
        if (src.length >= 2 && src.substring(src.length - 2, src.length - 1) == "\\") return false
        let i = 1
        let depth = 0
        const end: int = src.length - 1
        while (i < end) {
            const c: string = src.substring(i, i + 1)
            if (c == "\\") {
                if (!safeEscape(src.substring(i + 1, i + 2))) return false
                i = i + 2
            } else if (c == "[") {
                const close: int = classEnd(src, i + 1)
                if (close < 0) return false
                i = close + 1
            } else if (c == "(") {
                depth = depth + 1
                if (src.substring(i + 1, i + 2) == "?") {
                    if (src.substring(i + 2, i + 3) != ":") return false
                    i = i + 3
                } else {
                    i = i + 1
                }
            } else if (c == ")") {
                depth = depth - 1
                if (depth < 0) return false
                i = i + 1
            } else if (c == "|") {
                if (depth == 0) return false
                i = i + 1
            } else if (c == "{") {
                const q: int = quantEnd(src, i + 1)
                if (q < 0) return false
                i = q + 1
            } else if (plainChar(c) || c == "." || c == "*" || c == "+" || c == "?" || c == "-") {
                i = i + 1
            } else {
                return false
            }
        }
        return depth == 0
    }

    fn plainChar(c: string) -> boolean {
        if (c == "_" || c == " " || c == "@") return true
        return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9")
    }

    fn alnum(c: string) -> boolean {
        return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9")
    }

    fn safeEscape(c: string) -> boolean {
        return c == "d" || c == "w" || c == "s" || c == "D" || c == "W" || c == "S" ||
               c == "." || c == "*" || c == "+" || c == "?" || c == "(" || c == ")" || c == "[" || c == "]" ||
               c == "{" || c == "}" || c == "|" || c == "^" || c == "$" || c == "/" || c == "\\"
    }

    // The index of the `]` closing a class opened before `from` (-1: not in the subset).
    fn classEnd(src: string, from: int) -> int {
        let i: int = from
        if (src.substring(i, i + 1) == "^") i = i + 1
        let first = true
        while (i < src.length) {
            const c: string = src.substring(i, i + 1)
            if (c == "]") {
                if (first) return -1
                return i
            }
            if (c == "\\") {
                const e: string = src.substring(i + 1, i + 2)
                if (!(e == "d" || e == "w" || e == "s" || e == "D" || e == "W" || e == "S")) return -1
                i = i + 2
            } else if (alnum(c) && src.substring(i + 1, i + 2) == "-" && alnum(src.substring(i + 2, i + 3))) {
                i = i + 3
            } else if (alnum(c) || c == "_") {
                i = i + 1
            } else {
                return -1
            }
            first = false
        }
        return -1
    }

    // The index of the `}` ending a `{n}` / `{n,}` / `{n,m}` quantifier (-1: not one).
    fn quantEnd(src: string, from: int) -> int {
        let i: int = from
        let digits = 0
        while (i < src.length && src.substring(i, i + 1) >= "0" && src.substring(i, i + 1) <= "9") {
            i = i + 1
            digits = digits + 1
        }
        if (digits == 0) return -1
        if (src.substring(i, i + 1) == ",") {
            i = i + 1
            while (i < src.length && src.substring(i, i + 1) >= "0" && src.substring(i, i + 1) <= "9") { i = i + 1 }
        }
        if (src.substring(i, i + 1) != "}") return -1
        return i
    }

    // The struct sub-field writes a field of struct type grants (M1 D12: a
    // field whose writable part is a sub-field lists `FieldAt(path)`): each
    // sub-field that has its own `let` or `rule=` graph.
    fn subFieldEdits(g: TypeInfo[], ty: Type) -> EditKind[] {
        const s: Sym | not = namedOf(ty)
        if (s is not) return []
        const ti: TypeInfo | not = typeInfoOf(g, s)
        if (ti is not) return []
        const fs: FieldDef[] | not = structFieldDefs(ti.def)
        if (fs is not) return []
        let out: EditKind[] = []
        let i = 0
        for (const fd of fs) {
            if (fd.grants.replace) out = out.concat([EditKind.FieldAt([{ owner: s, idx: i }])])
            i = i + 1
        }
        return out
    }

    type RGraph:struct = { graph: TransitionGraph | not, st: AS }

    // L18 / §66.13.2: state-children with `rule=` make the field's value a graph
    // (O52 ruled: a state-child names a variant of the field's enum).
    fn graphOf(te: TypeEnv, g: TypeInfo[], ty: Type, body: ADeclChild[], st0: AS) -> RGraph {
        let st: AS = st0
        let children: AStateChild[] = []
        for (const c of body) { children = children.concat(stateChildOf(c)) }
        if (children.length == 0) return { graph: not, st: st }
        const es: Sym | not = isEnumType(g, ty)
        if (es is not) {
            return { graph: not, st: addDiag(st, te.file, children[0].span, "E-DECL-STATE-CHILD", "state-children need an enum-valued field (§66.13.2)") }
        }
        let edges: Edge[] = []
        let seen: int[] = []
        for (const c of children) {
            const origin: int = variantIndex(g, es, c.name)
            if (origin >= 0 && seen.indexOf(origin) >= 0) {
                // r1 nit: one state-child per variant
                st = addDiag(st, te.file, c.span, "E-DECL-STATE-CHILD", "`<" + c.name + ">` is declared twice in this graph — a variant has one state-child (its edges and body)")
            }
            seen = seen.concat([origin])
            if (origin < 0) {
                st = addDiag(st, te.file, c.span, "E-DECL-STATE-CHILD", "`<" + c.name + ">` is not a variant of `" + es.hint + "` (O52: a state-child names a variant of the enclosing field)")
            } else {
                let targets: int[] = []
                for (const a of c.attrs) {
                    if (a.name == "rule") {
                        const names: string[] = ruleNames(a.value)
                        for (const n of names) {
                            const ti: int = variantIndex(g, es, n)
                            if (ti < 0) {
                                st = addDiag(st, te.file, a.span, "E-DECL-STATE-CHILD", "`rule=." + n + "`: not a variant of `" + es.hint + "`")
                            } else {
                                targets = targets.concat([ti])
                            }
                        }
                    } else {
                        // s451: any other attribute on a state-child (`show=`,
                        // `title=`, …) was read by nothing — silently ignored.
                        st = addDiag(st, te.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "` on the state-child `<" + c.name + ">` is not in the bootstrap — a state-child reads only `rule=` (§66.13.2); the attribute would be ignored")
                    }
                }
                edges = edges.concat([{ origin: origin, targets: targets }])
            }
        }
        return { graph: { enumSym: es, edges: edges }, st: st }
    }

    fn stateChildOf(c: ADeclChild) -> AStateChild[] {
        return match c {
            .StateChild(s: s) :> [s]
            .ChildField(d: d) :> []
        }
    }

    // `rule=.X` or `rule=(.X | .Y)` → the variant names.
    fn ruleNames(v: AAttrValue) -> string[] {
        return match v {
            .Bare(e: e) :> altNames(e)
            .Paren(e: e) :> altNames(e)
            .NoValue :> []
            .Quoted(v: s) :> []
            .Braced(b: b) :> []
        }
    }

    fn altNames(e: AExpr) -> string[] {
        const k: AExprK = e.k
        return match k {
            .Variant(name: n) :> [n]
            .Binary(op: o, l: l, r: r) :> altNames(l).concat(altNames(r))
            .Name(name: n) :> []
            .At(name: n) :> []
            .AtItem :> []
            .Num(raw: r) :> []
            .Str(v: s) :> []
            .Bool(v: b) :> []
            .NotLit :> []
            .Recovered :> []
            .Member(obj: o) :> []
            .Call(callee: c) :> []
            .Unary(op: o) :> []
            .Ternary(test: t) :> []
            .Assign(target: t) :> []
            .ArrayLit(elems: es) :> []
            .ObjectLit(props: ps) :> []
            .Spread(e: sx) :> []
            .Index(obj: ix) :> []
            .Lambda(params: lp) :> []
            .Sql(q: q) :> []
            .Handled(h: x) :> []
        }
    }

    fn childFields(body: ADeclChild[]) -> ADecl[] {
        let out: ADecl[] = []
        for (const c of body) { out = out.concat(childFieldOf(c)) }
        return out
    }

    fn childFieldOf(c: ADeclChild) -> ADecl[] {
        return match c {
            .ChildField(d: d) :> [d]
            .StateChild(s: s) :> []
        }
    }

    // A user declaration's fields (L17): attributes in opener order, then child
    // fields in body order.
    fn userFields(te: TypeEnv, g: TypeInfo[], d: ADecl, st0: AS) -> RFields {
        let st: AS = st0
        let out: FieldInfo[] = []
        for (const a of d.attrs) {
            const r: RField = fieldOf(te, g, a.nid, a.span, a.name, a.isLet, a.exported, a.ty, a.dflt, [], FieldRole.Attribute, [], 0, st)
            out = out.concat([r.f])
            st = r.st
        }
        for (const c of childFields(d.body)) {
            if (hasFlag(c.mods, "single")) {
                // s442, §66.13.4: the Move-20 invariant — one declaration site
                // inside N instances cannot be one instance.
                st = addDiag(st, te.file, c.span, "E-COMPONENT-ENGINE-SCOPE", "`<" + c.name + " … single>` is a `single` declaration inside the multi-instance declaration `<" + d.name + ">` — every `<" + d.name + ">` instance would share one `" + c.name + "`. Drop `single`: an ordinary child field gives each `<" + d.name + ">` its own `" + c.name + "` (§66.13.4)")
            }
            const r2: RField = fieldOf(te, g, c.nid, c.span, c.name, c.isLet, c.exported, c.ty, c.own, c.body, FieldRole.Child, c.validators, 1, st)
            out = out.concat([r2.f])
            st = r2.st
        }
        return { fs: out, st: st }
    }

    // The program's fields: the declarations directly in its body (L14).
    fn programFields(te: TypeEnv, g: TypeInfo[], p: AProgram, st0: AS) -> RFields {
        let st: AS = st0
        let out: FieldInfo[] = []
        for (const it of p.items) {
            for (const d of declsOfItem(it)) {
                if (isNestedUserDecl(d)) {
                    // a user declaration (stubbed by withNestedStubs), not a field
                } else {
                    const r: RField = fieldOf(te, g, d.nid, d.span, d.name, d.isLet, d.exported, d.ty, d.own, d.body, FieldRole.Child, d.validators, 2, st)
                    out = out.concat([r.f])
                    st = r.st
                }
            }
        }
        return { fs: out, st: st }
    }

    fn declsOfItem(it: AItem) -> ADecl[] {
        const k: AItemK = it.k
        return match k {
            .DeclItem(d: d) :> [d]
            .ImportItem(i: i) :> []
            .TypeItem(t: t) :> []
            .FnItem(f: f) :> []
            .MarkupItem(n: n) :> []
            .ProgramItem(p: p) :> []
        }
    }

    // ---- handles (L10) ---------------------------------------------------------------
    // Walk a renders: every USE with `as=` binds a handle on the nearest
    // enclosing `<each>` row, else on the declaration. Conditional = under an
    // `if=` (inside the same row scope).
    type RHandles:struct = { hs: HandleInfo[], st: AS }
    type HWalk:struct = { owner: int, conditional: boolean, file: string }

    fn handlesIn(g0: DeclStub[], nodes: ANode[], w: HWalk, st0: AS) -> RHandles {
        let st: AS = st0
        let out: HandleInfo[] = []
        for (const n of nodes) {
            const r: RHandles = handlesInNode(g0, n, w, st)
            out = out.concat(r.hs)
            st = r.st
        }
        return { hs: out, st: st }
    }

    fn handlesInNode(g0: DeclStub[], n: ANode, w: HWalk, st: AS) -> RHandles {
        const k: ANodeK = n.k
        return match k {
            .Elem(e: e) :> handlesInElem(g0, e, w, st)
            .Text(text: t) :> noHandles(st)
            .Interp(e: x) :> noHandles(st)
            .DeclNode(d: d) :> noHandles(st)
            .Effect(w: w) :> noHandles(st)
        }
    }

    fn noHandles(st: AS) -> RHandles { return { hs: [], st: st } }

    fn attrNamed(attrs: AAttr[], name: string) -> AAttr | not {
        for (const a of attrs) {
            if (a.name == name) return a
        }
        return not
    }

    fn bareName(v: AAttrValue) -> string {
        return match v {
            .Bare(e: e) :> exprName(e)
            .Paren(e: e) :> exprName(e)
            .Quoted(v: s) :> ""
            .NoValue :> ""
            .Braced(b: b) :> ""
        }
    }

    fn exprName(e: AExpr) -> string {
        const k: AExprK = e.k
        return match k {
            .Name(name: n) :> n
            .At(name: n) :> ""
            .AtItem :> ""
            .Num(raw: r) :> ""
            .Str(v: s) :> ""
            .Bool(v: b) :> ""
            .NotLit :> ""
            .Recovered :> ""
            .Variant(name: n) :> ""
            .Member(obj: o) :> ""
            .Call(callee: c) :> ""
            .Unary(op: o) :> ""
            .Binary(op: o) :> ""
            .Ternary(test: t) :> ""
            .Assign(target: t) :> ""
            .ArrayLit(elems: es) :> ""
            .ObjectLit(props: ps) :> ""
            .Spread(e: sx) :> ""
            .Index(obj: ix) :> ""
            .Lambda(params: lp) :> ""
            .Sql(q: q) :> ""
            .Handled(h: x) :> ""
        }
    }

    fn stubNamedDecl(g0: DeclStub[], name: string) -> DeclStub | not {
        for (const d of g0) {
            if (!d.isProgram && d.sym.hint == name) return d
        }
        return not
    }

    fn handlesInElem(g0: DeclStub[], e: AElem, w: HWalk, st0: AS) -> RHandles {
        let st: AS = st0
        let out: HandleInfo[] = []
        const cond: boolean = w.conditional || attrNamed(e.attrs, "if") is given || attrNamed(e.attrs, "else-if") is given || attrNamed(e.attrs, "else") is given
        if (e.tag == "each" && !e.star) {
            // a row scope: handles inside it live on the row, conditional relative to the row
            const r: RHandles = handlesIn(g0, e.kids, { owner: e.nid, conditional: false, file: w.file }, st)
            return { hs: r.hs, st: r.st }
        }
        const target: DeclStub | not = stubNamedDecl(g0, e.tag)
        if (target is given && !e.star) {
            const as: AAttr | not = attrNamed(e.attrs, "as")
            if (as is given) {
                const name: string = bareName(as.value)
                if (name == "") {
                    st = addDiag(st, w.file, as.span, "E-DECL-AS", "`as=` takes a name")
                } else {
                    const rs: RSym = mint(st, name)
                    st = rs.st
                    out = out.concat([{ sym: rs.s, name: name, target: target.sym, owner: w.owner, conditional: cond,
                                        span: as.span, file: w.file }])
                }
            }
        }
        const r2: RHandles = handlesIn(g0, e.kids, { owner: w.owner, conditional: cond, file: w.file }, st)
        return { hs: out.concat(r2.hs), st: r2.st }
    }

    fn markupNodes(items: AItem[]) -> ANode[] {
        let out: ANode[] = []
        for (const it of items) { out = out.concat(markupOf(it)) }
        return out
    }

    fn markupOf(it: AItem) -> ANode[] {
        const k: AItemK = it.k
        return match k {
            .MarkupItem(n: n) :> [n]
            .ImportItem(i: i) :> []
            .TypeItem(t: t) :> []
            .FnItem(f: f) :> []
            .DeclItem(d: d) :> []
            .ProgramItem(p: p) :> []
        }
    }

    fn rendersNodes(ds: DeclStub) -> ANode[] {
        const p: AProgram | not = ds.p
        if (p is given) return markupNodes(p.items)
        const d: ADecl | not = ds.d
        if (d is not) return []
        const r: AElem | not = d.renders
        if (r is not) return []
        return [{ nid: -1, span: r.span, k: ANodeK.Elem(r) }]
    }

    // ---- functions ---------------------------------------------------------------------
    type RFns:struct = { fs: FnSrc[], st: AS }

    fn fnsOf(files: FileAst[], te: TypeEnv, st0: AS) -> RFns {
        let st: AS = st0
        let out: FnSrc[] = []
        for (const f of files) {
            const fte: TypeEnv = { stubs: te.stubs, declNames: te.declNames, declSyms: te.declSyms, file: f.path }
            for (const af of fnItems(f.items)) {
                const r: RSym = mint(st, af.name)
                st = r.st
                // each signature component is judged by its own type
                // expression: the return type alone, the parameter list as a
                // whole (an untyped or mis-typed parameter voids the arity)
                let ret: Type | not = not
                const at: AType | not = af.ret
                if (at is given) {
                    if (!isVoidType(at) && !hasErrIn(f.errs, at.span)) {
                        const rt: RType = resolveType(fte, at, st)
                        // guard (i), r7 A: a return type that did not resolve
                        // (E-TYPE-UNKNOWN answers with a placeholder type) is
                        // left unresolved — never checked against, never trusted
                        if (!rt.unresolved) ret = rt.t
                        st = rt.st
                    }
                }
                let arity: int = af.params.length
                if (!paramsTrusted(f.errs, af.params)) arity = -1
                const re: RErrType = errTypeOf(fte, f, af, st)
                st = re.st
                const info: FnInfo = { nid: af.nid, span: af.span, sym: r.s, name: af.name, file: f.path,
                                       exported: af.exported, pure: af.pure, arity: arity, ret: ret,
                                       failable: af.failable, err: re.err,
                                       serverOwn: af.server || sqlsInBlock(af.body).length > 0, rerr: not }
                st = addBind(st, af.nid, BindFact.BBind(r.s))
                out = out.concat([{ info: info, f: af }])
            }
        }
        return { fs: out, st: st }
    }

    // s451 (Ue) — a `!` function's error type. §19.4.2 "`!` without
    // `-> ErrorType` uses a built-in default error enum: `Error`"; §19.4.4.1
    // "The error type after `!` SHALL be an enum type … A non-enum error type
    // SHALL be E-ERROR-011" (scalar, sequence, `T | not` — "they fail for one
    // reason, not several"). A type that does not resolve is E-TYPE-UNKNOWN's.
    type RErrType:struct = { err: Sym | not, st: AS }

    fn errTypeOf(te: TypeEnv, f: FileAst, af: AFn, st: AS) -> RErrType {
        if (!af.failable) return { err: not, st: st }
        const at: AType | not = af.err
        if (at is not) return { err: builtinSym(te.stubs, "Error"), st: st }
        if (hasErrIn(f.errs, at.span)) return { err: not, st: st }
        const rt: RType = resolveType(te, at, st)
        if (rt.unresolved) return { err: not, st: rt.st }
        const es: Sym | not = enumStubSym(te, rt.t)
        if (es is given) return { err: es, st: rt.st }
        return { err: not, st: addDiag(rt.st, f.path, at.span, "E-ERROR-011", "the error type of `" + af.name + "(…)!` is not an enum — §19.4.4.1: \"The error type after `!` SHALL be an enum type\" (a `:enum` declaration, or the built-in `Error` when it is omitted). Declare the failures as variants: `type " + af.name + "Error:enum = { … }`") }
    }

    // =========================================================================
    // s454 (U1b) — THE FAILURE ENUM OF A CLIENT CALL (§19.9.10 "The failure set
    // of a client call (S454)"): "At a client call site … of a server-placed
    // function `f`, the call fails with: `f`'s declared error enum's variants
    // (when `f` is declared `! E`) … **plus** ONE variant, **`Transport(t:
    // ServerCallError)`** … For an `f` not declared `!`, the failure set is
    // `Transport(t: ServerCallError)` alone." and "A declared variant named
    // `Transport`": "If `f`'s declared enum has a variant `Transport` whose
    // payload is exactly `(t: ServerCallError)`, that variant IS the wrapper …
    // A declared variant named `Transport` with any other payload (or none)
    // SHALL be a compile error at the client call site — **`E-ERROR-016`**".
    //
    // Design Item 1 B "Core shape": "Lower mints one EnumDef per declared error
    // enum used at a remote site — `E+Transport` = `E`'s variants followed by
    // `Transport(t: ServerCallError)` (merged when `E` already has it) — plus one
    // shared `{ Transport(t: ServerCallError) }` for non-`!` callees." Minted HERE
    // (phase A, before any arm is resolved against it), once per declared enum,
    // for every function whose own body places it on the server — a callee
    // that may be called from the client (whether a site is a client call is
    // decided per site, §19.9.10 "placement is whole-program"). The minted enums
    // live in the built-in file: one ships in Core only when Core names it.
    // E's variants come FIRST, in order, so a variant's index is the same in `E`
    // and in `E + Transport` (an arm resolved against either reads the same).
    // =========================================================================
    type RRemoteEnums:struct = { fs: FnSrc[], minted: TypeInfo[], st: AS }
    // A declared enum's id (-1: the shared enum of a non-`!` callee) → its remote enum.
    type RemoteMemo:struct = { enumId: int, remote: Sym }
    type RMintedEnum:struct = { ti: TypeInfo, st: AS }

    fn remoteEnums(fs: FnSrc[], ts: TypeInfo[], sce: Sym, st0: AS) -> RRemoteEnums {
        let st: AS = st0
        let minted: TypeInfo[] = []
        let memo: RemoteMemo[] = []
        let out: FnSrc[] = []
        for (const f of fs) {
            let rerr: Sym | not = not
            if (f.info.serverOwn) {
                const e: Sym | not = f.info.err
                let key: int = -1
                let make = true
                if (f.info.failable) {
                    if (e is given) {
                        key = e.id
                        const shape: int = transportShape(ts, e, sce)
                        if (shape == 0) {
                            rerr = e              // E declares `Transport(t: ServerCallError)`: E IS the set
                            make = false
                        } else if (shape == 1) {
                            make = false          // another `Transport`: E-ERROR-016 at each client call site
                        }
                    } else {
                        make = false              // not an enum: E-ERROR-011 reported
                    }
                }
                if (make) {
                    // (named `prior`, not `known`: impl#1 resolves a narrowed local that shares
                    // a top-level function's name to that FUNCTION — dogfood finding, progress.md)
                    const prior: Sym | not = remoteMemoOf(memo, key)
                    if (prior is given) {
                        rerr = prior
                    } else {
                        const rm: RMintedEnum = mintRemoteEnum(ts, e, key, sce, st)
                        st = rm.st
                        minted = minted.concat([rm.ti])
                        const ms: Sym = typeDefSym(rm.ti.def)
                        memo = memo.concat([{ enumId: key, remote: ms }])
                        rerr = ms
                    }
                }
            }
            out = out.concat([{ info: withRemoteErr(f.info, rerr), f: f.f }])
        }
        return { fs: out, minted: minted, st: st }
    }

    fn remoteMemoOf(memo: RemoteMemo[], key: int) -> Sym | not {
        for (const m of memo) {
            if (m.enumId == key) return m.remote
        }
        return not
    }

    fn withRemoteErr(i: FnInfo, rerr: Sym | not) -> FnInfo {
        return { nid: i.nid, span: i.span, sym: i.sym, name: i.name, file: i.file, exported: i.exported,
                 pure: i.pure, arity: i.arity, ret: i.ret, failable: i.failable, err: i.err,
                 serverOwn: i.serverOwn, rerr: rerr }
    }

    // Does enum `e` declare a variant named `Transport`: -1 none; 0 exactly
    // `Transport(t: ServerCallError)` (§19.9.10 "that variant IS the wrapper");
    // 1 any other payload, or none (E-ERROR-016).
    export fn transportShape(ts: TypeInfo[], e: Sym, sce: Sym) -> int {
        const t: TypeInfo | not = typeInfoOf(ts, e)
        if (t is not) return -1
        for (const v of enumVariants(t.def)) {
            if (v.sym.hint == "Transport") {
                if (v.fields.length == 1 && v.fields[0].sym.hint == "t" && v.fields[0].ty == Type.Named(sce)) return 0
                return 1
            }
        }
        return -1
    }

    // `E + Transport` (or, key -1, the shared `Transport` enum): fresh Syms for
    // every variant and payload field (one declaration site per Sym).
    fn mintRemoteEnum(ts: TypeInfo[], e: Sym | not, key: int, sce: Sym, st0: AS) -> RMintedEnum {
        let st: AS = st0
        let name: string = "Transport"
        let vs: VariantDef[] = []
        if (key >= 0 && e is given) {
            name = e.hint + " + Transport"
            const t: TypeInfo | not = typeInfoOf(ts, e)
            if (t is given) {
                for (const v of enumVariants(t.def)) {
                    const rv: RSym = mint(st, v.sym.hint)
                    st = rv.st
                    let fds: FieldDef[] = []
                    for (const fd of v.fields) {
                        const rf: RSym = mint(st, fd.sym.hint)
                        st = rf.st
                        fds = fds.concat([{ sym: rf.s, ty: fd.ty, grants: noGrants() }])
                    }
                    vs = vs.concat([{ sym: rv.s, fields: fds }])
                }
            }
        }
        const re: RSym = mint(st, name)
        st = re.st
        const rt: RSym = mint(st, "Transport")
        st = rt.st
        const rtf: RSym = mint(st, "t")
        st = rtf.st
        vs = vs.concat([{ sym: rt.s, fields: [{ sym: rtf.s, ty: Type.Named(sce), grants: noGrants() }] }])
        const ti: TypeInfo = { nid: -1, span: mkSpan(0, 0), name: name, file: builtinFile(), exported: false, def: TypeDef.EnumDef(re.s, vs) }
        return { ti: ti, st: st }
    }

    // The enum a resolved type names (a `type … :enum` or a built-in one), else not.
    fn enumStubSym(te: TypeEnv, t: Type) -> Sym | not {
        const s: Sym | not = namedOf(t)
        if (s is not) return not
        for (const st of te.stubs) {
            if (st.sym.id == s.id && st.isEnum) return s
        }
        return not
    }

    // Did the parser report an error inside `span`?
    fn hasErrIn(errs: ASpan[], span: ASpan) -> boolean {
        for (const e of errs) {
            if (e.start >= span.start && e.end <= span.end) return true
        }
        return false
    }


    fn fileErrs(files: FileAst[], path: string) -> ASpan[] {
        for (const f of files) {
            if (f.path == path) return f.errs
        }
        return []
    }

    // A field is untrusted only when ITS OWN written type failed to parse
    // (a parser error inside the type expression's span).
    fn trustFields(fs: FieldInfo[], errs: ASpan[]) -> FieldInfo[] {
        let out: FieldInfo[] = []
        for (const f of fs) {
            out = out.concat([{ nid: f.nid, span: f.span, annotated: f.annotated, trusted: f.trusted && typeTrusted(errs, f.typeSpan),
                                typeSpan: f.typeSpan, sym: f.sym, ty: f.ty, mode: f.mode, role: f.role, grants: f.grants,
                                graph: f.graph, exported: f.exported, wcap: f.wcap, init: f.init, reads: f.reads, shrink: f.shrink, vals: f.vals, valsWritten: f.valsWritten }])
        }
        return out
    }

    fn typeSpanOf(at: AType | not) -> ASpan | not {
        if (at is not) return not
        return at.span
    }

    fn typeTrusted(errs: ASpan[], span: ASpan | not) -> boolean {
        if (span is not) return true
        return !hasErrIn(errs, span)
    }

    // Every parameter is written with a type, and none of those types failed to parse.
    fn paramsTrusted(errs: ASpan[], ps: AParam[]) -> boolean {
        for (const p of ps) {
            const at: AType | not = p.ty
            if (at is not) return false
            if (hasErrIn(errs, at.span)) return false
        }
        return true
    }

    // `-> void` (§7.5 primitive-type) declares that the function returns no value.
    fn isVoidType(at: AType) -> boolean {
        const k: ATypeK = at.k
        return match k {
            .TName(name: n) :> n == "void"
            .TSeq(elem: e) :> false
            .TMaybe(inner: i) :> false
        }
    }

    fn fnItems(items: AItem[]) -> AFn[] {
        let out: AFn[] = []
        for (const it of items) { if (!isLaterProgram(items, it)) out = out.concat(fnItemOf(it)) }   // s451: a second top-level program is E-PROGRAM-002, not read
        return out
    }

    fn fnItemOf(it: AItem) -> AFn[] {
        const k: AItemK = it.k
        return match k {
            .FnItem(f: f) :> [f]
            .ProgramItem(p: p) :> fnItems(p.items)
            .ImportItem(i: i) :> []
            .TypeItem(t: t) :> []
            .DeclItem(d: d) :> []
            .MarkupItem(n: n) :> []
        }
    }

    // s442: `<accent:swatch label="Accent" …/>` — a declaration whose own type
    // names a DECLARATION is a named shared instance (§66.8.2; `:Decl` is a
    // typed own value, #16). Not in the bootstrap: it is reported where it is
    // written, instead of reading as a field-less declaration named `accent`.
    fn namedInstanceDiags(ds: DeclStub[], declNames: string[], files: FileAst[], st0: AS) -> AS {
        let st: AS = st0
        for (const s of ds) {
            const d: ADecl | not = s.d
            if (d is given) {
                const n: string = ownTypeName(d)
                if (n != "" && declNames.indexOf(n) >= 0) {
                    st = addDiag(st, s.file, d.span, "E-BOOTSTRAP-UNSUPPORTED", "`<" + d.name + ":" + n + " …/>` is a named shared instance of `<" + n + ">` (§66.8.2) — not in the bootstrap")
                } else {
                    st = o19Diags(s.file, d, st)
                    st = openerWordDiags(s.file, fileErrs(files, s.file), d, false, st)
                    // s444 Phase B: a user declaration's OWN validators, and a field's below depth 1
                    if (d.validators.length > 0) st = addDiag(st, s.file, d.validators[0].span, "E-BOOTSTRAP-UNSUPPORTED", "validators on `<" + d.name + ">`'s own opener bind its own value (§66.4 rule 3) — a user declaration's own value is not bindable in the bootstrap; put them on a child field")
                    for (const c of childFields(d.body)) { st = deepValidatorDiags(s.file, c.body, st) }
                }
            }
            const p: AProgram | not = s.p
            if (p is given) {
                // the program's cells (a nested user declaration is its own stub)
                for (const it of p.items) {
                    for (const c of declsOfItem(it)) {
                        if (!isNestedUserDecl(c) && declNames.indexOf(ownTypeName(c)) < 0) st = openerWordDiags(s.file, fileErrs(files, s.file), c, s.isProgram, st)
                        if (!isNestedUserDecl(c)) st = deepValidatorDiags(s.file, c.body, st)
                    }
                }
            }
        }
        return st
    }

    // s444 (PA): an opener word the bootstrap does not READ used to land in
    // ADecl.mods and be silently ignored (analyze reads only `single`; the
    // parser reports validators) — e.g. §6.14 `persist="local" key="…"`.
    // Every other word is refused here, on the declaration and on every child
    // field at any depth. (A named shared instance's construction words are
    // not opener words — it is refused as a whole, namedInstanceDiags.)
    // s444 Phase B: validators on a declaration nested BELOW a child field (the
    // bootstrap models one level of child fields) are refused, never dropped.
    fn deepValidatorDiags(file: string, body: ADeclChild[], st0: AS) -> AS {
        let st: AS = st0
        for (const g of childFields(body)) {
            if (g.validators.length > 0) st = addDiag(st, file, g.validators[0].span, "E-BOOTSTRAP-UNSUPPORTED", "validators on `<" + g.name + ">` (a field nested below a child field) are not in the bootstrap")
            st = deepValidatorDiags(file, g.body, st)
        }
        return st
    }

    // A declaration holding a parse error is recovery debris there (Rule C).
    // `cell`: `d` is a program cell (the only place the bootstrap reads
    // `reset-on=`, s449 — resetOnPass).
    fn openerWordDiags(file: string, errs: ASpan[], d: ADecl, cell: boolean, st0: AS) -> AS {
        let st: AS = st0
        if (hasErrIn(errs, d.span)) return st
        st = repeatedWordDiags(file, d, st)
        for (const a of d.mods) {
            if (a.name == "reset-on" && !cell) {
                st = addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`reset-on=` on `<" + d.name + ">`, a field of a declaration, is not in the bootstrap — whether a field's `reset-on=` may name a sibling field of the same instance (a per-instance reset) is OPEN (§6.8.4); it is read on a program cell")
            } else if (isPersistWord(a.name)) {
                // s451: on a program cell, persistPass reads them (§6.14)
                if (!cell) st = persistFieldDiag(file, d, a, st)
            } else if (!isKnownOpenerWord(a.name) && a.name.indexOf(":") < 0) {
                st = addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", unknownOpenerMessage(a.name))
            }
        }
        for (const c of childFields(d.body)) { st = openerWordDiags(file, errs, c, false, st) }
        return st
    }

    // The declaration-opener words the bootstrap reads (besides the typed
    // attributes and the own value): `single` (§66.13.3); the validator words
    // are the parser's (it reports them, validatorMessage).
    fn isKnownOpenerWord(w: string) -> boolean {
        return w == "single" || w == "reset-on" || isValidatorName(w)
    }

    fn isValidatorName(w: string) -> boolean {
        return w == "req" || w == "length" || w == "pattern" || w == "min" || w == "max" || w == "gt" || w == "lt" ||
               w == "gte" || w == "lte" || w == "eq" || w == "neq" || w == "oneOf" || w == "notIn"
    }

    // s451 fix round (S239 review MED-1) — a word written TWICE in one opener
    // (`persist="local" persist="cookie"`, `single single`, `req req`,
    // `reset-on=[@q] reset-on=[@q]`, any modifier or validator) is refused:
    // every reader takes the first match, so the rest were silently dropped.
    // Searched §4, §5, §66.2 and §34 for a duplicate-attribute code — none
    // governs a repeated opener word — so E-BOOTSTRAP-UNSUPPORTED, by
    // construction for every name, at each repeat.
    fn repeatedWordDiags(file: string, d: ADecl, st0: AS) -> AS {
        let st: AS = st0
        let seen: string[] = []
        for (const a of d.mods) {
            if (seen.indexOf(a.name) >= 0) st = addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", repeatedMessage(d.name, a.name))
            seen = seen.concat([a.name])
        }
        // A validator CALL may repeat with other arguments — `length(>2)
        // length(<9)` is a conjunction every one of which is read (validators.
        // test.js pins it); a bare one (`req req`) says nothing twice.
        // s451 (S239 nit on #1260): a PRESENCE validator — `req`, `is some` —
        // is one predicate whatever its argument (§55.1: its argument is only a
        // message, §55.10), so `req req("m")` / `req("a") req` repeat it too.
        for (const v of d.validators) {
            if (seen.indexOf(v.name) >= 0 && (isBareValidator(v) || isPresenceValidator(v.name))) st = addDiag(st, file, v.span, "E-BOOTSTRAP-UNSUPPORTED", repeatedMessage(d.name, v.name))
            seen = seen.concat([v.name])
        }
        return st
    }

    // §55.1's presence predicates: `req` and `is given` — `is some` is its
    // soft-deprecated spelling (S462). The two-word forms reach the bootstrap
    // as the opener words `is` `given` / `is` `some`, refused as unknown — and a
    // second `is` is caught by the `mods` pass above.
    fn isPresenceValidator(name: string) -> boolean {
        return name == "req" || name == "is given" || name == "is some"
    }

    fn isBareValidator(v: AValidator) -> boolean {
        const a: AValArg = v.arg
        return match a {
            .NoArgs :> true
            .Cmp(op: o) :> false
            .Exprs(es: es) :> false
            .Regex(source: s) :> false
        }
    }

    fn repeatedMessage(decl: string, w: string) -> string {
        return "`" + w + "` is written twice on `<" + decl + ">` — the bootstrap reads one, so the other would be silently dropped; the SPEC names no code for a repeated opener word, so it is refused: write it once"
    }

    // s451 — the `persist=` storage value "session", spelled in pieces: impl#1
    // (which compiles the bootstrap) escalates a function to the SERVER when
    // its body holds the word `session` ANYWHERE, string literals included —
    // route-inference.ts SERVER_ONLY_PATTERNS `/(?<!@)\bsession\b/` is
    // string-blind (the `print(` and `Bun.*` triggers moved to the AST; this
    // one did not). Dogfood finding, s451.
    fn sessionWord() -> string { return "sess" + "ion" }

    // s451 — the §6.14 opener words: `persist=`, `key=` and `prepaint`.
    fn isPersistWord(w: string) -> boolean {
        return w == "persist" || w == "key" || w == "prepaint"
    }

    // s451 — a §6.14 word on a user declaration or on a field of one. §6.14.1
    // rule 3: "On a §66 declaration it governs the **shared instance only**";
    // where the attribute sits in a declaration, and per-instance keys, are
    // OPEN (O-061-9) — refused. `prepaint` with no `persist=` on the same
    // opener is §6.14.4.2 rule 2's error wherever it is written.
    fn persistFieldDiag(file: string, d: ADecl, a: AAttr, st: AS) -> AS {
        if (a.name == "prepaint" && attrNamed(d.mods, "persist") is not) {
            return addDiag(st, file, a.span, "E-PREPAINT-WITHOUT-PERSIST", "`prepaint` on `<" + d.name + ">`, which has no `persist=` — REFLECT pre-paints a STORED value, so it needs `persist=\"local\"` or `\"" + sessionWord() + "\"` + `key=` on the same cell (§6.14.4.2 rule 2)")
        }
        return addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "` on `<" + d.name + ">`, a declaration or a field of one, is not in the bootstrap — on a §66 declaration `persist=` governs the shared instance only (§6.14.1 rule 3), and its position there and per-instance keys are OPEN (O-061-9); the bootstrap persists a program cell, `let <x:T=v persist=\"local\" key=\"app.x\"/>`")
    }

    fn unknownOpenerMessage(w: string) -> string {
        return "`" + w + "` in a declaration opener is not in the bootstrap — it reads only typed attributes, the own value, `single` and validators there, and never ignores a word it does not implement"
    }

    // r1 G2 / r2 item 1: an own value AND typed attributes on one declaration —
    // what `@x` then is, is ⚑ O19 (OPEN). Refused, not decided — on the
    // declaration itself and on every child field, at any depth.
    fn o19Diags(file: string, d: ADecl, st0: AS) -> AS {
        let st: AS = st0
        // r3: an own TYPE with no initializer (`<c:int s:int=7/>`) is an own value too
        if ((hasOwnValue(d.own) || hasOwnType(d)) && d.attrs.length > 0) {
            st = addDiag(st, file, d.span, "E-BOOTSTRAP-UNSUPPORTED", "`<" + d.name + ">` has an own value (or an own type) AND attributes — what `@" + d.name + "` then names is ⚑ O19 (not ruled); the bootstrap does not decide it")
        }
        for (const c of childFields(d.body)) { st = o19Diags(file, c, st) }
        return st
    }

    // A declared own type other than the `:struct` container marker (§66.2.2).
    fn hasOwnType(d: ADecl) -> boolean {
        if (d.ty is not) return false
        return ownTypeName(d) != "struct"
    }

    fn hasOwnValue(v: AAttrValue) -> boolean {
        return match v {
            .NoValue :> false
            .Quoted(v: x) :> true
            .Bare(e: x) :> true
            .Paren(e: x) :> true
            .Braced(b: b) :> true
        }
    }

    fn ownTypeName(d: ADecl) -> string {
        const t: AType | not = d.ty
        if (t is not) return ""
        const k: ATypeK = t.k
        return match k {
            .TName(name: n) :> n
            .TSeq(elem: e) :> ""
            .TMaybe(inner: i) :> ""
        }
    }

    // ---- Phase A driver -----------------------------------------------------------------
    type RGlobals:struct = { g: Globals, st: AS }

    fn phaseA(files: FileAst[], entry: string, st0: AS) -> RGlobals {
        let st: AS = st0
        const rs: RStubs = typeStubs(files, st)
        st = rs.st
        const rd: RDeclStubs = declStubs(files, entry, st)
        st = programShapeDiags(files, entry, rd.st)
        let declNames: string[] = []
        let declSyms: Sym[] = []
        let program: Sym = mkSym(-1, "program")
        let hasProgram = false
        for (const d of rd.ds) {
            if (d.isProgram) {
                hasProgram = true
                program = d.sym
            } else {
                declNames = declNames.concat([d.sym.hint])
                declSyms = declSyms.concat([d.sym])
            }
        }
        if (!hasProgram) st = addDiag(st, entry, mkSpan(0, 0), "E-PROGRAM-MISSING", "the entry file has no `<program>`")
        st = namedInstanceDiags(rd.ds, declNames, files, st)
        const te0: TypeEnv = { stubs: rs.stubs, declNames: declNames, declSyms: declSyms, file: entry }
        const rt: RTypeInfos = typeInfos(rs.stubs, te0, st)
        st = rt.st
        const rf0: RFns = fnsOf(files, te0, st)
        st = rf0.st
        // s454 (U1b): the failure enum of a client call of each server-triggered function
        const rr: RRemoteEnums = remoteEnums(rf0.fs, rt.ts, builtinSym(rs.stubs, serverCallErrorName()), st)
        st = rr.st
        const rf: RFns = { fs: rr.fs, st: st }
        const allTypes: TypeInfo[] = rt.ts.concat(rr.minted)
        // fields + handles per declaration
        let decls: DeclSrc[] = []
        let handles: HandleInfo[] = []
        for (const ds of rd.ds) {
            const te: TypeEnv = { stubs: rs.stubs, declNames: declNames, declSyms: declSyms, file: ds.file }
            let fields: FieldInfo[] = []
            let single = false
            const p: AProgram | not = ds.p
            const d: ADecl | not = ds.d
            if (p is given) {
                const r: RFields = programFields(te, rt.ts, p, st)
                fields = r.fs
                st = r.st
                single = true
            } else if (d is given) {
                const r2: RFields = userFields(te, rt.ts, d, st)
                fields = r2.fs
                st = r2.st
                single = hasFlag(d.mods, "single")
            }
            fields = trustFields(fields, fileErrs(files, ds.file))
            const rh: RHandles = handlesIn(rd.ds, rendersNodes(ds), { owner: ds.nid, conditional: false, file: ds.file }, st)
            st = rh.st
            handles = handles.concat(rh.hs)
            let own: Sym[] = []
            for (const h of rh.hs) {
                if (h.owner == ds.nid) own = own.concat([h.sym])
            }
            let kind: DeclKind = DeclKind.User
            if (ds.isProgram) kind = DeclKind.Program
            const info: DeclInfo = { nid: ds.nid, span: declSpan(ds), sym: ds.sym, kind: kind, single: single, file: ds.file, fields: fields, handles: own }
            decls = decls.concat([{ info: info, file: ds.file, isProgram: ds.isProgram, d: ds.d, p: ds.p }])
        }
        const g: Globals = { program: program, entry: entry, te: te0, types: allTypes, decls: decls, fns: rf.fs, handles: handles, files: files,
                             errorSym: builtinSym(rs.stubs, "Error"), sqlErrorSym: builtinSym(rs.stubs, "SqlError"),
                             sceSym: builtinSym(rs.stubs, serverCallErrorName()) }
        return { g: g, st: st }
    }

    // r2 F4 — does a body read the clock (`Date.now()`) ITSELF? The effect
    // summary's own `clock` fact (dpa-066 M3: the name-keyed whole-program
    // set this section used to close over calls is retired — the summary
    // closes it over the binder's Syms, rulesPass reads it). Syntactic — the
    // call's shape, wherever it stands (a `fn` body too, where E-FN-004 also
    // reports it).
    fn blockClock(b: ABlock) -> boolean {
        for (const s of b.stmts) {
            if (stmtClock(s)) return true
        }
        return false
    }

    fn stmtClock(s: AStmt) -> boolean {
        const k: AStmtK = s.k
        return match k {
            .Eval(e: e) :> exprClock(e)
            .Local(name: n, init: i) :> exprClock(i)
            .Return(e: e) :> maybeClock(e)
            .If(cond: c, thenB: t, elseB: el) :> exprClock(c) || blockClock(t) || maybeBlockClock(el)
            .Given(name: n, subject: sub, body: b) :> exprClock(sub) || blockClock(b)
            .EffectStmt(w: w) :> blockClock(w.body)
            .Defer(body: b) :> blockClock(b)
            .Fail(f: f) :> exprsClock(failExprs(f))
        }
    }

    fn exprsClock(es: AExpr[]) -> boolean {
        for (const x of es) {
            if (exprClock(x)) return true
        }
        return false
    }

    fn maybeClock(e: AExpr | not) -> boolean {
        if (e is not) return false
        return exprClock(e)
    }

    fn maybeBlockClock(b: ABlock | not) -> boolean {
        if (b is not) return false
        return blockClock(b)
    }

    fn exprClock(e: AExpr) -> boolean {
        if (isClockCall(e)) return true
        for (const x of exprKids(e)) {
            if (exprClock(x)) return true
        }
        for (const b of exprBlocks(e)) {
            if (blockClock(b)) return true
        }
        return false
    }

    fn isClockCall(e: AExpr) -> boolean {
        const k: AExprK = e.k
        const c: AExpr | not = calleeOf(k)
        if (c is not) return false
        const m: MethodCall | not = memberCall(c)
        if (m is not) return false
        return m.method == "now" && exprName(m.obj) == "Date"
    }

    fn calleeOf(k: AExprK) -> AExpr | not {
        return match k {
            .Call(callee: c) :> c
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: s) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: x) :> not
            .Assign(target: x) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Index(obj: ix) :> not
            .Lambda(params: ps) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
        }
    }

    // =========================================================================
    // Phase B — resolving bodies: expressions, statements, writes, views.
    // =========================================================================
    // Where code sits (L1): a function body, or a declaration's initializers /
    // renders (the program is one — R4).
    type CtxK:enum = { InFn, InDecl(owner: Sym, isProgram: boolean) }
    // s444 — where a host call (`Date.now()`) may stand (the host-call surface,
    // progress.md): a `function` body or an event handler (HostOk); a pure
    // `fn` body (HostPure → E-FN-004, §33.3 item 7 / §48.3.4); anywhere else —
    // initializers, markup, `if=` / `in=` values — not in the bootstrap (HostNo).
    type HostCtx:enum = { HostNo, HostOk, HostPure }

    type LocalB:struct = { name: string, s: Sym, ty: Type | not, mutable: boolean, narrowed: InstRef | not, nDecl: Sym | not }
    type RowB:struct = { bind: Sym, ty: Type | not }
    // `@name` narrowed by an enclosing `given c = @name :> { … }` (§66.7.5, O56
    // RULED S435: "A direct `@handle.field = …` inside the narrowed block is
    // legal"; reads S437): inside the block `@name` IS the narrowed instance
    // `c`, so a direct `@name.f = …` / `@name.f` there goes through `c` exactly
    // as `c.f` does. Scoped to the block and to the handle named.
    type NarrowB:struct = { name: string, ty: Type | not, inst: InstRef, iDecl: Sym }

    // `present`: the conditional handles a PRESENCE TEST has proven mounted here
    // (RULED S442: "the S437 conditional-handle rule vs Q1: the presence test
    // COUNTS AS the narrowing (`if=@color` is legal; reads inside are
    // narrowed)"). Inside, `@h` is not `maybe`.
    type Env:struct = {
        g: Globals,
        file: string,
        ctx: CtxK,
        locals: LocalB[],
        rows: RowB[],
        handles: HandleInfo[],
        inRenders: boolean,
        narrows: NarrowB[],
        present: string[],
        host: HostCtx,          // s444: may a host call stand here?
        own: string,            // s444: the child field whose own `renders` this is ("" — none): `@own` is this instance (O54 = (a), RULED S442)
        inEffect: boolean,      // s449: inside an effect body (an effect there is E-LIFECYCLE-016, §6.7.4)
        fx: FailCtx,            // s451 (Ue): the error-model context (see FailCtx)
    }

    // s451 (Ue) — the error-model context of the code being resolved.
    // `inFn` / `fnName` / `failable` / `err`: the enclosing function
    // DECLARATION (a handler, an effect and a declaration's markup are not
    // one — "a handler is not a `!` function", §19.4.3); `defer`: inside a
    // deferred body (§19.16.3 rule 3); `subject`: the node being resolved as a
    // handling form's subject (its failable is handled there); `whole`: the
    // node that is a statement's WHOLE value — the one place a handling form
    // stands in this slice (nested ones are Ue2's).
    // `fnRef` (review HIGH-2): the one node allowed to NAME a function without
    // calling it here — a direct call's callee, or an event-handler reference.
    // `wholeWhat` (s452): what position `whole` is, for E-ERROR-012's message
    // ("the initializer of `x`", "a `return` operand", …; "" — not named).
    // s454 (U1b): `fnSym` — the enclosing function's Sym id (-1: not in a
    // function); `serverOwn` — its own body places it on the server (§12.2
    // T1/T4), so a call made in it is server→server whatever the rest of the
    // program does (§19.9.10 "Not affected: A server→server call").
    type FailCtx:struct = { inFn: boolean, fnName: string, failable: boolean, err: Sym | not, defer: boolean, subject: int, whole: int, fnRef: int, wholeWhat: string, fnSym: int, serverOwn: boolean }

    fn noFailCtx() -> FailCtx { return { inFn: false, fnName: "", failable: false, err: not, defer: false, subject: -1, whole: -1, fnRef: -1, wholeWhat: "", fnSym: -1, serverOwn: false } }

    fn withFx(env: Env, fx: FailCtx) -> Env {
        return { g: env.g, file: env.file, ctx: env.ctx, locals: env.locals, rows: env.rows,
                 handles: env.handles, inRenders: env.inRenders, narrows: env.narrows, present: env.present, host: env.host, own: env.own, inEffect: env.inEffect, fx: fx }
    }

    fn withSubject(env: Env, nid: int) -> Env {
        const f: FailCtx = env.fx
        return withFx(env, { inFn: f.inFn, fnName: f.fnName, failable: f.failable, err: f.err, defer: f.defer, subject: nid, whole: f.whole, fnRef: f.fnRef, wholeWhat: f.wholeWhat, fnSym: f.fnSym, serverOwn: f.serverOwn })
    }

    fn withWhole(env: Env, nid: int) -> Env {
        return withWholeAt(env, nid, "")
    }

    // s452: `nid` is a statement's whole value standing in position `what`
    // (named in E-ERROR-012's message).
    fn withWholeAt(env: Env, nid: int, what: string) -> Env {
        const f: FailCtx = env.fx
        return withFx(env, { inFn: f.inFn, fnName: f.fnName, failable: f.failable, err: f.err, defer: f.defer, subject: f.subject, whole: nid, fnRef: f.fnRef, wholeWhat: what, fnSym: f.fnSym, serverOwn: f.serverOwn })
    }

    fn withFnRef(env: Env, nid: int) -> Env {
        const f: FailCtx = env.fx
        return withFx(env, { inFn: f.inFn, fnName: f.fnName, failable: f.failable, err: f.err, defer: f.defer, subject: f.subject, whole: f.whole, fnRef: nid, wholeWhat: f.wholeWhat, fnSym: f.fnSym, serverOwn: f.serverOwn })
    }

    fn withDeferFx(env: Env) -> Env {
        const f: FailCtx = env.fx
        return withFx(env, { inFn: f.inFn, fnName: f.fnName, failable: f.failable, err: f.err, defer: true, subject: f.subject, whole: f.whole, fnRef: f.fnRef, wholeWhat: f.wholeWhat, fnSym: f.fnSym, serverOwn: f.serverOwn })
    }

    fn withLocal(env: Env, l: LocalB) -> Env {
        return { g: env.g, file: env.file, ctx: env.ctx, locals: env.locals.concat([l]), rows: env.rows,
                 handles: env.handles, inRenders: env.inRenders, narrows: env.narrows, present: env.present, host: env.host, own: env.own, inEffect: env.inEffect, fx: env.fx }
    }

    fn withRow(env: Env, row: RowB, name: string, hs: HandleInfo[]) -> Env {
        const l: LocalB = { name: name, s: row.bind, ty: row.ty, mutable: false, narrowed: not, nDecl: not }
        return { g: env.g, file: env.file, ctx: env.ctx, locals: env.locals.concat([l]), rows: env.rows.concat([row]),
                 handles: env.handles.concat(hs), inRenders: env.inRenders, narrows: env.narrows, present: env.present, host: env.host, own: env.own, inEffect: env.inEffect, fx: env.fx }
    }

    fn withNarrow(env: Env, n: NarrowB) -> Env {
        return { g: env.g, file: env.file, ctx: env.ctx, locals: env.locals, rows: env.rows,
                 handles: env.handles, inRenders: env.inRenders, narrows: env.narrows.concat([n]), present: env.present, host: env.host, own: env.own, inEffect: env.inEffect, fx: env.fx }
    }

    fn withPresent(env: Env, name: string) -> Env {
        if (name == "") return env
        return { g: env.g, file: env.file, ctx: env.ctx, locals: env.locals, rows: env.rows,
                 handles: env.handles, inRenders: env.inRenders, narrows: env.narrows, present: env.present.concat([name]), host: env.host, own: env.own, inEffect: env.inEffect, fx: env.fx }
    }

    fn withHost(env: Env, h: HostCtx) -> Env {
        return { g: env.g, file: env.file, ctx: env.ctx, locals: env.locals, rows: env.rows,
                 handles: env.handles, inRenders: env.inRenders, narrows: env.narrows, present: env.present, host: h, own: env.own, inEffect: env.inEffect, fx: env.fx }
    }

    fn withOwn(env: Env, name: string) -> Env {
        return { g: env.g, file: env.file, ctx: env.ctx, locals: env.locals, rows: env.rows,
                 handles: env.handles, inRenders: env.inRenders, narrows: env.narrows, present: env.present, host: env.host, own: name, inEffect: env.inEffect, fx: env.fx }
    }

    // s449: an effect body — a logic context (§6.7.4 "same rules as `${}`") run
    // on a change: a host call may stand in it, as in a handler (it is the
    // effect's job to call the outside world), and an effect inside it is
    // E-LIFECYCLE-016.
    fn effectBodyEnv(env: Env) -> Env {
        return { g: env.g, file: env.file, ctx: env.ctx, locals: env.locals, rows: env.rows,
                 handles: env.handles, inRenders: env.inRenders, narrows: env.narrows, present: env.present, host: HostCtx.HostOk, own: env.own, inEffect: true, fx: env.fx }
    }

    // s444 — O54 = (a) (RULED S442: "`@email` inside `email`'s own `renders` …
    // Rec: this instance."): inside a CHILD field's own renders, `@<field>`
    // names that field of the current instance (Lexical(0) — the declaration
    // instance that holds it). -1 = not the own field.
    fn ownFieldIndex(env: Env, name: string) -> int {
        if (env.own == "" || env.own != name) return -1
        const d: DeclSrc | not = ctxDecl(env)
        if (d is not) return -1
        if (d.isProgram) return -1
        return fieldIndex(d.info, name)
    }

    // The conditional handle a condition tests for presence ("" — none): a
    // BARE `@h` (the ruled spelling, `if=@color`), where `@h` is a conditional
    // handle in scope not narrowed by a `given`. (`@h != not` is not taken:
    // its `@h` lowers as a snapshot read — still S437's read rule.)
    fn presenceHandle(env: Env, c: AExpr) -> string {
        return condHandleNamed(env, atName(c))
    }

    fn condHandleNamed(env: Env, n: string) -> string {
        if (n == "") return ""
        if (lookupNarrow(env, n) is given) return ""
        const h: HandleInfo | not = lookupHandle(env, n)
        if (h is not) return ""
        if (!h.conditional) return ""
        return n
    }

    // A condition: a presence test of a conditional handle resolves its `@h`
    // as a SUBJECT (not a read — the test is the narrowing, ruled S442).
    fn resolveCond(env: Env, c: AExpr, st: AS) -> AS {
        const h: string = presenceHandle(env, c)
        if (h == "") return resolveExpr(env, c, Type.Bool, st).st
        return resolveExpr(withPresent(env, h), c, Type.Bool, st).st
    }

    fn lookupNarrow(env: Env, name: string) -> NarrowB | not {
        let i: int = env.narrows.length - 1
        while (i >= 0) {
            if (env.narrows[i].name == name) return env.narrows[i]
            i = i - 1
        }
        return not
    }

    fn lookupLocal(env: Env, name: string) -> LocalB | not {
        let i: int = env.locals.length - 1
        while (i >= 0) {
            if (env.locals[i].name == name) return env.locals[i]
            i = i - 1
        }
        return not
    }

    fn lookupHandle(env: Env, name: string) -> HandleInfo | not {
        let i: int = env.handles.length - 1
        while (i >= 0) {
            if (env.handles[i].name == name) return env.handles[i]
            i = i - 1
        }
        return not
    }

    fn ctxDecl(env: Env) -> DeclSrc | not {
        const c: CtxK = env.ctx
        return match c {
            .InDecl(owner: o) :> findDeclSrc(env.g, o)
            .InFn :> not
        }
    }

    fn inProgramCtx(env: Env) -> boolean {
        const c: CtxK = env.ctx
        return match c {
            .InDecl(owner: o, isProgram: p) :> p
            .InFn :> false
        }
    }

    // L1: the program's fields from here — its own initializers / renders use
    // the lexically enclosing instance; everything else the shared instance.
    fn programInst(env: Env) -> InstRef {
        if (inProgramCtx(env)) return InstRef.Lexical(0)
        return InstRef.Shared(env.g.program)
    }

    // The program's cells, when code in THIS file can see them: §7.6.1 — a
    // file-level cell is reachable as `@x` "in the same file". A library's
    // `@x` never reaches the app that links it (its meaning must not depend on
    // which app imports it).
    fn programInfo(env: Env) -> DeclInfo | not {
        const d: DeclSrc | not = findDeclSrc(env.g, env.g.program)
        if (d is not) return not
        if (d.file != env.file) return not
        return d.info
    }

    // A user declaration named `name` that THIS file can see: declared here, or
    // imported here (§21.3). Only such a one is `@name`'s shared instance (§66.7.1).
    fn visibleDecl(env: Env, name: string) -> DeclSrc | not {
        const d: DeclSrc | not = declNamed(env.g, name)
        if (d is not) return not
        if (d.file == env.file || importsName(env.g.files, env.file, name)) return d
        return not
    }

    // ---- expression results -------------------------------------------------
    // `inst` / `iDecl`: the expression names an INSTANCE (a handle, the current
    // instance, a shared instance, a narrowed local); `maybe`: a conditional
    // handle, not narrowed (§66.7.5).
    type XI:struct = { ty: Type | not, inst: InstRef | not, iDecl: Sym | not, maybe: boolean }
    type RX:struct = { x: XI, st: AS }

    fn plain(t: Type | not, st: AS) -> RX { return { x: { ty: t, inst: not, iDecl: not, maybe: false }, st: st } }

    fn diagX(env: Env, e: AExpr, code: string, msg: string, st: AS) -> RX {
        return plain(not, addDiag(st, env.file, e.span, code, msg))
    }

    fn resolveExprs(env: Env, es: AExpr[], expected: Type | not, st0: AS) -> AS {
        let st: AS = st0
        for (const e of es) { st = resolveExpr(env, e, expected, st).st }
        return st
    }

    fn resolveExpr(env: Env, e: AExpr, expected: Type | not, st: AS) -> RX {
        const k: AExprK = e.k
        return match k {
            .Name(name: n) :> resolveName(env, e, n, st)
            .At(name: n) :> resolveAtRead(env, e, n, st)
            .AtItem :> resolveAtItem(env, e, st)
            .Num(raw: r) :> resolveNum(e, r, st)
            .Str(v: s) :> plain(Type.Str, addValue(st, e.nid, ValueFact.VLit(Literal.Str(s))))
            .Bool(v: b) :> plain(Type.Bool, addValue(st, e.nid, ValueFact.VLit(Literal.Bool(b))))
            .NotLit :> plain(expected, addValue(st, e.nid, ValueFact.VLit(Literal.Absent)))
            .Recovered :> plain(not, st)                 // the parser reported it: no fact, no type
            .Variant(name: n) :> resolveVariant(env, e, n, expected, st)
            .Member(obj: o, name: n) :> resolveMember(env, e, o, n, st)
            .Call(callee: c, args: args) :> resolveCall(env, e, c, args, st)
            .Unary(op: o, e: x) :> resolveUnary(env, e, o, x, st)
            .Binary(op: o, l: l, r: r) :> resolveBinary(env, e, o, l, r, st)
            .Ternary(test: t, yes: y, no: n) :> resolveTernary(env, e, t, y, n, expected, st)
            .Assign(target: t) :> diagX(env, e, "E-ASSIGN-POSITION", "an assignment is a statement — it cannot be used as a value", st)
            .ArrayLit(elems: es) :> resolveArray(env, e, es, expected, st)
            .ObjectLit(props: ps) :> resolveObject(env, e, ps, expected, st)
            .Spread(e: x) :> diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", "an array spread `...` is in the bootstrap only as a recognized edit shape (`@x = [...@x, e]`, §66.11.2) — Core has no spread value", st)
            .Index(obj: o) :> diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", "an index `a[i]` is in the bootstrap only as an element-field write target (dpa-052 Q3) — Core has no index read", st)
            .Lambda(params: ps2) :> diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", "an arrow function is in the bootstrap only as the argument of `.filter(…)` / `.map(…)` on a sequence", st)
            .Sql(q: q) :> resolveSql(env, e, q, false, st)   // s451: a query's values are bound like any expression; its facts are placePass's; (Ue) its failable rule here
            .Handled(h: h) :> resolveHandled(env, e, h, false, st)   // s451 (Ue)
        }
    }

    fn resolveNum(e: AExpr, raw: string, st: AS) -> RX {
        const t: Type = numType(raw)
        const n: number = Number(raw)
        const isInt: boolean = t == Type.Int
        if (isInt) return plain(t, addValue(st, e.nid, ValueFact.VLit(Literal.Int(n))))
        return plain(t, addValue(st, e.nid, ValueFact.VLit(Literal.Num(n))))
    }

    fn resolveName(env: Env, e: AExpr, name: string, st: AS) -> RX {
        const l: LocalB | not = lookupLocal(env, name)
        if (l is given) {
            const st2: AS = addName(st, e.nid, NameFact.NLocal(l.s))
            if (l.narrowed is given) return { x: { ty: l.ty, inst: l.narrowed, iDecl: l.nDecl, maybe: false }, st: st2 }
            return plain(l.ty, st2)
        }
        // §66.5.2: inside a declaration's renders / initializers, its fields are
        // bare read-only projections of the current instance.
        const d: DeclSrc | not = ctxDecl(env)
        if (d is given) {
            if (!d.isProgram) {
                const i: int = fieldIndex(d.info, name)
                if (i >= 0) return plain(d.info.fields[i].ty, addName(st, e.nid, NameFact.NField(d.info.sym, InstRef.Lexical(0), i)))
            }
        }
        const f: FnInfo | not = fnNamed(env.g, name)
        if (f is given) {
            const st2: AS = addName(st, e.nid, NameFact.NFn(f.sym))
            if (env.fx.fnRef == e.nid) return plain(not, st2)
            // s451 (Ue, review HIGH-2): a function named without being called —
            // an alias, a returned / passed / stored function. Core has no
            // function value (only a Lambda as a SeqCall argument), so it was
            // lowered as `null`. A `!` function there is a call left unhandled
            // (§19.4.3 / §19.4.4: an unhandled `!` call SHALL be E-ERROR-002);
            // any other function value is refused.
            if (f.failable) return plain(not, addDiag(st2, env.file, e.span, "E-ERROR-002", "the failable function '" + f.name + "' is used as a value — whatever calls it later would discard its error. Call it here and handle the result (`" + f.name + "(…) !{ … }`, `match`, `?`) (§19.4.3)"))
            return plain(not, addDiag(st2, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + name + "` names a function without calling it (an alias, a returned, passed or stored function) — function values arrive with a later \"function values\" slice; call it directly: `" + name + "(…)`"))
        }
        const pi: DeclInfo | not = programInfo(env)
        if (pi is given) {
            if (fieldIndex(pi, name) >= 0) {
                return diagX(env, e, "E-SCOPE-001", "`" + name + "` is a cell — read it as `@" + name + "` (V5-strict: bare names are locals)", st)
            }
        }
        return diagX(env, e, "E-SCOPE-001", "`" + name + "` is not declared", st)
    }

    // A READ through `@h`. RULED S437 (bryan: "yes, reads require narrowing"):
    // reading through a conditionally-mounted handle (`T | not`, §66.7.5)
    // outside a narrowing is an error, as a write already is. Same code as the
    // write (§66.20 E-DECL-HANDLE-NOT-NARROWED names only writes today; the
    // ruling widens its condition to reads — slice-m2/progress.md).
    fn resolveAtRead(env: Env, e: AExpr, name: string, st: AS) -> RX {
        const r: RX = resolveAt(env, e, name, st)
        if (!r.x.maybe) return r
        let tn: string = "T"
        const td: Sym | not = r.x.iDecl
        if (td is given) tn = td.hint
        const msg: string = "`@" + name + "` names a conditionally-mounted instance (typed `" + tn + " | not`) — a read through it must be narrowed first: `given c = @" + name + " :> { … c.field … }` (§66.7.5; reads ruled S437)"
        return { x: r.x, st: addDiag(r.st, env.file, e.span, "E-DECL-HANDLE-NOT-NARROWED", msg) }
    }

    // A handle as the SUBJECT of a narrowing or a write: no read check (the
    // `given` narrows it; a write has its own guard, writeGuards).
    fn resolveHandleSubject(env: Env, e: AExpr, st: AS) -> RX {
        const n: string = atName(e)
        if (n != "") return resolveAt(env, e, n, st)
        return resolveExpr(env, e, not, st)
    }

    fn atName(e: AExpr) -> string {
        const k: AExprK = e.k
        return match k {
            .At(name: n) :> n
            .Name(name: n) :> ""
            .AtItem :> ""
            .Num(raw: r) :> ""
            .Str(v: s) :> ""
            .Bool(v: b) :> ""
            .NotLit :> ""
            .Recovered :> ""
            .Variant(name: n) :> ""
            .Member(obj: o) :> ""
            .Call(callee: c) :> ""
            .Unary(op: o) :> ""
            .Binary(op: o) :> ""
            .Ternary(test: t) :> ""
            .Assign(target: t) :> ""
            .ArrayLit(elems: es) :> ""
            .ObjectLit(props: ps) :> ""
            .Spread(e: sx) :> ""
            .Index(obj: ix) :> ""
            .Lambda(params: lp) :> ""
            .Sql(q: q) :> ""
            .Handled(h: x) :> ""
        }
    }

    fn resolveAt(env: Env, e: AExpr, name: string, st: AS) -> RX {
        // §66.7.5: inside `given c = @name :> { … }`, `@name` is the narrowed `c`.
        const nb: NarrowB | not = lookupNarrow(env, name)
        if (nb is given) {
            return { x: { ty: nb.ty, inst: nb.inst, iDecl: nb.iDecl, maybe: false },
                     st: addName(st, e.nid, NameFact.NInst(nb.iDecl, nb.inst)) }
        }
        // s444 — O54 (a) for a CHILD field's own renders: `@f` is this instance's `f`.
        const oi: int = ownFieldIndex(env, name)
        if (oi >= 0) {
            const od: DeclSrc | not = ctxDecl(env)
            if (od is given) return plain(od.info.fields[oi].ty, addName(st, e.nid, NameFact.NField(od.info.sym, InstRef.Lexical(0), oi)))
        }
        // O54 (a): inside x's own renders / initializers, `@x` is the current instance.
        const d: DeclSrc | not = ctxDecl(env)
        if (d is given) {
            if (!d.isProgram && d.info.sym.hint == name) {
                const inst: InstRef = InstRef.Lexical(0)
                return { x: { ty: Type.Named(d.info.sym), inst: inst, iDecl: d.info.sym, maybe: false },
                         st: addName(st, e.nid, NameFact.NInst(d.info.sym, inst)) }
            }
        }
        // A handle in scope first: a row-scoped (§66.7.4) or declaration-scoped
        // handle shadows a program-scope name; a program-scope handle cannot
        // share a program cell's name (the scope pass refuses that).
        const h: HandleInfo | not = lookupHandle(env, name)
        if (h is given) {
            const hi: InstRef = InstRef.Alias(h.sym)
            // a presence test in scope proves it mounted (ruled S442)
            const maybe: boolean = h.conditional && env.present.indexOf(name) < 0
            return { x: { ty: Type.Named(h.target), inst: hi, iDecl: h.target, maybe: maybe },
                     st: addName(st, e.nid, NameFact.NInst(h.target, hi)) }
        }
        const pi: DeclInfo | not = programInfo(env)
        if (pi is given) {
            const i: int = fieldIndex(pi, name)
            if (i >= 0) return plain(pi.fields[i].ty, addName(st, e.nid, NameFact.NField(pi.sym, programInst(env), i)))
        }
        const ud: DeclSrc | not = visibleDecl(env, name)
        if (ud is given) {
            const si: InstRef = InstRef.Shared(ud.info.sym)
            return { x: { ty: Type.Named(ud.info.sym), inst: si, iDecl: ud.info.sym, maybe: false },
                     st: addName(st, e.nid, NameFact.NInst(ud.info.sym, si)) }
        }
        return diagX(env, e, "E-SCOPE-001", "`@" + name + "` names no cell, declaration or `as=` handle in scope", st)
    }

    fn resolveAtItem(env: Env, e: AExpr, st: AS) -> RX {
        if (env.rows.length == 0) return diagX(env, e, "E-SYNTAX-064", "`@.` outside an `<each>` body (§17.7.3)", st)
        const row: RowB = env.rows[env.rows.length - 1]
        return plain(row.ty, addName(st, e.nid, NameFact.NLocal(row.bind)))
    }

    // A bare variant resolves against the type its position expects; with no
    // expectation, against the one enum that has it.
    fn resolveVariant(env: Env, e: AExpr, name: string, expected: Type | not, st: AS) -> RX {
        if (expected is given) {
            const es: Sym | not = isEnumType(env.g.types, expected)
            if (es is given) {
                const i: int = variantIndex(env.g.types, es, name)
                if (i >= 0) return plain(expected, addValue(st, e.nid, ValueFact.VVariant(es, i)))
                return diagX(env, e, "E-TYPE-VARIANT", "`." + name + "` is not a variant of `" + es.hint + "`", st)
            }
        }
        let found: Sym[] = []
        let idx: int = -1
        for (const t of env.g.types) {
            // s451 (Ue): a built-in error enum's variant resolves only where its type is expected
            const s: Sym = typeDefSym(t.def)
            const i: int = variantIndex(env.g.types, s, name)
            if (i >= 0 && t.file != builtinFile()) {
                found = found.concat([s])
                idx = i
            }
        }
        if (found.length == 1) return plain(Type.Named(found[0]), addValue(st, e.nid, ValueFact.VVariant(found[0], idx)))
        if (found.length == 0) return diagX(env, e, "E-TYPE-VARIANT", "`." + name + "` is not a variant of any enum in scope", st)
        return diagX(env, e, "E-VARIANT-AMBIGUOUS", "`." + name + "` is a variant of more than one enum — qualify it", st)
    }

    fn isLengthOf(t: Type | not) -> boolean {
        if (t is not) return false
        if (seqElem(t) is given) return true
        return t == Type.Str
    }

    fn resolveMember(env: Env, e: AExpr, obj: AExpr, name: string, st0: AS) -> RX {
        const ro: RX = resolveExpr(env, obj, not, st0)
        const st: AS = ro.st
        // `.length` of a sequence or a string is a primitive (a read, never a place).
        if (name == "length" && ro.x.inst is not && isLengthOf(ro.x.ty)) {
            return plain(Type.Int, addName(st, e.nid, NameFact.NLength))
        }
        const inst: InstRef | not = ro.x.inst
        const iDecl: Sym | not = ro.x.iDecl
        if (inst is given && iDecl is given) {
            const d: DeclSrc | not = findDeclSrc(env.g, iDecl)
            if (d is not) return diagX(env, e, "E-SCOPE-001", "unknown declaration", st)
            const i: int = fieldIndex(d.info, name)
            // s449 — the compound surface (§55.5): every user declaration has one (Edge B)
            if (i < 0 && isSurfaceProp(name) && !d.isProgram) return compoundSurface(env, e, iDecl, inst, name, st)
            if (i < 0) return diagX(env, e, "E-SCOPE-001", "`<" + d.info.sym.hint + ">` has no field `" + name + "`", st)
            return { x: { ty: d.info.fields[i].ty, inst: not, iDecl: not, maybe: ro.x.maybe },
                     st: addName(st, e.nid, NameFact.NField(iDecl, inst, i)) }
        }
        // s449 — the validity surface of a FIELD read (`@email.isValid`,
        // `@signup.email.touched`): a top-level value has one when it carries
        // validators (§55.5.1 rules 1-2), a user declaration's field always
        // (§55.6, Edge B).
        if (isSurfaceProp(name)) {
            const nf: NameFact | not = nameFactIn(st, obj.nid)
            const where: int = fieldReadKind(env, nf)
            if (where == 2 || where == 1) return fieldSurface(env, e, obj, nf, name, where, st)
        }
        const t: Type | not = ro.x.ty
        if (t is given) {
            const s: Sym | not = namedOf(t)
            if (s is given) {
                const ti: TypeInfo | not = typeInfoOf(env.g.types, s)
                if (ti is given) {
                    const fs: FieldDef[] | not = structFieldDefs(ti.def)
                    if (fs is given) {
                        let i = 0
                        for (const fd of fs) {
                            if (fd.sym.hint == name) return plain(fd.ty, addName(st, e.nid, NameFact.NStruct(s, i)))
                            i = i + 1
                        }
                        return diagX(env, e, "E-SCOPE-001", "`" + s.hint + "` has no field `" + name + "`", st)
                    }
                }
            }
        }
        return diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", "member access `." + name + "` on a value that is not a struct or an instance is not in bootstrap slice M2", st)
    }

    // s444 Phase B — the synthesized validity-surface properties (§55.5–§55.7).
    fn isSurfaceProp(n: string) -> boolean {
        return n == "isValid" || n == "errors" || n == "touched" || n == "submitted"
    }

    fn surfaceDeferred(what: string, sec: string) -> string {
        return "`" + what + "` reads the synthesized validity surface (" + sec + "), which is not in the bootstrap yet"
    }

    fn surfaceProp(n: string) -> SurfaceProp {
        if (n == "isValid") return SurfaceProp.IsValid
        if (n == "errors") return SurfaceProp.Errors
        if (n == "touched") return SurfaceProp.Touched
        return SurfaceProp.Submitted
    }

    // `errors` read as a VALUE: §55.9 makes it an array of ValidationError
    // tags (a map of them on a compound), and the bootstrap has no
    // ValidationError type for the typer to give it — refused, never read as
    // an untyped value. `<errors of=…/>` renders it (§55.8).
    fn errorsAsValue(what: string) -> string {
        return "`" + what + ".errors` read as a value — the ValidationError array (§55.9) has no type in the bootstrap yet; render it with `<errors of=" + what + "/>` (§55.8), or test `" + what + ".isValid`"
    }

    // s449 — `@signup.isValid` / `.submitted` (§55.5): the compound of a user
    // declaration's instance. Its `touched` / `errors` are per-field maps
    // (§55.5) the bootstrap has no type for — refused (read them per field).
    fn compoundSurface(env: Env, e: AExpr, d: Sym, inst: InstRef, name: string, st: AS) -> RX {
        const what: string = "@" + d.hint
        if (name == "errors") return diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", errorsAsValue(what), st)
        if (name == "touched") return diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", "`" + what + ".touched` is a map of per-field flags (§55.5) — a map value has no type in the bootstrap yet; read one field's: `" + what + ".<field>.touched` (§55.6)", st)
        return plain(Type.Bool, addName(st, e.nid, NameFact.NSurface(ValidityOf.OfDecl(d, inst), surfaceProp(name))))
    }

    // s449 — a field's surface (§55.5.1 / §55.6). `where`: 2 a top-level
    // value, 1 a user declaration's field (fieldReadKind).
    fn fieldSurface(env: Env, e: AExpr, obj: AExpr, nf: NameFact | not, name: string, where: int, st: AS) -> RX {
        const v: ValidityOf | not = fieldValidity(nf)
        if (v is not) return diagX(env, e, "E-SCOPE-001", "`." + name + "` — `" + exprLabel(obj) + "` is not a field", st)
        const what: string = exprLabel(obj)
        // its validators were written but refused (already reported): no second, false diagnostic
        if (where == 2 && fieldValidatorsRefused(env, v)) return plain(not, st)
        if (where == 2 && !fieldCarriesValidators(env, v)) {
            return diagX(env, e, "E-VALIDITY-NO-SURFACE", "`." + name + "` — `" + what + "` is a top-level value that carries no validators, so it has no validity surface (§55.5.1 rule 2: only a value that carries validators gets one); add a validator to its declaration, or drop the read", st)
        }
        if (name == "errors") return diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", errorsAsValue(what), st)
        if (where == 1 && name == "submitted") {
            return diagX(env, e, "E-SCOPE-001", "`" + what + ".submitted` — a field of a declaration has no `submitted` of its own (§55.6); its compound has it: `@" + validityDecl(v).hint + ".submitted` (§55.5)", st)
        }
        return plain(Type.Bool, addName(st, e.nid, NameFact.NSurface(v, surfaceProp(name))))
    }

    fn fieldValidity(nf: NameFact | not) -> ValidityOf | not {
        return match nf {
            .NField(decl: d, inst: i, idx: x) :> ValidityOf.OfField(d, i, x)
            .NLocal(sym: s) :> not
            .NInst(decl: d) :> not
            .NStruct(owner: o) :> not
            .NFn(sym: s) :> not
            .NLength :> not
            .NSurface(of: x) :> not
            not :> not
        }
    }

    fn fieldCarriesValidators(env: Env, v: ValidityOf) -> boolean {
        return match v {
            .OfField(decl: d, inst: i, idx: x) :> declFieldValidated(env, d, x)
            .OfDecl(decl: d) :> false
        }
    }

    // A value whose source wrote validators that were all refused (each
    // reported where written): it has no admitted validator, but the author
    // did write some — a surface read of it is not E-VALIDITY-NO-SURFACE.
    fn fieldValidatorsRefused(env: Env, v: ValidityOf) -> boolean {
        return match v {
            .OfField(decl: d, inst: i, idx: x) :> declFieldRefused(env, d, x)
            .OfDecl(decl: d) :> false
        }
    }

    fn declFieldRefused(env: Env, d: Sym, idx: int) -> boolean {
        const ds: DeclSrc | not = findDeclSrc(env.g, d)
        if (ds is not) return false
        if (idx < 0 || idx >= ds.info.fields.length) return false
        const f: FieldInfo = ds.info.fields[idx]
        return f.vals.length == 0 && f.valsWritten > 0
    }

    fn declFieldValidated(env: Env, d: Sym, idx: int) -> boolean {
        const ds: DeclSrc | not = findDeclSrc(env.g, d)
        if (ds is not) return false
        if (idx < 0 || idx >= ds.info.fields.length) return false
        return ds.info.fields[idx].vals.length > 0
    }

    fn exprLabel(e: AExpr) -> string {
        const k: string = placeKey(e)
        if (k == "") return "this value"
        return k
    }

    // The fact recorded so far for node `nid` (the binder's names list, unindexed).
    fn nameFactIn(st: AS, nid: int) -> NameFact | not {
        const i: int = st.facts.names.nids.indexOf(nid)
        if (i < 0) return not
        return st.facts.names.facts[i]
    }

    // 2 = a read of a program cell (top level), 1 = a read of a user
    // declaration's field, 0 = anything else.
    fn fieldReadKind(env: Env, f: NameFact | not) -> int {
        return match f {
            .NField(decl: d) :> declKindOf(env, d)
            .NLocal(sym: s) :> 0
            .NInst(decl: d) :> 0
            .NStruct(owner: o) :> 0
            .NFn(sym: s) :> 0
            .NLength :> 0
            .NSurface(of: x) :> 0
            not :> 0
        }
    }

    fn declKindOf(env: Env, d: Sym) -> int {
        if (d.id == env.g.program.id) return 2
        return 1
    }

    fn resolveCall(env: Env, e: AExpr, callee: AExpr, args: AExpr[], st0: AS) -> RX {
        const n: string = exprName(callee)
        if (n == "reset") return diagX(env, e, "E-RESET-POSITION", "`reset(@x)` is a statement (a write), not a value", st0)
        if (n == "") {
            const m: MethodCall | not = memberCall(callee)
            if (m is given) {
                // s444: the host-call surface (one call — the clock read) and the
                // sequence functions a lambda is admitted to (filter / map)
                if (m.method == "now" && exprName(m.obj) == "Date" && lookupLocal(env, "Date") is not) return resolveHost(env, e, args, st0)
                if (m.method == "filter" || m.method == "map") return resolveSeqCall(env, e, m, args, st0)
            }
            return diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", "only calls of a named function, " + dateNowText() + ", and `.filter(x => …)` / `.map(x => …)` on a sequence are in the bootstrap", st0)
        }
        const rc: RX = resolveExpr(withFnRef(env, callee.nid), callee, not, st0)
        const st: AS = resolveExprs(env, args, not, rc.st)
        const cf: FnInfo | not = calledFn(env, nameFactIn(st, callee.nid))
        if (cf is given) {
            const sp: AS = callPurity(env, e, cf, st)
            // s451 (Ue): a `!` function's call is handled only as a handling form's subject (§19.4.3)
            if (cf.failable && env.fx.subject != e.nid) return plain(not, bySite(env, siteOf(env), conflictDiags(env, cf, e), [], unhandledCall(env, e, cf.name, sp)))
            // s454 (U1b): a server function's call made on the client is failable (§19.9.10)
            if (cf.serverOwn && env.fx.subject != e.nid) return plain(not, remoteUnhandled(env, e, cf, sp))
            return plain(not, sp)
        }
        return plain(not, st)
    }

    fn calledFn(env: Env, f: NameFact | not) -> FnInfo | not {
        return match f {
            .NFn(sym: s) :> fnOfSym(env.g, s)
            .NField(decl: d) :> not
            .NLocal(sym: s) :> not
            .NInst(decl: d) :> not
            .NStruct(owner: o) :> not
            .NLength :> not
            .NSurface(of: x) :> not
            not :> not
        }
    }

    fn fnOfSym(g: Globals, s: Sym) -> FnInfo | not {
        for (const f of g.fns) {
            if (f.info.sym.id == s.id) return f.info
        }
        return not
    }

    // r2 F4 — a call is judged by where it stands, like `Date.now()` itself:
    //  - in a pure `fn` body, a call of a `function` is E-FN-003 — §48.6.2 "A
    //    `fn` body SHALL NOT call a `function`-declared callable (§7.3), because
    //    `function` declarations carry no purity guarantees … Calling a
    //    `function` from inside `fn` is E-FN-003". With it, a `fn` reaches the
    //    clock only by calling it itself (E-FN-004, resolveHost) — §48.6.1's
    //    "transitivity of `fn` constraints" holds by construction.
    //  - where the clock is not in the bootstrap (an initializer, markup, an
    //    attribute value), a call of a function that reads it (directly or
    //    through a call — the effect summary's `clock`) is refused exactly as a
    //    direct `Date.now()` there is.
    // Whether the callee reads the clock is the summary's to say: both are
    // recorded here and decided by rulesPass (dpa-066 M3).
    fn callPurity(env: Env, e: AExpr, cf: FnInfo, st: AS) -> AS {
        const h: HostCtx = env.host
        return match h {
            .HostOk :> st
            .HostPure :> fnCallsFunction(env, e, cf, st)
            .HostNo :> clockCallHere(env, e, cf, st)
        }
    }

    fn fnCallsFunction(env: Env, e: AExpr, cf: FnInfo, st: AS) -> AS {
        if (cf.pure) return st
        return addPending(st, PendRule.PureCall(cf.sym.id, fnCallsFunctionDiag(env, e, cf, ""),
            fnCallsFunctionDiag(env, e, cf, " — and `" + cf.name + "` reads the clock (" + dateNowText() + ", non-deterministic, §48.3.4)")))
    }

    fn fnCallsFunctionDiag(env: Env, e: AExpr, cf: FnInfo, why: string) -> Diag {
        return newDiag("E-FN-003", "a `fn` body calls `" + cf.name + "`, which is declared `function` — a `function` carries no purity guarantee, so a `fn` may call only another `fn` (§48.6.2)" + why + "; declare `" + cf.name + "` with `fn`, or make the caller a `function`", env.file, e.span)
    }

    fn clockCallHere(env: Env, e: AExpr, cf: FnInfo, st: AS) -> AS {
        return addPending(st, PendRule.IfClock(cf.sym.id, newDiag("E-BOOTSTRAP-UNSUPPORTED", "`" + cf.name + "()` reads the clock (" + dateNowText() + ", directly or through a function it calls) — here (an initializer, markup, or an attribute value) that is not in the bootstrap; its host-call surface is a `function` body or an event handler", env.file, e.span)))
    }

    // s444 — THE HOST-CALL SURFACE (progress.md "host call surface"): exactly
    // `Date.now()`, a `number` (ms since the epoch), in a `function` body or an
    // event handler. In a pure `fn` it is E-FN-004 (§33.3 item 7: a pure
    // function SHALL NOT "Call any non-deterministic built-in (`Date.now`, …)";
    // §41.19: the host member-expression `Date.now` "remains covered by the
    // existing E-FN-004"). Elsewhere (an initializer, markup, an `if=`) it is
    // outside the bootstrap: those positions evaluate on a schedule (lazy
    // shared instances, reactive re-runs) the SPEC's one-shot rule (§6.x
    // "one-shot evaluation at module initialization") does not describe.
    // The clock call's spelling, for messages. (impl#1 workaround F-NEW-s444:
    // impl#1's E-FN-004 scan matches the call's TEXT inside a string literal
    // of a `fn` body — so the spelling is never written whole in one here.)
    fn dateNowText() -> string { return "`Date" + ".now()`" }

    fn resolveHost(env: Env, e: AExpr, args: AExpr[], st: AS) -> RX {
        if (args.length > 0) return diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", dateNowText() + " takes no argument", st)
        const h: HostCtx = env.host
        return match h {
            .HostOk :> plain(Type.Num, addValue(st, e.nid, ValueFact.VHost(HostCall.DateNow)))
            .HostPure :> diagX(env, e, "E-FN-004", dateNowText() + " is non-deterministic — a `fn` body is pure and cannot call it (§33.3 item 7, §48.3.4); call it in a `function` (or an event handler) and pass the time in as a parameter", st)
            .HostNo :> diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", dateNowText() + " here (an initializer, markup, or an attribute value) is not in the bootstrap — its host-call surface is a `function` body or an event handler", st)
        }
    }

    // s444 — `seq.filter(x => e)` / `seq.map(x => e)`: a NEW sequence (R3). The
    // one argument is an arrow function of ONE parameter, typed as the element.
    fn resolveSeqCall(env: Env, e: AExpr, m: MethodCall, args: AExpr[], st0: AS) -> RX {
        const ro: RX = resolveExpr(env, m.obj, not, st0)
        let st: AS = ro.st
        let elem: Type | not = not
        const ot: Type | not = ro.x.ty
        const isFilter: boolean = m.method == "filter"
        // what a refusal still answers (a filter keeps the receiver's type), so
        // a `.length` after a refused call is not a second report
        let guess: Type | not = not
        if (isFilter) guess = ot
        if (ot is given) {
            elem = seqElem(ot)
            if (elem is not) return plain(not, addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`." + m.method + "(…)` on a value that is not a sequence (it is `" + typeName(ot) + "`)"))
        }
        const lam: AExpr | not = oneArg(args)
        if (lam is not) return plain(guess, addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`." + m.method + "(…)` takes one arrow function `x => …`"))
        const ps: string[] = lambdaParams(lam)
        if (!isLambda(lam) || ps.length != 1) {
            return plain(guess, addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "the argument of `." + m.method + "(…)` must be an arrow function of one parameter, `x => …` (the bootstrap has no other function value)"))
        }
        let want: Type | not = not
        let op: SeqFn = SeqFn.Map
        if (isFilter) {
            want = Type.Bool
            op = SeqFn.Filter
        }
        const rl: RX = resolveLambda(env, lam, ps, elem, want, st)
        st = rl.st
        // a filter keeps the receiver's type; a map is a sequence of the body's
        // type with the receiver's length (a value — its grants are the receiver's)
        let result: Type | not = guess
        if (!isFilter) result = mappedType(ot, rl.x.ty)
        return plain(result, addValue(st, e.nid, ValueFact.VSeqCall(op)))
    }

    fn oneArg(args: AExpr[]) -> AExpr | not {
        if (args.length != 1) return not
        return args[0]
    }

    fn mappedType(src: Type | not, body: Type | not) -> Type | not {
        if (src is not || body is not) return not
        return mappedOf(src, body)
    }

    fn mappedOf(src: Type, body: Type) -> Type | not {
        return match src {
            .Seq(elem: el, grants: g) :> Type.Seq(body, g)
            .Int :> not
            .Num :> not
            .Str :> not
            .Bool :> not
            .Named(sym: x) :> not
            .Maybe(inner: i) :> not
        }
    }

    // A lambda: its parameters are minted locals (typed `ty` when known, via
    // the annotation table the typer reads); its body is resolved with them in
    // scope. Answers the body's type.
    fn resolveLambda(env: Env, lam: AExpr, ps: string[], ty: Type | not, want: Type | not, st0: AS) -> RX {
        let st: AS = st0
        let env2: Env = env
        let syms: Sym[] = []
        for (const pn of ps) {
            const rs: RSym = mint(st, pn)
            st = rs.st
            syms = syms.concat([rs.s])
            if (ty is given) st = addAnnot(st, rs.s, ty)
            env2 = withLocal(env2, { name: pn, s: rs.s, ty: ty, mutable: false, narrowed: not, nDecl: not })
        }
        st = addValue(st, lam.nid, ValueFact.VLambda(syms))
        const b: AExpr | not = lambdaBody(lam)
        if (b is not) return plain(not, st)
        return resolveExpr(env2, b, want, st)
    }

    fn isLambda(e: AExpr) -> boolean { return lambdaBody(e) is given }

    fn lambdaParams(e: AExpr) -> string[] {
        const k: AExprK = e.k
        return match k {
            .Lambda(params: ps) :> ps
            .Sql(q: q) :> []
            .Handled(h: x) :> []
            .Name(name: n) :> []
            .At(name: n) :> []
            .AtItem :> []
            .Num(raw: r) :> []
            .Str(v: x) :> []
            .Bool(v: b) :> []
            .NotLit :> []
            .Recovered :> []
            .Variant(name: n) :> []
            .Member(obj: o) :> []
            .Call(callee: c) :> []
            .Unary(op: o) :> []
            .Binary(op: o) :> []
            .Ternary(test: t) :> []
            .Assign(target: t) :> []
            .ArrayLit(elems: es) :> []
            .ObjectLit(props: ps2) :> []
            .Spread(e: x) :> []
            .Index(obj: o) :> []
        }
    }

    fn lambdaBody(e: AExpr) -> AExpr | not {
        const k: AExprK = e.k
        return match k {
            .Lambda(params: ps, body: b) :> b
            .Sql(q: q) :> not
            .Handled(h: x) :> not
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: x) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .Assign(target: t) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps2) :> not
            .Spread(e: x) :> not
            .Index(obj: o) :> not
        }
    }

    fn resolveUnary(env: Env, e: AExpr, op: UnOp, x: AExpr, st0: AS) -> RX {
        const isNot: boolean = op == UnOp.Not
        if (isNot) {
            const r: RX = resolveExpr(env, x, Type.Bool, st0)
            return plain(Type.Bool, addValue(r.st, e.nid, ValueFact.VOp(PrimOp.Not)))
        }
        // s460: `x is given` / `x is not` (§42.2.4) — an absence check over a
        // value of any type, lowered as `x != not` / `x == not` are
        const isGiven: boolean = op == UnOp.IsGiven
        const isAbsent: boolean = op == UnOp.IsNot
        if (isGiven || isAbsent) {
            const rp: RX = resolveExpr(env, x, not, st0)
            let prim: PrimOp = PrimOp.IsSome
            if (isAbsent) prim = PrimOp.IsNot
            return plain(Type.Bool, addValue(rp.st, e.nid, ValueFact.VOp(prim)))
        }
        const r2: RX = resolveExpr(env, x, not, st0)
        return plain(r2.x.ty, addValue(r2.st, e.nid, ValueFact.VOp(PrimOp.Neg)))
    }

    fn isVariantExpr(e: AExpr) -> boolean {
        const k: AExprK = e.k
        return match k {
            .Variant(name: n) :> true
            .Name(name: n) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Num(raw: r) :> false
            .Str(v: s) :> false
            .Bool(v: b) :> false
            .NotLit :> false
            .Recovered :> false
            .Member(obj: o) :> false
            .Call(callee: c) :> false
            .Unary(op: o) :> false
            .Binary(op: o) :> false
            .Ternary(test: t) :> false
            .Assign(target: t) :> false
            .ArrayLit(elems: es) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: sx) :> false
            .Index(obj: ix) :> false
            .Lambda(params: lp) :> false
            .Sql(q: q) :> false
            .Handled(h: x) :> false
        }
    }

    // `==` is structural (§45): primitive compare for scalars and nullary
    // enums, the runtime's structural equality for structs and sequences.
    fn isStructural(env: Env, t: Type | not) -> boolean {
        if (t is not) return false
        if (seqElem(t) is given) return true
        const s: Sym | not = namedOf(t)
        if (s is not) return false
        if (isEnumType(env.g.types, t) is given) return false
        return true
    }

    fn resolveBinary(env: Env, e: AExpr, op: BinOp, l: AExpr, r: AExpr, st0: AS) -> RX {
        // operands: a bare variant takes the OTHER operand's type
        let rl: RX = plain(not, st0)
        let rr: RX = plain(not, st0)
        if (isVariantExpr(l) && !isVariantExpr(r)) {
            rr = resolveExpr(env, r, not, st0)
            rl = resolveExpr(env, l, rr.x.ty, rr.st)
            rr = { x: rr.x, st: rl.st }
        } else {
            rl = resolveExpr(env, l, not, st0)
            rr = resolveExpr(env, r, rl.x.ty, rl.st)
        }
        const st: AS = rr.st
        const lt: Type | not = rl.x.ty
        return match op {
            .Eq :> plain(Type.Bool, addValue(st, e.nid, ValueFact.VOp(eqOp(isStructural(env, lt), true))))
            .Ne :> plain(Type.Bool, addValue(st, e.nid, ValueFact.VOp(eqOp(isStructural(env, lt), false))))
            .Add :> plain(lt, addValue(st, e.nid, ValueFact.VOp(addOp(lt, rr.x.ty))))
            .Sub :> plain(lt, addValue(st, e.nid, ValueFact.VOp(PrimOp.Sub)))
            .Mul :> plain(lt, addValue(st, e.nid, ValueFact.VOp(PrimOp.Mul)))
            .Div :> plain(Type.Num, addValue(st, e.nid, ValueFact.VOp(PrimOp.Div)))
            .Mod :> plain(lt, addValue(st, e.nid, ValueFact.VOp(PrimOp.Mod)))
            .Lt :> plain(Type.Bool, addValue(st, e.nid, ValueFact.VOp(PrimOp.Lt)))
            .Le :> plain(Type.Bool, addValue(st, e.nid, ValueFact.VOp(PrimOp.Le)))
            .Gt :> plain(Type.Bool, addValue(st, e.nid, ValueFact.VOp(PrimOp.Gt)))
            .Ge :> plain(Type.Bool, addValue(st, e.nid, ValueFact.VOp(PrimOp.Ge)))
            .And :> plain(Type.Bool, addValue(st, e.nid, ValueFact.VOp(PrimOp.And)))
            .Or :> plain(Type.Bool, addValue(st, e.nid, ValueFact.VOp(PrimOp.Or)))
            .Pipe :> diagX(env, e, "E-BOOTSTRAP-UNSUPPORTED", "`|` outside a `rule=` alternation is not in bootstrap slice M2", st)
        }
    }

    fn eqOp(structural: boolean, eq: boolean) -> PrimOp {
        if (structural && eq) return PrimOp.EqStruct
        if (structural) return PrimOp.NeqStruct
        if (eq) return PrimOp.EqPrim
        return PrimOp.NeqPrim
    }

    fn isStrType(t: Type | not) -> boolean {
        if (t is not) return false
        return t == Type.Str
    }

    fn addOp(a: Type | not, b: Type | not) -> PrimOp {
        if (isStrType(a) || isStrType(b)) return PrimOp.Concat
        return PrimOp.Add
    }

    fn resolveTernary(env: Env, e: AExpr, test: AExpr, yes: AExpr, no: AExpr, expected: Type | not, st0: AS) -> RX {
        const rt: RX = plain(Type.Bool, resolveCond(env, test, st0))
        const ry: RX = resolveExpr(withPresent(env, presenceHandle(env, test)), yes, expected, rt.st)
        let want: Type | not = expected
        if (want is not) want = ry.x.ty
        const rn: RX = resolveExpr(env, no, want, ry.st)
        let t: Type | not = ry.x.ty
        if (t is not) t = rn.x.ty
        return plain(t, rn.st)
    }

    fn resolveArray(env: Env, e: AExpr, es: AExpr[], expected: Type | not, st0: AS) -> RX {
        let elem: Type | not = not
        if (expected is given) elem = seqElem(expected)
        const st: AS = resolveExprs(env, es, elem, st0)
        return plain(expected, st)
    }

    // An object literal is a struct VALUE of the type its position expects,
    // constructed by field name (§66.18: never positionally).
    fn resolveObject(env: Env, e: AExpr, ps: AProp[], expected: Type | not, st0: AS) -> RX {
        let st: AS = dupKeys(env, ps, st0)
        const s: Sym | not = namedOf(expectedOr(expected))
        if (s is not) {
            return diagX(env, e, "E-TYPE-STRUCT-CONTEXT", "an object literal needs a struct type from its position (an annotated declaration or field)", resolvePropValues(env, ps, st))
        }
        const ti: TypeInfo | not = typeInfoOf(env.g.types, s)
        if (ti is not) return diagX(env, e, "E-TYPE-STRUCT-CONTEXT", "`" + s.hint + "` is not a struct type", st)
        const fs: FieldDef[] | not = structFieldDefs(ti.def)
        if (fs is not) return diagX(env, e, "E-TYPE-STRUCT-CONTEXT", "`" + s.hint + "` is not a struct type", st)
        let order: int[] = []
        for (const fd of fs) {
            let at: int = -1
            let j = 0
            for (const p of ps) {
                if (!p.spread && p.name == fd.sym.hint) at = j
                j = j + 1
            }
            if (at < 0) st = addDiag(st, env.file, e.span, "E-TYPE-STRUCT-FIELD", "`" + s.hint + "` value is missing field `" + fd.sym.hint + "`")
            order = order.concat([at])
        }
        let j2 = 0
        for (const p of ps) {
            if (p.spread) {
                st = addDiag(st, env.file, p.span, "E-BOOTSTRAP-UNSUPPORTED", "a spread `...` is in slice M2 only as `@x = { ...@x, f: v }` (a field edit, O58 (b))")
            } else {
                let fty: Type | not = not
                for (const fd of fs) {
                    if (fd.sym.hint == p.name) fty = fd.ty
                }
                if (fty is not) st = addDiag(st, env.file, p.span, "E-TYPE-STRUCT-FIELD", "`" + s.hint + "` has no field `" + p.name + "`")
                st = resolveExpr(env, p.value, fty, st).st
            }
            j2 = j2 + 1
        }
        return plain(Type.Named(s), addValue(st, e.nid, ValueFact.VStructOf(s, order)))
    }

    // RULED S440 ("duplicate keys are an error in ANY struct literal": "a
    // duplicate key in any struct literal (plain, nested, or the
    // spread-override shape) is a compile error"); SPEC §14.3: "A duplicate
    // key in any struct literal — a plain literal (`@p = { x: 5, x: 6, y: 1,
    // z: 1 }`), a nested one, or the spread-override shape … — is a compile
    // error, **`E-STRUCT-DUPLICATE-KEY`**." One report per repeated key, at
    // the repeat, whatever the literal's type (a nested literal is resolved
    // through here too). The spread-override shape — resolved as field edits,
    // not through here — reports the same code (dupOverride).
    fn dupKeys(env: Env, ps: AProp[], st0: AS) -> AS {
        let st: AS = st0
        let j = 0
        while (j < ps.length) {
            if (!ps[j].spread && keyBefore(ps, j)) st = dupOverride(env, st, ps[j])
            j = j + 1
        }
        return st
    }

    // Is prop `j`'s key named by an earlier (non-spread) prop?
    fn keyBefore(ps: AProp[], j: int) -> boolean {
        let k = 0
        while (k < j) {
            if (!ps[k].spread && ps[k].name == ps[j].name) return true
            k = k + 1
        }
        return false
    }

    fn expectedOr(t: Type | not) -> Type {
        if (t is given) return t
        return Type.Str
    }

    fn resolvePropValues(env: Env, ps: AProp[], st0: AS) -> AS {
        let st: AS = st0
        for (const p of ps) { st = resolveExpr(env, p.value, not, st).st }
        return st
    }

    // =========================================================================
    // Writes — THE EDIT CLASSIFIER (§6.2, §66.11.2).
    // =========================================================================
    // A write target resolved to a PLACE: field `idx` of declaration `decl`
    // through `inst`, then struct steps `path` (a FieldAt when non-empty).
    type WPlace:struct = { decl: DeclInfo, inst: InstRef, idx: int, path: FieldRef[], ty: Type | not, maybe: boolean }
    type RPlace:struct = { place: WPlace | not, local: LocalB | not, st: AS }

    fn noPlace(st: AS) -> RPlace { return { place: not, local: not, st: st } }

    fn resolvePlace(env: Env, t: AExpr, st: AS) -> RPlace {
        const k: AExprK = t.k
        return match k {
            .At(name: n) :> placeAt(env, t, n, st)
            .Member(obj: o, name: n) :> placeMember(env, t, o, n, st)
            .Name(name: n) :> placeName(env, t, n, st)
            .AtItem :> noPlace(addDiag(st, env.file, t.span, "E-WRITE-NOT-GRANTED", "a row value `@.` is a read-only projection of the row"))
            .Num(raw: r) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .Str(v: s) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .Bool(v: b) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .NotLit :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .Recovered :> noPlace(st)
            .Variant(name: n) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .Call(callee: c) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .Unary(op: o) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .Binary(op: o) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .Ternary(test: x) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .Assign(target: x) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .ArrayLit(elems: es) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .ObjectLit(props: ps) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .Spread(e: x) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .Index(obj: o) :> noPlace(addDiag(st, env.file, t.span, "E-BOOTSTRAP-UNSUPPORTED", "writing an element `a[i]` is in the bootstrap only as an element-FIELD write (`@xs[i].f = v`, dpa-052 Q3) — Core has no position-write place"))
            .Lambda(params: ps2) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .Sql(q: q) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
            .Handled(h: x) :> noPlace(addDiag(st, env.file, t.span, "E-ASSIGN-TARGET", "not a writable place"))
        }
    }

    fn placeAt(env: Env, t: AExpr, name: string, st: AS) -> RPlace {
        // s444 — O54 (a): `@f` in f's own renders is this instance's field `f`
        const oi: int = ownFieldIndex(env, name)
        if (oi >= 0) {
            const od: DeclSrc | not = ctxDecl(env)
            if (od is given) {
                return { place: { decl: od.info, inst: InstRef.Lexical(0), idx: oi, path: [], ty: od.info.fields[oi].ty, maybe: false },
                         local: not, st: st }
            }
        }
        const pi: DeclInfo | not = programInfo(env)
        if (pi is given && lookupHandle(env, name) is not) {
            const i: int = fieldIndex(pi, name)
            if (i >= 0) {
                return { place: { decl: pi, inst: programInst(env), idx: i, path: [], ty: pi.fields[i].ty, maybe: false },
                         local: not, st: st }
            }
        }
        return noPlace(addDiag(st, env.file, t.span, "E-BOOTSTRAP-UNSUPPORTED", "`@" + name + " = …` — writing a whole instance is not in bootstrap slice M2 (write a field: `@" + name + ".f = …`)"))
    }

    fn placeName(env: Env, t: AExpr, name: string, st: AS) -> RPlace {
        const l: LocalB | not = lookupLocal(env, name)
        if (l is given) return { place: not, local: l, st: st }
        const d: DeclSrc | not = ctxDecl(env)
        if (d is given && env.inRenders) {
            if (!d.isProgram && fieldIndex(d.info, name) >= 0) {
                return noPlace(addDiag(st, env.file, t.span, "E-DECL-RENDERS-BARE-WRITE", "`" + name + "` inside a `renders` is a read-only projection — write it as `@" + d.info.sym.hint + "." + name + "` (§66.5.2)"))
            }
        }
        return noPlace(addDiag(st, env.file, t.span, "E-SCOPE-001", "`" + name + "` is not a writable local"))
    }

    fn placeMember(env: Env, t: AExpr, obj: AExpr, name: string, st0: AS) -> RPlace {
        // obj names an instance → a field of its declaration
        const ro: RX = resolveHandleSubject(env, obj, st0)
        const st: AS = ro.st
        const inst: InstRef | not = ro.x.inst
        const iDecl: Sym | not = ro.x.iDecl
        if (inst is given && iDecl is given) {
            const d: DeclSrc | not = findDeclSrc(env.g, iDecl)
            if (d is not) return noPlace(st)
            const i: int = fieldIndex(d.info, name)
            if (i < 0 && isSurfaceProp(name) && !d.isProgram) return noPlace(addDiag(st, env.file, t.span, "E-SYNTHESIZED-WRITE", "`@" + d.info.sym.hint + "." + name + "` is a synthesized validity property — read-only (§55.5, §55.7)"))
            if (i < 0) return noPlace(addDiag(st, env.file, t.span, "E-SCOPE-001", "`<" + d.info.sym.hint + ">` has no field `" + name + "`"))
            return { place: { decl: d.info, inst: inst, idx: i, path: [], ty: d.info.fields[i].ty, maybe: ro.x.maybe },
                     local: not, st: st }
        }
        // obj is itself a place of struct type → a FieldAt step
        const rp: RPlace = resolvePlace(env, obj, st0)
        const base: WPlace | not = rp.place
        if (base is not) return rp
        // s449 — a field's surface property is read-only too (§55.5.1 rule 7, §55.7)
        if (isSurfaceProp(name) && base.path.length == 0) {
            const isProg: boolean = base.decl.sym.id == env.g.program.id
            if (!isProg || base.decl.fields[base.idx].vals.length > 0) {
                return noPlace(addDiag(rp.st, env.file, t.span, "E-SYNTHESIZED-WRITE", "`" + exprLabel(obj) + "." + name + "` is a synthesized validity property — read-only (§55.5.1 rule 7, §55.7)"))
            }
        }
        const bt: Type | not = base.ty
        if (bt is given) {
            const s: Sym | not = namedOf(bt)
            if (s is given) {
                const ti: TypeInfo | not = typeInfoOf(env.g.types, s)
                if (ti is given) {
                    const fs: FieldDef[] | not = structFieldDefs(ti.def)
                    if (fs is given) {
                        let i = 0
                        for (const fd of fs) {
                            if (fd.sym.hint == name) {
                                const p: WPlace = { decl: base.decl, inst: base.inst, idx: base.idx,
                                                    path: base.path.concat([{ owner: s, idx: i }]), ty: fd.ty, maybe: base.maybe }
                                return { place: p, local: not, st: rp.st }
                            }
                            i = i + 1
                        }
                    }
                }
            }
        }
        return noPlace(addDiag(rp.st, env.file, t.span, "E-ASSIGN-TARGET", "`." + name + "` is not a field of a struct here"))
    }

    // The FieldDef a FieldAt path ends at.
    fn pathTarget(env: Env, p: WPlace) -> FieldDef | not {
        let target: FieldDef | not = not
        for (const step of p.path) {
            const ti: TypeInfo | not = typeInfoOf(env.g.types, step.owner)
            if (ti is not) return not
            const fs: FieldDef[] | not = structFieldDefs(ti.def)
            if (fs is not) return not
            if (step.idx < 0 || step.idx >= fs.length) return not
            target = fs[step.idx]
        }
        return target
    }

    fn derivedMessage(p: WPlace, f: FieldInfo) -> string {
        const deps: string = f.reads.join(", ")
        return "Assignment to derived value `@" + f.sym.hint + "`. `" + f.sym.hint + "` is derived (a locked declaration whose initializer reads " + deps + ") — it recomputes and cannot be written. To change it, write one of its dependencies. If you want a value that STARTS from that expression and is then written independently, declare it `let` — it becomes SEEDED: computed once, and it no longer follows " + deps + " (§66.9)."
    }

    // L8: a transition is Static only when Core can prove the edge — a literal
    // every state may move to; otherwise the edge is checked at runtime.
    // A literal target no state can EVER legally reach (no incoming edge, and
    // not the field's initial state) is refused here (E-ENGINE-INVALID-TRANSITION).
    type RCheck:struct = { check: Check, st: AS }

    fn transitionCheck(env: Env, g: TransitionGraph, value: AExpr, initial: int, st: AS) -> RCheck {
        const k: AExprK = value.k
        const lit: string = variantLitName(k)
        if (lit == "") return { check: Check.RuntimeEdge, st: st }
        const to: int = variantIndex(env.g.types, g.enumSym, lit)
        if (to < 0) return { check: Check.RuntimeEdge, st: st }
        let incoming = false
        for (const e of g.edges) {
            if (e.origin != to && e.targets.indexOf(to) >= 0) incoming = true
        }
        if (!incoming && to != initial) {
            const st2: AS = addDiag(st, env.file, value.span, "E-ENGINE-INVALID-TRANSITION", "`." + lit + "` has no incoming edge in the `rule=` graph and is not the initial state — no write can reach it (§66.13.2)")
            return { check: Check.RuntimeEdge, st: st2 }
        }
        return { check: Check.RuntimeEdge, st: st }
    }

    fn variantLitName(k: AExprK) -> string {
        return match k {
            .Variant(name: n) :> n
            .Name(name: n) :> ""
            .At(name: n) :> ""
            .AtItem :> ""
            .Num(raw: r) :> ""
            .Str(v: s) :> ""
            .Bool(v: b) :> ""
            .NotLit :> ""
            .Recovered :> ""
            .Member(obj: o) :> ""
            .Call(callee: c) :> ""
            .Unary(op: o) :> ""
            .Binary(op: o) :> ""
            .Ternary(test: t) :> ""
            .Assign(target: t) :> ""
            .ArrayLit(elems: es) :> ""
            .ObjectLit(props: ps) :> ""
            .Spread(e: sx) :> ""
            .Index(obj: ix) :> ""
            .Lambda(params: lp) :> ""
            .Sql(q: q) :> ""
            .Handled(h: x) :> ""
        }
    }

    // The initial variant of a graph field (its own value), for the reachability rule.
    fn initialVariant(env: Env, g: TransitionGraph, init: AAttrValue) -> int {
        return match init {
            .Bare(e: e) :> initialOf(env, g, e)
            .Paren(e: e) :> initialOf(env, g, e)
            .NoValue :> -1
            .Quoted(v: s) :> -1
            .Braced(b: b) :> -1
        }
    }

    fn initialOf(env: Env, g: TransitionGraph, e: AExpr) -> int {
        const k: AExprK = e.k
        const n: string = variantLitName(k)
        if (n == "") return -1
        return variantIndex(env.g.types, g.enumSym, n)
    }

    // The checks every write shares: the handle is narrowed (§66.7.5), the field
    // is writable from this file (E2, §66.14).
    fn writeGuards(env: Env, p: WPlace, span: ASpan, st0: AS) -> AS {
        let st: AS = st0
        if (p.maybe) {
            st = addDiag(st, env.file, span, "E-DECL-HANDLE-NOT-NARROWED", "this handle names a conditionally-mounted instance (`" + p.decl.sym.hint + " | not`) — narrow it first: `given c = @handle :> { c.field = … }` (§66.7.5)")
        }
        const f: FieldInfo = p.decl.fields[p.idx]
        if (p.decl.file != env.file && !f.exported) {
            st = addDiag(st, env.file, span, "E-FIELD-PRIVATE-WRITE", "`" + f.sym.hint + "` of `<" + p.decl.sym.hint + ">` is not exported — it is writable only inside its defining file (§66.14)")
        }
        return st
    }

    // `target = value` (statement position).
    fn resolveAssign(env: Env, e: AExpr, target: AExpr, value: AExpr, st0: AS) -> AS {
        // s442: the recognized sequence reassignment shapes (§66.11.2) and an
        // element-field write (dpa-052 Q3).
        // r1 F1: only a CELL / field place — a local (or a place rooted in one)
        // takes the ordinary local path below (E-ASSIGN-CONST, value resolution).
        const shape: int = seqEditShape(target, value)
        if (shape > 0 && !rootIsLocal(env, target)) return resolveSeqShape(env, e, target, value, shape, st0)
        const ef: ElemFieldTarget | not = elemFieldTarget(target)
        if (ef is given) {
            if (!rootIsLocal(env, ef.seq)) return resolveElemFieldWrite(env, e, ef, value, st0)
        }
        // `@inst = { ...@inst, f: v }` — the self-spread of an INSTANCE: field
        // edits of that instance (O58 (b)).
        if (isSelfSpread(target, value)) {
            const ri: RX = resolveHandleSubject(env, target, st0)
            const inst: InstRef | not = ri.x.inst
            const iDecl: Sym | not = ri.x.iDecl
            if (inst is given && iDecl is given) return resolveInstanceSpread(env, e, inst, iDecl, ri.x.maybe, value, ri.st)
        }
        const rp: RPlace = resolvePlace(env, target, st0)
        let st: AS = rp.st
        const l: LocalB | not = rp.local
        if (l is given) {
            if (!l.mutable) st = addDiag(st, env.file, target.span, "E-ASSIGN-CONST", "`" + l.name + "` is not a `let` local")
            st = addEffect(st, e.nid, EffectFact.EAssignLocal(l.s))
            return resolveExpr(env, value, l.ty, st).st
        }
        const p: WPlace | not = rp.place
        if (p is not) return resolveExpr(env, value, not, st).st
        st = writeGuards(env, p, target.span, st)
        const f: FieldInfo = p.decl.fields[p.idx]
        if (p.path.length == 0 && isSelfSpread(target, value)) return resolveSpread(env, e, p, f, value, st)
        if (p.path.length > 0) return resolveFieldAt(env, e, p, f, value, st)
        const rv: RX = resolveExpr(env, value, f.ty, st)
        const rw: RWriteFact = wholeFieldWrite(env, p, f, value, rv.st, e.span)
        const w: WriteFact | not = rw.w
        if (w is given) return addEffect(rw.st, e.nid, EffectFact.EWrite(w))
        return rw.st
    }

    // A write of a WHOLE field (§66.11): along its graph (a Transition), a
    // `replace`, or refused — E-DERIVED-WRITE for a derived field (its message
    // names the `let`-seeding trade-off, §66.9 rule 5), E-WRITE-NOT-GRANTED
    // for a locked one (its message names `let`).
    fn wholeFieldWrite(env: Env, p: WPlace, f: FieldInfo, value: AExpr, st: AS, span: ASpan) -> RWriteFact {
        const g: TransitionGraph | not = f.graph
        const cap: Sym | not = f.wcap
        if (g is given && cap is given) {
            const rc: RCheck = transitionCheck(env, g, value, initialVariant(env, g, f.init), st)
            return { w: { cap: cap, inst: p.inst, edit: EditKind.Transition, check: rc.check }, st: rc.st }
        }
        if (f.grants.replace && cap is given) {
            return { w: { cap: cap, inst: p.inst, edit: EditKind.Replace, check: Check.Static }, st: st }
        }
        const isDerived: boolean = f.mode == FieldMode.Derived
        if (isDerived) return { w: not, st: addDiag(st, env.file, span, "E-DERIVED-WRITE", derivedMessage(p, f)) }
        // r2 F6: a field whose contract grants edits but not `replace` is not
        // locked — say which grant this whole-value write needs
        if (f.grants.edits.length > 0) return { w: not, st: addDiag(st, env.file, span, "E-WRITE-NOT-GRANTED", replaceNotGrantedMsg(f)) }
        return { w: not, st: addDiag(st, env.file, span, "E-WRITE-NOT-GRANTED", "`@" + f.sym.hint + "` is locked — nothing grants this write (a whole-value replace). Declare it `let <" + f.sym.hint + "…/>` (`let` before the `<`, §66.2.5) to make it writable (§66.9, §66.11).") }
    }

    fn replaceNotGrantedMsg(f: FieldInfo) -> string {
        const n: string = f.sym.hint
        let msg: string = "`@" + n + " = …` is a whole-value replace of `@" + n + "`, and its contract does not grant `replace` — it grants edits only (§66.11.2: a whole-value write is checked against the grants, whatever the spelling)"
        if (grantsEdit(f.grants.edits, EditKind.RemoveAnywhere)) msg = msg + ". A removal is `@" + n + " = @" + n + ".filter(x => …)` of its OWN value (`remove`)"
        if (seqElem(f.ty) is given) msg = msg + "; to write any value, add `replace` to the type's grants (§66.12.2)"
        return msg
    }

    fn grantsEdit(es: EditKind[], k: EditKind) -> boolean {
        for (const e of es) {
            if (e == k) return true
        }
        return false
    }

    // `@h = { ...@h, f: v, … }` over an instance: one field write per override,
    // each judged by that field's own contract exactly as `@h.f = v` is.
    fn resolveInstanceSpread(env: Env, e: AExpr, inst: InstRef, iDecl: Sym, maybe: boolean, value: AExpr, st0: AS) -> AS {
        let st: AS = st0
        const d: DeclSrc | not = findDeclSrc(env.g, iDecl)
        if (d is not) return st
        const ps: AProp[] = propsOf(value)
        // the spread operand `...@h` names the instance (a subject, like a
        // write target — no read check; writeGuards reports an un-narrowed
        // handle). lower reads it as the statement's snapshot (S440).
        st = resolveHandleSubject(env, ps[0].value, st).st
        let ws: SpreadWrite[] = []
        let j = 1
        while (j < ps.length) {
            const pr: AProp = ps[j]
            const i: int = fieldIndex(d.info, pr.name)
            if (overriddenBefore(ps, j)) {
                st = dupOverride(env, st, pr)
            } else if (i < 0) {
                st = addDiag(st, env.file, pr.span, "E-SCOPE-001", "`<" + d.info.sym.hint + ">` has no field `" + pr.name + "`")
            } else {
                const f: FieldInfo = d.info.fields[i]
                const p: WPlace = { decl: d.info, inst: inst, idx: i, path: [], ty: f.ty, maybe: maybe }
                st = writeGuards(env, p, pr.span, st)
                st = resolveExpr(env, pr.value, f.ty, st).st
                const rw: RWriteFact = wholeFieldWrite(env, p, f, pr.value, st, pr.span)
                st = rw.st
                const w: WriteFact | not = rw.w
                if (w is given) {
                    const m: RSym = mint(st, pr.name)
                    st = m.st
                    ws = ws.concat([{ w: w, prop: j, tmp: m.s }])
                }
            }
            j = j + 1
        }
        let refs: FieldRef[] = []
        let names: string[] = []
        let fi = 0
        for (const fd of d.info.fields) {
            refs = refs.concat([{ owner: iDecl, idx: fi }])
            names = names.concat([fd.sym.hint])
            fi = fi + 1
        }
        return spreadEffect(st, e, ws, iDecl.hint, refs, names)
    }

    // The spread's effect. `inst` is the local the written instance is resolved
    // into ONCE, before the Commit (lower: `Let inst = Handle(…)`, the writes go
    // through `Narrowed(inst)`), so a flush can never make a later write of the
    // same edit re-resolve a handle to a different instance. Minted here so
    // `lower` still decides nothing.
    // STRICT SNAPSHOT (RULED S440): every `@x` read inside the override values
    // reads a value taken BEFORE any override value is evaluated — so a call in
    // one override that writes `@x` is not seen by another. The snapshot is
    // PER FIELD (`fields`: one local per field of the target, the field's
    // FieldRef beside it), and lower reads only the fields the override values
    // read lexically: taking a whole-value snapshot would `.get()` — and so
    // subscribe to — every field when the spread runs inside an effect (S440
    // re-review N1: a runaway re-run loop). `snap` is the whole-value local,
    // used only when an override value reads the WHOLE `@x` (which reads every
    // field lexically anyway).
    fn spreadEffect(st0: AS, e: AExpr, ws: SpreadWrite[], hint: string, refs: FieldRef[], names: string[]) -> AS {
        const m: RSym = mint(st0, hint)
        const sn: RSym = mint(m.st, "before")
        let st: AS = sn.st
        let fields: SnapField[] = []
        let k = 0
        for (const r of refs) {
            const fm: RSym = mint(st, "before_" + names[k])
            st = fm.st
            fields = fields.concat([{ ref: r, local: fm.s }])
            k = k + 1
        }
        return addEffect(st, e.nid, EffectFact.ESpread(ws, m.s, sn.s, fields))
    }

    // RULED S440: a spread-override literal names each field at most once.
    fn overriddenBefore(ps: AProp[], j: int) -> boolean {
        let k = 1
        while (k < j) {
            if (ps[k].name == ps[j].name) return true
            k = k + 1
        }
        return false
    }

    // A struct literal's repeated key — the spread-override shape and a plain
    // literal alike (RULED S440; SPEC §14.3, §66.11.3; §34 E-STRUCT-DUPLICATE-KEY).
    fn dupOverride(env: Env, st: AS, pr: AProp) -> AS {
        return addDiag(st, env.file, pr.span, "E-STRUCT-DUPLICATE-KEY", "`" + pr.name + "` is named twice in this struct literal — a struct literal names each key at most once (in a spread, an override edits its field once); keep one `" + pr.name + ": …` (§14.3, ruled S440)")
    }

    // A write at a struct path (`@o.s = v`): the TARGET sub-field's own contract.
    fn resolveFieldAt(env: Env, e: AExpr, p: WPlace, f: FieldInfo, value: AExpr, st0: AS) -> AS {
        const rv: RX = resolveExpr(env, value, p.ty, st0)
        let st: AS = rv.st
        const r: RWriteFact = fieldAtWrite(env, p, f, value, st, e.span)
        st = r.st
        const w: WriteFact | not = r.w
        if (w is given) st = addEffect(st, e.nid, EffectFact.EWrite(w))
        return st
    }

    type RWriteFact:struct = { w: WriteFact | not, st: AS }

    fn fieldAtWrite(env: Env, p: WPlace, f: FieldInfo, value: AExpr, st: AS, span: ASpan) -> RWriteFact {
        const cap: Sym | not = f.wcap
        const target: FieldDef | not = pathTarget(env, p)
        if (target is not || cap is not) {
            return { w: not, st: addDiag(st, env.file, span, "E-WRITE-NOT-GRANTED", "`@" + f.sym.hint + "` grants no write") }
        }
        const edit: EditKind = EditKind.FieldAt(p.path)
        if (target.grants.replace) return { w: { cap: cap, inst: p.inst, edit: edit, check: Check.Static }, st: st }
        if (f.grants.replace && target.grants.edits.length == 0) return { w: { cap: cap, inst: p.inst, edit: edit, check: Check.Static }, st: st }
        return { w: not, st: addDiag(st, env.file, span, "E-WRITE-NOT-GRANTED", "`" + target.sym.hint + "` is not writable here — its contract grants no replace (§66.11.4)") }
    }

    // `@x = { ...@x, f: v, … }` — the spread of the SAME place with named
    // overrides is a FIELD EDIT per override (O58 (b), ruled S437): each is
    // judged by `f`'s own contract, exactly as `@x.f = v` is.
    fn isSelfSpread(target: AExpr, value: AExpr) -> boolean {
        const k: AExprK = value.k
        return match k {
            .ObjectLit(props: ps) :> spreadsTarget(target, ps)
            .Spread(e: x) :> false
            .Index(obj: o) :> false
            .Lambda(params: ps2) :> false
            .Sql(q: q) :> false
            .Handled(h: x) :> false
            .Name(name: n) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Num(raw: r) :> false
            .Str(v: s) :> false
            .Bool(v: b) :> false
            .NotLit :> false
            .Recovered :> false
            .Variant(name: n) :> false
            .Member(obj: o) :> false
            .Call(callee: c) :> false
            .Unary(op: o) :> false
            .Binary(op: o) :> false
            .Ternary(test: t) :> false
            .Assign(target: t) :> false
            .ArrayLit(elems: es) :> false
        }
    }

    fn spreadsTarget(target: AExpr, ps: AProp[]) -> boolean {
        if (ps.length == 0) return false
        if (!ps[0].spread) return false
        let i = 1
        while (i < ps.length) {
            if (ps[i].spread) return false
            i = i + 1
        }
        return samePlaceSyntax(target, ps[0].value)
    }

    // Two place expressions spelled the same (`@order` / `@order`, `@c.o` / `@c.o`).
    fn samePlaceSyntax(a: AExpr, b: AExpr) -> boolean {
        return placeKey(a) != "" && placeKey(a) == placeKey(b)
    }

    fn placeKey(e: AExpr) -> string {
        const k: AExprK = e.k
        return match k {
            .At(name: n) :> "@" + n
            .Name(name: n) :> n
            .Member(obj: o, name: n) :> memberKey(placeKey(o), n)
            .AtItem :> ""
            .Num(raw: r) :> ""
            .Str(v: s) :> ""
            .Bool(v: b) :> ""
            .NotLit :> ""
            .Recovered :> ""
            .Variant(name: n) :> ""
            .Call(callee: c) :> ""
            .Unary(op: o) :> ""
            .Binary(op: o) :> ""
            .Ternary(test: t) :> ""
            .Assign(target: t) :> ""
            .ArrayLit(elems: es) :> ""
            .ObjectLit(props: ps) :> ""
            .Spread(e: sx) :> ""
            .Index(obj: ix) :> ""
            .Lambda(params: lp) :> ""
            .Sql(q: q) :> ""
            .Handled(h: x) :> ""
        }
    }

    fn memberKey(base: string, n: string) -> string {
        if (base == "") return ""
        return base + "." + n
    }

    fn resolveSpread(env: Env, e: AExpr, p: WPlace, f: FieldInfo, value: AExpr, st0: AS) -> AS {
        let st: AS = st0
        const s: Sym | not = namedOf(f.ty)
        let fs: FieldDef[] = []
        if (s is given) {
            const ti: TypeInfo | not = typeInfoOf(env.g.types, s)
            if (ti is given) {
                const d: FieldDef[] | not = structFieldDefs(ti.def)
                if (d is given) fs = d
            }
        }
        if (s is not || fs.length == 0) return addDiag(st, env.file, e.span, "E-TYPE-STRUCT-CONTEXT", "a spread write needs a struct-typed target")
        const ps: AProp[] = propsOf(value)
        // the spread operand reads the place itself
        st = resolveExpr(env, ps[0].value, f.ty, st).st
        let ws: SpreadWrite[] = []
        let j = 1
        while (j < ps.length) {
            const pr: AProp = ps[j]
            let idx: int = -1
            let i = 0
            for (const fd of fs) {
                if (fd.sym.hint == pr.name) idx = i
                i = i + 1
            }
            if (overriddenBefore(ps, j)) {
                st = dupOverride(env, st, pr)
            } else if (idx < 0) {
                st = addDiag(st, env.file, pr.span, "E-TYPE-STRUCT-FIELD", "`" + s.hint + "` has no field `" + pr.name + "`")
            } else {
                const sub: WPlace = { decl: p.decl, inst: p.inst, idx: p.idx, path: [{ owner: s, idx: idx }], ty: fs[idx].ty, maybe: p.maybe }
                const rv: RX = resolveExpr(env, pr.value, fs[idx].ty, st)
                const rw: RWriteFact = fieldAtWrite(env, sub, f, pr.value, rv.st, pr.span)
                st = rw.st
                const w: WriteFact | not = rw.w
                if (w is given) {
                    const m: RSym = mint(st, pr.name)
                    st = m.st
                    ws = ws.concat([{ w: w, prop: j, tmp: m.s }])
                }
            }
            j = j + 1
        }
        let refs: FieldRef[] = []
        let names: string[] = []
        let fi = 0
        for (const fd of fs) {
            refs = refs.concat([{ owner: s, idx: fi }])
            names = names.concat([fd.sym.hint])
            fi = fi + 1
        }
        return spreadEffect(st, e, ws, p.decl.sym.hint, refs, names)
    }

    fn propsOf(v: AExpr) -> AProp[] {
        const k: AExprK = v.k
        return match k {
            .ObjectLit(props: ps) :> ps
            .Spread(e: sx) :> []
            .Index(obj: ix) :> []
            .Lambda(params: lp) :> []
            .Sql(q: q) :> []
            .Handled(h: x) :> []
            .Name(name: n) :> []
            .At(name: n) :> []
            .AtItem :> []
            .Num(raw: r) :> []
            .Str(v: s) :> []
            .Bool(v: b) :> []
            .NotLit :> []
            .Recovered :> []
            .Variant(name: n) :> []
            .Member(obj: o) :> []
            .Call(callee: c) :> []
            .Unary(op: o) :> []
            .Binary(op: o) :> []
            .Ternary(test: t) :> []
            .Assign(target: t) :> []
            .ArrayLit(elems: es) :> []
        }
    }

    // `reset(@x)` (L4): a replace with x's initializer — needs `replace`
    // (§66.11.2: reset IS a replace; O58 (b): it restores the declared initial
    // state authoritatively, bypassing sub-field contracts).
    fn resolveReset(env: Env, e: AExpr, args: AExpr[], st0: AS) -> AS {
        if (args.length != 1) return addDiag(st0, env.file, e.span, "E-RESET-ARG", "`reset` takes one cell: `reset(@x)`")
        const rp: RPlace = resolvePlace(env, args[0], st0)
        let st: AS = rp.st
        const p: WPlace | not = rp.place
        if (p is not) return st
        st = writeGuards(env, p, args[0].span, st)
        const f: FieldInfo = p.decl.fields[p.idx]
        const cap: Sym | not = f.wcap
        if (p.path.length > 0) return addDiag(st, env.file, e.span, "E-RESET-ARG", "`reset` takes a whole cell, not a sub-field")
        if (!f.grants.replace || cap is not) {
            return addDiag(st, env.file, e.span, "E-WRITE-NOT-GRANTED", "`reset(@" + f.sym.hint + ")` is a replace (§66.11.2) and `" + f.sym.hint + "` does not grant `replace` — declare it `let`")
        }
        return addEffect(st, e.nid, EffectFact.EReset({ cap: cap, inst: p.inst, edit: EditKind.Replace, check: Check.Static }, p.decl.sym, p.idx))
    }

    // =========================================================================
    // Statements.
    // =========================================================================
    type RB:struct = { env: Env, st: AS }

    // A statement-position expression: an assignment, a `reset`, or a value.
    fn resolveStmtExpr(env: Env, e: AExpr, st: AS) -> AS {
        const k: AExprK = e.k
        return match k {
            .Assign(target: t, value: v) :> resolveAssign(withWholeAt(env, v.nid, "the right-hand side of an assignment"), e, t, v, st)
            .Call(callee: c, args: args) :> resolveCallStmt(env, e, c, args, st)
            .Name(name: n) :> resolveExpr(env, e, not, st).st
            .At(name: n) :> resolveExpr(env, e, not, st).st
            .AtItem :> resolveExpr(env, e, not, st).st
            .Num(raw: r) :> resolveExpr(env, e, not, st).st
            .Str(v: s) :> resolveExpr(env, e, not, st).st
            .Bool(v: b) :> resolveExpr(env, e, not, st).st
            .NotLit :> resolveExpr(env, e, not, st).st
            .Recovered :> resolveExpr(env, e, not, st).st
            .Variant(name: n) :> resolveExpr(env, e, not, st).st
            .Member(obj: o) :> resolveExpr(env, e, not, st).st
            .Unary(op: o) :> resolveExpr(env, e, not, st).st
            .Binary(op: o) :> resolveExpr(env, e, not, st).st
            .Ternary(test: t) :> resolveExpr(env, e, not, st).st
            .ArrayLit(elems: es) :> resolveExpr(env, e, not, st).st
            .ObjectLit(props: ps) :> resolveExpr(env, e, not, st).st
            .Spread(e: x) :> resolveExpr(env, e, not, st).st
            .Index(obj: o) :> resolveExpr(env, e, not, st).st
            .Lambda(params: ps2) :> resolveExpr(env, e, not, st).st
            .Sql(q: q) :> resolveSql(withWhole(env, e.nid), e, q, true, st).st
            .Handled(h: h) :> resolveHandled(withWhole(env, e.nid), e, h, true, st).st   // s451 (Ue)
        }
    }

    fn resolveCallStmt(env: Env, e: AExpr, callee: AExpr, args: AExpr[], st: AS) -> AS {
        if (exprName(callee) == "reset") return resolveReset(env, e, args, st)
        const rmv: MethodCall | not = removeCall(callee)
        if (rmv is given) {
            if (!rootIsLocal(env, rmv.obj)) return resolveRemoveCall(env, e, rmv, args, st)
            return localEditRefused(env, e, rmv.method, args, st)
        }
        const m: MethodCall | not = methodCall(callee)
        if (m is given) {
            // r1 F1 (the same deletion, pre-existing M2 shape): an edit call on a LOCAL
            if (rootIsLocal(env, m.obj)) return localEditRefused(env, e, m.method, args, st)
        }
        if (m is given) return resolveEditCall(env, e, m, args, st)
        return resolveExpr(env, e, not, st).st
    }

    // `@x.push(v)` / `@x.unshift(v)` — a sequence EDIT named by its method
    // (§66.11.2 classifies mutating method calls): end-append / front-prepend.
    type MethodCall:struct = { obj: AExpr, method: string }

    fn methodCall(callee: AExpr) -> MethodCall | not {
        const k: AExprK = callee.k
        return match k {
            .Member(obj: o, name: n) :> methodOf(o, n)
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: s) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .Assign(target: t) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: sx) :> not
            .Index(obj: ix) :> not
            .Lambda(params: lp) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
        }
    }

    fn methodOf(o: AExpr, n: string) -> MethodCall | not {
        if (n == "push" || n == "unshift") return { obj: o, method: n }
        return not
    }

    fn resolveEditCall(env: Env, e: AExpr, m: MethodCall, args: AExpr[], st0: AS) -> AS {
        const rp: RPlace = resolvePlace(env, m.obj, st0)
        let st: AS = rp.st
        const p: WPlace | not = rp.place
        if (p is not) return st
        st = writeGuards(env, p, m.obj.span, st)
        const f: FieldInfo = p.decl.fields[p.idx]
        let elem: Type | not = not
        const pt: Type | not = p.ty
        if (pt is given) elem = seqElem(pt)
        if (args.length != 1) return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`." + m.method + "` with other than one element is not in bootstrap slice M2")
        st = resolveExpr(env, args[0], elem, st).st
        if (p.path.length > 0) return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "an edit of a sub-field sequence is not in bootstrap slice M2")
        let edit: EditKind = EditKind.Append
        let what: string = "an end-append"
        if (m.method == "unshift") {
            edit = EditKind.Prepend
            what = "a front-prepend"
        }
        const cap: Sym | not = f.wcap
        const granted: boolean = f.grants.replace || f.grants.edits.indexOf(edit) >= 0 || hasEditKind(f.grants.edits, edit)
        // r1 F7: a granted edit that GROWS a fixed-length sequence breaks its length invariant
        if (granted && growsFixed(p.ty)) return addDiag(st, env.file, e.span, "E-WRITE-INVARIANT", fixedLengthMessage(f.sym.hint, what))
        if (granted && cap is given) {
            return addEffect(st, e.nid, EffectFact.EWrite({ cap: cap, inst: p.inst, edit: edit, check: Check.Static }))
        }
        const isDerived: boolean = f.mode == FieldMode.Derived
        if (isDerived) return addDiag(st, env.file, e.span, "E-DERIVED-VALUE-MUTATE", "`@" + f.sym.hint + "` is derived — an in-place edit of a derived value is an error (§6.6.18, §66.9)")
        return addDiag(st, env.file, e.span, "E-WRITE-NOT-GRANTED", "`@" + f.sym.hint + "." + m.method + "(…)` is " + what + ", which `" + f.sym.hint + "`'s type does not grant (§66.12.2)")
    }

    fn hasEditKind(es: EditKind[], k: EditKind) -> boolean {
        for (const x of es) {
            if (x == k) return true
        }
        return false
    }

    // =========================================================================
    // s442 — recognized sequence edit shapes (§66.11.2: "Edits … are classified
    // at compile time, from mutating method calls AND from recognized
    // reassignment shapes").
    //   1  `@x = [...@x, e1, …]`   an end-append per element
    //   2  `@x = [e1, …, ...@x]`   a front-prepend per element
    //   3  `@x = @x.filter(λ)`     a shrink-anywhere
    //   4  `@x = @x.map(λ)`        a position-write
    // 0 = not a recognized shape (an unclassifiable reassignment is a replace).
    // =========================================================================
    fn seqEditShape(target: AExpr, value: AExpr) -> int {
        if (placeKey(target) == "") return 0
        const es: AExpr[] = arrayElems(value)
        if (es.length >= 2) {
            const first: AExpr | not = spreadInner(es[0])
            const last: AExpr | not = spreadInner(es[es.length - 1])
            if (countSpreads(es) == 1) {
                if (first is given) {
                    if (samePlaceSyntax(target, first)) return 1
                }
                if (last is given) {
                    if (samePlaceSyntax(target, last)) return 2
                }
            }
            return 0
        }
        const m: MethodCall | not = callMethod(value)
        if (m is given) {
            if (samePlaceSyntax(target, m.obj)) {
                if (m.method == "filter") return 3
                if (m.method == "map") return 4
            }
        }
        return 0
    }

    fn countSpreads(es: AExpr[]) -> int {
        let n = 0
        for (const x of es) {
            if (spreadInner(x) is given) n = n + 1
        }
        return n
    }

    fn arrayElems(e: AExpr) -> AExpr[] {
        const k: AExprK = e.k
        return match k {
            .ArrayLit(elems: es) :> es
            .Name(name: n) :> []
            .At(name: n) :> []
            .AtItem :> []
            .Num(raw: r) :> []
            .Str(v: x) :> []
            .Bool(v: b) :> []
            .NotLit :> []
            .Recovered :> []
            .Variant(name: n) :> []
            .Member(obj: o) :> []
            .Call(callee: c) :> []
            .Unary(op: o) :> []
            .Binary(op: o) :> []
            .Ternary(test: t) :> []
            .Assign(target: t) :> []
            .ObjectLit(props: ps) :> []
            .Spread(e: x) :> []
            .Index(obj: o) :> []
            .Lambda(params: ps) :> []
            .Sql(q: q) :> []
            .Handled(h: x) :> []
        }
    }

    fn spreadInner(e: AExpr) -> AExpr | not {
        const k: AExprK = e.k
        return match k {
            .Spread(e: x) :> x
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: x) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .Assign(target: t) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Index(obj: o) :> not
            .Lambda(params: ps) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
        }
    }

    // `obj.method(…)` as a value: the call's method, when its callee is a member.
    fn callMethod(e: AExpr) -> MethodCall | not {
        const k: AExprK = e.k
        return match k {
            .Call(callee: c) :> memberCall(c)
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: x) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .Assign(target: t) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Index(obj: o) :> not
            .Lambda(params: ps) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
        }
    }

    fn memberCall(c: AExpr) -> MethodCall | not {
        const k: AExprK = c.k
        return match k {
            .Member(obj: o, name: n) :> methodNamed(o, n)
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: x) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Call(callee: x) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .Assign(target: t) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Index(obj: o) :> not
            .Lambda(params: ps) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
        }
    }

    fn methodNamed(o: AExpr, n: string) -> MethodCall { return { obj: o, method: n } }

    fn shapeEdit(shape: int) -> EditKind {
        if (shape == 1) return EditKind.Append
        if (shape == 2) return EditKind.Prepend
        if (shape == 3) return EditKind.Anywhere
        return EditKind.PositionWrite
    }

    fn shapeWhat(shape: int) -> string {
        if (shape == 1) return "an end-append (§66.11.2: `@x = [...@x, e]` is the same edit as `@x.push(e)`)"
        if (shape == 2) return "a front-prepend (`@x = [e, ...@x]`)"
        if (shape == 3) return "a shrink-anywhere (§66.11.2: `@x = @x.filter(…)`; the `remove` grant)"
        return "a position-write (§66.11.2: `@x = @x.map(…)`)"
    }

    fn resolveSeqShape(env: Env, e: AExpr, target: AExpr, value: AExpr, shape: int, st0: AS) -> AS {
        const rp: RPlace = resolvePlace(env, target, st0)
        let st: AS = rp.st
        const p: WPlace | not = rp.place
        if (p is not) return st
        st = writeGuards(env, p, target.span, st)
        const f: FieldInfo = p.decl.fields[p.idx]
        if (p.path.length > 0) return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "an edit of a sub-field sequence is not in bootstrap slice M2")
        // r1 nit: the shape over a value that is not a sequence is a type error
        const pty: Type | not = p.ty
        if (pty is given) {
            if (seqElem(pty) is not) {
                return addDiag(st, env.file, e.span, "E-TYPE-031", "`@" + f.sym.hint + "` is `" + typeName(pty) + "`, not a sequence — `[…]` is not a value of its type (§66.1 rule 5)")
            }
        }
        const edit: EditKind = shapeEdit(shape)
        const cap: Sym | not = f.wcap
        let isGranted: boolean = f.grants.replace || hasEditKind(f.grants.edits, edit)
        // RULED S442: `filter` SHRINKS anywhere — the `remove` grant, not `insert`
        if (shape == 3) isGranted = f.grants.replace || shrinkGranted(f.shrink, SeqAt.Anywhere)
        // s444: every granted shape lowers, so a granted field always has a
        // write capability (its grants list the edit — seqEdits)
        if (!isGranted || cap is not) {
            const isDerived: boolean = f.mode == FieldMode.Derived
            if (isDerived) return addDiag(st, env.file, e.span, "E-DERIVED-WRITE", derivedMessage(p, f))
            return addDiag(st, env.file, e.span, "E-WRITE-NOT-GRANTED", "`@" + f.sym.hint + " = …` is " + shapeWhat(shape) + ", which `" + f.sym.hint + "`'s type does not grant (§66.12.2)")
        }
        // r2 N2: `filter` shrinks — impossible on a fixed-length sequence
        if (shape == 3 && growsFixed(p.ty)) return addDiag(st, env.file, e.span, "E-WRITE-INVARIANT", fixedShrinkMessage(f.sym.hint, shapeWhat(shape)))
        if (shape > 2) {
            // s444: `@x = @x.filter(λ)` — a RemoveAnywhere whose value is the
            // filtered sequence (C9: a filter of the field itself); `@x =
            // @x.map(λ)` — a PositionWrite of the mapped sequence
            st = resolveExpr(env, value, p.ty, st).st
            if (cap is not) return noCapability(env, e, st)
            if (shape == 3) return addEffect(st, e.nid, EffectFact.EWrite({ cap: cap, inst: p.inst, edit: EditKind.RemoveAnywhere, check: Check.Static }))
            return addEffect(st, e.nid, EffectFact.EWrite({ cap: cap, inst: p.inst, edit: EditKind.PositionWrite, check: Check.Static }))
        }
        // r1 F7: growing a FIXED-length sequence breaks its length invariant
        if (growsFixed(p.ty)) return addDiag(st, env.file, e.span, "E-WRITE-INVARIANT", fixedLengthMessage(f.sym.hint, shapeWhat(shape)))
        let elemTy: Type | not = not
        const pt: Type | not = p.ty
        if (pt is given) elemTy = seqElem(pt)
        let elems: AExpr[] = []
        let tmps: Sym[] = []
        for (const x of arrayElems(value)) {
            const inner: AExpr | not = spreadInner(x)
            if (inner is given) {
                // the operand `...@x` reads the target itself (a read, no check)
                st = resolveExpr(env, inner, pt, st).st
            } else {
                st = resolveExpr(env, x, elemTy, st).st
                elems = elems.concat([x])
                // r1 F5/F6: the array is ONE value — every new element is
                // evaluated (left to right) into its local before any write
                const m: RSym = mint(st, "elem")
                st = m.st
                tmps = tmps.concat([m.s])
            }
        }
        const sn: RSym = mint(st, "before_" + f.sym.hint)
        st = sn.st
        const snap: SeqSnap = { local: sn.s, decl: p.decl.sym, idx: p.idx }
        return addEffect(st, e.nid, EffectFact.EEdits({ cap: cap, inst: p.inst, edit: edit, check: Check.Static }, elems, tmps, snap))
    }

    // r1 F1: is the place `e` names rooted in a local (a `let` / `const`, a
    // parameter, a row binding)? Such a place is not a cell: the sequence
    // shapes and edit calls classify CELL writes only.
    fn rootIsLocal(env: Env, e: AExpr) -> boolean {
        const k: AExprK = e.k
        return match k {
            .Name(name: n) :> lookupLocal(env, n) is given
            .Member(obj: o) :> rootIsLocal(env, o)
            .Index(obj: o) :> rootIsLocal(env, o)
            .At(name: n) :> false
            .AtItem :> false
            .Num(raw: r) :> false
            .Str(v: x) :> false
            .Bool(v: b) :> false
            .NotLit :> false
            .Recovered :> false
            .Variant(name: n) :> false
            .Call(callee: c) :> false
            .Unary(op: o) :> false
            .Binary(op: o) :> false
            .Ternary(test: t) :> false
            .Assign(target: t) :> false
            .ArrayLit(elems: es) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: x) :> false
            .Lambda(params: ps) :> false
            .Sql(q: q) :> false
            .Handled(h: x) :> false
        }
    }

    // An edit method on a local sequence: its values are resolved, and it is
    // refused — Core has no in-place edit of a local (dpa-052 Q2 puts locals
    // under their type's grants; the bootstrap cannot lower one either way).
    fn localEditRefused(env: Env, e: AExpr, method: string, args: AExpr[], st0: AS) -> AS {
        const st: AS = resolveExprs(env, args, not, st0)
        return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`." + method + "(…)` on a local sequence is not in the bootstrap — Core has no edit of a local (write a new value: `let t = …`)")
    }

    // r1 F7: a sequence type whose length axis is FIXED (no `free` / bound,
    // §66.12.1: omission is fully constrained) cannot grow — provably, so a
    // growing edit is a compile error (§66.11.2 invariants; dpa-052 Q5).
    fn growsFixed(t: Type | not) -> boolean {
        if (t is not) return false
        return seqFixed(t)
    }

    fn seqFixed(t: Type) -> boolean {
        return match t {
            .Seq(elem: el, grants: g) :> isFixedLength(g.length)
            .Int :> false
            .Num :> false
            .Str :> false
            .Bool :> false
            .Named(sym: x) :> false
            .Maybe(inner: i) :> false
        }
    }

    fn isFixedLength(l: LengthGrant) -> boolean {
        return match l {
            .Fixed :> true
            .Free :> false
            .Bounded(min: a, max: b) :> false
        }
    }

    fn fixedShrinkMessage(name: string, what: string) -> string {
        return "`@" + name + "`: " + what + " shrinks the sequence, and its type fixes the length (no `free` grant, §66.12.1–§66.12.2) — the write provably breaks the length invariant (§66.11.2)"
    }

    fn fixedLengthMessage(name: string, what: string) -> string {
        return "`@" + name + "`: " + what + " grows the sequence, and its type fixes the length (no `free` grant, §66.12.1–§66.12.2) — the write provably breaks the length invariant (§66.11.2)"
    }

    fn callMethodName(v: AExpr) -> string {
        const m: MethodCall | not = callMethod(v)
        if (m is given) return m.method
        return "?"
    }

    // s444: a write the classifier GRANTED whose field has no write capability
    // — impossible by construction (a granted edit is in the field's grants,
    // so the field has a capability, §66.11.1 / check.scrml C1). Reported, never
    // dropped silently.
    fn noCapability(env: Env, e: AExpr, st: AS) -> AS {
        return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "internal: this write is granted but its field has no write capability (a bootstrap defect — please report it)")
    }

    // `@x.shift()` / `@x.pop()` — a removal at the front / end (§66.12.2: the
    // "where it changes" axis; `push` + `pop` = "changes at the end").
    fn removeCall(callee: AExpr) -> MethodCall | not {
        const m: MethodCall | not = memberCall(callee)
        if (m is not) return not
        if (m.method == "shift" || m.method == "pop") return m
        return not
    }

    fn resolveRemoveCall(env: Env, e: AExpr, m: MethodCall, args: AExpr[], st0: AS) -> AS {
        const rp: RPlace = resolvePlace(env, m.obj, st0)
        let st: AS = rp.st
        const p: WPlace | not = rp.place
        if (p is not) return st
        st = writeGuards(env, p, m.obj.span, st)
        const f: FieldInfo = p.decl.fields[p.idx]
        if (p.path.length > 0) {
            // r3: a removal on a sub-field sequence is judged by THAT field's grants (dpa-052 Q6,
            // the deepest field written) — not tracked here; refused, as `.push` on one is
            return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + placeKey(m.obj) + "." + m.method + "()` — an edit of a sub-field sequence is not in bootstrap slice M2 (it would be judged by that field's own grants, dpa-052 Q6)")
        }
        let place: SeqAt = SeqAt.Front
        let what: string = "a removal at the front (the `shift` grant)"
        if (m.method == "pop") {
            place = SeqAt.End
            what = "a removal at the end (the `pop` grant)"
        }
        // RULED S442: a removal needs a SHRINK grant there (or `remove`), never the grow grant
        const isGranted: boolean = f.grants.replace || shrinkGranted(f.shrink, place)
        // r3 nit: messages name the place written (`@r.xs`), not only its field (`@r`)
        const at: string = placeKey(m.obj)
        if (!isGranted) {
            return addDiag(st, env.file, e.span, "E-WRITE-NOT-GRANTED", "`" + at + "." + m.method + "()` is " + what + ", which `" + at + "`'s type does not grant (§66.12.2)")
        }
        // r2 N2 (F7's mirror): a removal SHRINKS — impossible on a fixed-length sequence
        if (growsFixed(p.ty)) return addDiag(st, env.file, e.span, "E-WRITE-INVARIANT", fixedShrinkMessage(at.substring(1), what))
        if (args.length > 0) return addDiag(resolveExprs(env, args, not, st), env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + at + "." + m.method + "()` takes no argument")
        // s444: a removal of one element — Core RemoveEnd / RemoveFront (count 1)
        let edit: EditKind = EditKind.RemoveFront
        if (m.method == "pop") edit = EditKind.RemoveEnd
        const cap: Sym | not = f.wcap
        if (cap is not) return noCapability(env, e, st)
        return addEffect(st, e.nid, EffectFact.ERemove({ cap: cap, inst: p.inst, edit: edit, check: Check.Static }))
    }

    // `@xs[i].f = v` (dpa-052 Q3, RULED S440): an edit of field `f` at that
    // position, judged by `f`'s own contract — not a position replace, not the
    // `positions` permission. A field with no contract is fixed (§66.11.4).
    type ElemFieldTarget:struct = { seq: AExpr, index: AExpr, field: string }

    fn elemFieldTarget(t: AExpr) -> ElemFieldTarget | not {
        const k: AExprK = t.k
        return match k {
            .Member(obj: o, name: n) :> indexedField(o, n)
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: x) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: x) :> not
            .Assign(target: x) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Index(obj: o) :> not
            .Lambda(params: ps) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
        }
    }

    fn indexedField(o: AExpr, n: string) -> ElemFieldTarget | not {
        const k: AExprK = o.k
        return match k {
            .Index(obj: s, idx: i) :> elemField(s, i, n)
            .Name(name: x) :> not
            .At(name: x) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: x) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: x) :> not
            .Member(obj: x) :> not
            .Call(callee: c) :> not
            .Unary(op: x) :> not
            .Binary(op: x) :> not
            .Ternary(test: x) :> not
            .Assign(target: x) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Lambda(params: ps) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
        }
    }

    fn elemField(s: AExpr, i: AExpr, n: string) -> ElemFieldTarget { return { seq: s, index: i, field: n } }

    fn resolveElemFieldWrite(env: Env, e: AExpr, ef: ElemFieldTarget, value: AExpr, st0: AS) -> AS {
        const rp: RPlace = resolvePlace(env, ef.seq, st0)
        let st: AS = rp.st
        const p: WPlace | not = rp.place
        if (p is not) return st
        st = writeGuards(env, p, ef.seq.span, st)
        st = resolveExpr(env, ef.index, Type.Int, st).st
        const f: FieldInfo = p.decl.fields[p.idx]
        let elem: Type | not = not
        const pt: Type | not = p.ty
        if (pt is given) elem = seqElem(pt)
        let target: FieldDef | not = not
        let owner: string = ""
        let elemSym: Sym | not = not
        let targetIdx: int = -1
        if (elem is given) {
            const s: Sym | not = namedOf(elem)
            if (s is given) {
                const ti: TypeInfo | not = typeInfoOf(env.g.types, s)
                if (ti is given) {
                    const fs: FieldDef[] | not = structFieldDefs(ti.def)
                    if (fs is given) {
                        owner = s.hint
                        elemSym = s
                        let k = 0
                        for (const fd of fs) {
                            if (fd.sym.hint == ef.field) {
                                target = fd
                                targetIdx = k
                            }
                            k = k + 1
                        }
                    }
                }
            }
        }
        if (owner == "") return addDiag(st, env.file, e.span, "E-ASSIGN-TARGET", "`@" + f.sym.hint + "[…]." + ef.field + "` — the elements of `@" + f.sym.hint + "` are not structs")
        if (target is not) return addDiag(st, env.file, e.span, "E-SCOPE-001", "`" + owner + "` has no field `" + ef.field + "`")
        st = resolveExpr(env, value, target.ty, st).st
        if (!target.grants.replace && target.grants.edits.length == 0) {
            return addDiag(st, env.file, e.span, "E-WRITE-NOT-GRANTED", "`@" + f.sym.hint + "[…]." + ef.field + " = …` is an edit of `" + owner + "." + ef.field + "`, which carries no contract — it is fixed (§66.11.4; an element-field write is judged by that field's own contract, dpa-052 Q3)")
        }
        // s444: `= v` REPLACES the element field — its contract must grant `replace`
        if (!target.grants.replace) {
            return addDiag(st, env.file, e.span, "E-WRITE-NOT-GRANTED", "`@" + f.sym.hint + "[…]." + ef.field + " = …` replaces `" + owner + "." + ef.field + "`, whose contract grants edits but no `replace` (§66.11.4, dpa-052 Q3)")
        }
        const cap: Sym | not = f.wcap
        if (cap is not || elemSym is not) return noCapability(env, e, st)
        return addEffect(st, e.nid, EffectFact.EElemAt(cap, p.inst, ef.index, [{ owner: elemSym, idx: targetIdx }]))
    }

    fn resolveBlock(env: Env, b: ABlock, st0: AS) -> AS {
        let st: AS = st0
        let env2: Env = env
        for (const s of b.stmts) {
            const r: RB = resolveStmt(env2, s, st)
            env2 = r.env
            st = r.st
        }
        return st
    }

    fn resolveStmt(env: Env, s: AStmt, st: AS) -> RB {
        const k: AStmtK = s.k
        return match k {
            .Eval(e: e) :> keepEnv(env, resolveStmtExpr(env, e, st))
            .Local(name: n, mutable: m, ty: y, init: i) :> resolveLocal(env, s, n, m, y, i, st)
            .Return(e: e) :> keepEnv(env, resolveMaybeExpr(env, e, st))
            .Fail(f: f) :> keepEnv(env, resolveFail(env, s, f, st))       // s451 (Ue, §19.3)
            .If(cond: c, thenB: t, elseB: el) :> keepEnv(env, resolveIf(env, c, t, el, st))
            .Given(name: n, subject: sub, body: b) :> keepEnv(env, resolveGiven(env, s, n, sub, b, st))
            .EffectStmt(w: w) :> keepEnv(env, effectAsStatement(env, w, st))
            .Defer(body: b, arrayLead: a, bare: bare) :> keepEnv(env, resolveDefer(env, s, b, a, bare, st))
        }
    }

    // s449 — an effect where a STATEMENT stands. Inside an effect body it is
    // E-LIFECYCLE-016 (§6.7.4: "An `<effect>` — or a retiring keyword `when …
    // changes { }` — inside the body of another `<effect>` is E-LIFECYCLE-016").
    // In a function or handler body there is no position in the tree to own it
    // (§6.7.4: an `<effect>` "SHALL appear where a `<request>` may: as a child
    // element of an element scope"); §34 names no code for that, so the
    // bootstrap refuses it rather than guess an owner.
    fn effectAsStatement(env: Env, w: AEffect, st: AS) -> AS {
        if (env.inEffect) return addDiag(st, env.file, w.span, "E-LIFECYCLE-016", "an effect inside another effect's body — an effect body is logic, not a markup position; declare the inner effect as a sibling `<effect>` with its own `deps=` (§6.7.4)")
        return addDiag(st, env.file, w.span, "E-BOOTSTRAP-UNSUPPORTED", "an effect inside a function or handler body has no position in the tree to own it (§6.7.4: an `<effect>` stands where a `<request>` may — a child of an element scope); write it in the program's markup")
    }

    // =========================================================================
    // s451 — `defer` (SPEC §19.16), the scope-exit statement.
    //
    // Exits the bootstrap HAS, all handled by the lowering (print.scrml
    // deferBlockJs — a `try … finally` per block that holds a defer): falling
    // off the end of a block; `return` (after its value is evaluated); (Ue)
    // `fail` and `?` — each a `return` of a failure (print.scrml: `return
    // rt.failure(…)`), so the same `finally` runs the deferred bodies; a host
    // error passing through. Exits the bootstrap does NOT have — loops and
    // `break` / `continue`, the CPS split of a function body — have no source
    // form here (a parse or scope error, so the compile has no Core —
    // lower.scrml's gate), so no `defer` can meet them and be mis-run. For the
    // same reason -DUPLICATE-FUNCTION (no function declaration inside a body)
    // and -SERVER-IN-SPLIT (no split) have no trigger the bootstrap can parse.
    // (Ue) E-DEFER-UNHANDLED-FAILABLE is the binder's (resolveCall /
    // resolveSql / guarded, under FailCtx.defer); `fail` / `?` inside a
    // deferred body are E-DEFER-CONTROL-FLOW (deferBodyRule / deferExprRules).
    //
    // Here: §19.16.3 rule 4 (E-DEFER-OUTSIDE-FUNCTION: "`defer` SHALL appear
    // only inside the body of a function DECLARATION … It is
    // E-DEFER-OUTSIDE-FUNCTION in every other position"), §19.16.2
    // E-DEFER-UNSUPPORTED-SITE ("a `defer` that is the whole UNBRACED body of
    // an `if` / `else` … SHALL be a compile error"), §19.16.1
    // E-DEFER-AMBIGUOUS-LEAD. The block-chain rules (rules 1-2, LATER-SHADOW)
    // are `deferChecks`, run once per function body.
    // =========================================================================
    fn inFnBody(env: Env) -> boolean {
        const c: CtxK = env.ctx
        return match c {
            .InFn :> !env.inEffect
            .InDecl(owner: o) :> false
        }
    }

    fn resolveDefer(env: Env, s: AStmt, body: ABlock, arrayLead: boolean, bare: boolean, st0: AS) -> AS {
        if (!inFnBody(env)) {
            return addDiag(st0, env.file, s.span, "E-DEFER-OUTSIDE-FUNCTION", "`defer` stands only in the body of a function declaration (`function` / `fn`) — a handler, an effect or the program has no single block exit to attach the deferred statement to (§19.16.3 rule 4); move the body into a named function and call it")
        }
        // §19.16.1: "Where a binding named `defer` is in scope, a single-statement
        // `defer` led by an array literal SHALL be a compile error naming both spellings"
        if (arrayLead && deferBound(env)) {
            return addDiag(st0, env.file, s.span, "E-DEFER-AMBIGUOUS-LEAD", "`defer [` reads two ways while a binding named `defer` is in scope (§19.16.1): write `defer[…]` (no space) to index the binding, or `defer { […]… }` to defer the statement")
        }
        let st: AS = st0
        if (bare) st = addDiag(st, env.file, s.span, "E-DEFER-UNSUPPORTED-SITE", "a `defer` that is the whole unbraced arm of an `if` / `else` has no written block to belong to (§19.16.2) — brace the arm (`{ defer … }`) or move the `defer` to the enclosing block")
        // The deferred body sees the bindings in scope at the `defer` (§19.16.2
        // "Evaluation time"); its own locals stay inside it. (Ue) A failable in
        // it is handled in place (§19.16.3 rule 3).
        return resolveBlock(withDeferFx(env), body, st)
    }

    // Is a binding named `defer` VISIBLE here (§19.16.1: a parameter, an
    // earlier local, a `given` binding, a file-level function)?
    fn deferBound(env: Env) -> boolean {
        if (lookupLocal(env, "defer") is given) return true
        if (lookupHandle(env, "defer") is given) return true
        return fnNamed(env.g, "defer") is given
    }

    // A `let` / `const` written AFTER a position in a block of the function.
    type DeferLater:struct = { name: string, span: ASpan }

    // §19.16.3 rules 1-2 and §19.16.2 E-DEFER-LATER-SHADOW, over one function
    // body. `later` = the declarations in force at the exit of the block
    // being walked that were written after the current position — in that
    // block or in any enclosing block of the same function ("a `let` / `const`
    // / `lin` declaration written AFTER the `defer` — in its own block or in
    // any enclosing block of the same function").
    fn deferChecks(file: string, body: ABlock, st: AS) -> AS {
        return deferChecksIn(file, body, [], st)
    }

    fn deferChecksIn(file: string, b: ABlock, outer: DeferLater[], st0: AS) -> AS {
        let st: AS = st0
        let i = 0
        for (const s of b.stmts) {
            st = deferChecksStmt(file, s, outer.concat(laterLocals(b, i + 1)), st)
            i = i + 1
        }
        return st
    }

    fn laterLocals(b: ABlock, from: int) -> DeferLater[] {
        let out: DeferLater[] = []
        let i = 0
        for (const s of b.stmts) {
            if (i >= from) {
                const n: string = localNameOf(s)
                if (n != "") out = out.concat([{ name: n, span: s.span }])
            }
            i = i + 1
        }
        return out
    }

    fn deferChecksStmt(file: string, s: AStmt, later: DeferLater[], st: AS) -> AS {
        const k: AStmtK = s.k
        return match k {
            .Defer(body: d) :> deferShadow(file, s, d, later, deferBodyRules(file, d, st))
            .If(cond: c, thenB: t, elseB: el) :> deferChecksElse(file, el, later, deferChecksIn(file, t, later, st))
            .Given(name: n, body: d) :> deferChecksIn(file, d, later, st)
            .Eval(e: e) :> deferChecksBlocks(file, allExprBlocks(e), later, st)        // s451 (Ue): a braced arm block is a defer site (§19.16.2)
            .Local(name: n, init: i) :> deferChecksBlocks(file, allExprBlocks(i), later, st)
            .Return(e: e) :> deferChecksBlocks(file, maybeExprBlocks(e), later, st)
            .EffectStmt(w: w) :> st
            .Fail(f: f) :> st
        }
    }

    fn deferChecksBlocks(file: string, bs: ABlock[], later: DeferLater[], st0: AS) -> AS {
        let st: AS = st0
        for (const b of bs) { st = deferChecksIn(file, b, later, st) }
        return st
    }

    fn deferChecksElse(file: string, el: ABlock | not, later: DeferLater[], st: AS) -> AS {
        if (el is not) return st
        return deferChecksIn(file, el, later, st)
    }

    // Rules 1-2 inside a deferred body, at every depth: no `return`, `fail` or
    // `?` (E-DEFER-CONTROL-FLOW — "A deferred body SHALL NOT contain a
    // `return`, a `fail`, a `?` propagation"), no `defer` (E-DEFER-NESTED —
    // "A deferred body SHALL NOT contain a `defer` statement"), the arms of a
    // handling form included (s451 Ue). The bootstrap parses no `yield` /
    // `break` / `continue` and no nested function body (a lambda body is an
    // expression), so a `return` here always leaves the deferred body.
    fn deferBodyRules(file: string, b: ABlock, st0: AS) -> AS {
        let st: AS = st0
        for (const s of b.stmts) { st = deferBodyRule(file, s, st) }
        return st
    }

    fn deferBodyRule(file: string, s: AStmt, st: AS) -> AS {
        const k: AStmtK = s.k
        return match k {
            .Return(e: e) :> addDiag(st, file, s.span, "E-DEFER-CONTROL-FLOW", "a deferred statement cannot contain a `return` — it runs while its block is already exiting, after the function's return value is computed (§19.16.3 rule 1)")
            .Defer(body: d) :> addDiag(st, file, s.span, "E-DEFER-NESTED", "a deferred statement cannot contain a `defer` — there is no block to attach it to that is not already exiting (§19.16.3 rule 2)")
            .If(cond: c, thenB: t, elseB: el) :> deferBodyElse(file, el, deferBodyRules(file, t, st))
            .Given(name: n, body: d) :> deferBodyRules(file, d, st)
            .Eval(e: e) :> deferExprRules(file, e, st)
            .Local(name: n, init: i) :> deferExprRules(file, i, st)
            .EffectStmt(w: w) :> st
            .Fail(f: x) :> addDiag(st, file, s.span, "E-DEFER-CONTROL-FLOW", "a deferred statement cannot contain a `fail` — it runs while its block is already exiting; a failure here would replace the function's real result (§19.16.3 rule 1)")
        }
    }

    // s451 (Ue) — rule 1 inside a deferred statement's expressions: no `?`
    // (§19.16.3 rule 1: "a `?` propagation"), and the arms of a handling form
    // obey the deferred-body rules ("The rule reaches EVERY statement position
    // inside the deferred body, including … the arms of a `!{}` handler").
    fn deferExprRules(file: string, e: AExpr, st0: AS) -> AS {
        let st: AS = st0
        const h: AHandled | not = handledOf(e.k)
        if (h is given) {
            const how: AHow = h.how
            if (how == AHow.Propagate) st = addDiag(st, file, e.span, "E-DEFER-CONTROL-FLOW", "a deferred statement cannot contain a `?` propagation — it runs while its block is already exiting (§19.16.3 rule 1); handle the failure in place with `!{ … | _ :> … }`")
        }
        for (const x of exprKids(e)) { st = deferExprRules(file, x, st) }
        for (const b of exprBlocks(e)) { st = deferBodyRules(file, b, st) }
        return st
    }

    fn deferBodyElse(file: string, el: ABlock | not, st: AS) -> AS {
        if (el is not) return st
        return deferBodyRules(file, el, st)
    }

    // E-DEFER-LATER-SHADOW (§19.16.2): "If the deferred body reads a name that
    // such a later declaration (re)binds, the program SHALL be rejected …
    // The diagnostic names the binding and both sites". A name the deferred
    // body binds itself (a local, a `given` name, a lambda parameter) is its
    // own; every other bare name it mentions — read, written or called — is
    // resolved at the `defer`, so a later binding of it is the hazard.
    fn deferShadow(file: string, s: AStmt, body: ABlock, later: DeferLater[], st0: AS) -> AS {
        let st: AS = st0
        const used: string[] = blockNameRefs(body, [])
        let reported: string[] = []
        for (const l of later) {
            if (used.indexOf(l.name) >= 0 && reported.indexOf(l.name) < 0) {
                reported = reported.concat([l.name])
                st = addDiag(st, file, l.span, "E-DEFER-LATER-SHADOW", "`" + l.name + "` is declared here, after the `defer` at " + offsetOf(s.span) + " whose deferred statement reads `" + l.name + "` — at the block's exit it would read this later binding, not the one in scope at the `defer` (§19.16.2); rename one of them")
            }
        }
        return st
    }

    // The bare names a block mentions that it does not bind itself.
    fn blockNameRefs(b: ABlock, bound0: string[]) -> string[] {
        let bound: string[] = bound0
        let out: string[] = []
        for (const s of b.stmts) {
            out = out.concat(stmtNameRefs(s, bound))
            const n: string = localNameOf(s)
            if (n != "") bound = bound.concat([n])
        }
        return out
    }

    fn stmtNameRefs(s: AStmt, bound: string[]) -> string[] {
        const k: AStmtK = s.k
        return match k {
            .Eval(e: e) :> exprNameRefs(e, bound)
            .Local(name: n, init: i) :> exprNameRefs(i, bound)
            .Return(e: e) :> maybeNameRefs(e, bound)
            .If(cond: c, thenB: t, elseB: el) :> exprNameRefs(c, bound).concat(blockNameRefs(t, bound)).concat(elseNameRefs(el, bound))
            .Given(name: n, subject: sub, body: d) :> exprNameRefs(sub, bound).concat(blockNameRefs(d, bound.concat([n])))
            .EffectStmt(w: w) :> []
            .Defer(body: d) :> blockNameRefs(d, bound)
            .Fail(f: f) :> exprsNameRefs(failExprs(f), bound)
        }
    }

    fn maybeNameRefs(e: AExpr | not, bound: string[]) -> string[] {
        if (e is not) return []
        return exprNameRefs(e, bound)
    }

    fn elseNameRefs(el: ABlock | not, bound: string[]) -> string[] {
        if (el is not) return []
        return blockNameRefs(el, bound)
    }

    // s451 (Ue): a handling form — its subject, then each arm with the arm's
    // own binders bound.
    fn handledNameRefs(h: AHandled, bound: string[]) -> string[] {
        let out: string[] = exprNameRefs(h.subject, bound)
        for (const a of handledArms(h)) {
            const ab: string[] = bound.concat(armBindNames(a.pat))
            const body: AArmBody = a.body
            for (const x of armExprOf(body)) { out = out.concat(exprNameRefs(x, ab)) }
            for (const b of armBlockOf(body)) { out = out.concat(blockNameRefs(b, ab)) }
        }
        return out
    }

    fn armBindNames(p: APat) -> string[] {
        return match p {
            .PName(binds: bs) :> bindNames(bs)
            .PWild :> []
            .PWhole(bind: b) :> [b.name]
            .PBare(bind: b) :> [b.name]
        }
    }

    fn bindNames(bs: ABind[]) -> string[] {
        let out: string[] = []
        for (const b of bs) { out = out.concat([b.name]) }
        return out
    }

    fn exprsNameRefs(es: AExpr[], bound: string[]) -> string[] {
        let out: string[] = []
        for (const x of es) { out = out.concat(exprNameRefs(x, bound)) }
        return out
    }

    fn exprNameRefs(e: AExpr, bound0: string[]) -> string[] {
        const h: AHandled | not = handledOf(e.k)
        if (h is given) return handledNameRefs(h, bound0)
        const bound: string[] = bound0.concat(lambdaParams(e))
        let out: string[] = []
        const n: string = exprName(e)
        if (n != "" && bound.indexOf(n) < 0) out = [n]
        for (const x of exprKids(e)) { out = out.concat(exprNameRefs(x, bound)) }
        return out
    }

    // =========================================================================
    // s451 (Ue) — THE ERROR MODEL (SPEC §19), in the binder.
    //
    // §19.4.3 "A call to a `!` function SHALL NOT be ignored. The caller MUST"
    // match / propagate with `?` / catch with `!{}` / … — "Failing to handle
    // the result of a `!` function call in any of these ways SHALL be a
    // compile error: E-ERROR-002" — at EVERY position the binder resolves (a
    // call, an event-handler call and an event-handler REFERENCE, S439/S441);
    // §19.8.3 (R11) the same for a `?{}` outside a `!` function. A handling
    // form resolves its subject with `subject` set, so that one node is not
    // reported. Inside a deferred body the code is E-DEFER-UNHANDLED-FAILABLE
    // (§19.16.3 rule 3: "Inside a deferred body this code REPLACES
    // E-ERROR-002").
    //
    // Slice limit (Ue2): a handling form stands only as a statement's WHOLE
    // value — `f() !{ … }` / `match f() { … }` alone, `let x = …`, `x = …`,
    // `@c = …`, `return …`, or an arm's value — so its Attempt is a statement
    // that runs where the source evaluates it. Inside a larger expression it
    // would need ordered hoisting (an argument, an operand, a condition, an
    // interpolation): refused.
    // =========================================================================
    fn ue2Reason() -> string {
        return "is in the bootstrap only as a statement's whole value (`f() !{ … }` / `match f() { … }` alone, `let x = …`, `x = …`, `@c = …`, `return …`) — inside a larger expression (an argument, an operand, a condition, an interpolation or an initializer) it arrives with slice Ue2 (ordered hoisting)"
    }

    // A call of a `!` function, not the subject of a handling form.
    fn unhandledCall(env: Env, e: AExpr, name: string, st: AS) -> AS {
        if (env.fx.defer) return addDiag(st, env.file, e.span, "E-DEFER-UNHANDLED-FAILABLE", "`" + name + "(…)` is failable and this is a deferred statement — handle it in place with a total `!{ … | _ :> … }` (or an exhaustive `match`): the block is already exiting, so there is no caller-bound path left for its error, and an enclosing `!` does not cover it (§19.16.3 rule 3)")
        if (env.fx.inFn) return addDiag(st, env.file, e.span, "E-ERROR-002", "Result of failable function '" + name + "' is not handled. Either match the result, propagate with '?' (inside a `!` function), or catch with '!{}' (§19.4.3)")
        return addDiag(st, env.file, e.span, "E-ERROR-002", "Result of failable function '" + name + "' is not handled here. Catch it with '!{}' (e.g. '" + name + "(…) !{ | .Variant :> … }'), match the result, or call it from a function that handles it — `?` needs an enclosing `!` function, and the bootstrap has no `<errorBoundary>` (§19.4.3)")
    }

    // A failable function passed as an event-handler REFERENCE (S441: "SHALL
    // be E-ERROR-002, exactly like `onclick=risky()`").
    // `onclick={ risky }` is a reference too (S441: "the bare `onclick=risky`,
    // `onclick=${risky}`, or `onclick={ risky }`").
    fn bracedHandler(env: Env, b: ABlock, st: AS) -> AS {
        const r: AExpr | not = blockReference(b)
        if (r is not) return resolveBlock(env, b, st)
        return handlerReference(env, r, resolveBlock(withFnRef(env, r.nid), b, st))
    }

    // The one name a braced handler body consists of, else not.
    export fn blockReference(b: ABlock) -> AExpr | not {
        if (b.stmts.length != 1) return not
        const k: AStmtK = b.stmts[0].k
        const e: AExpr | not = match k {
            .Eval(e: x) :> x
            .Local(name: n) :> not
            .Return(e: x) :> not
            .If(cond: c) :> not
            .Given(name: n) :> not
            .EffectStmt(w: w) :> not
            .Defer(body: d) :> not
            .Fail(f: x) :> not
        }
        if (e is not) return not
        if (exprName(e) == "") return not
        return e
    }

    // An event-handler REFERENCE (`onclick=f`): the event calls `f` (s451 Ue,
    // review HIGH-2 — before, it was lowered as `null` and called nothing).
    // A `!` function there is E-ERROR-002 (S441); a function with parameters
    // would receive the event, which the bootstrap does not model — refused.
    fn handlerReference(env: Env, e: AExpr, st: AS) -> AS {
        if (exprName(e) == "") return st
        const f: FnInfo | not = calledFn(env, nameFactIn(st, e.nid))
        if (f is not) return st
        // s454 (U1b) — §19.9.10 scope 2: "in an event-handler value, as a call or
        // as a handler reference (§19.4.3 … apply unchanged — a server function is
        // now a failable function for both)"; design §2.2: "a handler REFERENCE
        // `onclick=saveNote` → E-ERROR-002 … the dispatcher discards the result".
        if (f.serverOwn && !f.failable) return addDiag(st, env.file, e.span, "E-ERROR-002", "Server function '" + f.name + "' is passed as an event-handler reference: the event would call it on the client and discard the result, but a client call of a server function can fail on the wire (§19.9.10). Call it in a handler that handles it (e.g. '{ " + f.name + "() !{ .Transport(t) :> … } }'), or wire a function that handles it (§19.4.3)")
        if (!f.failable) {
            if (f.arity == 0) return st
            return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "an event-handler reference to `" + f.name + "`, which takes parameters — the event would be its argument, which the bootstrap does not model; write the call: `{ " + f.name + "(…) }`")
        }
        return addDiag(st, env.file, e.span, "E-ERROR-002", "Failable function '" + f.name + "' is passed as an event-handler reference, so the event would call it and discard its error. Call it in a handler that handles the result (e.g. '{ " + f.name + "() !{ | .Variant :> … } }'), or wire a function that handles it (§19.4.3, S441)")
    }

    // The `!` function a call names, else not.
    fn failableCallee(env: Env, st: AS, e: AExpr) -> FnInfo | not {
        const c: AExpr | not = calleeOf(e.k)
        if (c is not) return not
        const f: FnInfo | not = calledFn(env, nameFactIn(st, c.nid))
        if (f is not) return not
        if (!f.failable) return not
        return f
    }

    // The name a handled subject is reported by.
    fn subjectName(e: AExpr) -> string {
        const c: AExpr | not = calleeOf(e.k)
        if (c is given) {
            const n: string = exprName(c)
            if (n != "") return n + "(…)"
        }
        if (sqlOfK(e.k) is given) return "the `" + sqlSigil() + "}` query"
        return "this expression"
    }

    // `subject?` / `subject !{ … }` / `match subject { … }`. `stmt`: the form
    // stands as a statement (its arms yield no value).
    // s454 (U1b): a subject that calls a server-triggered function (§12.2 T1/T4,
    // FnInfo.serverOwn) from a site that is (or may be) on the client is judged
    // against the CLIENT call's failure set (§19.9.10) — remoteHandled.
    fn resolveHandled(env: Env, e: AExpr, h: AHandled, stmt: boolean, st0: AS) -> RX {
        let st: AS = st0
        const subj: AExpr = h.subject
        const sc: FnInfo | not = serverCalleeNamed(env, subj)
        const site: SiteK = siteOf(env)
        // (fix round 1: an own-trigger server site too — its arms resolve against the client
        // set, and SiteLocal reports a `.Transport` arm as dead handling, §19.9.10, as a T5 site does)
        if (sc is given) {
            const rs0: RX = resolveExpr(withSubject(withWhole(env, -1), subj.nid), subj, not, st)
            const hm: AHow = h.how
            const ty: Type | not = match hm {
                .Propagate :> rs0.x.ty
                .Guard(arms: x) :> rs0.x.ty
                .MatchOn(arms: x) :> not
            }
            return plain(ty, remoteHandled(env, e, h, subj, sc, site, stmt, rs0.st))
        }
        if (!stmt && env.fx.whole != e.nid) st = addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "a handled failable (`?`, `!{ … }`, `match`) " + ue2Reason())
        const rs: RX = resolveExpr(withSubject(withWhole(env, -1), subj.nid), subj, not, st)
        st = rs.st
        const f: FnInfo | not = failableCallee(env, st, subj)
        let failable = false
        let err: Sym | not = not
        if (f is given) {
            failable = true
            err = f.err
        } else if (sqlOfK(subj.k) is given) {
            failable = true
            err = env.g.sqlErrorSym
        }
        const how: AHow = h.how
        return match how {
            .Propagate :> plain(rs.x.ty, propagate(env, e, subj, failable, err, stmt, st))
            .Guard(arms: arms) :> plain(rs.x.ty, guarded(env, e, subj, arms, failable, err, false, stmt, st))
            .MatchOn(arms: arms) :> plain(not, guarded(env, e, subj, arms, failable, err, true, stmt, st))
        }
    }

    // §19.5.4: "`?` SHALL be valid only inside a `!` function body … E-ERROR-003";
    // "`?` SHALL be valid only when applied to a call to a `!` function …
    // E-ERROR-004"; §19.5.3 compatibility (E-ERROR-010).
    fn propagate(env: Env, e: AExpr, subj: AExpr, failable: boolean, err: Sym | not, stmt: boolean, st0: AS) -> AS {
        if (!failable) return addDiag(st0, env.file, e.span, "E-ERROR-004", e004Msg(subj))
        if (!env.fx.failable) return addDiag(st0, env.file, e.span, "E-ERROR-003", e003Msg(env))
        return propagationFact(env, e, err, stmt, st0)
    }

    fn e004Msg(subj: AExpr) -> string {
        return "'?' applied to " + subjectName(subj) + ", which is not a call of a failable function. Only '!' functions (and `" + sqlSigil() + "}` queries) can be propagated with '?' (§19.5.4)"
    }

    fn e003Msg(env: Env) -> string {
        let where: string = "this handler or markup, which is not a function"
        if (env.fx.inFn) where = "function '" + env.fx.fnName + "', which is not declared as failable"
        return "'?' propagation operator used in " + where + ". Add '!' to the function signature or handle the error with 'match' or '!{}' (§19.5.4)"
    }

    // The re-fail of a propagation: each variant of `err` re-fails as the
    // SAME-NAMED variant of the enclosing function's enum with the same
    // payload (§19.5.2's desugaring constructs it positionally, so the
    // payloads must agree in count and type); otherwise E-ERROR-010 (§19.5.3:
    // "the compiler SHALL emit a compile error (E-ERROR-010) identifying the
    // incompatible variants" — §19.8.4 the same for a `?{}`).
    fn propagationFact(env: Env, e: AExpr, err: Sym | not, stmt: boolean, st0: AS) -> AS {
        const into: Sym | not = env.fx.err
        if (err is not || into is not) return st0          // an error type that is not an enum: E-ERROR-011 reported
        const rt: RRetag = retagInto(env, err, into, 0, -1, st0)
        if (rt.bad.length > 0) return addDiag(rt.st, env.file, e.span, "E-ERROR-010", e010Msg(env, err, into, rt.bad))
        return handledFact(env, e, err, stmt, into, rt.retag, not, rt.st)
    }

    fn e010Msg(env: Env, err: Sym, into: Sym, bad: string[]) -> string {
        return "propagating `" + err.hint + "` into `" + env.fx.fnName + "(…)! " + into.hint + "` would drop the variant(s) " + bad.join(", ") + " — every variant the callee can fail with must exist in the enclosing function's error type with the same payload (§19.5.3). Add them to `" + into.hint + "`, or handle the call with `!{ … }` / `match`"
    }

    // The retag of variants [from, upto) of `err` into `into` (upto -1: all),
    // and the names of those `into` cannot take (missing, or another payload).
    type RRetag:struct = { retag: Retag[], bad: string[], st: AS }

    fn retagInto(env: Env, err: Sym, into: Sym, from: int, upto: int, st0: AS) -> RRetag {
        let st: AS = st0
        const vs: VariantDef[] = enumVariantsOf(env.g, err)
        const to: VariantDef[] = enumVariantsOf(env.g, into)
        let bad: string[] = []
        let retag: Retag[] = []
        let i = 0
        for (const v of vs) {
            if (i >= from && (upto < 0 || i < upto)) {
                const j: int = variantIndex(env.g.types, into, v.sym.hint)
                if (j < 0 || !samePayload(v, to[j])) {
                    bad = bad.concat([v.sym.hint])
                } else {
                    let binds: Sym[] = []
                    for (const fd of v.fields) {
                        const rb: RSym = mint(st, fd.sym.hint)
                        st = rb.st
                        binds = binds.concat([rb.s])
                    }
                    retag = retag.concat([{ from: i, to: j, binds: binds }])
                }
            }
            i = i + 1
        }
        return { retag: retag, bad: bad, st: st }
    }

    fn samePayload(a: VariantDef, b: VariantDef) -> boolean {
        if (a.fields.length != b.fields.length) return false
        let i = 0
        while (i < a.fields.length) {
            if (!(a.fields[i].ty == b.fields[i].ty)) return false
            i = i + 1
        }
        return true
    }

    fn enumVariantsOf(g: Globals, s: Sym) -> VariantDef[] {
        const t: TypeInfo | not = typeInfoOf(g.types, s)
        if (t is not) return []
        return enumVariants(t.def)
    }

    // The fact lower reads: the result / raw-result locals, minted here.
    // s454 (U1b): `outcome` — the Suspend's bind when the call turns out to
    // suspend (a client call of a server function, or a call of a waiting
    // client function, design §2.1); `remote` — the client-call facts.
    fn handledFact(env: Env, e: AExpr, err: Sym, stmt: boolean, into: Sym | not, retag: Retag[], remote: RemoteFact | not, st0: AS) -> AS {
        const rr: RSym = mint(st0, "handled")
        const ro: RSym = mint(rr.st, "outcome")
        const rs: RSym = mint(ro.st, "settled")
        return addFail(rs.st, e.nid, FailFact.FHandled({ err: err, result: rr.s, ok: ro.s, stmt: stmt, into: into, retag: retag,
                                                           outcome: rs.s, remote: remote }))
    }

    // `!{ arms }` / `match subject { arms }`.
    fn guarded(env: Env, e: AExpr, subj: AExpr, arms: AArm[], failable: boolean, err: Sym | not, isMatch: boolean, stmt: boolean, st0: AS) -> AS {
        let st: AS = st0
        if (!failable) {
            if (isMatch) st = plainMatchBinderDiags(env, arms, st)
            if (!isMatch) st = deadHandlerBinderDiags(env, arms, st)
            if (isMatch) return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "a `match` over " + subjectName(subj) + " — a value that is not a failable result — is not in the bootstrap; it arrives with the §18 `match` unit (here `match` is admitted on a call of a `!` function or a `" + sqlSigil() + "}` query, §19.7.1)")
            return deadHandler(env, e, subj, st)
        }
        if (err is not) return st                          // E-ERROR-011 reported: no variant set to check against
        if (isMatch && variantIndex(env.g.types, err, "Ok") >= 0) return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", okVariantMsg(err))
        const ra: RArms = resolveArms(env, subj, arms, err, isMatch, stmt, st)
        st = ra.st
        for (const d of coverDiags(env, e, subj, err, isMatch, ra, -1, err.hint)) { st = withDiag(st, d) }
        return handledFact(env, e, err, stmt, not, [], not, st)
    }

    fn okVariantMsg(err: Sym) -> string {
        return "`" + err.hint + "` has a variant named `Ok`, which a `match` on a failable result reserves for the success value (§19.7.3) — rename the variant"
    }

    // The arms of a `!{}` / `match`, resolved against enum `err` — what does
    // not depend on WHICH failure set the call has: every arm's pattern,
    // binders and body, a duplicate (E-TYPE-023), an arm after the wildcard
    // (E-SYNTAX-010). `covered`: the variant indices named; `wild`: a
    // wildcard arm (plain `_` / `else`, or `_ err`); `okSeen`: `.Ok`, or a
    // PLAIN wildcard (§18.6.1: `_ err` never takes `.Ok`).
    type RArms:struct = { st: AS, covered: int[], wild: boolean, okSeen: boolean }

    fn resolveArms(env: Env, subj: AExpr, arms: AArm[], err: Sym, isMatch: boolean, stmt: boolean, st0: AS) -> RArms {
        let st: AS = st0
        const vs: VariantDef[] = enumVariantsOf(env.g, err)
        let covered: int[] = []
        let wild = false          // a wildcard arm: plain `_` / `else`, or `_ err` — every remaining ERROR
        let okSeen = false        // `.Ok`, or a PLAIN wildcard (§18.6.1: `_ err` never takes `.Ok`)
        let wildWhole = false     // the first wildcard was `_ err`
        for (const a of arms) {
            const ra: RArm = resolveArm(env, a, err, vs, isMatch, { stmt: stmt, subj: subj, isMatch: isMatch, what: env.fx.wholeWhat }, st)
            st = ra.st
            // review MED-1 / LOW-1 — §18.8.1: "Duplicate variant arms (two arms for
            // the same variant) SHALL be a compile error (E-TYPE-023 …). The second
            // arm is unreachable." (`!{}` arms follow the match rule, §19 alias
            // note.) s452 r2 (LOW-3): an arm AFTER a wildcard is E-SYNTAX-010 —
            // §18.6 "The `else` arm SHALL be the last arm. An `else` arm that is
            // not the last arm SHALL be a compile error (E-SYNTAX-010)" (`_` is its
            // alias), and §18.6.1 for the whole-error binder: "it is the wildcard
            // for the last-arm position (E-SYNTAX-010)". After `_ err` the reason
            // is the position rule, NOT unreachability (`_ err` never takes `.Ok`).
            if (wild) {
                st = addDiag(st, env.file, a.span, "E-SYNTAX-010", afterWildMsg(wildWhole))
            } else if ((ra.idx >= 0 && covered.indexOf(ra.idx) >= 0) || (ra.idx == -2 && okSeen)) {
                st = addDiag(st, env.file, a.span, "E-TYPE-023", "a second arm for the same variant — the first arm already takes it, so this one is unreachable (§18.8.1 E-TYPE-023: duplicate match arm)")
            }
            if (ra.idx == -1) {
                wild = true
                okSeen = true                // a plain wildcard takes the success value too (§19.7.3)
            }
            if (ra.idx == -4 && !wild) {
                wild = true                  // `_ err`: every remaining error, never `.Ok` (§18.6.1)
                wildWhole = true
            }
            if (ra.idx == -2) okSeen = true
            if (ra.idx >= 0) covered = covered.concat([ra.idx])
        }
        return { st: st, covered: covered, wild: wild, okSeen: okSeen }
    }

    // What the failure set decides about resolved arms: totality over the
    // FIRST `upto` variants of `err` (-1: all of them) — E-TYPE-080 (`!{}`) /
    // E-TYPE-020 (`match`, which also owes `.Ok`) — and, in a deferred
    // statement, the catch-all §19.16.3 rule 3 requires.
    fn coverDiags(env: Env, e: AExpr, subj: AExpr, err: Sym, isMatch: boolean, ra: RArms, upto: int, label: string) -> Diag[] {
        const vs: VariantDef[] = enumVariantsOf(env.g, err)
        let missing: string[] = []
        if (isMatch && !ra.okSeen) missing = ["Ok"]
        if (!ra.wild) {
            let i = 0
            for (const v of vs) {
                if ((upto < 0 || i < upto) && ra.covered.indexOf(i) < 0) missing = missing.concat([v.sym.hint])
                i = i + 1
            }
        }
        if (!ra.wild && !isMatch && env.fx.defer) {
            return [newDiag("E-DEFER-UNHANDLED-FAILABLE", "a `!{ … }` handler in a deferred statement SHALL carry a catch-all `| _ :> …` arm (§19.16.3 rule 3) — listing every variant of `" + label + "` is not enough: a failure outside the declared enum would otherwise leave the `finally`", env.file, e.span)]
        }
        if (missing.length == 0) return []
        if (isMatch) return [newDiag("E-TYPE-020", "this `match` over the result of " + subjectName(subj) + " is not exhaustive: it does not cover " + missing.join(", ") + " — a `match` on a failable result covers `.Ok` and every variant of `" + label + "`, or ends with `else :>` / `_ :>` (§19.7.1)", env.file, e.span)]
        return [newDiag("E-TYPE-080", "this `!{ … }` handler on " + subjectName(subj) + " is not exhaustive: it does not cover " + missing.join(", ") + " of `" + label + "` — add those arms, or a catch-all `| _ :> …` (§19.7)", env.file, e.span)]
    }

    // How a client call's failure set is named in a message: the minted enum's
    // hint already reads `E + Transport` (`Transport` alone for a callee not
    // declared `!`); the wrapper's payload is spelled out. A declared enum that
    // IS the set (it declares the wrapper) is named as written.
    fn setLabel(env: Env, f: FnInfo, rset: Sym) -> string {
        const e: Sym | not = f.err
        if (e is given) {
            if (e.id == rset.id) return rset.hint
        }
        return rset.hint + "(t: ServerCallError)"
    }

    fn ownLabel(f: FnInfo) -> string {
        const e: Sym | not = f.err
        if (e is given) return e.hint
        return f.name
    }

    // =========================================================================
    // s454 (U1b) — A CALL OF A SERVER FUNCTION, JUDGED BY ITS SITE (§19.9.10).
    // "The rule applies to a call when both hold: 1. The callee is server-
    // placed … 2. The call is evaluated on the client". The callee half is
    // known here: its OWN body places it on the server (FnInfo.serverOwn —
    // §12.2 T1/T4; a callee placed only by Trigger 5 calls in place wherever
    // it is called from, so it is never the callee of a client call — design
    // §1.6). The caller half — the SITE:
    //   SiteLocal    a function whose own body places it on the server: the
    //                call is server→server ("Not affected"), judged as a local
    //                call (its failure set is the callee's own);
    //   SiteRemote   an event handler, an `<effect>` body: client by position;
    //   SitePending  a function with no server trigger of its own: whether it
    //                is client-placed is a WHOLE-PROGRAM fact (§19.9.10 "An
    //                implementation SHALL decide 'remote' from the resolved
    //                whole-program placement" — Trigger 5) — decided after the
    //                effect summary (rulesPass, PendRule.RemoteOr);
    //   SiteValue    a value position (an initializer, markup, an attribute
    //                value): E-VALUE-SERVER-CALL (§13.7), "not reported a
    //                second time as E-ERROR-002" — nothing here.
    // =========================================================================
    type SiteK:enum = { SiteLocal, SiteRemote, SitePending, SiteValue }

    fn siteOf(env: Env) -> SiteK {
        const h: HostCtx = env.host
        if (h == HostCtx.HostNo) return SiteK.SiteValue
        if (!env.fx.inFn) return SiteK.SiteRemote
        if (env.fx.serverOwn) return SiteK.SiteLocal
        return SiteK.SitePending
    }

    // The server-triggered function a call subject names, else not — by the
    // binder's own name rule (a local of that name shadows it; resolveName),
    // so it is known BEFORE the subject is resolved.
    fn serverCalleeNamed(env: Env, e: AExpr) -> FnInfo | not {
        const c: AExpr | not = calleeOf(e.k)
        if (c is not) return not
        const n: string = exprName(c)
        if (n == "") return not
        if (lookupLocal(env, n) is given) return not
        const f: FnInfo | not = fnNamed(env.g, n)
        if (f is not) return not
        if (!f.serverOwn) return not
        return f
    }

    // Report diagnostics that hold only when the site is a CLIENT call
    // (`remote`) or only when it is server→server (`local`), by the site.
    fn bySite(env: Env, site: SiteK, remote: Diag[], local: Diag[], st: AS) -> AS {
        if (site == SiteK.SiteRemote) return withDiags(st, remote)
        if (site == SiteK.SiteLocal) return withDiags(st, local)
        if (site == SiteK.SitePending) {
            if (remote.length == 0 && local.length == 0) return st
            return addPending(st, PendRule.RemoteOr(env.fx.fnSym, remote, local))
        }
        return st
    }

    fn withDiags(st: AS, ds: Diag[]) -> AS {
        let out: AS = st
        for (const d of ds) { out = withDiag(out, d) }
        return out
    }

    // A server function called and NOT handled: on the client it "SHALL be
    // E-ERROR-002" (§19.9.10 the rule) — in a deferred statement
    // E-DEFER-UNHANDLED-FAILABLE (§19.16.3 rule 3 "REPLACES E-ERROR-002"); a
    // server→server call of a function not declared `!` is valid ("An
    // unhandled server→server call stays valid"). (A `!` callee's unhandled
    // call is E-ERROR-002 everywhere — unhandledCall.)
    fn remoteUnhandled(env: Env, e: AExpr, f: FnInfo, st: AS) -> AS {
        const site: SiteK = siteOf(env)
        return bySite(env, site, [unhandledRemoteDiag(env, e, f)].concat(conflictDiags(env, f, e)), [], st)
    }

    fn unhandledRemoteDiag(env: Env, e: AExpr, f: FnInfo) -> Diag {
        if (env.fx.defer) return newDiag("E-DEFER-UNHANDLED-FAILABLE", "`" + f.name + "(…)` is a server function and this call is made on the client, so it can fail on the wire (§19.9.10) — and this is a deferred statement: handle it in place with a total `!{ … | _ :> … }` (§19.16.3 rule 3)", env.file, e.span)
        if (env.fx.inFn) return newDiag("E-ERROR-002", "Result of failable call '" + f.name + "(…)' is not handled: '" + f.name + "' is a server function and this call is made on the client, so it can fail on the wire (§19.9.10). Handle it: '" + f.name + "(…) !{ .Transport(t) :> … }', a 'match' on the result, or '?' inside a '!' function whose error enum declares 'Transport(t: ServerCallError)'", env.file, e.span)
        let owner: string = "an event handler"
        if (env.inEffect) owner = "an `<effect>` body"
        return newDiag("E-ERROR-002", "Result of failable call '" + f.name + "(…)' is not handled here: '" + f.name + "' is a server function and " + owner + " runs on the client, so the call can fail on the wire (§19.9.10). Catch it with '!{}' (e.g. '{ " + f.name + "(…) !{ .Transport(t) :> … } }'), match the result, or call it from a function that handles it (§19.4.3)", env.file, e.span)
    }

    // E-ERROR-016 at a client call site (transportConflict's rule), as a diagnostic list.
    fn conflictDiags(env: Env, f: FnInfo, e: AExpr) -> Diag[] {
        const st: AS = transportConflict(env.g, f, env.file, e.span, emptyAS())
        return st.diags
    }

    fn emptyAS() -> AS {
        return { facts: noFacts(), diags: [], nextSym: 0, annots: [], bad: { params: [], fields: [] }, effects: [], pend: [] }
    }

    // `f(…)?` / `f(…) !{ … }` / `match f(…) { … }` where `f` is server-
    // triggered and the site is (or may be) a client call. The failure set of
    // a client call is `f`'s declared variants plus `Transport(t:
    // ServerCallError)` (FnInfo.rerr — E's variants first, so an arm resolved
    // against it reads the same in E); of a server→server call, `f`'s own.
    fn remoteHandled(env: Env, e: AExpr, h: AHandled, subj: AExpr, f: FnInfo, site: SiteK, stmt: boolean, st0: AS) -> AS {
        let st: AS = st0
        const rset: Sym | not = f.rerr
        const how: AHow = h.how
        if (rset is not) {
            // no client failure set: E's `Transport` collides (E-ERROR-016 on a client
            // call), or E is not an enum (E-ERROR-011, reported). Judged as the local call.
            st = bySite(env, site, conflictDiags(env, f, e), [], st)
            return match how {
                .Propagate :> propagate(env, e, subj, f.failable, f.err, stmt, st)
                .Guard(arms: arms) :> guarded(env, e, subj, arms, f.failable, f.err, false, stmt, st)
                .MatchOn(arms: arms) :> guarded(env, e, subj, arms, f.failable, f.err, true, stmt, st)
            }
        }
        // Ue2 (a handled form nested in a larger expression): on a client call the
        // suspension plan lowers it (ANF, design §2.2) or refuses it by position; a
        // server→server call stays a local handled form, which this slice keeps whole.
        if (!stmt && env.fx.whole != e.nid) st = bySite(env, site, [], [newDiag("E-BOOTSTRAP-UNSUPPORTED", "a handled failable (`?`, `!{ … }`, `match`) " + ue2Reason(), env.file, e.span)], st)
        const nE: int = localCount(env, f)
        return match how {
            .Propagate :> remotePropagate(env, e, subj, f, rset, nE, site, stmt, st)
            .Guard(arms: arms) :> remoteGuarded(env, e, subj, arms, f, rset, nE, false, site, stmt, st)
            .MatchOn(arms: arms) :> remoteGuarded(env, e, subj, arms, f, rset, nE, true, site, stmt, st)
        }
    }

    // How many leading variants of the client set are `f`'s own: all of them
    // when `f`'s enum IS the set (it declares the wrapper), else its enum's
    // count (0 for a callee not declared `!`).
    fn localCount(env: Env, f: FnInfo) -> int {
        const e: Sym | not = f.err
        const r: Sym | not = f.rerr
        if (e is not || r is not) return 0
        if (e.id == r.id) return enumVariantsOf(env.g, r).length
        return enumVariantsOf(env.g, e).length
    }

    fn remoteFact(env: Env, f: FnInfo, retagT: Retag[]) -> RemoteFact {
        return { callee: f.sym, caller: env.fx.fnSym, local: f.err, retagT: retagT }
    }

    // `?` on the call — §19.9.10 "`?` on a client server call": "the enclosing
    // function's enum SHALL declare `Transport(t: ServerCallError)` — plus `f`'s
    // declared variants, as for any `?` — or the `?` is **E-ERROR-010**. For an
    // `f` not declared `!` this is `?` on a failable call (the call is failable
    // by this section), so E-ERROR-004 does not apply to it. The E-ERROR-010
    // message SHALL name the line to add". Server→server, the set is `f`'s own:
    // E-ERROR-004 for a callee not declared `!`.
    fn remotePropagate(env: Env, e: AExpr, subj: AExpr, f: FnInfo, rset: Sym, nE: int, site: SiteK, stmt: boolean, st0: AS) -> AS {
        if (!env.fx.failable) return addDiag(st0, env.file, e.span, "E-ERROR-003", e003Msg(env))
        const into: Sym | not = env.fx.err
        if (into is not) return st0                        // E-ERROR-011 reported
        // the callee's own variants: owed by both sets
        const own: RRetag = retagInto(env, rset, into, 0, nE, st0)
        let st: AS = own.st
        if (own.bad.length > 0) return addDiag(st, env.file, e.span, "E-ERROR-010", e010Msg(env, rset, into, own.bad))
        // the wire's `Transport`: owed by a client call only
        const tr: RRetag = retagInto(env, rset, into, nE, -1, st)
        st = tr.st
        let remote: Diag[] = []
        if (tr.bad.length > 0) remote = [newDiag("E-ERROR-010", "`" + f.name + "` is a server function: a call to it from the client can also fail on the wire. Add `Transport(t: ServerCallError)` to `" + into.hint + "`, or handle the call with `!{ … .Transport(t) :> … }` (§19.9.10, §19.5.3)", env.file, e.span)]
        let local: Diag[] = []
        if (!f.failable) local = [newDiag("E-ERROR-004", e004Msg(subj) + " — `" + f.name + "` is a server function called server→server here, so the call cannot fail on the wire (§19.9.10)", env.file, e.span)]
        st = bySite(env, site, remote.concat(conflictDiags(env, f, e)), local, st)
        return handledFact(env, e, rset, stmt, into, own.retag, remoteFact(env, f, tr.retag), st)
    }

    // `!{}` / `match` on the call: the arms resolve against the CLIENT set (the
    // maximal one — design F5 a); its totality is owed on a client call, the
    // callee's own on a server→server call — where a `.Transport` arm handles
    // nothing (§19.9.10: "When the callee is not declared `!`, the whole handler
    // is attached to a call that cannot fail and is **E-ERROR-013**. When the
    // callee is declared `!`, only the `.Transport` arm is dead; it SHALL be
    // reported as dead handling in the manner of E-ERROR-013 (the message names
    // the callee and says the call is server→server)").
    fn remoteGuarded(env: Env, e: AExpr, subj: AExpr, arms: AArm[], f: FnInfo, rset: Sym, nE: int, isMatch: boolean, site: SiteK, stmt: boolean, st0: AS) -> AS {
        let st: AS = st0
        if (isMatch && variantIndex(env.g.types, rset, "Ok") >= 0) return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", okVariantMsg(rset))
        const ra: RArms = resolveArms(env, subj, arms, rset, isMatch, stmt, st)
        st = ra.st
        const remote: Diag[] = coverDiags(env, e, subj, rset, isMatch, ra, -1, setLabel(env, f, rset)).concat(conflictDiags(env, f, e))
        let local: Diag[] = []
        if (!f.failable) {
            let form: string = "'!{}' handler"
            if (isMatch) form = "'match'"
            local = [newDiag("E-ERROR-013", form + " on '" + f.name + "(…)', which cannot fail here: '" + f.name + "' is a server function, but this call is made on the SERVER (server→server, §19.9.10 \"Not affected\") — the callee runs in place, nothing crosses the wire, and '" + f.name + "' is not declared '!', so none of the handler's arms can run. Remove the handler", env.file, e.span)]
        } else {
            local = coverDiags(env, e, subj, rset, isMatch, ra, nE, ownLabel(f))
            if (nE < enumVariantsOf(env.g, rset).length && ra.covered.indexOf(nE) >= 0) {
                local = local.concat([newDiag("E-ERROR-013", "the `.Transport` arm handles nothing: `" + f.name + "` is called server→server here (§19.9.10 \"Not affected\": the callee runs in place, nothing crosses the wire), so the call fails only with `" + f.name + "`'s declared variants. Remove the `.Transport` arm", env.file, e.span)])
            }
        }
        st = bySite(env, site, remote, local, st)
        return handledFact(env, e, rset, stmt, not, [], remoteFact(env, f, []), st)
    }

    // s452 — §19.4.3 ruling 3: "A `!{}` handler SHALL be attached only to an
    // expression that can fail: a call to a function declared `!` (§19.4.1), a
    // call the compiler treats as `!` (a CPS body-split function, §19.9.5; a
    // built-in failable such as `parseVariant`, §41.13), or a `?{}` query … On
    // anything else … That SHALL be a compile error: E-ERROR-013" ("For a
    // handler on a non-call expression the message names the expression
    // instead"). Fail-closed readings (DESIGN.md item 2): a callee whose body
    // can place it on the server may be a client→server call, which §19.9.10
    // makes failable — that depends on where the CALLER runs, and the
    // client→server call is unit U1b: refused, never E-ERROR-013. A callee name
    // that did not resolve was reported (E-SCOPE-001 — the bootstrap has no
    // built-in `parseVariant`): no second report.
    fn deadHandler(env: Env, e: AExpr, subj: AExpr, st: AS) -> AS {
        const c: AExpr | not = calleeOf(subj.k)
        if (c is not) {
            const what: string = subjectLabel(subj)
            return addDiag(st, env.file, e.span, "E-ERROR-013", "'!{}' handler on '" + what + "', which cannot fail: '" + what + "' is not a call of a failable function, so none of its arms can run. Remove the '!{ … }' handler.")
        }
        const nf: NameFact | not = nameFactIn(st, c.nid)
        const f: FnInfo | not = calledFn(env, nf)
        if (f is given) {
            // s454 (U1b): a server-triggered callee reaches here only from a
            // server→server site (a client site is remoteHandled's) — §19.9.10:
            // "When the callee is not declared `!`, the whole handler is attached
            // to a call that cannot fail and is **E-ERROR-013**"
            if (f.serverOwn) return addDiag(st, env.file, e.span, "E-ERROR-013", "'!{}' handler on '" + f.name + "(…)', which cannot fail here: '" + f.name + "' is a server function, but this call is made on the SERVER (server→server, §19.9.10 \"Not affected\") — the callee runs in place, nothing crosses the wire, and '" + f.name + "' is not declared '!', so none of the handler's arms can run. Remove the handler")
            return addDiag(st, env.file, e.span, "E-ERROR-013", deadHandlerMsg(f.name))
        }
        const n: string = exprName(c)
        if (n != "" && nf is not) return st               // the name did not resolve: reported where it stands
        let label: string = n
        if (label == "") label = subjectLabel(c)
        return addDiag(st, env.file, e.span, "E-ERROR-013", deadHandlerMsg(label))
    }

    fn deadHandlerMsg(name: string) -> string {
        return "'!{}' handler on '" + name + "(…)', which cannot fail: '" + name + "' is not a failable function, so none of its arms can run. Remove the '!{ … }' handler, or declare '" + name + "' with '!' if it can fail."
    }

    // An expression as written, for E-ERROR-013's non-call form.
    fn subjectLabel(e: AExpr) -> string {
        const k: AExprK = e.k
        const lit: string = match k {
            .NotLit :> "not"
            .Num(raw: r) :> r
            .Bool(v: b) :> boolText(b)
            .Str(v: sv) :> "\"" + sv + "\""
            .Name(name: n) :> n
            .At(name: n) :> "@" + n
            .AtItem :> "@."
            .Recovered :> ""
            .Variant(name: n) :> "." + n
            .Member(obj: o) :> ""
            .Call(callee: c) :> ""
            .Unary(op: o) :> ""
            .Binary(op: o) :> ""
            .Ternary(test: t) :> ""
            .Assign(target: t) :> ""
            .ArrayLit(elems: es) :> ""
            .ObjectLit(props: ps) :> ""
            .Spread(e: x) :> ""
            .Index(obj: o) :> ""
            .Lambda(params: ps) :> ""
            .Sql(q: q) :> ""
            .Handled(h: x) :> ""
        }
        if (lit != "") return lit
        const pk: string = placeKey(e)
        if (pk != "") return pk
        return "this expression"
    }

    fn boolText(b: boolean) -> string {
        if (b) return "true"
        return "false"
    }

    // One arm: its pattern's variant (`idx`: -1 wildcard, -2 `.Ok`, -3 none),
    // its binders (locals scoped to the arm), its body.
    type RArm:struct = { idx: int, st: AS }

    fn resolveArm(env: Env, a: AArm, err: Sym, vs: VariantDef[], isMatch: boolean, cx: ArmCx, st0: AS) -> RArm {
        let st: AS = st0
        if (a.legacy) st = addDiag(st, env.file, a.span, "W-MATCH-ARROW-LEGACY", "the arm separator `=>` / `->` is deprecated — write `:>` (§19 alias note; `bun scrml migrate --fix` rewrites it)")
        let armEnv: Env = withSubject(withWhole(env, -1), -1)
        let idx: int = -3
        const p: APat = a.pat
        const pn: PatName | not = patName(p)
        const wb: WholePat | not = wholePatOf(p)
        if (wb is given) {
            // s452 — §18.6.1: `_ err` matches every error variant an earlier arm
            // did not (never `.Ok`) and binds the WHOLE error value, typed as the
            // failure's error type. A bare name (§18.2) and `else err` (§18.6.1)
            // are E-MATCH-BARE-BINDER; they are bound anyway (one report, no
            // E-SCOPE-001 cascade) and count as that wildcard (no E-TYPE-080 one).
            idx = -4
            if (wb.bare) {
                st = addDiag(st, env.file, a.span, "E-MATCH-BARE-BINDER", bareBinderFailableMsg(wb.b.name))
            } else if (wb.viaElse) {
                st = addDiag(st, env.file, a.span, "E-MATCH-BARE-BINDER", elseBinderMsg(wb.b.name))
            }
            const rw: RBinds = bindWhole(armEnv, wb.b, err, st)
            armEnv = rw.env
            st = rw.st
        } else if (pn is not) {
            idx = -1
        } else if (isMatch && pn.name == "Ok") {
            idx = -2
            if (pn.parens && pn.binds.length != 1) st = addDiag(st, env.file, a.span, "E-TYPE-021", "`.Ok` carries one value (the success value, §19.7.3) — bind it as `.Ok(v)`, not with " + pn.binds.length + " binder(s)")
            const rb: RBinds = bindArm(armEnv, pn.binds, [], st)
            armEnv = rb.env
            st = rb.st
        } else {
            const i: int = variantIndex(env.g.types, err, pn.name)
            if (i < 0) {
                let what: string = "`." + pn.name + "` is not a variant of `" + err.hint + "`"
                if (pn.name == "Ok") what = "`.Ok` is the success value of a `match` — a `!{ … }` handler's arms are failures only"
                st = addDiag(st, env.file, a.span, "E-TYPE-VARIANT", what + " (its variants: " + variantNamesOf(vs).join(", ") + ")")
                const rb0: RBinds = bindArm(armEnv, pn.binds, [], st)     // bound anyway: one report, not a cascade
                armEnv = rb0.env
                st = rb0.st
            } else {
                idx = i
                const fs: FieldDef[] = vs[i].fields
                if (pn.parens && pn.binds.length != fs.length) st = addDiag(st, env.file, a.span, "E-TYPE-021", "`." + pn.name + "` carries " + fs.length + " value(s) but the pattern binds " + pn.binds.length + " — bind one name (or `_`) per payload field, in declaration order (§18.7)")
                // s452 — the legacy paren-free binder `.V m` (a `!{}` arm only, the
                // parser's): §19.4.3 ruling 2 "the same pattern as `| .V(m) :>`: `m`
                // binds the variant's PAYLOAD … under §18.7's positional arity: on a
                // unit variant or a variant with two or more fields it SHALL be E-TYPE-021"
                if (!pn.parens && pn.binds.length == 1 && fs.length != 1) st = addDiag(st, env.file, a.span, "E-TYPE-021", "`." + pn.name + " " + pn.binds[0].name + "` binds ONE payload value (it is `." + pn.name + "(" + pn.binds[0].name + ")`, §19.4.3) but `." + pn.name + "` carries " + fs.length + " — bind every field positionally (`." + pn.name + "(a, b)`), or none (`." + pn.name + "`) (§18.7)")
                const rb2: RBinds = bindArm(armEnv, pn.binds, fs, st)
                armEnv = rb2.env
                st = rb2.st
            }
        }
        st = addFail(st, a.nid, FailFact.FArm(idx))
        const body: AArmBody = a.body
        st = resolveArmBody(armEnv, a, body, cx, st)
        return { idx: idx, st: st }
    }

    type PatName:struct = { name: string, binds: ABind[], parens: boolean }

    fn patName(p: APat) -> PatName | not {
        return match p {
            .PName(name: n, binds: bs, parens: pr) :> { name: n, binds: bs, parens: pr }
            .PWild :> not
            .PWhole(bind: b) :> not
            .PBare(bind: b) :> not
        }
    }

    // s452 r2 — E-SYNTAX-010's message, true for both kinds of wildcard.
    fn afterWildMsg(whole: boolean) -> string {
        if (whole) return "an arm after the whole-error binder `_ err` — it is the wildcard and SHALL be the last arm (§18.6.1, §18.6: E-SYNTAX-010). It takes every remaining error but never `.Ok`, so write the `.Ok` arm (and every other arm) before it"
        return "an arm after the wildcard (`_` / `else`) — the wildcard SHALL be the last arm (§18.6: E-SYNTAX-010); it already took every remaining case, so this arm could never run. Move the wildcard last"
    }

    // s452 — an arm whose pattern binds the whole matched value: `_ err`
    // (§18.6.1), `else err` (`viaElse`), or a bare `err` (`bare`, §18.2).
    type WholePat:struct = { b: ABind, viaElse: boolean, bare: boolean }

    fn wholePatOf(p: APat) -> WholePat | not {
        return match p {
            .PWhole(bind: b, viaElse: v) :> { b: b, viaElse: v, bare: false }
            .PBare(bind: b) :> { b: b, viaElse: false, bare: true }
            .PName(name: n) :> not
            .PWild :> not
        }
    }

    // The whole-error binder's local: typed as the failure's error enum
    // (§18.6.1 "The binder's type is the type of the failure being handled").
    fn bindWhole(env: Env, b: ABind, err: Sym, st0: AS) -> RBinds {
        const rb: RSym = mint(st0, b.name)
        const st: AS = addBind(rb.st, b.nid, BindFact.BBind(rb.s))
        if (b.name == "_") return { env: env, st: st }
        return { env: withLocal(env, { name: b.name, s: rb.s, ty: Type.Named(err), mutable: false, narrowed: not, nDecl: not }), st: st }
    }

    // §18.2's message at a failable site (a `!{}` arm, a `match` on a failable result).
    fn bareBinderFailableMsg(name: string) -> string {
        return "Arm pattern '" + name + "' is a bare name. To bind the whole error, write '_ " + name + "' (e.g. '| _ " + name + " :>'); for a catch-all that binds nothing write '_' (or 'else'); or name the variant ('.V(x)') to bind its payload."
    }

    // §18.2's message in a `match` on any other value.
    fn bareBinderPlainMsg(name: string) -> string {
        return "Arm pattern '" + name + "' is a bare name. A match arm does not bind the whole value: write '_' (or 'else') for a catch-all, or name the variant ('.V(x)') to bind its payload."
    }

    // §18.6.1: `else <name>` — "for the second it offers `_ <name>`".
    fn elseBinderMsg(name: string) -> string {
        return "Arm pattern 'else " + name + "' binds a name to 'else', which binds nothing (§18.6). To bind the whole error, write '_ " + name + "' (e.g. '| _ " + name + " :>'); for a catch-all that binds nothing write 'else' alone."
    }

    // §18.6.1: `_ <name>` on a `match` whose subject is not a failable result —
    // "says that a match arm binds the whole value only where it is an error,
    // and offers `_` / `else` or a named variant".
    fn wholeBinderPlainMsg(name: string) -> string {
        return "Arm pattern '_ " + name + "' binds the whole matched value, which a match arm does only where that value is an error — a '!{}' arm or a 'match' on a failable result (§18.6.1). Here write '_' (or 'else') for a catch-all, or name the variant ('.V(x)') to bind its payload."
    }

    // s452 — E-MATCH-BARE-BINDER for every misplaced binder of a `match` whose
    // subject is NOT a failable result (§18.2, §18.6.1): a bare name, `_ name`,
    // `else name`.
    fn plainMatchBinderDiags(env: Env, arms: AArm[], st0: AS) -> AS {
        let st: AS = st0
        for (const a of arms) {
            const wb: WholePat | not = wholePatOf(a.pat)
            if (wb is given) {
                let m: string = wholeBinderPlainMsg(wb.b.name)
                if (wb.bare) m = bareBinderPlainMsg(wb.b.name)
                if (wb.viaElse) m = elseBinderMsg(wb.b.name)
                st = addDiag(st, env.file, a.span, "E-MATCH-BARE-BINDER", m)
            }
        }
        return st
    }

    // The same for a `!{}` on something that cannot fail — a `!{}` arm is a
    // failable site whatever its subject, so `_ name` is legal there; a bare
    // name and `else name` are not (§18.2, §18.6.1).
    fn deadHandlerBinderDiags(env: Env, arms: AArm[], st0: AS) -> AS {
        let st: AS = st0
        for (const a of arms) {
            const wb: WholePat | not = wholePatOf(a.pat)
            if (wb is given) {
                if (wb.bare) st = addDiag(st, env.file, a.span, "E-MATCH-BARE-BINDER", bareBinderFailableMsg(wb.b.name))
                if (wb.viaElse) st = addDiag(st, env.file, a.span, "E-MATCH-BARE-BINDER", elseBinderMsg(wb.b.name))
            }
        }
        return st
    }

    fn variantNamesOf(vs: VariantDef[]) -> string[] {
        let out: string[] = []
        for (const v of vs) { out = out.concat([v.sym.hint]) }
        return out
    }

    type RBinds:struct = { env: Env, st: AS }

    // The arm's binders: a minted local each (`_` binds nothing visible),
    // typed by the payload field it takes (`.Ok`'s by nothing: the success
    // type is not written, §19.4.1).
    fn bindArm(env0: Env, bs: ABind[], fs: FieldDef[], st0: AS) -> RBinds {
        let env: Env = env0
        let st: AS = st0
        let i = 0
        for (const b of bs) {
            const rb: RSym = mint(st, b.name)
            st = addBind(rb.st, b.nid, BindFact.BBind(rb.s))
            let ty: Type | not = not
            if (i < fs.length) ty = fs[i].ty
            if (b.name != "_") env = withLocal(env, { name: b.name, s: rb.s, ty: ty, mutable: false, narrowed: not, nDecl: not })
            i = i + 1
        }
        return { env: env, st: st }
    }

    // s452 — what an arm's body is judged against: `stmt` — the form is a
    // statement (its result is not read); otherwise it stands in a VALUE
    // position `what` (§19.4.3 ruling 1a), and every arm yields a value or leaves.
    type ArmCx:struct = { stmt: boolean, subj: AExpr, isMatch: boolean, what: string }

    // An arm's body. As a statement's arm, an expression is a statement (a
    // write, a call) and an arm MAY fall through. In a value position (§19.4.3
    // ruling 1a) an arm "SHALL either yield a value of the call's success type
    // or leave (`return` / `fail`)": an expression arm is its value, a block
    // arm's value is its last expression (§18.5 "The block's result is its
    // **last expression**"); an arm that does neither falls through —
    // E-ERROR-012. (The bootstrap has no loops, so `break` / `continue` — which
    // §19.4.3 also counts as leaving — have no source form here.)
    fn resolveArmBody(env: Env, a: AArm, body: AArmBody, cx: ArmCx, st: AS) -> AS {
        return match body {
            .ArmExpr(e: x) :> armExpr(env, a, x, cx, st)
            .ArmBlock(b: b) :> armBlock(env, a, b, cx, st)
        }
    }

    fn armExpr(env: Env, a: AArm, x: AExpr, cx: ArmCx, st: AS) -> AS {
        if (cx.stmt) return resolveStmtExpr(withWhole(env, x.nid), x, st)
        return armValueExpr(env, a, x, cx, st)
    }

    // The expression that is an arm's value (an expression arm, or a block
    // arm's last statement): a write is resolved as the statement it is and
    // falls through; a value is resolved as the arm's value (a handling form
    // there is a statement's whole value — its own Attempt, Ue); a call of a
    // function that yields nothing falls through.
    fn armValueExpr(env: Env, a: AArm, x: AExpr, cx: ArmCx, st0: AS) -> AS {
        if (isWriteExpr(x)) return fallsThrough(env, a, cx, resolveStmtExpr(env, x, st0))
        const st: AS = resolveExpr(withWholeAt(env, x.nid, "the value of an enclosing arm"), x, not, st0).st
        return pendNoValue(env, a, cx, x, st)
    }

    // A call of a declared scrml function as the arm's value: whether it yields
    // a value is the effect summary's `noValue` (transitive through
    // `return <call>` — G7), decided by rulesPass (dpa-066 M3).
    fn pendNoValue(env: Env, a: AArm, cx: ArmCx, x: AExpr, st: AS) -> AS {
        const c: AExpr | not = calleeOf(x.k)
        if (c is not) return st
        const f: FnInfo | not = calledFn(env, nameFactIn(st, c.nid))
        if (f is not) return st
        return addPending(st, PendRule.IfNoValue(f.sym.id, fallsThroughDiag(env, a, cx)))
    }

    fn armBlock(env: Env, a: AArm, b: ABlock, cx: ArmCx, st0: AS) -> AS {
        if (cx.stmt) return resolveBlock(env, b, st0)
        // s452 r2 (HIGH-1) — §19.16.2: "The same code covers a `defer` written
        // directly in an arm of a `match` / `if` / `for` that is used for its
        // VALUE … the defer block would capture it" — E-DEFER-UNSUPPORTED-SITE.
        // PA readings (DESIGN.md §3): a `!{}` arm is the same shape (both lower
        // to one Attempt); an arm that LEAVES (`{ defer …; return x }`) is still
        // an arm used for its value — refused too (fail closed, reversible). A
        // `defer` in a STATEMENT-position arm stays legal (above).
        const dsp: AStmt | not = directDefer(b)
        if (dsp is given) return addDiag(resolveBlock(env, b, st0), env.file, dsp.span, "E-DEFER-UNSUPPORTED-SITE", "a `defer` directly in an arm whose result is used as a value (" + whereLabel(cx.what) + ") — the deferred block would capture the arm's result (§19.16.2). Handle the call as a statement and keep the `defer` in its arm, or move the `defer` to the enclosing block")
        if (blockDiverges(b)) return resolveBlock(env, b, st0)
        const n: int = b.stmts.length
        if (n == 0) return fallsThrough(env, a, cx, st0)
        const last: AExpr | not = evalOf(b.stmts[n - 1])
        if (last is not) return fallsThrough(env, a, cx, resolveBlock(env, b, st0))
        // `{ statement* expression }`: the statements in order (their locals in
        // scope for the value), then the last expression as the arm's value
        let st: AS = st0
        let env2: Env = env
        let i = 0
        while (i < n - 1) {
            const r: RB = resolveStmt(env2, b.stmts[i], st)
            env2 = r.env
            st = r.st
            i = i + 1
        }
        return armValueExpr(env2, a, last, cx, st)
    }

    // The first `defer` written directly in `b` (not in a nested block), else not.
    fn directDefer(b: ABlock) -> AStmt | not {
        for (const s of b.stmts) {
            const k: AStmtK = s.k
            const isD: boolean = match k {
                .Defer(body: d) :> true
                .Eval(e: x) :> false
                .Local(name: n) :> false
                .Return(e: x) :> false
                .If(cond: c) :> false
                .Given(name: n) :> false
                .EffectStmt(w: w) :> false
                .Fail(f: x) :> false
            }
            if (isD) return s
        }
        return not
    }

    fn evalOf(s: AStmt) -> AExpr | not {
        const k: AStmtK = s.k
        return match k {
            .Eval(e: x) :> x
            .Local(name: n) :> not
            .Return(e: x) :> not
            .If(cond: c) :> not
            .Given(name: n) :> not
            .EffectStmt(w: w) :> not
            .Defer(body: d) :> not
            .Fail(f: x) :> not
        }
    }

    // A write in expression form — an assignment, `reset(@x)`, or an edit call
    // on a reactive place (`@xs.push(v)`, `@xs.pop()`): it produces no value.
    fn isWriteExpr(x: AExpr) -> boolean {
        if (assignValue(x) is given) return true
        const c: AExpr | not = calleeOf(x.k)
        if (c is not) return false
        if (exprName(c) == "reset") return true
        const m: MethodCall | not = methodCall(c)
        if (m is given) return isReactiveRoot(placeRoot(m.obj))
        const rm: MethodCall | not = removeCall(c)
        if (rm is given) return isReactiveRoot(placeRoot(rm.obj))
        return false
    }

    // What "yields a value" reads in a body (ownNoValue, the effect summary's
    // own fact; the rule is stated there).
    fn declaresVoid(t: AType) -> boolean {
        const k: ATypeK = t.k
        return match k {
            .TName(name: n) :> n == "void"
            .TSeq(elem: e) :> false
            .TMaybe(inner: i) :> false
        }
    }

    // Does SOME statement of `b` return a value on every path through it (the
    // first such statement ends every path that reaches it)?
    fn blockYieldsOnAllPaths(b: ABlock) -> boolean {
        for (const s of b.stmts) {
            if (stmtYieldsOnAllPaths(s)) return true
        }
        return false
    }

    fn stmtYieldsOnAllPaths(s: AStmt) -> boolean {
        const k: AStmtK = s.k
        return match k {
            .Return(e: x) :> x is given
            .If(cond: c, thenB: t, elseB: el) :> blockYieldsOnAllPaths(t) && maybeBlockYields(el)
            .Given(name: n) :> false
            .Eval(e: x) :> false
            .Local(name: n) :> false
            .EffectStmt(w: w) :> false
            .Defer(body: d) :> false
            .Fail(f: x) :> false
        }
    }

    fn maybeBlockYields(b: ABlock | not) -> boolean {
        if (b is not) return false
        return blockYieldsOnAllPaths(b)
    }

    // A `return` with no value anywhere in `b` (s452 r3 MED-B).
    fn blockHasBareReturn(b: ABlock) -> boolean {
        for (const s of b.stmts) {
            if (stmtHasBareReturn(s)) return true
        }
        return false
    }

    fn stmtHasBareReturn(s: AStmt) -> boolean {
        const k: AStmtK = s.k
        return match k {
            .Return(e: x) :> returnIsBare(x)
            .If(cond: c, thenB: t, elseB: el) :> exprHasBareReturn(c) || blockHasBareReturn(t) || maybeBlockHasBareReturn(el)
            .Given(name: n, subject: x, body: b) :> exprHasBareReturn(x) || blockHasBareReturn(b)
            .Eval(e: x) :> exprHasBareReturn(x)
            .Local(name: n, init: i) :> exprHasBareReturn(i)
            .EffectStmt(w: w) :> false
            .Defer(body: d) :> false                       // a deferred body holds no `return` (§19.16.3 rule 1)
            .Fail(f: x) :> false
        }
    }

    fn returnIsBare(x: AExpr | not) -> boolean {
        if (x is not) return true
        return exprHasBareReturn(x)
    }

    fn maybeBlockHasBareReturn(b: ABlock | not) -> boolean {
        if (b is not) return false
        return blockHasBareReturn(b)
    }

    // ... inside a handling form's arm block in `e`, at any depth.
    fn exprHasBareReturn(e: AExpr) -> boolean {
        for (const b of exprBlocks(e)) {
            if (blockHasBareReturn(b)) return true
        }
        for (const x of exprKids(e)) {
            if (exprHasBareReturn(x)) return true
        }
        return false
    }

    // E-ERROR-012 (§19.4.3 ruling 1a), with the SPEC's message.
    fn fallsThrough(env: Env, a: AArm, cx: ArmCx, st: AS) -> AS {
        return withDiag(st, fallsThroughDiag(env, a, cx))
    }

    fn fallsThroughDiag(env: Env, a: AArm, cx: ArmCx) -> Diag {
        const pat: string = patLabel(a.pat)
        const where: string = whereLabel(cx.what)
        const form: string = handledFormLabel(cx)
        const n: string = exprName(maybeCallee(cx.subj))
        if (n != "") {
            return newDiag("E-ERROR-012", "Arm '" + pat + "' of the " + form + " on '" + n + "(…)' produces no value, but the " + form + "'s result is used here (" + where + "). In a value position every arm must yield a value of '" + n + "'s success type or leave with 'return' / 'fail'. End the arm with a fallback value (e.g. '| " + pat + " :> { @phase = …; fallback }'), leave with 'return', or call '" + n + "(…) !{ … }' as a statement and keep the writes in its arms.", env.file, a.span)
        }
        return newDiag("E-ERROR-012", "Arm '" + pat + "' of the " + form + " on " + subjectName(cx.subj) + " produces no value, but the " + form + "'s result is used here (" + where + "). In a value position every arm must yield a value of its success type (a `" + sqlSigil() + "}` query's is its terminator's, §44.3: `.get()` → `Row | not`, `.all()` → `Row[]`) or leave with 'return' / 'fail'. End the arm with a fallback value (e.g. '| " + pat + " :> { @phase = …; fallback }'), leave with 'return', or handle it as a statement and keep the writes in its arms.", env.file, a.span)
    }

    fn maybeCallee(e: AExpr) -> AExpr {
        const c: AExpr | not = calleeOf(e.k)
        if (c is not) return e
        return c
    }

    fn handledFormLabel(cx: ArmCx) -> string {
        if (cx.isMatch) return "match"
        return "handler"
    }

    fn whereLabel(what: string) -> string {
        if (what == "") return "a value position"
        return what
    }

    // An arm's pattern, as written (for messages).
    fn patLabel(p: APat) -> string {
        return match p {
            .PName(name: n, binds: bs, parens: pr) :> patNameLabel(n, bs, pr)
            .PWild :> "_"
            .PWhole(bind: b, viaElse: v) :> wholeLabel(b.name, v)
            .PBare(bind: b) :> b.name
        }
    }

    fn patNameLabel(n: string, bs: ABind[], parens: boolean) -> string {
        if (!parens) return "." + n
        return "." + n + "(" + bindNames(bs).join(", ") + ")"
    }

    fn wholeLabel(name: string, viaElse: boolean) -> string {
        if (viaElse) return "else " + name
        return "_ " + name
    }

    // Does every path through `b` leave the function (`return` / `fail`)?
    fn blockDiverges(b: ABlock) -> boolean {
        if (b.stmts.length == 0) return false
        return stmtDiverges(b.stmts[b.stmts.length - 1])
    }

    fn stmtDiverges(s: AStmt) -> boolean {
        const k: AStmtK = s.k
        return match k {
            .Return(e: x) :> true
            .Fail(f: x) :> true
            .If(cond: c, thenB: t, elseB: el) :> blockDiverges(t) && elseDiverges(el)
            .Eval(e: x) :> false
            .Local(name: n) :> false
            .Given(name: n) :> false
            .EffectStmt(w: w) :> false
            .Defer(body: x) :> false
        }
    }

    fn elseDiverges(el: ABlock | not) -> boolean {
        if (el is not) return false
        return blockDiverges(el)
    }

    // §19.8.3 (R11) / §19.8.2 — a `?{}` no handling form takes. In a function
    // body: outside a `!` function E-ERROR-002; inside one it propagates
    // implicitly ("The `?{}` expression behaves as if it were a `!` function
    // call") — §19.8.4 "propagated if the enclosing function's error type is
    // compatible, or SHALL be a compile error if incompatible" (E-ERROR-010).
    // Elsewhere (a handler, an effect, markup) a query is refused by placement
    // (U1d / E-VALUE-SERVER-CALL) — placePass's.
    fn resolveSql(env: Env, e: AExpr, q: ASql, stmt: boolean, st0: AS) -> RX {
        const st: AS = resolveExprs(env, q.params, not, st0)
        if (!env.fx.inFn || q.handled) return plain(not, st)
        if (env.fx.defer) return plain(not, addDiag(st, env.file, e.span, "E-DEFER-UNHANDLED-FAILABLE", "this `" + sqlSigil() + "}` query is failable and stands in a deferred statement — handle it in place with a total `!{ … | _ :> … }` (§19.16.3 rule 3); an enclosing `!` does not cover it"))
        if (!env.fx.failable) return plain(not, addDiag(st, env.file, e.span, "E-ERROR-002", "this `" + sqlSigil() + "}` query is failable (§19.8.3, S451): outside a `!` function it must be handled at the site — a `!{ … }` handler on the query, or a `match` on its result — or moved into a `!` function, where a failure propagates (§19.8.2). (\"No row\" is not a failure: `.get()` returns `not`, `.all()` `[]`.)"))
        if (!stmt && env.fx.whole != e.nid) return plain(not, addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "a `" + sqlSigil() + "}` query that a `!` function propagates implicitly (§19.8.2) " + ue2Reason()))
        return plain(not, propagationFact(env, e, env.g.sqlErrorSym, stmt, st))
    }

    // §19.3 — `fail …`. §19.3.3: "`fail` SHALL be valid only inside a function
    // body declared with the `!` modifier … E-ERROR-001"; "The variant
    // specified in the `fail` statement SHALL be a valid variant of that error
    // enum type … E-ERROR-009 … a variant undeclared by the declared enum, a
    // `fail` naming a foreign enum entirely, and a `fail` target that is not an
    // enum variant"; the bare form resolves against the declared type; a valid
    // variant with the wrong payload count is E-TYPE-082 ("never double-fire").
    fn resolveFail(env: Env, s: AStmt, f: AFail, st0: AS) -> AS {
        let st: AS = resolveExprs(env, f.args, not, st0)
        const t: AExpr | not = f.target
        if (t is given) st = resolveExpr(env, t, not, st).st
        if (!env.fx.failable) {
            let where: string = "outside any function (a handler, an effect or markup)"
            if (env.fx.inFn) where = "in function '" + env.fx.fnName + "', which is not declared as failable"
            return addDiag(st, env.file, s.span, "E-ERROR-001", "'fail' used " + where + ". Add '!' to the function signature: 'function " + env.fx.fnName + "(...)! ErrorType' (§19.3.3)")
        }
        const err: Sym | not = env.fx.err
        if (err is not) return st                          // E-ERROR-011 reported
        const vs: VariantDef[] = enumVariantsOf(env.g, err)
        const valid: string = variantNamesOf(vs).join(", ")
        if (t is given) return addDiag(st, env.file, s.span, "E-ERROR-009", "'fail' names something that is not a variant of the declared error type '" + err.hint + "' for function '" + env.fx.fnName + "'. Valid variants: " + valid + " (§19.3.3)")
        if (f.enumName != "") {
            const named: Sym | not = typeNamedHere(env, f.enumName)
            let same = false
            if (named is given) same = named.id == err.id
            if (!same) return addDiag(st, env.file, s.span, "E-ERROR-009", "'fail' names variant '" + f.enumName + "." + f.variant + "', which is not a valid variant of the declared error type '" + err.hint + "' for function '" + env.fx.fnName + "' — '" + f.enumName + "' is a different type. Valid variants: " + valid + " (§19.3.3)")
        }
        const idx: int = variantIndex(env.g.types, err, f.variant)
        if (idx < 0) return addDiag(st, env.file, s.span, "E-ERROR-009", "'fail' names variant '" + f.variant + "' which is not a valid variant of the declared error type '" + err.hint + "' for function '" + env.fx.fnName + "'. Valid variants: " + valid + " (§19.3.3)")
        const n: int = vs[idx].fields.length
        if (n != f.args.length) return addDiag(st, env.file, s.span, "E-TYPE-082", "`" + err.hint + "." + f.variant + "` carries " + n + " payload value(s) but this `fail` supplies " + f.args.length + " — one argument per declared field, in order (§19.3.3, §14.4)")
        return addFail(st, s.nid, FailFact.FFail(err, idx))
    }

    // The type a name denotes where `env` stands (user types first, so a user
    // `Error` shadows the built-in), else not.
    fn typeNamedHere(env: Env, name: string) -> Sym | not {
        const s: TypeStub | not = stubNamed(env.g.te, name)
        if (s is not) return not
        return s.sym
    }

    // =========================================================================
    // s449 — a reactive effect (SPEC §6.7.4), `<effect deps=[…]>${ … }</>` or
    // its soft-deprecated keyword spelling, where markup stands: the `<program>`
    // body, an `if=` element, an `<each>` row. Codes here:
    //   E-EFFECT-NO-DEPS — "An `<effect>` with no `deps=`, or with `deps=[]`,
    //     never runs (it does not run on mount) and is E-EFFECT-NO-DEPS";
    //   E-LIFECYCLE-007 — "Every `deps=` entry SHALL be a declared, mutable
    //     reactive cell in scope at the `<effect>`. An undeclared name, a
    //     non-`@` name, or a derived cell … is E-LIFECYCLE-007";
    //   W-LIFECYCLE-010 — "An empty body … is W-LIFECYCLE-010";
    //   W-WHEN-EFFECT-DEPRECATED — the keyword spelling, "with
    //     W-WHEN-EFFECT-DEPRECATED at every site".
    // The no-write rule (E-EFFECT-WRITES-STATE / E-EFFECT-WRITE-UNPROVEN) needs
    // every function's write summary, so the effect is recorded here and judged
    // by effectPass once all bodies are bound.
    // Refused (E-BOOTSTRAP-UNSUPPORTED, fail closed): an effect in a user
    // declaration's `renders` (which scope owns it — the instance or the render
    // site — is not settled), and a dependency naming a whole instance.
    // =========================================================================
    fn resolveEffect(env: Env, w: AEffect, st0: AS) -> AS {
        let st: AS = st0
        if (!inProgramCtx(env) || env.own != "") {
            return addDiag(st, env.file, w.span, "E-BOOTSTRAP-UNSUPPORTED", "an effect inside a declaration's `renders` is not in the bootstrap — which scope owns it (the instance or the render site) is not settled (§6.7.4 / §66); write it in the program's markup")
        }
        if (w.keyword) {
            st = addDiag(st, env.file, w.span, "W-WHEN-EFFECT-DEPRECATED", "`when … changes { … }` is the soft-deprecated spelling of an `<effect>` — write " + effectSpelling(w) + " (`scrml fix` rewrites a body that writes no reactive cell; §6.7.4, §63)")
        }
        if (w.deps.length == 0 && !w.keyword) {
            st = addDiag(st, env.file, w.span, "E-EFFECT-NO-DEPS", "this `<effect>` lists no dependency — an effect does not run on mount, so with no `deps=[…]` it never runs (§6.7.4); list the cells whose changes should run it, and put logic that runs once in `on mount { }` or a bare expression")
        }
        for (const d of w.deps) { st = resolveEffectDep(env, d, st) }
        if (w.body.stmts.length == 0) {
            st = addDiag(st, env.file, w.span, "W-LIFECYCLE-010", "this effect has an empty body — its trigger fires and does nothing (§6.7.4); add a body or remove it")
        }
        st = resolveBlock(effectBodyEnv(env), w.body, st)
        return addEffectSrc(st, w, env.file)
    }

    // `<effect deps=[@a, @b]>` — the canonical spelling of an effect, for a message.
    fn effectSpelling(w: AEffect) -> string {
        let names: string[] = []
        for (const d of w.deps) {
            const n: string = atName(d)
            if (n != "") names = names.concat(["@" + n])
        }
        return "`<effect deps=[" + names.join(", ") + "]>" + interpOpen() + " … }</>`"
    }

    // `$` + `{` — never written whole in a string literal here (it would open
    // an interpolation, progress.md F9).
    fn interpOpen() -> string { return "$" + "{" }

    fn resolveEffectDep(env: Env, d: AExpr, st: AS) -> AS {
        const name: string = atName(d)
        // fix round (LOW b): a field path (`@signup.email`) is ⚑ OPEN in §6.7.4 — refused, not decided
        if (name == "" && memberName(d.k) != "" && isReactiveRoot(placeRoot(d))) {
            return addDiag(st, env.file, d.span, "E-BOOTSTRAP-UNSUPPORTED", "a field path as an effect dependency is not in the bootstrap — whether a §66 field path (`@signup.email`) may be a dep entry is OPEN (§6.7.4); list a cell `@name`")
        }
        if (name == "") return addDiag(st, env.file, d.span, "E-LIFECYCLE-007", "an effect dependency is a cell written `@name` (§6.7.4) — this entry is not one")
        const r: RX = resolveExpr(env, d, not, st)
        if (r.st.diags.length > st.diags.length) {
            return addDiag(st, env.file, d.span, "E-LIFECYCLE-007", "`@" + name + "` in an effect's dependency list is not a declared `@variable` in scope (§6.7.4)")
        }
        const f: NameFact | not = nameFactIn(r.st, d.nid)
        if (f is not) return addDiag(st, env.file, d.span, "E-LIFECYCLE-007", "`@" + name + "` in an effect's dependency list is not a declared `@variable` in scope (§6.7.4)")
        return depOfFact(env, d, name, f, r.st)
    }

    // F17: arms return through a function, never an object literal.
    fn depOfFact(env: Env, d: AExpr, name: string, f: NameFact, st: AS) -> AS {
        return match f {
            .NField(decl: ds, inst: i, idx: idx) :> depField(env, d, name, ds, idx, st)
            .NInst(decl: ds) :> addDiag(st, env.file, d.span, "E-BOOTSTRAP-UNSUPPORTED", "`@" + name + "` names a whole instance — an effect dependency naming one is not in the bootstrap (whether a declaration's value is a \"declared mutable reactive cell\", §6.7.4, is not settled); list its fields' cells")
            .NLocal(sym: s) :> notMutableDep(env, d, name, st)
            .NStruct(owner: o) :> notMutableDep(env, d, name, st)
            .NFn(sym: s) :> notMutableDep(env, d, name, st)
            .NLength :> notMutableDep(env, d, name, st)
            .NSurface(of: x) :> notMutableDep(env, d, name, st)
        }
    }

    fn notMutableDep(env: Env, d: AExpr, name: string, st: AS) -> AS {
        return addDiag(st, env.file, d.span, "E-LIFECYCLE-007", "`@" + name + "` in an effect's dependency list is not a declared mutable `@variable` (§6.7.4)")
    }

    fn depField(env: Env, d: AExpr, name: string, ds: Sym, idx: int, st: AS) -> AS {
        const di: DeclInfo | not = declInfoIn(env.g, ds)
        if (di is not || idx < 0 || idx >= di.fields.length) return st
        const fi: FieldInfo = di.fields[idx]
        const w: Sym | not = fi.wcap
        if (w is given) return st
        const m: FieldMode = fi.mode
        const why: string = match m {
            .Derived :> "a DERIVED cell (its initializer reads cells) — it has no change event of its own; list the `@variables` it is computed from and read `@" + name + "` in the body (§6.7.4)"
            .Locked :> "a LOCKED field (no `let`) — it never changes; declare it `let` to make it a mutable cell"
            .Let :> "not writable"
            .Seeded :> "not writable"
        }
        return addDiag(st, env.file, d.span, "E-LIFECYCLE-007", "`@" + name + "` in an effect's dependency list is " + why)
    }

    fn declInfoIn(g: Globals, s: Sym) -> DeclInfo | not {
        const ds: DeclSrc | not = findDeclSrc(g, s)
        if (ds is not) return not
        return ds.info
    }

    // F17: a match arm whose body is an object literal loses its named payload
    // bindings — arms return through this constructor instead.
    fn keepEnv(env: Env, st: AS) -> RB { return { env: env, st: st } }

    fn resolveMaybeExpr(env: Env, e: AExpr | not, st: AS) -> AS {
        if (e is not) return st
        return resolveExpr(withWholeAt(env, e.nid, "a `return` operand"), e, not, st).st
    }

    // `let a[: T] = init`. An annotation is the local's type (and the
    // initializer's expected type); it is recorded in `Tables.annots`.
    fn resolveLocal(env: Env, s: AStmt, name: string, mutable: boolean, aty: AType | not, init: AExpr, st0: AS) -> RB {
        let st: AS = st0
        let annot: Type | not = not
        if (aty is given && !hasErrIn(fileErrs(env.g.files, env.file), aty.span)) {
            const te: TypeEnv = { stubs: env.g.te.stubs, declNames: env.g.te.declNames, declSyms: env.g.te.declSyms, file: env.file }
            const rt: RType = resolveType(te, aty, st)
            // r8: an annotation that did not resolve is not the local's type
            if (!rt.unresolved) annot = rt.t
            st = rt.st
        }
        const ri: RX = resolveExpr(withWholeAt(env, init.nid, "the initializer of `" + name + "`"), init, annot, st)
        const rs: RSym = mint(ri.st, name)
        st = addBind(rs.st, s.nid, BindFact.BBind(rs.s))
        let lty: Type | not = ri.x.ty
        if (annot is given) {
            lty = annot
            st = addAnnot(st, rs.s, annot)
        }
        const l: LocalB = { name: name, s: rs.s, ty: lty, mutable: mutable, narrowed: not, nDecl: not }
        return { env: withLocal(env, l), st: st }
    }

    fn resolveIf(env: Env, c: AExpr, t: ABlock, el: ABlock | not, st0: AS) -> AS {
        let st: AS = resolveCond(env, c, st0)
        st = resolveBlock(withPresent(env, presenceHandle(env, c)), t, st)
        if (el is given) st = resolveBlock(env, el, st)
        return st
    }

    // L11: `given c = @handle :> { … }` binds the INSTANCE (§66.7.5, O56 narrow).
    fn resolveGiven(env: Env, s: AStmt, name: string, subject: AExpr, body: ABlock, st0: AS) -> AS {
        const rs0: RX = resolveHandleSubject(env, subject, st0)
        let st: AS = rs0.st
        const inst: InstRef | not = rs0.x.inst
        const iDecl: Sym | not = rs0.x.iDecl
        if (inst is not || iDecl is not) {
            return addDiag(st, env.file, s.span, "E-BOOTSTRAP-UNSUPPORTED", "`given` over a value that is not an instance handle is not in bootstrap slice M2 (O56: writes through it would be errors)")
        }
        const rs: RSym = mint(st, name)
        st = addBind(rs.st, s.nid, BindFact.BGiven(rs.s, inst))
        const narrowed: InstRef = InstRef.Narrowed(rs.s)
        const l: LocalB = { name: name, s: rs.s, ty: rs0.x.ty, mutable: false, narrowed: narrowed, nDecl: iDecl }
        let inner: Env = withLocal(env, l)
        // the subject handle itself is narrowed inside the block too (§66.7.5)
        const hn: string = atName(subject)
        if (hn != "") inner = withNarrow(inner, { name: hn, ty: rs0.x.ty, inst: narrowed, iDecl: iDecl })
        return resolveBlock(inner, body, st)
    }

    // =========================================================================
    // Views (markup).
    // =========================================================================
    fn resolveNodes(env: Env, ns: ANode[], st0: AS) -> AS {
        let st: AS = st0
        for (const n of ns) { st = resolveNode(env, n, st) }
        return chainCheck(env, ns, st)
    }

    // ---- s451: `if=` / `else-if=` / `else` chains (§17.1.1) ------------------
    // A chain is the maximal run of SIBLINGS: one `if=` element, then zero or
    // more `else-if=` elements, then at most one `else` element; whitespace-only
    // text between members does not break it (§17.1.1 Syntax). Exactly the
    // first true branch is in the DOM (lower.scrml `chainView`: ONE View.Cond).
    // The structure rules are LOCAL — each looks only at the immediately
    // preceding element at the same level (§17.1.1 Normative Rules):
    //   E-CTRL-001  `else` not preceded by an `if=` / `else-if=` element
    //   E-CTRL-002  `else-if=` not preceded by an `if=` / `else-if=` element
    //   E-CTRL-003  an `else-if=` / `else` element right after an `else` element
    //               (extends a chain past its terminal `else`; the element is
    //               also not preceded by `if=` / `else-if=`, so 001/002 fire too)
    //   E-CTRL-005  `else` / `else-if=` on the same element as `if=`
    // E-CTRL-004 (a state object opener) cannot arise: no state opener reaches
    // markup here (a declaration in markup is refused, resolveNode). An `if=`
    // after an `else` opens a NEW chain (the grammar's `if-element` begins one).
    // Fail closed (refused, never ignored): a chain attribute on an element the
    // chain lowering does not wrap (only HTML elements and uses are wrapped); an
    // `if=` / `else-if=` whose value is not an expression (quoted, valueless or
    // braced — it used to render unconditionally); `else` with a value; and
    // `else` + `else-if=` on one element (the SPEC names no rule for it).
    fn chainCheck(env: Env, ns: ANode[], st0: AS) -> AS {
        let st: AS = st0
        let prev: int = 0               // the preceding sibling element: 0 none / not a member, 1 `if=` or `else-if=`, 2 `else`
        for (const n of ns) {
            const k: ANodeK = n.k
            const e: AElem | not = match k {
                .Elem(e: x) :> x
                .Text(text: t) :> not
                .Interp(e: x) :> not
                .DeclNode(d: d) :> not
                .Effect(w: w) :> not
            }
            if (e is given) {
                st = chainMember(env, e, prev, st)
                st = showHostCheck(env, e, st)
                st = attrCaseDiags(env, e, st)
                prev = chainRoleAfter(e)
            } else if (!blankNode(n)) {
                prev = 0
            }
        }
        return st
    }

    // What an element is to the NEXT sibling: 1 it carries `if=` or `else-if=`,
    // 2 it carries `else` (only), 0 neither.
    fn chainRoleAfter(e: AElem) -> int {
        if (attrNamed(e.attrs, "if") is given || attrNamed(e.attrs, "else-if") is given) return 1
        if (attrNamed(e.attrs, "else") is given) return 2
        return 0
    }

    fn chainMember(env: Env, e: AElem, prev: int, st0: AS) -> AS {
        let st: AS = st0
        const ia: AAttr | not = attrNamed(e.attrs, "if")
        const ea: AAttr | not = attrNamed(e.attrs, "else-if")
        const la: AAttr | not = attrNamed(e.attrs, "else")
        if (ia is not && ea is not && la is not) return st
        if (ia is given && (ea is given || la is given)) {
            st = addDiag(st, env.file, e.span, "E-CTRL-005", "`else` (or `else-if=`) and `if=` cannot appear on the same element `<" + e.tag + ">`. An element either opens a new chain (`if=`) or continues one (`else-if=` / `else`), not both (§17.1.1)")
        } else if (ea is given && la is given) {
            st = addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`<" + e.tag + ">` carries both `else-if=` and `else` — §17.1.1 gives an element one chain role; the bootstrap refuses the combination rather than pick one")
        } else if (ea is given) {
            if (prev == 2) st = addDiag(st, env.file, e.span, "E-CTRL-003", "The element `<" + e.tag + " else-if=…>` tries to extend a chain that already ended with `else`. Once `else` appears, no further `else-if=` or `else` is allowed in the same chain (§17.1.1)")
            if (prev != 1) st = addDiag(st, env.file, ea.span, "E-CTRL-002", "`else-if=` on `<" + e.tag + ">` has no preceding `if=` element at the same level. An `else-if=` block must immediately follow an element with `if=` or `else-if=` (§17.1.1)")
        } else if (la is given) {
            if (prev == 2) st = addDiag(st, env.file, e.span, "E-CTRL-003", "The element `<" + e.tag + " else>` tries to extend a chain that already ended with `else`. Once `else` appears, no further `else-if=` or `else` is allowed in the same chain (§17.1.1)")
            if (prev != 1) st = addDiag(st, env.file, la.span, "E-CTRL-001", "`else` on `<" + e.tag + ">` has no preceding `if=` element at the same level. An `else` block must immediately follow an element with `if=` or `else-if=` (§17.1.1)")
        }
        // the condition's value: an expression (a quoted, valueless or braced
        // condition used to render the element unconditionally — fail-open)
        st = chainCondValue(env, e, ia, st)
        st = chainCondValue(env, e, ea, st)
        if (la is given && !isNoValue(la.value)) {
            st = addDiag(st, env.file, la.span, "E-BOOTSTRAP-UNSUPPORTED", "`else` on `<" + e.tag + ">` takes no value — it is a bare attribute (§17.1.1)")
        }
        // the host: only an HTML element or a use is wrapped by the chain
        // lowering. `<each>` and `<errors>` refuse the attribute themselves; a
        // refused element has no fact. Anything else would IGNORE it.
        const f: ElemFact | not = elemFactNow(st, e.nid)
        if (f is given && !chainHost(f)) {
            st = chainHostRefused(env, e, ia, st)
            st = chainHostRefused(env, e, ea, st)
            st = chainHostRefused(env, e, la, st)
        }
        return st
    }

    // s451 — `show=` (§17.2) is implemented on an HTML element only
    // (resolveShow). On a USE §17.1.1 lets a component carry it ("An `else` or
    // `else-if=` element MAY also carry `show=`"), but a use has no single
    // element to toggle in the bootstrap (refused in resolveUse, where a field
    // named `show` is told apart); `<*x/>` and `<slot>` read no attributes at
    // all. Each would IGNORE it — refused here. `<each>` and `<errors>`
    // refuse it themselves; a refused element has no fact.
    fn showHostCheck(env: Env, e: AElem, st: AS) -> AS {
        const a: AAttr | not = attrNamed(e.attrs, "show")
        if (a is not) return st
        const f: ElemFact | not = elemFactNow(st, e.nid)
        if (f is not) return st
        if (!showRefusedOn(f)) return st
        let tag: string = e.tag
        if (e.star) tag = "*" + e.tag
        return addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`show=` on `<" + tag + ">` is not in the bootstrap — only an HTML element is shown / hidden (§17.2); the attribute would be ignored and the content always visible")
    }

    // s451 fix round (S239 MED) — every reader of an element's scrml attributes
    // matches the name EXACTLY (`if`, `else-if`, `else`, `show`, `on…`,
    // `bind:…`, `as`, `in`, `key`, `of`, `all`, `deps`, `rule`), so a case
    // variant (`SHOW=`, `If=`, `Else-If=`, `onClick=`, `BIND:value`) fell
    // through to a plain HTML attribute and did nothing. The SPEC names no rule
    // for the case of an attribute name (§4, §5, §24 searched; §13.x makes only
    // ELEMENT names case-insensitive), so a case variant of a scrml control
    // name is refused on every element that is not a USE (a use's names are
    // its declaration's field names — case-sensitive, `a` and `A` distinct).
    // `ref=` (§6.7.1a, an element-reference binding) is not in the bootstrap:
    // on an HTML element it would be a plain `ref="…"` attribute — refused.
    // On an HTML element, two names equal up to case are one HTML attribute
    // (HTML attribute names are case-insensitive): the second is a repeat
    // (exact repeats are the parser's, repeatedAttrDiags).
    fn attrCaseDiags(env: Env, e: AElem, st0: AS) -> AS {
        let st: AS = st0
        const f: ElemFact | not = elemFactNow(st, e.nid)
        if (f is not) return st
        if (isUseFact(f)) return st
        const html: boolean = isHtmlFact(f)
        let seen: string[] = []
        let seenExact: string[] = []
        let tag: string = e.tag
        if (e.star) tag = "*" + e.tag
        for (const a of e.attrs) {
            const lower: string = a.name.toLowerCase()
            if (lower != a.name && isControlAttrName(lower)) {
                st = addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "` on `<" + tag + ">` is a case variant of the scrml attribute `" + lower + "` — the bootstrap reads scrml attribute names exactly, so it would be a plain HTML attribute that does nothing; write `" + lower + "`")
            } else if (html && a.name == "ref") {
                st = addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`ref=` on `<" + tag + ">` (§6.7.1a, an element-reference binding) is not in the bootstrap — it would be emitted as a plain `ref` attribute and bind nothing")
            } else if (html && seen.indexOf(lower) >= 0 && seenExact.indexOf(a.name) < 0) {
                st = addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "` is written twice on `<" + tag + ">` (HTML attribute names are case-insensitive) — the bootstrap reads one, so the other would be silently dropped; the SPEC names no rule for a repeated attribute, so it is refused: write it once")
            }
            seen = seen.concat([lower])
            seenExact = seenExact.concat([a.name])
        }
        return st
    }

    // The attribute names a scrml reader of an element dispatches on (lower
    // case): the control attributes, the event prefix `on`, any namespaced
    // `x:y` name (`bind:`, `class:`, `style:`, …).
    fn isControlAttrName(n: string) -> boolean {
        if (n.indexOf(":") >= 0) return true
        if (n.length > 2 && n.substring(0, 2) == "on") return true
        return n == "if" || n == "else-if" || n == "else" || n == "show" || n == "ref" || n == "as" ||
               n == "in" || n == "key" || n == "of" || n == "all" || n == "deps" || n == "rule"
    }

    fn isUseFact(f: ElemFact) -> boolean {
        return match f {
            .MUse(decl: d) :> true
            .MHtml :> false
            .MEach(bind: b) :> false
            .MErrors(of: x) :> false
            .MSlot :> false
            .MDb :> false
            .MStateView(v: v) :> false
            .MInline(v: v) :> false
            .MStar(decl: d) :> false
        }
    }

    fn isHtmlFact(f: ElemFact) -> boolean {
        return match f {
            .MHtml :> true
            .MUse(decl: d) :> false
            .MEach(bind: b) :> false
            .MErrors(of: x) :> false
            .MSlot :> false
            .MDb :> false
            .MStateView(v: v) :> false
            .MInline(v: v) :> false
            .MStar(decl: d) :> false
        }
    }

    fn showRefusedOn(f: ElemFact) -> boolean {
        return match f {
            .MHtml :> false
            .MUse(decl: d) :> false           // resolveUse: a field named `show` constructs; else refused there
            .MEach(bind: b) :> false          // refuses `show` itself (resolveEach)
            .MErrors(of: x) :> false          // refuses it itself (resolveErrors)
            .MSlot :> true
            .MDb :> true
            .MStateView(v: v) :> true
            .MInline(v: v) :> true
            .MStar(decl: d) :> true
        }
    }

    fn chainCondValue(env: Env, e: AElem, a: AAttr | not, st: AS) -> AS {
        if (a is not) return st
        if (valueExpr(a.value) is given) return st
        return addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "=` on `<" + e.tag + ">` needs a condition expression — `" + a.name + "=@x` or `" + a.name + "=(@n >= 3)`; a quoted, valueless or braced condition is not in the bootstrap (§17.1, §5.2) — it would render the element unconditionally")
    }

    fn chainHostRefused(env: Env, e: AElem, a: AAttr | not, st: AS) -> AS {
        if (a is not) return st
        let tag: string = e.tag
        if (e.star) tag = "*" + e.tag
        return addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "` on `<" + tag + ">` is not in the bootstrap — only an HTML element or a use of a declaration is conditionally rendered (§17.1); the attribute would be ignored and the element always rendered")
    }

    fn chainHost(f: ElemFact) -> boolean {
        return match f {
            .MHtml :> true
            .MUse(decl: d) :> true
            .MEach(bind: b) :> true          // refuses `if=` / `else-if=` / `else` itself (resolveEach)
            .MErrors(of: x) :> true          // refuses them itself (resolveErrors)
            .MSlot :> false
            .MDb :> false
            .MStateView(v: v) :> false
            .MInline(v: v) :> false
            .MStar(decl: d) :> false
        }
    }

    // The element fact recorded so far for `nid` (the dense index is built
    // after resolution, so this scans).
    fn elemFactNow(st: AS, nid: int) -> ElemFact | not {
        const t: ElemTable = st.facts.elems
        let i: int = t.nids.length - 1
        while (i >= 0) {
            if (t.nids[i] == nid) return t.facts[i]
            i = i - 1
        }
        return not
    }

    // An element's condition attribute: its `if=`, else its `else-if=` (the
    // condition its branch is shown under; an `else` branch has none).
    fn condAttrOf(attrs: AAttr[]) -> AAttr | not {
        const a: AAttr | not = attrNamed(attrs, "if")
        if (a is given) return a
        return attrNamed(attrs, "else-if")
    }

    fn isChainAttr(name: string) -> boolean {
        return name == "if" || name == "else-if" || name == "else"
    }

    fn resolveNode(env: Env, n: ANode, st: AS) -> AS {
        const k: ANodeK = n.k
        return match k {
            .Elem(e: e) :> resolveElem(env, e, st)
            .Text(text: t) :> st
            .Interp(e: e) :> resolveExpr(env, e, not, st).st
            .DeclNode(d: d) :> addDiag(st, env.file, d.span, "E-BOOTSTRAP-UNSUPPORTED", "a declaration inside markup is not in bootstrap slice M2")
            .Effect(w: w) :> resolveEffect(env, w, st)
        }
    }

    fn isChildRole(r: FieldRole) -> boolean {
        return match r {
            .Child :> true
            .Attribute :> false
        }
    }

    fn resolveElem(env: Env, e: AElem, st: AS) -> AS {
        if (e.star) return resolveStar(env, e, st)
        if (e.tag == "each") return resolveEach(env, e, st)
        if (e.tag == "slot") return resolveSlot(env, e, st)
        // A user declaration in scope wins over every built-in reading of the
        // tag — HTML and (r2 F2) the structural-refusal list alike.
        const d: DeclSrc | not = declNamed(env.g, e.tag)
        if (d is given) {
            // O55 RULED (bryan S442): a plain use of a `single` declaration is an
            // error; `<*x/>` is the only way to render it (§66.13.3).
            if (d.info.single) return singleInstantiated(env, e, st)
            return resolveUse(env, e, d, st)
        }
        // the same for a program cell declared `single` (§66.19.6 `<phase/>`)
        const sd: ADecl | not = singleProgramField(env, e.tag)
        if (sd is given) return singleInstantiated(env, e, st)
        // s449 — `<errors of=…/>` (§55.8), when no declaration takes the name
        if (e.tag == "errors") return resolveErrors(env, e, st)
        // s452 — `<db src=…>` (§4 state block; §8.1.1 database scope)
        if (e.tag == "db") return resolveDb(env, e, st)
        // s444 (PA): a scrml STRUCTURAL element the bootstrap does not
        // implement is never an HTML element (§4.15, §24.4 "These element names
        // SHALL NOT be treated as HTML elements") — refused, not rendered as
        // markup (it used to fall through to MHtml with no diagnostic). Only
        // when no declaration of that name is in scope (above).
        const owner: string = structuralOwner(e.tag)
        if (owner != "") {
            return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`<" + e.tag + ">` is a scrml structural element (" + owner + "), not an HTML element (§4.15, §24.4) — it is not in the bootstrap")
        }
        return resolveHtml(env, e, st)
    }

    // s452 — a `<db src=…>` state block. §4: "A state block is a first-class
    // context. Its content is markup context"; §8.1.1: a `<db src=>` is a
    // database scope for the `?{}` blocks inside it (placePass's dbsPass
    // resolves which database every query runs on, and checks `src=` —
    // E-SQL-005). It is not an HTML element: its children render in place.
    // Its other attributes are REFUSED, never ignored: `tables=` generates
    // types (§14.8.4) and `protect=` keeps columns off the client (§14.8.9 — a
    // confidentiality control), neither in the bootstrap.
    fn resolveDb(env: Env, e: AElem, st0: AS) -> AS {
        let st: AS = st0
        let src = false
        for (const a of e.attrs) {
            if (a.name == "src") {
                src = true
            } else if (isChainAttr(a.name) || a.name == "show") {
                // s452 r2 (NIT): `if=` / `else-if=` / `else` / `show=` are judged —
                // and refused on a `<db>` — by the chain and `show=` rules (MDb is
                // no chain host, show= is refused on it): one report, not two
            } else if (a.name == "tables") {
                st = addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`<db tables=…>` generates a type per table from the schema (§14.8.4), which is not in the bootstrap — it would be ignored")
            } else if (a.name == "protect") {
                st = addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`<db protect=…>` keeps the named columns off the client (§14.8.9), which is not in the bootstrap — a confidentiality control is refused, never ignored")
            } else {
                st = addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "=` on `<db>` is not in the bootstrap (it takes `src=`, §8.1.1) — it would be ignored")
            }
        }
        if (!src) st = addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "a `<db>` without `src=` names no database (§8.1.1: a database scope is a `<db src=>`) — the bootstrap has no other reading of it")
        return addElem(resolveNodes(env, e.kids, st), e.nid, ElemFact.MDb)
    }

    // s449 — `<errors of=expr/>` (§55.8): "`of=expr` REQUIRED — References a
    // per-field cell (`@signup.name`), a compound cell (`@signup`), or a
    // validated top-level value (`@email`)"; `all` (optional flag) renders
    // the full array. `of=` missing → E-ERRORS-001; not a `@`-rooted
    // reference to one of those → E-ERRORS-002; a top-level value with no
    // validators has no surface → E-VALIDITY-NO-SURFACE (§55.8, the S442 (5)
    // read rule applied to the convention). The body override (`<errors
    // of=…>${(err) => …}</>`) is not in the bootstrap — refused, never
    // dropped. Any other attribute is refused (it would be ignored).
    fn resolveErrors(env: Env, e: AElem, st0: AS) -> AS {
        let st: AS = st0
        let of: AAttr | not = not
        let all = false
        for (const a of e.attrs) {
            if (a.name == "of") {
                of = a
            } else if (a.name == "all" && isNoValue(a.value)) {
                all = true
            } else {
                st = addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "` is not an attribute of `<errors>` — it takes `of=` and the `all` flag (§55.8); it would be ignored")
            }
        }
        for (const k of e.kids) {
            if (!blankNode(k)) {
                return addDiag(st, env.file, k.span, "E-BOOTSTRAP-UNSUPPORTED", "a body inside `<errors of=…>` (the §55.8 body override) is not in the bootstrap — it would be dropped silently; write `<errors of=…/>` (the default rendering)")
            }
        }
        if (of is not) return addDiag(st, env.file, e.span, "E-ERRORS-001", "`<errors>` needs `of=` — the value whose errors it renders: `<errors of=@signup.email/>` (§55.8)")
        const x: AExpr | not = valueExpr(of.value)
        if (x is not || !isReactiveRoot(placeRoot(x))) {
            return addDiag(st, env.file, of.span, "E-ERRORS-002", "`<errors of=…>` takes a `@`-rooted reference — a field (`@signup.email`), a declaration (`@signup`) or a validated top-level value (`@email`) (§55.8)")
        }
        const r: RX = resolveExpr(env, x, not, st)
        if (r.st.diags.length > st.diags.length) return r.st
        const nf: NameFact | not = nameFactIn(r.st, x.nid)
        const where: int = fieldReadKind(env, nf)
        const fv: ValidityOf | not = fieldValidity(nf)
        if (fv is given) {
            if (where == 2 && fieldValidatorsRefused(env, fv)) return r.st
            if (where == 2 && !fieldCarriesValidators(env, fv)) {
                return addDiag(r.st, env.file, of.span, "E-VALIDITY-NO-SURFACE", "`<errors of=" + exprLabel(x) + "/>` — `" + exprLabel(x) + "` is a top-level value that carries no validators, so it has no validity surface and no `errors` (§55.5.1 rule 2, §55.8)")
            }
            return addElem(r.st, e.nid, ElemFact.MErrors(fv, all))
        }
        const dv: ValidityOf | not = declValidity(env, nf)
        if (dv is given) return addElem(r.st, e.nid, ElemFact.MErrors(dv, all))
        return addDiag(r.st, env.file, of.span, "E-ERRORS-002", "`<errors of=" + exprLabel(x) + "/>` — `" + exprLabel(x) + "` is not a field, a declaration or a validated top-level value, so it has no `errors` (§55.8)")
    }

    fn isNoValue(v: AAttrValue) -> boolean {
        return match v {
            .NoValue :> true
            .Bare(e: x) :> false
            .Paren(e: x) :> false
            .Quoted(v: s) :> false
            .Braced(b: b) :> false
        }
    }

    // An instance of a USER declaration → its compound surface (§55.5).
    fn declValidity(env: Env, nf: NameFact | not) -> ValidityOf | not {
        return match nf {
            .NInst(decl: d, inst: i) :> userCompound(env, d, i)
            .NField(decl: d) :> not
            .NLocal(sym: s) :> not
            .NStruct(owner: o) :> not
            .NFn(sym: s) :> not
            .NLength :> not
            .NSurface(of: x) :> not
            not :> not
        }
    }

    fn userCompound(env: Env, d: Sym, i: InstRef) -> ValidityOf | not {
        if (d.id == env.g.program.id) return not
        return ValidityOf.OfDecl(d, i)
    }

    // s449 (from U0 review r2 N2): `<slot>` CONTENT (fallback for a use with no
    // children). SPEC §66.15.2 rules only "use-site children → `<slot/>`" and
    // says nothing of content written inside `<slot>…</slot>`; Core `View.Slot`
    // carries no fallback. It used to be dropped unvisited — an effect there
    // never ran, an unresolved `${@nope}` raised nothing. Fail closed: any
    // content other than whitespace is refused.
    fn resolveSlot(env: Env, e: AElem, st: AS) -> AS {
        for (const k of e.kids) {
            if (!blankNode(k)) {
                return addElem(addDiag(st, env.file, k.span, "E-BOOTSTRAP-UNSUPPORTED", "content inside `<slot>…</slot>` (fallback content for a use with no children) is not in the bootstrap — SPEC §66.15.2 rules only `<slot/>`; the content would be dropped silently. Write `<slot/>` and render a default outside it"), e.nid, ElemFact.MSlot)
            }
        }
        return addElem(st, e.nid, ElemFact.MSlot)
    }

    fn blankNode(n: ANode) -> boolean {
        const k: ANodeK = n.k
        return match k {
            .Text(text: t) :> t.trim() == ""
            .Elem(e: e) :> false
            .Interp(e: e) :> false
            .DeclNode(d: d) :> false
            .Effect(w: w) :> false
        }
    }

    // s444 (PA): the scrml structural / directive tags (§4.15, §24.4 and impl#1's
    // name-resolver SCRML_NON_ELEMENT_TAGS: the placement table, §65, the
    // document roots, definition blocks, directive sugar, the lifecycle tags,
    // §36 input-state tags) the bootstrap does NOT implement — each with its
    // owning section. `each` and `slot` are implemented (resolveElem); `<theme>`
    // is refused by the parser; `<program>` parses as the program. Compared
    // lowercase (`errorBoundary`, `onTransition`). "" = not one.
    fn structuralOwner(tag: string) -> string {
        const t: string = tag.toLowerCase()
        return match t {
            "request"       :> "§6.7.7 async request"
            "poll"          :> "§6.7 lifecycle"
            "timer"         :> "§6.7 lifecycle"
            "timeout"       :> "§6.7.8 lifecycle"
            "machine"       :> "§6.7 lifecycle"
            "errorboundary" :> "§19 error boundary"
            "schema"        :> "§39.2"
            "channel"       :> "§38"
            "onchange"      :> "§38.13"
            "auth"          :> "§40.9.5"
            "page"          :> "§40"
            "engine"        :> "§51.0 (retired into `single` declarations, §66.13.3)"
            "ontransition"  :> "§51.0.H"
            "ontimeout"     :> "§51.0.M"
            "onidle"        :> "§51.0.R"
            "match"         :> "§18.0.1"
            "empty"         :> "§17.7 `<each>` fallback"
            "render"        :> "§19.15"
            "outlet"        :> "§20.8"
            "column"        :> "§41.14"
            "formfor"       :> "§41.14"
            "tablefor"      :> "§41.14"
            "if"            :> "a retired control-flow tag"
            "else"          :> "a retired control-flow tag"
            "else-if"       :> "a retired control-flow tag"
            "component"     :> "§15"
            "snippet"       :> "§16"
            "partial"       :> "§16"
            "foreign"       :> "§23.6"
            "endpoint"      :> "§61"
            "api"           :> "§60"
            "markup"        :> "a legacy document root"
            "defaults"      :> "§65.3.3"
            "keyboard"      :> "§36 input state"
            "mouse"         :> "§36 input state"
            "gamepad"       :> "§36 input state"
            _               :> ""
        }
    }

    // `<*x …/>` (§66.6.2): the existing instance.
    fn resolveStar(env: Env, e: AElem, st0: AS) -> AS {
        let st: AS = st0
        // s442: `<*f/>` naming a FIELD of the enclosing declaration (the
        // program's cells included, R4) — THIS instance's own field (§66.6.2).
        const sf: StarField | not = starField(env, e.tag)
        if (sf is given) return resolveStarField(env, e, sf, st)
        const d: DeclSrc | not = declNamed(env.g, e.tag)
        if (d is not) {
            // r1 nit: a field of SOME user declaration, named out of its scope
            const owner: string = fieldOwnerName(env.g, e.tag)
            if (owner != "") {
                return addDiag(st, env.file, e.span, "E-SCOPE-001", "`<*" + e.tag + "/>` — `" + e.tag + "` is a field of `<" + owner + ">`; `<*" + e.tag + "/>` names it only inside `<" + owner + ">`'s renders (§66.6.2)")
            }
            return addDiag(st, env.file, e.span, "E-DECL-STAR-PREDEFINED", "`<*" + e.tag + "/>` — a predefined (HTML) declaration has no shared instance (§66.6.5)")
        }
        for (const a of e.attrs) {
            if (fieldIndex(d.info, a.name) >= 0) {
                st = addDiag(st, env.file, a.span, "E-DECL-STAR-REF-ATTR-WRITE", "`" + a.name + "=` on `<*" + e.tag + ">` would write the referenced instance — a `<*x>` reference is read-only; write through logic (§66.6.7)")
            }
        }
        if (st.diags.length == st0.diags.length) {
            // s442: the shared instance, inlined (resolveStarShared)
            st = resolveStarShared(env, e, d, st)
        }
        return st
    }

    // ---- s442: `<*f/>` of a field, and state-child bodies ----------------------
    // The field `<*name/>` names from here: a field of the enclosing user
    // declaration (its renders), else a cell of the program visible here.
    type StarField:struct = { decl: DeclInfo, inst: InstRef, idx: int, src: DeclSrc }

    fn starField(env: Env, name: string) -> StarField | not {
        const d: DeclSrc | not = ctxDecl(env)
        if (d is given) {
            if (!d.isProgram) {
                const i: int = fieldIndex(d.info, name)
                if (i >= 0) return { decl: d.info, inst: InstRef.Lexical(0), idx: i, src: d }
            }
        }
        const pi: DeclInfo | not = programInfo(env)
        const ps: DeclSrc | not = findDeclSrc(env.g, env.g.program)
        if (pi is given && ps is given) {
            const j: int = fieldIndex(pi, name)
            if (j >= 0) return { decl: pi, inst: programInst(env), idx: j, src: ps }
        }
        return not
    }

    // A field with a `rule=` graph whose state-children carry bodies renders
    // the body of the variant it holds (O5 (1i)). Anything else a `<*f/>` could
    // mean — a child declaration's own `renders`, a field with no markup
    // (⚑ O51) — is outside this construct and reported.
    fn resolveStarField(env: Env, e: AElem, sf: StarField, st0: AS) -> AS {
        let st: AS = st0
        const f: FieldInfo = sf.decl.fields[sf.idx]
        if (e.attrs.length > 0) {
            return addDiag(st, env.file, e.span, "E-DECL-STAR-REF-ATTR-WRITE", "`<*" + e.tag + ">` names the field `" + e.tag + "` of this instance — a `<*x>` reference takes no attributes here (§66.6.7)")
        }
        // s442: a child field with its own `renders` (§66.4 rule 2: "a field that
        // needs its own … `renders` … is a CHILD declaration") renders it here,
        // for THIS instance (§66.6.2) — resolved in this declaration's context.
        const own: ANode[] = fieldRenders(sf.src, f.nid)
        if (own.length > 0) return addElem(st, e.nid, ElemFact.MInline({ nodes: own, subst: not }))
        const g: TransitionGraph | not = f.graph
        const children: AStateChild[] = fieldStateChildren(sf.src, f.nid)
        let arms: StateArm[] = []
        if (g is given) {
            for (const c of children) {
                const v: int = variantIndex(env.g.types, g.enumSym, c.name)
                if (v >= 0 && c.body.length > 0) arms = arms.concat([{ variant: v, body: c.body }])
            }
            if (arms.length > 0) {
                const sv: StateView = { decl: sf.decl.sym, inst: sf.inst, idx: sf.idx, enumSym: g.enumSym, arms: arms }
                return addElem(st, e.nid, ElemFact.MStateView(sv))
            }
        }
        return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`<*" + e.tag + "/>` — rendering a field is in the bootstrap only for a `rule=` graph field whose state-children have bodies (O5 (1i)); `" + e.tag + "` has none (a field with no markup of its own is ⚑ O51)")
    }

    // The state-children of the field declared by the ADecl `fieldNid` inside
    // the declaration `ds` (a program cell, or a user declaration's child).
    fn fieldStateChildren(ds: DeclSrc, fieldNid: int) -> AStateChild[] {
        for (const fd of fieldDecls(ds)) {
            if (fd.nid == fieldNid) {
                let out: AStateChild[] = []
                for (const c of fd.body) { out = out.concat(stateChildOf(c)) }
                return out
            }
        }
        return []
    }

    // The `renders` of the field declared by the ADecl `fieldNid` in `ds` (as
    // one node, nid -1 — the renders AElem carries the facts), else none.
    fn fieldRenders(ds: DeclSrc, fieldNid: int) -> ANode[] {
        for (const fd of fieldDecls(ds)) {
            if (fd.nid == fieldNid) return rendersOf(fd)
        }
        return []
    }

    // s442: `<*x/>` of a user declaration at program top level — its shared
    // instance (§66.6.2, §66.6.4), rendered by inlining its renders.
    fn resolveStarShared(env: Env, e: AElem, d: DeclSrc, st: AS) -> AS {
        if (!inProgramCtx(env)) {
            return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`<*" + e.tag + "/>` inside a declaration's `renders` (the lexically nearest `" + e.tag + "`, §66.6.2) is not in the bootstrap — only a child field (`<*f/>`) or, at program top level, the shared instance")
        }
        const nodes: ANode[] = rendersNodes(d)
        if (nodes.length == 0) {
            return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`<*" + e.tag + "/>` — `<" + e.tag + ">` has no `renders` (a use of a declaration with no markup is ⚑ O51)")
        }
        // r1 G3: an attribute with no default (⚑ O33) has no value in the shared
        // instance — provably, since a `<*x/>` reference sets nothing (§66.6.7).
        for (const f of d.info.fields) {
            if (isAttributeRole(f.role) && !hasOwnValue(f.init)) {
                return addDiag(st, env.file, e.span, "E-BOOTSTRAP-UNSUPPORTED", "`<*" + e.tag + "/>` — `<" + e.tag + ">`'s attribute `" + f.sym.hint + "` has no default, and a `<*x/>` reference sets none: its value in the shared instance is ⚑ O33 (not ruled)")
            }
        }
        // s444: Core View.Star renders the existing instance with its own
        // renders — its uses, `as=` handles and `<slot/>` included (M1 D4 closed)
        return addElem(st, e.nid, ElemFact.MStar(d.info.sym, InstRef.Shared(d.info.sym)))
    }

    fn isAttributeRole(r: FieldRole) -> boolean {
        return match r {
            .Attribute :> true
            .Child :> false
        }
    }

    // The ADecls that are fields of `ds`: the program's cells (its body's
    // declarations that are not nested user declarations), or a user
    // declaration's child fields.
    fn fieldDecls(ds: DeclSrc) -> ADecl[] {
        const p: AProgram | not = ds.p
        if (p is given) {
            let out: ADecl[] = []
            for (const it of p.items) {
                for (const d of declsOfItem(it)) {
                    if (!isNestedUserDecl(d)) out = out.concat([d])
                }
            }
            return out
        }
        const ud: ADecl | not = ds.d
        if (ud is given) return childFields(ud.body)
        return []
    }

    // Every state-child body of `ds`'s fields, resolved in `ds`'s context (O5
    // (1i): the body is that variant's markup, like the declaration's renders).
    fn stateBodyLists(ds: DeclSrc) -> ANode[][] {
        let out: ANode[][] = []
        for (const fd of fieldDecls(ds)) {
            for (const c of fd.body) {
                for (const sc of stateChildOf(c)) { out = out.concat([sc.body]) }
            }
        }
        return out
    }

    fn stateBodies(ds: DeclSrc) -> ANode[] {
        let out: ANode[] = []
        for (const fd of fieldDecls(ds)) {
            for (const c of fd.body) {
                for (const sc of stateChildOf(c)) { out = out.concat(sc.body) }
            }
        }
        return out
    }

    fn fieldOwnerName(g: Globals, name: string) -> string {
        for (const d of g.decls) {
            if (!d.isProgram && fieldIndex(d.info, name) >= 0) return d.info.sym.hint
        }
        return ""
    }

    // s442: the program's cell `name` when it was declared `single` (§66.13.3).
    fn singleProgramField(env: Env, name: string) -> ADecl | not {
        if (programInfo(env) is not) return not
        const ps: DeclSrc | not = findDeclSrc(env.g, env.g.program)
        if (ps is not) return not
        for (const d of fieldDecls(ps)) {
            if (d.name == name && hasFlag(d.mods, "single")) return d
        }
        return not
    }

    fn singleInstantiated(env: Env, e: AElem, st: AS) -> AS {
        return addDiag(st, env.file, e.span, "E-DECL-SINGLE-INSTANTIATED", "`<" + e.tag + "/>` makes a new instance of `" + e.tag + "`, which is declared `single` — it has exactly one instance; render that one with `<*" + e.tag + "/>` (§66.13.3, O55 ruled S442)")
    }

    fn eventName(attr: string) -> string {
        if (attr.length > 2 && attr.substring(0, 2) == "on") return attr.substring(2)
        return ""
    }

    // A handler value is a statement (or a block of them).
    fn resolveHandler(env: Env, v: AAttrValue, st: AS) -> AS {
        return match v {
            .Bare(e: e) :> handlerReference(env, e, resolveStmtExpr(withFnRef(env, e.nid), e, st))
            .Paren(e: e) :> handlerReference(env, e, resolveStmtExpr(withFnRef(env, e.nid), e, st))
            .Braced(b: b) :> bracedHandler(env, b, st)
            .Quoted(v: s) :> st
            .NoValue :> st
        }
    }

    fn valueExpr(v: AAttrValue) -> AExpr | not {
        return match v {
            .Bare(e: e) :> e
            .Paren(e: e) :> e
            .Quoted(v: s) :> not
            .NoValue :> not
            .Braced(b: b) :> not
        }
    }

    fn resolveValue(env: Env, v: AAttrValue, expected: Type | not, st: AS) -> AS {
        const e: AExpr | not = valueExpr(v)
        if (e is not) return st
        return resolveExpr(env, e, expected, st).st
    }

    // An element's `if=` value: a condition (resolveCond). `elemPresentEnv`:
    // the env its other attributes and its children see — the conditional
    // handle its `if=` tests for presence is mounted there (ruled S442).
    fn resolveIfValue(env: Env, v: AAttrValue, st: AS) -> AS {
        const x: AExpr | not = valueExpr(v)
        if (x is not) return st
        return resolveCond(env, x, st)
    }

    fn elemPresentEnv(env: Env, e: AElem) -> Env {
        const a: AAttr | not = condAttrOf(e.attrs)
        if (a is not) return env
        const x: AExpr | not = valueExpr(a.value)
        if (x is not) return env
        return withPresent(env, presenceHandle(env, x))
    }

    fn resolveHtml(env: Env, e: AElem, st0: AS) -> AS {
        const penv: Env = elemPresentEnv(env, e)
        let st: AS = addElem(st0, e.nid, ElemFact.MHtml)
        // E-DECL-FIELD-TAG-NEEDS-STAR: a bare tag naming a CHILD field of the
        // enclosing declaration (§66.6.6).
        const cd: DeclSrc | not = ctxDecl(env)
        if (cd is given) {
            if (!cd.isProgram) {
                const i: int = fieldIndex(cd.info, e.tag)
                if (i >= 0 && isChildRole(cd.info.fields[i].role)) {
                    st = addDiag(st, env.file, e.span, "E-DECL-FIELD-TAG-NEEDS-STAR", "`<" + e.tag + "/>` names a field of `<" + cd.info.sym.hint + ">` — did you mean `<*" + e.tag + "/>`? A plain tag makes a new instance (§66.6.6)")
                }
            }
        }
        for (const a of e.attrs) {
            const ev: string = eventName(a.name)
            if (isChainAttr(a.name)) {
                // s451: `if=` / `else-if=` / `else` (§17.1.1) — chain attributes (chainCheck)
                st = resolveIfValue(env, a.value, st)
                st = addAttr(st, a.nid, AttrKind.AIf)
            } else if (a.name == "show") {
                st = resolveShow(penv, e, a, st)
            } else if (ev != "") {
                st = resolveHandler(withHost(penv, HostCtx.HostOk), a.value, st)
                st = addAttr(st, a.nid, AttrKind.AOn(ev))
            } else if (a.name.substring(0, 5) == "bind:") {
                // r2 F6: one element writes back to ONE place — a second
                // `bind:` on it (two cells fed from one input) is refused
                // (⚑ PA: the SPEC (§5.4) does not say; no code names it).
                const first: AAttr | not = firstBind(e.attrs)
                if (first is given && first.nid != a.nid) {
                    // s451: the same `bind:` name twice is the parser's
                    // repeated-attribute refusal — one diagnostic per fault
                    if (first.name.toLowerCase() != a.name.toLowerCase()) {
                        st = addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "` is a second `bind:` on this `<" + e.tag + ">` (after `" + first.name + "`) — one element writes back to one place; bind each place on its own element (§5.4)")
                    }
                } else {
                    st = resolveBind(penv, e, a, st)
                }
            } else if (a.name.indexOf(":") >= 0) {
                st = addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "` is not in bootstrap slice M2")
            } else if (valueExpr(a.value) is given) {
                st = resolveValue(penv, a.value, not, st)
                st = addAttr(st, a.nid, AttrKind.ABound)
            } else {
                st = addAttr(st, a.nid, AttrKind.AStatic)
            }
        }
        return resolveNodes(penv, e.kids, st)
    }

    // s451 — `show=cond` on an HTML element (§17.2): "The element EXISTS in the
    // DOM regardless of `expr`. When `expr` evaluates to false, the element is
    // hidden. The compiler generates a CSS `display: none` toggle." It is a
    // condition like `if=` (the typer's checkCond: a `bool` or a `T | not`
    // presence test; §5.2's atomic-only-when-bare rule is shared with `if=` —
    // a bare operator fails in the parser, E-PARSE-TAG, for both, not yet as
    // E-ATTR-UNQUOTED-OPERATOR), resolved
    // in the env the element's other attributes see (inside its `if=`). It
    // does NOT narrow the children — they exist while it is false.
    // §17.1.1: "`if=`, `else-if=`, and `else` MAY coexist on the same element
    // with `show=` … The two attributes compose without conflict" — the chain
    // arm decides presence, this decides visibility (lower: Attr.Show inside
    // the arm). Fail closed: a quoted / valueless / braced condition is
    // refused (as for `if=`, #1254). §5.5.4 / E-ATTR-WRITER-CONFLICT: a
    // WHOLESALE `style=(expr)` "with `if=`/`show=`" shares the `display`
    // surface — its next write would erase the toggle. On any other host
    // (`<each>`, a use, `<*x>`, `<errors>`, `<slot>`, a state-child) `show=`
    // is refused (showHostCheck), never ignored.
    fn resolveShow(env: Env, e: AElem, a: AAttr, st0: AS) -> AS {
        let st: AS = st0
        if (valueExpr(a.value) is not) {
            return addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`show=` on `<" + e.tag + ">` needs a condition expression — `show=@x` or `show=(@n >= 3)`; a quoted, valueless or braced condition is not in the bootstrap (§17.2, §5.2) — it would never hide the element")
        }
        const sa: AAttr | not = attrNamed(e.attrs, "style")
        if (sa is given && !isStaticAttr(sa.value)) {
            st = addDiag(st, env.file, sa.span, "E-ATTR-WRITER-CONFLICT", "`style=(…)` on `<" + e.tag + ">` writes the whole `style` attribute, and `show=` on the same element toggles its `display` — the wholesale write would erase the toggle on its next evaluation. Keep one: drop `show=` and compute `display` in `style=(…)`, or make `style=` static (§5.5.4)")
        }
        st = resolveIfValue(env, a.value, st)
        return addAttr(st, a.nid, AttrKind.AShow)
    }

    // s444 — `bind:value=@place` / `bind:checked=@place` (§5.4): the element
    // shows the place and writes it back. The write is judged exactly as
    // `@place = v` is (the place's own contract; writeGuards); the value it
    // writes is the element's — a string (`value`) or a boolean (`checked`).
    fn resolveBind(env: Env, e: AElem, a: AAttr, st0: AS) -> AS {
        let st: AS = st0
        let kind: BindKind = BindKind.Value
        if (a.name == "bind:checked") {
            kind = BindKind.Checked
        } else if (a.name != "bind:value") {
            if (a.name == "bind:selected" || a.name == "bind:group" || a.name == "bind:files") {
                return addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "` (§5.4) is not in the bootstrap — only `bind:value` and `bind:checked`")
            }
            return addDiag(st, env.file, a.span, "E-ATTR-011", "`" + a.name + "` — `bind:` is valid only on `value`, `checked`, `selected` and `group` (§5.4)")
        }
        const isValue: boolean = kind == BindKind.Value
        if (isValue && e.tag != "input" && e.tag != "textarea" && e.tag != "select") {
            return addDiag(st, env.file, a.span, "E-ATTR-011", "`bind:value` is valid on `<input>`, `<textarea>` and `<select>` (§5.4), not on `<" + e.tag + ">`")
        }
        if (!isValue && (e.tag != "input" || staticAttrText(e.attrs, "type") != "checkbox")) {
            return addDiag(st, env.file, a.span, "E-ATTR-011", "`bind:checked` is valid on `<input type=\"checkbox\">` (§5.4)")
        }
        const x: AExpr | not = valueExpr(a.value)
        if (x is not) return addDiag(st, env.file, a.span, "E-ATTR-010", "`" + a.name + "` requires a reactive `@` place: `" + a.name + "=@x` (§5.4)")
        if (!atRooted(x)) return addDiag(st, env.file, a.span, "E-ATTR-010", "`" + a.name + "` requires a reactive `@` place — a plain value is not written back (§5.4)")
        const rp: RPlace = resolvePlace(env, x, st)
        st = rp.st
        const p: WPlace | not = rp.place
        if (p is not) return st
        st = writeGuards(env, p, x.span, st)
        const f: FieldInfo = p.decl.fields[p.idx]
        const pt: Type | not = p.ty
        if (pt is given) {
            const bad: string = bindTypeProblem(kind, pt)
            if (bad == "coerce") return addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`bind:value` to a `" + typeName(pt) + "` place needs a number coercion of the element's text, which is not in the bootstrap (only string places)")
            if (bad != "") return addDiag(st, env.file, a.span, "E-TYPE-031", "`" + a.name + "` writes " + bad + ", and `" + placeKey(x) + "` is `" + typeName(pt) + "` (§5.4)")
        }
        let rw: RWriteFact = { w: not, st: st }
        if (p.path.length == 0) {
            rw = wholeFieldWrite(env, p, f, x, st, a.span)
        } else {
            rw = fieldAtWrite(env, p, f, x, st, a.span)
        }
        st = rw.st
        const w: WriteFact | not = rw.w
        if (w is not) return st
        // s444 Phase B (RULED S442 (2)): the target field's validators land on
        // this native element — "wherever the bind is written"; a hand-written
        // attribute of the same name wins (it is the element's markup)
        let vattrs: HtmlAttrPair[] = []
        if (p.path.length == 0) {
            const lb: RPairs = bindValAttrs(env, e, a, f, kind, st)
            vattrs = lb.ps
            st = lb.st
        }
        const m: RSym = mint(st, "v")
        return addAttr(m.st, a.nid, AttrKind.ABind(kind, w, p.decl.sym, p.idx, m.s, vattrs))
    }

    fn firstBind(attrs: AAttr[]) -> AAttr | not {
        for (const a of attrs) {
            if (a.name.substring(0, 5) == "bind:") return a
        }
        return not
    }

    type RPairs:struct = { ps: HtmlAttrPair[], st: AS }

    // Each validator's HTML attributes, where they apply to this element (HTML's
    // own applicability: `required` on text-like inputs / textarea / select;
    // `minlength` / `maxlength` / `pattern` on text-like inputs (and textarea
    // for the lengths); `min` / `max` on number / range / date-time inputs).
    // s449: an attribute HTML does not apply to THIS element is simply not
    // written (§55.17.1: "No other validator is lowered") — the validator is
    // not inert: the §55 surface evaluates it and the §55.17 gate enforces it.
    // (Was: refused, when the HTML attribute was the only enforcement.)
    fn bindValAttrs(env: Env, e: AElem, a: AAttr, f: FieldInfo, kind: BindKind, st0: AS) -> RPairs {
        let st: AS = st0
        let out: HtmlAttrPair[] = []
        const itype: string = inputType(e)
        for (const v of f.vals) {
            for (const h of v.attrs) {
                if (htmlApplies(h.name, e.tag, itype, kind)) {
                    if (attrNamed(e.attrs, h.name) is given) {
                        st = handAttrConflict(env, e, f, v.name, h, st)
                    } else if (!hasPairNamed(out, h.name)) {
                        out = out.concat([h])
                    }
                }
            }
        }
        return { ps: out, st: st }
    }

    // r2 F6: a hand-written attribute of a lowered validator's name. The same
    // static text is the same constraint (the element's markup renders it); a
    // different one (`minlength="1"` against `length(>=3)`), or a computed one,
    // contradicts the declaration's contract on the one element the browser
    // checks — refused, never silently one or the other (fail-closed; ⚑ PA:
    // §55 does not say which wins — §53.7.1's analogous `type` rule lets the
    // derived attribute win with a warning).
    fn handAttrConflict(env: Env, e: AElem, f: FieldInfo, vname: string, h: HtmlAttrPair, st: AS) -> AS {
        const ha: AAttr | not = attrNamed(e.attrs, h.name)
        if (ha is not) return st
        if (isStaticAttr(ha.value) && staticAttrText(e.attrs, h.name) == h.value) return st
        return addDiag(st, env.file, ha.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + h.name + "` is written by hand on this `<" + e.tag + ">`, and `" + f.sym.hint + "`'s validator `" + vname + "` lowers to `" + h.name + "=\"" + h.value + "\"` here — the two disagree on the constraint the browser checks; remove the hand-written `" + h.name + "` (the declaration's validator is the contract, dpa-058 RULED S442 (2))")
    }

    fn isStaticAttr(v: AAttrValue) -> boolean {
        return match v {
            .Quoted(v: s) :> true
            .NoValue :> true
            .Bare(e: x) :> false
            .Paren(e: x) :> false
            .Braced(b: b) :> false
        }
    }

    fn hasPairNamed(ps: HtmlAttrPair[], n: string) -> boolean {
        for (const p of ps) {
            if (p.name == n) return true
        }
        return false
    }

    fn inputType(e: AElem) -> string {
        if (e.tag != "input") return ""
        const t: string = staticAttrText(e.attrs, "type")
        if (t == "") return "text"
        return t.toLowerCase()
    }

    fn isTextInput(t: string) -> boolean {
        return t == "text" || t == "search" || t == "url" || t == "tel" || t == "email" || t == "password"
    }

    fn isRangedInput(t: string) -> boolean {
        return t == "number" || t == "range" || t == "date" || t == "month" || t == "week" || t == "time" || t == "datetime-local"
    }

    fn htmlApplies(name: string, tag: string, itype: string, kind: BindKind) -> boolean {
        const isValue: boolean = kind == BindKind.Value
        if (!isValue) return false
        if (name == "required") return tag == "textarea" || tag == "select" || (tag == "input" && (isTextInput(itype) || isRangedInput(itype)))
        if (name == "minlength" || name == "maxlength") return tag == "textarea" || (tag == "input" && isTextInput(itype))
        if (name == "pattern") return tag == "input" && isTextInput(itype)
        if (name == "min" || name == "max") return tag == "input" && isRangedInput(itype)
        return false
    }

    // "" = the value a bind writes fits the place; "coerce" = a numeric place
    // (bind:value); else what the bind writes.
    fn bindTypeProblem(kind: BindKind, t: Type) -> string {
        let inner: Type = t
        const mi: Type | not = maybeInner(t)
        if (mi is given) inner = mi
        const isValue: boolean = kind == BindKind.Value
        if (isValue) {
            if (inner == Type.Str) return ""
            if (inner == Type.Int || inner == Type.Num) return "coerce"
            return "a string"
        }
        if (inner == Type.Bool) return ""
        return "a boolean"
    }

    // Is `e` a place rooted in `@` (`@x`, `@x.f`, `@h.f.g`)?
    fn atRooted(e: AExpr) -> boolean {
        const k: AExprK = e.k
        return match k {
            .At(name: n) :> true
            .Member(obj: o) :> atRooted(o)
            .AtItem :> true
            .Name(name: n) :> false
            .Num(raw: r) :> false
            .Str(v: x) :> false
            .Bool(v: b) :> false
            .NotLit :> false
            .Recovered :> false
            .Variant(name: n) :> false
            .Call(callee: c) :> false
            .Unary(op: o) :> false
            .Binary(op: o) :> false
            .Ternary(test: t) :> false
            .Assign(target: t) :> false
            .ArrayLit(elems: es) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: x) :> false
            .Index(obj: o) :> false
            .Lambda(params: ps) :> false
            .Sql(q: q) :> false
            .Handled(h: x) :> false
        }
    }

    // A static attribute's text ("" when absent or not a quoted literal).
    fn staticAttrText(attrs: AAttr[], name: string) -> string {
        const a: AAttr | not = attrNamed(attrs, name)
        if (a is not) return ""
        const v: AAttrValue = a.value
        return match v {
            .Quoted(v: s) :> s
            .NoValue :> ""
            .Bare(e: x) :> exprName(x)
            .Paren(e: x) :> ""
            .Braced(b: b) :> ""
        }
    }

    fn handleByOwnerName(env: Env, owner: int, name: string) -> HandleInfo | not {
        for (const h of env.g.handles) {
            if (h.owner == owner && h.name == name) return h
        }
        return not
    }

    // A USE of a declaration (§66.6.1): a new instance; its attributes are
    // construction (§66.14 rule 4, L6 / O60 — the printer seeds a field with a
    // capability and derives one without).
    fn resolveUse(env: Env, e: AElem, d: DeclSrc, st0: AS) -> AS {
        const penv: Env = elemPresentEnv(env, e)
        let st: AS = st0
        let alias: Sym | not = not
        for (const a of e.attrs) {
            if (a.name == "as") {
                const n: string = bareName(a.value)
                const h: HandleInfo | not = lookupHandle(env, n)
                if (h is given) alias = h.sym
                st = addAttr(st, a.nid, AttrKind.AAs)
            } else if (isChainAttr(a.name)) {
                st = resolveIfValue(env, a.value, st)
                st = addAttr(st, a.nid, AttrKind.AIf)
            } else {
                const i: int = fieldIndex(d.info, a.name)
                if (i < 0 && a.name == "show") {
                    // s451: §17.2 `show=` on a use — see showHostCheck
                    st = addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`show=` on a use of `<" + e.tag + ">` is not in the bootstrap — only an HTML element is shown / hidden (§17.2); wrap the use in one: `<div show=…><" + e.tag + " …/></div>`")
                } else if (i < 0) {
                    st = addDiag(st, env.file, a.span, "E-DECL-USE-ATTR", "`<" + e.tag + ">` has no attribute `" + a.name + "`")
                } else {
                    const f: FieldInfo = d.info.fields[i]
                    st = resolveConstructValue(penv, a.value, f.ty, st)
                    st = addAttr(st, a.nid, AttrKind.AConstruct(i))
                }
            }
        }
        st = addElem(st, e.nid, ElemFact.MUse(d.info.sym, alias))
        // s449 (from U0 review F1): an effect in USE-SITE SLOT CONTENT (§66.15.2)
        // is rendered wherever the declaration's `renders` places `<slot/>` —
        // zero times (the effect would be dropped) or several (it would run once
        // per placement). Which scope owns slot content is not settled, so the
        // bootstrap refuses it, as it refuses an effect in a `renders`.
        for (const sp of kidEffectSpans(e.kids)) {
            st = addDiag(st, env.file, sp, "E-BOOTSTRAP-UNSUPPORTED", "an effect in the slot content of `<" + e.tag + ">` is not in the bootstrap — slot content is rendered once per `<slot/>` in its `renders` (possibly never, possibly twice), and which scope owns it is not settled (§6.7.4 / §66.15.2); write the effect outside the use")
        }
        return resolveNodes(penv, e.kids, st)
    }

    fn resolveConstructValue(env: Env, v: AAttrValue, t: Type, st: AS) -> AS {
        return match v {
            .Quoted(v: s) :> st
            .Bare(e: e) :> resolveExpr(env, e, t, st).st
            .Paren(e: e) :> resolveExpr(env, e, t, st).st
            .NoValue :> st
            .Braced(b: b) :> addDiag(st, env.file, b.span, "E-DECL-USE-ATTR", "a construction value is an expression, not a block")
        }
    }

    // `<each in=… key=… as name>` (§17.7): a row scope with its own binding and handles (§66.7.4).
    fn resolveEach(env: Env, e: AElem, st0: AS) -> AS {
        let st: AS = st0
        let srcTy: Type | not = not
        let asName: string = ""
        for (const a of e.attrs) {
            if (a.name == "in") {
                const ex: AExpr | not = valueExpr(a.value)
                if (ex is given) {
                    const r: RX = resolveExpr(env, ex, not, st)
                    st = r.st
                    srcTy = r.x.ty
                }
                st = addAttr(st, a.nid, AttrKind.AEachIn)
            } else if (a.name == "as") {
                asName = bareName(a.value)
                st = addAttr(st, a.nid, AttrKind.AEachAs)
            }
        }
        if (asName == "") asName = "item"
        let elemTy: Type | not = not
        if (srcTy is given) elemTy = seqElem(unMaybe(srcTy))    // `S | not` iterates `S` (§17.7.2)
        const rs: RSym = mint(st, asName)
        st = rs.st
        let rowHandles: HandleInfo[] = []
        let hsyms: Sym[] = []
        for (const h of env.g.handles) {
            if (h.owner == e.nid) {
                rowHandles = rowHandles.concat([h])
                hsyms = hsyms.concat([h.sym])
            }
        }
        const row: RowB = { bind: rs.s, ty: elemTy }
        const renv: Env = withRow(env, row, asName, rowHandles)
        // `key=` is an attribute of `<each>`, not part of the row TEMPLATE: it
        // reads the row's item, never an `as=` handle of the row it keys
        // (§66.7.3 an instance is "keyed by the row's `key=`"; §66.7.4 a row
        // handle is visible "within that row's template only").
        const kenv: Env = withRow(env, row, asName, [])
        for (const a of e.attrs) {
            if (a.name == "key") {
                st = resolveValue(kenv, a.value, not, st)
                st = addAttr(st, a.nid, AttrKind.AEachKey)
            } else if (a.name != "in" && a.name != "as") {
                st = addDiag(st, env.file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`<each " + a.name + "=>` is not in bootstrap slice M2")
            }
        }
        st = addElem(st, e.nid, ElemFact.MEach(rs.s, hsyms))
        return resolveNodes(renv, e.kids, st)
    }

    // =========================================================================
    // Phase B driver.
    // =========================================================================
    fn handlesOwnedBy(g: Globals, owner: int) -> HandleInfo[] {
        let out: HandleInfo[] = []
        for (const h of g.handles) {
            if (h.owner == owner) out = out.concat([h])
        }
        return out
    }

    fn declEnv(g: Globals, ds: DeclSrc, inRenders: boolean) -> Env {
        return { g: g, file: ds.file, ctx: CtxK.InDecl(ds.info.sym, ds.isProgram), locals: [], rows: [],
                 handles: handlesOwnedBy(g, ds.info.nid), inRenders: inRenders, narrows: [], present: [],
                 host: HostCtx.HostNo, own: "", inEffect: false, fx: noFailCtx() }
    }

    fn phaseB(g: Globals, st0: AS) -> AS {
        let st: AS = st0
        for (const ds of g.decls) {
            // initializers (L2: the instance under construction is Lexical(0))
            const ienv: Env = declEnv(g, ds, false)
            for (const f of ds.info.fields) {
                st = resolveValue(ienv, f.init, f.ty, st)
            }
            // renders
            const renv: Env = declEnv(g, ds, true)
            st = resolveNodes(renv, rendersNodes(ds), st)
            // s442: state-child bodies (O5 (1i)), in the same context
            for (const sb of stateBodyLists(ds)) { st = resolveNodes(renv, sb, st) }   // s451: one sibling list each (if-chains)
            // s442: a child field's own renders (§66.4 rule 2), in the same context;
            // s444: with `@<field>` naming that field of this instance (O54 = (a))
            if (ds.p is not) {
                for (const fd of fieldDecls(ds)) { st = resolveNodes(withOwn(renv, fd.name), rendersOf(fd), st) }
            }
        }
        const prog: DeclSrc | not = findDeclSrc(g, g.program)
        let progHandles: HandleInfo[] = []
        if (prog is given) progHandles = handlesOwnedBy(g, prog.info.nid)
        for (const fs of g.fns) {
            let hs: HandleInfo[] = []
            if (fs.info.file == g.entry) hs = progHandles
            let host: HostCtx = HostCtx.HostOk
            if (fs.info.pure) host = HostCtx.HostPure
            const fx: FailCtx = { inFn: true, fnName: fs.info.name, failable: fs.info.failable, err: fs.info.err, defer: false, subject: -1, whole: -1, fnRef: -1, wholeWhat: "",
                                  fnSym: fs.info.sym.id, serverOwn: fs.info.serverOwn }
            let env: Env = { g: g, file: fs.info.file, ctx: CtxK.InFn, locals: [], rows: [], handles: hs, inRenders: false, narrows: [], present: [], host: host, own: "", inEffect: false, fx: fx }
            const fte: TypeEnv = { stubs: g.te.stubs, declNames: g.te.declNames, declSyms: g.te.declSyms, file: fs.info.file }
            for (const p of fs.f.params) {
                const rs: RSym = mint(st, p.name)
                st = rs.st
                let pty: Type = Type.Str
                const at: AType | not = p.ty
                if (at is given) {
                    // a type that failed to parse is not resolved (its parse
                    // error is the diagnostic; the typer treats it as unproven)
                    if (!hasErrIn(fileErrs(g.files, fs.info.file), at.span)) {
                        const rt: RType = resolveType(fte, at, st)
                        pty = rt.t
                        const unresolved: boolean = rt.unresolved
                        st = rt.st
                        if (unresolved) st = badParam(st, p.nid)     // r8: never checked against
                    }
                } else {
                    st = addDiag(st, fs.info.file, p.span, "E-BOOTSTRAP-UNSUPPORTED", "an unannotated parameter `" + p.name + "` — bootstrap slice M2 needs `" + p.name + ": Type` (Core parameters are typed)")
                }
                st = addBind(st, p.nid, BindFact.BParam(rs.s, pty))
                env = withLocal(env, { name: p.name, s: rs.s, ty: pty, mutable: false, narrowed: not, nDecl: not })
            }
            st = resolveBlock(env, fs.f.body, st)
            st = deferChecks(fs.info.file, fs.f.body, st)    // s451: §19.16 block-chain rules
        }
        return st
    }

    // =========================================================================
    // THE SCOPE PASS (M3 item 1) — a scope binds each name once.
    //
    // Reads the binder's tables, and the function / handler BODIES of the
    // FileAst for the block rule. Codes, as resolved by the governing-sentence
    // gate (docs/changes/s439-bootstrap-m3-typer/progress.md):
    //   - a FILE-SCOPE duplicate — two cells of the program, two functions of
    //     one file — is E-SCOPE-010 (§7.3.3: "File-scope duplicates are
    //     E-SCOPE-010 (§7.6)"; §7.6.1: a file-level cell declaration takes
    //     part in file scope "identically to file-level `let`/`const`");
    //   - a `let` / `const` that redeclares a name of the SAME block of a
    //     function body (or, in its top-level block, a parameter) is
    //     E-SCOPE-REDECLARE (§7.3.3). A nested block may shadow.
    //   - two `as=` of one name in one scope, or a handle named like a cell:
    //     E-HANDLE-REDECLARE (ruled S440 #5 / #7; SPEC §66.7.2) — dupHandles;
    //   - a duplicate top-level `function`: E-SCOPE-010 (ruled S440 #6; SPEC
    //     §7.6) — dupFns;
    //   - where no ruling / SPEC sentence names one — a handle or a program
    //     cell named like a visible declaration, two fields of one
    //     declaration, two declarations or types of one name in one file, two
    //     parameters of one name, a redeclaration inside an inline handler
    //     block — the bootstrap-local E-BOOTSTRAP-REDECLARE (each owes a ruling);
    //   - one name declared in two FILES (a declaration, a function): the
    //     bootstrap links ONE namespace, so it cannot tell them apart —
    //     E-BOOTSTRAP-UNSUPPORTED.
    // =========================================================================
    fn mkDiag(file: string, span: ASpan, code: string, msg: string) -> Diag {
        return newDiag(code, msg, file, span)
    }

    fn offsetOf(span: ASpan) -> string { return "offset " + span.start }

    // The index of the first of `names[0 .. j)` equal to `names[j]`, else -1.
    fn earlierSame(names: string[], j: int) -> int {
        let i = 0
        while (i < j) {
            if (names[i] == names[j]) return i
            i = i + 1
        }
        return -1
    }

    fn checkScopes(files: FileAst[], t: Tables) -> Diag[] {
        let out: Diag[] = dupFields(files, t).concat(dupDecls(t)).concat(dupTypes(t)).concat(dupFns(t)).concat(dupHandles(files, t))
        for (const f of files) {
            for (const af of fnItems(f.items)) {
                out = out.concat(dupParams(f.path, af.params))
                out = out.concat(blockRedeclares(f.path, af.body, af.params, true))
            }
            out = out.concat(handlerRedeclares(f.path, fileMarkup(f.items)))
        }
        return out
    }

    // Two fields of one declaration. The program's fields ARE the file-scope
    // cells (R4), so a duplicate there is E-SCOPE-010.
    fn dupFields(files: FileAst[], t: Tables) -> Diag[] {
        let out: Diag[] = []
        for (const d of t.decls) {
            let names: string[] = []
            for (const f of d.fields) { names = names.concat([f.sym.hint]) }
            let j = 0
            while (j < names.length) {
                const i: int = earlierSame(names, j)
                if (i >= 0) {
                    const f: FieldInfo = d.fields[j]
                    const first: string = offsetOf(d.fields[i].span)
                    if (d.sym.id == t.program.id) {
                        out = out.concat([mkDiag(d.file, f.span, "E-SCOPE-010", "`" + names[j] + "` is already declared at file scope (at " + first + ") — a file-scope name is bound once: duplicate binding in file scope (§7.6, §7.6.1)")])
                    } else {
                        out = out.concat([mkDiag(d.file, f.span, "E-BOOTSTRAP-REDECLARE", "`<" + d.sym.hint + ">` already has a field `" + names[j] + "` (at " + first + ") — a declaration's fields are named once (the SPEC names no code for this; bootstrap-local)")])
                    }
                } else if (d.sym.id == t.program.id && visibleDeclNamed(files, t, d.file, names[j])) {
                    // `@x` would name both the cell and `<x>`'s shared instance (§66.7.1)
                    out = out.concat([mkDiag(d.file, d.fields[j].span, "E-SCOPE-010", "`" + names[j] + "` — `@" + names[j] + "` already names the shared instance of `<" + names[j] + ">` (§66.7.1); a program cell cannot take that name (a cell named like a visible declaration is E-SCOPE-010, ruled S442)")])
                }
                j = j + 1
            }
        }
        return out
    }

    // Is a user declaration named `name` VISIBLE in `file` — declared there,
    // or imported into it (§21.3)? Only a visible one claims `@name` there.
    fn visibleDeclNamed(files: FileAst[], t: Tables, file: string, name: string) -> boolean {
        for (const d of t.decls) {
            if (d.sym.id != t.program.id && d.sym.hint == name) {
                if (d.file == file || importsName(files, file, name)) return true
            }
        }
        return false
    }

    fn importsName(files: FileAst[], file: string, name: string) -> boolean {
        for (const f of files) {
            if (f.path == file) {
                for (const it of f.items) {
                    const imp: AImport | not = importOf(it)
                    if (imp is given) {
                        for (const n of imp.names) {
                            if (n.name == name) return true
                        }
                    }
                }
            }
        }
        return false
    }

    // Two `type` declarations of one name (SPEC-silent: bootstrap-local). In
    // two files the bootstrap's one type namespace would silently take the first.
    fn dupTypes(t: Tables) -> Diag[] {
        let out: Diag[] = builtinRedeclares(t)
        let names: string[] = []
        let users: TypeInfo[] = []
        for (const ti of t.types) {
            if (ti.file != builtinFile()) {
                names = names.concat([ti.name])
                users = users.concat([ti])
            }
        }
        let j = 0
        while (j < names.length) {
            const i: int = earlierSame(names, j)
            if (i >= 0) {
                const ti: TypeInfo = users[j]
                const first: TypeInfo = users[i]
                if (first.file == ti.file) {
                    out = out.concat([mkDiag(ti.file, ti.span, "E-BOOTSTRAP-REDECLARE", "type `" + names[j] + "` is already declared in this file (at " + offsetOf(first.span) + ") — a file declares each type name once (the SPEC names no code for this; bootstrap-local)")])
                } else {
                    out = out.concat([mkDiag(ti.file, ti.span, "E-BOOTSTRAP-UNSUPPORTED", "type `" + names[j] + "` is also declared in `" + first.file + "` — " + oneNamespace(names[j]))])
                }
            }
            j = j + 1
        }
        return out
    }

    // s451 (Ue) — §19.8.4: "`SqlError` SHALL be a built-in enum type provided by
    // the compiler. The developer SHALL NOT redefine it." (No code is named:
    // the bootstrap-local redeclaration code, as for the other unnamed cases.)
    // A user `Error` is legal: it shadows the built-in by name (§19.4.2 only
    // makes the built-in the bare `!`'s default).
    fn builtinRedeclares(t: Tables) -> Diag[] {
        let out: Diag[] = []
        for (const ti of t.types) {
            if (ti.file != builtinFile() && ti.name == "SqlError") {
                out = out.concat([mkDiag(ti.file, ti.span, "E-BOOTSTRAP-REDECLARE", "`SqlError` is the built-in enum of query failures (§19.8.1) — \"The developer SHALL NOT redefine it\" (§19.8.4); name this type something else")])
            }
            // s454 (U1b) — §19.9.10: "the developer SHALL NOT redefine it"
            if (ti.file != builtinFile() && ti.name == serverCallErrorName()) {
                out = out.concat([mkDiag(ti.file, ti.span, "E-BOOTSTRAP-REDECLARE", "`ServerCallError` is the built-in enum of a client call's boundary failures (§19.9.10: `Unreachable`, `Refused(status)`, `ServerFault(status)`, `Malformed(reason)`) — \"the developer SHALL NOT redefine it\"; name this type something else")])
            }
        }
        return out
    }

    // Why a name declared in two files is refused (measured on base
    // b7c863235: the binder resolved every use to the FIRST one — a silent
    // mis-link), stated as the slice limit it is.
    fn oneNamespace(name: string) -> string {
        return "the bootstrap links one namespace, so every use of `" + name + "` would resolve to the first one (a silent mis-link); it is refused instead (a bootstrap slice limit, not a language rule)"
    }

    // Two parameters of one name (SPEC-silent: bootstrap-local).
    fn dupParams(file: string, ps: AParam[]) -> Diag[] {
        let out: Diag[] = []
        let names: string[] = []
        for (const p of ps) { names = names.concat([p.name]) }
        let j = 0
        while (j < names.length) {
            const i: int = earlierSame(names, j)
            if (i >= 0) {
                out = out.concat([mkDiag(file, ps[j].span, "E-BOOTSTRAP-REDECLARE", "parameter `" + names[j] + "` is already declared (at " + offsetOf(ps[i].span) + ") — a parameter list names each parameter once (the SPEC names no code for this; bootstrap-local)")])
            }
            j = j + 1
        }
        return out
    }

    // Two user declarations of one name.
    fn dupDecls(t: Tables) -> Diag[] {
        let out: Diag[] = []
        let users: DeclInfo[] = []
        for (const d of t.decls) {
            if (d.sym.id != t.program.id) users = users.concat([d])
        }
        let names: string[] = []
        for (const d of users) { names = names.concat([d.sym.hint]) }
        let j = 0
        while (j < names.length) {
            const i: int = earlierSame(names, j)
            if (i >= 0) {
                const d: DeclInfo = users[j]
                const first: DeclInfo = users[i]
                if (first.file == d.file) {
                    out = out.concat([mkDiag(d.file, d.span, "E-BOOTSTRAP-REDECLARE", "`<" + names[j] + ">` is already declared in this file (at " + offsetOf(first.span) + ") — the SPEC names no code for this; bootstrap-local")])
                } else {
                    out = out.concat([mkDiag(d.file, d.span, "E-BOOTSTRAP-UNSUPPORTED", "`<" + names[j] + ">` is also declared in `" + first.file + "` — " + oneNamespace(names[j]))])
                }
            }
            j = j + 1
        }
        return out
    }

    // Two functions of one name. In one file that is a file-scope duplicate:
    // RULED S440 (22-item queue #6, "duplicate top-level `function` →
    // E-SCOPE-010, §7.6 text fixed to name `function`"); SPEC §7.6: "Two
    // top-level `function` declarations of one name SHALL be a compile error
    // (E-SCOPE-010: duplicate binding in file scope)".
    fn dupFns(t: Tables) -> Diag[] {
        let out: Diag[] = []
        let names: string[] = []
        for (const f of t.fns) { names = names.concat([f.name]) }
        let j = 0
        while (j < names.length) {
            const i: int = earlierSame(names, j)
            if (i >= 0) {
                const f: FnInfo = t.fns[j]
                const first: FnInfo = t.fns[i]
                if (first.file == f.file) {
                    out = out.concat([mkDiag(f.file, f.span, "E-SCOPE-010", "function `" + names[j] + "` is already declared at file scope (at " + offsetOf(first.span) + ") — duplicate binding in file scope (§7.6; ruled S440 #6)")])
                } else {
                    out = out.concat([mkDiag(f.file, f.span, "E-BOOTSTRAP-UNSUPPORTED", "function `" + names[j] + "` is also declared in `" + first.file + "` — " + oneNamespace(names[j]))])
                }
            }
            j = j + 1
        }
        return out
    }

    // `as=` handles: one name per scope (a declaration's renders, or one
    // `<each>` row — §66.7.4), and never a name `@…` already means.
    // RULED S440 (#5 = PA rec: "(i) duplicate `as=` in one scope and (ii) a
    // handle named like a cell are errors under one code
    // (`E-HANDLE-REDECLARE`); (iii) the same name on mutually exclusive `if=`
    // instances is an error for now, logged as a candidate widening"; #7 +
    // SPEC-text OPEN #7: "a row `as=` handle may shadow a program-level
    // HANDLE, not a CELL"). SPEC §66.7.2: "Each of the following is a compile
    // error, `E-HANDLE-REDECLARE`". So:
    //   - two handles of one name in one scope — (i), and (iii) when they sit
    //     under `if=` (exclusive arms are one scope too) — E-HANDLE-REDECLARE;
    //   - a handle in ANY scope — the program, a row (§66.7.4), a
    //     declaration's `renders` — named like a cell VISIBLE in its file —
    //     (ii) — E-HANDLE-REDECLARE. Program cells are visible only in the
    //     program's own file (§7.6.1);
    //   - a row / renders handle named like a PROGRAM handle is legal (#7):
    //     different owners, never compared here.
    // A PROGRAM-scope handle named like a visible declaration (whose `@name`
    // is its shared instance, §66.7.1) is not a cell: no ruling names it, so
    // it stays the bootstrap-local E-BOOTSTRAP-REDECLARE (owes a ruling).
    fn dupHandles(files: FileAst[], t: Tables) -> Diag[] {
        let out: Diag[] = []
        let prog: DeclInfo | not = declInfo(t, t.program)
        let cells: string[] = []
        let cellSpans: ASpan[] = []
        let progNid: int = -1
        let progFile: string = ""
        if (prog is given) {
            progNid = prog.nid
            progFile = prog.file
            for (const f of prog.fields) {
                cells = cells.concat([f.sym.hint])
                cellSpans = cellSpans.concat([f.span])
            }
        }
        let j = 0
        while (j < t.handles.length) {
            const h: HandleInfo = t.handles[j]
            let dup: HandleInfo | not = not
            let i = 0
            while (i < j) {
                const o: HandleInfo = t.handles[i]
                if (dup is not && o.owner == h.owner && o.name == h.name) dup = o
                i = i + 1
            }
            if (dup is given) {
                let why: string = ""
                if (h.conditional || dup.conditional) why = " — even under mutually exclusive `if=` conditions (an error for now, ruled S440 #5 (iii))"
                out = out.concat([mkDiag(h.file, h.span, "E-HANDLE-REDECLARE", "`as=" + h.name + "` — a handle `@" + h.name + "` is already bound in this scope (at " + offsetOf(dup.span) + "); a scope binds each handle name once" + why + " (§66.7.2)")])
            } else if (h.file == progFile && cells.indexOf(h.name) >= 0) {
                const cellAt: string = offsetOf(cellSpans[cells.indexOf(h.name)])
                out = out.concat([mkDiag(h.file, h.span, "E-HANDLE-REDECLARE", "the handle `as=" + h.name + "` is named like the cell `@" + h.name + "` (declared at " + cellAt + ") — a handle may not share a cell's name, in any scope (a row handle may shadow a program-level HANDLE, never a cell); rename one of them (§66.7.2, §66.7.4)")])
            } else if (visibleDeclNamed(files, t, h.file, h.name)) {   // any scope — program, row, renders (r5 R5, ruled S442)
                out = out.concat([mkDiag(h.file, h.span, "E-HANDLE-REDECLARE", "`as=" + h.name + "` — `@" + h.name + "` already names the shared instance of `<" + h.name + ">` (§66.7.1); a handle cannot take that name (a handle named like a visible declaration is E-HANDLE-REDECLARE, ruled S442)")])
            }
            j = j + 1
        }
        return out
    }

    // §7.3.3: a block binds each name once. `params` are the function's own
    // (they share its top-level block); a nested block starts afresh (it may
    // shadow). `inFn` = a function body; else an inline handler block, which
    // §7.3.3 does not name (bootstrap-local code). Only `let` / `const` locals
    // are compared: ruling:user-voice-scrml.md S439 #6 (B1) exempts a nested
    // `function x` over a parameter `x` — the slice's statement grammar has no
    // nested function yet, so that holds by construction; when one parses it
    // must NOT be compared against the parameters here.
    fn blockRedeclares(file: string, b: ABlock, params: AParam[], inFn: boolean) -> Diag[] {
        let out: Diag[] = []
        let names: string[] = []
        let spans: ASpan[] = []
        for (const p of params) {
            names = names.concat([p.name])
            spans = spans.concat([p.span])
        }
        const nParams: int = params.length
        for (const s of b.stmts) {
            const n: string = localNameOf(s)
            if (n != "") {
                const i: int = names.indexOf(n)
                if (i >= 0) out = out.concat([redeclareDiag(file, n, s.span, spans[i], i < nParams, inFn)])
                names = names.concat([n])
                spans = spans.concat([s.span])
            }
            for (const nb of nestedBlocks(s)) { out = out.concat(blockRedeclares(file, nb, [], inFn)) }
        }
        return out
    }

    fn redeclareDiag(file: string, name: string, span: ASpan, first: ASpan, isParam: boolean, inFn: boolean) -> Diag {
        let what: string = "a declaration"
        if (isParam) what = "a parameter"
        const msg: string = "`" + name + "` is already bound in this block by " + what + " (at " + offsetOf(first) + ") — a block binds each name once; a NESTED block may shadow it (§7.3.3)"
        if (inFn) return mkDiag(file, span, "E-SCOPE-REDECLARE", msg)
        return mkDiag(file, span, "E-BOOTSTRAP-REDECLARE", msg + " — §7.3.3 names function bodies; the bootstrap applies it to an inline handler block too (bootstrap-local)")
    }

    fn localNameOf(s: AStmt) -> string {
        const k: AStmtK = s.k
        return match k {
            .Local(name: n) :> n
            .Eval(e: e) :> ""
            .Return(e: e) :> ""
            .If(cond: c) :> ""
            .Given(name: n) :> ""
            .EffectStmt(w: w) :> ""
            .Defer(body: b) :> ""
            .Fail(f: x) :> ""
        }
    }

    fn nestedBlocks(s: AStmt) -> ABlock[] {
        const k: AStmtK = s.k
        return match k {
            .If(cond: c, thenB: t, elseB: el) :> thenElse(t, el)
            .Given(name: n, body: b) :> [b]
            .EffectStmt(w: w) :> []
            .Eval(e: e) :> allExprBlocks(e)                 // s451 (Ue): a handling form's arm blocks
            .Local(name: n, init: i) :> allExprBlocks(i)
            .Return(e: e) :> maybeExprBlocks(e)
            .Defer(body: b) :> [b]
            .Fail(f: x) :> []
        }
    }

    // s451 (Ue) — every arm block inside an expression, at any depth.
    fn allExprBlocks(e: AExpr) -> ABlock[] {
        let out: ABlock[] = exprBlocks(e)
        for (const x of exprKids(e)) { out = out.concat(allExprBlocks(x)) }
        return out
    }

    fn maybeExprBlocks(e: AExpr | not) -> ABlock[] {
        if (e is not) return []
        return allExprBlocks(e)
    }

    // s451 (Ue) — a `fail`'s expressions: its payload values, or the non-variant target.
    fn failExprs(f: AFail) -> AExpr[] {
        const t: AExpr | not = f.target
        if (t is given) return f.args.concat([t])
        return f.args
    }

    fn thenElse(t: ABlock, el: ABlock | not) -> ABlock[] {
        if (el is given) return [t, el]
        return [t]
    }

    // Every markup tree the binder resolves in a file: the program's body and
    // each declaration's `renders`.
    fn fileMarkup(items: AItem[]) -> ANode[] {
        let out: ANode[] = []
        for (const it of items) { out = out.concat(itemMarkup(it)) }
        return out
    }

    fn itemMarkup(it: AItem) -> ANode[] {
        const k: AItemK = it.k
        return match k {
            .ProgramItem(p: p) :> markupNodes(p.items)
            .DeclItem(d: d) :> rendersOf(d)
            .ImportItem(i: i) :> []
            .TypeItem(t: t) :> []
            .FnItem(f: f) :> []
            .MarkupItem(n: n) :> []
        }
    }

    fn rendersOf(d: ADecl) -> ANode[] {
        const r: AElem | not = d.renders
        if (r is not) return []
        return [{ nid: -1, span: r.span, k: ANodeK.Elem(r) }]
    }

    fn handlerRedeclares(file: string, nodes: ANode[]) -> Diag[] {
        let out: Diag[] = []
        for (const n of nodes) { out = out.concat(nodeHandlerRedeclares(file, n)) }
        return out
    }

    fn nodeHandlerRedeclares(file: string, n: ANode) -> Diag[] {
        const k: ANodeK = n.k
        return match k {
            .Elem(e: e) :> elemHandlerRedeclares(file, e)
            .Text(text: t) :> []
            .Interp(e: x) :> []
            .DeclNode(d: d) :> []
            // s449: an effect body is a block like an inline handler's
            .Effect(w: w) :> blockRedeclares(file, w.body, [], false)
        }
    }

    fn elemHandlerRedeclares(file: string, e: AElem) -> Diag[] {
        let out: Diag[] = []
        for (const a of e.attrs) {
            const b: ABlock | not = bracedOf(a.value)
            if (b is given && eventName(a.name) != "") out = out.concat(blockRedeclares(file, b, [], false))
        }
        return out.concat(handlerRedeclares(file, e.kids))
    }

    fn bracedOf(v: AAttrValue) -> ABlock | not {
        return match v {
            .Braced(b: b) :> b
            .Bare(e: e) :> not
            .Paren(e: e) :> not
            .Quoted(v: s) :> not
            .NoValue :> not
        }
    }

    // =========================================================================
    // THE TYPER (M3 item 1) — a type per expression node, and the checks.
    //
    // A pass over the FileAst that reads the binder's `Tables` (every name is
    // already a Sym, every write already classified) and produces the typer's
    // own table, `Typing` (one VType per expression NodeId), plus diagnostics.
    // It re-decides no binding, and it never re-scans source text (Rule 7).
    //
    // What it checks, and why (the governing-sentence gate,
    // docs/changes/s439-bootstrap-m3-typer/progress.md):
    //   - WRITES (§66.1 rule 5: "Every cell and field write SHALL be
    //     type-checked against the target's declared type"): a whole-field
    //     replace / transition, a field-at write, each override of a spread
    //     (O58 (b)), an appended / prepended element. A value PROVABLY not of
    //     the target's type is E-TYPE-031; the absence literal `not` into a
    //     type without `| not` is E-TYPE-041 (§42.3.1). RULED S440 (22-item
    //     queue #1, "cell write type mismatch → E-TYPE-031"; SPEC-text OPEN
    //     #1, "a wrong-typed FIELD write is E-TYPE-031 too"): §7.5.1
    //     position 6.
    //   - INITIALIZERS — a declaration's own value / attribute default, and a
    //     use-site construction value, which IS that field's initializer for
    //     that instance (§66.9 rule 8): §7.5.1 position 2 — an `int` /
    //     `number` / `string` / `boolean` ANNOTATION given a literal of a
    //     different primitive is E-TYPE-031 (`int` joined the set: RULED S440,
    //     JS-WAT 7(a)); `not` into a non-optional annotation is E-TYPE-041.
    //   - CALL ARITY: E-CALL-ARITY (ruled S440 #2; SPEC §7.3) — see typeCall.
    //   - `<each in=…>`: E-EACH-NOT-SEQUENCE (ruled S440 #3; SPEC §17.7.2) for
    //     a value provably not a sequence — see checkIterable.
    //   - CONDITIONS (`if`, `if=` / `else-if=`, `show=`, a ternary test): a
    //     `bool` or a `T | not` presence test, else E-COND-NOT-BOOLEAN (ruled
    //     S440 #4 = (c) + Q1) — an UNRESOLVED type included (ruled S460 "a′,
    //     go": conditions are provable-or-ERROR, SPEC §42.4) — see checkCond;
    //     a presence test is recorded for `lower`.
    //   - OPERATORS (ruled S440 Gotcha Q1-Q3, dpa-054 #3): E-OPERATOR-OPERAND-TYPE,
    //     E-OPERAND-NOT-NARROWED, E-INT-DIVISION — see checkOperands; the
    //     narrowing they need — see NARROWING.
    // What it deliberately does NOT check: an ARGUMENT's type (§7.5.1
    // position 3: such a program "SHALL compile") and a return value
    // (position 4) — no ruling widened those.
    //
    // Assignability is PROVABLE-OR-SILENT: a check fires only on `Fails`, and
    // an Unknown value is never an error here. (The one exception is a
    // CONDITION — S460, see checkCond.) `int` is ENFORCED (RULED S440,
    // JS-WAT 7(a)): a `number` into an `int` is `Fails`.
    // =========================================================================
    export fn exprType(t: Tables, nid: int) -> VType {
        const i: int = slotOf(t.typing.at, nid)
        if (i < 0) return VType.Unknown
        return t.typing.exprs[i].vt
    }

    // Is condition node `nid` a presence test (a `T | not` condition)?
    export fn presenceTest(t: Tables, nid: int) -> boolean {
        return t.typing.presence.indexOf(nid) >= 0
    }

    // The settled pass's types, indexed by NodeId (the first entry per node;
    // the same one-pass build as `nidIndex`, over the entries' own nids).
    fn typingOf(exprs: ExprType[], presence: int[]) -> Typing {
        let top: int = -1
        for (const x of exprs) {
            if (x.nid > top) top = x.nid
        }
        let at: int[] = minusOnes(top + 1)
        let i: int = exprs.length - 1
        while (i >= 0) {
            if (exprs[i].nid >= 0) at[exprs[i].nid] = i
            i = i - 1
        }
        return { exprs: exprs, at: at, presence: presence }
    }

    // `contribs`: every value an UNANNOTATED `let` local is given — its
    // initializer and each later assignment (a local's type is their join).
    // `presence`: the presence-test condition nodes (Typing.presence).
    type TypeState:struct = { exprs: ExprType[], diags: Diag[], contribs: LocalT[], presence: int[] }
    type RTyping:struct = { typing: Typing, diags: Diag[] }
    type LocalT:struct = { id: int, vt: VType }
    // The typer's view of where it is: the tables, the file, the locals'
    // types (by Sym id) in scope, and `settled` — the local types the
    // previous pass joined (they win over `locals`, see typeProgram).
    // `narrowed`: the PLACES proven present here (see NARROWING below), by
    // place key — a `T | not` read of one of them is typed `T`.
    // `fnw`: each function's WRITE SET (place keys it may write, transitively
    // through its calls) — a call drops the narrowing of what its callee writes.
    // `blame`: what has already been reported (see Blame) — read only by the
    // condition rule (checkCond), never by another check.
    type TEnv:struct = { t: Tables, file: string, errs: ASpan[], locals: LocalT[], settled: LocalT[], narrowed: string[],
                         fnw: FnW[], rows: Alias[], fret: Type | not, blame: Blame }
    // s460 — §42.4 statement 6 ("no second report"): a CONDITION whose type is
    // unresolved BECAUSE of an error already reported is not reported again.
    // `spans`: the Error diagnostics the passes before the typer (binder, scope,
    // effect, validator) reported in this file; `syms`: the locals whose
    // WRITTEN type was refused (a parameter annotation that failed to parse or
    // to resolve, E-TYPE-UNKNOWN — Rule C for names, r8); `fns`: the functions
    // (by Sym id) whose written return type was refused, or whose name is
    // declared in two files (guard (ii), already E-BOOTSTRAP-UNSUPPORTED).
    type Blame:struct = { spans: ASpan[], syms: int[], fns: int[] }
    type RVT:struct = { vt: VType, ts: TypeState }
    type RTEnv:struct = { env: TEnv, ts: TypeState }

    fn tWithRefused(env: TEnv, s: Sym) -> TEnv {
        const b: Blame = { spans: env.blame.spans, syms: env.blame.syms.concat([s.id]), fns: env.blame.fns }
        return { t: env.t, file: env.file, errs: env.errs, locals: env.locals, settled: env.settled,
                 narrowed: env.narrowed, fnw: env.fnw, rows: env.rows, fret: env.fret, blame: b }
    }

    fn tWithLocal(env: TEnv, s: Sym, vt: VType) -> TEnv {
        return { t: env.t, file: env.file, errs: env.errs, locals: env.locals.concat([{ id: s.id, vt: vt }]), settled: env.settled,
                 narrowed: env.narrowed, fnw: env.fnw, rows: env.rows, fret: env.fret, blame: env.blame }
    }

    // ---- NARROWING (for the S440 `T | not` operand rule) ------------------------
    // RULED S440 (Gotcha Q3): "a `T | not` operand must be narrowed before `+`,
    // arithmetic, comparison, or use in a template" — so the typer must know
    // where a `T | not` place IS narrowed, or it would refuse correct code.
    // The slice's narrowing forms (it parses no `is some` / `given` over a
    // value): the explicit tests `x is given` / `x is not` (s460, §42.4
    // statement 8), a presence comparison `x != not` / `x == not` (either
    // side), and a bare `T | not` condition `if (x)` (a presence test,
    // truthiness Q1) — narrowing the `if` / `else` branch, the ternary arm,
    // the right operand of `&&` / `||`, an element under `if=` (its other
    // attributes and children), and the rest of a block after an `if` whose
    // other branch always `return`s. They combine through `&&` / `||` and
    // through a `!` applied to one of those BOOLEAN tests (`!(x is not)`,
    // `!(x == not)`); a `!` over a bare `T | not` is not a combination — it is
    // refused (E-OPERATOR-OPERAND-TYPE: `!` takes booleans, S440 Gotcha Q2),
    // because a bare optional is a presence test only as a WHOLE condition.
    // A place is named by its key: a local by its Sym (`#id`), a cell /
    // handle path by its spelling (`@o.v`). A write to the place (or a prefix
    // of it) drops the narrowing for the rest of the block — a bare write, a
    // call whose callee may write it (`fnw`), and a write inside a NESTED
    // block too (an `if` / `given` leaves the JOIN of its paths, r2 F1 / F3).
    type Narrowing:struct = { yes: string[], no: string[] }

    fn noNarrowing() -> Narrowing { return { yes: [], no: [] } }

    // s451 — a deferred body runs at its block's EXIT (§19.16.2), where a
    // narrowing in force at the `defer` may no longer hold. It keeps only the
    // narrowings nothing can undo before that exit: a local (`#id`, not a
    // place under it) that is never rebound — a parameter, a `const`, a
    // `let` with no assignment (no EAssignLocal of it anywhere). A cell's
    // narrowing (`@…`) is dropped: the rest of the block, or any call, may
    // write the cell. Fail closed — a dropped narrowing makes a read in the
    // deferred body unproven, never silently `T`.
    fn tDeferEnv(env: TEnv) -> TEnv {
        let keep: string[] = []
        for (const k of env.narrowed) {
            if (k.indexOf("#") == 0 && k.indexOf(".") < 0 && !reboundLocal(env.t, k.substring(1))) keep = keep.concat([k])
        }
        return { t: env.t, file: env.file, errs: env.errs, locals: env.locals, settled: env.settled, narrowed: keep, fnw: env.fnw, rows: env.rows, fret: env.fret, blame: env.blame }
    }

    // Is the local with Sym id `id` rebound (`x = …`) anywhere?
    fn reboundLocal(t: Tables, id: string) -> boolean {
        for (const f of t.effects.facts) {
            if (reboundId(f) == id) return true
        }
        return false
    }

    fn reboundId(f: EffectFact) -> string {
        return match f {
            .EAssignLocal(sym: s) :> "" + s.id
            .EWrite(w: w) :> ""
            .ESpread(ws: ws) :> ""
            .EReset(w: w) :> ""
            .EEdits(w: w) :> ""
            .ERemove(w: w) :> ""
            .EElemAt(cap: c) :> ""
        }
    }

    fn tNarrow(env: TEnv, keys: string[]) -> TEnv {
        let out: string[] = env.narrowed
        for (const k of keys) {
            if (k != "") out = out.concat([k])
        }
        return { t: env.t, file: env.file, errs: env.errs, locals: env.locals, settled: env.settled, narrowed: out, fnw: env.fnw, rows: env.rows, fret: env.fret, blame: env.blame }
    }

    // Drop the narrowing of `key` and of every place under it.
    // (r3 N3) An `<each>` row binding (`rows`: its `#id` key → its source's
    // place key) is an element OF its source: a write to the source (or to a
    // place over / under it) drops the row binding's narrowings too.
    fn tUnnarrow(env: TEnv, key: string) -> TEnv {
        if (key == "") return env
        let drop: string[] = [key]
        // rows are outer-first: one ordered pass also drops a NESTED row whose
        // source lies under an already-dropped row (`<each in=g.kids>`, r5 R1)
        // (A write strictly UNDER a source — `@xs[0].n` — also drops, but the
        // slice parser drops indexing (residue R7), so that limb is unreachable.)
        for (const r of env.rows) {
            if (r.key != "" && (underAny(r.key, drop) || underAny(key, [r.key]))) drop = drop.concat([r.name])
        }
        let out: string[] = []
        for (const k of env.narrowed) {
            if (!underAny(k, drop)) out = out.concat([k])
        }
        return { t: env.t, file: env.file, errs: env.errs, locals: env.locals, settled: env.settled, narrowed: out, fnw: env.fnw, rows: env.rows, fret: env.fret, blame: env.blame }
    }

    // Is `k` one of `keys`, or a place under one?
    fn underAny(k: string, keys: string[]) -> boolean {
        for (const d of keys) {
            if (k == d || k.indexOf(d + ".") == 0) return true
        }
        return false
    }

    fn tWithRow(env: TEnv, bind: Sym, src: string) -> TEnv {
        return { t: env.t, file: env.file, errs: env.errs, locals: env.locals, settled: env.settled, narrowed: env.narrowed,
                 fnw: env.fnw, rows: env.rows.concat([{ name: "#" + bind.id, key: src }]), fret: env.fret, blame: env.blame }
    }

    // A place's key ("" — not a place the typer narrows).
    fn nKey(env: TEnv, e: AExpr) -> string {
        const k: AExprK = e.k
        return match k {
            .Name(name: n) :> localKey(nameFact(env.t.names, e.nid))
            .At(name: n) :> "@" + n
            .Member(obj: o, name: n) :> memberKey(nKey(env, o), n)
            .AtItem :> ""
            .Num(raw: r) :> ""
            .Str(v: s) :> ""
            .Bool(v: b) :> ""
            .NotLit :> ""
            .Recovered :> ""
            .Variant(name: n) :> ""
            .Call(callee: c) :> ""
            .Unary(op: o) :> ""
            .Binary(op: o) :> ""
            .Ternary(test: x) :> ""
            .Assign(target: x) :> ""
            .ArrayLit(elems: es) :> ""
            .ObjectLit(props: ps) :> ""
            .Spread(e: sx) :> ""
            .Index(obj: ix) :> ""
            .Lambda(params: lp) :> ""
            .Sql(q: q) :> ""
            .Handled(h: x) :> ""
        }
    }

    fn localKey(f: NameFact | not) -> string {
        return match f {
            .NLocal(sym: s) :> "#" + s.id
            .NField(decl: d) :> ""
            .NInst(decl: d) :> ""
            .NStruct(owner: o) :> ""
            .NFn(sym: s) :> ""
            .NLength :> ""
            .NSurface(of: x) :> ""
            not :> ""
        }
    }

    fn isNotLit(e: AExpr) -> boolean {
        const k: AExprK = e.k
        return match k {
            .NotLit :> true
            .Name(name: n) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Num(raw: r) :> false
            .Str(v: s) :> false
            .Bool(v: b) :> false
            .Recovered :> false
            .Variant(name: n) :> false
            .Member(obj: o) :> false
            .Call(callee: c) :> false
            .Unary(op: o) :> false
            .Binary(op: o) :> false
            .Ternary(test: x) :> false
            .Assign(target: x) :> false
            .ArrayLit(elems: es) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: sx) :> false
            .Index(obj: ix) :> false
            .Lambda(params: lp) :> false
            .Sql(q: q) :> false
            .Handled(h: x) :> false
        }
    }

    // What a condition proves present when it is true (`yes`) / false (`no`).
    fn condNarrowing(env: TEnv, c: AExpr) -> Narrowing {
        const k: AExprK = c.k
        return match k {
            .Binary(op: o, l: l, r: r) :> binNarrowing(env, o, l, r)
            .Unary(op: o, e: x) :> unaryNarrowing(env, o, x)
            .Name(name: n) :> placeNarrowing(env, c)
            .At(name: n) :> placeNarrowing(env, c)
            .Member(obj: o) :> placeNarrowing(env, c)
            .AtItem :> noNarrowing()
            .Num(raw: r) :> noNarrowing()
            .Str(v: s) :> noNarrowing()
            .Bool(v: b) :> noNarrowing()
            .NotLit :> noNarrowing()
            .Recovered :> noNarrowing()
            .Variant(name: n) :> noNarrowing()
            .Call(callee: x) :> noNarrowing()
            .Ternary(test: x) :> noNarrowing()
            .Assign(target: x) :> noNarrowing()
            .ArrayLit(elems: es) :> noNarrowing()
            .ObjectLit(props: ps) :> noNarrowing()
            .Spread(e: sx) :> noNarrowing()
            .Index(obj: ix) :> noNarrowing()
            .Lambda(params: lp) :> noNarrowing()
            .Sql(q: q) :> noNarrowing()
            .Handled(h: x) :> noNarrowing()
        }
    }

    // A bare place as a condition is a presence test (truthiness Q1): true ⇒ present.
    // (F17: a match arm whose body is an object literal — arms call this instead.)
    fn placeNarrowing(env: TEnv, c: AExpr) -> Narrowing { return { yes: [nKey(env, c)], no: [] } }

    fn binNarrowing(env: TEnv, op: BinOp, l: AExpr, r: AExpr) -> Narrowing {
        return match op {
            .Ne :> presenceCmp(env, l, r, true)
            .Eq :> presenceCmp(env, l, r, false)
            .And :> andNarrowing(condNarrowing(env, l), condNarrowing(env, r))
            .Or :> orNarrowing(condNarrowing(env, l), condNarrowing(env, r))
            .Add :> noNarrowing()
            .Sub :> noNarrowing()
            .Mul :> noNarrowing()
            .Div :> noNarrowing()
            .Mod :> noNarrowing()
            .Lt :> noNarrowing()
            .Le :> noNarrowing()
            .Gt :> noNarrowing()
            .Ge :> noNarrowing()
            .Pipe :> noNarrowing()
        }
    }

    // `x != not` proves `x` present when true; `x == not` when false.
    fn presenceCmp(env: TEnv, l: AExpr, r: AExpr, ne: boolean) -> Narrowing {
        let key: string = ""
        if (isNotLit(r)) key = nKey(env, l)
        if (isNotLit(l)) key = nKey(env, r)
        if (ne) return { yes: [key], no: [] }
        return { yes: [], no: [key] }
    }

    fn andNarrowing(a: Narrowing, b: Narrowing) -> Narrowing { return { yes: a.yes.concat(b.yes), no: [] } }
    fn orNarrowing(a: Narrowing, b: Narrowing) -> Narrowing { return { yes: [], no: a.no.concat(b.no) } }

    fn unaryNarrowing(env: TEnv, op: UnOp, x: AExpr) -> Narrowing {
        // s460: `x is given` proves `x` present when true; `x is not` when
        // false (as `x != not` / `x == not` do — §42.4 statement 8)
        if (op == UnOp.IsGiven) return { yes: [nKey(env, x)], no: [] }
        if (op == UnOp.IsNot) return { yes: [], no: [nKey(env, x)] }
        const isNot: boolean = op == UnOp.Not
        if (!isNot) return noNarrowing()
        const n: Narrowing = condNarrowing(env, x)
        return { yes: n.no, no: n.yes }
    }

    // A place read: its `T | not` type is `T` where the place is narrowed.
    fn narrowRead(env: TEnv, e: AExpr, vt: VType) -> VType {
        const x: Type | not = knownOf(vt)
        if (x is not) return vt
        const inner: Type | not = maybeInner(x)
        if (inner is not) return vt
        const key: string = nKey(env, e)
        if (key != "" && env.narrowed.indexOf(key) >= 0) return known(inner)
        return vt
    }

    // Does a block always leave its function (its last statement a `return`,
    // or an `if` both of whose branches do)?
    fn exits(b: ABlock) -> boolean {
        if (b.stmts.length == 0) return false
        return stmtExits(b.stmts[b.stmts.length - 1])
    }

    fn stmtExits(s: AStmt) -> boolean {
        const k: AStmtK = s.k
        return match k {
            .Return(e: e) :> true
            .If(cond: c, thenB: t, elseB: el) :> bothExit(t, el)
            .Eval(e: e) :> false
            .Local(name: n) :> false
            .Given(name: n) :> false
            .EffectStmt(w: w) :> false
            .Defer(body: b) :> false
            .Fail(f: x) :> true                  // s451 (Ue): `fail` leaves the function (§19.3.2)
        }
    }

    fn bothExit(t: ABlock, el: ABlock | not) -> boolean {
        if (el is not) return false
        return exits(t) && exits(el)
    }

    // ---- WRITE SETS (s442 r2 F1: a call may undo a narrowing) ------------------
    // A function's write set: the place keys (`@o`, `@o.n`, spelled as
    // placeKey spells them) its body writes — an assignment, `reset(@x)`, an
    // edit call `@xs.push(…)` — and, transitively, what the functions it calls
    // write. A `given c = @h` body's `c.f` is `@h.f`. Syntactic and whole
    // program (the bootstrap links one namespace): over-approximate, so it only
    // ever un-narrows MORE (never silences a report).
    type FnW:struct = { name: string, keys: string[], params: int[] }   // `params`: the parameter nids (r4 (c): argument checks)
    type Alias:struct = { name: string, key: string }

    fn exprKids(e: AExpr) -> AExpr[] {
        const k: AExprK = e.k
        return match k {
            .Member(obj: o) :> [o]
            .Call(callee: c, args: a) :> [c].concat(a)
            .Unary(op: o, e: x) :> [x]
            .Binary(op: o, l: l, r: r) :> [l, r]
            .Ternary(test: t, yes: y, no: n) :> [t, y, n]
            .Assign(target: t, value: v) :> [t, v]
            .ArrayLit(elems: es) :> es
            .ObjectLit(props: ps) :> propValueList(ps)
            .Spread(e: x) :> [x]
            .Index(obj: o, idx: i) :> [o, i]
            .Lambda(params: lp, body: b) :> [b]
            .Sql(q: q) :> q.params
            .Handled(h: h) :> handledKids(h)      // s451 (Ue): the subject, then each expression arm (block arms: exprBlocks)
            .Name(name: n) :> []
            .At(name: n) :> []
            .AtItem :> []
            .Num(raw: r) :> []
            .Str(v: s) :> []
            .Bool(v: b) :> []
            .NotLit :> []
            .Recovered :> []
            .Variant(name: n) :> []
        }
    }

    // s451 (Ue) — a handling form's expression children: its subject, then
    // each EXPRESSION arm's body. Its arm BLOCKS hold statements — every walk
    // that recurses through exprKids reaches them through exprBlocks.
    fn handledKids(h: AHandled) -> AExpr[] {
        let out: AExpr[] = [h.subject]
        for (const a of handledArms(h)) {
            const b: AArmBody = a.body
            out = out.concat(armExprOf(b))
        }
        return out
    }

    fn handledArms(h: AHandled) -> AArm[] {
        const how: AHow = h.how
        return match how {
            .Propagate :> []
            .Guard(arms: arms) :> arms
            .MatchOn(arms: arms) :> arms
        }
    }

    fn armExprOf(b: AArmBody) -> AExpr[] {
        return match b {
            .ArmExpr(e: x) :> [x]
            .ArmBlock(b: blk) :> []
        }
    }

    fn armBlockOf(b: AArmBody) -> ABlock[] {
        return match b {
            .ArmExpr(e: x) :> []
            .ArmBlock(b: blk) :> [blk]
        }
    }

    // s451 (Ue) — the statement BLOCKS directly inside an expression: a
    // handling form's block arms (no other expression holds statements).
    fn exprBlocks(e: AExpr) -> ABlock[] {
        const h: AHandled | not = handledOf(e.k)
        if (h is not) return []
        let out: ABlock[] = []
        for (const a of handledArms(h)) {
            const b: AArmBody = a.body
            out = out.concat(armBlockOf(b))
        }
        return out
    }

    fn propValueList(ps: AProp[]) -> AExpr[] {
        let out: AExpr[] = []
        for (const p of ps) { out = out.concat([p.value]) }
        return out
    }

    // What an expression writes: place keys, and `()name` for each call of `name`.
    fn exprEffects(e: AExpr) -> string[] {
        let out: string[] = ownEffect(e)
        for (const x of exprKids(e)) { out = out.concat(exprEffects(x)) }
        for (const b of exprBlocks(e)) { out = out.concat(blockEffects(b, [])) }    // s451 (Ue): an arm block's writes
        return out
    }

    fn exprsEffects(es: AExpr[]) -> string[] {
        let out: string[] = []
        for (const x of es) { out = out.concat(exprEffects(x)) }
        return out
    }

    fn ownEffect(e: AExpr) -> string[] {
        const k: AExprK = e.k
        return match k {
            .Assign(target: t) :> [placeKey(t)]
            .Call(callee: c, args: a) :> callEffect(c, a)
            .Name(name: n) :> []
            .At(name: n) :> []
            .AtItem :> []
            .Num(raw: r) :> []
            .Str(v: s) :> []
            .Bool(v: b) :> []
            .NotLit :> []
            .Recovered :> []
            .Variant(name: n) :> []
            .Member(obj: o) :> []
            .Unary(op: o) :> []
            .Binary(op: o) :> []
            .Ternary(test: x) :> []
            .ArrayLit(elems: es) :> []
            .ObjectLit(props: ps) :> []
            .Spread(e: sx) :> []
            .Index(obj: ix) :> []
            .Lambda(params: lp) :> []
            .Sql(q: q) :> []
            .Handled(h: x) :> []
        }
    }

    fn callEffect(c: AExpr, a: AExpr[]) -> string[] {
        const n: string = exprName(c)
        if (n == "reset") {
            if (a.length == 1) return [placeKey(a[0])]
            return []
        }
        if (n != "") return ["()" + n]
        const m: MethodCall | not = methodCall(c)
        if (m is given) return [placeKey(m.obj)]
        return []
    }

    fn blockEffects(b: ABlock, al: Alias[]) -> string[] {
        let out: string[] = []
        for (const s of b.stmts) { out = out.concat(stmtEffects(s, al)) }
        return out
    }

    fn stmtEffects(s: AStmt, al: Alias[]) -> string[] {
        const k: AStmtK = s.k
        return match k {
            .Eval(e: e) :> aliased(exprEffects(e), al)
            .Local(name: n, init: i) :> aliased(exprEffects(i), al)
            .Return(e: e) :> aliased(maybeEffects(e), al)
            .If(cond: c, thenB: t, elseB: el) :> aliased(exprEffects(c), al).concat(blockEffects(t, al)).concat(elseEffects(el, al))
            .Given(name: n, subject: sub, body: b) :> aliased(exprEffects(sub), al).concat(blockEffects(b, al.concat([aliasOf(n, sub)])))
            .EffectStmt(w: w) :> []              // registers nothing where it stands (refused there) and writes nothing
            .Defer(body: b) :> blockEffects(b, al)   // s451: runs at the block's exit — its writes are the function's
            .Fail(f: f) :> aliased(exprsEffects(failExprs(f)), al)
        }
    }

    fn aliasOf(n: string, sub: AExpr) -> Alias { return { name: n, key: placeKey(sub) } }

    fn maybeEffects(e: AExpr | not) -> string[] {
        if (e is not) return []
        return exprEffects(e)
    }

    fn elseEffects(el: ABlock | not, al: Alias[]) -> string[] {
        if (el is not) return []
        return blockEffects(el, al)
    }

    // `c.f` inside `given c = @h` is `@h.f`.
    fn aliased(keys: string[], al: Alias[]) -> string[] {
        let out: string[] = []
        for (const k of keys) {
            let key: string = k
            for (const a of al) {
                if (a.key != "" && (key == a.name || key.indexOf(a.name + ".") == 0)) key = a.key + key.substring(a.name.length)
            }
            out = out.concat([key])
        }
        return out
    }

    fn fnKeysNamed(ws: FnW[], name: string) -> string[] {
        let out: string[] = []
        for (const w of ws) {
            if (w.name == name) out = out.concat(w.keys)
        }
        return out
    }

    // Every function's write set, closed over its calls (a fixpoint: each pass
    // adds keys, a key set is finite; bounded by the function count + 2).
    fn fnWrites(files: FileAst[]) -> FnW[] {
        let ws: FnW[] = []
        for (const f of files) {
            for (const af of fnItems(f.items)) { ws = ws.concat([{ name: af.name, keys: blockEffects(af.body, []), params: paramNids(af.params) }]) }
        }
        let changed = true
        let pass = 0
        while (changed && pass < ws.length + 2) {
            changed = false
            let next: FnW[] = []
            for (const w of ws) {
                let keys: string[] = w.keys
                for (const k of w.keys) {
                    if (k.indexOf("()") == 0) {
                        for (const c of fnKeysNamed(ws, k.substring(2))) {
                            if (keys.indexOf(c) < 0) {
                                keys = keys.concat([c])
                                changed = true
                            }
                        }
                    }
                }
                next = next.concat([{ name: w.name, keys: keys, params: w.params }])
            }
            ws = next
            pass = pass + 1
        }
        return ws
    }

    // Drop the narrowing of every place a call inside `e` may write. Applied
    // to an expression before it is typed (so a read in it is not narrowed
    // across a call that clears the place — conservatively, a read BEFORE
    // such a call in the same expression is un-narrowed too) and to a
    // statement's continuation.
    fn tCallUnnarrow(env: TEnv, e: AExpr) -> TEnv {
        if (env.narrowed.length == 0) return env
        let out: TEnv = env
        for (const eff of exprEffects(e)) {
            if (eff.indexOf("()") == 0) {
                for (const k of fnKeysNamed(env.fnw, eff.substring(2))) {
                    if (k.indexOf("@") == 0) out = tUnnarrow(out, k)
                }
            }
        }
        return out
    }

    fn findLocalT(ls: LocalT[], id: int) -> VType | not {
        let i: int = ls.length - 1
        while (i >= 0) {
            if (ls[i].id == id) return ls[i].vt
            i = i - 1
        }
        return not
    }

    fn tLocal(env: TEnv, s: Sym) -> VType {
        const settled: VType | not = findLocalT(env.settled, s.id)
        if (settled is given) return settled
        const own: VType | not = findLocalT(env.locals, s.id)
        if (own is given) return own
        return VType.Unknown
    }

    fn record(ts: TypeState, nid: int, vt: VType) -> TypeState {
        return { exprs: ts.exprs.concat([{ nid: nid, vt: vt }]), diags: ts.diags, contribs: ts.contribs, presence: ts.presence }
    }

    fn report(ts: TypeState, env: TEnv, span: ASpan, code: string, msg: string) -> TypeState {
        return { exprs: ts.exprs, diags: ts.diags.concat([mkDiag(env.file, span, code, msg)]), contribs: ts.contribs, presence: ts.presence }
    }

    fn contribute(ts: TypeState, s: Sym, vt: VType) -> TypeState {
        return { exprs: ts.exprs, diags: ts.diags, contribs: ts.contribs.concat([{ id: s.id, vt: vt }]), presence: ts.presence }
    }

    fn markPresence(ts: TypeState, nid: int) -> TypeState {
        return { exprs: ts.exprs, diags: ts.diags, contribs: ts.contribs, presence: ts.presence.concat([nid]) }
    }

    // A local's written type (`let a: T = …`), if it has one.
    fn annotOf(t: Tables, s: Sym) -> Type | not {
        for (const a of t.annots) {
            if (a.sym.id == s.id) return a.ty
        }
        return not
    }

    // One type per unannotated local: the join of everything it is given
    // (flow-insensitive). `not` joined with `T` is `T | not` (§42.3.1: "The
    // compiler SHALL infer `T | not` when a variable is initialized with `not`
    // and later assigned a value of type `T`"); an unprovable join is Unknown.
    fn joinContribs(cs: LocalT[]) -> LocalT[] {
        let out: LocalT[] = []
        for (const c of cs) {
            let found = false
            let next: LocalT[] = []
            for (const o of out) {
                if (o.id == c.id) {
                    next = next.concat([{ id: o.id, vt: joinVT(o.vt, c.vt) }])
                    found = true
                } else {
                    next = next.concat([o])
                }
            }
            if (!found) next = next.concat([c])
            out = next
        }
        return out
    }

    fn sameVT(a: VType, b: VType) -> boolean {
        const x: Type | not = knownOf(a)
        const y: Type | not = knownOf(b)
        if (x is given && y is given) return sameType(x, y)
        if (x is given || y is given) return false
        return isAbsentVT(a) == isAbsentVT(b)
    }

    fn isAbsentVT(v: VType) -> boolean {
        return match v {
            .Absent :> true
            .Known(t: x) :> false
            .Unknown :> false
        }
    }

    fn sameLocals(a: LocalT[], b: LocalT[]) -> boolean {
        if (a.length != b.length) return false
        for (const x of a) {
            const y: VType | not = findLocalT(b, x.id)
            if (y is not) return false
            if (!sameVT(x.vt, y)) return false
        }
        return true
    }


    fn rvt(vt: VType, ts: TypeState) -> RVT { return { vt: vt, ts: ts } }

    // ---- types as values ------------------------------------------------------
    fn known(ty: Type) -> VType { return VType.Known(ty) }

    fn anySeqGrants() -> SeqGrants { return { length: LengthGrant.Free, at: [], shrink: [], positionsWritable: false } }

    fn maybeInner(ty: Type) -> Type | not {
        return match ty {
            .Maybe(inner: i) :> i
            .Int :> not
            .Num :> not
            .Str :> not
            .Bool :> not
            .Named(sym: s) :> not
            .Seq(elem: e) :> not
        }
    }

    // `T` for a `T | not`; any other type as it is.
    fn unMaybe(ty: Type) -> Type {
        const i: Type | not = maybeInner(ty)
        if (i is given) return i
        return ty
    }

    fn typeName(ty: Type) -> string {
        return match ty {
            .Int :> "int"
            .Num :> "number"
            .Str :> "string"
            .Bool :> "bool"
            .Named(sym: s) :> s.hint
            .Seq(elem: e) :> elemName(e) + "[]"
            .Maybe(inner: i) :> typeName(i) + " | not"
        }
    }

    // A sequence's element type as written before `[]`: a `T | not` element is
    // parenthesized — `(int | not)[]`, not `int | not[]` (r7 N2).
    fn elemName(e: Type) -> string {
        if (maybeInner(e) is given) return "(" + typeName(e) + ")"
        return typeName(e)
    }

    // A type's kind, for the assignability table: 0 int · 1 number · 2 string ·
    // 3 bool · 4 named · 5 sequence · 6 maybe.
    fn kindOf(ty: Type) -> int {
        return match ty {
            .Int :> 0
            .Num :> 1
            .Str :> 2
            .Bool :> 3
            .Named(sym: s) :> 4
            .Seq(elem: e) :> 5
            .Maybe(inner: i) :> 6
        }
    }

    // Does a value of type `v` fit a position of type `target`?
    export type Verdict:enum = { Fits, Fails, Unproven }

    fn fitsType(v: Type, target: Type) -> Verdict {
        const ti: Type | not = maybeInner(target)
        const vi: Type | not = maybeInner(v)
        if (ti is given) {
            if (vi is given) return fitsType(vi, ti)
            return fitsType(v, ti)
        }
        if (vi is given) {
            // a `T | not` value into a `T` position: wrong if `T` is; else it
            // may be `not` — not provable here (§42 narrowing is its own rule)
            const r: Verdict = fitsType(vi, target)
            if (r == Verdict.Fails) return Verdict.Fails
            return Verdict.Unproven
        }
        const vk: int = kindOf(v)
        const tk: int = kindOf(target)
        if (tk == 0) {
            // `int` ENFORCED (RULED S440, JS-WAT 7(a): "enforce `int` (bootstrap
            // typer; `7 / 2` into `int` is an error; integer division explicit)";
            // PA note: "§7.5.1's provable domain widens to `int` with it"): a
            // `number` does not narrow to `int` implicitly — only an `int` fits.
            // (int refines number, S404: an `int` into `number` fits, below.)
            if (vk == 0) return Verdict.Fits
            return Verdict.Fails
        }
        if (tk == 1) {
            if (vk == 0 || vk == 1) return Verdict.Fits
            return Verdict.Fails
        }
        if (tk == 4) {
            const vs: Sym | not = namedOf(v)
            const tsym: Sym | not = namedOf(target)
            if (vs is given && tsym is given) {
                if (vs.id == tsym.id) return Verdict.Fits
            }
            return Verdict.Fails
        }
        if (tk == 5) {
            const ve: Type | not = seqElem(v)
            const te: Type | not = seqElem(target)
            if (ve is given && te is given) return fitsType(ve, te)
            return Verdict.Fails
        }
        if (vk == tk) return Verdict.Fits
        return Verdict.Fails
    }

    fn sameType(a: Type, b: Type) -> boolean {
        return fitsType(a, b) == Verdict.Fits && fitsType(b, a) == Verdict.Fits
    }

    fn isNumericKind(ty: Type) -> boolean {
        const k: int = kindOf(ty)
        return k == 0 || k == 1
    }

    // The type two values share (ternary arms, array elements), when provable.
    fn joinVT(a: VType, b: VType) -> VType {
        return match a {
            .Known(t: x) :> joinKnown(x, b)
            .Absent :> joinAbsent(b)
            .Unknown :> VType.Unknown
        }
    }

    fn joinKnown(x: Type, b: VType) -> VType {
        return match b {
            .Known(t: y) :> joinTypes(x, y)
            .Absent :> known(optional(x))
            .Unknown :> VType.Unknown
        }
    }

    fn joinAbsent(b: VType) -> VType {
        return match b {
            .Known(t: y) :> known(optional(y))
            .Absent :> VType.Absent
            .Unknown :> VType.Unknown
        }
    }

    fn optional(ty: Type) -> Type {
        if (maybeInner(ty) is given) return ty
        return Type.Maybe(ty)
    }

    fn joinTypes(x: Type, y: Type) -> VType {
        if (sameType(x, y)) return known(x)
        if (isNumericKind(x) && isNumericKind(y)) return known(Type.Num)
        if (fitsType(y, x) == Verdict.Fits) return known(x)       // T and T | not → T | not
        if (fitsType(x, y) == Verdict.Fits) return known(y)
        return VType.Unknown
    }

    // Arithmetic (§45 aside, JS semantics): int ∘ int is int, any other
    // numeric pair is number, anything else is unproven.
    fn numJoin(a: VType, b: VType) -> VType {
        const x: Type | not = knownOf(a)
        const y: Type | not = knownOf(b)
        if (x is not || y is not) return VType.Unknown
        if (kindOf(x) == 0 && kindOf(y) == 0) return known(Type.Int)
        if (isNumericKind(x) && isNumericKind(y)) return known(Type.Num)
        return VType.Unknown
    }

    fn knownOf(v: VType) -> Type | not {
        return match v {
            .Known(t: x) :> x
            .Absent :> not
            .Unknown :> not
        }
    }


    fn litType(l: Literal) -> VType {
        return match l {
            .Int(v: n) :> known(Type.Int)
            .Num(v: n) :> known(Type.Num)
            .Str(v: s) :> known(Type.Str)
            .Bool(v: b) :> known(Type.Bool)
            .Variant(enumSym: s) :> known(Type.Named(s))
            .Absent :> VType.Absent
        }
    }

    // ---- the binder's facts, as the typer reads them --------------------------
    // Each accessor is total over ONE family (plus `not`: no fact).
    // The value type a NAME denotes (a name / `@x` / `@.` / a member step).
    fn nameType(env: TEnv, f: NameFact | not) -> VType {
        return match f {
            .NLocal(sym: s) :> tLocal(env, s)
            .NField(decl: d, inst: i, idx: x) :> fieldTypeOf(env.t, d, x)
            .NInst(decl: d, inst: i) :> known(instType(env.t, d, i))
            .NStruct(owner: o, idx: x) :> structFieldType(env.t, o, x)
            .NFn(sym: s) :> VType.Unknown
            .NLength :> known(Type.Int)
            .NSurface(of: x, prop: pr) :> surfaceType(pr)
            not :> VType.Unknown
        }
    }

    // s449 — a surface property's value type (§55.5 / §55.6): `isValid`,
    // `touched` and `submitted` are booleans; `errors` (a ValidationError
    // array, or a map of them) is refused as a value before typing.
    fn surfaceType(pr: SurfaceProp) -> VType {
        return match pr {
            .IsValid :> known(Type.Bool)
            .Touched :> known(Type.Bool)
            .Submitted :> known(Type.Bool)
            .Errors :> VType.Unknown
        }
    }

    // Is `c` a bare `@h` naming a CONDITIONALLY-mounted handle?
    fn isCondHandle(env: TEnv, c: AExpr) -> boolean {
        if (atName(c) == "") return false
        return condAlias(env.t, nameFact(env.t.names, c.nid))
    }

    fn condAlias(t: Tables, f: NameFact | not) -> boolean {
        return match f {
            .NInst(decl: d, inst: i) :> condAliasInst(t, i)
            .NLocal(sym: s) :> false
            .NField(decl: d) :> false
            .NStruct(owner: o) :> false
            .NFn(sym: s) :> false
            .NLength :> false
            .NSurface(of: x) :> false
            not :> false
        }
    }

    fn condAliasInst(t: Tables, i: InstRef) -> boolean {
        return match i {
            .Alias(sym: s) :> handleConditional(t, s)
            .Shared(decl: d) :> false
            .Lexical(depth: n) :> false
            .Narrowed(sym: s) :> false
        }
    }

    fn handleConditional(t: Tables, s: Sym) -> boolean {
        for (const h of t.handles) {
            if (h.sym.id == s.id) return h.conditional
        }
        return false
    }

    // An instance's type: a handle to a conditionally-mounted instance is
    // `T | not` (§66.7.5) — so a bare `if=@h` over it is a presence test, and
    // an operator over it is un-narrowed; any other instance is `T`.
    fn instType(t: Tables, d: Sym, i: InstRef) -> Type {
        return match i {
            .Alias(sym: s) :> handleType(t, d, s)
            .Shared(decl: x) :> Type.Named(d)
            .Lexical(depth: n) :> Type.Named(d)
            .Narrowed(sym: s) :> Type.Named(d)
        }
    }

    fn handleType(t: Tables, d: Sym, s: Sym) -> Type {
        for (const h of t.handles) {
            if (h.sym.id == s.id && h.conditional) return Type.Maybe(Type.Named(d))
        }
        return Type.Named(d)
    }

    // The function a callee names.
    fn calleeFn(f: NameFact | not) -> Sym | not {
        return match f {
            .NFn(sym: s) :> s
            .NLocal(sym: s) :> not
            .NField(decl: d) :> not
            .NInst(decl: d) :> not
            .NStruct(owner: o) :> not
            .NLength :> not
            .NSurface(of: x) :> not
            not :> not
        }
    }

    // The type of a constant the binder resolved. (An operator's type is
    // computed from its operands, typeBinary / typeUnary.)
    fn valueType(f: ValueFact | not) -> VType {
        return match f {
            .VLit(lit: l) :> litType(l)
            .VVariant(enumSym: s) :> known(Type.Named(s))
            .VStructOf(ty: s) :> known(Type.Named(s))
            .VOp(op: o) :> VType.Unknown
            .VHost(call: c) :> known(Type.Num)
            .VSeqCall(op: o) :> VType.Unknown
            .VLambda(params: ps) :> VType.Unknown
            not :> VType.Unknown
        }
    }

    fn opOf(f: ValueFact | not) -> PrimOp | not {
        return match f {
            .VOp(op: o) :> o
            .VLit(lit: l) :> not
            .VVariant(enumSym: s) :> not
            .VStructOf(ty: s) :> not
            .VHost(call: c) :> not
            .VSeqCall(op: x) :> not
            .VLambda(params: ps) :> not
            not :> not
        }
    }

    // The Sym a binder binds (a local, a function, a parameter, a `given`).
    fn bindSym(f: BindFact | not) -> Sym | not {
        return match f {
            .BBind(sym: s) :> s
            .BParam(sym: s) :> s
            .BGiven(sym: s) :> s
            not :> not
        }
    }

    // A parameter's (annotated) type.
    fn paramType(f: BindFact | not) -> VType {
        return match f {
            .BParam(sym: s, ty: y) :> known(y)
            .BBind(sym: s) :> VType.Unknown
            .BGiven(sym: s) :> VType.Unknown
            not :> VType.Unknown
        }
    }

    // The classified writes a statement carries: a plain write is one
    // (`prop` = -1, the value is the assignment's / call's own), a spread its
    // overrides; anything else none.
    fn effectWrites(f: EffectFact | not) -> SpreadWrite[] {
        return match f {
            .EWrite(w: w) :> [oneWrite(w)]
            .ESpread(ws: ws) :> ws
            .EReset(w: w) :> []
            .EAssignLocal(sym: s) :> []
            .EEdits(w: w) :> [oneWrite(w)]
            .ERemove(w: w) :> [oneWrite(w)]
            .EElemAt(cap: c) :> []
            not :> []
        }
    }

    fn oneWrite(w: WriteFact) -> SpreadWrite { return { w: w, prop: -1, tmp: not } }

    fn isReset(f: EffectFact | not) -> boolean {
        return match f {
            .EReset(w: w) :> true
            .EWrite(w: w) :> false
            .ESpread(ws: ws) :> false
            .EAssignLocal(sym: s) :> false
            .EEdits(w: w) :> false
            .ERemove(w: w) :> false
            .EElemAt(cap: c) :> false
            not :> false
        }
    }

    // The local a rebinding `a = v` assigns (§66.11.5).
    fn assignedLocal(f: EffectFact | not) -> Sym | not {
        return match f {
            .EAssignLocal(sym: s) :> s
            .EWrite(w: w) :> not
            .ESpread(ws: ws) :> not
            .EReset(w: w) :> not
            .EEdits(w: w) :> not
            .ERemove(w: w) :> not
            .EElemAt(cap: c) :> not
            not :> not
        }
    }

    // The field index a use-site attribute constructs (-1: not a construction).
    fn constructIndex(k: AttrKind | not) -> int {
        return match k {
            .AConstruct(field: i) :> i
            .AStatic :> -1
            .ABound :> -1
            .AOn(event: ev) :> -1
            .AIf :> -1
            .AShow :> -1
            .AAs :> -1
            .AEachIn :> -1
            .AEachKey :> -1
            .AEachAs :> -1
            .ABind(kind: k) :> -1
            not :> -1
        }
    }

    // The declaration a USE constructs.
    fn useDecl(f: ElemFact | not) -> Sym | not {
        return match f {
            .MUse(decl: d) :> d
            .MEach(bind: b) :> not
            .MHtml :> not
            .MSlot :> not
            .MDb :> not
            .MErrors(of: x) :> not
            .MStateView(v: v) :> not
            .MInline(v: v) :> not
            .MStar(decl: d) :> not
            not :> not
        }
    }

    // An `<each>`'s row binding.
    fn eachBind(f: ElemFact | not) -> Sym | not {
        return match f {
            .MEach(bind: b) :> b
            .MUse(decl: d) :> not
            .MHtml :> not
            .MSlot :> not
            .MDb :> not
            .MErrors(of: x) :> not
            .MStateView(v: v) :> not
            .MInline(v: v) :> not
            .MStar(decl: d) :> not
            not :> not
        }
    }
    fn fieldTypeOf(t: Tables, d: Sym, idx: int) -> VType {
        const di: DeclInfo | not = declInfo(t, d)
        if (di is not) return VType.Unknown
        if (idx < 0 || idx >= di.fields.length) return VType.Unknown
        // S444 review: a field whose type is untrusted (did not resolve, or failed
        // to parse) is never checked against — a read of it is unknown (r8)
        if (!di.fields[idx].trusted) return VType.Unknown
        return known(di.fields[idx].ty)
    }

    fn structFieldType(t: Tables, owner: Sym, idx: int) -> VType {
        const ti: TypeInfo | not = typeInfoOf(t.types, owner)
        if (ti is not) return VType.Unknown
        const fs: FieldDef[] | not = structFieldDefs(ti.def)
        if (fs is not) return VType.Unknown
        if (idx < 0 || idx >= fs.length) return VType.Unknown
        if (t.unresolved.fields.indexOf(fs[idx].sym.id) >= 0) return VType.Unknown     // r8
        return known(fs[idx].ty)
    }

    // The field a write capability belongs to (a capability is minted for one
    // field, core.scrml THE BINDER'S OBLIGATION).
    fn fieldOfCap(t: Tables, cap: Sym) -> FieldInfo | not {
        for (const d of t.decls) {
            for (const f of d.fields) {
                const c: Sym | not = f.wcap
                if (c is given) {
                    if (c.id == cap.id) return f
                }
            }
        }
        return not
    }

    // The type the written VALUE must have: the field's (replace, transition),
    // the sub-field's at the end of a FieldAt path, the element's for an edit.
    fn writeValueType(t: Tables, w: WriteFact) -> Type | not {
        const f: FieldInfo | not = fieldOfCap(t, w.cap)
        if (f is not) return not
        const e: EditKind = w.edit
        return match e {
            .Replace :> f.ty
            .Transition :> f.ty
            .FieldAt(path: p) :> pathType(t, p)
            .Append :> seqElem(f.ty)
            .Prepend :> seqElem(f.ty)
            .Anywhere :> seqElem(f.ty)
            .PositionWrite :> f.ty                   // s444: `@x = @x.map(λ)` writes the whole mapped sequence
            .RemoveEnd :> Type.Int                   // s444: the count removed
            .RemoveFront :> Type.Int
            .RemoveAnywhere :> f.ty                  // s444: `@x = @x.filter(λ)` writes the whole filtered sequence
            .ElemAt(index: x, path: p) :> pathType(t, p)
        }
    }

    fn pathType(t: Tables, path: FieldRef[]) -> Type | not {
        if (path.length == 0) return not
        const last: FieldRef = path[path.length - 1]
        return knownOf(structFieldType(t, last.owner, last.idx))
    }

    // ---- the checks ------------------------------------------------------------
    // A value into a typed position (a write): E-TYPE-031 when it provably
    // does not fit, E-TYPE-041 for `not` into a type without `| not`.
    fn checkValue(env: TEnv, v: VType, target: Type, span: ASpan, what: string, ts: TypeState) -> TypeState {
        return match v {
            .Known(t: x) :> checkKnown(env, x, target, span, what, ts)
            .Absent :> checkAbsent(env, target, span, what, ts)
            .Unknown :> ts
        }
    }

    fn checkKnown(env: TEnv, x: Type, target: Type, span: ASpan, what: string, ts: TypeState) -> TypeState {
        if (mayBeNot(x, target)) {
            return report(ts, env, span, "E-TYPE-031", what + " expects `" + typeName(target) + "`, and this value is `" + typeName(x) + "` — a `T | not` is not a `T`: it may be `not`; narrow it first (`if (x is given) { … }`) (§34 E-TYPE-031; ruled S442: \"`T | not` into `T` is an error for all types\")")
        }
        if (fitsType(x, target) != Verdict.Fails) return ts
        return report(ts, env, span, "E-TYPE-031", what + " expects `" + typeName(target) + "`, and this value is `" + typeName(x) + "` (§66.1 rule 5: every cell and field write is type-checked against the target's declared type)" + intHint(unMaybe(x), unMaybe(target)))
    }

    // An UN-NARROWED `T | not` into a non-optional `T` position — at any depth
    // of sequence elements (`[@o.n]` into `int[]`). RULED S442 (dpa-058 list
    // item 4): "`T | not` into `T` is an error for EVERY type … A `T | not`
    // isn't a `T`" — bryan: "if the lifecycle says T | not then it can only
    // end as not". Supersedes the S439 "unproven, not wrong" reading. (A
    // narrowed value reads as `T` and never reaches here as `T | not`; a value
    // whose `T` itself does not fit is fitsType's plain Fails.)
    fn mayBeNot(x: Type, target: Type) -> boolean {
        const xi: Type | not = maybeInner(x)
        const ti: Type | not = maybeInner(target)
        if (xi is given) {
            // both optional: the outer `not` is admitted — look inside (r7 B)
            if (ti is given) return mayBeNot(xi, ti)
            return fitsType(xi, target) != Verdict.Fails
        }
        // an optional TARGET admits the outer `not`, not a `not` element
        // inside (`[@o.n]` into `int[] | not`, r7 B)
        if (ti is given) return mayBeNot(x, ti)
        const xe: Type | not = seqElem(x)
        const te: Type | not = seqElem(target)
        if (xe is given && te is given) return mayBeNot(xe, te)
        return false
    }

    // A `number` into an `int` (RULED S440, JS-WAT 7(a)): say why and what to write.
    fn intHint(x: Type, target: Type) -> string {
        if (kindOf(target) == 0 && kindOf(x) == 1) return " — `int` is enforced: a `number` is not implicitly an `int` (integer division is explicit: `div(a, b, .Mode)`; ruled S440, JS-WAT 7(a))"
        return ""
    }

    fn checkAbsent(env: TEnv, target: Type, span: ASpan, what: string, ts: TypeState) -> TypeState {
        if (maybeInner(target) is given) return ts
        return report(ts, env, span, "E-TYPE-041", "`not` is assigned to " + what + " of non-optional type `" + typeName(target) + "` — only a `" + typeName(target) + " | not` position holds `not` (§42.3.1)")
    }

    // §7.5.1 positions 1 / 2 (and §66.9 rule 8 at a use site): an ANNOTATED
    // `number` / `string` / `boolean` — and, RULED S440 (JS-WAT 7(a), "enforce
    // `int`"; PA note: "§7.5.1's provable domain widens to `int` with it"),
    // `int` — given a literal of a different primitive. An `int` takes an
    // INTEGER literal only (`1.5` is not an `int`); a `number` takes either.
    // (SPEC §7.5.1 still says `int` is "deliberately OUTSIDE" the set — the
    // S440 ruling widens it; SPEC pass 2 owes the text.)
    // 0 non-integer number literal · 4 integer literal · 1 string literal ·
    // 2 boolean literal · 3 `not` · -1 other.
    fn literalKind(e: AExpr) -> int {
        const k: AExprK = e.k
        return match k {
            .Num(raw: r) :> numLitKind(r)
            .Str(v: s) :> 1
            .Bool(v: b) :> 2
            .NotLit :> 3
            .Recovered :> -1
            .Unary(op: o, e: x) :> negLiteralKind(o, x)
            .Name(name: n) :> -1
            .At(name: n) :> -1
            .AtItem :> -1
            .Variant(name: n) :> -1
            .Member(obj: o) :> -1
            .Call(callee: c) :> -1
            .Binary(op: o) :> -1
            .Ternary(test: x) :> -1
            .Assign(target: x) :> -1
            .ArrayLit(elems: es) :> -1
            .ObjectLit(props: ps) :> -1
            .Spread(e: sx) :> -1
            .Index(obj: ix) :> -1
            .Lambda(params: lp) :> -1
            .Sql(q: q) :> -1
            .Handled(h: x) :> -1
        }
    }

    fn numLitKind(raw: string) -> int {
        const t: Type = numType(raw)
        const isInt: boolean = t == Type.Int
        if (isInt) return 4
        return 0
    }

    // `-5` is a number literal; `!true` is an operator applied to one.
    fn negLiteralKind(o: UnOp, x: AExpr) -> int {
        const isNeg: boolean = o == UnOp.Neg
        if (!isNeg) return -1
        const lk: int = literalKind(x)
        if (lk == 0 || lk == 4) return lk
        return -1
    }

    fn primitiveOfLiteral(lk: int) -> string {
        if (lk == 0) return "non-integer number"
        if (lk == 4) return "number"
        if (lk == 1) return "string"
        return "boolean"
    }

    // Does an initializer literal of kind `lk` fit an annotation of kind `tk`?
    // (-1: the annotation is outside the checked set — a named type, a
    // sequence, `T | not` — and is not judged here.)
    fn literalFits(tk: int, lk: int) -> int {
        if (tk == 0) {
            if (lk == 4) return 1
            return 0
        }
        if (tk == 1) {
            if (lk == 0 || lk == 4) return 1
            return 0
        }
        if (tk == 2) {
            if (lk == 1) return 1
            return 0
        }
        if (tk == 3) {
            if (lk == 2) return 1
            return 0
        }
        return -1
    }

    fn checkInit(env: TEnv, target: Type, lk: int, span: ASpan, what: string, ts: TypeState) -> TypeState {
        if (lk < 0) return ts
        if (lk == 3) return checkAbsent(env, target, span, what, ts)
        if (literalFits(kindOf(target), lk) != 0) return ts
        let lit: string = primitiveOfLiteral(lk)
        if (kindOf(target) == 0 && lk == 0) lit = "non-integer number"
        return report(ts, env, span, "E-TYPE-031", what + " is annotated `" + typeName(target) + "`, and its initializer is a " + lit + " literal (§7.5.1: an annotated `let` / `const` or declaration whose initializer is a literal of a different primitive; a use-site value is that field's initializer, §66.9 rule 8; `int` enforced, ruled S440 JS-WAT 7(a))")
    }

    fn attrLiteralKind(v: AAttrValue) -> int {
        return match v {
            .Quoted(v: s) :> 1
            .Bare(e: e) :> literalKind(e)
            .Paren(e: e) :> literalKind(e)
            .NoValue :> -1
            .Braced(b: b) :> -1
        }
    }

    // ---- expressions -----------------------------------------------------------
    fn typeExprs(env: TEnv, es: AExpr[], ts0: TypeState) -> TypeState {
        let ts: TypeState = ts0
        for (const e of es) { ts = typeExpr(env, e, ts).ts }
        return ts
    }

    fn typeExpr(env: TEnv, e: AExpr, ts: TypeState) -> RVT {
        const r: RVT = typeExprK(tCallUnnarrow(env, e), e, ts)
        return rvt(r.vt, record(r.ts, e.nid, r.vt))
    }

    // s451: each expression typed in order (a query's bound values).
    fn typeExprList(env: TEnv, es: AExpr[], ts0: TypeState) -> TypeState {
        let ts: TypeState = ts0
        for (const e of es) { ts = typeExpr(env, e, ts).ts }
        return ts
    }

    fn typeExprK(env: TEnv, e: AExpr, ts: TypeState) -> RVT {
        const nf: NameFact | not = nameFact(env.t.names, e.nid)
        const vf: ValueFact | not = valueFact(env.t.values, e.nid)
        const k: AExprK = e.k
        return match k {
            .Name(name: n) :> rvt(narrowRead(env, e, nameType(env, nf)), ts)
            .At(name: n) :> rvt(narrowRead(env, e, nameType(env, nf)), ts)
            .AtItem :> rvt(nameType(env, nf), ts)
            .Num(raw: r) :> rvt(valueType(vf), ts)
            .Str(v: s) :> rvt(valueType(vf), ts)
            .Bool(v: b) :> rvt(valueType(vf), ts)
            .NotLit :> rvt(VType.Absent, ts)
            .Recovered :> rvt(VType.Unknown, ts)                 // a parse-error placeholder is never typed
            .Variant(name: n) :> rvt(valueType(vf), ts)
            .Member(obj: o, name: n) :> typeMember(env, e, nf, o, ts)
            .Call(callee: c, args: args) :> typeCall(env, e, c, args, ts)
            .Unary(op: o, e: x) :> typeUnary(env, e, o, x, ts)
            .Binary(op: o, l: l, r: r) :> typeBinary(env, e, vf, o, l, r, ts)
            .Ternary(test: x, yes: y, no: n) :> typeTernary(env, x, y, n, ts)
            .Assign(target: x, value: v) :> rvt(VType.Unknown, typeExpr(env, v, ts).ts)
            .ArrayLit(elems: es) :> typeArray(env, es, ts)
            .ObjectLit(props: ps) :> rvt(valueType(vf), typePropValues(env, ps, ts))
            .Spread(e: x) :> rvt(VType.Unknown, typeExpr(env, x, ts).ts)
            .Index(obj: o, idx: i) :> rvt(VType.Unknown, typeExpr(env, i, typeExpr(env, o, ts).ts).ts)
            .Lambda(params: ps2, body: b) :> typeLambda(env, e, b, ts)
            .Handled(h: h) :> typeHandled(env, e, h, ts)   // s451 (Ue)
            .Sql(q: q) :> rvt(VType.Unknown, typeExprList(env, q.params, ts))   // s451: no row type yet (§14.8 schema types are not in the bootstrap)
        }
    }

    // s444 — a lambda: its body typed with its parameters bound (their types
    // are the binder's annotations — the sequence's element type).
    fn typeLambda(env: TEnv, e: AExpr, body: AExpr, ts: TypeState) -> RVT {
        let env2: TEnv = env
        for (const s of lambdaSyms(valueFact(env.t.values, e.nid))) {
            const a: Type | not = annotOf(env.t, s)
            let vt: VType = VType.Unknown
            if (a is given) vt = known(a)
            env2 = tWithLocal(env2, s, vt)
        }
        return rvt(VType.Unknown, typeExpr(env2, body, ts).ts)
    }

    fn lambdaSyms(f: ValueFact | not) -> Sym[] {
        return match f {
            .VLambda(params: ps) :> ps
            .VLit(lit: l) :> []
            .VVariant(enumSym: s) :> []
            .VStructOf(ty: s) :> []
            .VOp(op: o) :> []
            .VHost(call: c) :> []
            .VSeqCall(op: o) :> []
            not :> []
        }
    }

    // s444 — the type of a call that names no function: a host call's, or a
    // filter's (the sequence it filters — the same type).
    fn builtinCallType(env: TEnv, e: AExpr, callee: AExpr, ts: TypeState) -> VType {
        const f: ValueFact | not = valueFact(env.t.values, e.nid)
        return match f {
            .VHost(call: c) :> known(Type.Num)
            .VSeqCall(op: o) :> seqCallType(ts, o, callee)
            .VLit(lit: l) :> VType.Unknown
            .VVariant(enumSym: s) :> VType.Unknown
            .VStructOf(ty: s) :> VType.Unknown
            .VOp(op: o) :> VType.Unknown
            .VLambda(params: ps) :> VType.Unknown
            not :> VType.Unknown
        }
    }

    fn seqCallType(ts: TypeState, o: SeqFn, callee: AExpr) -> VType {
        const isFilter: boolean = o == SeqFn.Filter
        if (!isFilter) return VType.Unknown
        const obj: AExpr | not = memberObj(callee)
        if (obj is not) return VType.Unknown
        return exprType0(ts, obj.nid)
    }

    fn typeMember(env: TEnv, e: AExpr, f: NameFact | not, obj: AExpr, ts: TypeState) -> RVT {
        const ro: RVT = typeExpr(env, obj, ts)
        return rvt(narrowRead(env, e, nameType(env, f)), ro.ts)
    }

    fn typePropValues(env: TEnv, ps: AProp[], ts0: TypeState) -> TypeState {
        let ts: TypeState = ts0
        for (const p of ps) { ts = typeExpr(env, p.value, ts).ts }
        return ts
    }

    fn typeUnary(env: TEnv, e: AExpr, o: UnOp, x: AExpr, ts: TypeState) -> RVT {
        const r: RVT = typeExpr(env, x, ts)
        // s460: `x is given` / `x is not` is a `bool` over an operand of any
        // type (§42.2.4) — the operand needs no narrowing; it is what narrows
        if (o == UnOp.IsGiven || o == UnOp.IsNot) return rvt(known(Type.Bool), r.ts)
        const isNot: boolean = o == UnOp.Not
        if (hasErrIn(env.errs, e.span)) {
            // Rule C: an operation holding a parser error is not judged
            if (isNot) return rvt(known(Type.Bool), r.ts)
            return rvt(VType.Unknown, r.ts)
        }
        if (isNot) return rvt(known(Type.Bool), checkBoolOperand(env, x, r.vt, "`!`", r.ts))
        const ts2: TypeState = checkNumOperand(env, x, r.vt, "unary `-`", r.ts)
        if (ts2.diags.length > r.ts.diags.length) return rvt(VType.Unknown, ts2)
        const xt: Type | not = knownOf(r.vt)
        if (xt is given && isNumericKind(xt)) return rvt(r.vt, ts2)
        return rvt(VType.Unknown, ts2)
    }

    // `&&` / `||`: the right operand is evaluated only when the left one is
    // true / false, so it is typed under that narrowing (`x != not && x > 0`).
    fn typeBinary(env: TEnv, e: AExpr, f: ValueFact | not, bop: BinOp, l: AExpr, r: AExpr, ts: TypeState) -> RVT {
        const rl: RVT = typeExpr(env, l, ts)
        let renv: TEnv = env
        const isAnd: boolean = bop == BinOp.And
        const isOr: boolean = bop == BinOp.Or
        if (isAnd) renv = tCallUnnarrow(tNarrow(env, condNarrowing(env, l).yes), l)   // r3 N1: what the left operand's calls write is not narrowed
        if (isOr) renv = tCallUnnarrow(tNarrow(env, condNarrowing(env, l).no), l)
        const rr: RVT = typeExpr(renv, r, rl.ts)
        const op: PrimOp | not = opOf(f)
        if (op is not) return rvt(VType.Unknown, rr.ts)
        const ts2: TypeState = checkOperands(env, e, op, l, r, rl.vt, rr.vt, rr.ts)
        // a refused operation has no type to pass on (no second report downstream)
        if (ts2.diags.length > rr.ts.diags.length) return rvt(VType.Unknown, ts2)
        return rvt(binaryType(op, rl.vt, rr.vt), ts2)
    }

    // ---- OPERATORS AND CONDITIONS (RULED S440) ----------------------------------
    // Gotcha Q1: "arithmetic and relational operators take NUMBERS only; `+`
    // takes two numbers or two strings; string ordering goes through an
    // explicit compare." Gotcha Q2: "`!`, `&&`, `||` (and `and`/`or`) take
    // booleans only; defaults use `??`." Gotcha Q3: "a `T | not` operand must
    // be narrowed before `+`, arithmetic, comparison, or use in a template."
    // Truthiness Q2: "an immediate error wherever the violation is PROVABLE,
    // silence where the type is unknown (provable-or-silent)" — still the rule
    // for every OPERAND here; superseded for CONDITIONS by S460 (checkCond).
    // dpa-054 #3: "`/`
    // between two `int`s … is a compile error naming the fix".
    // No SPEC text or code exists yet for these (SPEC pass 2 owes both), so the
    // codes are PROPOSED here and flagged: E-OPERATOR-OPERAND-TYPE (an operand
    // of a type the operator does not take), E-OPERAND-NOT-NARROWED (a `T |
    // not` operand, un-narrowed, whose `T` the operator would take),
    // E-INT-DIVISION (`/` on two `int`s), E-COND-NOT-BOOLEAN (a condition that
    // is neither a `bool` nor a `T | not` presence test).
    // `==` / `!=` are out of this rule (§45.3 E-EQ-001 is its own conformance
    // item); a `T | not` compared with `not` is how a presence test is spelled.
    fn checkOperands(env: TEnv, e: AExpr, op: PrimOp, l: AExpr, r: AExpr, a: VType, b: VType, ts: TypeState) -> TypeState {
        // Rule C (S439): nothing is checked against what failed to parse — an
        // operation whose own span holds a parser error is not judged.
        if (hasErrIn(env.errs, e.span)) return ts
        return match op {
            .Add :> checkPlus(env, e, l, r, a, b, ts)
            .Concat :> checkPlus(env, e, l, r, a, b, ts)
            .Sub :> checkNumPair(env, e, l, r, a, b, "`-`", ts)
            .Mul :> checkNumPair(env, e, l, r, a, b, "`*`", ts)
            .Mod :> checkNumPair(env, e, l, r, a, b, "`%`", ts)
            .Div :> checkDiv(env, e, l, r, a, b, ts)
            .Lt :> checkNumPair(env, e, l, r, a, b, "`<`", ts)
            .Le :> checkNumPair(env, e, l, r, a, b, "`<=`", ts)
            .Gt :> checkNumPair(env, e, l, r, a, b, "`>`", ts)
            .Ge :> checkNumPair(env, e, l, r, a, b, "`>=`", ts)
            .And :> checkBoolOperand(env, r, b, "`&&`", checkBoolOperand(env, l, a, "`&&`", ts))
            .Or :> checkBoolOperand(env, r, b, "`||`", checkBoolOperand(env, l, a, "`||`", ts))
            .EqPrim :> ts
            .NeqPrim :> ts
            .EqStruct :> ts
            .NeqStruct :> ts
            .IsSome :> ts
            .IsNot :> ts
            .Not :> ts
            .Neg :> ts
            .Length :> ts
        }
    }

    fn checkNumPair(env: TEnv, e: AExpr, l: AExpr, r: AExpr, a: VType, b: VType, what: string, ts: TypeState) -> TypeState {
        return checkNumOperand(env, r, b, what, checkNumOperand(env, l, a, what, ts))
    }

    // `/` is float-only (dpa-054 #3): two provable `int`s are refused, naming `div`.
    fn checkDiv(env: TEnv, e: AExpr, l: AExpr, r: AExpr, a: VType, b: VType, ts0: TypeState) -> TypeState {
        const ts: TypeState = checkNumPair(env, e, l, r, a, b, "`/`", ts0)
        if (ts.diags.length > ts0.diags.length) return ts
        const x: Type | not = knownOf(a)
        const y: Type | not = knownOf(b)
        if (x is given && y is given) {
            if (kindOf(unMaybe(x)) == 0 && kindOf(unMaybe(y)) == 0) {
                return report(ts, env, e.span, "E-INT-DIVISION", "`/` between two `int`s — `/` is float-only (it divides `number`s); integer division is explicit: `div(a, b, .Mode)`, the rounding mode required (dpa-054 #3, ruled S440; `int` enforced, JS-WAT 7(a)). (`div` itself is not in the bootstrap yet.)")
            }
        }
        return ts
    }

    // An arithmetic / relational operand: a number.
    fn checkNumOperand(env: TEnv, x: AExpr, v: VType, what: string, ts: TypeState) -> TypeState {
        return match v {
            .Known(t: t) :> numKnown(env, x, t, what, ts)
            .Absent :> operandType(env, x, "not", what, "numbers", ts)
            .Unknown :> ts
        }
    }

    fn numKnown(env: TEnv, x: AExpr, t: Type, what: string, ts: TypeState) -> TypeState {
        if (isNumericKind(t)) return ts
        const inner: Type | not = maybeInner(t)
        if (inner is given) {
            if (isNumericKind(inner)) return notNarrowed(env, x, t, what, ts)
        }
        return operandType(env, x, typeName(t), what, "numbers", ts)
    }

    // A `!` / `&&` / `||` operand: a bool.
    fn checkBoolOperand(env: TEnv, x: AExpr, v: VType, what: string, ts: TypeState) -> TypeState {
        return match v {
            .Known(t: t) :> boolKnown(env, x, t, what, ts)
            .Absent :> operandType(env, x, "not", what, "booleans", ts)
            .Unknown :> ts
        }
    }

    fn boolKnown(env: TEnv, x: AExpr, t: Type, what: string, ts: TypeState) -> TypeState {
        if (kindOf(t) == 3) return ts
        const inner: Type | not = maybeInner(t)
        if (inner is given) {
            if (kindOf(inner) == 3) return notNarrowed(env, x, t, what, ts)
        }
        return operandType(env, x, typeName(t), what, "booleans", ts)
    }

    // `+`: two numbers or two strings. Each operand first (a `T | not`, a
    // bool, a struct … is refused whatever the other is), then the pair.
    fn checkPlus(env: TEnv, e: AExpr, l: AExpr, r: AExpr, a: VType, b: VType, ts0: TypeState) -> TypeState {
        const ts: TypeState = plusOperand(env, r, b, plusOperand(env, l, a, ts0))
        if (ts.diags.length > ts0.diags.length) return ts
        const x0: Type | not = knownOf(a)
        const y0: Type | not = knownOf(b)
        if (x0 is not || y0 is not) return ts
        // an operand the check above let through as `T | not` (a joined local) counts as its `T`
        const x: Type = unMaybe(x0)
        const y: Type = unMaybe(y0)
        if (isNumericKind(x) && isNumericKind(y)) return ts
        if (kindOf(x) == 2 && kindOf(y) == 2) return ts
        return report(ts, env, e.span, "E-OPERATOR-OPERAND-TYPE", "`+` takes two numbers or two strings, and this is `" + typeName(x) + " + " + typeName(y) + "` — convert explicitly (ruled S440, Gotcha Q1)")
    }

    fn plusOperand(env: TEnv, x: AExpr, v: VType, ts: TypeState) -> TypeState {
        return match v {
            .Known(t: t) :> plusKnown(env, x, t, ts)
            .Absent :> operandType(env, x, "not", "`+`", "two numbers or two strings", ts)
            .Unknown :> ts
        }
    }

    fn plusKnown(env: TEnv, x: AExpr, t: Type, ts: TypeState) -> TypeState {
        if (isNumericKind(t) || kindOf(t) == 2) return ts
        const inner: Type | not = maybeInner(t)
        if (inner is given) {
            if (isNumericKind(inner) || kindOf(inner) == 2) return notNarrowed(env, x, t, "`+`", ts)
        }
        return operandType(env, x, typeName(t), "`+`", "two numbers or two strings", ts)
    }

    fn operandType(env: TEnv, x: AExpr, got: string, what: string, takes: string, ts: TypeState) -> TypeState {
        let hint: string = ""
        if (takes == "booleans") hint = " — compare explicitly (`n > 0`, `s != \"\"`, `x is given`)"
        return report(ts, env, x.span, "E-OPERATOR-OPERAND-TYPE", what + " takes " + takes + ", and this operand is `" + got + "`" + hint + " (ruled S440, Gotcha Q1 / Q2)")
    }

    // A `T | not` operand not narrowed here (the NARROWING above is flow-joined,
    // so a place is narrowed wherever it is provably present). s442 r2: the
    // earlier carve-out for an unannotated local's JOINED `T | not` is gone —
    // with flow narrowing it silenced only reads where the local may really be
    // `not` (`let a = not; if (…) { a = 5 }; a + 1`).
    fn notNarrowed(env: TEnv, x: AExpr, t: Type, what: string, ts: TypeState) -> TypeState {
        return report(ts, env, x.span, "E-OPERAND-NOT-NARROWED", what + " on a `" + typeName(t) + "` operand — it may be `not`; narrow it first (`if (x is given) { … }`, `x is given && …`) (ruled S440, Gotcha Q3)")
    }

    // A condition — `if`, `if=` / `else-if=`, `show=`, a ternary test (SPEC
    // §42.4). RULED S440 #4 = (c): "All conditions require a boolean, or a
    // `T | not` presence test, and the truthiness of numbers and strings goes";
    // Q1: "a bare `@x` of type `T | not` IS a presence test … the compiler
    // emits an absence check, never JS truthiness". RULED S460 ("a′, go"):
    // "a bare `x` whose type the compiler CANNOT resolve is an ERROR naming
    // the fixes (annotate it, or write `x is given` / `x == true`)" — which
    // supersedes S440 Truthiness Q2's provable-or-silent FOR CONDITIONS ONLY:
    // a condition is PROVABLE-OR-ERROR. Every other check here stays
    // provable-or-silent (an Unknown operand, argument, `in=` … is silent).
    fn checkCond(env: TEnv, c: AExpr, v: VType, what: string, ts: TypeState) -> TypeState {
        if (hasErrIn(env.errs, c.span)) return ts          // Rule C: not judged across a parse error
        // r5 R3: a bare conditional-handle presence test stays a presence
        // test inside a region that already narrowed it (trivially true) —
        // ruled S442, "`if=@color` is legal".
        if (isCondHandle(env, c)) return markPresence(ts, c.nid)
        return condOperands(env, c, what, condWhole(env, c, v, what, ts))
    }

    fn condWhole(env: TEnv, c: AExpr, v: VType, what: string, ts: TypeState) -> TypeState {
        return match v {
            .Known(t: t) :> condKnown(env, c, t, what, ts)
            .Absent :> markPresence(ts, c.nid)      // `not` as a condition: a presence test that is always false
            .Unknown :> condUnresolvedWhole(env, c, what, ts)
        }
    }

    // s460 N1 (PA reading of "a on F2, go": a ternary that IS the condition's
    // value is inside the condition — §42.4 statement 10). Each arm is the
    // condition's value when taken, so a ternary whose type did not resolve is
    // judged ARM BY ARM so the report lands where the cause is: an unresolved
    // or non-bool arm is blamed at the arm. STRICT-DIRECTION ONLY (PA, S460):
    // this admits nothing the whole-ternary rule refused — when no arm is
    // reported (every arm is a legal condition value on its own, e.g. a
    // `bool` arm beside a `T | not` arm, whose join did not resolve), the
    // arms' judgement is discarded and the WHOLE ternary is refused as
    // unresolved, exactly as before (statement 5, blame per statement 6).
    // A ternary whose arms joined to a known type is judged whole (condKnown).
    fn condUnresolvedWhole(env: TEnv, c: AExpr, what: string, ts0: TypeState) -> TypeState {
        const arms: AExpr[] = armsOf(c)
        if (arms.length == 0) return condUnresolved(env, c, what, ts0)
        let ts: TypeState = ts0
        for (const arm of arms) {
            ts = condWhole(env, arm, exprType0(ts, arm.nid), armWhat(what), ts)
        }
        if (ts.diags.length > ts0.diags.length) return ts
        return condUnresolved(env, c, what, ts0)
    }

    // How an arm is named: "a ternary arm of an `if` condition" — once; an arm
    // of a nested ternary is still an arm of the same condition.
    fn armWhat(what: string) -> string {
        if (what.indexOf("a ternary arm of ") == 0) return what
        return "a ternary arm of " + what
    }

    // A ternary's two arms (its test is a condition of its own); [] otherwise.
    fn armsOf(x: AExpr) -> AExpr[] {
        const k: AExprK = x.k
        return match k {
            .Ternary(test: t, yes: y, no: n) :> [y, n]
            .Unary(op: o) :> []
            .Binary(op: o) :> []
            .Name(name: n) :> []
            .At(name: n) :> []
            .AtItem :> []
            .Num(raw: r) :> []
            .Str(v: s) :> []
            .Bool(v: b) :> []
            .NotLit :> []
            .Recovered :> []
            .Variant(name: n) :> []
            .Member(obj: o) :> []
            .Call(callee: f) :> []
            .Assign(target: x2) :> []
            .ArrayLit(elems: es) :> []
            .ObjectLit(props: ps) :> []
            .Spread(e: sx) :> []
            .Index(obj: ix) :> []
            .Lambda(params: lp) :> []
            .Sql(q: q) :> []
            .Handled(h: x2) :> []
        }
    }

    // s460 F2 — RULED S460 ("a on F2, go"): "inside a condition, an operand of
    // `!` / `&&` / `||` whose type cannot be resolved is the same ERROR
    // (E-COND-NOT-BOOLEAN, unresolved message) … Operands OUTSIDE conditions
    // stay provable-or-silent (S440 Q2)" (§42.4 statement 10). The walk starts
    // at the condition and goes down through `!` / `&&` / `||` only: a nested
    // logical operator is walked, any other operand (a call, a name, a
    // comparison) is judged by the type the typer recorded for it.
    // So `!(g() && @b)` reaches `g()`; `f(!g())` does not (that `!` is an
    // argument, a value position). Parentheses are not nodes — transparent.
    // A ternary's TEST is a condition of its own (checkCond via typeTernary),
    // so it gets this walk there. s460 N1: a ternary that is the condition's
    // value, or an operand in its `!` / `&&` / `||` chain, has ARMS that are
    // that value when taken — walked like the place they stand in
    // (condUnresolvedWhole, condArmOperands). A ternary in a value position (an
    // argument, an index, an initializer) is not reached: its arms are values.
    // Statement 6 per operand: suppressed when an Error lies within THAT
    // operand (condBlamed); a logical operator the binder never resolved (a
    // refused region) stops the walk. A known non-bool / `not` operand is
    // checkBoolOperand's (E-OPERATOR-OPERAND-TYPE / E-OPERAND-NOT-NARROWED).
    fn condOperands(env: TEnv, c: AExpr, what: string, ts: TypeState) -> TypeState {
        const k: AExprK = c.k
        return match k {
            .Unary(op: o, e: x) :> condNotOperand(env, c, o, x, what, ts)
            .Binary(op: o, l: l, r: r) :> condLogicOperands(env, c, o, l, r, what, ts)
            .Name(name: n) :> ts
            .At(name: n) :> ts
            .AtItem :> ts
            .Num(raw: r) :> ts
            .Str(v: s) :> ts
            .Bool(v: b) :> ts
            .NotLit :> ts
            .Recovered :> ts
            .Variant(name: n) :> ts
            .Member(obj: o) :> ts
            .Call(callee: f) :> ts
            .Ternary(test: x, yes: y, no: n) :> condOperands(env, n, armWhat(what), condOperands(env, y, armWhat(what), ts))
            .Assign(target: x) :> ts
            .ArrayLit(elems: es) :> ts
            .ObjectLit(props: ps) :> ts
            .Spread(e: sx) :> ts
            .Index(obj: ix) :> ts
            .Lambda(params: lp) :> ts
            .Sql(q: q) :> ts
            .Handled(h: x) :> ts
        }
    }

    fn condNotOperand(env: TEnv, c: AExpr, o: UnOp, x: AExpr, what: string, ts: TypeState) -> TypeState {
        if (o != UnOp.Not) return ts
        if (refusedRead(env, c)) return ts
        return condOperand(env, x, "`!`", what, ts)
    }

    fn condLogicOperands(env: TEnv, c: AExpr, o: BinOp, l: AExpr, r: AExpr, what: string, ts: TypeState) -> TypeState {
        let opName: string = ""
        if (o == BinOp.And) opName = "`&&`"
        if (o == BinOp.Or) opName = "`||`"
        if (opName == "") return ts
        if (refusedRead(env, c)) return ts
        return condOperand(env, r, opName, what, condOperand(env, l, opName, what, ts))
    }

    // One operand: a nested `!` / `&&` / `||` is walked; anything else is
    // judged — an unresolved one is E-COND-NOT-BOOLEAN unless blamed.
    fn condOperand(env: TEnv, x: AExpr, opName: string, what: string, ts: TypeState) -> TypeState {
        if (isLogical(x)) return condOperands(env, x, what, ts)
        const arms: AExpr[] = armsOf(x)
        if (arms.length > 0) return condArmOperands(env, x, arms, opName, what, ts)
        if (!unresolvedVT(exprType0(ts, x.nid))) return ts
        return condOperandUnresolved(env, x, opName, what, ts)
    }

    fn condOperandUnresolved(env: TEnv, x: AExpr, opName: string, what: string, ts: TypeState) -> TypeState {
        if (condBlamed(env, x, ts)) return ts
        return report(ts, env, x.span, "E-COND-NOT-BOOLEAN", "this operand of " + opName + " in " + what + " is a value whose type the compiler cannot resolve, and `!` / `&&` / `||` in a condition take a `bool` — annotate it (a parameter or return type), or say what you test: `x is given` (is it present?) or `x == true` (is it true?) (ruled S460, \"a on F2, go\")")
    }

    // s460 N1 — a ternary operand of a condition's `!` / `&&` / `||`: each arm
    // is the operand when taken, so each is judged as an operand (walked if
    // logical, blamed if unresolved). When the ternary's own type did not
    // resolve, the typer's bool check on it was silent, so each RESOLVED arm
    // gets that check here (checkBoolOperand); a resolved ternary was already
    // checked whole.
    fn condArmOperands(env: TEnv, x: AExpr, arms: AExpr[], opName: string, what: string, ts0: TypeState) -> TypeState {
        const whole: boolean = unresolvedVT(exprType0(ts0, x.nid))
        let ts: TypeState = ts0
        for (const arm of arms) {
            ts = condOperand(env, arm, opName, armWhat(what), ts)
            if (whole) ts = checkBoolOperand(env, arm, exprType0(ts, arm.nid), opName, ts)
        }
        // strict-direction only: an unresolved ternary operand none of whose
        // arms was reported is refused whole, as before
        if (!whole || ts.diags.length > ts0.diags.length) return ts
        return condOperandUnresolved(env, x, opName, what, ts0)
    }

    fn unresolvedVT(v: VType) -> boolean {
        return match v {
            .Known(t: x) :> false
            .Absent :> false
            .Unknown :> true
        }
    }

    fn isLogical(x: AExpr) -> boolean {
        const k: AExprK = x.k
        return match k {
            .Unary(op: o) :> o == UnOp.Not
            .Binary(op: o) :> o == BinOp.And || o == BinOp.Or
            .Name(name: n) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Num(raw: r) :> false
            .Str(v: s) :> false
            .Bool(v: b) :> false
            .NotLit :> false
            .Recovered :> false
            .Variant(name: n) :> false
            .Member(obj: o) :> false
            .Call(callee: f) :> false
            .Ternary(test: x2) :> false
            .Assign(target: x2) :> false
            .ArrayLit(elems: es) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: sx) :> false
            .Index(obj: ix) :> false
            .Lambda(params: lp) :> false
            .Sql(q: q) :> false
            .Handled(h: x2) :> false
        }
    }

    // s460 — a condition whose type did not resolve is E-COND-NOT-BOOLEAN
    // (§42.4 statement 5), unless an error already reported explains it
    // (statement 6: no second report — see Blame).
    fn condUnresolved(env: TEnv, c: AExpr, what: string, ts: TypeState) -> TypeState {
        if (condBlamed(env, c, ts)) return ts
        return report(ts, env, c.span, "E-COND-NOT-BOOLEAN", what + " is a value whose type the compiler cannot resolve, and a condition must be a `bool` or a `T | not` presence test — annotate it (a parameter or return type), or say what you test: `x is given` (is it present?) or `x == true` (is it true?) (ruled S460, \"a′, go\")")
    }

    // Is condition `c`'s unresolved type already accounted for? An Error the
    // typer (a refused operator, E-CALL-ARITY …) or an earlier pass (an
    // undeclared name, a refused construct) reported inside it; or a read of
    // a local / field whose written type was refused, or a call of a function
    // whose written return type was refused.
    fn condBlamed(env: TEnv, c: AExpr, ts: TypeState) -> boolean {
        if (hasErrIn(env.blame.spans, c.span)) return true
        for (const d of ts.diags) {
            if (d.file == env.file && d.severity == Severity.Error && d.span.start >= c.span.start && d.span.end <= c.span.end) return true
        }
        return refusedRead(env, c)
    }

    fn refusedRead(env: TEnv, c: AExpr) -> boolean {
        const k: AExprK = c.k
        return match k {
            .Name(name: n) :> refusedName(env, nameFact(env.t.names, c.nid))
            .At(name: n) :> refusedName(env, nameFact(env.t.names, c.nid))
            .Member(obj: o) :> refusedName(env, nameFact(env.t.names, c.nid)) || refusedRead(env, o)
            .Call(callee: f) :> refusedCallee(env, calleeFn(nameFact(env.t.names, f.nid))) || unboundCall(env, c, f)
            .AtItem :> false
            .Num(raw: r) :> false
            .Str(v: s) :> false
            .Bool(v: b) :> false
            .NotLit :> false
            .Recovered :> true
            .Variant(name: n) :> false
            // an operator the binder never resolved (it stands in a region the
            // binder refused or skipped) — its Unknown is not a type left open
            .Unary(op: o) :> opOf(valueFact(env.t.values, c.nid)) is not
            .Binary(op: o) :> opOf(valueFact(env.t.values, c.nid)) is not
            .Ternary(test: x) :> false
            .Assign(target: x) :> false
            .ArrayLit(elems: es) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: sx) :> false
            .Index(obj: ix) :> false
            .Lambda(params: lp) :> false
            .Sql(q: q) :> false
            .Handled(h: x) :> false
        }
    }

    // A call the binder never resolved: its callee names nothing it bound and
    // it is no built-in (undeclared — the scope rules report it — or inside a
    // region the binder skipped).
    fn unboundCall(env: TEnv, c: AExpr, callee: AExpr) -> boolean {
        if (nameFact(env.t.names, callee.nid) is given) return false
        return valueFact(env.t.values, c.nid) is not
    }

    fn refusedName(env: TEnv, f: NameFact | not) -> boolean {
        return match f {
            .NLocal(sym: s) :> env.blame.syms.indexOf(s.id) >= 0
            .NField(decl: d, inst: i, idx: x) :> refusedDeclField(env.t, d, x)
            .NStruct(owner: o, idx: x) :> refusedStructField(env.t, o, x)
            .NInst(decl: d) :> false
            .NFn(sym: s) :> false
            .NLength :> false
            .NSurface(of: x) :> false
            // a name the binder did not resolve: undeclared (reported by the
            // scope rules) or inside a construct already refused (`if=` on a
            // `<db>`, E-BOOTSTRAP-UNSUPPORTED) — not a type left unresolved
            not :> true
        }
    }

    fn refusedCallee(env: TEnv, s: Sym | not) -> boolean {
        if (s is not) return false
        return env.blame.fns.indexOf(s.id) >= 0
    }

    // A declaration field whose WRITTEN type was refused (FieldInfo.trusted, r8).
    fn refusedDeclField(t: Tables, d: Sym, idx: int) -> boolean {
        const di: DeclInfo | not = declInfo(t, d)
        if (di is not) return false
        if (idx < 0 || idx >= di.fields.length) return false
        return di.fields[idx].annotated && !di.fields[idx].trusted
    }

    // A struct field whose type did not resolve (Unresolved.fields, r8).
    fn refusedStructField(t: Tables, owner: Sym, idx: int) -> boolean {
        const ti: TypeInfo | not = typeInfoOf(t.types, owner)
        if (ti is not) return false
        const fs: FieldDef[] | not = structFieldDefs(ti.def)
        if (fs is not) return false
        if (idx < 0 || idx >= fs.length) return false
        return t.unresolved.fields.indexOf(fs[idx].sym.id) >= 0
    }

    fn condKnown(env: TEnv, c: AExpr, t: Type, what: string, ts: TypeState) -> TypeState {
        if (kindOf(t) == 3) return ts
        const inner: Type | not = maybeInner(t)
        if (inner is given) {
            // RULED S442 (six typer questions): "a bare `bool | not` in a
            // condition is an ERROR naming both fixes (`@f is some` / `@f ==
            // true`) — the same spelling otherwise flips meaning inside vs
            // outside a narrowing". (A NARROWED `bool | not` reads as `bool`
            // and stays a value test.)
            if (kindOf(inner) == 3) {
                return report(ts, env, c.span, "E-COND-NOT-BOOLEAN", what + " is a bare `bool | not` — ambiguous: say `x is given` (is it present?) or `x == true` (is it true?) (ruled S442)")
            }
            return markPresence(ts, c.nid)
        }
        return report(ts, env, c.span, "E-COND-NOT-BOOLEAN", what + " needs a `bool` (or a `T | not` presence test), and this value is `" + typeName(t) + "` — a condition has no truthiness; compare explicitly (`n > 0`, `s != \"\"`, `xs.length > 0`) (ruled S440 #4 = (c))")
    }
    // `&&` / `||` take booleans only (RULED S440, Gotcha Q2 — superseding
    // §45.9's "JS semantics", where they yield an operand): a legal `&&` / `||`
    // is a `bool`, whatever the typer could prove of its operands.
    fn binaryType(op: PrimOp, a: VType, b: VType) -> VType {
        return match op {
            .EqPrim :> known(Type.Bool)
            .NeqPrim :> known(Type.Bool)
            .EqStruct :> known(Type.Bool)
            .NeqStruct :> known(Type.Bool)
            .Lt :> known(Type.Bool)
            .Le :> known(Type.Bool)
            .Gt :> known(Type.Bool)
            .Ge :> known(Type.Bool)
            .IsSome :> known(Type.Bool)
            .IsNot :> known(Type.Bool)
            .Not :> known(Type.Bool)
            .And :> known(Type.Bool)
            .Or :> known(Type.Bool)
            .Concat :> known(Type.Str)
            .Add :> numJoin(a, b)
            .Sub :> numJoin(a, b)
            .Mul :> numJoin(a, b)
            .Mod :> numJoin(a, b)
            .Div :> divType(a, b)
            .Neg :> numJoin(a, a)
            .Length :> known(Type.Int)
        }
    }


    fn divType(a: VType, b: VType) -> VType {
        const j: VType = numJoin(a, b)
        if (knownOf(j) is given) return known(Type.Num)
        return VType.Unknown
    }

    // The test is a condition (checkCond); each arm is typed under its narrowing.
    fn typeTernary(env: TEnv, test: AExpr, yes: AExpr, no: AExpr, ts: TypeState) -> RVT {
        const rt: RVT = typeExpr(env, test, ts)
        const n: Narrowing = condNarrowing(env, test)
        const ry: RVT = typeExpr(tCallUnnarrow(tNarrow(env, n.yes), test), yes, checkCond(env, test, rt.vt, "a ternary test", rt.ts))
        const rn: RVT = typeExpr(tCallUnnarrow(tNarrow(env, n.no), test), no, ry.ts)
        return rvt(joinVT(ry.vt, rn.vt), rn.ts)
    }

    fn typeArray(env: TEnv, es: AExpr[], ts0: TypeState) -> RVT {
        let ts: TypeState = ts0
        let elem: VType = VType.Unknown
        let first = true
        for (const e of es) {
            const r: RVT = typeExpr(env, e, ts)
            ts = r.ts
            if (first) {
                elem = r.vt
            } else {
                elem = joinVT(elem, r.vt)
            }
            first = false
        }
        const et: Type | not = knownOf(elem)
        if (et is given) return rvt(known(Type.Seq(et, anySeqGrants())), ts)
        return rvt(VType.Unknown, ts)
    }

    // A call of a named function: its arity against the declaration, and its
    // value is the declared return type.
    // CALL ARITY — RULED S440 (#2 = PA rec: "make extra arguments an error
    // now, and write the callback case down as the one reason that would
    // reopen it"; "too few arguments is an error unless the parameter has a
    // default (§7.3.2)"); SPEC §7.3: "A call that passes MORE arguments than
    // the function declares parameters is a compile error, `E-CALL-ARITY`. A
    // call that passes FEWER is a compile error too, unless each omitted
    // parameter has a default (§7.3.2)." The slice front end parses no
    // default, rest (`...xs`) or `?`-optional parameter: a signature holding
    // one does not parse cleanly, its `arity` is -1, and no call of it is
    // checked (the SPEC's PA reading — rest absorbs extras, `?` counts as
    // defaulted — is honoured by never guessing). Checked only when the
    // callee resolves statically to a function (provable-or-silent).
    fn typeCall(env: TEnv, e: AExpr, callee: AExpr, args: AExpr[], ts0: TypeState) -> RVT {
        let ts: TypeState = typeExprs(env, args, ts0)
        ts = typePlace(env, callee, VType.Unknown, ts)
        const s: Sym | not = calleeFn(nameFact(env.t.names, callee.nid))
        if (s is not) return rvt(builtinCallType(env, e, callee, ts), ts)
        const fi: FnInfo | not = fnInfoOf(env.t, s)
        if (fi is not) return rvt(VType.Unknown, ts)
        const n: int = fi.arity
        if (n >= 0 && n != args.length) {
            ts = report(ts, env, e.span, "E-CALL-ARITY", arityMessage(fi.name, n, args.length))
        }
        // guard (ii), r7 A: a callee whose name is declared in more than one
        // file is mis-linked by the one-namespace bootstrap (already refused,
        // E-BOOTSTRAP-UNSUPPORTED) — untrusted: no argument check, no return type
        if (inManyFiles(env.t, fi.name)) return rvt(VType.Unknown, ts)
        if (n >= 0 && n == args.length) ts = checkArgs(env, fi.name, args, ts)
        const ret: Type | not = fi.ret
        if (ret is given) return rvt(known(ret), ts)
        return rvt(VType.Unknown, ts)
    }

    // Is a function name declared in more than one file (guard (ii))?
    fn inManyFiles(t: Tables, name: string) -> boolean {
        let first: string = ""
        for (const f of t.fns) {
            if (f.name == name) {
                if (first == "") {
                    first = f.file
                } else if (f.file != first) {
                    return true
                }
            }
        }
        return false
    }

    // ---- `int` ENFORCEMENT AT EVERY §7.5.1 POSITION (r4 (c)) -------------------
    // RULED S442: "`int` enforcement reaches every §7.5.1 position (returns,
    // arguments, all initializers); `1e3` / `2.0` into `int` stay errors (float
    // literals)". Only an `int`-BEARING target (`int`, `int | not`, a sequence
    // of them) is checked at a return / an argument / a non-literal
    // initializer — the ruling widens `int`, not those positions in general
    // (§7.5.1 positions 3-5 stay unchecked for every other type).
    fn hasInt(t: Type) -> boolean {
        if (kindOf(t) == 0) return true
        const i: Type | not = maybeInner(t)
        if (i is given) return hasInt(i)
        const el: Type | not = seqElem(t)
        if (el is given) return hasInt(el)
        return false
    }

    fn paramNids(ps: AParam[]) -> int[] {
        let out: int[] = []
        for (const p of ps) { out = out.concat([p.nid]) }
        return out
    }

    // Each argument against its parameter (§7.5.1 position 3; every type since r7 A — pa-ruled widening, measured-zero corpus).
    fn checkArgs(env: TEnv, name: string, args: AExpr[], ts0: TypeState) -> TypeState {
        let ts: TypeState = ts0
        let pnids: int[] = []
        for (const w of env.fnw) {
            if (w.name == name) pnids = w.params
        }
        if (pnids.length != args.length) return ts
        let i = 0
        while (i < args.length) {
            let pt: Type | not = knownOf(paramType(bindFact(env.t.binds, pnids[i])))
            if (env.t.unresolved.params.indexOf(pnids[i]) >= 0) pt = not      // r8: an unresolved parameter type
            if (pt is given) {
                const what: string = "argument " + (i + 1) + " of `" + name + "`"
                // r7 A: full assignability for EVERY parameter type (§7.5.1 position 3)
                ts = checkValue(env, exprType0(ts, args[i].nid), pt, args[i].span, what, ts)
                ts = checkNotElems(env, args[i], pt, ts)
            }
            i = i + 1
        }
        return ts
    }

    // `return v` against the declared `-> T` (§7.5.1 position 4; every type since r7 A — pa-ruled widening, measured-zero corpus).
    fn typeReturn(env: TEnv, e: AExpr | not, ts0: TypeState) -> TypeState {
        const ts: TypeState = typeMaybeExpr(env, e, ts0)
        if (e is not) return ts
        const rt: Type | not = env.fret
        if (rt is not) return ts
        const ts1: TypeState = checkNotElems(env, e, rt, ts)
        // r7 A: full assignability for EVERY return type (§7.5.1 position 4)
        return checkValue(env, exprType0(ts1, e.nid), rt, e.span, "the return value", ts1)
    }

    // A non-literal initializer into an `int`-bearing annotation (a literal is
    // checkInit's; checking it here too would report it twice).
    // The struct literals inside an attribute-valued initializer, field by
    // field (as a write's and an annotated local's are — spelling-independent).
    fn checkAttrLitFields(env: TEnv, v: AAttrValue, target: Type, ts: TypeState) -> TypeState {
        const x: AExpr | not = valueExpr(v)
        if (x is not) return ts
        return checkNotElems(env, x, target, checkLitFields(env, x, ts))
    }

    // r6: at a position checked for `int` only (a return, an argument, a
    // non-literal initializer), a target of any OTHER type is checked for the
    // `T | not` rule alone — "`T | not` into `T` is an error for all types"
    // (ruled S442) decides that question in every position that takes a `T`;
    // no ruling widens those positions for other type mismatches.
    fn checkMaybeNot(env: TEnv, v: VType, target: Type, span: ASpan, what: string, ts: TypeState) -> TypeState {
        // r7 C: the `not` literal itself into a non-optional target — the
        // same failure, reported with the code every other position already
        // uses for it (E-TYPE-041, §42.3.1)
        if (isAbsentVT(v)) return checkAbsent(env, target, span, what, ts)
        const x: Type | not = knownOf(v)
        if (x is not) return ts
        if (!mayBeNot(x, target)) return ts
        return checkKnown(env, x, target, span, what, ts)
    }

    // r7 C: `not` ELEMENTS of an array literal into a sequence whose element
    // type is non-optional (`[not]` into `string[]`). Only when the array's
    // own type is unproven (all elements `not` / unknown) — a typed array
    // (`[1, not]`: `(int | not)[]`) is mayBeNot's, reported once there.
    fn checkNotElems(env: TEnv, e: AExpr, target: Type, ts: TypeState) -> TypeState {
        const es: AExpr[] = arrayElems(e)
        if (es.length == 0) return ts
        if (knownOf(exprType0(ts, e.nid)) is given) return ts
        const te: Type | not = seqElem(unMaybe(target))
        if (te is not) return ts
        let out: TypeState = ts
        for (const x of es) {
            if (isNotLit(x)) {
                out = checkAbsent(env, te, x.span, "an element of `" + typeName(target) + "`", out)
            } else {
                out = checkNotElems(env, x, te, out)
            }
        }
        return out
    }

    fn arrayElems(e: AExpr) -> AExpr[] {
        const k: AExprK = e.k
        return match k {
            .ArrayLit(elems: es) :> es
            .Name(name: n) :> []
            .At(name: n) :> []
            .AtItem :> []
            .Num(raw: r) :> []
            .Str(v: s) :> []
            .Bool(v: b) :> []
            .NotLit :> []
            .Recovered :> []
            .Variant(name: n) :> []
            .Member(obj: o) :> []
            .Call(callee: c) :> []
            .Unary(op: o) :> []
            .Binary(op: o) :> []
            .Ternary(test: x) :> []
            .Assign(target: x) :> []
            .ObjectLit(props: ps) :> []
            .Spread(e: sx) :> []
            .Index(obj: ix) :> []
            .Lambda(params: lp) :> []
            .Sql(q: q) :> []
            .Handled(h: x) :> []
        }
    }

    fn checkIntInit(env: TEnv, target: Type, lk: int, v: VType, span: ASpan, what: string, ts: TypeState) -> TypeState {
        if (lk >= 0) return ts
        if (!hasInt(target)) return checkMaybeNot(env, v, target, span, what, ts)
        return checkValue(env, v, target, span, what, ts)
    }

    fn arityMessage(name: string, n: int, got: int) -> string {
        if (got > n) return "`" + name + "` takes " + n + " argument(s) and is called with " + got + " — an extra argument is an error (§7.3, E-CALL-ARITY; ruled S440 #2)"
        return "`" + name + "` takes " + n + " argument(s) and is called with " + got + " — a missing argument is an error unless its parameter has a default (§7.3, §7.3.2; ruled S440 #2)"
    }

    fn fnInfoOf(t: Tables, s: Sym) -> FnInfo | not {
        for (const f of t.fns) {
            if (f.sym.id == s.id) return f
        }
        return not
    }

    // ---- statements ------------------------------------------------------------
    fn typeBlock(env: TEnv, b: ABlock, ts0: TypeState) -> TypeState {
        return typeBlockEnv(env, b, ts0).ts
    }

    // A block, and the env its last statement leaves (its narrowing is what
    // an enclosing `if` / `given` joins, s442 r2 F1 / F3).
    fn typeBlockEnv(env: TEnv, b: ABlock, ts0: TypeState) -> RTEnv {
        let ts: TypeState = ts0
        let env2: TEnv = env
        for (const s of b.stmts) {
            const r: RTEnv = typeStmt(env2, s, ts)
            env2 = r.env
            ts = r.ts
        }
        return { env: env2, ts: ts }
    }

    fn keepTEnv(env: TEnv, ts: TypeState) -> RTEnv { return { env: env, ts: ts } }

    // s451 (Ue) — a handling form: its subject, then each arm with its
    // binders typed by the payload field each takes (the binder's FArm /
    // FHandled facts). `?` and `!{}` yield the subject's success type (a `!`
    // signature has no success-type slot, §19.4.1, so it is Unknown unless
    // inference knows it); a `match` yields Unknown (its arms' join is not
    // computed — no check fires on Unknown).
    fn typeHandled(env: TEnv, e: AExpr, h: AHandled, ts0: TypeState) -> RVT {
        const rs: RVT = typeExpr(env, h.subject, ts0)
        let ts: TypeState = rs.ts
        const err: Sym | not = handledErr(failFact(env.t.fails, e.nid))
        for (const a of handledArms(h)) {
            let aenv: TEnv = env
            const fs: FieldDef[] = armFields(env.t, err, failFact(env.t.fails, a.nid))
            const p: APat = a.pat
            // s452: a whole-error arm's binder is the whole error enum (§18.6.1)
            const whole: boolean = armIdx(failFact(env.t.fails, a.nid)) == -4
            let i = 0
            for (const b of patBindsOf(p)) {
                const bs: Sym | not = bindSym(bindFact(env.t.binds, b.nid))
                let vt: VType = VType.Unknown
                if (i < fs.length && env.t.unresolved.fields.indexOf(fs[i].sym.id) < 0) vt = known(fs[i].ty)
                if (whole && err is given) vt = known(Type.Named(err))
                if (bs is given) aenv = tWithLocal(aenv, bs, vt)
                i = i + 1
            }
            const body: AArmBody = a.body
            for (const x of armExprOf(body)) {
                if (assignValue(x) is given) {
                    ts = typeStmtExpr(aenv, x, ts)
                } else {
                    ts = typeExpr(aenv, x, ts).ts
                }
            }
            for (const b2 of armBlockOf(body)) { ts = typeBlock(aenv, b2, ts) }
        }
        const how: AHow = h.how
        if (how == AHow.Propagate) return rvt(rs.vt, ts)
        return rvt(VType.Unknown, ts)
    }

    fn handledErr(f: FailFact | not) -> Sym | not {
        return match f {
            .FHandled(h: h) :> h.err
            .FArm(idx: x) :> not
            .FFail(err: x) :> not
            not :> not
        }
    }

    // The payload fields an arm's binders take (none for `.Ok` / `_`).
    fn armFields(t: Tables, err: Sym | not, f: FailFact | not) -> FieldDef[] {
        if (err is not) return []
        const idx: int = armIdx(f)
        if (idx < 0) return []
        const ti: TypeInfo | not = typeInfoOf(t.types, err)
        if (ti is not) return []
        const vs: VariantDef[] = enumVariants(ti.def)
        if (idx >= vs.length) return []
        return vs[idx].fields
    }

    fn armIdx(f: FailFact | not) -> int {
        return match f {
            .FArm(idx: i) :> i
            .FHandled(h: x) :> -3
            .FFail(err: x) :> -3
            not :> -3
        }
    }

    fn patBindsOf(p: APat) -> ABind[] {
        return match p {
            .PName(binds: bs) :> bs
            .PWild :> []
            .PWhole(bind: b) :> [b]
            .PBare(bind: b) :> [b]
        }
    }

    // s451 (Ue) — `fail E.V(args)`: each payload value against its field's
    // type (§19.3.3: the `fail` is "a variant CONSTRUCTION", typed as one).
    fn typeFail(env: TEnv, s: AStmt, f: AFail, ts0: TypeState) -> TypeState {
        let ts: TypeState = typeExprList(env, failExprs(f), ts0)
        const ff: FailFact | not = failFact(env.t.fails, s.nid)
        const fs: FieldDef[] = failFields(env.t, ff)
        let i = 0
        for (const a of f.args) {
            if (i < fs.length && env.t.unresolved.fields.indexOf(fs[i].sym.id) < 0) {
                ts = checkValue(env, exprType0(ts, a.nid), fs[i].ty, a.span, "payload value " + (i + 1) + " of this `fail`", ts)
            }
            i = i + 1
        }
        return ts
    }

    fn failFields(t: Tables, f: FailFact | not) -> FieldDef[] {
        return match f {
            .FFail(err: e, idx: i) :> armFields(t, e, FailFact.FArm(i))
            .FHandled(h: x) :> []
            .FArm(idx: x) :> []
            not :> []
        }
    }

    // Each statement's continuation env: the narrowing a statement's CALLS
    // may undo (a callee that writes the place, r2 F1) is dropped, and an
    // `if` / `given` leaves the JOIN of its paths (r2 F1 / F3).
    fn typeStmt(env: TEnv, s: AStmt, ts: TypeState) -> RTEnv {
        const k: AStmtK = s.k
        return match k {
            .Eval(e: e) :> typeEvalStmt(env, e, ts)
            .Local(name: n, init: i) :> typeLocal(tCallUnnarrow(env, i), s, n, i, ts)
            .Return(e: e) :> keepTEnv(env, typeReturn(env, e, ts))
            .If(cond: c, thenB: tb, elseB: el) :> typeIf(env, c, tb, el, ts)
            .Given(name: n, subject: sub, body: b) :> typeGiven(env, s, sub, b, ts)
            .EffectStmt(w: w) :> keepTEnv(env, ts)     // refused by the binder (E-LIFECYCLE-016 / E-BOOTSTRAP-UNSUPPORTED)
            .Defer(body: b) :> keepTEnv(env, typeBlock(tDeferEnv(env), b, ts))   // s451: typed at its exit, not where it stands
            .Fail(f: f) :> keepTEnv(env, typeFail(env, s, f, ts))               // s451 (Ue)
        }
    }

    // `p = v`: drops the narrowing of `p` (and under it) — and, when `v` is
    // PROVABLY present (a known type, not `T | not`), narrows `p` (r2 F3).
    fn typeEvalStmt(env: TEnv, e: AExpr, ts0: TypeState) -> RTEnv {
        const ts: TypeState = typeStmtExpr(env, e, ts0)
        const key: string = writtenKey(env, e)
        const out: TEnv = tUnnarrow(tCallUnnarrow(env, e), key)
        if (key != "" && writesPresent(e, ts)) return keepTEnv(tNarrow(out, [key]), ts)
        return keepTEnv(out, ts)
    }

    fn writesPresent(e: AExpr, ts: TypeState) -> boolean {
        const v: AExpr | not = assignValue(e)
        if (v is not) return false
        const x: Type | not = knownOf(exprType0(ts, v.nid))
        if (x is not) return false
        return maybeInner(x) is not
    }

    fn assignValue(e: AExpr) -> AExpr | not {
        const k: AExprK = e.k
        return match k {
            .Assign(target: t, value: v) :> v
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: s) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: x) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: sx) :> not
            .Index(obj: ix) :> not
            .Lambda(params: lp) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
        }
    }

    // A statement `p = v` / `reset(p)` writes place `p`.
    fn writtenKey(env: TEnv, e: AExpr) -> string {
        const k: AExprK = e.k
        return match k {
            .Assign(target: t) :> assignKey(env, e, t)
            .Name(name: n) :> ""
            .At(name: n) :> ""
            .AtItem :> ""
            .Num(raw: r) :> ""
            .Str(v: s) :> ""
            .Bool(v: b) :> ""
            .NotLit :> ""
            .Recovered :> ""
            .Variant(name: n) :> ""
            .Member(obj: o) :> ""
            .Call(callee: c, args: a) :> resetKey(env, c, a)
            .Unary(op: o) :> ""
            .Binary(op: o) :> ""
            .Ternary(test: x) :> ""
            .ArrayLit(elems: es) :> ""
            .ObjectLit(props: ps) :> ""
            .Spread(e: sx) :> ""
            .Index(obj: ix) :> ""
            .Lambda(params: lp) :> ""
            .Sql(q: q) :> ""
            .Handled(h: x) :> ""
        }
    }

    // A bare local target `a = v` carries no name fact (the binder records the
    // rebinding as an effect of the statement): its key is the effect's local.
    fn assignKey(env: TEnv, e: AExpr, t: AExpr) -> string {
        if (exprName(t) != "") {
            const s: Sym | not = assignedLocal(effectFact(env.t.effects, e.nid))
            if (s is given) return "#" + s.id
            return ""
        }
        return nKey(env, t)
    }

    fn resetKey(env: TEnv, c: AExpr, a: AExpr[]) -> string {
        if (exprName(c) == "reset" && a.length == 1) return nKey(env, a[0])
        return ""
    }

    // The narrowing an `if` leaves: the INTERSECTION of what each path leaves
    // (a path that always `return`s leaves nothing to join — the other path's
    // narrowing holds, e.g. after `if (x == not) { return }`). The env's own
    // locals and settled types stay the enclosing block's.
    fn joinPaths(env: TEnv, a: TEnv, aExits: boolean, b: TEnv, bExits: boolean) -> TEnv {
        if (aExits && !bExits) return withNarrowed(env, b.narrowed)
        if (bExits && !aExits) return withNarrowed(env, a.narrowed)
        if (aExits && bExits) return env
        let both: string[] = []
        for (const k of a.narrowed) {
            if (b.narrowed.indexOf(k) >= 0) both = both.concat([k])
        }
        return withNarrowed(env, both)
    }

    fn withNarrowed(env: TEnv, keys: string[]) -> TEnv {
        return { t: env.t, file: env.file, errs: env.errs, locals: env.locals, settled: env.settled, narrowed: keys,
                 fnw: env.fnw, rows: env.rows, fret: env.fret, blame: env.blame }
    }

    fn typeMaybeExpr(env: TEnv, e: AExpr | not, ts: TypeState) -> TypeState {
        if (e is not) return ts
        return typeExpr(env, e, ts).ts
    }

    // `let a[: T] = init`: an annotated local IS its annotation; an
    // unannotated one contributes its initializer to its joined type.
    // §7.5.1 position 1: an ANNOTATED local's literal initializer is checked
    // against its annotation (`number` / `string` / `boolean`; `not` into a
    // non-optional type is E-TYPE-041, §42.3.1), and every struct literal in
    // it field by field (§66.1 rule 5's rule, spelling-independent).
    fn typeLocal(env: TEnv, s: AStmt, name: string, init: AExpr, ts: TypeState) -> RTEnv {
        const r: RVT = typeExpr(env, init, ts)
        const sym: Sym | not = bindSym(bindFact(env.t.binds, s.nid))
        if (sym is not) return keepTEnv(env, r.ts)
        const annot: Type | not = annotOf(env.t, sym)
        if (annot is given) {
            let ts2: TypeState = checkInit(env, annot, literalKind(init), init.span, "`" + name + "`", r.ts)
            ts2 = checkIntInit(env, annot, literalKind(init), r.vt, init.span, "`" + name + "`", ts2)
            ts2 = checkNotElems(env, init, annot, checkLitFields(env, init, ts2))
            return keepTEnv(tWithLocal(env, sym, known(annot)), ts2)
        }
        return keepTEnv(tWithLocal(env, sym, r.vt), contribute(r.ts, sym, r.vt))
    }

    // The condition is checked (checkCond, ruled S440 #4 = (c)); each branch
    // is typed under the condition's narrowing (less what the condition's own
    // calls may undo); the statement leaves the join of both paths.
    fn typeIf(env: TEnv, c: AExpr, tb: ABlock, el: ABlock | not, ts0: TypeState) -> RTEnv {
        const rc: RVT = typeExpr(env, c, ts0)
        let ts: TypeState = checkCond(env, c, rc.vt, "an `if` condition", rc.ts)
        const n: Narrowing = condNarrowing(env, c)
        const rt: RTEnv = typeBlockEnv(tCallUnnarrow(tNarrow(env, n.yes), c), tb, ts)
        const noEnv: TEnv = tCallUnnarrow(tNarrow(env, n.no), c)
        if (el is not) return keepTEnv(joinPaths(env, rt.env, exits(tb), noEnv, false), rt.ts)
        const re: RTEnv = typeBlockEnv(noEnv, el, rt.ts)
        return keepTEnv(joinPaths(env, rt.env, exits(tb), re.env, exits(el)), re.ts)
    }

    // The body may not run: what it leaves is joined with the path around it.
    fn typeGiven(env: TEnv, s: AStmt, subject: AExpr, body: ABlock, ts: TypeState) -> RTEnv {
        const r: RVT = typeExpr(env, subject, ts)
        const sym: Sym | not = bindSym(bindFact(env.t.binds, s.nid))
        const around: TEnv = tCallUnnarrow(env, subject)
        let inner: TEnv = around
        if (sym is given) inner = tWithLocal(around, sym, r.vt)
        const rb: RTEnv = typeBlockEnv(inner, body, r.ts)
        return keepTEnv(joinPaths(env, rb.env, false, around, false), rb.ts)
    }

    // A statement-position expression: a write is checked against the
    // classified target (the binder's WriteFact), per override for a spread.
    fn typeStmtExpr(env: TEnv, e: AExpr, ts: TypeState) -> TypeState {
        const k: AExprK = e.k
        return match k {
            .Assign(target: x, value: v) :> typeAssign(env, e, x, v, ts)
            .Call(callee: c, args: args) :> typeCallStmt(env, e, c, args, ts)
            .Name(name: n) :> typeExpr(env, e, ts).ts
            .At(name: n) :> typeExpr(env, e, ts).ts
            .AtItem :> typeExpr(env, e, ts).ts
            .Num(raw: r) :> typeExpr(env, e, ts).ts
            .Str(v: s) :> typeExpr(env, e, ts).ts
            .Bool(v: b) :> typeExpr(env, e, ts).ts
            .NotLit :> typeExpr(env, e, ts).ts
            .Recovered :> typeExpr(env, e, ts).ts
            .Variant(name: n) :> typeExpr(env, e, ts).ts
            .Member(obj: o) :> typeExpr(env, e, ts).ts
            .Unary(op: o) :> typeExpr(env, e, ts).ts
            .Binary(op: o) :> typeExpr(env, e, ts).ts
            .Ternary(test: x) :> typeExpr(env, e, ts).ts
            .ArrayLit(elems: es) :> typeExpr(env, e, ts).ts
            .ObjectLit(props: ps) :> typeExpr(env, e, ts).ts
            .Spread(e: x) :> typeExpr(env, e, ts).ts
            .Index(obj: o) :> typeExpr(env, e, ts).ts
            .Lambda(params: ps2) :> typeExpr(env, e, ts).ts
            .Sql(q: q) :> typeExpr(env, e, ts).ts
            .Handled(h: x) :> typeExpr(env, e, ts).ts
        }
    }

    fn typeAssign(env: TEnv, e: AExpr, target: AExpr, value: AExpr, ts0: TypeState) -> TypeState {
        const f: EffectFact | not = effectFact(env.t.effects, e.nid)
        // s444: `@xs[i].f = v` — the value against the element field's type
        const ea: FieldRef[] | not = elemAtPath(f)
        if (ea is given) {
            const r0: RVT = typeExpr(env, value, ts0)
            let ts3: TypeState = typePlace(env, target, VType.Unknown, r0.ts)
            const tt: Type | not = pathType(env.t, ea)
            if (tt is given) ts3 = checkNotElems(env, value, tt, checkLitFields(env, value, checkValue(env, r0.vt, tt, value.span, placeLabel(target), ts3)))
            // r2 F3: the index names a POSITION — an `int`
            const ix: AExpr | not = elemAtIndex(f)
            if (ix is given) ts3 = checkIndex(env, exprType0(ts3, ix.nid), ix.span, ts3)
            return record(ts3, e.nid, VType.Unknown)
        }
        // s442: a recognized append / prepend shape — each ELEMENT is the written value
        const ed: EditsOf | not = editsOf(f)
        if (ed is given) return typeEditsAssign(env, e, target, value, ed, ts0)
        const ws: SpreadWrite[] = effectWrites(f)
        const ps: AProp[] = propsOf(value)
        if (ws.length > 0 && ws[0].prop >= 0) {
            // a spread: the operand and each override typed; each override checked
            let ts: TypeState = typePlace(env, target, VType.Unknown, typeExpr(env, value, ts0).ts)
            for (const sw of ws) {
                if (sw.prop < ps.length) {
                    const pv: AProp = ps[sw.prop]
                    ts = checkWrite(env, sw.w, exprType0(ts, pv.value.nid), pv.value, "`" + pv.name + "`", ts)
                }
            }
            return record(ts, e.nid, VType.Unknown)
        }
        const r: RVT = typeExpr(env, value, ts0)
        let ts1: TypeState = r.ts
        let placeType: VType = VType.Unknown
        if (ws.length == 1) {
            const wt: Type | not = writeValueType(env.t, ws[0].w)
            if (wt is given) placeType = known(wt)
        } else {
            // a local rebinding (§66.11.5): it widens the local's joined type.
            // Only a BARE local target (`a = v`) is the local itself; `a.n = v`
            // is a field edit of it (§66.11.4) whose field type this path does
            // not compute — unchecked (provable-or-silent), and not joined.
            const ls: Sym | not = assignedLocal(f)
            const bareLocal: boolean = exprName(target) != ""
            if (ls is given) {
                if (bareLocal) placeType = tLocal(env, ls)
                const la: Type | not = annotOf(env.t, ls)
                if (la is given && bareLocal) {
                    // a write to an annotated local: checked like a cell write
                    ts1 = checkLitFields(env, value, checkValue(env, r.vt, la, value.span, placeLabel(target), ts1))
                } else if (la is not && bareLocal) {
                    ts1 = contribute(ts1, ls, r.vt)
                }
            }
        }
        let ts2: TypeState = typePlace(env, target, placeType, ts1)
        for (const sw of ws) { ts2 = checkWrite(env, sw.w, r.vt, value, placeLabel(target), ts2) }
        return record(ts2, e.nid, VType.Unknown)
    }

    // s442 — `@x = [...@x, a, b]`: the array is typed as a value, then each
    // element is checked as the edit's written value (the element type).
    type EditsOf:struct = { w: WriteFact, elems: AExpr[] }

    fn editsOf(f: EffectFact | not) -> EditsOf | not {
        return match f {
            .EEdits(w: w, elems: es) :> editsPair(w, es)
            .EWrite(w: w) :> not
            .ESpread(ws: ws) :> not
            .EReset(w: w) :> not
            .EAssignLocal(sym: s) :> not
            .ERemove(w: w) :> not
            .EElemAt(cap: c) :> not
            not :> not
        }
    }

    fn editsPair(w: WriteFact, es: AExpr[]) -> EditsOf { return { w: w, elems: es } }

    fn elemAtIndex(f: EffectFact | not) -> AExpr | not {
        return match f {
            .EElemAt(cap: c, index: x) :> x
            .EEdits(w: w) :> not
            .EWrite(w: w) :> not
            .ESpread(ws: ws) :> not
            .EReset(w: w) :> not
            .EAssignLocal(sym: s) :> not
            .ERemove(w: w) :> not
            not :> not
        }
    }

    // r2 F3 — `@xs[i].f = v`: `i` names a position of the sequence, so it is an
    // `int` (`int` enforced, RULED S440 JS-WAT 7(a): a `number` is not
    // implicitly an `int`). ⚑ PA: no SPEC sentence states the index type of a
    // sequence position (§66.12.2's "positions" axis names no type); the
    // bootstrap holds it to `int`. Provable-or-silent, as every check here: an
    // index whose type is unknown is left to the runtime position check.
    fn checkIndex(env: TEnv, v: VType, span: ASpan, ts: TypeState) -> TypeState {
        return match v {
            .Known(t: x) :> checkIndexKnown(env, x, span, ts)
            .Absent :> report(ts, env, span, "E-TYPE-031", "a sequence index is an `int` position, and this index is `not` (§66.12.2 positions; `int` enforced, ruled S440 JS-WAT 7(a))")
            .Unknown :> ts
        }
    }

    fn checkIndexKnown(env: TEnv, x: Type, span: ASpan, ts: TypeState) -> TypeState {
        if (!mayBeNot(x, Type.Int) && fitsType(x, Type.Int) != Verdict.Fails) return ts
        return report(ts, env, span, "E-TYPE-031", "a sequence index is an `int` position, and this index is `" + typeName(x) + "` (§66.12.2 positions; `int` enforced, ruled S440 JS-WAT 7(a): a `number` is not implicitly an `int`)")
    }

    fn elemAtPath(f: EffectFact | not) -> FieldRef[] | not {
        return match f {
            .EElemAt(cap: c, path: p) :> p
            .EEdits(w: w) :> not
            .EWrite(w: w) :> not
            .ESpread(ws: ws) :> not
            .EReset(w: w) :> not
            .EAssignLocal(sym: s) :> not
            .ERemove(w: w) :> not
            not :> not
        }
    }

    fn typeEditsAssign(env: TEnv, e: AExpr, target: AExpr, value: AExpr, ed: EditsOf, ts0: TypeState) -> TypeState {
        let ts: TypeState = typePlace(env, target, VType.Unknown, typeExpr(env, value, ts0).ts)
        for (const x of ed.elems) {
            ts = checkWrite(env, ed.w, exprType0(ts, x.nid), x, "an element of this sequence", ts)
        }
        return record(ts, e.nid, VType.Unknown)
    }

    // A write target (a PLACE): recorded with the type the place holds; the
    // instance / struct it is reached through typed as a value.
    fn typePlace(env: TEnv, target: AExpr, placeType: VType, ts: TypeState) -> TypeState {
        let ts2: TypeState = ts
        const obj: AExpr | not = memberObj(target)
        if (obj is given) ts2 = typeExpr(env, obj, ts2).ts
        return record(ts2, target.nid, placeType)
    }

    fn memberObj(e: AExpr) -> AExpr | not {
        const k: AExprK = e.k
        return match k {
            .Member(obj: o) :> o
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: s) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: x) :> not
            .Assign(target: x) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: sx) :> not
            .Index(obj: ix) :> not
            .Lambda(params: lp) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
        }
    }

    // A write whose value is the call's single argument: `@xs.push(v)`.
    fn typeCallStmt(env: TEnv, e: AExpr, callee: AExpr, args: AExpr[], ts0: TypeState) -> TypeState {
        const f: EffectFact | not = effectFact(env.t.effects, e.nid)
        const ws: SpreadWrite[] = effectWrites(f)
        if (ws.length == 0) {
            if (isReset(f)) {
                // `reset(@x)`: its argument is a place, not a value to check
                return record(typePlace(env, callee, VType.Unknown, typeExprs(env, args, ts0)), e.nid, VType.Unknown)
            }
            return typeExpr(env, e, ts0).ts
        }
        let ts: TypeState = typePlace(env, callee, VType.Unknown, typeExprs(env, args, ts0))
        if (args.length == 1) {
            for (const sw of ws) { ts = checkWrite(env, sw.w, exprType0(ts, args[0].nid), args[0], "an element of this sequence", ts) }
        }
        return record(ts, e.nid, VType.Unknown)
    }
    // The type recorded for a node this pass already typed.
    fn exprType0(ts: TypeState, nid: int) -> VType {
        let i: int = ts.exprs.length - 1
        while (i >= 0) {
            if (ts.exprs[i].nid == nid) return ts.exprs[i].vt
            i = i - 1
        }
        return VType.Unknown
    }

    // A write: its value against the target's type, then — however the write
    // is spelled — every struct-literal field inside the value against that
    // struct field's declared type (§66.1 rule 5).
    fn checkWrite(env: TEnv, w: WriteFact, v: VType, value: AExpr, what: string, ts: TypeState) -> TypeState {
        const f: FieldInfo | not = fieldOfCap(env.t, w.cap)
        if (f is not) return ts
        if (!f.trusted) return ts
        const target: Type | not = writeValueType(env.t, w)
        if (target is not) return ts
        return checkNotElems(env, value, target, checkLitFields(env, value, checkValue(env, v, target, value.span, what, ts)))
    }

    // The struct literals inside a written value: each named property against
    // its struct field (the literal's struct is the type the typer recorded).
    fn checkLitFields(env: TEnv, e: AExpr, ts: TypeState) -> TypeState {
        const k: AExprK = e.k
        return match k {
            .ObjectLit(props: ps) :> checkObjFields(env, e, ps, ts)
            .Spread(e: x) :> ts
            .Index(obj: o) :> ts
            .Lambda(params: ps2) :> ts
            .Sql(q: q) :> ts
            .Handled(h: x) :> ts
            .ArrayLit(elems: es) :> checkLitList(env, es, ts)
            .Ternary(test: x, yes: y, no: n) :> checkLitFields(env, n, checkLitFields(env, y, ts))
            .Name(name: n) :> ts
            .At(name: n) :> ts
            .AtItem :> ts
            .Num(raw: r) :> ts
            .Str(v: x) :> ts
            .Bool(v: b) :> ts
            .NotLit :> ts
            .Recovered :> ts
            .Variant(name: n) :> ts
            .Member(obj: o) :> ts
            .Call(callee: c) :> ts
            .Unary(op: o) :> ts
            .Binary(op: o) :> ts
            .Assign(target: x) :> ts
        }
    }

    fn checkLitList(env: TEnv, es: AExpr[], ts0: TypeState) -> TypeState {
        let ts: TypeState = ts0
        for (const x of es) { ts = checkLitFields(env, x, ts) }
        return ts
    }

    fn checkObjFields(env: TEnv, e: AExpr, ps: AProp[], ts0: TypeState) -> TypeState {
        let ts: TypeState = ts0
        const lt: Type | not = knownOf(exprType0(ts, e.nid))
        if (lt is not) return ts
        const s: Sym | not = namedOf(lt)
        if (s is not) return ts
        const ti: TypeInfo | not = typeInfoOf(env.t.types, s)
        if (ti is not) return ts
        const fs: FieldDef[] | not = structFieldDefs(ti.def)
        if (fs is not) return ts
        for (const p of ps) {
            if (!p.spread) {
                for (const fd of fs) {
                    if (fd.sym.hint == p.name && env.t.unresolved.fields.indexOf(fd.sym.id) < 0) {   // r8: not against an unresolved field type
                        ts = checkValue(env, exprType0(ts, p.value.nid), fd.ty, p.value.span, "`" + s.hint + "." + p.name + "`", ts)
                    }
                }
                ts = checkLitFields(env, p.value, ts)
            }
        }
        return ts
    }

    // How a message names a write target: `@x`, `@x.f`, `c.f`.
    fn placeLabel(e: AExpr) -> string {
        const key: string = placeKey(e)
        if (key == "") return "this write"
        return "`" + key + "`"
    }

    // ---- views -----------------------------------------------------------------
    fn typeNodes(env: TEnv, ns: ANode[], ts0: TypeState) -> TypeState {
        let ts: TypeState = ts0
        for (const n of ns) { ts = typeNode(env, n, ts) }
        return ts
    }

    // A markup `${x}`: typed; a `T | not` there is NOT an un-narrowed operand —
    // RULED S442: "`${@o.n}` in markup without narrowing stays SILENT (`${not}`
    // renders nothing); Q3's "use in a template" binds string templates only".
    fn typeInterp(env: TEnv, x: AExpr, ts0: TypeState) -> TypeState {
        const r: RVT = typeExpr(env, x, ts0)
        const t: Type | not = knownOf(r.vt)
        if (t is not) return r.ts
        if (maybeInner(t) is not) return r.ts
        return r.ts                                         // (f): a `T | not` renders nothing — silent
    }

    fn typeNode(env: TEnv, n: ANode, ts: TypeState) -> TypeState {
        const k: ANodeK = n.k
        return match k {
            .Elem(e: e) :> typeElem(env, e, ts)
            .Text(text: x) :> ts
            .Interp(e: x) :> typeInterp(env, x, ts)
            .DeclNode(d: d) :> ts
            .Effect(w: w) :> typeEffect(env, w, ts)
        }
    }

    // s449: an effect's dependencies are typed as reads; its body as a handler
    // block is (it runs only while its scope is mounted, under the same
    // narrowing as the markup around it).
    fn typeEffect(env: TEnv, w: AEffect, ts0: TypeState) -> TypeState {
        const ts: TypeState = typeExprs(env, w.deps, ts0)
        return typeBlock(env, w.body, ts)
    }

    fn typeElem(env: TEnv, e: AElem, ts: TypeState) -> TypeState {
        if (e.star) return ts
        if (e.tag == "each") return typeEach(env, e, ts)
        const u: Sym | not = useDecl(elemFact(env.t.elems, e.nid))
        if (u is given) return typeUse(env, e, u, ts)
        return typeHtml(env, e, ts)
    }

    fn typeAttrValue(env: TEnv, v: AAttrValue, ts: TypeState) -> RVT {
        const x: AExpr | not = valueExpr(v)
        if (x is not) return rvt(VType.Unknown, ts)
        return typeExpr(env, x, ts)
    }

    fn typeHandlerValue(env: TEnv, v: AAttrValue, ts: TypeState) -> TypeState {
        return match v {
            .Bare(e: x) :> typeStmtExpr(env, x, ts)
            .Paren(e: x) :> typeStmtExpr(env, x, ts)
            .Braced(b: b) :> typeBlock(env, b, ts)
            .Quoted(v: s) :> ts
            .NoValue :> ts
        }
    }

    // An element's `if=` (L5): a condition (checkCond, ruled S440 #4 = (c)),
    // typed FIRST — the element's other attributes and its children exist
    // only while it holds, so they are typed under its narrowing (`renv`).
    fn typeIfAttr(env: TEnv, e: AElem, ts: TypeState) -> RTEnv {
        const a: AAttr | not = condAttrOf(e.attrs)       // s451: an `else-if=` branch too
        if (a is not) return keepTEnv(env, ts)
        const x: AExpr | not = valueExpr(a.value)
        if (x is not) return keepTEnv(env, ts)
        const r: RVT = typeExpr(env, x, ts)
        // s460 N3 — name the attribute the condition stands in (`if=` / `else-if=`)
        return keepTEnv(tCallUnnarrow(tNarrow(env, condNarrowing(env, x).yes), x), checkCond(env, x, r.vt, "`" + a.name + "=`", r.ts))
    }

    fn typeShowAttr(env: TEnv, a: AAttr, ts: TypeState) -> TypeState {
        const x: AExpr | not = valueExpr(a.value)
        if (x is not) return ts
        const r: RVT = typeExpr(env, x, ts)
        return checkCond(env, x, r.vt, "`show=`", r.ts)
    }

    fn typeHtml(env: TEnv, e: AElem, ts0: TypeState) -> TypeState {
        const ri: RTEnv = typeIfAttr(env, e, ts0)
        const renv: TEnv = ri.env
        let ts: TypeState = ri.ts
        for (const a of e.attrs) {
            if (isChainAttr(a.name)) {
                // typed above (typeIfAttr); `else` has no value
            } else if (a.name == "show") {
                // s451: §17.2 — a condition (checkCond), under the element's
                // `if=` narrowing; it narrows nothing itself
                ts = typeShowAttr(renv, a, ts)
            } else if (eventName(a.name) != "") {
                ts = typeHandlerValue(renv, a.value, ts)
            } else {
                ts = typeAttrValue(renv, a.value, ts).ts
            }
        }
        return typeNodes(renv, e.kids, ts)
    }

    // A USE: each construction value is the field's initializer for this
    // instance (§66.9 rule 8) — the §7.5.1 position-2 rule applies.
    fn typeUse(env: TEnv, e: AElem, decl: Sym, ts0: TypeState) -> TypeState {
        const ri: RTEnv = typeIfAttr(env, e, ts0)
        const renv: TEnv = ri.env
        let ts: TypeState = ri.ts
        const di: DeclInfo | not = declInfo(env.t, decl)
        for (const a of e.attrs) {
            let av: VType = VType.Unknown
            if (a.name != "as" && !isChainAttr(a.name)) {
                const ra: RVT = typeAttrValue(renv, a.value, ts)
                ts = ra.ts
                av = ra.vt
            }
            const i: int = constructIndex(attrFact(env.t.attrs, a.nid))
            if (di is given && i >= 0 && i < di.fields.length) {
                const f: FieldInfo = di.fields[i]
                if (f.annotated && f.trusted) {
                    const what: string = "`" + a.name + "` of `<" + e.tag + ">`"
                    const lk: int = attrLiteralKind(a.value)
                    ts = checkInit(env, f.ty, lk, a.span, what, ts)
                    ts = checkIntInit(env, f.ty, lk, av, a.span, what, ts)
                    ts = checkAttrLitFields(env, a.value, f.ty, ts)
                }
            }
        }
        return typeNodes(renv, e.kids, ts)
    }

    // `<each in=…>`: a row scope whose binding is the source's element type.
    fn typeEach(env: TEnv, e: AElem, ts0: TypeState) -> TypeState {
        let ts: TypeState = ts0
        let src: VType = VType.Unknown
        const inA: AAttr | not = attrNamed(e.attrs, "in")
        if (inA is given) {
            const r: RVT = typeInValue(env, inA.value, ts)
            ts = r.ts
            src = r.vt
            ts = checkIterable(env, src, inA.span, ts)
        }
        let elem: VType = VType.Unknown
        const st: Type | not = knownOf(src)
        if (st is given) {
            const et: Type | not = seqElem(unMaybe(st))
            if (et is given) elem = known(et)
        }
        let renv: TEnv = env
        const bind: Sym | not = eachBind(elemFact(env.t.elems, e.nid))
        if (bind is given) renv = tWithRow(tWithLocal(env, bind, elem), bind, eachSourceKey(env, e))
        const keyA: AAttr | not = attrNamed(e.attrs, "key")
        if (keyA is given) ts = typeAttrValue(renv, keyA.value, ts).ts
        return typeNodes(renv, e.kids, ts)
    }

    // RULED S440 (22-item queue #3, "`<each in=>` over a non-sequence → error,
    // name a code (`E-EACH-NOT-SEQUENCE`)"; SPEC-text OPEN #3, "stay silent
    // under the typer's provable-or-silent rule, and error only when the value
    // is provably not a sequence"); SPEC §17.7.2: "`<each in=expr>` over a
    // value that is not a sequence is a compile error, `E-EACH-NOT-SEQUENCE`
    // … A value typed `S | not`, where `S` is a sequence, is admitted". A
    // value PROVABLY not a sequence (a scalar, a string, a struct, an enum, an
    // instance, or `T | not` over one of those) is refused; `S | not` over a
    // sequence and an unproven value are not. `in="abc"` is a string literal
    // (checked like a string cell); `in=not` is refused (it is never a
    // sequence — kept from S439, the reversible direction).
    fn typeInValue(env: TEnv, v: AAttrValue, ts: TypeState) -> RVT {
        return match v {
            .Quoted(v: s) :> rvt(known(Type.Str), ts)
            .Bare(e: x) :> typeExpr(env, x, ts)
            .Paren(e: x) :> typeExpr(env, x, ts)
            .NoValue :> rvt(VType.Unknown, ts)
            .Braced(b: b) :> rvt(VType.Unknown, ts)
        }
    }

    // The place an `<each in=…>` iterates ("" — not a place: a literal, a call).
    fn eachSourceKey(env: TEnv, e: AElem) -> string {
        const a: AAttr | not = attrNamed(e.attrs, "in")
        if (a is not) return ""
        const x: AExpr | not = valueExpr(a.value)
        if (x is not) return ""
        return nKey(env, x)
    }

    fn checkIterable(env: TEnv, v: VType, span: ASpan, ts: TypeState) -> TypeState {
        if (isAbsentVT(v)) {
            return report(ts, env, span, "E-EACH-NOT-SEQUENCE", "`<each in=not>` — `not` is not a sequence (§17.7.2)")
        }
        const x: Type | not = knownOf(v)
        if (x is not) return ts
        let s: Type = x
        const inner: Type | not = maybeInner(x)
        if (inner is given) s = inner                     // `S | not` is admitted when `S` is a sequence (§17.7.4)
        if (kindOf(s) == 5) return ts
        return report(ts, env, span, "E-EACH-NOT-SEQUENCE", "`<each in=…>` iterates a sequence (an array or a tuple), and this value is `" + typeName(x) + "` — for a count, `<each of=N>` (§17.7.2)")
    }

    // ---- the program ------------------------------------------------------------
    // The typer runs whole-program PASSES until every unannotated local's
    // joined type is stable (a local read before a later assignment is typed
    // from the join, not from its initializer alone). Only the settled pass's
    // types and diagnostics are kept. A local's join only moves UP a shallow
    // lattice (a type → `T | not` / `number` → Unknown: at most 3 moves), and a
    // pass that does not settle moves at least one local, so N locals settle
    // within 3N + 2 passes (the bound; a chain of N locals needs N + 1). If
    // the bound is ever hit, only the locals STILL CHANGING become Unknown
    // (silent — provable-or-silent); settled ones keep their type.
    // `prior`: the diagnostics the passes before the typer reported — read only
    // to keep the condition rule from reporting a second time (Blame, s460).
    fn typeProgram(files: FileAst[], t: Tables, prior: Diag[]) -> RTyping {
        let settled: LocalT[] = []
        let prev: LocalT[] = []
        let pass = 0
        let bound = 2
        while (pass < bound) {
            const ts: TypeState = typePass(files, t, settled, prior)
            const next: LocalT[] = joinContribs(ts.contribs)
            if (pass == 0) bound = 3 * next.length + 2
            if (sameLocals(next, settled)) return { typing: typingOf(ts.exprs, ts.presence), diags: ts.diags }
            prev = settled
            settled = next
            pass = pass + 1
        }
        const last: TypeState = typePass(files, t, unknownWhereChanged(prev, settled), prior)
        return { typing: typingOf(last.exprs, last.presence), diags: last.diags }
    }

    fn unknownWhereChanged(prev: LocalT[], cur: LocalT[]) -> LocalT[] {
        let out: LocalT[] = []
        for (const l of cur) {
            const before: VType | not = findLocalT(prev, l.id)
            let keep = false
            if (before is given) keep = sameVT(before, l.vt)
            if (keep) {
                out = out.concat([l])
            } else {
                out = out.concat([{ id: l.id, vt: VType.Unknown }])
            }
        }
        return out
    }

    fn typePass(files: FileAst[], t: Tables, settled: LocalT[], prior: Diag[]) -> TypeState {
        let ts: TypeState = { exprs: [], diags: [], contribs: [], presence: [] }
        const fnw: FnW[] = fnWrites(files)
        const fns: int[] = refusedReturns(files, t)
        for (const f of files) {
            const blame: Blame = { spans: errorSpansIn(prior, f.path), syms: [], fns: fns }
            const env: TEnv = { t: t, file: f.path, errs: f.errs, locals: [], settled: settled, narrowed: [], fnw: fnw, rows: [], fret: not, blame: blame }
            for (const it of f.items) { ts = typeItem(env, it, ts) }
        }
        return ts
    }

    // s460 (Blame.spans): the spans of the Error diagnostics in file `path`.
    fn errorSpansIn(ds: Diag[], path: string) -> ASpan[] {
        let out: ASpan[] = []
        for (const d of ds) {
            if (d.file == path && d.severity == Severity.Error) out = out.concat([d.span])
        }
        return out
    }

    // s460 (Blame.fns): the functions whose WRITTEN return type was refused —
    // it failed to parse or to resolve (fnsOf leaves `ret` unset: guard (i))
    // — or whose name is declared in two files (guard (ii)).
    fn refusedReturns(files: FileAst[], t: Tables) -> int[] {
        let out: int[] = []
        for (const f of files) {
            for (const af of fnItems(f.items)) {
                const s: Sym | not = bindSym(bindFact(t.binds, af.nid))
                if (s is given) {
                    const fi: FnInfo | not = fnInfoOf(t, s)
                    if (fi is given) {
                        const at: AType | not = af.ret
                        let refused: boolean = inManyFiles(t, fi.name)
                        if (at is given && !isVoidType(at) && fi.ret is not) refused = true
                        if (refused) out = out.concat([s.id])
                    }
                }
            }
        }
        return out
    }

    fn typeItem(env: TEnv, it: AItem, ts: TypeState) -> TypeState {
        const k: AItemK = it.k
        return match k {
            .ProgramItem(p: p) :> typeProgramBody(env, p, ts)
            .DeclItem(d: d) :> typeUserDecl(env, d, ts)
            .FnItem(f: f) :> typeFn(env, f, ts)
            .ImportItem(i: i) :> ts
            .TypeItem(t: x) :> ts
            .MarkupItem(n: n) :> ts
        }
    }

    fn declByNid(t: Tables, nid: int) -> DeclInfo | not {
        for (const d of t.decls) {
            if (d.nid == nid) return d
        }
        return not
    }

    fn typeProgramBody(env: TEnv, p: AProgram, ts0: TypeState) -> TypeState {
        let ts: TypeState = typeFieldInits(env, declByNid(env.t, p.nid), ts0)
        for (const it of p.items) { ts = typeProgramItem(env, it, ts) }
        // s442: the program cells' state-child bodies (O5 (1i))
        for (const it of p.items) {
            for (const d of declsOfItem(it)) {
                if (!isNestedUserDecl(d)) ts = typeFieldMarkup(env, [d], ts)
            }
        }
        return ts
    }

    // s442: the markup a field carries — its state-child bodies (O5 (1i)) and
    // its own `renders` (a child declaration's, §66.4 rule 2) — typed where
    // the binder resolved it (the declaring declaration's context).
    fn typeFieldMarkup(env: TEnv, fds: ADecl[], ts0: TypeState) -> TypeState {
        let ts: TypeState = ts0
        for (const fd of fds) {
            for (const c of fd.body) {
                for (const sc of stateChildOf(c)) { ts = typeNodes(env, sc.body, ts) }
            }
            const r: AElem | not = fd.renders
            if (r is given) ts = typeElem(env, r, ts)
            ts = typeValidatorArgs(env, fd.validators, ts)
        }
        return ts
    }

    // s444 Phase B: a validator's argument expressions are typed as values
    // (the typer covers every expression node; nothing is checked here — the
    // binder judged each validator's applicability, fieldVals).
    fn typeValidatorArgs(env: TEnv, vs: AValidator[], ts0: TypeState) -> TypeState {
        let ts: TypeState = ts0
        for (const v of vs) {
            const a: AValArg = v.arg
            ts = typeValArg(env, a, ts)
        }
        return ts
    }

    fn typeValArg(env: TEnv, a: AValArg, ts: TypeState) -> TypeState {
        return match a {
            .Cmp(op: op, e: x) :> typeExpr(env, x, ts).ts
            .Exprs(es: es) :> typeExprs(env, es, ts)
            .NoArgs :> ts
            .Regex(source: s) :> ts
        }
    }

    fn typeProgramItem(env: TEnv, it: AItem, ts: TypeState) -> TypeState {
        const k: AItemK = it.k
        return match k {
            .FnItem(f: f) :> typeFn(env, f, ts)
            .MarkupItem(n: n) :> typeNode(env, n, ts)
            .DeclItem(d: d) :> typeUserDecl(env, d, ts)
            .ProgramItem(p: p) :> ts
            .ImportItem(i: i) :> ts
            .TypeItem(t: x) :> ts
        }
    }

    fn typeUserDecl(env: TEnv, d: ADecl, ts0: TypeState) -> TypeState {
        let ts: TypeState = typeFieldInits(env, declByNid(env.t, d.nid), ts0)
        // s442: its child fields' markup (only a user declaration has child fields)
        if (declByNid(env.t, d.nid) is given) ts = typeFieldMarkup(env, childFields(d.body), ts)
        const r: AElem | not = d.renders
        if (r is not) return ts
        return typeElem(env, r, ts)
    }

    // A declaration's initializers: typed, and an ANNOTATED field's literal
    // initializer checked (§7.5.1 position 2).
    fn typeFieldInits(env: TEnv, di: DeclInfo | not, ts0: TypeState) -> TypeState {
        if (di is not) return ts0
        let ts: TypeState = ts0
        for (const f of di.fields) {
            const rv: RVT = typeAttrValue(env, f.init, ts)
            ts = rv.ts
            if (f.annotated && f.trusted) {
                const lk: int = attrLiteralKind(f.init)
                ts = checkInit(env, f.ty, lk, f.span, "`" + f.sym.hint + "`", ts)
                ts = checkIntInit(env, f.ty, lk, rv.vt, f.span, "`" + f.sym.hint + "`", ts)
                ts = checkAttrLitFields(env, f.init, f.ty, ts)
            }
        }
        return ts
    }

    fn typeFn(env: TEnv, af: AFn, ts: TypeState) -> TypeState {
        let fenv: TEnv = env
        for (const p of af.params) {
            const pf: BindFact | not = bindFact(env.t.binds, p.nid)
            const s: Sym | not = bindSym(pf)
            // an untyped parameter, or one whose type failed to parse, is unproven
            let pvt: VType = VType.Unknown
            const trusted: boolean = paramsTrusted(env.errs, [p]) && env.t.unresolved.params.indexOf(p.nid) < 0
            if (trusted) pvt = paramType(pf)
            if (s is given) {
                fenv = tWithLocal(fenv, s, pvt)
                // s460 (Blame.syms): a WRITTEN type that was refused (Rule C);
                // an unannotated parameter is not blamed — its type is simply
                // unresolved, which is what the condition rule reports (§42.4 5)
                if (!trusted && p.ty is given) fenv = tWithRefused(fenv, s)
            }
        }
        return typeBlock(withRet(fenv, fnRet(env.t, af)), af.body, ts)
    }

    // The declared return type of a function (`not`: none, or untrusted).
    fn fnRet(t: Tables, af: AFn) -> Type | not {
        const s: Sym | not = bindSym(bindFact(t.binds, af.nid))
        if (s is not) return not
        const fi: FnInfo | not = fnInfoOf(t, s)
        if (fi is not) return not
        return fi.ret
    }

    fn withRet(env: TEnv, r: Type | not) -> TEnv {
        return { t: env.t, file: env.file, errs: env.errs, locals: env.locals, settled: env.settled, narrowed: env.narrowed,
                 fnw: env.fnw, rows: env.rows, fret: r, blame: env.blame }
    }

    // =========================================================================
    // s449 — THE NO-WRITE RULE (SPEC §6.7.4, "The no-write rule —
    // E-EFFECT-WRITES-STATE"): "An effect body SHALL NOT write any reactive
    // cell, directly or through a called function. A write found by the
    // analysis below is E-EFFECT-WRITES-STATE; a body the analysis cannot prove
    // write-free is E-EFFECT-WRITE-UNPROVEN."
    //
    // THE WRITE SUMMARY. "The compiler computes, for every scrml function, a
    // write summary: the set of reactive cells its body may write, closed
    // transitively over the static call graph (a fixed point, so recursion is
    // handled)." Here each function's body is SCANNED once over the binder's
    // facts (BodyScan: its direct writes, the scrml functions it calls or hands
    // on as values, and the call sites nothing resolves), and the EFFECT
    // SUMMARY (summarize, below — dpa-066) closes the scans over those
    // references to a fixed point. What a rule reads from it is a WITNESS — the
    // first call chain down to a write (or to an unresolvable call) — because
    // the message "SHALL name the call chain down to the write".
    //
    // The rules, as the bootstrap meets them:
    //  1. a direct write in the body — any write the binder classified (an
    //     assignment to `@x` or a field / element of it, an edit or removal
    //     call, a spread write, `reset(@x)`, an engine transition) and, by its
    //     shape, a write the binder refused and reported (`@x = …`, `reset(…)`,
    //     `@x.push(…)` with no fact) — is E-EFFECT-WRITES-STATE;
    //  2. a call to a statically resolved scrml function (`function` or `fn`,
    //     same file or imported — the bootstrap links every imported module, so
    //     every body is in the compilation) whose summary is non-empty is
    //     E-EFFECT-WRITES-STATE, naming the chain. (The bootstrap has no server
    //     functions and no §52 cells yet: that limb is vacuous here.)
    //  3. a function VALUE — a scrml function named without being called —
    //     counts as called: its summary is added (the receiver may call it). An
    //     arrow function's body is scanned in place (it can only stand as a
    //     `.filter` / `.map` argument in the bootstrap).
    //  4. a call the analysis cannot resolve fails closed, E-EFFECT-WRITE-
    //     UNPROVEN: a call through a local / parameter / field. (`^{ }` is not
    //     parsed in a bootstrap logic body at all, so it never reaches here.)
    //  5. a host call (`Date.now()`, the closed HostCall set) is outside scrml's
    //     state and is not a write.
    //  +  rule 2's "any call the SPEC defines as writing a cell on the caller's
    //     behalf", the bootstrap's implicit ones — what a READ runs: reading a
    //     user declaration's SHARED instance (`@box`, `@box.k`) constructs it on
    //     first reference (§66.6.4), running its field initializers and
    //     constructing the instances its renders mounts unconditionally; reading
    //     a field with no write capability (a derived cell, or a locked one the
    //     printer builds as `rt.derived`) runs its FORMULA (§6.6). Each such read
    //     refers to a CONSTRUCTION / FORMULA summary (over-approximate: whether a
    //     read is the first is not static). SPEC §6.15: "Each value position is
    //     summarized like a function, so a READ of something that evaluates a
    //     value position carries that position's summary … Under this section
    //     every such summary is empty — that is the point", and "§6.7.4's write
    //     summary still follows reads into formulas and constructions — it now
    //     finds nothing there for a well-formed program, and the check stays as
    //     defence in depth." The value positions themselves are judged at their
    //     source (§6.15, below); a chain through one only ECHOES that report, so
    //     it is dropped when the source-side rule has found a root (effectPass).
    // The message names the fix by shape (S447 1a): a write back to the cell's
    // initializer (or `reset(@x)`) → `reset-on=[…]` on the cell; a write of a
    // call's result → a `<request>`; otherwise → move the write to the writer,
    // or derive the value.
    // =========================================================================
    type FixShape:enum = { ResetFix, RequestFix, OtherFix }
    // A write: the cell (`@x`, `@decl.field`), where, and the fix its shape names.
    type WSite:struct = { cell: string, span: ASpan, file: string, fix: FixShape }
    // A call the analysis cannot resolve, and why.
    type USite:struct = { what: string, span: ASpan, file: string }
    // A scrml function the body calls (`asValue` = false) or hands on as a value.
    type FnRef:struct = { sym: int, name: string, span: ASpan, file: string, asValue: boolean }
    type BodyScan:struct = { writes: WSite[], refs: FnRef[], unproven: USite[] }
    // The first chain (display labels — `f()` — outermost first) down to a
    // write / an unresolvable call: what the summary answers (writeWitness).
    type Witness:struct = { chain: string[], site: WSite }
    type UWitness:struct = { chain: string[], site: USite }
    type WCx:struct = { t: Tables, file: string }

    fn emptyScan() -> BodyScan { return { writes: [], refs: [], unproven: [] } }

    fn addWrite(acc: BodyScan, w: WSite) -> BodyScan {
        return { writes: acc.writes.concat([w]), refs: acc.refs, unproven: acc.unproven }
    }

    fn addRef(acc: BodyScan, r: FnRef) -> BodyScan {
        return { writes: acc.writes, refs: acc.refs.concat([r]), unproven: acc.unproven }
    }

    fn addUnproven(acc: BodyScan, u: USite) -> BodyScan {
        return { writes: acc.writes, refs: acc.refs, unproven: acc.unproven.concat([u]) }
    }

    fn scanBlock(cx: WCx, b: ABlock, acc0: BodyScan) -> BodyScan {
        let acc: BodyScan = acc0
        for (const s of b.stmts) { acc = scanStmt(cx, s, acc) }
        return acc
    }

    fn scanStmt(cx: WCx, s: AStmt, acc: BodyScan) -> BodyScan {
        const k: AStmtK = s.k
        return match k {
            .Eval(e: e) :> scanExpr(cx, e, acc)      // scanExpr records the write (stmtWrite), at any depth
            .Local(name: n, init: i) :> scanExpr(cx, i, acc)
            .Return(e: e) :> scanMaybe(cx, e, acc)
            .If(cond: c, thenB: t, elseB: el) :> scanElse(cx, el, scanBlock(cx, t, scanExpr(cx, c, acc)))
            .Given(name: n, subject: sub, body: b) :> scanBlock(cx, b, scanExpr(cx, sub, acc))
            .EffectStmt(w: w) :> acc                // refused where it stands (E-LIFECYCLE-016 / E-BOOTSTRAP-UNSUPPORTED)
            .Defer(body: b) :> scanBlock(cx, b, acc)
            .Fail(f: f) :> scanExprs(cx, failExprs(f), acc)
        }
    }

    fn scanMaybe(cx: WCx, e: AExpr | not, acc: BodyScan) -> BodyScan {
        if (e is not) return acc
        return scanExpr(cx, e, acc)
    }

    fn scanElse(cx: WCx, el: ABlock | not, acc: BodyScan) -> BodyScan {
        if (el is not) return acc
        return scanBlock(cx, el, acc)
    }

    fn scanExprs(cx: WCx, es: AExpr[], acc0: BodyScan) -> BodyScan {
        let acc: BodyScan = acc0
        for (const e of es) { acc = scanExpr(cx, e, acc) }
        return acc
    }

    // Every write, call and function value in `e`, at any depth (an arrow
    // function's body included — rule 3). A write is recorded wherever it
    // stands, not only as a statement: a markup interpolation or an
    // initializer (the source-side rule below) has no statement to stand in,
    // and `${ @xs.push(1) }` is a write all the same.
    fn scanExpr(cx: WCx, e: AExpr, acc0: BodyScan) -> BodyScan {
        const acc1: BodyScan = stmtWrite(cx, e, acc0)
        const c: AExpr | not = calleeOf(e.k)
        if (c is given) return scanExprs(cx, exprKids(e).slice(1), scanCall(cx, e, c, acc1))
        let acc: BodyScan = formulaRef(cx, e, constructionRef(cx, e, fnValueRef(cx, e, acc1)))
        for (const x of exprKids(e)) { acc = scanExpr(cx, x, acc) }
        for (const b of exprBlocks(e)) { acc = scanBlock(cx, b, acc) }      // s451 (Ue): an arm block
        return acc
    }

    // A read of a user declaration's SHARED instance may construct it (see the
    // banner): a reference to that declaration's construction summary.
    fn constructionRef(cx: WCx, e: AExpr, acc: BodyScan) -> BodyScan {
        const d: Sym | not = sharedDeclRead(nameFact(cx.t.names, e.nid))
        if (d is not) return acc
        if (d.id == cx.t.program.id) return acc       // the program is constructed at boot, never by a read
        for (const r of acc.refs) {
            if (r.sym == d.id) return acc             // `@box.k` resolves `@box` too: one reference per body
        }
        return addRef(acc, { sym: d.id, name: constructionLabel(d.hint), span: e.span, file: cx.file, asValue: false })
    }

    // s449 fix round (HIGH-1) — a read of a field with NO write capability (a
    // derived cell, or a locked one whose initializer the printer turns into a
    // `rt.derived` — print `fieldCtor`) RUNS ITS FORMULA on the read (lazy pull,
    // §6.6): a reference to that formula's summary. Program-level cells
    // included — `constructionRef` skips the program because it is built at
    // boot, but a derived program cell is still recomputed at its read.
    // Reviewer-measured: `<d:int=(@n + g())/>` read in an effect wrote `@a`.
    fn formulaRef(cx: WCx, e: AExpr, acc: BodyScan) -> BodyScan {
        const fi: FieldInfo | not = formulaFieldRead(cx.t, nameFact(cx.t.names, e.nid))
        if (fi is not) return acc
        for (const r of acc.refs) {
            if (r.sym == fi.sym.id) return acc            // one reference per body
        }
        return addRef(acc, { sym: fi.sym.id, name: formulaLabel(cx.t, fi), span: e.span, file: cx.file, asValue: false })
    }

    fn formulaFieldRead(t: Tables, f: NameFact | not) -> FieldInfo | not {
        const df: DeclField | not = readField(f)
        if (df is not) return not
        const di: DeclInfo | not = declInfo(t, df.decl)
        if (di is not || df.idx < 0 || df.idx >= di.fields.length) return not
        const fi: FieldInfo = di.fields[df.idx]
        const w: Sym | not = fi.wcap
        if (w is given) return not                        // a cell: seeded once, at construction
        return fi
    }

    type DeclField:struct = { decl: Sym, idx: int }

    fn mkDeclField(d: Sym, i: int) -> DeclField { return { decl: d, idx: i } }

    fn readField(f: NameFact | not) -> DeclField | not {
        return match f {
            .NField(decl: d, inst: i, idx: x) :> mkDeclField(d, x)
            .NInst(decl: d) :> not
            .NLocal(sym: s) :> not
            .NStruct(owner: o) :> not
            .NFn(sym: s) :> not
            .NLength :> not
            .NSurface(of: x) :> not
            not :> not
        }
    }

    fn formulaLabel(t: Tables, fi: FieldInfo) -> string {
        for (const d of t.decls) {
            for (const f of d.fields) {
                if (f.sym.id == fi.sym.id) {
                    if (d.kind == DeclKind.Program) return "formula of @" + fi.sym.hint
                    return "formula of @" + d.sym.hint + "." + fi.sym.hint
                }
            }
        }
        return "formula of @" + fi.sym.hint
    }

    fn sharedDeclRead(f: NameFact | not) -> Sym | not {
        return match f {
            .NField(decl: d, inst: i) :> sharedOf(i)
            .NInst(decl: d, inst: i) :> sharedOf(i)
            .NLocal(sym: s) :> not
            .NStruct(owner: o) :> not
            .NFn(sym: s) :> not
            .NLength :> not
            .NSurface(of: v) :> sharedOf(validityInst(v))
            not :> not
        }
    }

    fn sharedOf(i: InstRef) -> Sym | not {
        return match i {
            .Shared(decl: d) :> d
            .Lexical(depth: n) :> not
            .Alias(sym: s) :> not
            .Narrowed(sym: s) :> not
        }
    }

    fn constructionLabel(name: string) -> string { return "construction of <" + name + ">" }

    fn scanCall(cx: WCx, e: AExpr, callee: AExpr, acc: BodyScan) -> BodyScan {
        // an edit / removal / `reset` call is a WRITE, recorded at its statement
        // (stmtWrite); its receiver is only read
        if (effectFact(cx.t.effects, e.nid) is given || exprName(callee) == "reset" || isEditCallee(callee)) return scanExprs(cx, receiverOf(callee), acc)
        // a host call (`Date.now()`) or a sequence call (`xs.filter(λ)`): the
        // receiver is read; the arrow function is an argument (scanned by the caller)
        if (isHostOrSeq(valueFact(cx.t.values, e.nid))) return scanExprs(cx, receiverOf(callee), acc)
        const f: NameFact | not = nameFact(cx.t.names, callee.nid)
        const s: Sym | not = fnSymOf(f)
        if (s is given) return addRef(acc, { sym: s.id, name: s.hint + "()", span: e.span, file: cx.file, asValue: false })
        // A callee name with no fact was already reported (E-SCOPE-001), and any
        // other callee shape is refused by the binder — only a NAME that resolves
        // to something other than a function reaches here: a local, a parameter,
        // a field. Rule 4: fail closed.
        if (f is given && exprName(callee) != "") {
            return addUnproven(acc, { what: "`" + exprName(callee) + "(…)` calls through `" + exprName(callee) + "`, which is " + calleeKind(f) + ", not a declared scrml function", span: e.span, file: cx.file })
        }
        return scanExprs(cx, receiverOf(callee), acc)
    }

    // Rule 3: a scrml function NAMED without being called.
    fn fnValueRef(cx: WCx, e: AExpr, acc: BodyScan) -> BodyScan {
        if (exprName(e) == "") return acc
        const s: Sym | not = fnSymOf(nameFact(cx.t.names, e.nid))
        if (s is not) return acc
        return addRef(acc, { sym: s.id, name: s.hint, span: e.span, file: cx.file, asValue: true })
    }

    fn fnSymOf(f: NameFact | not) -> Sym | not {
        return match f {
            .NFn(sym: s) :> s
            .NLocal(sym: s) :> not
            .NField(decl: d) :> not
            .NInst(decl: d) :> not
            .NStruct(owner: o) :> not
            .NLength :> not
            .NSurface(of: x) :> not
            not :> not
        }
    }

    fn calleeKind(f: NameFact) -> string {
        return match f {
            .NLocal(sym: s) :> "a local or a parameter (a function value the compiler cannot resolve to a known set of scrml functions)"
            .NField(decl: d) :> "a cell"
            .NInst(decl: d) :> "an instance"
            .NStruct(owner: o) :> "a struct field"
            .NLength :> "a length"
            .NSurface(of: x) :> "a validity surface"
            .NFn(sym: s) :> "a function"
        }
    }

    fn isHostOrSeq(v: ValueFact | not) -> boolean {
        return match v {
            .VHost(call: c) :> true
            .VSeqCall(op: o) :> true
            .VLit(lit: l) :> false
            .VVariant(enumSym: s) :> false
            .VOp(op: o) :> false
            .VStructOf(ty: t) :> false
            .VLambda(params: ps) :> false
            not :> false
        }
    }

    // `@x.push(…)` / `.unshift` / `.pop` / `.shift` on a reactive place — an edit
    // or removal by its method (§66.11.2), whether or not the binder accepted it.
    fn isEditCallee(callee: AExpr) -> boolean {
        const k: AExprK = callee.k
        const n: string = memberName(k)
        if (n != "push" && n != "unshift" && n != "pop" && n != "shift") return false
        const r: AExpr[] = receiverOf(callee)
        if (r.length == 0) return false
        return isReactiveRoot(placeRoot(r[0]))
    }

    fn memberName(k: AExprK) -> string {
        return match k {
            .Member(obj: o, name: n) :> n
            .Name(name: n) :> ""
            .At(name: n) :> ""
            .AtItem :> ""
            .Num(raw: r) :> ""
            .Str(v: s) :> ""
            .Bool(v: b) :> ""
            .NotLit :> ""
            .Recovered :> ""
            .Variant(name: n) :> ""
            .Call(callee: c) :> ""
            .Unary(op: o) :> ""
            .Binary(op: o) :> ""
            .Ternary(test: t) :> ""
            .Assign(target: t) :> ""
            .ArrayLit(elems: es) :> ""
            .ObjectLit(props: ps) :> ""
            .Spread(e: x) :> ""
            .Index(obj: o) :> ""
            .Lambda(params: ps) :> ""
            .Sql(q: q) :> ""
            .Handled(h: x) :> ""
        }
    }

    // The receiver of a member callee (`xs` of `xs.filter`), else nothing.
    fn receiverOf(callee: AExpr) -> AExpr[] {
        const k: AExprK = callee.k
        return match k {
            .Member(obj: o) :> [o]
            .Name(name: n) :> []
            .At(name: n) :> []
            .AtItem :> []
            .Num(raw: r) :> []
            .Str(v: s) :> []
            .Bool(v: b) :> []
            .NotLit :> []
            .Recovered :> []
            .Variant(name: n) :> []
            .Call(callee: c) :> []
            .Unary(op: o) :> []
            .Binary(op: o) :> []
            .Ternary(test: t) :> []
            .Assign(target: t) :> []
            .ArrayLit(elems: es) :> []
            .ObjectLit(props: ps) :> []
            .Spread(e: x) :> []
            .Index(obj: o) :> []
            .Lambda(params: ps) :> []
            .Sql(q: q) :> []
            .Handled(h: x) :> []
        }
    }

    // The base of a place expression: `@x` → "@x", `@.` → "@.", a name → the
    // name, anything else → "".
    fn placeRoot(e: AExpr) -> string {
        const k: AExprK = e.k
        return match k {
            .At(name: n) :> "@" + n
            .AtItem :> "@."
            .Name(name: n) :> n
            .Member(obj: o) :> placeRoot(o)
            .Index(obj: o) :> placeRoot(o)
            .Num(raw: r) :> ""
            .Str(v: s) :> ""
            .Bool(v: b) :> ""
            .NotLit :> ""
            .Recovered :> ""
            .Variant(name: n) :> ""
            .Call(callee: c) :> ""
            .Unary(op: o) :> ""
            .Binary(op: o) :> ""
            .Ternary(test: t) :> ""
            .Assign(target: t) :> ""
            .ArrayLit(elems: es) :> ""
            .ObjectLit(props: ps) :> ""
            .Spread(e: x) :> ""
            .Lambda(params: ps) :> ""
            .Sql(q: q) :> ""
            .Handled(h: x) :> ""
        }
    }

    fn isReactiveRoot(root: string) -> boolean { return root.indexOf("@") == 0 }

    // Rule 1 at a statement: the write the binder classified, else a write by
    // its shape that the binder refused (and reported) — still a write.
    fn stmtWrite(cx: WCx, e: AExpr, acc: BodyScan) -> BodyScan {
        const f: EffectFact | not = effectFact(cx.t.effects, e.nid)
        const cap: Sym | not = writtenCap(f)
        if (cap is given) return addWrite(acc, { cell: cellLabel(cx.t, cap), span: e.span, file: cx.file, fix: factFix(cx.t, e, f, cap) })
        const syn: string = syntacticWrite(e)
        if (syn != "") return addWrite(acc, { cell: syn, span: e.span, file: cx.file, fix: shapeFix(e, "") })
        return acc
    }

    // The capability a reactive write uses (`not` for a local rebinding / no write).
    fn writtenCap(f: EffectFact | not) -> Sym | not {
        return match f {
            .EWrite(w: w) :> w.cap
            .ESpread(ws: ws) :> firstSpreadCap(ws)
            .EReset(w: w) :> w.cap
            .EEdits(w: w) :> w.cap
            .ERemove(w: w) :> w.cap
            .EElemAt(cap: c) :> c
            .EAssignLocal(sym: s) :> not
            not :> not
        }
    }

    fn firstSpreadCap(ws: SpreadWrite[]) -> Sym | not {
        if (ws.length == 0) return not
        return ws[0].w.cap
    }

    fn isResetFact(f: EffectFact | not) -> boolean {
        return match f {
            .EReset(w: w) :> true
            .EWrite(w: w) :> false
            .ESpread(ws: ws) :> false
            .EEdits(w: w) :> false
            .ERemove(w: w) :> false
            .EElemAt(cap: c) :> false
            .EAssignLocal(sym: s) :> false
            not :> false
        }
    }

    // The cell a capability writes, as the author spells it: `@x` for a program
    // cell, `@decl.field` for a declaration's field.
    fn cellLabel(t: Tables, cap: Sym) -> string {
        for (const d of t.decls) {
            for (const f of d.fields) {
                const w: Sym | not = f.wcap
                if (w is given && w.id == cap.id) {
                    if (d.kind == DeclKind.Program) return "@" + f.sym.hint
                    return "@" + d.sym.hint + "." + f.sym.hint
                }
            }
        }
        return "`" + cap.hint + "`"
    }

    fn fieldOfCap(t: Tables, cap: Sym) -> FieldInfo | not {
        for (const d of t.decls) {
            for (const f of d.fields) {
                const w: Sym | not = f.wcap
                if (w is given && w.id == cap.id) return f
            }
        }
        return not
    }

    fn factFix(t: Tables, e: AExpr, f: EffectFact | not, cap: Sym) -> FixShape {
        if (isResetFact(f)) return FixShape.ResetFix
        let init: string = ""
        const fi: FieldInfo | not = fieldOfCap(t, cap)
        if (fi is given) init = initKey(fi.init)
        return shapeFix(e, init)
    }

    // The fix a write's SHAPE names: `reset(…)` or a write of the cell's own
    // initializer literal → reset-on=; a write of a call's result → <request>;
    // otherwise → move / derive.
    fn shapeFix(e: AExpr, init: string) -> FixShape {
        if (exprName(callTarget(e)) == "reset") return FixShape.ResetFix
        const v: AExpr | not = assignedValue(e)
        if (v is not) return FixShape.OtherFix
        if (calleeOf(v.k) is given) return FixShape.RequestFix
        if (init != "" && litKey(v) == init) return FixShape.ResetFix
        return FixShape.OtherFix
    }

    fn callTarget(e: AExpr) -> AExpr {
        const c: AExpr | not = calleeOf(e.k)
        if (c is given) return c
        return e
    }

    fn assignedValue(e: AExpr) -> AExpr | not {
        const k: AExprK = e.k
        return match k {
            .Assign(target: t, value: v) :> v
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: s) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Index(obj: o) :> not
            .Lambda(params: ps) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
        }
    }

    fn assignedTarget(e: AExpr) -> AExpr | not {
        const k: AExprK = e.k
        return match k {
            .Assign(target: t, value: v) :> t
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: s) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Index(obj: o) :> not
            .Lambda(params: ps) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
        }
    }

    // A literal's identity ("" — not a literal), to compare a written value
    // with a cell's initializer.
    fn litKey(e: AExpr) -> string {
        const k: AExprK = e.k
        return match k {
            .Num(raw: r) :> "n:" + r
            .Str(v: s) :> "s:" + s
            .Bool(v: b) :> boolKey(b)
            .NotLit :> "not"
            .Variant(name: n) :> "v:" + n
            .Unary(op: o, e: x) :> negKey(o, x)
            .Name(name: n) :> ""
            .At(name: n) :> ""
            .AtItem :> ""
            .Recovered :> ""
            .Member(obj: o) :> ""
            .Call(callee: c) :> ""
            .Binary(op: o) :> ""
            .Ternary(test: t) :> ""
            .Assign(target: t) :> ""
            .ArrayLit(elems: es) :> ""
            .ObjectLit(props: ps) :> ""
            .Spread(e: x) :> ""
            .Index(obj: o) :> ""
            .Lambda(params: ps) :> ""
            .Sql(q: q) :> ""
            .Handled(h: x) :> ""
        }
    }

    fn boolKey(b: boolean) -> string {
        if (b) return "b:true"
        return "b:false"
    }

    fn negKey(o: UnOp, x: AExpr) -> string {
        if (o != UnOp.Neg) return ""
        const inner: string = litKey(x)
        if (inner.indexOf("n:") != 0) return ""
        return "n:-" + inner.substring(2)
    }

    fn initKey(v: AAttrValue) -> string {
        return match v {
            .Bare(e: e) :> litKey(e)
            .Paren(e: e) :> litKey(e)
            .Quoted(v: s) :> "s:" + s
            .NoValue :> ""
            .Braced(b: b) :> ""
        }
    }

    // A write by its SHAPE alone (the cell it names, "" — not a write):
    // `@x… = v`, `reset(@x…)`, `@x….push(v)` and the other edit / removal calls.
    fn syntacticWrite(e: AExpr) -> string {
        const t: AExpr | not = assignedTarget(e)
        if (t is given) {
            const root: string = placeRoot(t)
            if (isReactiveRoot(root)) return root
            return ""
        }
        const c: AExpr | not = calleeOf(e.k)
        if (c is not) return ""
        if (exprName(c) == "reset") {
            const args: AExpr[] = exprKids(e).slice(1)
            if (args.length == 1 && isReactiveRoot(placeRoot(args[0]))) return placeRoot(args[0])
            return ""
        }
        if (isEditCallee(c)) return placeRoot(receiverOf(c)[0])
        return ""
    }

    // ---- the scans the summary closes: one per function (scanBlock), one per
    // user declaration (its CONSTRUCTION) and one per formula (a field computed
    // on its read) — see the banner; summarize builds them.

    // What constructing a declaration's instance runs: every field initializer
    // (the declared defaults — a use-site value is evaluated where the use
    // renders, not by a read), and the construction of each declaration its
    // renders uses (L12 (b) builds the unconditional ones with it; every use is
    // counted — over-approximate).
    fn constructionScan(t: Tables, ds: DeclSrc) -> BodyScan {
        const cx: WCx = { t: t, file: ds.file }
        let acc: BodyScan = emptyScan()
        for (const f of ds.info.fields) { acc = scanValue(cx, f.init, acc) }
        const d: ADecl | not = ds.d
        if (d is given) {
            const r: AElem | not = d.renders
            if (r is given) acc = usedDecls(cx, r.kids, acc)
        }
        return acc
    }

    fn scanValue(cx: WCx, v: AAttrValue, acc: BodyScan) -> BodyScan {
        return match v {
            .Bare(e: e) :> scanExpr(cx, e, acc)
            .Paren(e: e) :> scanExpr(cx, e, acc)
            .Braced(b: b) :> scanBlock(cx, b, acc)
            .Quoted(v: s) :> acc
            .NoValue :> acc
        }
    }

    fn usedDecls(cx: WCx, ns: ANode[], acc0: BodyScan) -> BodyScan {
        let acc: BodyScan = acc0
        for (const n of ns) {
            const e: AElem | not = elemOfNode(n.k)
            if (e is given) {
                const used: Sym | not = useOf(elemFact(cx.t.elems, e.nid))
                if (used is given) acc = addRef(acc, { sym: used.id, name: constructionLabel(used.hint), span: e.span, file: cx.file, asValue: false })
                acc = usedDecls(cx, e.kids, acc)
            }
        }
        return acc
    }

    fn useOf(f: ElemFact | not) -> Sym | not {
        return match f {
            .MUse(decl: d) :> d
            .MStar(decl: d) :> d
            .MHtml :> not
            .MEach(bind: b) :> not
            .MSlot :> not
            .MDb :> not
            .MErrors(of: x) :> not
            .MStateView(v: v) :> not
            .MInline(v: v) :> not
            not :> not
        }
    }

    // ---- the queries: the first write / unresolvable call callable `i` reaches
    // (its first atom in the summary's `writes` / `writesOpen`; dpa-066 M1).
    fn writeWitness(s: Summary, i: int) -> Witness | not {
        const a: FxAtom | not = witnessOf(s.writes[i])
        if (a is not) return not
        return { chain: fxChain(s, s.writes, i, a), site: s.nodes[a.root].f.scan.writes[a.pos] }
    }

    fn openWitness(s: Summary, i: int) -> UWitness | not {
        const a: FxAtom | not = witnessOf(s.writesOpen[i])
        if (a is not) return not
        return { chain: fxChain(s, s.writesOpen, i, a), site: s.nodes[a.root].f.scan.unproven[a.pos] }
    }

    // ---- the pass: every accepted effect's body against the summaries ---------
    // (and every value position — §6.15, valueDiags)
    fn effectPass(g: Globals, t: Tables, effects: EffectSrc[], sum: Summary) -> Diag[] {
        const ps: ValuePos[] = valuePositions(g, t)
        let scans: BodyScan[] = []
        for (const p of ps) { scans = scans.concat([scanValue({ t: t, file: p.file }, p.v, emptyScan())]) }
        // The ROOTS: each value position's own writes / write chains (not
        // through another value position). They come first — each is the cause
        // of whatever a reader of that value would report. When there is a
        // root, a chain through a formula / construction is its ECHO and is
        // dropped (`quiet`); when there is none, such a chain means the
        // source-side rule missed a position, and it is reported — the
        // defence in depth §6.15 keeps.
        let roots: Diag[] = []
        let echoes: Diag[] = []
        let i: int = 0
        for (const p of ps) {
            roots = roots.concat(valueDiags(p, scans[i], sum, true))
            echoes = echoes.concat(valueDiags(p, scans[i], sum, false))
            i = i + 1
        }
        const quiet: boolean = roots.length > 0
        let out: Diag[] = roots
        if (!quiet) out = echoes
        for (const es of effects) {
            const scan: BodyScan = scanBlock({ t: t, file: es.file }, es.w.body, emptyScan())
            for (const w of scan.writes) { out = out.concat([writesDirect(es.w, w)]) }
            for (const r of scan.refs) { out = out.concat(refDiags(es.w, r, sum, quiet)) }
            for (const u of scan.unproven) { out = out.concat([unprovenDirect(u)]) }
        }
        return out
    }

    // A chain that runs through a value position (a formula / a construction)
    // — the echo of that position's own report (§6.15).
    fn throughValue(r: FnRef, chain: string[]) -> boolean {
        if (isValueLabel(r.name)) return true
        for (const l of chain) {
            if (isValueLabel(l)) return true
        }
        return false
    }

    fn isValueLabel(l: string) -> boolean {
        return l.indexOf("formula of ") == 0 || l.indexOf("construction of ") == 0
    }

    fn refDiags(w: AEffect, r: FnRef, s: Summary, quiet: boolean) -> Diag[] {
        // fix round (LOW a): a reference with no summary is unresolved — fail closed
        const i: int = nodeIdx(s.nodes, r.sym)
        if (i < 0) return [newDiag("E-EFFECT-WRITE-UNPROVEN", "this effect reaches `" + r.name + "`, which has no write summary — the compiler cannot prove it writes no reactive cell, and the rule fails closed (§6.7.4 rule 4)", r.file, r.span)]
        const sw: Witness | not = writeWitness(s, i)
        if (sw is given) {
            if (quiet && throughValue(r, sw.chain)) return []
            return [writesThrough(w, r, sw)]
        }
        const su: UWitness | not = openWitness(s, i)
        if (su is given) {
            if (quiet && throughValue(r, su.chain)) return []
            return [unprovenThrough(r, su)]
        }
        return []
    }

    fn effectWord(w: AEffect) -> string {
        if (w.keyword) return "this `when … changes` effect"
        return "this `<effect>`"
    }

    fn writesDirect(w: AEffect, site: WSite) -> Diag {
        const msg: string = effectWord(w) + " writes `" + site.cell + "`. An effect drives the outside world and may not write reactive state, directly or through a called function (§6.7.4). " + fixText(w, site)
        return newDiag("E-EFFECT-WRITES-STATE", msg, site.file, site.span)
    }

    fn writesThrough(w: AEffect, r: FnRef, wit: Witness) -> Diag {
        const chain: string = chainText(wit.chain) + " → " + wit.site.cell
        let how: string = " writes `" + wit.site.cell + "` through a call: `" + chain + "`"
        if (r.asValue) how = " hands `" + r.name.replace("()", "") + "` on as a function value — whatever receives it may call it (§6.7.4 rule 3) — and it writes `" + wit.site.cell + "`: `" + chain + "`"
        if (r.name.indexOf("formula of ") == 0) how = " reads a value computed on its read — its formula runs inside the effect and writes `" + wit.site.cell + "`: `" + chain + "`"
        if (r.name.indexOf("construction of ") == 0) how = " reads a shared instance that its first read CONSTRUCTS, running initializers that write `" + wit.site.cell + "`: `" + chain + "`"
        const msg: string = effectWord(w) + how + ". An effect drives the outside world and may not write reactive state, directly or through a called function (§6.7.4). " + fixText(w, wit.site)
        return newDiag("E-EFFECT-WRITES-STATE", msg, r.file, r.span)
    }

    fn unprovenDirect(u: USite) -> Diag {
        const msg: string = u.what + " — the compiler cannot prove this effect writes no reactive cell, and the rule fails closed (§6.7.4 rule 4). Call a declared scrml function by its name"
        return newDiag("E-EFFECT-WRITE-UNPROVEN", msg, u.file, u.span)
    }

    fn unprovenThrough(r: FnRef, wit: UWitness) -> Diag {
        const msg: string = "this effect reaches a call the compiler cannot resolve, through `" + chainText(wit.chain) + "`: " + wit.site.what + " — it cannot prove the effect writes no reactive cell, and the rule fails closed (§6.7.4 rule 4)"
        return newDiag("E-EFFECT-WRITE-UNPROVEN", msg, r.file, r.span)
    }

    fn chainText(labels: string[]) -> string {
        return labels.join(" → ")
    }

    // The fix the message names, by the write's shape (S447 1a).
    fn fixText(w: AEffect, site: WSite) -> string {
        const f: FixShape = site.fix
        return match f {
            .ResetFix :> "To reset `" + site.cell + "` when this effect's dependencies change, declare it on the cell: `reset-on=[" + depNames(w).join(", ") + "]` (§6.8.4)."
            .RequestFix :> "A call result that must land in state is a `<request>`'s job — it owns the result, loading and errors (§6.7.7)."
            .OtherFix :> "Move the write into the code that writes the trigger (the handler or function), or derive the value (§6.6)."
        }
    }

    fn depNames(w: AEffect) -> string[] {
        let out: string[] = []
        for (const d of w.deps) {
            const n: string = atName(d)
            if (n != "") out = out.concat(["@" + n])
        }
        return out
    }

    // =========================================================================
    // s449 — VALUE POSITIONS DO NOT WRITE REACTIVE STATE (SPEC §6.15; bryan,
    // S449, user-voice-scrml.md §S449 item 3). "Evaluating a **value position**
    // SHALL NOT write any reactive cell, directly or through a called function.
    // A write found by the analysis below is **E-VALUE-WRITES-STATE**; a value
    // position the analysis cannot prove write-free is **E-VALUE-WRITE-UNPROVEN**.
    // Both are compile errors."
    //
    // The value positions (§6.15's list), as the bootstrap has them:
    //   1. an initializer — a program cell's own value, a user declaration's own
    //      value, every attribute-field default and child-field initializer (at
    //      any depth), and a use-site construction value (§66.9 rule 8). (§6.8.1
    //      `default=` is not in the bootstrap: an unknown opener word, refused.)
    //   2. a derived formula — a locked initializer that reads cells (§66.9
    //      rule 3; a call counts as a read, as `valueReads` decides the mode).
    //   3. a render expression — a markup interpolation, and every markup
    //      attribute value (`class=`, `title=`, `if=`, `show=`, `<each in=…>` /
    //      `key=`, …), in the program body, a `renders` and a state-child body.
    //      (A multi-statement `${ }`, a Tier-0 `for … lift`, a display-text
    //      interpolation and `<match on=>` are not in the bootstrap.)
    // NOT value positions (§6.15): an event-handler attribute (`on*=`) and a
    // `bind:` binding (action positions), a function body (judged where it is
    // called), an `<effect>` body (§6.7.4 — the walk skips it; `<request>`,
    // `<onMount>`, `<timer>`, engine `effect=` / `<onTransition>` are not in the
    // bootstrap), and a `${ }` at the program body top — in the bootstrap a
    // logic block of items, never an interpolation, so never reached here.
    // An `as=` value is a name the attribute binds, not an expression evaluated.
    //
    // Each position is scanned with the effect rule's scanValue and judged
    // against the SAME write summaries (§6.15: "one summary shared by every
    // rule that uses it"). The message names the position, the written cell,
    // the call chain and the fix by shape (§6.15 "The message names the
    // position and the fix").
    // =========================================================================
    fn valueWritesCode() -> string { return "E-VALUE-WRITES-STATE" }
    fn valueUnprovenCode() -> string { return "E-VALUE-WRITE-UNPROVEN" }

    // Which of §6.15's three kinds a position is — it picks the fix text.
    type ValueKind:enum = { InitKind, FormulaKind, RenderKind }
    // A value position: what it is (for the message), its kind, its value, where.
    type ValuePos:struct = { what: string, vk: ValueKind, v: AAttrValue, span: ASpan, file: string }

    fn valuePositions(g: Globals, t: Tables) -> ValuePos[] {
        let out: ValuePos[] = []
        for (const ds of g.decls) {
            const p: AProgram | not = ds.p
            const d: ADecl | not = ds.d
            if (p is given) {
                for (const fd of fieldDecls(ds)) { out = out.concat(declInits(fd, "@" + fd.name, ds.file)) }
            } else if (d is given) {
                out = out.concat(declInits(d, "@" + d.name, ds.file))
            }
            for (const n of declMarkup(ds)) { out = out.concat(nodePositions(t, n, ds.file)) }
        }
        return out
    }

    // A declaration's own value, its attribute fields' defaults and its child
    // fields' initializers (at any depth); `path` is the cell as the author
    // spells it (`@x`, `@box.k`).
    fn declInits(d: ADecl, path: string, file: string) -> ValuePos[] {
        let out: ValuePos[] = []
        if (computedValue(d.own)) out = out.concat([initPos(d.isLet, d.own, path, d.span, file)])
        for (const a of d.attrs) {
            if (computedValue(a.dflt)) out = out.concat([initPos(a.isLet, a.dflt, path + "." + a.name, a.span, file)])
        }
        for (const c of childFields(d.body)) { out = out.concat(declInits(c, path + "." + c.name, file)) }
        return out
    }

    // A value with something to evaluate (a quoted string is a literal).
    fn computedValue(v: AAttrValue) -> boolean {
        return match v {
            .Bare(e: e) :> true
            .Paren(e: e) :> true
            .Braced(b: b) :> true
            .Quoted(v: s) :> false
            .NoValue :> false
        }
    }

    // A locked initializer that reads cells is a derived FORMULA (§66.9 rule 3);
    // anything else is an initializer (a `let` seed, a locked constant).
    fn initPos(isLet: boolean, v: AAttrValue, path: string, span: ASpan, file: string) -> ValuePos {
        if (!isLet && valueReads(v).length > 0) return { what: "the formula of derived `" + path + "`", vk: ValueKind.FormulaKind, v: v, span: span, file: file }
        return { what: "the initializer of `" + path + "`", vk: ValueKind.InitKind, v: v, span: span, file: file }
    }

    fn nodePositions(t: Tables, n: ANode, file: string) -> ValuePos[] {
        const k: ANodeK = n.k
        return match k {
            .Elem(e: e) :> elemPositions(t, e, file)
            .Interp(e: x) :> [interpPos(x, n.span, file)]
            .Text(text: s) :> []
            .DeclNode(d: d) :> []          // refused where it stands
            .Effect(w: w) :> []            // a lifecycle body — the effect rule's (§6.7.4), not a value position
        }
    }

    fn interpPos(x: AExpr, span: ASpan, file: string) -> ValuePos {
        return { what: "the interpolation", vk: ValueKind.RenderKind, v: AAttrValue.Bare(x), span: span, file: file }
    }

    fn elemPositions(t: Tables, e: AElem, file: string) -> ValuePos[] {
        let out: ValuePos[] = []
        for (const a of e.attrs) {
            if (isValueAttr(a.name) && computedValue(a.value)) out = out.concat([attrPos(attrFact(t.attrs, a.nid), e.tag, a, file)])
        }
        for (const k of e.kids) { out = out.concat(nodePositions(t, k, file)) }
        return out
    }

    // A markup attribute whose value is evaluated: every one but an event
    // handler and a `bind:` (action positions, §6.15) and `as=` (a name it
    // binds). Decided by the NAME, not the binder's fact, so an attribute the
    // binder refused is still judged (fail closed).
    fn isValueAttr(name: string) -> boolean {
        if (eventName(name) != "") return false
        if (name.substring(0, 5) == "bind:") return false
        return name != "as"
    }

    fn attrPos(k: AttrKind | not, tag: string, a: AAttr, file: string) -> ValuePos {
        const named: string = "the `" + a.name + "=` value on `<" + tag + ">`"
        const what: string = match k {
            .AIf :> "the `if=` condition on `<" + tag + ">`"
            .AShow :> "the `show=` condition on `<" + tag + ">`"
            .AConstruct(field: i) :> "the use-site value `" + a.name + "=` of `<" + tag + ">`"
            .AEachIn :> "the `<each in=…>` sequence"
            .AEachKey :> "the `<each key=…>` key"
            .AStatic :> named
            .ABound :> named
            .AOn(event: ev) :> named
            .AAs :> named
            .AEachAs :> named
            .ABind(kind: b) :> named
            not :> named
        }
        // a use-site construction value is an initializer of the instance's
        // field (§6.15 list item 1, §66.9 rule 8)
        let vk: ValueKind = ValueKind.RenderKind
        if (isConstructAttr(k)) vk = ValueKind.InitKind
        return { what: what, vk: vk, v: a.value, span: a.span, file: file }
    }

    fn isConstructAttr(k: AttrKind | not) -> boolean {
        return match k {
            .AConstruct(field: i) :> true
            .AIf :> false
            .AShow :> false
            .AEachIn :> false
            .AEachKey :> false
            .AStatic :> false
            .ABound :> false
            .AOn(event: ev) :> false
            .AAs :> false
            .AEachAs :> false
            .ABind(kind: b) :> false
            not :> false
        }
    }

    // Every write / write chain / unresolvable call a position's scan reaches.
    // `rootsOnly`: leave out a chain through another value position (a
    // formula / a construction) — its echo (see effectPass).
    fn valueDiags(p: ValuePos, scan: BodyScan, sum: Summary, rootsOnly: boolean) -> Diag[] {
        let out: Diag[] = []
        for (const w of scan.writes) { out = out.concat([valueWrites(p, "writes `" + w.cell + "`", w.span, w.file)]) }
        for (const r of scan.refs) { out = out.concat(valueRefDiags(p, r, sum, rootsOnly)) }
        for (const u of scan.unproven) { out = out.concat([valueUnproven(p, u.what, u.span, u.file)]) }
        return out
    }

    fn valueRefDiags(p: ValuePos, r: FnRef, s: Summary, rootsOnly: boolean) -> Diag[] {
        const i: int = nodeIdx(s.nodes, r.sym)
        if (i < 0) return [valueUnproven(p, "it reaches `" + r.name + "`, which has no write summary", r.span, r.file)]
        const sw: Witness | not = writeWitness(s, i)
        if (sw is given) {
            if (rootsOnly && throughValue(r, sw.chain)) return []
            const chain: string = chainText(sw.chain) + " → " + sw.site.cell
            let how: string = "writes `" + sw.site.cell + "` through a call: `" + chain + "`"
            if (r.asValue) how = "hands `" + r.name + "` on as a function value — whatever receives it may call it during the evaluation (§6.7.4 rule 3) — and it writes `" + sw.site.cell + "`: `" + chain + "`"
            if (isValueLabel(r.name)) how = "reads a value whose evaluation writes `" + sw.site.cell + "`: `" + chain + "`"
            return [valueWrites(p, how, r.span, r.file)]
        }
        const su: UWitness | not = openWitness(s, i)
        if (su is given) {
            if (rootsOnly && throughValue(r, su.chain)) return []
            return [valueUnproven(p, "it reaches a call the compiler cannot resolve, through `" + chainText(su.chain) + "`: " + su.site.what, r.span, r.file)]
        }
        return []
    }

    // The fix by shape (§6.15, verbatim).
    fn valueFix(vk: ValueKind) -> string {
        return match vk {
            .InitKind :> "an initializer computes the cell's starting value and may not change other cells; load with a `<request>` (§6.7.7), prepare the outside world in an `<onMount>` (§6.7.1a), or move the write into the handler that should cause it"
            .FormulaKind :> "a derived value is computed from other cells and may not change them; derive the other value too (§6.6), or move the write into the handler that writes the formula's inputs"
            .RenderKind :> "rendering shows state and may not change it; move the write into a handler, or derive the displayed value (§6.6)"
        }
    }

    fn valueWrites(p: ValuePos, how: string, span: ASpan, file: string) -> Diag {
        const msg: string = p.what + " " + how + ". A value position may not write reactive state, directly or through a called function (§6.15): " + valueFix(p.vk) + "."
        return newDiag(valueWritesCode(), msg, file, span)
    }

    fn valueUnproven(p: ValuePos, why: string, span: ASpan, file: string) -> Diag {
        const msg: string = p.what + ": " + why + " — the compiler cannot prove it writes no reactive cell, and a value position fails closed (§6.15). Call a declared scrml function by its name."
        return newDiag(valueUnprovenCode(), msg, file, span)
    }

    // =========================================================================
    // s449 — `reset-on=[@a, @b]` (SPEC §6.8.4): "When any listed cell changes
    // … the runtime SHALL perform `reset(@self)`". The static rules — "Rules 2,
    // 3, 5 and 6 are compile-time errors; none of them is deferred to run time":
    //   2  every entry "a declared, mutable, non-derived reactive cell in scope
    //      at the declaration" (an empty list too) — E-RESET-ON-INVALID-ENTRY;
    //   3  the entry → reset-cell graph is acyclic ("including a cell listing
    //      itself") — E-RESET-ON-CYCLE, naming the cells on the cycle;
    //   5  the cell's contract admits the reset write (`reset(@x)` is a replace)
    //      — a locked or derived cell is E-RESET-ON-NOT-WRITABLE;
    //   6  on a cell with a `rule=` graph, "Every state other than the target
    //      itself SHALL admit the target in its `rule=`" — else
    //      E-RESET-ON-ENGINE-REFUSED naming every refusing state and the target;
    //      a non-literal target means every variant is a target (fail closed).
    // The bootstrap reads `reset-on=` on PROGRAM cells (a field of a user
    // declaration is refused — per-instance resets are OPEN, openerWordDiags).
    // A rule that passes is a ResetOnInfo; `rank` orders a chain (rule 4).
    // =========================================================================
    type RResets:struct = { infos: ResetOnInfo[], st: AS }
    type ResetEdge:struct = { target: int, triggers: int[], span: ASpan }

    fn resetOnPass(g: Globals, st0: AS) -> RResets {
        let st: AS = st0
        const prog: DeclSrc | not = findDeclSrc(g, g.program)
        if (prog is not) return { infos: [], st: st }
        const p: AProgram | not = prog.p
        if (p is not) return { infos: [], st: st }
        let edges: ResetEdge[] = []
        for (const it of p.items) {
            for (const d of declsOfItem(it)) {
                if (!isNestedUserDecl(d)) {
                    for (const a of d.mods) {
                        if (a.name == "reset-on") {
                            const r: RResetEdge = resetEdgeOf(g, prog, d, a, st)
                            st = r.st
                            const e: ResetEdge | not = r.e
                            if (e is given) edges = edges.concat([e])
                        }
                    }
                }
            }
        }
        // rule 3 — an edge on a cycle is refused (reported once per cycle)
        let onCycle: int[] = []
        for (const e of edges) {
            if (onCycle.indexOf(e.target) < 0) {
                const cyc: int[] = cycleFrom(edges, e.target, e.target, [])
                if (cyc.length > 0) {
                    st = addDiag(st, prog.file, e.span, "E-RESET-ON-CYCLE", "the `reset-on=` rules form a cycle: " + cycleText(prog.info, cyc) + " — a reset chain must end; drop one of these entries (§6.8.4 rule 3)")
                    onCycle = onCycle.concat(cyc)
                }
            }
        }
        let infos: ResetOnInfo[] = []
        for (const e of edges) {
            if (onCycle.indexOf(e.target) < 0) infos = infos.concat([{ target: e.target, triggers: e.triggers, rank: rankOf(edges, e.target, []) }])
        }
        return { infos: infos, st: st }
    }

    type RResetEdge:struct = { e: ResetEdge | not, st: AS }

    fn resetEdgeOf(g: Globals, prog: DeclSrc, d: ADecl, a: AAttr, st0: AS) -> RResetEdge {
        let st: AS = st0
        const target: int = fieldIndex(prog.info, d.name)
        if (target < 0) return { e: not, st: st }
        const es: AExpr[] | not = resetEntries(a.value)
        if (es is not) return { e: not, st: addDiag(st, prog.file, a.span, "E-RESET-ON-INVALID-ENTRY", "`reset-on=` takes a bracketed list of cells, `reset-on=[@a, @b]` (§6.8.4)") }
        if (es.length == 0) return { e: not, st: addDiag(st, prog.file, a.span, "E-RESET-ON-INVALID-ENTRY", "`reset-on=[]` lists no cell — the reset would never happen; list the cells whose changes reset `@" + d.name + "` (§6.8.4 rule 2)") }
        let triggers: int[] = []
        let ok = true
        for (const x of es) {
            const why: string = entryProblem(prog.info, x)
            if (why != "") {
                st = addDiag(st, prog.file, x.span, "E-RESET-ON-INVALID-ENTRY", why + " (§6.8.4 rule 2: every entry is a declared, mutable, non-derived reactive cell in scope)")
                ok = false
            } else {
                triggers = triggers.concat([fieldIndex(prog.info, atName(x))])
            }
        }
        const f: FieldInfo = prog.info.fields[target]
        const gr: TransitionGraph | not = f.graph
        if (gr is given) {
            const refused: string = engineRefusals(g, gr, f.init)
            if (refused != "") {
                st = addDiag(st, prog.file, a.span, "E-RESET-ON-ENGINE-REFUSED", "`reset-on=` on `@" + d.name + "` resets it along its `rule=` graph, and every state other than the reset target must admit the target: " + refused + " (§6.8.4 rule 6) — add the target to those states' `rule=`")
                ok = false
            }
        } else if (!f.grants.replace) {
            st = addDiag(st, prog.file, a.span, "E-RESET-ON-NOT-WRITABLE", notWritableMessage(d.name, f.mode))
            ok = false
        }
        if (!ok) return { e: not, st: st }
        return { e: { target: target, triggers: triggers, span: a.span }, st: st }
    }

    fn resetEntries(v: AAttrValue) -> AExpr[] | not {
        return match v {
            .Bare(e: e) :> arrayItems(e)
            .Paren(e: e) :> not
            .NoValue :> not
            .Quoted(v: s) :> not
            .Braced(b: b) :> not
        }
    }

    fn arrayItems(e: AExpr) -> AExpr[] | not {
        const es: AExpr[] = arrayElems(e)
        if (es.length > 0) return es
        const k: AExprK = e.k
        return match k {
            .ArrayLit(elems: xs) :> xs
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: s) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .Assign(target: t) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Index(obj: o) :> not
            .Lambda(params: ps) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
        }
    }

    // Why `x` is not a valid entry ("" — it is one).
    fn entryProblem(pi: DeclInfo, x: AExpr) -> string {
        const n: string = atName(x)
        if (n == "") return "a `reset-on=` entry is a cell written `@name` — this entry is not one"
        const i: int = fieldIndex(pi, n)
        if (i < 0) return "`@" + n + "` is not a declared cell in scope"
        const f: FieldInfo = pi.fields[i]
        const w: Sym | not = f.wcap
        if (w is given) return ""
        const m: FieldMode = f.mode
        return match m {
            .Derived :> "`@" + n + "` is a DERIVED cell — it has no change event of its own; list the cells it is computed from"
            .Locked :> "`@" + n + "` is a LOCKED cell — it never changes"
            .Let :> "`@" + n + "` is not a mutable cell"
            .Seeded :> "`@" + n + "` is not a mutable cell"
        }
    }

    fn notWritableMessage(name: string, m: FieldMode) -> string {
        const what: string = match m {
            .Derived :> "a DERIVED cell (its value is computed from other cells)"
            .Locked :> "a LOCKED cell (no `let`, so no write is granted)"
            .Let :> "a cell whose contract grants no replace"
            .Seeded :> "a cell whose contract grants no replace"
        }
        return "`reset-on=` on `@" + name + "` — the reset is a write, `reset(@" + name + ")`, a replace (§66.11), and `@" + name + "` is " + what + "; make it writable (`let`) or drop `reset-on=` (§6.8.4 rule 5)"
    }

    // Rule 6: the states that refuse the reset target(s), as a message ("" — none).
    // The target is the initializer's variant; a non-literal initializer makes
    // every variant a possible target (fail closed).
    fn engineRefusals(g: Globals, gr: TransitionGraph, init: AAttrValue) -> string {
        const ti: TypeInfo | not = typeInfoOf(g.types, gr.enumSym)
        if (ti is not) return ""
        const vs: VariantDef[] = enumVariants(ti.def)
        let targets: int[] = []
        const lit: string = initVariant(init)
        const t: int = variantIndex(g.types, gr.enumSym, lit)
        if (lit != "" && t >= 0) {
            targets = [t]
        } else {
            let i = 0
            for (const v of vs) {
                targets = targets.concat([i])
                i = i + 1
            }
        }
        let out: string[] = []
        let s = 0
        for (const v of vs) {
            const admits: int[] = edgeTargets(gr, s)
            for (const tgt of targets) {
                if (tgt != s && admits.indexOf(tgt) < 0) {
                    out = out.concat(["`." + v.sym.hint + "` has " + ruleText(vs, admits) + "; it does not admit the reset target `." + vs[tgt].sym.hint + "`"])
                }
            }
            s = s + 1
        }
        return out.join("; ")
    }

    fn initVariant(v: AAttrValue) -> string {
        return match v {
            .Bare(e: e) :> variantLitName(e.k)
            .Paren(e: e) :> variantLitName(e.k)
            .NoValue :> ""
            .Quoted(v: s) :> ""
            .Braced(b: b) :> ""
        }
    }

    fn edgeTargets(gr: TransitionGraph, origin: int) -> int[] {
        for (const e of gr.edges) {
            if (e.origin == origin) return e.targets
        }
        return []
    }

    fn ruleText(vs: VariantDef[], targets: int[]) -> string {
        if (targets.length == 0) return "no `rule=` (no outgoing edge)"
        let names: string[] = []
        for (const t of targets) { names = names.concat(["." + vs[t].sym.hint]) }
        return "`rule=" + names.join(" | ") + "`"
    }

    // A cycle through `at` back to `start` in the reset-on graph (trigger →
    // reset cell): the cells on it, in order, or [] when there is none.
    fn cycleFrom(edges: ResetEdge[], start: int, at: int, path: int[]) -> int[] {
        for (const e of edges) {
            if (e.triggers.indexOf(at) >= 0) {
                if (e.target == start) return path.concat([at])
                if (path.indexOf(e.target) < 0 && e.target != at) {
                    const c: int[] = cycleFrom(edges, start, e.target, path.concat([at]))
                    if (c.length > 0) return c
                }
            }
        }
        return []
    }

    fn cycleText(pi: DeclInfo, cyc: int[]) -> string {
        let parts: string[] = []
        for (const i of cyc) { parts = parts.concat(["`@" + pi.fields[i].sym.hint + "`"]) }
        if (cyc.length == 1) return parts[0] + " lists itself"
        return parts.join(" → ") + " → " + parts[0]
    }

    // A cell's depth in the (acyclic) reset-on graph: 0 when none of its
    // triggers is itself reset, else one more than the deepest trigger.
    fn rankOf(edges: ResetEdge[], target: int, seen: int[]) -> int {
        let best: int = 0
        for (const e of edges) {
            if (e.target == target) {
                for (const t of e.triggers) {
                    if (seen.indexOf(t) < 0 && isResetTarget(edges, t)) {
                        const r: int = rankOf(edges, t, seen.concat([target])) + 1
                        if (r > best) best = r
                    }
                }
            }
        }
        return best
    }

    fn isResetTarget(edges: ResetEdge[], i: int) -> boolean {
        for (const e of edges) {
            if (e.target == i) return true
        }
        return false
    }

    // =========================================================================
    // s451 — `persist="local" | "session"` + `key=` (SPEC §6.14) on a PROGRAM
    // cell — the §6.8.4 opener position: "In the §66 opener it is a
    // **modifier** — the same class as `debounced=` (§6.13), `persist=` (§6.14)
    // and validators". Governing sentences and every refusal's search are in
    // docs/changes/s451-boot-u5-persist/progress.md. Codes:
    //   E-PERSIST-STORAGE-UNKNOWN  §6.14.1 r1 — a value other than "local" / "session"
    //   E-PERSIST-KEY-REQUIRED     §6.14.1 r2 — `persist=` without `key=`
    //   E-PERSIST-WITH-SERVER      §6.14.3 r3 — `server` on the same cell
    //   E-PREPAINT-WITHOUT-PERSIST §6.14.4.2 r2 — `prepaint` without `persist=`
    //   E-HOLD-WITHOUT-PERSIST     §6.14.4.3 r2 — `hold=@x` naming no `persist=` cell
    // Refused (E-BOOTSTRAP-UNSUPPORTED), never accepted-and-ignored: `prepaint`
    // and `hold=` on a persisted cell (no pre-paint script); a computed `key=`
    // (O-061-9); a locked or derived cell (O-061-10); `"local"` on a cell whose
    // contract refuses a whole-value write, and a `"local"` cell as a
    // `reset-on=` trigger (O-061-5; §6.8.4 rule 7); a type with no §57 wire
    // descriptor or holding a FIXED-length sequence; two cells sharing one
    // storage + key; `key=` without `persist=`.
    // E-PERSIST-LIN / -REVEALED cannot be written in the bootstrap (no `lin`
    // cell, no `reveal`); E-PERSIST-DRAFT-OVERWRITTEN needs `<request>` (refused).
    // =========================================================================
    type RPersists:struct = { infos: PersistInfo[], st: AS }
    type RPersist:struct = { info: PersistInfo | not, st: AS }

    fn persistPass(g: Globals, files: FileAst[], st0: AS) -> RPersists {
        let st: AS = st0
        const prog: DeclSrc | not = findDeclSrc(g, g.program)
        if (prog is not) return { infos: [], st: st }
        const p: AProgram | not = prog.p
        if (p is not) return { infos: [], st: st }
        const errs: ASpan[] = fileErrs(files, prog.file)
        let infos: PersistInfo[] = []
        // every program cell that WRITES `persist=` (accepted or not) — what `hold=` names
        let declared: string[] = []
        for (const it of p.items) {
            for (const d of declsOfItem(it)) {
                if (!isNestedUserDecl(d) && !hasErrIn(errs, d.span)) {
                    if (attrNamed(d.mods, "persist") is given) declared = declared.concat([d.name])
                    const r: RPersist = persistOf(g, prog, d, st)
                    st = r.st
                    const pi: PersistInfo | not = r.info
                    if (pi is given) {
                        const other: string = keyHolder(infos, pi.persist)
                        if (other != "") {
                            st = addDiag(st, prog.file, d.span, "E-BOOTSTRAP-UNSUPPORTED", "`@" + d.name + "` and `@" + other + "` persist under the same key \"" + pi.persist.key + "\" in the same storage — each would restore and overwrite the other's value; the SPEC names no code for it (`key=` is \"an external storage contract\", §6.14.1 rule 2), so the bootstrap refuses it — give each cell its own key")
                        } else {
                            infos = infos.concat([pi])
                        }
                    }
                }
            }
        }
        // §6.8.4 rule 7: "whether a cross-tab `storage`-event write to a
        // trigger is a change follows O-061-5" (OPEN) — refused.
        for (const it of p.items) {
            for (const d of declsOfItem(it)) {
                if (!isNestedUserDecl(d)) {
                    for (const a of d.mods) {
                        if (a.name == "reset-on") st = syncedTriggerDiags(prog.file, d, a, infos, st)
                    }
                }
            }
        }
        st = holdDiags(files, declared, st)
        return { infos: infos, st: st }
    }

    fn syncedTriggerDiags(file: string, d: ADecl, a: AAttr, infos: PersistInfo[], st0: AS) -> AS {
        let st: AS = st0
        const es: AExpr[] | not = resetEntries(a.value)
        if (es is not) return st
        for (const x of es) {
            const n: string = atName(x)
            if (n != "" && isSyncedCell(infos, n)) {
                st = addDiag(st, file, x.span, "E-BOOTSTRAP-UNSUPPORTED", "`reset-on=` on `@" + d.name + "` lists `@" + n + "`, a `persist=\"local\"` cell another tab can write — whether that cross-tab write is a change that resets `@" + d.name + "` is OPEN (§6.8.4 rule 7, O-061-5); use `persist=\"" + sessionWord() + "\"` (no cross-tab sync) or drop the entry")
            }
        }
        return st
    }

    fn isSyncedCell(infos: PersistInfo[], name: string) -> boolean {
        for (const i of infos) {
            if (i.sym.hint == name && i.persist.store == PersistStore.Local) return true
        }
        return false
    }

    // The cell already persisted under `ps`'s storage + key ("" — none).
    fn keyHolder(infos: PersistInfo[], ps: Persist) -> string {
        for (const i of infos) {
            if (i.persist.key == ps.key && i.persist.store == ps.store) return i.sym.hint
        }
        return ""
    }

    fn persistOf(g: Globals, prog: DeclSrc, d: ADecl, st0: AS) -> RPersist {
        let st: AS = st0
        const pm: AAttr | not = attrNamed(d.mods, "persist")
        const km: AAttr | not = attrNamed(d.mods, "key")
        const pp: AAttr | not = attrNamed(d.mods, "prepaint")
        if (pm is not) {
            if (pp is given) st = addDiag(st, prog.file, pp.span, "E-PREPAINT-WITHOUT-PERSIST", "`prepaint` on `@" + d.name + "`, which has no `persist=` — REFLECT pre-paints a STORED value, so it needs `persist=\"local\"` or `\"" + sessionWord() + "\"` + `key=` on the same cell (§6.14.4.2 rule 2)")
            if (km is given) st = addDiag(st, prog.file, km.span, "E-BOOTSTRAP-UNSUPPORTED", "`key=` on `@" + d.name + "`, which has no `persist=` — a storage key means nothing without a storage; add `persist=\"local\"` or `\"" + sessionWord() + "\"` (§6.14.1)")
            return { info: not, st: st }
        }
        let ok = true
        const store: PersistStore | not = storeOf(pm.value)
        if (store is not) {
            st = addDiag(st, prog.file, pm.span, "E-PERSIST-STORAGE-UNKNOWN", "`persist=` takes \"local\" (localStorage) or \"" + sessionWord() + "\" (sessionStorage) — " + storeText(pm.value) + " is neither (§6.14.1 rule 1; \"cookie\" is deferred, and IndexedDB is a planned stdlib addition, not a `persist=` value)")
            ok = false
        }
        let key: string = ""
        if (km is not) {
            st = addDiag(st, prog.file, pm.span, "E-PERSIST-KEY-REQUIRED", "`persist=` on `@" + d.name + "` has no `key=` — the storage key is an external contract the author writes, never derived from the cell's name (a rename would silently drop every user's saved value): add `key=\"app." + d.name + "\"` or similar (§6.14.1 rule 2)")
            ok = false
        } else {
            const kv: string | not = quotedOf(km.value)
            if (kv is not) {
                st = addDiag(st, prog.file, km.span, "E-BOOTSTRAP-UNSUPPORTED", "a computed `key=` on `@" + d.name + "` is not in the bootstrap — a per-instance key expression is OPEN (O-061-9); write the key as a quoted string")
                ok = false
            } else if (kv == "") {
                // SPEC silent on an empty key (§6.14.1 r2 only requires one) — refused
                st = addDiag(st, prog.file, km.span, "E-BOOTSTRAP-UNSUPPORTED", "`key=\"\"` on `@" + d.name + "` names no storage key — the SPEC does not say whether an empty key is one (§6.14.1 rule 2), so the bootstrap refuses it; write a non-empty key")
                ok = false
            } else {
                key = kv
            }
        }
        const sv: AAttr | not = attrNamed(d.mods, "server")
        if (sv is given) {
            st = addDiag(st, prog.file, pm.span, "E-PERSIST-WITH-SERVER", "`persist=` on `@" + d.name + "`, a server-authority cell — it is already durable, and browser persistence is legal only where authority is local (§6.14.3 rule 3)")
            ok = false
        }
        if (pp is given) {
            st = addDiag(st, prog.file, pp.span, "E-BOOTSTRAP-UNSUPPORTED", "`prepaint` (REFLECT, §6.14.4.2) is not in the bootstrap — it emits no pre-paint script; drop `prepaint` (the cell restores when the client runs, §6.14.2 rule 7)")
            ok = false
        }
        const i: int = fieldIndex(prog.info, d.name)
        if (i < 0) return { info: not, st: st }
        const f: FieldInfo = prog.info.fields[i]
        const why: string = persistCellProblem(g, f, store, st)
        if (why != "") {
            st = addDiag(st, prog.file, pm.span, "E-BOOTSTRAP-UNSUPPORTED", "`persist=` on `@" + d.name + "` — " + why)
            ok = false
        }
        if (!ok) return { info: not, st: st }
        if (store is given) return { info: { sym: f.sym, persist: { store: store, key: key } }, st: st }
        return { info: not, st: st }
    }

    // Why the bootstrap refuses to persist `f` ("" — it does not).
    fn persistCellProblem(g: Globals, f: FieldInfo, store: PersistStore | not, st: AS) -> string {
        const m: FieldMode = f.mode
        if (f.wcap is not) {
            return match m {
                .Derived :> "a DERIVED cell (its value is computed); persisting one is OPEN (O-061-10)"
                .Locked :> "a LOCKED cell never changes, and no rule says what a restore does to one; make it writable (`let`)"
                .Let :> "a cell whose contract grants no write"
                .Seeded :> "a cell whose contract grants no write"
            }
        }
        if (store is given && store == PersistStore.Local && (f.graph is given || !f.grants.replace)) {
            return "another tab's value reaches a `persist=\"local\"` cell as one whole-value write, and this cell's contract refuses one (" + contractText(f) + ") — whether its contract judges that write or it is applied like a restore is OPEN (O-061-5); use `persist=\"" + sessionWord() + "\"` (no cross-tab sync)"
        }
        // r8: an unresolved type is never checked against
        if (st.bad.fields.indexOf(f.sym.id) >= 0) return ""
        const wb: WireBuild = wireBuild(typesProgram(g), f.ty)
        const wt: WireTable | not = wb.table
        if (wt is not) return "its type has no §57 wire form in the bootstrap codec: " + wb.why.join("; ")
        if (hasFixedLength(wt)) return "its type holds a FIXED-length sequence — the length is fixed by construction, and no rule says whether a restored value may bring another length"
        return ""
    }

    fn contractText(f: FieldInfo) -> string {
        if (f.graph is given) return "a `rule=` graph"
        return "no `replace` grant"
    }

    // The program's type definitions as a CoreProgram — all the codec reads.
    fn typesProgram(g: Globals) -> CoreProgram {
        let defs: TypeDef[] = []
        for (const t of g.types) { defs = defs.concat([t.def]) }
        return { program: g.program, decls: [], types: defs, fns: [], server: [], dbs: [], reset: true, sqlError: not, serverCallError: not }
    }

    fn storeOf(v: AAttrValue) -> PersistStore | not {
        const s: string | not = quotedOf(v)
        if (s is not) return not
        if (s == "local") return PersistStore.Local
        if (s == sessionWord()) return PersistStore.Session
        return not
    }

    fn quotedOf(v: AAttrValue) -> string | not {
        return match v {
            .Quoted(v: s) :> s
            .Bare(e: e) :> not
            .Paren(e: e) :> not
            .NoValue :> not
            .Braced(b: b) :> not
        }
    }

    fn storeText(v: AAttrValue) -> string {
        return match v {
            .Quoted(v: s) :> "\"" + s + "\""
            .Bare(e: e) :> "an unquoted value"
            .Paren(e: e) :> "a computed value"
            .NoValue :> "no value"
            .Braced(b: b) :> "a block"
        }
    }

    // §6.14.4.3 rule 2 — `hold=@cell`, wherever markup is written. A cell's
    // own declaration's fields shadow program cells of the same name.
    fn holdDiags(files: FileAst[], declared: string[], st0: AS) -> AS {
        let st: AS = st0
        for (const f of files) {
            for (const it of f.items) { st = holdInItem(f.path, it, declared, [], st) }
        }
        return st
    }

    fn holdInItem(file: string, it: AItem, declared: string[], shadow: string[], st0: AS) -> AS {
        let st: AS = st0
        const k: AItemK = it.k
        const ns: ANode[] = match k {
            .MarkupItem(n: n) :> [n]
            .ImportItem(i: i) :> []
            .TypeItem(t: t) :> []
            .FnItem(f: f) :> []
            .DeclItem(d: d) :> []
            .ProgramItem(p: p) :> []
        }
        for (const n of ns) { st = holdInNode(file, n, declared, shadow, st) }
        for (const d of declsOfItem(it)) { st = holdInDecl(file, d, declared, shadow, st) }
        const ps: AItem[] = match k {
            .ProgramItem(p: p) :> p.items
            .MarkupItem(n: n) :> []
            .ImportItem(i: i) :> []
            .TypeItem(t: t) :> []
            .FnItem(f: f) :> []
            .DeclItem(d: d) :> []
        }
        for (const x of ps) { st = holdInItem(file, x, declared, shadow, st) }
        return st
    }

    fn holdInDecl(file: string, d: ADecl, declared: string[], shadow0: string[], st0: AS) -> AS {
        let st: AS = st0
        let shadow: string[] = shadow0
        if (isNestedUserDecl(d)) {
            for (const a of d.attrs) { shadow = shadow.concat([a.name]) }
            for (const c of childFields(d.body)) { shadow = shadow.concat([c.name]) }
        }
        const r: AElem | not = d.renders
        if (r is given) st = holdInElem(file, r, declared, shadow, st)
        for (const c of d.body) {
            const ch: ADeclChild = c
            const kids: ANode[] = match ch {
                .ChildField(d: x) :> []
                .StateChild(s: s) :> s.body
            }
            for (const n of kids) { st = holdInNode(file, n, declared, shadow, st) }
        }
        for (const c of childFields(d.body)) { st = holdInDecl(file, c, declared, shadow, st) }
        return st
    }

    fn holdInNode(file: string, n: ANode, declared: string[], shadow: string[], st: AS) -> AS {
        const k: ANodeK = n.k
        return match k {
            .Elem(e: e) :> holdInElem(file, e, declared, shadow, st)
            .DeclNode(d: d) :> holdInDecl(file, d, declared, shadow, st)
            .Text(text: t) :> st
            .Interp(e: x) :> st
            .Effect(w: w) :> st
        }
    }

    fn holdInElem(file: string, e: AElem, declared: string[], shadow: string[], st0: AS) -> AS {
        let st: AS = st0
        for (const a of e.attrs) {
            if (a.name == "hold") st = holdAttrDiag(file, a, declared, shadow, st)
        }
        for (const n of e.kids) { st = holdInNode(file, n, declared, shadow, st) }
        return st
    }

    fn holdAttrDiag(file: string, a: AAttr, declared: string[], shadow: string[], st: AS) -> AS {
        const x: AExpr | not = valueExpr(a.value)
        let n: string = ""
        if (x is given) n = atName(x)
        if (n == "") return addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`hold=` takes one persisted cell, `hold=@cell` — any other operand form is OPEN (O-062-10)")
        if (declared.indexOf(n) >= 0 && shadow.indexOf(n) < 0) {
            return addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`hold=@" + n + "` (HOLD, §6.14.4.3) is not in the bootstrap — it emits no pre-paint script, so nothing would be held; drop `hold=` (the region shows the default until the client restores `@" + n + "`, §6.14.2 rule 7)")
        }
        return addDiag(st, file, a.span, "E-HOLD-WITHOUT-PERSIST", "`hold=@" + n + "` — `@" + n + "` is not a `persist=` cell, and a region is held only until a STORED value is restored (§6.14.4.3 rule 2); a general \"cloak until rendered\" marker is not this attribute")
    }

    // s449: an effect at FILE level (outside `<program>`) has no element scope to
    // own it — refused, never silently dropped (no pass reaches file-level markup).
    fn strayEffects(files: FileAst[], st0: AS) -> AS {
        let st: AS = st0
        for (const f of files) {
            for (const it of f.items) {
                for (const n of markupOf(it)) {
                    for (const sp of effectSpans(n)) {
                        st = addDiag(st, f.path, sp, "E-BOOTSTRAP-UNSUPPORTED", "an effect outside `<program>` — no element scope owns it (§6.7.4); move it into the program")
                    }
                }
            }
        }
        return st
    }

    fn effectSpans(n: ANode) -> ASpan[] {
        const k: ANodeK = n.k
        return match k {
            .Effect(w: w) :> [w.span]
            .Elem(e: e) :> kidEffectSpans(e.kids)
            .Text(text: t) :> []
            .Interp(e: x) :> []
            .DeclNode(d: d) :> []
        }
    }

    fn kidEffectSpans(ns: ANode[]) -> ASpan[] {
        let out: ASpan[] = []
        for (const n of ns) { out = out.concat(effectSpans(n)) }
        return out
    }

    // =========================================================================
    // s451 (U1a) — ROUTE PLACEMENT, `?{}` AND THE DATABASES (placePass).
    // Design authority: scrml-support/docs/deep-dives/bootstrap-u1-server-
    // boundary-design-2026-10-03.md §1, §2, §5 — superseded where the S451
    // rulings say so (user-voice-scrml.md §S451; normative in SPEC). The
    // governing sentences, quoted (docs/changes/s451-boot-u1a/progress.md has
    // the full list and every reading this pass takes):
    //  §12.1 "The compiler SHALL decide where each function executes. The
    //        default is client-side execution."
    //  §12.2 "SHALL escalate a function to a server route if ANY of": T1 "The
    //        function accesses a resource not accessible from the client" (a
    //        `?{}` — §8.5.4 "any function that contains a `?{}` block is
    //        server-escalated"); T4 "an explicit `server` annotation (§52.10).
    //        DEPRECATED" (T2 protected fields and T3 server-only stdlib imports
    //        have no source form in the bootstrap — `protect=` / stdlib imports
    //        are not in it; T5 is emission — design §2 "Trigger 5 is emission,
    //        not inference" — and T6/T7/T8 have no bootstrap surface).
    //  §52.10 "During the deprecation window, the parser SHALL accept `server
    //        function` declarations and emit `W-DEPRECATED-SERVER-MODIFIER`."
    //  §19.9.5 "A function whose body mixes a server-trigger statement with a
    //        reactive-assignment statement is split across the client/server
    //        boundary" — the SPLIT (CPS); §6.6.9 "A function that also performs
    //        a reactive assignment (`@cell = …`) is CPS-split — a CLIENT
    //        function with an embedded server round-trip." Detected here,
    //        REFUSED until unit U1d builds the body split.
    //  §6.6.9 "A WHOLLY server-escalated function body that READS a client
    //        cell … SHALL be a compile error, E-REACTIVE-003."
    //  §34 E-RI-002 "Server-escalated function mutates `@` reactive variable"
    //        — a wholly-server body that writes a cell (only the deprecated
    //        `server` modifier makes a writing body wholly server: without it
    //        the write splits the body, §19.9.5).
    //  §12.4 (S451 R2) "A server-escalated function whose static call graph
    //        reaches such an access through a callee, directly or
    //        transitively, SHALL be E-ROUTE-002, and the message SHALL name
    //        the chain down to the function that touches the cell and the
    //        cell itself."
    //  §12.4 (S451 R3) "A function that the compiler cannot fully analyze for
    //        route placement SHALL be a compile error (E-ROUTE-001)."
    //  §12.4 E-ROUTE-005: "A single function whose own body accesses BOTH a
    //        server-only resource … AND a client-only global (a DOM global
    //        with no server-side referent) … The DOM globals recognized … are
    //        … (`document`, `window`); an access rooted at a name bound by an
    //        in-scope local, parameter, or import is a domain object".
    //  §12.5.3 E-ROUTE-003 / E-ROUTE-004: non-serializable return / parameter
    //        types of a server function (judged against the §57 codec).
    //  §13.7 (S451 R1) "A value position … SHALL NOT contain an expression
    //        whose value arrives only after the program waits … E-VALUE-
    //        SERVER-CALL": a server call, a client function that reaches one,
    //        a `?{}` written in the position (a Promise-returning stdlib call
    //        has no source form in the bootstrap).
    //  §19.8.3 (S451 R11) "Outside a `!` function it is treated exactly like a
    //        call to a `!` function whose error type is `SqlError` … an
    //        unhandled `?{}` SHALL be a compile error, E-ERROR-002."
    //  §8.1.1 / §44.2 "If no ancestor `<program>` has a `db=` attribute, the
    //        `?{}` block SHALL be a compile error (E-SQL-004)"; "An
    //        unrecognized prefix SHALL be a compile error (E-SQL-005)".
    // Placement is decided over binder facts (Syms) — never names, never text
    // (§12.4 "SHALL NOT classify a function based on … string-literal
    // contents" holds by construction).
    // =========================================================================
    // A `?{}` site: the node, its query, where.
    type SqlSite:struct = { nid: int, span: ASpan, q: ASql }
    // A client-state access in a body: what (as the author spells it), where.
    type CellUse:struct = { what: string, span: ASpan }
    // One function's direct facts (its own body only).
    type FnFacts:struct = {
        sym: int, name: string, file: string, span: ASpan, nid: int,
        modifier: boolean, failable: boolean,
        sqls: SqlSite[], reads: CellUse[], doms: CellUse[], scan: BodyScan,
    }
    // A chain from a function down to a site (display labels, outermost first).
    type Reach:struct = { chain: string[], what: string }
    type PlaceCx:struct = { t: Tables, g: Globals }
    // `doms`: where an E-ROUTE-005 function names a DOM global — the binder's
    // E-SCOPE-001 for that name is replaced by the placement error (one report).
    type RPlaced:struct = { facts: ServerFacts, doms: int[], st: AS }

    // ---- the direct facts ----------------------------------------------------
    // Every `?{}` in a block / expression, at any depth (a lambda included).
    fn sqlsInBlock(b: ABlock) -> SqlSite[] {
        let out: SqlSite[] = []
        for (const s of b.stmts) { out = out.concat(sqlsInStmt(s)) }
        return out
    }

    fn sqlsInStmt(s: AStmt) -> SqlSite[] {
        const k: AStmtK = s.k
        return match k {
            .Eval(e: e) :> sqlsInExpr(e)
            .Local(name: n, init: i) :> sqlsInExpr(i)
            .Return(e: e) :> sqlsInMaybe(e)
            .If(cond: c, thenB: tb, elseB: eb) :> sqlsInExpr(c).concat(sqlsInBlock(tb)).concat(sqlsInMaybeBlock(eb))
            .Given(name: n, subject: x, body: b) :> sqlsInExpr(x).concat(sqlsInBlock(b))
            .EffectStmt(w: w) :> sqlsInBlock(w.body)
            .Defer(body: b) :> sqlsInBlock(b)
            .Fail(f: f) :> sqlsInExprs(failExprs(f))
        }
    }

    fn sqlsInMaybe(e: AExpr | not) -> SqlSite[] {
        if (e is not) return []
        return sqlsInExpr(e)
    }

    fn sqlsInMaybeBlock(b: ABlock | not) -> SqlSite[] {
        if (b is not) return []
        return sqlsInBlock(b)
    }

    fn sqlsInExpr(e: AExpr) -> SqlSite[] {
        let out: SqlSite[] = []
        const q: ASql | not = sqlOfK(e.k)
        if (q is given) out = [{ nid: e.nid, span: e.span, q: q }]
        for (const x of exprKids(e)) { out = out.concat(sqlsInExpr(x)) }
        for (const b of exprBlocks(e)) { out = out.concat(sqlsInBlock(b)) }   // s451 (Ue): an arm block
        return out
    }

    fn sqlsInExprs(es: AExpr[]) -> SqlSite[] {
        let out: SqlSite[] = []
        for (const x of es) { out = out.concat(sqlsInExpr(x)) }
        return out
    }

    fn sqlsInValue(v: AAttrValue) -> SqlSite[] {
        return match v {
            .Bare(e: e) :> sqlsInExpr(e)
            .Paren(e: e) :> sqlsInExpr(e)
            .Braced(b: b) :> sqlsInBlock(b)
            .Quoted(v: s) :> []
            .NoValue :> []
        }
    }

    fn sqlOfK(k: AExprK) -> ASql | not {
        return match k {
            .Sql(q: q) :> q
            .Handled(h: x) :> not
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: s) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .Assign(target: t) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Index(obj: o) :> not
            .Lambda(params: ps) :> not
        }
    }

    // s451 (Ue): the handling form an expression is, else not.
    fn handledOf(k: AExprK) -> AHandled | not {
        return match k {
            .Sql(q: q) :> not
            .Handled(h: h) :> h
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: s) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .Assign(target: t) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Index(obj: o) :> not
            .Lambda(params: ps) :> not
        }
    }

    // Every READ of client state in a body (a cell, an instance, a validity
    // surface) — the binder's name facts. A write's TARGET is not a read (the
    // write is BodyScan's), and neither is the receiver of an edit call.
    fn readsInBlock(t: Tables, b: ABlock) -> CellUse[] {
        let out: CellUse[] = []
        for (const s of b.stmts) { out = out.concat(readsInStmt(t, s)) }
        return out
    }

    fn readsInStmt(t: Tables, s: AStmt) -> CellUse[] {
        const k: AStmtK = s.k
        return match k {
            .Eval(e: e) :> readsInExpr(t, e)
            .Local(name: n, init: i) :> readsInExpr(t, i)
            .Return(e: e) :> readsInMaybe(t, e)
            .If(cond: c, thenB: tb, elseB: eb) :> readsInExpr(t, c).concat(readsInBlock(t, tb)).concat(readsInMaybeBlock(t, eb))
            .Given(name: n, subject: x, body: b) :> readsInExpr(t, x).concat(readsInBlock(t, b))
            .EffectStmt(w: w) :> []
            .Defer(body: b) :> readsInBlock(t, b)
            .Fail(f: f) :> readsInExprs(t, failExprs(f))
        }
    }

    fn readsInMaybe(t: Tables, e: AExpr | not) -> CellUse[] {
        if (e is not) return []
        return readsInExpr(t, e)
    }

    fn readsInMaybeBlock(t: Tables, b: ABlock | not) -> CellUse[] {
        if (b is not) return []
        return readsInBlock(t, b)
    }

    fn readsInExpr(t: Tables, e: AExpr) -> CellUse[] {
        // an assignment: only its value is read; an edit / reset call: its arguments
        const v: AExpr | not = assignedValue(e)
        if (v is given) return readsInExpr(t, v)
        if (effectFact(t.effects, e.nid) is given) {
            // `reset(@x)`: its argument is the write's target, not a read
            const c: AExpr | not = calleeOf(e.k)
            if (c is given && exprName(c) == "reset") return []
            let acc: CellUse[] = []
            for (const x of exprKids(e).slice(1)) { acc = acc.concat(readsInExpr(t, x)) }
            return acc
        }
        const what: string = clientRead(t, nameFact(t.names, e.nid))
        if (what != "") return [{ what: what, span: e.span }]
        let out: CellUse[] = []
        for (const x of exprKids(e)) { out = out.concat(readsInExpr(t, x)) }
        for (const b of exprBlocks(e)) { out = out.concat(readsInBlock(t, b)) }   // s451 (Ue): an arm block
        return out
    }

    fn readsInExprs(t: Tables, es: AExpr[]) -> CellUse[] {
        let out: CellUse[] = []
        for (const x of es) { out = out.concat(readsInExpr(t, x)) }
        return out
    }

    // The client state a name fact reads ("" — none), as the author spells it.
    fn clientRead(t: Tables, f: NameFact | not) -> string {
        return match f {
            .NField(decl: d, inst: i, idx: x) :> fieldUseLabel(t, d, x)
            .NInst(decl: d) :> "@" + d.hint
            .NSurface(of: v) :> "the validity surface of @" + validityDecl(v).hint
            .NLocal(sym: s) :> ""
            .NStruct(owner: o) :> ""
            .NFn(sym: s) :> ""
            .NLength :> ""
            not :> ""
        }
    }

    fn fieldUseLabel(t: Tables, d: Sym, idx: int) -> string {
        const di: DeclInfo | not = declInfo(t, d)
        if (di is not || idx < 0 || idx >= di.fields.length) return "@" + d.hint
        const f: FieldInfo = di.fields[idx]
        if (di.kind == DeclKind.Program) return "@" + f.sym.hint
        return "@" + d.hint + "." + f.sym.hint
    }

    // §12.4: a DOM global — `document` / `window` named with NO binding (a
    // local, parameter or import of that name is a domain object, and has a
    // name fact). The bootstrap has no DOM API; the binder reports the name
    // (E-SCOPE-001) — this records it as a client-only access for placement.
    fn domsInBlock(t: Tables, b: ABlock) -> CellUse[] {
        let out: CellUse[] = []
        for (const s of b.stmts) { out = out.concat(domsInStmt(t, s)) }
        return out
    }

    fn domsInStmt(t: Tables, s: AStmt) -> CellUse[] {
        const k: AStmtK = s.k
        return match k {
            .Eval(e: e) :> domsInExpr(t, e)
            .Local(name: n, init: i) :> domsInExpr(t, i)
            .Return(e: e) :> domsInMaybe(t, e)
            .If(cond: c, thenB: tb, elseB: eb) :> domsInExpr(t, c).concat(domsInBlock(t, tb)).concat(domsInMaybeBlock(t, eb))
            .Given(name: n, subject: x, body: b) :> domsInExpr(t, x).concat(domsInBlock(t, b))
            .EffectStmt(w: w) :> []
            .Defer(body: b) :> domsInBlock(t, b)
            .Fail(f: f) :> domsInExprs(t, failExprs(f))
        }
    }

    fn domsInMaybe(t: Tables, e: AExpr | not) -> CellUse[] {
        if (e is not) return []
        return domsInExpr(t, e)
    }

    fn domsInMaybeBlock(t: Tables, b: ABlock | not) -> CellUse[] {
        if (b is not) return []
        return domsInBlock(t, b)
    }

    fn domsInExpr(t: Tables, e: AExpr) -> CellUse[] {
        const n: string = exprName(e)
        if ((n == "document" || n == "window") && nameFact(t.names, e.nid) is not && bindFact(t.binds, e.nid) is not) {
            return [{ what: "the DOM global `" + n + "`", span: e.span }]
        }
        let out: CellUse[] = []
        for (const x of exprKids(e)) { out = out.concat(domsInExpr(t, x)) }
        for (const b of exprBlocks(e)) { out = out.concat(domsInBlock(t, b)) }   // s451 (Ue): an arm block
        return out
    }

    fn domsInExprs(t: Tables, es: AExpr[]) -> CellUse[] {
        let out: CellUse[] = []
        for (const x of es) { out = out.concat(domsInExpr(t, x)) }
        return out
    }

    fn fnFacts(cx: PlaceCx, fs: FnSrc) -> FnFacts {
        const scan: BodyScan = scanBlock({ t: cx.t, file: fs.info.file }, fs.f.body, emptyScan())
        return { sym: fs.info.sym.id, name: fs.info.name, file: fs.info.file, span: fs.info.span, nid: fs.info.nid,
                 modifier: fs.f.server, failable: fs.f.failable,
                 sqls: sqlsInBlock(fs.f.body), reads: readsInBlock(cx.t, fs.f.body), doms: domsInBlock(cx.t, fs.f.body), scan: scan }
    }

    // ---- placement -------------------------------------------------------------
    fn serverTriggered(f: FnFacts) -> boolean { return f.sqls.length > 0 || f.modifier }
    fn clientDirect(f: FnFacts) -> boolean { return f.reads.length > 0 || f.scan.writes.length > 0 || f.doms.length > 0 }

    // §12.2 + §19.9.5 / §6.6.9, by the function's OWN body. Calling a server
    // function does not move the caller (design §2: "Calling a Server fn does
    // NOT change the caller's placement … it makes the caller async-colored");
    // reaching a client-only function DOES pin it to the client (§12.4: a
    // client-only function is "any function determined by route analysis to
    // execute exclusively on the client").
    fn directPlace(f: FnFacts) -> PlaceK {
        if (serverTriggered(f)) {
            // §19.9.5: a server trigger + a reactive assignment splits the body —
            // unless the deprecated `server` modifier declares the WHOLE body
            // server (§52.10: "historically forced server-side execution"); a
            // DOM access makes it unplaceable (E-ROUTE-005, judged first)
            if (f.sqls.length > 0 && f.scan.writes.length > 0 && !f.modifier && f.doms.length == 0) return PlaceK.Split
            return PlaceK.Server
        }
        if (clientDirect(f)) return PlaceK.Client
        return PlaceK.Ambient
    }

    fn factsOf(all: FnFacts[], sym: int) -> FnFacts | not {
        for (const f of all) {
            if (f.sym == sym) return f
        }
        return not
    }

    // A symbol no function owns (a declaration a construction reference names)
    // has no placement of its own: Ambient.
    fn placeOf(ps: PlaceFact[], sym: int) -> PlaceK {
        for (const p of ps) {
            if (p.sym == sym) return p.place
        }
        return PlaceK.Ambient
    }

    // The function references (calls and values) a body makes — the scan's
    // refs that name a scrml FUNCTION (a construction / formula reference
    // names a declaration or a field: that is a cell read, recorded already).
    fn fnRefs(all: FnFacts[], f: FnFacts) -> FnRef[] {
        let out: FnRef[] = []
        for (const r of f.scan.refs) {
            if (factsOf(all, r.sym) is given) out = out.concat([r])
        }
        return out
    }

    // THE REACHES — queries over the effect summary (dpa-066 M2; the three
    // fixpoints that computed them are retired). Each is the first chain (the
    // summary's witness) from function `sym` down to:
    //  - clientReachOf (§12.4 R2): a client-state access, through non-server
    //    callees — a server callee is judged on its own (server → server is a
    //    call in place, §13.4); a server function reaches none of its own;
    //  - routeOpenOf (§12.4 R3): a call the analysis cannot resolve, through
    //    non-server callees;
    //  - waitsOf (§13.2, §13.7 item 2): a server or split function — async colour.
    fn clientReachOf(s: Summary, sym: int) -> Reach | not {
        const i: int = nodeIdx(s.nodes, sym)
        if (i < 0) return not
        const a: FxAtom | not = witnessOf(s.client[i])
        if (a is not) return not
        return { chain: fxChain(s, s.client, i, a), what: clientWhats(s.nodes[a.root].f)[a.pos] }
    }

    fn routeOpenOf(s: Summary, sym: int) -> Reach | not {
        const i: int = nodeIdx(s.nodes, sym)
        if (i < 0) return not
        const a: FxAtom | not = witnessOf(s.routeOpen[i])
        if (a is not) return not
        return { chain: fxChain(s, s.routeOpen, i, a), what: s.nodes[a.root].f.scan.unproven[a.pos].what }
    }

    fn waitsOf(s: Summary, sym: int) -> Reach | not {
        const i: int = nodeIdx(s.nodes, sym)
        if (i < 0) return not
        const a: FxAtom | not = witnessOf(s.waits[i])
        if (a is not) return not
        return { chain: fxChain(s, s.waits, i, a), what: "" }
    }

    // The functions' own facts, as the summary read them (one scan per body).
    fn fnFactsOf(s: Summary) -> FnFacts[] {
        let out: FnFacts[] = []
        for (const c of s.nodes) {
            if (c.kind == CallableK.KFn) out = out.concat([c.f])
        }
        return out
    }

    // ---- the databases (§8.1.1 as amended S451, §44.2) ----------------------------
    // s452 — §8.1.1: "The compiler SHALL resolve the database for each `?{}`
    // block by finding its closest ancestor **database scope** — a `<program>`
    // element with a `db=` attribute, a `<program>` element whose database a
    // direct-child `<db src=>` supplies …, or a `<db src=>` state block.
    // 'Closest' means fewest nesting levels up the element tree, counting every
    // kind". Ruling 11a: "When a `<program>` element has no `db=` attribute and
    // exactly one `<db src=>` element is its **direct child**, that `<program>`
    // SHALL be a database scope whose database is the `<db>`'s `src=` value";
    // two or more direct-child `<db src=>` → "NONE of them supplies"; "A
    // `<program db=>` is never supplied". E-SQL-004 "whatever the number of
    // database scopes in the file".
    //
    // ONE walk over every file — items, markup, declarations — carrying the
    // nearest database scope. It records each function's scope (a function is
    // an item of a `<program>` body: the bootstrap has no function declared
    // inside an element), each MARKUP-position `?{}` site's scope (an attribute
    // or handler value, an interpolation, an `<effect>` body, a declaration's
    // value), and every scope's database.
    //
    // A database scope: its node (a `<program>` or a `<db>` element), its
    // database (`not` — the value was refused, reported). A `<program>` a
    // `<db>` supplies and that `<db>` share ONE Db (one database).
    type ScopeDb:struct = { nid: int, db: Db | not }
    // Each function's nearest database scope (-1: none).
    type FnDb:struct = { fnid: int, scope: int }
    // Each markup-position `?{}` site's nearest database scope (-1: none).
    type SiteDb:struct = { nid: int, scope: int }
    type RDbs:struct = { scopes: ScopeDb[], fns: FnDb[], sites: SiteDb[], st: AS }

    fn dbsPass(g: Globals, files: FileAst[], st0: AS) -> RDbs {
        let acc: RDbs = { scopes: [], fns: [], sites: [], st: st0 }
        for (const f of files) { acc = dbsInItems(g, f.path, f.items, -1, acc) }
        return acc
    }

    fn withScope(acc: RDbs, nid: int, db: Db | not, st: AS) -> RDbs {
        return { scopes: acc.scopes.concat([{ nid: nid, db: db }]), fns: acc.fns, sites: acc.sites, st: st }
    }

    fn withSites(acc: RDbs, ss: SqlSite[], scope: int) -> RDbs {
        let sites: SiteDb[] = acc.sites
        for (const x of ss) { sites = sites.concat([{ nid: x.nid, scope: scope }]) }
        return { scopes: acc.scopes, fns: acc.fns, sites: sites, st: acc.st }
    }

    fn dbsInItems(g: Globals, file: string, items: AItem[], scope: int, acc0: RDbs) -> RDbs {
        let acc: RDbs = acc0
        for (const it of items) {
            const k: AItemK = it.k
            const f: AFn | not = fnOfItemK(k)
            if (f is given) acc = { scopes: acc.scopes, fns: acc.fns.concat([{ fnid: f.nid, scope: scope }]), sites: acc.sites, st: acc.st }
            const p: AProgram | not = programOfK(k)
            if (p is given) acc = dbsInProgram(g, file, p, scope, acc)
            const n: ANode | not = markupOfItemK(k)
            if (n is given) acc = dbsInNode(g, file, n, scope, acc)
            const d: ADecl | not = declOfItemK(k)
            if (d is given) acc = dbsInDecl(g, file, d, scope, acc)
        }
        return acc
    }

    // A `<program>`: a database scope on its own `db=`; else on the `src=` of
    // its single direct-child `<db src=>` (ruling 11a); else not a scope.
    fn dbsInProgram(g: Globals, file: string, p: AProgram, outer: int, acc: RDbs) -> RDbs {
        const a: AAttr | not = attrNamed(p.attrs, "db")
        if (a is given) {
            const rd: RDb = dbOfAttr(file, a, acc.st)
            return dbsInItems(g, file, p.items, p.nid, withScope(acc, p.nid, rd.db, rd.st))
        }
        const sup: AElem | not = supplyingDb(g, p.items)
        if (sup is given) {
            const src: AAttr | not = attrNamed(sup.attrs, "src")
            if (src is given) {
                const rs: RDb = dbOfAttr(file, src, acc.st)
                const both: RDbs = withScope(withScope(acc, p.nid, rs.db, rs.st), sup.nid, rs.db, rs.st)
                return dbsInItems(g, file, p.items, p.nid, both)
            }
        }
        return dbsInItems(g, file, p.items, outer, acc)
    }

    // The ONE direct-child `<db src=>` of a program body, else not (none, or
    // two or more — "NONE of them supplies").
    fn supplyingDb(g: Globals, items: AItem[]) -> AElem | not {
        let found: AElem[] = []
        for (const it of items) {
            const n: ANode | not = markupOfItemK(it.k)
            if (n is given) {
                const e: AElem | not = elemOfANode(n)
                if (e is given) {
                    if (isDbElem(g, e) && attrNamed(e.attrs, "src") is given) found = found.concat([e])
                }
            }
        }
        if (found.length == 1) return found[0]
        return not
    }

    // A `<db>` state block (§4 — "`db` is a built-in state type"), unless a
    // user declaration takes the name (the binder's rule: a declaration in
    // scope wins over every built-in reading of a tag).
    fn isDbElem(g: Globals, e: AElem) -> boolean {
        if (e.star || e.tag != "db") return false
        return declNamed(g, e.tag) is not
    }

    fn dbsInNode(g: Globals, file: string, n: ANode, scope: int, acc: RDbs) -> RDbs {
        const k: ANodeK = n.k
        return match k {
            .Elem(e: e) :> dbsInElem(g, file, e, scope, acc)
            .Interp(e: x) :> withSites(acc, sqlsInExpr(x), scope)
            .Effect(w: w) :> withSites(acc, sqlsInBlock(w.body), scope)
            .DeclNode(d: d) :> dbsInDecl(g, file, d, scope, acc)
            .Text(text: t) :> acc
        }
    }

    // An element: its attribute values stand in the scope around it; a `<db
    // src=>` is the scope of its children (registered once — a program's
    // supplier is registered with the program).
    fn dbsInElem(g: Globals, file: string, e: AElem, scope: int, acc0: RDbs) -> RDbs {
        let acc: RDbs = acc0
        for (const a of e.attrs) { acc = withSites(acc, sqlsInValue(a.value), scope) }
        let inner: int = scope
        if (isDbElem(g, e)) {
            const src: AAttr | not = attrNamed(e.attrs, "src")
            if (src is given) {
                if (scopeDbOf(acc.scopes, e.nid) is not) {
                    const rd: RDb = dbOfAttr(file, src, acc.st)
                    acc = withScope(acc, e.nid, rd.db, rd.st)
                }
                inner = e.nid
            }
        }
        for (const c of e.kids) { acc = dbsInNode(g, file, c, inner, acc) }
        return acc
    }

    // A declaration: its own value, its attribute defaults, the opener's other
    // words' values, its validators' arguments, its child fields, its state
    // children, its renders.
    fn dbsInDecl(g: Globals, file: string, d: ADecl, scope: int, acc0: RDbs) -> RDbs {
        let acc: RDbs = withSites(acc0, sqlsInValue(d.own), scope)
        for (const a of d.attrs) { acc = withSites(acc, sqlsInValue(a.dflt), scope) }
        for (const m of d.mods) { acc = withSites(acc, sqlsInValue(m.value), scope) }
        for (const v of d.validators) { acc = withSites(acc, sqlsInExprs(valArgExprs(v.arg)), scope) }
        for (const c of d.body) {
            const ck: ADeclChild = c
            acc = match ck {
                .ChildField(d: cd) :> dbsInDecl(g, file, cd, scope, acc)
                .StateChild(s: sc) :> dbsInStateChild(g, file, sc, scope, acc)
            }
        }
        const r: AElem | not = d.renders
        if (r is given) acc = dbsInElem(g, file, r, scope, acc)
        return acc
    }

    fn dbsInStateChild(g: Globals, file: string, sc: AStateChild, scope: int, acc0: RDbs) -> RDbs {
        let acc: RDbs = acc0
        for (const a of sc.attrs) { acc = withSites(acc, sqlsInValue(a.value), scope) }
        for (const n of sc.body) { acc = dbsInNode(g, file, n, scope, acc) }
        return acc
    }

    fn valArgExprs(a: AValArg) -> AExpr[] {
        return match a {
            .NoArgs :> []
            .Cmp(op: o, e: x) :> [x]
            .Exprs(es: es) :> es
            .Regex(source: x) :> []
        }
    }

    fn markupOfItemK(k: AItemK) -> ANode | not {
        return match k {
            .MarkupItem(n: n) :> n
            .FnItem(f: f) :> not
            .ImportItem(i: i) :> not
            .TypeItem(t: t) :> not
            .DeclItem(d: d) :> not
            .ProgramItem(p: p) :> not
        }
    }

    fn declOfItemK(k: AItemK) -> ADecl | not {
        return match k {
            .DeclItem(d: d) :> d
            .MarkupItem(n: n) :> not
            .FnItem(f: f) :> not
            .ImportItem(i: i) :> not
            .TypeItem(t: t) :> not
            .ProgramItem(p: p) :> not
        }
    }

    fn elemOfANode(n: ANode) -> AElem | not {
        const k: ANodeK = n.k
        return match k {
            .Elem(e: e) :> e
            .Text(text: t) :> not
            .Interp(e: x) :> not
            .DeclNode(d: d) :> not
            .Effect(w: w) :> not
        }
    }

    fn fnOfItemK(k: AItemK) -> AFn | not {
        return match k {
            .FnItem(f: f) :> f
            .ImportItem(i: i) :> not
            .TypeItem(t: t) :> not
            .DeclItem(d: d) :> not
            .MarkupItem(n: n) :> not
            .ProgramItem(p: p) :> not
        }
    }

    fn programOfK(k: AItemK) -> AProgram | not {
        return match k {
            .ProgramItem(p: p) :> p
            .FnItem(f: f) :> not
            .ImportItem(i: i) :> not
            .TypeItem(t: t) :> not
            .DeclItem(d: d) :> not
            .MarkupItem(n: n) :> not
        }
    }

    type RDb:struct = { db: Db | not, st: AS }

    // §8.1.1's driver table (`./path`, `sqlite:`, `:memory:`, `postgres://`,
    // `postgresql://`, `mysql://`; `mongo*` is "NOT VALID for `?{}`"), §44.2,
    // and "A `file:` URI is not a path and SHALL be E-SQL-005". A value that is
    // not a literal is refused (a connection string is configuration, read at
    // compile time).
    fn dbOfAttr(file: string, a: AAttr, st: AS) -> RDb {
        const v: string | not = quotedValue(a.value)
        if (v is not) return { db: not, st: addDiag(st, file, a.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + a.name + "=` must be a literal connection string (`" + a.name + "=\"./app.db\"`, §8.1.1) — the bootstrap reads it at compile time") }
        const why: string = dbRefusal(v)
        if (why != "") return { db: not, st: addDiag(st, file, a.span, "E-SQL-005", "`" + a.name + "=` (" + dbKind(v) + "): " + why + " (§8.1.1, §44.2). A `" + sqlSigil() + "}` runs on SQLite (`./app.db`, `sqlite:./app.db`, `:memory:`), PostgreSQL (`postgres://…`, `postgresql://…`) or MySQL (`mysql://…`)") }
        const r: RSym = mint(st, "db")
        return { db: { sym: r.s, driver: dbDriver(v), target: dbTarget(v), file: file, owner: false }, st: r.st }
    }

    fn quotedValue(v: AAttrValue) -> string | not {
        return match v {
            .Quoted(v: s) :> s
            .NoValue :> not
            .Bare(e: x) :> not
            .Paren(e: x) :> not
            .Braced(b: b) :> not
        }
    }

    // s452 r3 (LOW-B) — a diagnostic SHALL NOT echo a `db=` / `src=` value at
    // all (credentials hide in too many places: userinfo, `?password=`,
    // `;password=`, a jdbc `&password=`, an unencoded `/`). It names what KIND
    // of value it is instead, from the recognized scheme only.
    fn dbKind(v: string) -> string {
        if (v.trim() == "") return "an empty value"
        const scheme: string = schemeOf(v)
        if (scheme == "") return "a SQLite path"
        if (scheme == "sqlite") return "a `sqlite:` path"
        if (scheme == "postgres" || scheme == "postgresql") return "a PostgreSQL connection string"
        if (scheme == "mysql") return "a MySQL connection string"
        if (scheme == "mongo" || scheme == "mongodb") return "a MongoDB URL"
        if (scheme == "file") return "a `file:` URI"
        return "a connection string with an unrecognized prefix"
    }

    // Why a connection string is not a `?{}` database ("" — it is one).
    fn dbRefusal(v: string) -> string {
        if (v.trim() == "") return "an empty connection string names no database"
        const scheme: string = schemeOf(v)
        if (scheme == "") return ""                      // a plain path: implicit `sqlite:`
        if (scheme == "sqlite") {
            if (v.substring(7).trim() == "") return "`sqlite:` names no path"
            return ""
        }
        if (scheme == "postgres" || scheme == "postgresql" || scheme == "mysql") {
            if (v.indexOf("://") != scheme.length) return "a `" + scheme + ":` connection string is a URL (`" + scheme + "://…`)"
            return ""
        }
        if (scheme == "mongo" || scheme == "mongodb") return "MongoDB is not a `" + sqlSigil() + "}` database — use a `^{}` meta context"
        if (scheme == "file") return "a `file:` URI is not a path — write the path itself or `sqlite:<path>`"
        return "its prefix is not a recognized database connection prefix"
    }

    // The URI scheme of a value ("" — none: a path, or `:memory:`).
    fn schemeOf(v: string) -> string {
        if (v == ":memory:") return ""
        const colon: int = v.indexOf(":")
        if (colon <= 0) return ""
        const s: string = v.substring(0, colon)
        let i: int = 0
        while (i < s.length) {
            const c: string = s.substring(i, i + 1)
            const ok: boolean = c.toUpperCase() != c.toLowerCase() || "0123456789+.-".indexOf(c) >= 0
            if (!ok) return ""
            i = i + 1
        }
        // a one-letter "scheme" is a Windows drive path (`C:\…`), not a scheme
        if (s.length == 1) return ""
        return s.toLowerCase()
    }

    fn dbDriver(v: string) -> Driver {
        const s: string = schemeOf(v)
        if (s == "postgres" || s == "postgresql") return Driver.Postgres
        if (s == "mysql") return Driver.Mysql
        return Driver.Sqlite
    }

    fn dbTarget(v: string) -> string {
        if (schemeOf(v) == "sqlite") return v.substring(7)
        return v
    }

    fn scopeDbOf(ss: ScopeDb[], nid: int) -> ScopeDb | not {
        for (const x of ss) {
            if (x.nid == nid) return x
        }
        return not
    }

    fn fnScope(fs: FnDb[], fnid: int) -> int {
        for (const f of fs) {
            if (f.fnid == fnid) return f.scope
        }
        return -1
    }

    fn siteScope(ss: SiteDb[], nid: int) -> int {
        for (const x of ss) {
            if (x.nid == nid) return x.scope
        }
        return -1
    }

    // The program's databases, each once (a supplied program shares its `<db>`'s).
    fn scopeDbs(ss: ScopeDb[]) -> Db[] {
        let out: Db[] = []
        let seen: int[] = []
        for (const x of ss) {
            const d: Db | not = x.db
            if (d is given) {
                if (seen.indexOf(d.sym.id) < 0) {
                    out = out.concat([d])
                    seen = seen.concat([d.sym.id])
                }
            }
        }
        return out
    }

    // ---- the action positions (not value positions, §6.15) ------------------------
    // An event-handler value and an `<effect>` body: client code that RUNS (a
    // handler on its event, an effect on its change), so a server call there
    // is a suspension (unit U1b) and a `?{}` there splits the client body
    // around server work (§19.9.5 — unit U1d).
    type ActionPos:struct = { what: string, v: AAttrValue, file: string }

    fn actionPositions(g: Globals) -> ActionPos[] {
        let out: ActionPos[] = []
        for (const ds of g.decls) {
            for (const n of declMarkup(ds)) { out = out.concat(nodeActions(n, ds.file)) }
        }
        return out
    }

    fn nodeActions(n: ANode, file: string) -> ActionPos[] {
        const k: ANodeK = n.k
        return match k {
            .Elem(e: e) :> elemActions(e, file)
            .Effect(w: w) :> [{ what: "this `<effect>` body", v: AAttrValue.Braced(w.body), file: file }]
            .Text(text: s) :> []
            .Interp(e: x) :> []
            .DeclNode(d: d) :> []
        }
    }

    fn elemActions(e: AElem, file: string) -> ActionPos[] {
        let out: ActionPos[] = []
        for (const a of e.attrs) {
            if (eventName(a.name) != "") out = out.concat([{ what: "the `" + a.name + "=` handler on `<" + e.tag + ">`", v: a.value, file: file }])
        }
        for (const k of e.kids) { out = out.concat(nodeActions(k, file)) }
        return out
    }

    // ---- the pass ------------------------------------------------------------------
    fn placePass(g: Globals, t: Tables, st0: AS, sum: Summary) -> RPlaced {
        const cx: PlaceCx = { t: t, g: g }
        let st: AS = st0
        // the functions' own facts and the ONE placement — the effect summary's
        // (dpa-066 M2): each function by its own body, an ambient one that
        // reaches a client-only function made client-only (§12.4)
        const all: FnFacts[] = fnFactsOf(sum)
        const places: PlaceFact[] = sum.places

        // the databases
        const rd: RDbs = dbsPass(g, g.files, st)
        st = rd.st
        const dbs: Db[] = scopeDbs(rd.scopes)

        let servers: int[] = []
        let sqls: SqlInfo[] = []
        let creates: int[] = []
        let doms: int[] = []
        for (const f of all) {
            const pk: PlaceK = placeOf(places, f.sym)
            if (f.modifier) st = addDiag(st, f.file, f.span, "W-DEPRECATED-SERVER-MODIFIER", "`server function " + f.name + "` — the `server` modifier is deprecated (§52.10, Insight 26): write `function " + f.name + "(…)` and let route inference place it (§12.2 — a `" + sqlSigil() + "}` in its body places it on the server)")
            if (f.doms.length > 0 && serverTriggered(f)) {
                for (const du of f.doms) { doms = doms.concat([du.span.start]) }
                st = addDiag(st, f.file, f.span, "E-ROUTE-005", "`" + f.name + "()` cannot be placed: its own body uses " + serverTrigger(f) + " (server-only) AND " + f.doms[0].what + " (client-only, no server referent) — route analysis can put it on neither side (§12.4). Split it: keep the server work in a server function, move the DOM access into a client function, and have the client function call the server one")
            } else if (pk == PlaceK.Split) {
                st = addDiag(st, f.file, f.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + f.name + "()` both runs a `" + sqlSigil() + "}` query and writes `" + f.scan.writes[0].cell + "`, so it is split across the client/server boundary (§19.9.5: \"A function whose body mixes a server-trigger statement with a reactive-assignment statement is split\") — the body split arrives with unit U1d. Until then: return the value from a server function and write the cell in the caller")
            } else if (pk == PlaceK.Server) {
                servers = servers.concat([f.sym])
                st = serverBodyDiags(cx, f, all, places, sum, st)
            } else if (sum.inherited.indexOf(f.sym) >= 0) {
                // s454 (U1b): server-placed by inheritance (§12.2 T5) — its calls
                // run in place on the server: a waiting client function there is
                // an ambient function emitted per side (U1c)
                st = waitingCallees(f, all, places, sum, st)
            }
            // (s454: a client function's call of a server function is judged by the
            // binder — §19.9.10, remoteHandled / remoteUnhandled — and lowered by
            // the suspension plan; the U1a refusal is gone)
            // the queries in its body: database, facts, the failable rule
            for (const s of f.sqls) {
                if (!f.failable) st = manualTxDiag(f.file, s, "'" + f.name + "', which is not declared '!'", f.name, st)
                const sr: RSqlSite = sqlSiteFacts(g, rd, f.file, fnScope(rd.fns, f.nid), s, f.failable, st)
                st = sr.st
                const si: SqlInfo | not = sr.info
                if (si is given) {
                    sqls = sqls.concat([si])
                    if (sr.creates) creates = creates.concat([si.db.id])
                }
            }
        }
        // §8.1.1 Ownership: a file owns a SQLite database when a query in it creates a table there
        let owned: Db[] = []
        for (const d of dbs) {
            owned = owned.concat([{ sym: d.sym, driver: d.driver, target: d.target, file: d.file, owner: d.driver == Driver.Sqlite && creates.indexOf(d.sym.id) >= 0 }])
        }

        // value positions (§13.7) and action positions
        st = valueServerDiags(g, t, all, places, sum, rd, st)
        st = actionServerDiags(g, t, all, places, rd, st)
        return { facts: { servers: servers, sqls: sqls, dbs: owned, places: places, inherited: sum.inherited, plan: noPlan() }, doms: doms, st: st }
    }

    fn serverTrigger(f: FnFacts) -> string {
        if (f.sqls.length > 0) return "a `" + sqlSigil() + "}` query"
        return "the `server` modifier"
    }

    // s454 (U1b) — E-ERROR-016 (§19.9.10 "A declared variant named
    // `Transport`"): "A declared variant named `Transport` with any other
    // payload (or none) SHALL be a compile error at the client call site …
    // The message names `f`, its enum, and the payload `(t: ServerCallError)`."
    // At a CLIENT call site of `f` only (a server→server call has no transport
    // half, so nothing collides there).
    fn transportConflict(g: Globals, f: FnInfo, file: string, span: ASpan, st: AS) -> AS {
        if (!f.serverOwn || !f.failable) return st
        const e: Sym | not = f.err
        if (e is not) return st
        if (transportShape(g.types, e, g.sceSym) != 1) return st
        return addDiag(st, file, span, "E-ERROR-016", "`" + f.name + "` is a server function and this call is made on the client, so it can also fail on the wire — the call's failure set is `" + e.hint + "`'s variants plus `Transport(t: ServerCallError)` (§19.9.10). But `" + e.hint + "` already declares a variant named `Transport` with a different payload, and the call's `Transport` cannot be both. Declare it as exactly `Transport(t: ServerCallError)` (then it IS the wrapper), or rename it")
    }

    // s454 (U1b) — a function that runs on the server (wholly, or by
    // inheritance) calling a client function that WAITS (it makes a client
    // call of a server function): on the server that callee would have to run
    // its server calls in place, which is the per-side emission of an ambient
    // function (unit U1c). Refused, fail closed.
    fn waitingCallees(f: FnFacts, all: FnFacts[], ps: PlaceFact[], sum: Summary, st0: AS) -> AS {
        let st: AS = st0
        for (const r of fnRefs(all, f)) {
            if (placeOf(ps, r.sym) != PlaceK.Server && sum.inherited.indexOf(r.sym) < 0 && !r.asValue) {
                const w: Reach | not = waitsOf(sum, r.sym)
                if (w is given) st = addDiag(st, r.file, r.span, "E-BOOTSTRAP-UNSUPPORTED", "`" + f.name + "()` runs on the server and calls `" + r.name + "`, a client function that waits for the server (`" + w.chain.join(" → ") + "`) — on the server that call would be made in place, which needs `" + r.name + "` emitted for each side (the bootstrap's unit U1c). Until then call the server function directly")
            }
        }
        return st
    }

    // A wholly-server function's own body and call graph (§6.6.9, §12.4, §12.5.3).
    fn serverBodyDiags(cx: PlaceCx, f: FnFacts, all: FnFacts[], ps: PlaceFact[], sum: Summary, st0: AS) -> AS {
        let st: AS = st0
        let seen: string[] = []
        for (const r of f.reads) {
            if (seen.indexOf(r.what) < 0) {
                seen = seen.concat([r.what])
                st = addDiag(st, f.file, r.span, "E-REACTIVE-003", "server function `" + f.name + "()` (placed on the server by " + serverTrigger(f) + ") reads `" + r.what + "` — a reactive cell lives in the browser (§6.6.9) and is not sent with the call, so on the server it would be `undefined`. Pass the value as an argument (`" + f.name + "(" + r.what + ")` at the call site, a parameter here), or have the server compute it itself inside the query")
            }
        }
        for (const w of f.scan.writes) {
            st = addDiag(st, w.file, w.span, "E-RI-002", "server function `" + f.name + "()` writes `" + w.cell + "` — the `server` modifier runs the whole body on the server, where reactive cells do not exist (§6.6.9), so the write would be lost. Remove the modifier and let the body split around its server work (§19.9.5), or return the value and write the cell in the caller")
        }
        for (const ref of fnRefs(all, f)) {
            if (placeOf(ps, ref.sym) != PlaceK.Server) {
                const c: Reach | not = clientReachOf(sum, ref.sym)
                if (c is given) {
                    st = addDiag(st, ref.file, ref.span, "E-ROUTE-002", "server function `" + f.name + "()` reaches client-only code: `" + [f.name + "()"].concat(c.chain).join(" → ") + "` " + c.what + " (§12.4 — reactive state and the DOM live in the browser, S451 R2). Pass the value in as an argument, extract the shared logic into a pure function (§33) that touches no cell, or duplicate the logic inside `" + f.name + "()`")
                }
                const u: Reach | not = routeOpenOf(sum, ref.sym)
                if (u is given) {
                    st = addDiag(st, ref.file, ref.span, "E-ROUTE-001", "server function `" + f.name + "()` cannot be fully analyzed for route placement: `" + [f.name + "()"].concat(u.chain).join(" → ") + "` — " + u.what + " (§12.4: \"SHALL be a compile error\"). Call a declared scrml function by its name")
                }
            }
        }
        for (const u2 of f.scan.unproven) {
            st = addDiag(st, u2.file, u2.span, "E-ROUTE-001", "server function `" + f.name + "()` cannot be fully analyzed for route placement: " + u2.what + " (§12.4: \"SHALL be a compile error\"). Call a declared scrml function by its name")
        }
        st = waitingCallees(f, all, ps, sum, st)
        return wireDiags(cx, f, st)
    }

    // §12.5.3 E-ROUTE-003 / E-ROUTE-004 against the §57 codec: a declaration's
    // instance (a live state object) is not serializable; a type the codec
    // refuses to describe (codec.scrml `WireBuild.why` — e.g. a struct field
    // named `__scrml_absent`) is refused, not called non-serializable. (s454:
    // payload enums are described — §57.8, S451 R8.)
    fn wireDiags(cx: PlaceCx, f: FnFacts, st0: AS) -> AS {
        let st: AS = st0
        const fs: FnSrc | not = fnSrcOf(cx.g, f.sym)
        if (fs is not) return st
        for (const p of fs.f.params) {
            const pty: Type | not = boundParamType(bindFact(cx.t.binds, p.nid))
            if (pty is given) st = wireDiag(cx, f, pty, "E-ROUTE-004", "parameter `" + p.name + "`", p.span, st)
        }
        const rt: Type | not = fs.info.ret
        if (rt is given) {
            const r: AType | not = fs.f.ret
            let sp: ASpan = f.span
            if (r is given) sp = r.span
            st = wireDiag(cx, f, rt, "E-ROUTE-003", "return type", sp, st)
        }
        return st
    }

    fn wireDiag(cx: PlaceCx, f: FnFacts, ty: Type, code: string, what: string, span: ASpan, st: AS) -> AS {
        const state: string = stateTypeIn(cx.g, ty)
        if (state != "") return addDiag(st, f.file, span, code, "server function `" + f.name + "()`'s " + what + " is not serializable: it holds `" + state + "`, a declaration's instance — a live state object (it has identity; it is not a value), with no wire form (§12.5.3). Pass the values it holds instead")
        const wb: WireBuild = wireBuild(typesProgram(cx.g), ty)
        if (wb.table is not) return addDiag(st, f.file, span, "E-BOOTSTRAP-UNSUPPORTED", "server function `" + f.name + "()`'s " + what + " has no wire descriptor in the bootstrap's codec: " + wb.why.join("; "))
        return st
    }

    // The declaration a type names (directly or inside a sequence / `T | not`), "" — none.
    fn stateTypeIn(g: Globals, ty: Type) -> string {
        return match ty {
            .Named(sym: s) :> declTypeName(g, s)
            .Seq(elem: e) :> stateTypeIn(g, e)
            .Maybe(inner: i) :> stateTypeIn(g, i)
            .Int :> ""
            .Num :> ""
            .Str :> ""
            .Bool :> ""
        }
    }

    fn declTypeName(g: Globals, s: Sym) -> string {
        for (const d of g.decls) {
            if (d.info.sym.id == s.id) return d.info.sym.hint
        }
        return ""
    }

    fn boundParamType(f: BindFact | not) -> Type | not {
        return match f {
            .BParam(sym: s, ty: ty) :> ty
            .BBind(sym: s) :> not
            .BGiven(sym: s) :> not
            not :> not
        }
    }

    fn fnSrcOf(g: Globals, sym: int) -> FnSrc | not {
        for (const fs of g.fns) {
            if (fs.info.sym.id == sym) return fs
        }
        return not
    }

    // One `?{}` in a function body: its database (§8.1.1), the failable rule
    // (§19.8.3), and its facts (sql.scrml).
    type RSqlSite:struct = { info: SqlInfo | not, creates: boolean, st: AS }

    fn sqlSiteFacts(g: Globals, rd: RDbs, file: string, scope: int, s: SqlSite, failable: boolean, st0: AS) -> RSqlSite {
        // (s451 Ue: the §19.8.3 failable rule — E-ERROR-002 — is the binder's, resolveSql)
        let st: AS = st0
        if (file != g.entry) {
            st = addDiag(st, file, s.span, "E-BOOTSTRAP-UNSUPPORTED", "a `" + sqlSigil() + "}` in an imported module makes it a module-with-db-context (§44.7.1), which is not in the bootstrap — keep the query in the program's file")
            return { info: not, creates: false, st: st }
        }
        if (scope < 0) {
            st = addDiag(st, file, s.span, "E-SQL-004", sql004Text())
            return { info: not, creates: false, st: st }
        }
        const pd: ScopeDb | not = scopeDbOf(rd.scopes, scope)
        if (pd is not) return { info: not, creates: false, st: st }
        const db: Db | not = pd.db
        if (db is not) return { info: not, creates: false, st: st }   // its `db=` was refused (E-SQL-005, reported)
        const sf: SqlFacts = sqlFacts(s.q.chunks)
        return { info: { nid: s.nid, db: db.sym, kind: sf.kind, reads: sf.reads, writes: sf.writes, columns: sf.columns }, creates: sf.createsTable, st: st }
    }

    fn sql004Text() -> string {
        return "this `" + sqlSigil() + "}` has no database scope (§8.1.1): no `<program db=…>`, no `<program>` whose single direct-child `<db src=…>` supplies its database, and no `<db src=…>` encloses it — whatever the number of databases in the file. Put `db=` on the enclosing `<program>` (`<program db=\"./app.db\">` for SQLite, `<program db=\"postgres://…\">` for PostgreSQL), or move the query inside the `<db>` it means"
    }


    // §19.8.3 (S451 R11): a `?{}` outside any function (a value / action
    // position), not handled at the site. (In a function body the binder
    // reports it — resolveSql — where the enclosing `!` and `defer` are known.)
    fn errorTwo(file: string, s: SqlSite, failable: boolean, st: AS) -> AS {
        if (failable || s.q.handled) return st
        return addDiag(st, file, s.span, "E-ERROR-002", "this `" + sqlSigil() + "}` query is failable (§19.8.3, S451): outside a `!` function it must be handled at the site — a `!{ … }` handler on the query, or a `match` on its result — or moved into a `!` function, where a failure propagates (§19.8.2). An unhandled query is E-ERROR-002. (\"No row\" is not a failure: `.get()` still returns `not`, `.all()` still `[]`.)")
    }

    // s452 — §19.10.4 (S451): manual transaction control (`?{BEGIN}`,
    // `?{COMMIT}`, `?{ROLLBACK}`, `?{SAVEPOINT}`, `?{RELEASE}`, `?{END}`)
    // "written where no enclosing function is declared `!` (in a function
    // without `!`, or at a body top) SHALL be a compile error: E-ERROR-015" —
    // the SPEC's message. `where` names the place; `fname` the function ("" —
    // a body top). The bootstrap emits no W-BATCH-001 (no implicit envelope
    // until U1e), so E-ERROR-015 is the one transaction diagnostic here, as
    // §19.10.4 requires outside a `!` function.
    fn manualTxDiag(file: string, s: SqlSite, where: string, fname: string, st: AS) -> AS {
        const kw: string = txControl(s.q.chunks)
        if (kw == "") return st
        let fix: string = "Move it into a function declared with '!' and use 'transaction { … }' (§19.10.2), which commits or rolls back on every exit."
        if (fname != "") fix = "Declare '" + fname + "' with '!' and use 'transaction { … }' (§19.10.2), which commits or rolls back on every exit."
        // s452 r3/r4 (MED-A): found only by the fail-closed plain `;` split — say why
        let why: string = ""
        if (txControlAware(s.q.chunks) == "") why = " (Found by reading every `;` in the query text as a statement boundary — quoting and commenting differ between databases, so the check does not trust them. The transaction-control word may be inside a quoted string or a comment; if so, move the query into a function declared '!', where manual transaction control is allowed, or bind the text as a value with `${…}`.)"
        return addDiag(st, file, s.span, "E-ERROR-015", "Manual transaction control '" + kw + "' in " + where + ". A transaction is '!'-gated (§19.10.4): its rollback promise needs a failure path. " + fix + why)
    }

    // §13.7 (S451 R1): a value position that would have to WAIT.
    fn valueServerDiags(g: Globals, t: Tables, all: FnFacts[], ps: PlaceFact[], sum: Summary, rd: RDbs, st0: AS) -> AS {
        let st: AS = st0
        for (const p of valuePositions(g, t)) {
            for (const s of sqlsInValue(p.v)) {
                st = errorTwo(p.file, s, false, st)
                st = manualTxDiag(p.file, s, p.what + ", which is not a function declared '!'", "", st)
                st = positionDb(g, rd, p.file, s, st)
                st = addDiag(st, p.file, s.span, "E-VALUE-SERVER-CALL", p.what + " runs a `" + sqlSigil() + "}` query — the query runs on the server, and " + waitFix())
            }
            const scan: BodyScan = scanValue({ t: t, file: p.file }, p.v, emptyScan())
            for (const r of scan.refs) {
                const pk: PlaceK = placeOf(ps, r.sym)
                const c: Reach | not = waitsOf(sum, r.sym)
                if (pk == PlaceK.Server) {
                    st = addDiag(st, r.file, r.span, "E-VALUE-SERVER-CALL", p.what + " calls the server function `" + r.name + "` — " + waitFix())
                } else if (c is given) {
                    st = addDiag(st, r.file, r.span, "E-VALUE-SERVER-CALL", p.what + " calls `" + r.name + "`, which reaches a server call (`" + c.chain.join(" → ") + "`) — " + waitFix())
                }
            }
        }
        return st
    }

    fn waitFix() -> string {
        return "a value position cannot wait for the server (§13.7). Load the value with a `<request>` (§6.7.7) into a cell and read the cell here — or, where the cell is server-authoritative, a `<x server>` declaration (§52)"
    }

    // E-SQL-004 for a `?{}` that stands in no function: its OWN nearest
    // database scope (s452 — the scope pass recorded it by position).
    fn positionDb(g: Globals, rd: RDbs, file: string, s: SqlSite, st: AS) -> AS {
        if (file != g.entry) return st
        const scope: int = siteScope(rd.sites, s.nid)
        if (scope >= 0 && scopeDbOf(rd.scopes, scope) is given) return st
        return addDiag(st, file, s.span, "E-SQL-004", sql004Text())
    }

    // The action positions: a `?{}` there is client code doing server work (a
    // split — U1d); a server call there is a suspension (U1b).
    fn actionServerDiags(g: Globals, t: Tables, all: FnFacts[], ps: PlaceFact[], rd: RDbs, st0: AS) -> AS {
        let st: AS = st0
        for (const a of actionPositions(g)) {
            for (const s of sqlsInValue(a.v)) {
                st = errorTwo(a.file, s, false, st)
                st = manualTxDiag(a.file, s, a.what + ", which is not a function declared '!'", "", st)
                st = positionDb(g, rd, a.file, s, st)
                st = addDiag(st, a.file, s.span, "E-BOOTSTRAP-UNSUPPORTED", a.what + " runs a `" + sqlSigil() + "}` query — client code that does server work is split around it (§19.9.5), and the body split arrives with unit U1d. Until then: put the query in a function")
            }
        }
        return st
    }

    // =========================================================================
    // s452 (dpa-066, RATIFIED S452 "all your recs" item 3) — THE EFFECT
    // SUMMARY. One record per CALLABLE — a scrml function, a user
    // declaration's CONSTRUCTION, a FORMULA (a field computed on its read) —
    // computed once, after binding, over the binder's Syms, and closed over
    // the call graph by effects.scrml (strongly connected components,
    // bottom-up; ruling 3.1). Every rule that asks "what does this callable
    // transitively do?" reads it.
    //
    // The OWN facts of a callable come from its body, read once: the write
    // scan (BodyScan — writes, references, unresolvable calls; the no-write
    // rule's banner above), its `?{}` sites, its client reads and DOM globals
    // (placement), whether it reads the clock, and whether a call of it yields
    // a value. The DIMENSIONS, each closed over the references that carry it
    // (per-dimension knowledge, ruling 3.2 — known facts and open reasons are
    // separate dimensions; no global TOP):
    //   writes      §6.7.4 / §6.15 — the cells it may write; every reference
    //               (calls, function values — rule 3 —, the construction a
    //               shared-instance read runs, the formula a derived read runs)
    //   writesOpen  §6.7.4 rule 4 — the calls the analysis cannot resolve; the same references
    //   client      §12.4 R2 — a client-only access (DOM global, cell write,
    //               cell read) of a NON-server function, through non-server
    //               functions: a server callee is judged on its own
    //   routeOpen   §12.4 R3 — the unresolvable calls of a function, through non-server functions
    //   waits       §13.2 / §13.7 item 2 — async colour: a server or split
    //               function, through every function reference
    //   clock       §48.6 / §33.3 item 7 — a body that reads the clock, through
    //               function CALLS (§48.6.2 is a rule about calls; a function
    //               value is refused in the bootstrap)
    //   noValue     §19.4.3 ruling 1a — a call of it yields no value: its own
    //               body (a bare `return`, a path that falls off, `-> void`),
    //               or a `return <call>` of a function that yields none (G7 —
    //               ruling 3.4/3.6: "returns a value" is in the summary)
    // and the ONE placement (§12.2): each function by its own body, an
    // ambient one that reaches client-only code made client (§12.4).
    // =========================================================================
    type CallableK:enum = { KFn, KConstruct, KFormula }
    // `f`: the own facts (a construction / formula has no `?{}`, client read or
    // DOM access of its own here — its reads are cell reads, recorded by the
    // reads that reach it). `clock` / `noValue` / `rets`: functions only.
    type Callable:struct = { kind: CallableK, label: string, f: FnFacts, clock: boolean, noValue: boolean, rets: int[] }
    type Summary:struct = {
        nodes: Callable[],
        writes: FxAtom[][],
        writesOpen: FxAtom[][],
        places: PlaceFact[],
        client: FxAtom[][],
        routeOpen: FxAtom[][],
        waits: FxAtom[][],
        clock: FxAtom[][],
        noValue: FxAtom[][],
        // s454 (U1b): the functions server-placed by INHERITANCE (§12.2 Trigger 5),
        // and why each still client-placed helper a server function calls is so
        inherited: int[],
        causes: Cause[],
    }

    fn summarize(g: Globals, t: Tables) -> Summary {
        const cx: PlaceCx = { t: t, g: g }
        let nodes: Callable[] = []
        for (const fs of g.fns) {
            nodes = nodes.concat([{ kind: CallableK.KFn, label: fs.info.name + "()", f: fnFacts(cx, fs), clock: blockClock(fs.f.body),
                                    noValue: ownNoValue(fs), rets: retCallsOf(t, fs) }])
        }
        for (const ds of g.decls) {
            if (!ds.isProgram) {
                const label: string = constructionLabel(ds.info.sym.hint)
                nodes = nodes.concat([{ kind: CallableK.KConstruct, label: label, f: valueFacts(ds.info.sym.id, label, ds.file, ds.info.span, ds.info.nid, constructionScan(t, ds)),
                                        clock: false, noValue: false, rets: [] }])
            }
            for (const fi of ds.info.fields) {
                const w: Sym | not = fi.wcap
                if (w is not) {
                    const flabel: string = formulaLabel(t, fi)
                    const fscan: BodyScan = scanValue({ t: t, file: ds.file }, fi.init, emptyScan())
                    nodes = nodes.concat([{ kind: CallableK.KFormula, label: flabel, f: valueFacts(fi.sym.id, flabel, ds.file, fi.span, fi.nid, fscan),
                                            clock: false, noValue: false, rets: [] }])
                }
            }
        }
        // the references: every one (the write dimensions), those to a function
        // (called or handed on as a value), and the CALLS of a function (the clock)
        let all: int[][] = []
        let fnE: int[][] = []
        let callE: int[][] = []
        for (const c of nodes) {
            all = all.concat([refTargets(nodes, c.f.scan.refs, false)])
            fnE = fnE.concat([refTargets(nodes, c.f.scan.refs, true)])
            callE = callE.concat([callTargets(nodes, c.f.scan.refs)])
        }
        // writes / writesOpen
        let ownW: FxAtom[][] = []
        let ownU: FxAtom[][] = []
        let i: int = 0
        for (const c of nodes) {
            ownW = ownW.concat([writeAtoms(c.f.scan.writes, i)])
            ownU = ownU.concat([openAtoms(c.f.scan.unproven, i)])
            i = i + 1
        }
        // the placement: each function by its own body …
        let direct: PlaceFact[] = []
        for (const c of nodes) {
            if (c.kind == CallableK.KFn) direct = direct.concat([{ sym: c.f.sym, name: c.f.name, place: directPlace(c.f) }])
        }
        // … client reach: non-server functions, through non-server functions
        let ownC: FxAtom[][] = []
        let edgeC: int[][] = []
        i = 0
        for (const c of nodes) {
            if (c.kind == CallableK.KFn && placeOf(direct, c.f.sym) != PlaceK.Server) {
                ownC = ownC.concat([clientAtoms(c.f, i)])
                edgeC = edgeC.concat([notServer(nodes, direct, fnE[i])])
            } else {
                ownC = ownC.concat([[]])
                edgeC = edgeC.concat([[]])
            }
            i = i + 1
        }
        const client: FxAtom[][] = closeDim(ownC, edgeC)
        // … and an ambient function that reaches client-only code is client (§12.4)
        let places: PlaceFact[] = []
        for (const p of direct) {
            let pk: PlaceK = p.place
            if (pk == PlaceK.Ambient && client[nodeIdx(nodes, p.sym)].length > 0) pk = PlaceK.Client
            places = places.concat([{ sym: p.sym, name: p.name, place: pk }])
        }
        // s454 (U1b) — §12.2 Trigger 5 (inheritance) and the client cause (below)
        const prefs: PosRef[] = positionRefs(g, t)
        const rev: int[][] = referrers(nodes, all)
        const inherited: int[] = inheritedFns(nodes, places, rev, prefs)
        const causes: Cause[] = clientCauses(g, nodes, places, rev, prefs, inherited)
        // routeOpen / waits / clock / noValue — functions only
        let ownR: FxAtom[][] = []
        let edgeR: int[][] = []
        let ownA: FxAtom[][] = []
        let edgeF: int[][] = []
        let ownK: FxAtom[][] = []
        let edgeK: int[][] = []
        let ownV: FxAtom[][] = []
        let edgeV: int[][] = []
        i = 0
        for (const c of nodes) {
            if (c.kind == CallableK.KFn) {
                const pk: PlaceK = placeOf(places, c.f.sym)
                ownR = ownR.concat([openAtoms(c.f.scan.unproven, i)])
                edgeR = edgeR.concat([notServer(nodes, places, fnE[i])])
                let a: FxAtom[] = []
                if (pk == PlaceK.Server || pk == PlaceK.Split) a = [ownAtom("s", i, 0)]
                ownA = ownA.concat([a])
                // s454 (U1b): a function server-placed by inheritance calls in place
                // (§13.4) — its calls make nothing wait (they are not client calls)
                if (inherited.indexOf(c.f.sym) >= 0) {
                    edgeF = edgeF.concat([[]])
                } else {
                    edgeF = edgeF.concat([fnE[i]])
                }
                let k: FxAtom[] = []
                if (c.clock) k = [ownAtom("c", i, 0)]
                ownK = ownK.concat([k])
                edgeK = edgeK.concat([callE[i]])
                let v: FxAtom[] = []
                if (c.noValue) v = [ownAtom("v", i, 0)]
                ownV = ownV.concat([v])
                edgeV = edgeV.concat([fnTargets(nodes, c.rets)])
            } else {
                ownR = ownR.concat([[]])
                edgeR = edgeR.concat([[]])
                ownA = ownA.concat([[]])
                edgeF = edgeF.concat([[]])
                ownK = ownK.concat([[]])
                edgeK = edgeK.concat([[]])
                ownV = ownV.concat([[]])
                edgeV = edgeV.concat([[]])
            }
            i = i + 1
        }
        return { nodes: nodes, writes: closeDim(ownW, all), writesOpen: closeDim(ownU, all), places: places,
                 client: client, routeOpen: closeDim(ownR, edgeR), waits: closeDim(ownA, edgeF),
                 clock: closeDim(ownK, edgeK), noValue: closeDim(ownV, edgeV), inherited: inherited, causes: causes }
    }

    // =========================================================================
    // s454 (U1b) — §12.2 TRIGGER 5 (INHERITANCE), over the summary's reference
    // graph. §19.9.10 "Which call sites are remote — placement is whole-
    // program": "a helper with no server trigger of its own is server-placed by
    // inheritance (Trigger 5) when every caller is server-placed, and a call
    // inside it is then server→server and not failable on the wire … An
    // implementation SHALL decide 'remote' from the resolved whole-program
    // placement — not from the caller's own body alone."
    //
    // A function is INHERITED when its own body is ambient (no server trigger,
    // no client-only access — PlaceK.Ambient after client reach), it has at
    // least one referrer other than itself, and EVERY referrer is a function
    // that is server-placed or itself inherited — a greatest fixpoint (a cycle
    // of helpers called only from the server is server-placed). Disqualified
    // by any CLIENT referrer: an event handler, an `<effect>` body, a value
    // position (markup, an initializer, an attribute value — positionRefs), a
    // construction or a formula (evaluated on the client), or a function that
    // is not server-placed. A function nobody references is client (§12.1 "The
    // default is client-side execution").
    // =========================================================================
    // A client position's reference to a function: what the position is, where.
    type PosRef:struct = { sym: int, what: string, file: string, span: ASpan }
    // Why a function is client-placed although a server function calls it.
    type Cause:struct = { sym: int, note: string }

    fn positionRefs(g: Globals, t: Tables) -> PosRef[] {
        let out: PosRef[] = []
        for (const a of actionPositions(g)) {
            for (const r of scanValue({ t: t, file: a.file }, a.v, emptyScan()).refs) { out = out.concat([{ sym: r.sym, what: a.what, file: r.file, span: r.span }]) }
        }
        for (const p of valuePositions(g, t)) {
            for (const r of scanValue({ t: t, file: p.file }, p.v, emptyScan()).refs) { out = out.concat([{ sym: r.sym, what: p.what, file: r.file, span: r.span }]) }
        }
        return out
    }

    // rev[j]: the callables whose references name callable j, in node order.
    fn referrers(nodes: Callable[], all: int[][]) -> int[][] {
        let rev: int[][] = []
        let j: int = 0
        for (const c of nodes) {
            let rs: int[] = []
            let i: int = 0
            for (const es of all) {
                if (es.indexOf(j) >= 0) rs = rs.concat([i])
                i = i + 1
            }
            rev = rev.concat([rs])
            j = j + 1
        }
        return rev
    }

    fn posRefTo(prefs: PosRef[], sym: int) -> PosRef | not {
        for (const r of prefs) {
            if (r.sym == sym) return r
        }
        return not
    }

    fn inheritedFns(nodes: Callable[], places: PlaceFact[], rev: int[][], prefs: PosRef[]) -> int[] {
        let inh: int[] = []
        let j: int = 0
        for (const c of nodes) {
            if (c.kind == CallableK.KFn && placeOf(places, c.f.sym) == PlaceK.Ambient && posRefTo(prefs, c.f.sym) is not) {
                let others = false
                let fnsOnly = true
                for (const i of rev[j]) {
                    if (i != j) others = true
                    if (nodes[i].kind != CallableK.KFn) fnsOnly = false
                }
                if (others && fnsOnly) inh = inh.concat([c.f.sym])
            }
            j = j + 1
        }
        let changed = true
        while (changed) {
            changed = false
            let keep: int[] = []
            for (const sym of inh) {
                const k: int = nodeIdx(nodes, sym)
                let ok = true
                for (const i of rev[k]) {
                    const isym: int = nodes[i].f.sym
                    if (i != k && placeOf(places, isym) != PlaceK.Server && inh.indexOf(isym) < 0) ok = false
                }
                if (ok) {
                    keep = keep.concat([sym])
                } else {
                    changed = true
                }
            }
            inh = keep
        }
        return inh
    }

    // §19.9.10: "When a helper's placement flips because a client caller was
    // added — the helper was server-placed by inheritance, and a new client
    // call to it makes it client-placed, so its own server calls become client
    // calls — any diagnostic this rule then raises inside the helper … SHALL
    // name that client caller (file and line) as the cause". A helper whose own
    // body is ambient, that a server-placed (or inherited) function calls, and
    // that is still client-placed: the FIRST client referrer is the cause.
    fn clientCauses(g: Globals, nodes: Callable[], places: PlaceFact[], rev: int[][], prefs: PosRef[], inh: int[]) -> Cause[] {
        let out: Cause[] = []
        let j: int = 0
        for (const c of nodes) {
            if (c.kind == CallableK.KFn && placeOf(places, c.f.sym) == PlaceK.Ambient && inh.indexOf(c.f.sym) < 0) {
                let serverSide = false
                let who: string = ""
                let at: string = ""
                for (const i of rev[j]) {
                    const n: Callable = nodes[i]
                    const isym: int = n.f.sym
                    const onServer: boolean = n.kind == CallableK.KFn && (placeOf(places, isym) == PlaceK.Server || inh.indexOf(isym) >= 0)
                    if (i != j && onServer) serverSide = true
                    if (i != j && !onServer && who == "") {
                        who = "`" + n.label + "`"
                        at = refSiteIn(g, n.f.scan.refs, c.f.sym)
                    }
                }
                const pr: PosRef | not = posRefTo(prefs, c.f.sym)
                if (pr is given && who == "") {
                    who = pr.what
                    at = pr.file + ":" + lineOf(g, pr.file, pr.span.start)
                }
                if (serverSide && who != "") {
                    out = out.concat([{ sym: c.f.sym, note: " — `" + c.f.name + "()` is client-placed because " + who + " calls it (" + at + "); called only from server functions it would be server-placed (§12.2 Trigger 5) and this call would be made in place on the server (§19.9.10 \"placement is whole-program\")" }])
                }
            }
            j = j + 1
        }
        return out
    }

    // "file:line" of the first reference in `refs` to function `sym`.
    fn refSiteIn(g: Globals, refs: FnRef[], sym: int) -> string {
        for (const r of refs) {
            if (r.sym == sym) return r.file + ":" + lineOf(g, r.file, r.span.start)
        }
        return ""
    }

    // The 1-based line of `offset` in `file` (parse.scrml records each file's line starts).
    fn lineOf(g: Globals, file: string, offset: int) -> int {
        for (const f of g.files) {
            if (f.path == file) {
                let n: int = 0
                for (const st of f.lines) {
                    if (st <= offset) n = n + 1
                }
                return n
            }
        }
        return 0
    }

    // ---- the rules pass's client-call queries --------------------------------------
    // Is a call made in function `caller` a CLIENT call? (-1: an event handler or
    // an effect body — client by position.) Server-placed by its own body, or by
    // inheritance: no.
    fn callerRemote(s: Summary, caller: int) -> boolean {
        if (caller < 0) return true
        if (placeOf(s.places, caller) == PlaceK.Server) return false
        return s.inherited.indexOf(caller) < 0
    }

    fn remoteOr(s: Summary, caller: int, r: Diag[], l: Diag[]) -> Diag[] {
        if (!callerRemote(s, caller)) return l
        let note: string = ""
        for (const c of s.causes) {
            if (c.sym == caller) note = c.note
        }
        if (note == "") return r
        let out: Diag[] = []
        for (const d of r) { out = out.concat([newDiag(d.code, d.message + note, d.file, d.span)]) }
        return out
    }

    // The own facts of a construction / a formula: its scan only.
    fn valueFacts(sym: int, label: string, file: string, span: ASpan, nid: int, scan: BodyScan) -> FnFacts {
        return { sym: sym, name: label, file: file, span: span, nid: nid, modifier: false, failable: false,
                 sqls: [], reads: [], doms: [], scan: scan }
    }

    // The callable a Sym names (-1: none — a reference with no summary).
    fn nodeIdx(nodes: Callable[], sym: int) -> int {
        let i: int = 0
        for (const c of nodes) {
            if (c.f.sym == sym) return i
            i = i + 1
        }
        return -1
    }

    fn isFnNode(nodes: Callable[], i: int) -> boolean {
        if (i < 0) return false
        return nodes[i].kind == CallableK.KFn
    }

    // The callables a body's references name, in source order (`fnOnly`: functions only).
    fn refTargets(nodes: Callable[], refs: FnRef[], fnOnly: boolean) -> int[] {
        let out: int[] = []
        for (const r of refs) {
            const j: int = nodeIdx(nodes, r.sym)
            if (j >= 0 && (!fnOnly || isFnNode(nodes, j))) out = out.concat([j])
        }
        return out
    }

    // The functions a body CALLS (§48.6.2's purity rule is about calls, and a
    // function value is refused in the bootstrap — the clock follows calls).
    fn callTargets(nodes: Callable[], refs: FnRef[]) -> int[] {
        let out: int[] = []
        for (const r of refs) {
            const j: int = nodeIdx(nodes, r.sym)
            if (!r.asValue && isFnNode(nodes, j)) out = out.concat([j])
        }
        return out
    }

    fn fnTargets(nodes: Callable[], syms: int[]) -> int[] {
        let out: int[] = []
        for (const s of syms) {
            const j: int = nodeIdx(nodes, s)
            if (isFnNode(nodes, j)) out = out.concat([j])
        }
        return out
    }

    // The references to a function NOT placed on the server (a server callee is judged on its own).
    fn notServer(nodes: Callable[], ps: PlaceFact[], es: int[]) -> int[] {
        let out: int[] = []
        for (const j of es) {
            if (placeOf(ps, nodes[j].f.sym) != PlaceK.Server) out = out.concat([j])
        }
        return out
    }

    fn writeAtoms(ws: WSite[], i: int) -> FxAtom[] {
        let out: FxAtom[] = []
        let k: int = 0
        for (const w of ws) {
            out = out.concat([ownAtom("w:" + w.cell, i, k)])
            k = k + 1
        }
        return out
    }

    fn openAtoms(us: USite[], i: int) -> FxAtom[] {
        let out: FxAtom[] = []
        let k: int = 0
        for (const u of us) {
            out = out.concat([ownAtom("u:" + u.file + ":" + u.span.start, i, k)])
            k = k + 1
        }
        return out
    }

    // A function's own client-only accesses, in §12.4's order of report: its
    // DOM globals, then its cell writes, then its cell reads.
    fn clientWhats(f: FnFacts) -> string[] {
        let out: string[] = []
        for (const d of f.doms) { out = out.concat([d.what]) }
        for (const w of f.scan.writes) { out = out.concat(["writes `" + w.cell + "`"]) }
        for (const r of f.reads) { out = out.concat(["reads `" + r.what + "`"]) }
        return out
    }

    fn clientAtoms(f: FnFacts, i: int) -> FxAtom[] {
        let out: FxAtom[] = []
        let k: int = 0
        for (const w of clientWhats(f)) {
            out = out.concat([ownAtom("c:" + w, i, k)])
            k = k + 1
        }
        return out
    }

    // ---- the own "yields a value" fact (§19.4.3 ruling 1a) -----------------------
    // Does a call of the function produce no value, by its OWN body? A declared
    // return type does produce one (`-> void` declares that it does not, §7.5 —
    // FnInfo.ret is `not` for it); a `!` function's result is handled, never
    // read as a value; otherwise the body decides — a value on EVERY path,
    // proven syntactically, FAIL CLOSED:
    //   - s452 r3 (MED-B): a bare `return` ANYWHERE in the body (any depth — an
    //     `if` branch, a `given` body, a handling form's arm block) is a path
    //     with no value;
    //   - otherwise the statements are walked in order and the FIRST one that
    //     returns a value on every path through it decides (s452 r3 LOW-C — what
    //     follows it is dead): `return <expr>`, or an `if` / `else` both of whose
    //     blocks do. Reaching the end of the body is no value.
    //   - A `fn` / `function` body's tail EXPRESSION is not a value: the
    //     bootstrap gives neither implicit tail return (`fn h() { "a" }` prints
    //     `function h() { "a"; }` — returns nothing; checked s452 r3).
    // Unprovable, so judged "no value": a `given` (its body runs only when the
    // value is present), a statement-position handling form whose arms return,
    // an `if` without `else`. What a `return <call>` returns is the CALLEE's
    // (retCallsOf — the summary closes it, G7).
    fn ownNoValue(fs: FnSrc) -> boolean {
        if (fs.info.ret is given || fs.info.failable) return false
        const r: AType | not = fs.f.ret
        if (r is given) return declaresVoid(r)
        if (blockHasBareReturn(fs.f.body)) return true
        return !blockYieldsOnAllPaths(fs.f.body)
    }

    // G7 (dpa-066): every `return <call of a scrml function>` in a function's
    // body, at any depth — the value it returns is that callee's, so a callee
    // that yields none makes this a path with no value. (A `!` function's
    // result is handled: none. A `-> void` function yields none already.)
    fn retCallsOf(t: Tables, fs: FnSrc) -> int[] {
        if (fs.info.failable) return []
        return retCallsBlock(t, fs.f.body)
    }

    // r2 LOW-1: the s452 r3 rule — an earlier statement that leaves on every
    // path decides; the dead code after it is not a return path (so
    // `{ return "x"; return nothing() }` yields a value).
    fn retCallsBlock(t: Tables, b: ABlock) -> int[] {
        let out: int[] = []
        for (const s of b.stmts) {
            out = out.concat(retCallsStmt(t, s))
            if (leavesOnAllPaths(s)) return out
        }
        return out
    }

    // Does `s` leave the function on every path through it (`return`, `fail`,
    // or an `if` / `else` both of whose blocks do)?
    fn leavesOnAllPaths(s: AStmt) -> boolean {
        const k: AStmtK = s.k
        return match k {
            .Return(e: x) :> true
            .Fail(f: x) :> true
            .If(cond: c, thenB: tb, elseB: eb) :> blockLeaves(tb) && maybeBlockLeaves(eb)
            .Given(name: n) :> false
            .Eval(e: x) :> false
            .Local(name: n) :> false
            .EffectStmt(w: w) :> false
            .Defer(body: d) :> false
        }
    }

    fn blockLeaves(b: ABlock) -> boolean {
        for (const s of b.stmts) {
            if (leavesOnAllPaths(s)) return true
        }
        return false
    }

    fn maybeBlockLeaves(b: ABlock | not) -> boolean {
        if (b is not) return false
        return blockLeaves(b)
    }

    fn retCallsStmt(t: Tables, s: AStmt) -> int[] {
        const k: AStmtK = s.k
        return match k {
            .Return(e: x) :> retCallsReturn(t, x)
            .If(cond: c, thenB: tb, elseB: eb) :> retCallsExpr(t, c).concat(retCallsBlock(t, tb)).concat(retCallsElse(t, eb))
            .Given(name: n, subject: x, body: b) :> retCallsExpr(t, x).concat(retCallsBlock(t, b))
            .Eval(e: x) :> retCallsExpr(t, x)
            .Local(name: n, init: i) :> retCallsExpr(t, i)
            .EffectStmt(w: w) :> []
            .Defer(body: d) :> []                       // a deferred body holds no `return` (§19.16.3 rule 1)
            .Fail(f: x) :> []
        }
    }

    fn retCallsElse(t: Tables, b: ABlock | not) -> int[] {
        if (b is not) return []
        return retCallsBlock(t, b)
    }

    fn retCallsReturn(t: Tables, x: AExpr | not) -> int[] {
        if (x is not) return []
        let out: int[] = retCallsExpr(t, x)
        const c: AExpr | not = calleeOf(x.k)
        if (c is given) {
            const s: Sym | not = fnSymOf(nameFact(t.names, c.nid))
            if (s is given) out = [s.id].concat(out)
        }
        return out
    }

    // ... a `return` inside a handling form's arm block in `e`, at any depth.
    fn retCallsExpr(t: Tables, e: AExpr) -> int[] {
        let out: int[] = []
        for (const b of exprBlocks(e)) { out = out.concat(retCallsBlock(t, b)) }
        for (const x of exprKids(e)) { out = out.concat(retCallsExpr(t, x)) }
        return out
    }

    // ---- the queries -------------------------------------------------------------
    // The witness of callable `i` in a dimension, as the chain of labels down to it.
    fn fxChain(s: Summary, dim: FxAtom[][], i: int, a: FxAtom) -> string[] {
        let out: string[] = []
        for (const j of atomChain(dim, i, a)) { out = out.concat([s.nodes[j].label]) }
        return out
    }

    // =========================================================================
    // s452 (dpa-066 M3) — THE RULES PASS: the binder's decisions that read the
    // effect summary. The binder (phaseB) meets them before any summary
    // exists, so it records each (addPending) with the diagnostic(s) it would
    // report and the position in the diagnostic list where it would have
    // reported it; here each is decided by a query and its diagnostic put
    // back at that position — the diagnostics keep the order the binder gave
    // them.
    //   IfNoValue    §19.4.3 ruling 1a — E-ERROR-012 when the arm's callee
    //                yields no value (noValue: transitive through `return <call>`,
    //                which closes G7; fail closed: an unknown callee yields none)
    //   RemoteOr     s454 (U1b) §19.9.10 — a call of a server function in a
    //                function with no server trigger of its own: `remote` when
    //                that function is client-placed in the WHOLE program (not
    //                inherited onto the server, §12.2 Trigger 5), else `local`;
    //                a remote diagnostic names the client caller that made it so
    //                (clientCause — "SHALL name that client caller (file and line)")
    //   IfClock      a call of a clock reader where the clock is not in the
    //                bootstrap (the summary's `clock`, through calls)
    //   PureCall     E-FN-003, its message naming the clock when the callee reads it
    // =========================================================================
    type PendRule:enum = {
        IfNoValue(fnSym: int, diag: Diag),
        RemoteOr(caller: int, remote: Diag[], local: Diag[]),
        IfClock(fnSym: int, diag: Diag),
        PureCall(fnSym: int, bare: Diag, clocked: Diag),
    }
    type Pending:struct = { at: int, rule: PendRule }

    fn rulesPass(s: Summary, st: AS) -> AS {
        if (st.pend.length == 0) return st
        let out: Diag[] = []
        let k: int = 0
        let i: int = 0
        while (i <= st.diags.length) {
            while (k < st.pend.length && st.pend[k].at == i) {
                out = out.concat(decide(s, st.pend[k].rule))
                k = k + 1
            }
            if (i < st.diags.length) out = out.concat([st.diags[i]])
            i = i + 1
        }
        return { facts: st.facts, diags: out, nextSym: st.nextSym, annots: st.annots, bad: st.bad, effects: st.effects, pend: [] }
    }

    fn decide(s: Summary, r: PendRule) -> Diag[] {
        return match r {
            .IfNoValue(fnSym: f, diag: d) :> onlyIf(yieldsNoValue(s, f), d)
            .RemoteOr(caller: c, remote: r, local: l) :> remoteOr(s, c, r, l)
            .IfClock(fnSym: f, diag: d) :> onlyIf(readsClock(s, f), d)
            .PureCall(fnSym: f, bare: a, clocked: b) :> either(readsClock(s, f), b, a)
        }
    }

    fn onlyIf(yes: boolean, d: Diag) -> Diag[] {
        if (yes) return [d]
        return []
    }

    fn either(yes: boolean, a: Diag, b: Diag) -> Diag[] {
        if (yes) return [a]
        return [b]
    }

    // ---- the queries ----------------------------------------------------------------
    // Does a call of function `sym` yield no value? An unknown callee: fail
    // closed (dpa-066 G10 — the walker this replaces failed open).
    fn yieldsNoValue(s: Summary, sym: int) -> boolean {
        const i: int = nodeIdx(s.nodes, sym)
        if (i < 0) return true
        return s.noValue[i].length > 0
    }

    // §12.2 T1 / T4: its own body has a `?{}` or the deprecated `server` modifier.
    fn serverTriggeredFn(s: Summary, sym: int) -> boolean {
        const i: int = nodeIdx(s.nodes, sym)
        if (i < 0) return false
        return serverTriggered(s.nodes[i].f)
    }

    // Does function `sym` read the clock, itself or through a call?
    fn readsClock(s: Summary, sym: int) -> boolean {
        const i: int = nodeIdx(s.nodes, sym)
        if (i < 0) return false
        return s.clock[i].length > 0
    }

    // =========================================================================
    // s454 (U1b) — THE SUSPENSION PLAN (design §2.2 "Where a ServerCall can
    // stand — ANF with refusal positions"). Per SITE, after the summary (it
    // reads the whole-program placement and the async colour — no transitive
    // question is answered here; those are the summary's). For every CLIENT
    // body — a client-placed function, an event handler, an `<effect>` body —
    // it finds the SUSPENSION POINTS:
    //   - a handling form (`!{}` / `match` / `?`) on a call of a server
    //     function made on the client (HandledFact.remote, caller remote);
    //   - a call of a WAITING client function (§13.2 async colour: the
    //     summary's `waits`) — a handled one, a plain one, or a handler
    //     reference that names one;
    // and decides each by POSITION, lowering the ones with a statement boundary
    // to suspend at and refusing (fail closed, naming the lifting slice) the
    // ones without:
    //   lowered   a statement's whole value; a call argument, an operand, an
    //             array element, an object value, a member / index operand, an
    //             `if` condition, a `return` / `let` value — ANF: everything
    //             evaluated BEFORE the point (left to right) is evaluated into a
    //             temporary first (TempFact), so order is kept; a point inside an
    //             `if` / `given` branch with statements after it — a Join
    //             (JoinFact) the branches jump to.
    //   refused   the right operand of `&&` / `||`, a ternary branch (it runs on
    //             one path only); a `!{}` / `match` arm; a `defer` body (and any
    //             `defer` in a function that waits — its body would run at the
    //             synchronous exit, §19.16.2); a lambda body (an awaited
    //             combinator, §13.2); the value of an indexed write.
    // The binder minted the Suspend's bind for a handling form
    // (HandledFact.outcome); a plain call's bind, the temporaries and the join
    // continuations are minted here. `waiting`: the client functions whose
    // body holds a suspension point — Core's Fn.waits (check.scrml C-S8).
    // =========================================================================
    export type SuspendK:enum = { SRemote(callee: Sym), SWaits(callee: Sym) }
    export type SuspendAt:struct = { nid: int, bind: Sym, kind: SuspendK }
    export type TempFact:struct = { nid: int, sym: Sym }
    export type JoinFact:struct = { nid: int, k: Sym }
    // `rets`: the WIRE type of a server function's answer that declares none — a
    // `!` function cannot (§19.4.1: "its success type is inferred from its
    // returns", §19.4.2), so the client decodes against the type its `return`s
    // prove (routedChecks).
    export type RetFact:struct = { sym: int, ty: Type }
    export type SuspendPlan:struct = { at: SuspendAt[], temps: TempFact[], joins: JoinFact[], waiting: int[], rets: RetFact[] }

    export fn noPlan() -> SuspendPlan { return { at: [], temps: [], joins: [], waiting: [], rets: [] } }

    export fn retOf(p: SuspendPlan, sym: int) -> Type | not {
        for (const r of p.rets) {
            if (r.sym == sym) return r.ty
        }
        return not
    }

    export fn suspendAtOf(p: SuspendPlan, nid: int) -> SuspendAt | not {
        for (const a of p.at) {
            if (a.nid == nid) return a
        }
        return not
    }

    export fn tempOf(p: SuspendPlan, nid: int) -> Sym | not {
        for (const x of p.temps) {
            if (x.nid == nid) return x.sym
        }
        return not
    }

    export fn joinOf(p: SuspendPlan, nid: int) -> Sym | not {
        for (const j of p.joins) {
            if (j.nid == nid) return j.k
        }
        return not
    }

    // The planner's running state.
    type PS:struct = { st: AS, plan: SuspendPlan }
    // A client body being planned: its file, and what it is (for messages).
    type PCx:struct = { g: Globals, t: Tables, s: Summary, file: string, inFn: boolean }
    // `found`: the expression holds a suspension point (lowered or refused).
    type PX:struct = { found: boolean, ps: PS }
    // Why a position cannot suspend ("" — it can).
    type Pos:struct = { refused: string }

    fn okPos() -> Pos { return { refused: "" } }

    fn planPass(g: Globals, t: Tables, s: Summary, st0: AS) -> PS {
        let ps: PS = { st: st0, plan: noPlan() }
        for (const fs of g.fns) {
            const sym: int = fs.info.sym.id
            const pk: PlaceK = placeOf(s.places, sym)
            if ((pk == PlaceK.Client || pk == PlaceK.Ambient) && s.inherited.indexOf(sym) < 0) {
                const cx: PCx = { g: g, t: t, s: s, file: fs.info.file, inFn: true }
                const before: int = ps.plan.at.length
                ps = planBlock(cx, fs.f.body, ps)
                if (ps.plan.at.length > before) {
                    ps = withPlan(ps, { at: ps.plan.at, temps: ps.plan.temps, joins: ps.plan.joins, waiting: ps.plan.waiting.concat([sym]), rets: ps.plan.rets })
                    // a `defer` in a function that waits (§19.16.2 exit timing)
                    for (const d of defersIn(fs.f.body)) {
                        ps = pdiag(ps, cx, d, "a `defer` in a function that waits for the server (`" + fs.info.name + "()` suspends on a server call) — its body would run when the function's synchronous part ends, BEFORE the server answers, not at the function's exit (§19.16.2). It arrives with the §19.16.6 async-`defer` slice; until then move the cleanup after the call's handling")
                    }
                }
            }
        }
        for (const a of actionPositions(g)) {
            const cx2: PCx = { g: g, t: t, s: s, file: a.file, inFn: false }
            ps = planValue(cx2, a.v, ps)
        }
        return ps
    }

    fn withPlan(ps: PS, p: SuspendPlan) -> PS { return { st: ps.st, plan: p } }

    fn pdiag(ps: PS, cx: PCx, span: ASpan, msg: string) -> PS {
        return { st: addDiag(ps.st, cx.file, span, "E-BOOTSTRAP-UNSUPPORTED", msg), plan: ps.plan }
    }

    fn pmint(ps: PS, hint: string) -> RPSym {
        const r: RSym = mint(ps.st, hint)
        return { s: r.s, ps: { st: r.st, plan: ps.plan } }
    }
    type RPSym:struct = { s: Sym, ps: PS }

    // An event-handler value (a reference, an expression, a block) or an effect body.
    fn planValue(cx: PCx, v: AAttrValue, ps: PS) -> PS {
        return match v {
            .Bare(e: e) :> planHandlerExpr(cx, e, ps)
            .Paren(e: e) :> planHandlerExpr(cx, e, ps)
            .Braced(b: b) :> planBraced(cx, b, ps)
            .Quoted(v: x) :> ps
            .NoValue :> ps
        }
    }

    fn planBraced(cx: PCx, b: ABlock, ps: PS) -> PS {
        const r: AExpr | not = blockReference(b)
        if (r is given) return planReference(cx, r, ps)
        return planBlock(cx, b, ps)
    }

    fn planHandlerExpr(cx: PCx, e: AExpr, ps: PS) -> PS {
        if (exprName(e) != "") return planReference(cx, e, ps)
        return planExpr(cx, e, okPos(), ps).ps
    }

    // `onclick=save` / `onclick={ save }` — the event CALLS the function: a
    // suspension point when it waits.
    fn planReference(cx: PCx, e: AExpr, ps: PS) -> PS {
        const f: Sym | not = fnSymOf(nameFact(cx.t.names, e.nid))
        if (f is not) return ps
        if (!waitingClientFn(cx, f.id)) return ps
        const rb: RPSym = pmint(ps, "settled")
        return addAt(rb.ps, { nid: e.nid, bind: rb.s, kind: SuspendK.SWaits(f) })
    }

    fn addAt(ps: PS, a: SuspendAt) -> PS {
        return withPlan(ps, { at: ps.plan.at.concat([a]), temps: ps.plan.temps, joins: ps.plan.joins, waiting: ps.plan.waiting, rets: ps.plan.rets })
    }

    // Is function `sym` a client function that waits (§13.2 async colour)?
    fn waitingClientFn(cx: PCx, sym: int) -> boolean {
        const pk: PlaceK = placeOf(cx.s.places, sym)
        if (pk == PlaceK.Server || pk == PlaceK.Split) return false
        if (cx.s.inherited.indexOf(sym) >= 0) return false
        return waitsOf(cx.s, sym) is given
    }

    fn planBlock(cx: PCx, b: ABlock, ps0: PS) -> PS {
        let ps: PS = ps0
        let i: int = 0
        for (const s of b.stmts) {
            const rest: boolean = i < b.stmts.length - 1
            ps = planStmt(cx, s, rest, ps)
            i = i + 1
        }
        return ps
    }

    fn planStmt(cx: PCx, s: AStmt, rest: boolean, ps: PS) -> PS {
        const k: AStmtK = s.k
        return match k {
            .Eval(e: e) :> planStmtExpr(cx, e, ps)
            .Local(name: n, init: i) :> planExpr(cx, i, okPos(), ps).ps
            .Return(e: e) :> planMaybe(cx, e, ps)
            .If(cond: c, thenB: tb, elseB: eb) :> planBranches(cx, s, [tb].concat(maybeBlockList(eb)), rest, planExpr(cx, c, okPos(), ps).ps)
            .Given(name: n, subject: x, body: b) :> planBranches(cx, s, [b], rest, planExpr(cx, x, okPos(), ps).ps)
            .EffectStmt(w: w) :> ps
            .Defer(body: b) :> planDeferBody(cx, b, ps)
            .Fail(f: f) :> planExprs(cx, failExprs(f), ps)
        }
    }

    fn maybeBlockList(b: ABlock | not) -> ABlock[] {
        if (b is not) return []
        return [b]
    }

    fn planMaybe(cx: PCx, e: AExpr | not, ps: PS) -> PS {
        if (e is not) return ps
        return planExpr(cx, e, okPos(), ps).ps
    }

    fn planExprs(cx: PCx, es: AExpr[], ps0: PS) -> PS {
        let ps: PS = ps0
        for (const e of es) { ps = planExpr(cx, e, okPos(), ps).ps }
        return ps
    }

    // An expression statement: an assignment's TARGET is written after its
    // value; an indexed target's index is evaluated in the write (refused).
    fn planStmtExpr(cx: PCx, e: AExpr, ps: PS) -> PS {
        const k: AExprK = e.k
        const t: AExpr | not = assignTargetOf(k)
        const v: AExpr | not = assignedValue(e)
        if (t is given && v is given) {
            let pos: Pos = okPos()
            if (isIndexTarget(t)) pos = { refused: "the value of an indexed write (`@xs[i] = …`) — its index is evaluated in the write, after the value; it arrives with the U1b ANF follow-up. Evaluate the call into a `const` first" }
            return planExpr(cx, v, pos, ps).ps
        }
        return planExpr(cx, e, okPos(), ps).ps
    }

    fn assignTargetOf(k: AExprK) -> AExpr | not {
        return match k {
            .Assign(target: t) :> t
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: s) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Call(callee: c) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: x) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Index(obj: ix) :> not
            .Lambda(params: lp) :> not
            .Sql(q: q) :> not
            .Handled(h: x) :> not
        }
    }

    fn isIndexTarget(t: AExpr) -> boolean {
        const k: AExprK = t.k
        return match k {
            .Index(obj: o) :> true
            .Member(obj: o) :> isIndexTarget(o)
            .Name(name: n) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Num(raw: r) :> false
            .Str(v: s) :> false
            .Bool(v: b) :> false
            .NotLit :> false
            .Recovered :> false
            .Variant(name: n) :> false
            .Call(callee: c) :> false
            .Unary(op: o) :> false
            .Binary(op: o) :> false
            .Ternary(test: x) :> false
            .Assign(target: x) :> false
            .ArrayLit(elems: es) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: x) :> false
            .Lambda(params: lp) :> false
            .Sql(q: q) :> false
            .Handled(h: x) :> false
        }
    }

    // An `if` / `given`: plan each branch; when one suspends and statements
    // follow, the statement gets a join continuation.
    fn planBranches(cx: PCx, s: AStmt, bs: ABlock[], rest: boolean, ps0: PS) -> PS {
        let ps: PS = ps0
        const before: int = ps.plan.at.length
        for (const b of bs) { ps = planBlock(cx, b, ps) }
        if (ps.plan.at.length > before && rest) {
            const rk: RPSym = pmint(ps, "join")
            ps = rk.ps
            ps = withPlan(ps, { at: ps.plan.at, temps: ps.plan.temps, joins: ps.plan.joins.concat([{ nid: s.nid, k: rk.s }]), waiting: ps.plan.waiting, rets: ps.plan.rets })
        }
        return ps
    }

    // A deferred body: no suspension point may stand in it (check.scrml C16).
    fn planDeferBody(cx: PCx, b: ABlock, ps0: PS) -> PS {
        let ps: PS = ps0
        for (const s of b.stmts) {
            for (const e of stmtExprs(s)) { ps = planExpr(cx, e, { refused: "a `defer` body — a deferred body cannot wait (C16; §19.16.6 async `defer` arrives with its own slice)" }, ps).ps }
        }
        return ps
    }

    // The expressions a statement evaluates directly (not its nested blocks').
    fn stmtExprs(s: AStmt) -> AExpr[] {
        const k: AStmtK = s.k
        return match k {
            .Eval(e: e) :> [e]
            .Local(name: n, init: i) :> [i]
            .Return(e: e) :> maybeExprList(e)
            .If(cond: c) :> [c]
            .Given(name: n, subject: x) :> [x]
            .EffectStmt(w: w) :> []
            .Defer(body: b) :> []
            .Fail(f: f) :> failExprs(f)
        }
    }

    fn maybeExprList(e: AExpr | not) -> AExpr[] {
        if (e is not) return []
        return [e]
    }

    // The `defer` statements of a function body, at any depth (their spans).
    fn defersIn(b: ABlock) -> ASpan[] {
        let out: ASpan[] = []
        for (const s of b.stmts) {
            const k: AStmtK = s.k
            const sub: ASpan[] = match k {
                .Defer(body: d) :> [s.span]
                .If(cond: c, thenB: tb, elseB: eb) :> defersIn(tb).concat(defersInMaybe(eb))
                .Given(name: n, body: gb) :> defersIn(gb)
                .Eval(e: x) :> []
                .Local(name: n) :> []
                .Return(e: x) :> []
                .EffectStmt(w: w) :> []
                .Fail(f: x) :> []
            }
            out = out.concat(sub)
        }
        return out
    }

    fn defersInMaybe(b: ABlock | not) -> ASpan[] {
        if (b is not) return []
        return defersIn(b)
    }

    // ---- an expression -------------------------------------------------------------
    // Walk `e` in evaluation order. A child that holds a suspension point makes
    // every EARLIER sibling a temporary (unless it is a literal), so it is
    // evaluated before the suspension (left-to-right order kept).
    fn planExpr(cx: PCx, e: AExpr, pos: Pos, ps0: PS) -> PX {
        let ps: PS = ps0
        const sp: SuspendK | not = suspendKindAt(cx, e)
        if (sp is given) {
            // the point's own arguments are evaluated before it suspends
            ps = planKids(cx, suspendArgs(e), pos, ps).ps
            if (pos.refused != "") return { found: true, ps: pdiag(ps, cx, e.span, suspendWhat(sp) + " in " + pos.refused) }
            ps = routedChecks(cx, e, sp, ps)
            // a suspending handling form's arms run in its continuation: none may suspend (first cut)
            const hh: AHandled | not = handledOf(e.k)
            if (hh is given) ps = planArms(cx, hh, ps)
            const bind: Sym | not = handledOutcome(cx, e)
            if (bind is given) return { found: true, ps: addAt(ps, { nid: e.nid, bind: bind, kind: sp }) }
            const rb: RPSym = pmint(ps, "settled")
            return { found: true, ps: addAt(rb.ps, { nid: e.nid, bind: rb.s, kind: sp }) }
        }
        const k: AExprK = e.k
        return match k {
            .Binary(op: o, l: l, r: r) :> planBinary(cx, o, l, r, pos, ps)
            .Ternary(test: t, yes: y, no: n) :> planTernary(cx, t, y, n, pos, ps)
            .Lambda(params: lp, body: b) :> planExpr(cx, b, { refused: "a lambda (`xs.map(x => …)`) — an awaited combinator (§13.2) is not in the bootstrap; it arrives with the §13.2 awaited-combinator slice. Call it in a statement" }, ps)
            .Handled(h: h) :> planHandledArms(cx, h, pos, ps)
            .Member(obj: o) :> planKids(cx, [o], pos, ps)
            .Call(callee: c, args: a) :> planKids(cx, a, pos, ps)
            .Unary(op: o, e: x) :> planKids(cx, [x], pos, ps)
            .Assign(target: t, value: v) :> planKids(cx, [v], pos, ps)
            .ArrayLit(elems: es) :> planKids(cx, es, pos, ps)
            .ObjectLit(props: pr) :> planKids(cx, propValueList(pr), pos, ps)
            .Spread(e: x) :> planKids(cx, [x], pos, ps)
            .Index(obj: o, idx: i) :> planKids(cx, [o, i], pos, ps)
            .Sql(q: q) :> planKids(cx, q.params, pos, ps)
            .Name(name: n) :> { found: false, ps: ps }
            .At(name: n) :> { found: false, ps: ps }
            .AtItem :> { found: false, ps: ps }
            .Num(raw: r) :> { found: false, ps: ps }
            .Str(v: s) :> { found: false, ps: ps }
            .Bool(v: b) :> { found: false, ps: ps }
            .NotLit :> { found: false, ps: ps }
            .Recovered :> { found: false, ps: ps }
            .Variant(name: n) :> { found: false, ps: ps }
        }
    }

    // Children in evaluation order; a temporary for each non-literal child
    // evaluated before a later child that holds a suspension point.
    fn planKids(cx: PCx, kids: AExpr[], pos: Pos, ps0: PS) -> PX {
        let ps: PS = ps0
        let found = false
        let i: int = 0
        for (const k of kids) {
            const r: PX = planExpr(cx, k, pos, ps)
            ps = r.ps
            if (r.found) {
                found = true
                let j: int = 0
                for (const prev of kids) {
                    if (j < i && !isLiteralExpr(prev) && tempOf(ps.plan, prev.nid) is not && suspendAtOf(ps.plan, prev.nid) is not) {
                        const rt: RPSym = pmint(ps, "tmp")
                        ps = rt.ps
                        ps = withPlan(ps, { at: ps.plan.at, temps: ps.plan.temps.concat([{ nid: prev.nid, sym: rt.s }]), joins: ps.plan.joins, waiting: ps.plan.waiting, rets: ps.plan.rets })
                    }
                    j = j + 1
                }
            }
            i = i + 1
        }
        return { found: found, ps: ps }
    }

    fn isLiteralExpr(e: AExpr) -> boolean {
        const k: AExprK = e.k
        return match k {
            .Num(raw: r) :> true
            .Str(v: s) :> true
            .Bool(v: b) :> true
            .NotLit :> true
            .Variant(name: n) :> true
            .Name(name: n) :> false
            .At(name: n) :> false
            .AtItem :> false
            .Recovered :> false
            .Member(obj: o) :> false
            .Call(callee: c) :> false
            .Unary(op: o) :> false
            .Binary(op: o) :> false
            .Ternary(test: x) :> false
            .Assign(target: x) :> false
            .ArrayLit(elems: es) :> false
            .ObjectLit(props: ps) :> false
            .Spread(e: x) :> false
            .Index(obj: ix) :> false
            .Lambda(params: lp) :> false
            .Sql(q: q) :> false
            .Handled(h: x) :> false
        }
    }

    // `a && f()` / `a || f()`: the right operand runs on one path only.
    fn planBinary(cx: PCx, o: BinOp, l: AExpr, r: AExpr, pos: Pos, ps: PS) -> PX {
        if (o == BinOp.And || o == BinOp.Or) {
            const rl: PX = planExpr(cx, l, pos, ps)
            const rr: PX = planExpr(cx, r, condPos(pos, "the right operand of `&&` / `||`"), rl.ps)
            return { found: rl.found || rr.found, ps: rr.ps }
        }
        return planKids(cx, [l, r], pos, ps)
    }

    fn planTernary(cx: PCx, t: AExpr, y: AExpr, n: AExpr, pos: Pos, ps: PS) -> PX {
        const rt: PX = planExpr(cx, t, pos, ps)
        const ry: PX = planExpr(cx, y, condPos(pos, "a branch of `? :`"), rt.ps)
        const rn: PX = planExpr(cx, n, condPos(pos, "a branch of `? :`"), ry.ps)
        return { found: rt.found || ry.found || rn.found, ps: rn.ps }
    }

    fn condPos(pos: Pos, what: string) -> Pos {
        if (pos.refused != "") return pos
        return { refused: what + " — it runs on one path only, and lifting it out would run it on both; it arrives with the U1b conditional-lowering follow-up. Write an `if` statement: a call in an `if` branch suspends" }
    }

    // A handling form that is NOT a suspension point: its subject's arguments
    // are evaluated in place; its arms cannot suspend in this slice.
    fn planHandledArms(cx: PCx, h: AHandled, pos: Pos, ps0: PS) -> PX {
        const r: PX = planKids(cx, [h.subject], pos, ps0)
        return { found: r.found, ps: planArms(cx, h, r.ps) }
    }

    fn planArms(cx: PCx, h: AHandled, ps0: PS) -> PS {
        let ps: PS = ps0
        const armPos: Pos = { refused: "a `!{}` / `match` arm — an arm that waits needs a continuation out of the arm, which arrives with the U1b arm-continuation follow-up. Handle the outer call, then make this call in the statement after it" }
        for (const a of handledArms(h)) {
            const b: AArmBody = a.body
            for (const x of armExprOf(b)) { ps = planExpr(cx, x, armPos, ps).ps }
            for (const blk of armBlockOf(b)) {
                for (const s of blk.stmts) {
                    for (const e of stmtExprs(s)) { ps = planExpr(cx, e, armPos, ps).ps }
                }
            }
        }
        return ps
    }

    // Is `e` a suspension point (and of which kind)?
    fn suspendKindAt(cx: PCx, e: AExpr) -> SuspendK | not {
        const h: AHandled | not = handledOf(e.k)
        if (h is given) {
            const hf: HandledFact | not = handledFactIn(cx.t, e.nid)
            if (hf is given) {
                const rf: RemoteFact | not = hf.remote
                if (rf is given) {
                    if (callerRemote(cx.s, rf.caller)) return SuspendK.SRemote(rf.callee)
                    return not
                }
            }
            const f: Sym | not = callSym(cx.t, h.subject)
            if (f is given) {
                if (waitingClientFn(cx, f.id)) return SuspendK.SWaits(f)
            }
            return not
        }
        const c: Sym | not = callSym(cx.t, e)
        if (c is given) {
            if (waitingClientFn(cx, c.id)) return SuspendK.SWaits(c)
        }
        return not
    }

    // The scrml function a call expression names, else not.
    fn callSym(t: Tables, e: AExpr) -> Sym | not {
        const c: AExpr | not = calleeOf(e.k)
        if (c is not) return not
        return fnSymOf(nameFact(t.names, c.nid))
    }

    fn handledFactIn(t: Tables, nid: int) -> HandledFact | not {
        const f: FailFact | not = failFact(t.fails, nid)
        return match f {
            .FHandled(h: h) :> h
            .FArm(idx: x) :> not
            .FFail(err: x) :> not
            not :> not
        }
    }

    fn handledOutcome(cx: PCx, e: AExpr) -> Sym | not {
        if (handledOf(e.k) is not) return not
        const hf: HandledFact | not = handledFactIn(cx.t, e.nid)
        if (hf is not) return not
        return hf.outcome
    }

    // The expressions a suspension point evaluates before it suspends: its call's arguments.
    fn suspendArgs(e: AExpr) -> AExpr[] {
        const h: AHandled | not = handledOf(e.k)
        let call: AExpr = e
        if (h is given) call = h.subject
        const k: AExprK = call.k
        return match k {
            .Call(callee: c, args: a) :> a
            .Name(name: n) :> []
            .At(name: n) :> []
            .AtItem :> []
            .Num(raw: r) :> []
            .Str(v: s) :> []
            .Bool(v: b) :> []
            .NotLit :> []
            .Recovered :> []
            .Variant(name: n) :> []
            .Member(obj: o) :> []
            .Unary(op: o) :> []
            .Binary(op: o) :> []
            .Ternary(test: x) :> []
            .Assign(target: x) :> []
            .ArrayLit(elems: es) :> []
            .ObjectLit(props: ps) :> []
            .Spread(e: x) :> []
            .Index(obj: ix) :> []
            .Lambda(params: lp) :> []
            .Sql(q: q) :> []
            .Handled(h: x) :> []
        }
    }

    fn suspendWhat(k: SuspendK) -> string {
        return match k {
            .SRemote(callee: f) :> "a client call of the server function `" + f.hint + "` (§19.9.10) stands"
            .SWaits(callee: f) :> "a call of `" + f.hint + "`, which waits for the server (§13.2: it calls a server function), stands"
        }
    }

    // A client call's route needs a wire type at both ends (§57.4 R10: the
    // client decodes strictly against the declared return type).
    fn routedChecks(cx: PCx, e: AExpr, k: SuspendK, ps0: PS) -> PS {
        const f: Sym | not = match k {
            .SRemote(callee: c) :> c
            .SWaits(callee: c) :> not
        }
        if (f is not) return ps0
        let ps: PS = ps0
        const fs: FnSrc | not = fnSrcOf(cx.g, f.id)
        if (fs is not) return ps
        if (fs.info.arity < 0) ps = pdiag(ps, cx, e.span, "a client call of `" + fs.info.name + "`, whose parameters are not all typed — the call's arguments cross the wire, encoded against each parameter's declared type (§57); declare every parameter's type")
        if (fs.info.ret is given || retOf(ps.plan, f.id) is given) return ps
        if (!fs.info.failable && yieldsNoValue(cx.s, f.id)) return ps          // no value: the 204 contract
        const rt: RetType = provenReturn(cx, fs.f.body)
        const ty: Type | not = rt.ty
        if (ty is not) return pdiag(ps, cx, e.span, "a client call of `" + fs.info.name + "`: the client decodes the server's answer strictly against the function's success type (§57.4, S451 R10), and `" + fs.info.name + "` declares none and its returns do not prove one (" + rt.why + ")" + declareHint(fs.info))
        const pc: PlaceCx = { t: cx.t, g: cx.g }
        const state: string = stateTypeIn(cx.g, ty)
        if (state != "") return pdiag(ps, cx, e.span, "a client call of `" + fs.info.name + "`, whose answer holds `" + state + "`, a declaration's instance — a live state object with no wire form (§12.5.3)")
        if (wireBuild(typesProgram(cx.g), ty).table is not) return pdiag(ps, cx, e.span, "a client call of `" + fs.info.name + "`, whose answer's type has no wire descriptor in the bootstrap's codec")
        return withPlan(ps, { at: ps.plan.at, temps: ps.plan.temps, joins: ps.plan.joins, waiting: ps.plan.waiting, rets: ps.plan.rets.concat([{ sym: f.id, ty: ty }]) })
    }

    fn declareHint(f: FnInfo) -> string {
        if (f.failable) return "; a `!` function has no success-type annotation (§19.4.1), so make every `return` carry a value of one known type"
        return "; declare it (`-> T`)"
    }

    // The ONE type every `return` in a body carries (§19.4.2 "inferred from its
    // returns"), by the typer's proven types — else why not.
    type RetType:struct = { ty: Type | not, why: string }

    fn provenReturn(cx: PCx, b: ABlock) -> RetType {
        const rs: ReturnSite[] = returnSites(b)
        if (rs.length == 0) return { ty: not, why: "it has no `return`" }
        let ty: Type | not = not
        for (const r of rs) {
            const x: AExpr | not = r.e
            if (x is not) return { ty: not, why: "a `return` without a value" }
            const vt: VType = exprType(cx.t, x.nid)
            const t: Type | not = knownType(vt)
            if (t is not) return { ty: not, why: "the type of a returned value is not proven" }
            if (ty is given) {
                if (!(ty == t)) return { ty: not, why: "its returns carry different types" }
            }
            ty = t
        }
        return { ty: ty, why: "" }
    }

    fn knownType(vt: VType) -> Type | not {
        return match vt {
            .Known(t: t) :> t
            .Absent :> not
            .Unknown :> not
        }
    }

    type ReturnSite:struct = { e: AExpr | not }

    // Every `return` in a body, at any depth (an `if` / `given` branch, a
    // handling form's arm block — whose `return` leaves the function).
    fn returnSites(b: ABlock) -> ReturnSite[] {
        let out: ReturnSite[] = []
        for (const s of b.stmts) {
            const k: AStmtK = s.k
            const sub: ReturnSite[] = match k {
                .Return(e: x) :> [{ e: x }].concat(returnSitesIn(x))
                .If(cond: c, thenB: tb, elseB: eb) :> returnSitesIn(c).concat(returnSites(tb)).concat(returnSitesMaybe(eb))
                .Given(name: n, subject: x, body: gb) :> returnSites(gb)
                .Eval(e: x) :> returnSitesIn(x)
                .Local(name: n, init: i) :> returnSitesIn(i)
                .EffectStmt(w: w) :> []
                .Defer(body: d) :> []
                .Fail(f: x) :> []
            }
            out = out.concat(sub)
        }
        return out
    }

    fn returnSitesMaybe(b: ABlock | not) -> ReturnSite[] {
        if (b is not) return []
        return returnSites(b)
    }

    // `return`s inside a handling form's arm blocks in an expression.
    fn returnSitesIn(e: AExpr | not) -> ReturnSite[] {
        if (e is not) return []
        let out: ReturnSite[] = []
        for (const b of exprBlocks(e)) { out = out.concat(returnSites(b)) }
        for (const x of exprKids(e)) { out = out.concat(returnSitesIn(x)) }
        return out
    }

    // =========================================================================
    // Entry. `files` in LINK ORDER: every file after the files it imports; the
    // entry (the file with `<program>`) last.
    // =========================================================================
    export fn analyze(files: FileAst[], entry: string) -> TypedProgram {
        const st0: AS = { facts: noFacts(), diags: [], nextSym: 0, annots: [], bad: { params: [], fields: [] }, effects: [], pend: [] }
        const ra: RGlobals = phaseA(files, entry, st0)
        let st: AS = checkImports(files, ra.g, ra.st)
        st = phaseB(ra.g, st)
        st = strayEffects(files, st)
        const rr: RResets = resetOnPass(ra.g, st)
        st = rr.st
        const rp: RPersists = persistPass(ra.g, files, st)
        st = rp.st
        let decls: DeclInfo[] = []
        for (const d of ra.g.decls) { decls = decls.concat([d.info]) }
        let fns: FnInfo[] = []
        for (const f of ra.g.fns) { fns = fns.concat([f.info]) }
        // The binder's tables, then the two passes that read them: the scope
        // pass (redeclarations) and the typer (value types). Each returns new
        // values; the final Tables carries the typer's own table.
        const fs: NodeFacts = indexed(st.facts)
        const bound: Tables = { program: ra.g.program, types: ra.g.types, decls: decls, fns: fns, handles: ra.g.handles,
                                names: fs.names, values: fs.values, effects: fs.effects, binds: fs.binds, elems: fs.elems,
                                attrs: fs.attrs, fails: fs.fails, annots: st.annots, unresolved: st.bad, typing: { exprs: [], at: [], presence: [] },
                                novalidate: [], resets: rr.infos, gated: [], persists: rp.infos, server: noServerFacts() }
        const scopeDiags: Diag[] = checkScopes(files, bound)
        // s452 (dpa-066): THE EFFECT SUMMARY — once, over the bound tables —
        // and the binder's decisions that read it (rulesPass, M3)
        const sum: Summary = summarize(ra.g, bound)
        st = rulesPass(sum, st)
        // s449: the no-write rule over every accepted effect (§6.7.4)
        const effectDiags: Diag[] = effectPass(ra.g, bound, st.effects, sum)
        // s444 Phase B: dead validators (RULED S442 (5)) and the forms that take `novalidate` (RULED S442 (3))
        const vp: ValPass = validatorPass(ra.g, bound)
        const typed: RTyping = typeProgram(files, bound, st.diags.concat(scopeDiags).concat(effectDiags).concat(vp.diags))
        // s451 (U1a): route placement, the queries and the databases
        const pp: RPlaced = placePass(ra.g, bound, st, sum)
        // s454 (U1b): the suspension plan — per client site, after placement (it
        // reads the typer's proven types: a server function's inferred success type)
        const typedT: Tables = { program: bound.program, types: bound.types, decls: bound.decls, fns: bound.fns, handles: bound.handles,
                                 names: bound.names, values: bound.values, effects: bound.effects, binds: bound.binds,
                                 elems: bound.elems, attrs: bound.attrs, fails: bound.fails, annots: bound.annots, unresolved: bound.unresolved, typing: typed.typing,
                                 novalidate: vp.forms, resets: bound.resets, gated: vp.gated, persists: bound.persists, server: pp.facts }
        const pl: PS = planPass(ra.g, typedT, sum, pp.st)
        const sf: ServerFacts = { servers: pp.facts.servers, sqls: pp.facts.sqls, dbs: pp.facts.dbs, places: pp.facts.places,
                                  inherited: pp.facts.inherited, plan: pl.plan }
        const t: Tables = { program: bound.program, types: bound.types, decls: bound.decls, fns: bound.fns, handles: bound.handles,
                            names: bound.names, values: bound.values, effects: bound.effects, binds: bound.binds,
                            elems: bound.elems, attrs: bound.attrs, fails: bound.fails, annots: bound.annots, unresolved: bound.unresolved, typing: typed.typing,
                            novalidate: vp.forms, resets: bound.resets, gated: vp.gated, persists: bound.persists, server: sf }
        return { files: files, tables: t, diags: domScopeDropped(pl.st.diags, pp.doms).concat(scopeDiags).concat(effectDiags).concat(vp.diags).concat(typed.diags),
                 infos: gatedInfos(vp.gated) }
    }

    // s451 (U1a): a DOM global in a server-triggered body is E-ROUTE-005 (the
    // function cannot be placed, §12.4), not also "not declared".
    fn domScopeDropped(ds: Diag[], doms: int[]) -> Diag[] {
        if (doms.length == 0) return ds
        let out: Diag[] = []
        for (const d of ds) {
            if (!(d.code == "E-SCOPE-001" && doms.indexOf(d.span.start) >= 0)) out = out.concat([d])
        }
        return out
    }

    // s449 — I-FORM-SUBMIT-GATED (§55.17.6 item 1): "one per gated form, at the
    // form's opener, naming the gating values in source order: *"this form's
    // submit is gated by: email, password"*".
    fn gatedInfos(gs: GateInfo[]) -> Diag[] {
        let out: Diag[] = []
        for (const g of gs) {
            // a form that binds only unvalidated fields records the submit (§55.7) but gates nothing
            if (g.values.length > 0) out = out.concat([newDiag("I-FORM-SUBMIT-GATED",
                "this form's submit is gated by: " + g.values.join(", ") + " — the compiler blocks the submit while any of them is invalid, before the form's `onsubmit` runs (§55.17.3); a submit button carrying `formnovalidate` bypasses the block (§55.17.4)", g.file, g.span)])
        }
        return out
    }

    // =========================================================================
    // s444 Phase B — THE VALIDATOR PASS, over the bound tables.
    //  - §55.5.2 (S447 call 4, narrowing RULED S442 (5)): validators are DEAD —
    //    E-VALIDATOR-DEAD — only when nothing can ever change the value: no
    //    `bind:` targets it, it is locked (no write grant), it is not
    //    server-loaded, not seeded at a use site, not restored by `persist=`.
    //    (`server` is not in the bootstrap — refused where written; s451:
    //    `persist=` is, but only on a writable cell — persistPass refuses it on
    //    a locked one — so "locked" already implies "not restored".) A `let`
    //    value set only from logic is LIVE: its
    //    surface reports what logic writes.
    //  - RULED S442 (3) "the compiler adds `novalidate` to any form carrying
    //    lowered attributes": every `<form>` whose markup — through `<*f/>`
    //    inlines, `<*x/>` Stars, uses, `<each>` rows and state-view arms — holds
    //    a bound element with lowered validator attributes.
    // =========================================================================
    type ValPass:struct = { diags: Diag[], forms: int[], gated: GateInfo[] }
    type BindKey:struct = { decl: int, idx: int }

    fn validatorPass(g: Globals, t: Tables) -> ValPass {
        let keys: BindKey[] = []
        for (const k of t.attrs.facts) { keys = keys.concat(bindKeyOf(k)) }
        let seeds: BindKey[] = []
        for (const ds of g.decls) {
            for (const n of declMarkup(ds)) { seeds = seeds.concat(seedKeysIn(t, n)) }
        }
        let diags: Diag[] = []
        for (const ds of g.decls) {
            let i = 0
            for (const f of ds.info.fields) {
                const locked: boolean = f.wcap is not
                if (f.vals.length > 0 && locked && !hasBindKey(keys, ds.info.sym.id, i) && !hasBindKey(seeds, ds.info.sym.id, i)) {
                    diags = diags.concat([newDiag("E-VALIDATOR-DEAD",
                        "`" + f.sym.hint + "` has validators, but nothing can ever change its value — it is locked (no `let`), no `bind:` targets it, and no use site seeds it — so its validity is a compile-time constant and the validators can never report a change (§55.5.2); make it `let` (and bind it or set it from logic), or drop the validators", ds.file, f.span)])
                }
                i = i + 1
            }
        }
        // r2 F1: a `<slot/>` in a declaration's markup is filled by the
        // children of every use of that declaration — collect the use sites.
        let uses: UseSite[] = []
        for (const ds of g.decls) {
            for (const n of declMarkup(ds)) { uses = uses.concat(useSitesIn(t, ds.info.sym.id, n)) }
        }
        let forms: int[] = []
        let gated: GateInfo[] = []
        for (const ds of g.decls) {
            const cx: CarryCx = { g: g, t: t, uses: uses, seen: [], slot: ds.info.sym.id, slotSeen: [] }
            for (const n of declMarkup(ds)) {
                forms = forms.concat(formsIn(cx, n))
                for (const gi of gatesIn(cx, n)) { gated = gated.concat([{ form: gi.form, values: gi.values, span: gi.span, file: ds.file }]) }
            }
        }
        return { diags: diags, forms: forms, gated: gated }
    }

    // ---- s449: THE GATED FORMS (§55.17.3) ------------------------------------
    // "A gated form is every `<form>` whose composed subtree (§55.17.2 rule 1)
    // contains a native control whose `bind:` targets a value that carries
    // validators, whether or not any of those validators lowers to an HTML
    // attribute." The composed subtree is the one `novalidate` walks
    // (formsIn): inlines, Stars, uses, `<each>` rows, state-view arms, slot
    // content. A form the author wrote `novalidate` on is gated all the same
    // (S447 gate-calls item 1: "with or without `novalidate`").
    fn gatesIn(cx: CarryCx, n: ANode) -> GateInfo[] {
        const k: ANodeK = n.k
        return match k {
            .Elem(e: e) :> gatesInElem(cx, e)
            .Text(text: x) :> []
            .Interp(e: x) :> []
            .DeclNode(d: d) :> []
            .Effect(w: w) :> []
        }
    }

    fn gatesInElem(cx: CarryCx, e: AElem) -> GateInfo[] {
        let out: GateInfo[] = []
        if (e.tag == "form" && !e.star && isHtmlFact(elemFact(cx.t.elems, e.nid))) {
            // §55.7: a form that binds ANY field with a surface sets `submitted`
            // (`all`); it is GATED (§55.17.3) when one of them carries validators.
            const surfaced: string[] = elemBound(cx, e, true)
            if (surfaced.length > 0) out = [{ form: e.nid, values: elemBound(cx, e, false), span: e.span, file: "" }]
        }
        for (const k of e.kids) { out = out.concat(gatesIn(cx, k)) }
        return out
    }

    // The validated values bound under this element (through its expansion
    // and its children), named, each once, in source order. `all`: every
    // bound value that has a surface (a validated top-level value, any field
    // of a user declaration), not only the validated ones.
    fn elemBound(cx: CarryCx, e: AElem, all: boolean) -> string[] {
        let out: string[] = []
        for (const a of e.attrs) { out = addNames(out, boundValidated(cx.t, attrFact(cx.t.attrs, a.nid), all)) }
        out = addNames(out, expansionBound(cx, elemFact(cx.t.elems, e.nid), all))
        return addNames(out, nodesBound(cx, e.kids, all))
    }

    fn addNames(xs: string[], ys: string[]) -> string[] {
        let out: string[] = xs
        for (const y of ys) {
            if (out.indexOf(y) < 0) out = out.concat([y])
        }
        return out
    }

    fn nodesBound(cx: CarryCx, ns: ANode[], all: boolean) -> string[] {
        let out: string[] = []
        for (const n of ns) {
            const k: ANodeK = n.k
            const el: AElem | not = elemOfNode(k)
            if (el is given) out = addNames(out, elemBound(cx, el, all))
        }
        return out
    }

    // A bind of a field's WHOLE value whose field carries validators → its name.
    fn boundValidated(t: Tables, k: AttrKind | not, all: boolean) -> string[] {
        return match k {
            .ABind(w: w, decl: d, idx: i) :> validatedName(t, w, d, i, all)
            .AStatic :> []
            .ABound :> []
            .AOn(event: ev) :> []
            .AIf :> []
            .AShow :> []
            .AConstruct(field: x) :> []
            .AAs :> []
            .AEachIn :> []
            .AEachKey :> []
            .AEachAs :> []
            not :> []
        }
    }

    fn validatedName(t: Tables, w: WriteFact, d: Sym, i: int, all: boolean) -> string[] {
        if (bindKeyFor(w, d, i).length == 0) return []
        const di: DeclInfo | not = declInfo(t, d)
        if (di is not) return []
        if (i < 0 || i >= di.fields.length) return []
        const surfacedOnly: boolean = all && di.sym.id != t.program.id
        if (di.fields[i].vals.length == 0 && !surfacedOnly) return []
        if (di.sym.id == t.program.id) return [di.fields[i].sym.hint]
        return [di.sym.hint + "." + di.fields[i].sym.hint]
    }

    fn expansionBound(cx: CarryCx, f: ElemFact | not, all: boolean) -> string[] {
        return match f {
            .MInline(v: v) :> nodesBound(cx, v.nodes, all)
            .MStar(decl: d) :> nodesBound(intoDecl(cx, d), declRendersOnce(cx, d), all)
            .MUse(decl: d) :> nodesBound(intoDecl(cx, d), declRendersOnce(cx, d), all)
            .MStateView(v: v) :> nodesBound(cx, stateArmNodes(v), all)
            .MSlot :> slotBound(cx, all)
            .MDb :> []
            .MErrors(of: x) :> []
            .MHtml :> []
            .MEach(bind: b) :> []
            not :> []
        }
    }

    fn slotBound(cx: CarryCx, all: boolean) -> string[] {
        if (cx.slot < 0 || cx.slotSeen.indexOf(cx.slot) >= 0) return []
        let out: string[] = []
        for (const u of cx.uses) {
            if (u.decl == cx.slot) {
                const ux: CarryCx = { g: cx.g, t: cx.t, uses: cx.uses, seen: cx.seen, slot: u.owner, slotSeen: cx.slotSeen.concat([cx.slot]) }
                out = addNames(out, nodesBound(ux, u.kids, all))
            }
        }
        return out
    }

    // s449 — the fields a USE seeds (`<f v="x"/>`, a use-site value, §66.9
    // rule 8): a locked validated field seeded there is LIVE (§55.5.2 (4)).
    fn seedKeysIn(t: Tables, n: ANode) -> BindKey[] {
        const k: ANodeK = n.k
        const e: AElem | not = elemOfNode(k)
        if (e is not) return []
        let out: BindKey[] = []
        const used: Sym | not = useDeclOf(elemFact(t.elems, e.nid))
        if (used is given) {
            for (const a of e.attrs) {
                const i: int = constructIdx(attrFact(t.attrs, a.nid))
                if (i >= 0) out = out.concat([{ decl: used.id, idx: i }])
            }
        }
        for (const c of e.kids) { out = out.concat(seedKeysIn(t, c)) }
        return out
    }

    fn useDeclOf(f: ElemFact | not) -> Sym | not {
        return match f {
            .MUse(decl: d) :> d
            .MStar(decl: d) :> not
            .MInline(v: v) :> not
            .MStateView(v: v) :> not
            .MHtml :> not
            .MEach(bind: b) :> not
            .MSlot :> not
            .MDb :> not
            .MErrors(of: x) :> not
            not :> not
        }
    }

    fn constructIdx(k: AttrKind | not) -> int {
        return match k {
            .AConstruct(field: i) :> i
            .AStatic :> -1
            .ABound :> -1
            .AOn(event: ev) :> -1
            .AIf :> -1
            .AShow :> -1
            .AAs :> -1
            .AEachIn :> -1
            .AEachKey :> -1
            .AEachAs :> -1
            .ABind(kind: b) :> -1
            not :> -1
        }
    }

    // A use of declaration `decl` (`<decl …>kids</>`) written in `owner`'s
    // markup: its `kids` fill `decl`'s `<slot/>`.
    type UseSite:struct = { decl: int, owner: int, kids: ANode[] }

    fn useSitesIn(t: Tables, owner: int, n: ANode) -> UseSite[] {
        const k: ANodeK = n.k
        const e: AElem | not = elemOfNode(k)
        if (e is not) return []
        let out: UseSite[] = useSiteOf(elemFact(t.elems, e.nid), owner, e.kids)
        for (const c of e.kids) { out = out.concat(useSitesIn(t, owner, c)) }
        return out
    }

    fn useSiteOf(f: ElemFact | not, owner: int, kids: ANode[]) -> UseSite[] {
        return match f {
            .MUse(decl: d) :> [{ decl: d.id, owner: owner, kids: kids }]
            .MStar(decl: d) :> []
            .MInline(v: v) :> []
            .MStateView(v: v) :> []
            .MHtml :> []
            .MEach(bind: b) :> []
            .MSlot :> []
            .MDb :> []
            .MErrors(of: x) :> []
            not :> []
        }
    }

    // The traversal context: `seen` — the declarations already being expanded
    // (a renders may reach itself); `slot` — the declaration whose uses fill a
    // `<slot/>` met here (-1: none — inside a use's expansion the slot is that
    // use's own children, which the traversal visits as the use's kids);
    // `slotSeen` — the declarations whose slot content is being visited.
    type CarryCx:struct = { g: Globals, t: Tables, uses: UseSite[], seen: int[], slot: int, slotSeen: int[] }

    fn bindKeyOf(k: AttrKind) -> BindKey[] {
        return match k {
            .ABind(w: w, decl: d, idx: i) :> bindKeyFor(w, d, i)
            .AStatic :> []
            .ABound :> []
            .AOn(event: ev) :> []
            .AIf :> []
            .AShow :> []
            .AConstruct(field: x) :> []
            .AAs :> []
            .AEachIn :> []
            .AEachKey :> []
            .AEachAs :> []
        }
    }

    // Only a bind of the field's WHOLE value (not a sub-field path) is its bind.
    fn bindKeyFor(w: WriteFact, d: Sym, i: int) -> BindKey[] {
        const isWhole: boolean = w.edit == EditKind.Replace
        if (!isWhole) return []
        return [{ decl: d.id, idx: i }]
    }

    fn hasBindKey(ks: BindKey[], d: int, i: int) -> boolean {
        for (const k of ks) {
            if (k.decl == d && k.idx == i) return true
        }
        return false
    }

    // All the markup a declaration owns: its renders, state-child bodies, child renders.
    fn declMarkup(ds: DeclSrc) -> ANode[] {
        let out: ANode[] = rendersNodes(ds).concat(stateBodies(ds))
        if (ds.p is not) {
            for (const fd of fieldDecls(ds)) { out = out.concat(rendersOf(fd)) }
        }
        return out
    }

    // The `<form>` elements under `n` that carry lowered attributes.
    fn formsIn(cx: CarryCx, n: ANode) -> int[] {
        const k: ANodeK = n.k
        return match k {
            .Elem(e: e) :> formsInElem(cx, e)
            .Text(text: x) :> []
            .Interp(e: x) :> []
            .DeclNode(d: d) :> []
            .Effect(w: w) :> []
        }
    }

    fn formsInElem(cx: CarryCx, e: AElem) -> int[] {
        let out: int[] = []
        if (e.tag == "form" && !e.star && isHtmlFact(elemFact(cx.t.elems, e.nid)) && attrNamed(e.attrs, "novalidate") is not) {
            if (elemCarries(cx, e)) out = [e.nid]
        }
        for (const k of e.kids) { out = out.concat(formsIn(cx, k)) }
        return out
    }

    fn isHtmlFact(f: ElemFact | not) -> boolean {
        return match f {
            .MHtml :> true
            .MUse(decl: d) :> false
            .MEach(bind: b) :> false
            .MSlot :> false
            .MDb :> false
            .MErrors(of: x) :> false
            .MStateView(v: v) :> false
            .MInline(v: v) :> false
            .MStar(decl: d) :> false
            not :> false
        }
    }

    // Does this markup hold a bound element with lowered attributes?
    fn nodesCarry(cx: CarryCx, ns: ANode[]) -> boolean {
        for (const n of ns) {
            const k: ANodeK = n.k
            const el: AElem | not = elemOfNode(k)
            if (el is given) {
                if (elemCarries(cx, el)) return true
            }
        }
        return false
    }

    fn elemOfNode(k: ANodeK) -> AElem | not {
        return match k {
            .Elem(e: e) :> e
            .Text(text: x) :> not
            .Interp(e: x) :> not
            .DeclNode(d: d) :> not
            .Effect(w: w) :> not
        }
    }

    fn elemCarries(cx: CarryCx, e: AElem) -> boolean {
        for (const a of e.attrs) {
            if (lowersAttrs(attrFact(cx.t.attrs, a.nid))) return true
        }
        const f: ElemFact | not = elemFact(cx.t.elems, e.nid)
        if (expansionCarries(cx, f)) return true
        return nodesCarry(cx, e.kids)
    }

    fn lowersAttrs(k: AttrKind | not) -> boolean {
        return match k {
            .ABind(vattrs: vs) :> vs.length > 0
            .AStatic :> false
            .ABound :> false
            .AOn(event: ev) :> false
            .AIf :> false
            .AShow :> false
            .AConstruct(field: x) :> false
            .AAs :> false
            .AEachIn :> false
            .AEachKey :> false
            .AEachAs :> false
            not :> false
        }
    }

    // The markup an element stands for beyond its own children: an inlined
    // renders, a Star's / a use's declaration renders, state-view arm bodies,
    // and (r2 F1) a `<slot/>`'s content — the children of every use of the
    // declaration whose markup holds it. A form's `novalidate` is one static
    // attribute of the declaration's markup, so it is added when ANY use's
    // slot content carries lowered attributes.
    fn expansionCarries(cx: CarryCx, f: ElemFact | not) -> boolean {
        return match f {
            .MInline(v: v) :> nodesCarry(cx, v.nodes)
            .MStar(decl: d) :> nodesCarry(intoDecl(cx, d), declRendersOnce(cx, d))
            .MUse(decl: d) :> nodesCarry(intoDecl(cx, d), declRendersOnce(cx, d))
            .MStateView(v: v) :> nodesCarry(cx, stateArmNodes(v))
            .MSlot :> slotCarries(cx)
            .MDb :> false
            .MErrors(of: x) :> false
            .MHtml :> false
            .MEach(bind: b) :> false
            not :> false
        }
    }

    // Into a declaration's renders through a Star / a use: that renders' own
    // `<slot/>` is the use's children (visited as its kids) — no slot owner.
    fn intoDecl(cx: CarryCx, d: Sym) -> CarryCx {
        return { g: cx.g, t: cx.t, uses: cx.uses, seen: cx.seen.concat([d.id]), slot: -1, slotSeen: cx.slotSeen }
    }

    fn slotCarries(cx: CarryCx) -> boolean {
        if (cx.slot < 0 || cx.slotSeen.indexOf(cx.slot) >= 0) return false
        for (const u of cx.uses) {
            if (u.decl == cx.slot) {
                const ux: CarryCx = { g: cx.g, t: cx.t, uses: cx.uses, seen: cx.seen, slot: u.owner, slotSeen: cx.slotSeen.concat([cx.slot]) }
                if (nodesCarry(ux, u.kids)) return true
            }
        }
        return false
    }

    fn declRendersOnce(cx: CarryCx, d: Sym) -> ANode[] {
        if (cx.seen.indexOf(d.id) >= 0) return []
        const ds: DeclSrc | not = findDeclSrc(cx.g, d)
        if (ds is not) return []
        return declMarkup(ds)
    }

    fn stateArmNodes(v: StateView) -> ANode[] {
        let out: ANode[] = []
        for (const a of v.arms) { out = out.concat(a.body) }
        return out
    }

    // Every imported name must be an EXPORTED type / declaration / function of a
    // file in the link set.
    fn checkImports(files: FileAst[], g: Globals, st0: AS) -> AS {
        let st: AS = st0
        for (const f of files) {
            for (const it of f.items) {
                const imp: AImport | not = importOf(it)
                if (imp is given) {
                    for (const n of imp.names) {
                        if (!exportedAnywhere(g, n.name)) {
                            st = addDiag(st, f.path, n.span, "E-IMPORT-NOT-EXPORTED", "`" + n.name + "` is not exported by `" + imp.from + "`")
                        }
                    }
                }
            }
        }
        return st
    }

    fn importOf(it: AItem) -> AImport | not {
        const k: AItemK = it.k
        return match k {
            .ImportItem(i: i) :> i
            .TypeItem(t: t) :> not
            .FnItem(f: f) :> not
            .DeclItem(d: d) :> not
            .MarkupItem(n: n) :> not
            .ProgramItem(p: p) :> not
        }
    }

    fn exportedAnywhere(g: Globals, name: string) -> boolean {
        for (const t of g.types) {
            if (t.name == name && t.exported) return true
        }
        for (const d of g.decls) {
            const ad: ADecl | not = d.d
            if (ad is given) {
                if (ad.name == name && ad.exported) return true
            }
        }
        for (const f of g.fns) {
            if (f.info.name == name && f.info.exported) return true
        }
        return false
    }
}
