// =============================================================================
// self-host-v2 / ingest.scrml — THE INGEST SHIM: impl#1's FileAST → Core
// (bootstrap M3 item 3; dpa-051 §8.3, ruled R5 at S437: "build the throwaway
// ingest shim now").
//
// WHAT THIS IS. The conformance corpus is written in pre-§66 syntax that the
// bootstrap front end (parse.scrml) does not parse, so without this module
// nothing can grade the bootstrap on the corpus. This module takes the FileAST
// impl#1 hands its CG stage and produces the bootstrap's Core (core.scrml), so
// the bootstrap PRINTER + RUNTIME can be graded on real conformance cases by
// conformance FOOTPRINT (dpa-051 §8.2).
//
// ⚑ THE ONE SANCTIONED EARLY HYBRID — its terms:
//   - It is confined to this module. Nothing else in the bootstrap reads
//     impl#1's AST.
//   - It is NEVER graded by parity with impl#1's output (S337). It is graded
//     only by what the cases assert: codes and runtime effect.
//   - DELETION CONDITION: delete this module (and slice-m3/'s substitute) when
//     bootstrap `analyze` produces a TypedProgram for the conformance corpus.
//     From then on the corpus is graded through the bootstrap's own front end.
//
// HOW LEGACY FORMS MAP (SPEC §66.21, the retired-form table). Every mapping
// below is the §66 Core MEANING of the legacy form, never a guess:
//   `<x> = v`         → a field of the program declaration with the
//                       TRANSITIONAL ALL-PERMISSIONS GRANT (§66.12.4): replace,
//                       plus every sequence edit when the value is a sequence.
//   `const <x> = e`   → a locked field; DERIVED exactly when `e` reads a cell
//                       (§66.9), else locked.
//   `@x = e` in a fn  → Write(.Replace) through x's capability.
//   `reset(@x)`       → Write(.Replace, InitOf(x)) (L4 / D15).
//   `if=` on an element → a one-arm View.Cond around it (L5).
//   `c ? a : b`       → a Match over a bool (L7).
//   whitespace-only text containing a newline is dropped (L13).
// A legacy shape with NO Core mapping yet is reported in `why` (the case is
// `not-yet`); the shim never invents a mapping. Components → declarations and
// `<engine>` → `single` declarations (§66.15 / §66.13.3) are not mapped yet:
// both need Core declarations with renders the printer already supports, but
// the mapping itself is M3/M4 work — they report `not-yet` today.
//
// THE "NEVER GUESS" DISCIPLINE, MECHANIZED. impl#1 decorates its nodes with
// many optional fields. For every node kind the shim maps, every key is either
// READ (and every value it can hold is mapped or reported) or REDUNDANT for a
// stated reason (identity / text twin / syntax / summary — see `unmapped`); any
// OTHER key carrying a value (not absent / null / false / empty) makes the case
// `not-yet` ("unmapped key"). So a node the shim maps is never silently stripped
// of a fact impl#1 carried.
//
// THE INPUT ENCODING. impl#1's AST is untyped JS; scrml has no `any`. The JS
// glue (slice-m3/substitute.js) encodes it SCHEMA-FREE into `IVal` below: every
// own key of every object, by key name, with no knowledge of any node kind. All
// interpretation happens here. See `mkNode` / `ivStr` … (the glue's only API).
//
// RULE 7 (no source-text scanning post-parse). The shim reads impl#1's
// STRUCTURED fields only: `initExpr`, `exprNode`, `condExpr`, `argExprNodes`,
// never the CONTENT of the parallel raw-text fields (`init`, `raw`, `expr`,
// `condition`, a call-ref's `args`). One such field is read for its LENGTH
// only: a call-ref's `args` count is compared with `argExprNodes` to detect
// arguments impl#1 carried only as text (never parsed). A shape
// whose structure impl#1 carries only as text is `not-yet`. PARSE_REENTRY
// sites in this module: NONE (see progress.md). Two reads of identifier
// SPELLINGS are not re-parses: the `@` sigil on impl#1's `ident.name` (impl#1's
// contract: "for reactive vars, includes `@`") and the `on` prefix of an event
// attribute name (HTML's event-attribute naming).
//
// Every `match` over an enum is total with no default arm (dpa-051 §3.4).
// Matches over impl#1's `kind` STRINGS keep an `else` arm — an open domain,
// and exactly where an unknown kind becomes `not-yet`.
//
// impl#1 workarounds: F11 (named payload binding), F15 (no helper fn shares a
// name with a payload field in this file), F17 (no object literal as a match
// arm body — constructor fns instead).
// =============================================================================
${
    import { Sym, Type, SeqAt, LengthGrant, SeqGrants, FieldRef, InstRef, Place, Literal, PrimOp,
             Pattern, Expr, MatchArm, EditKind, Check, Stmt, Block, Attr, CondArm, View, FieldMode,
             FieldRole, GrantSet, Field, DeclKind, Decl, Param, Fn, CoreProgram,
             mkSym, block, noGrants, fref } from "./core.scrml"
    import { Node, allNodes } from "./walk.scrml"
    import { kindOf } from "./measure.scrml"

    // =========================================================================
    // The schema-free encoding of impl#1's AST (built by the JS glue).
    // =========================================================================
    export type IVal:enum = {
        VStr(s: string),
        VNum(n: number),
        VBool(b: boolean),
        VNull,
        VNode(obj: INode),
        VList(elems: IVal[]),
    }
    export type IField:struct = { key: string, val: IVal }
    export type INode:struct = { entries: IField[] }
    export type IFile:struct = { path: string, ast: INode }

    // The glue's constructors (so the JS side never depends on how impl#1
    // encodes a scrml enum value).
    export fn ivStr(s: string) -> IVal { return IVal.VStr(s) }
    export fn ivNum(n: number) -> IVal { return IVal.VNum(n) }
    export fn ivBool(b: boolean) -> IVal { return IVal.VBool(b) }
    export fn ivNull() -> IVal { return IVal.VNull }
    export fn ivNode(o: INode) -> IVal { return IVal.VNode(o) }
    export fn ivList(xs: IVal[]) -> IVal { return IVal.VList(xs) }
    export fn ivEntry(k: string, v: IVal) -> IField { return { key: k, val: v } }
    export fn mkNode(es: IField[]) -> INode { return { entries: es } }
    export fn mkFile(p: string, a: INode) -> IFile { return { path: p, ast: a } }

    // ---- reading an encoded node ----
    // (Exported for the stylesheet shim, css-ingest.scrml (s440) — one reader
    // set over the one encoding; behaviour unchanged.)
    export fn getVal(n: INode, k: string) -> IVal {
        for (const e of n.entries) {
            if (e.key == k) return e.val
        }
        return IVal.VNull
    }

    export fn valStr(v: IVal) -> string | not {
        return match v {
            .VStr(s: s) :> s
            .VNum(n: x) :> not
            .VBool(b: x) :> not
            .VNull :> not
            .VNode(obj: x) :> not
            .VList(elems: x) :> not
        }
    }

    export fn valNum(v: IVal) -> number | not {
        return match v {
            .VNum(n: n) :> n
            .VStr(s: x) :> not
            .VBool(b: x) :> not
            .VNull :> not
            .VNode(obj: x) :> not
            .VList(elems: x) :> not
        }
    }

    export fn valBool(v: IVal) -> boolean {
        return match v {
            .VBool(b: b) :> b
            .VStr(s: x) :> false
            .VNum(n: x) :> false
            .VNull :> false
            .VNode(obj: x) :> false
            .VList(elems: x) :> false
        }
    }

    export fn valNode(v: IVal) -> INode | not {
        return match v {
            .VNode(obj: o) :> o
            .VStr(s: x) :> not
            .VNum(n: x) :> not
            .VBool(b: x) :> not
            .VNull :> not
            .VList(elems: x) :> not
        }
    }

    export fn valList(v: IVal) -> IVal[] {
        return match v {
            .VList(elems: xs) :> xs
            .VStr(s: x) :> []
            .VNum(n: x) :> []
            .VBool(b: x) :> []
            .VNull :> []
            .VNode(obj: x) :> []
        }
    }

    // Does a value carry anything (for the unmapped-key check)?
    export fn carries(v: IVal) -> boolean {
        return match v {
            .VStr(s: s) :> s.length > 0
            .VNum(n: x) :> true
            .VBool(b: b) :> b
            .VNull :> false
            .VNode(obj: x) :> true
            .VList(elems: xs) :> xs.length > 0
        }
    }

    export fn strAt(n: INode, k: string) -> string | not { return valStr(getVal(n, k)) }
    export fn numAt(n: INode, k: string) -> number | not { return valNum(getVal(n, k)) }
    export fn flagAt(n: INode, k: string) -> boolean { return valBool(getVal(n, k)) }
    export fn nodeAt(n: INode, k: string) -> INode | not { return valNode(getVal(n, k)) }
    export fn listAt(n: INode, k: string) -> IVal[] { return valList(getVal(n, k)) }

    export fn nodesIn(vs: IVal[]) -> INode[] {
        let out: INode[] = []
        for (const v of vs) {
            const o: INode | not = valNode(v)
            if (o is some) out = out.concat([o])
        }
        return out
    }

    export fn nodesAt(n: INode, k: string) -> INode[] { return nodesIn(listAt(n, k)) }

    export fn kindAt(n: INode) -> string {
        const k: string | not = strAt(n, "kind")
        if (k is not) return "<no kind>"
        return k
    }

    export fn hasStr(xs: string[], x: string) -> boolean {
        for (const y of xs) {
            if (y == x) return true
        }
        return false
    }

    // The keys of `n` that carry a value but are neither `read` nor
    // `redundant` — the mechanized "never guess": each becomes a `not-yet`
    // reason. EVERY key a mapping lists is in one of two classes, and there is
    // no third ("known but ignored"):
    //   read      — the mapping reads the key and acts on every value it can
    //               hold (a value it does not map is itself a not-yet);
    //   redundant — the key carries no fact the read keys lack, for a reason
    //               stated at the call site, one of:
    //                 identity  `id` (a node id; used only to mint local Syms);
    //                 text twin impl#1's source-TEXT spelling of a structured
    //                           key the shim reads (`init`↔`initExpr`,
    //                           `expr`↔`exprNode`, `raw`/`refs`/`name`↔the
    //                           attr value's `exprNode`, `condition`↔`condExpr`,
    //                           `args`↔`argExprNodes` — counts cross-checked);
    //                 syntax    how the source was spelled, no meaning
    //                           (`selfClosing`, `closerForm`,
    //                           `openerHadSpaceAfterLt`);
    //                 summary   a file-level flag summarizing nodes the shim
    //                           maps one by one (`hasResetExpr`, …).
    export fn unmapped(n: INode, what: string, read: string[], redundant: string[]) -> string[] {
        let out: string[] = []
        for (const e of n.entries) {
            if (!hasStr(read, e.key) && !hasStr(redundant, e.key)) {
                if (carries(e.val)) out = out.concat([what + " carries unmapped key `" + e.key + "`"])
            }
        }
        return out
    }

    // =========================================================================
    // The ingest context. Syms: the program is 0; field i is 1+i; field i's
    // write capability is 1+nF+i; fn j is 1+2nF+j; parameters follow; a local
    // declared by impl#1 node `id` is `localBase + id`. Every id is issued once,
    // to one declaration site (core.scrml, THE BINDER'S OBLIGATION).
    // =========================================================================
    type FieldInfo:struct = { name: string, idx: int, sym: Sym, wcap: Sym | not, ty: Type }
    type FnInfo:struct = { name: string, sym: Sym, arity: int }
    type LocalInfo:struct = { name: string, sym: Sym, ty: Type | not }
    type Cx:struct = {
        prog: Sym,
        fields: FieldInfo[],
        fnInfos: FnInfo[],
        locals: LocalInfo[],
        inst: InstRef,
        localBase: int,
    }

    // A lowered expression, its type when known, and the not-yet reasons.
    type LE:struct = { e: Expr, ty: Type | not, why: string[] }
    type LS:struct = { stmts: Stmt[], cx: Cx, why: string[] }
    type LV:struct = { views: View[], why: string[] }
    type LA:struct = { attrs: Attr[], test: Expr | not, why: string[] }

    fn placeholder() -> Expr { return Expr.Lit(Literal.Absent) }
    fn notYetE(why: string) -> LE { return { e: placeholder(), ty: not, why: [why] } }
    fn okE(e: Expr, ty: Type | not, why: string[]) -> LE { return { e: e, ty: ty, why: why } }

    fn withLocal(cx: Cx, l: LocalInfo) -> Cx {
        return {
            prog: cx.prog, fields: cx.fields, fnInfos: cx.fnInfos,
            locals: [l].concat(cx.locals), inst: cx.inst, localBase: cx.localBase,
        }
    }

    fn findField(cx: Cx, name: string) -> FieldInfo | not {
        for (const f of cx.fields) {
            if (f.name == name) return f
        }
        return not
    }

    fn findFnInfo(cx: Cx, name: string) -> FnInfo | not {
        for (const f of cx.fnInfos) {
            if (f.name == name) return f
        }
        return not
    }

    fn findLocal(cx: Cx, name: string) -> LocalInfo | not {
        for (const l of cx.locals) {
            if (l.name == name) return l
        }
        return not
    }

    // =========================================================================
    // Types (only what the shim must decide: `+` vs concat, `==` resolution).
    // A type's class, by one total match; "none" when the type is unknown.
    // =========================================================================
    fn tyClass(t: Type | not) -> string {
        if (t is not) return "none"
        return classOf(t)
    }

    fn classOf(t: Type) -> string {
        return match t {
            .Int :> "int"
            .Num :> "num"
            .Str :> "str"
            .Bool :> "bool"
            .Named(sym: x) :> "named"
            .Seq(elem: x) :> "seq"
            .Maybe(inner: x) :> "maybe"
        }
    }

    fn isStrTy(t: Type | not) -> boolean { return tyClass(t) == "str" }
    fn isIntTy(t: Type | not) -> boolean { return tyClass(t) == "int" }
    fn isNumericTy(t: Type | not) -> boolean { return isIntTy(t) || tyClass(t) == "num" }
    // A scalar compares by value with `===` (§45: `==` on scalars is EqPrim).
    fn isScalarTy(t: Type | not) -> boolean { return isNumericTy(t) || isStrTy(t) || tyClass(t) == "bool" }
    fn hasLength(t: Type | not) -> boolean { return isStrTy(t) || tyClass(t) == "seq" }

    fn sameTy(a: Type | not, b: Type | not) -> Type | not {
        if (a is not) return not
        if (b is not) return not
        if (a == b) return a
        return not
    }

    // =========================================================================
    // Expressions.
    // =========================================================================
    fn lowerExpr(cx: Cx, n: INode) -> LE {
        const k: string = kindAt(n)
        return match k {
            "ident" :> identExpr(cx, n)
            "lit" :> litExpr(n)
            "binary" :> binaryExpr(cx, n)
            "unary" :> unaryExpr(cx, n)
            "ternary" :> ternaryExpr(cx, n)
            "member" :> memberExpr(cx, n)
            "call" :> callExpr(cx, n)
            else :> notYetE("expr: " + k)
        }
    }

    fn lowerExprAt(cx: Cx, n: INode, key: string) -> LE {
        const c: INode | not = nodeAt(n, key)
        if (c is not) return notYetE("expr: missing structured `" + key + "`")
        return lowerExpr(cx, c)
    }

    // A read of program field `f` from the context's instance.
    fn fieldRead(cx: Cx, f: FieldInfo) -> Expr {
        return Expr.Read(Place.Cell(cx.prog, cx.inst, [fref(cx.prog, f.idx)]))
    }

    fn identExpr(cx: Cx, n: INode) -> LE {
        const why: string[] = unmapped(n, "ident", ["kind", "name"], [])
        const name: string | not = strAt(n, "name")
        if (name is not) return notYetE("expr: ident without a name")
        if (name.startsWith("@")) {
            const f: FieldInfo | not = findField(cx, name.slice(1))
            if (f is not) return notYetE("expr: `@` name that is not a program cell")
            return okE(fieldRead(cx, f), f.ty, why)
        }
        const l: LocalInfo | not = findLocal(cx, name)
        if (l is not) return notYetE("expr: free identifier (not a local or parameter)")
        return okE(Expr.Local(l.sym), l.ty, why)
    }

    fn litExpr(n: INode) -> LE {
        const why: string[] = unmapped(n, "lit", ["kind", "value", "litType", "hasInterpolation"], ["raw"])
        const lt: string | not = strAt(n, "litType")
        if (lt is not) return notYetE("expr: lit without litType")
        return match lt {
            "number" :> numLit(n, why)
            "string" :> strLit(n, why)
            "template" :> templateLit(n, why)
            "bool" :> okE(Expr.Lit(Literal.Bool(flagAt(n, "value"))), Type.Bool, why)
            "not" :> okE(Expr.Lit(Literal.Absent), not, why)
            else :> notYetE("expr: lit " + lt)
        }
    }

    fn numLit(n: INode, why: string[]) -> LE {
        const v: number | not = numAt(n, "value")
        if (v is not) return notYetE("expr: number lit without a value")
        if (v % 1 == 0) return okE(Expr.Lit(Literal.Int(v)), Type.Int, why)
        return okE(Expr.Lit(Literal.Num(v)), Type.Num, why)
    }

    fn strLit(n: INode, why: string[]) -> LE {
        const v: string | not = strAt(n, "value")
        if (v is not) return okE(Expr.Lit(Literal.Str("")), Type.Str, why)
        return okE(Expr.Lit(Literal.Str(v)), Type.Str, why)
    }

    fn templateLit(n: INode, why: string[]) -> LE {
        if (flagAt(n, "hasInterpolation")) return notYetE("expr: template literal with interpolation")
        return strLit(n, why)
    }

    fn binaryExpr(cx: Cx, n: INode) -> LE {
        const why0: string[] = unmapped(n, "binary", ["kind", "op", "left", "right"], [])
        const op: string | not = strAt(n, "op")
        if (op is not) return notYetE("expr: binary without op")
        const l: LE = lowerExprAt(cx, n, "left")
        // `x is not` / `x is some`: the right side is impl#1's synthesized pattern.
        if (op == "is-not") return prim1E(PrimOp.IsNot, l, Type.Bool, why0)
        if (op == "is-some") return prim1E(PrimOp.IsSome, l, Type.Bool, why0)
        if (op == "is-not-not") return prim1E(PrimOp.IsSome, l, Type.Bool, why0)
        const r: LE = lowerExprAt(cx, n, "right")
        const why: string[] = why0.concat(l.why).concat(r.why)
        return match op {
            "+" :> plusExpr(l, r, why)
            "-" :> arith(PrimOp.Sub, l, r, why)
            "*" :> arith(PrimOp.Mul, l, r, why)
            "/" :> prim2E(PrimOp.Div, l, r, numTy(l, r), why)
            "%" :> arith(PrimOp.Mod, l, r, why)
            "<" :> prim2E(PrimOp.Lt, l, r, Type.Bool, why)
            "<=" :> prim2E(PrimOp.Le, l, r, Type.Bool, why)
            ">" :> prim2E(PrimOp.Gt, l, r, Type.Bool, why)
            ">=" :> prim2E(PrimOp.Ge, l, r, Type.Bool, why)
            "&&" :> prim2E(PrimOp.And, l, r, Type.Bool, why)
            "||" :> prim2E(PrimOp.Or, l, r, Type.Bool, why)
            "==" :> eqExpr(PrimOp.EqPrim, l, r, why)
            "!=" :> eqExpr(PrimOp.NeqPrim, l, r, why)
            else :> notYetE("expr: binary " + op)
        }
    }

    fn prim1E(op: PrimOp, a: LE, ty: Type | not, why: string[]) -> LE {
        return okE(Expr.Prim(op, [a.e]), ty, why.concat(a.why))
    }

    fn prim2E(op: PrimOp, a: LE, b: LE, ty: Type | not, why: string[]) -> LE {
        return okE(Expr.Prim(op, [a.e, b.e]), ty, why)
    }

    fn numTy(a: LE, b: LE) -> Type | not {
        if (isNumericTy(a.ty) && isNumericTy(b.ty)) return Type.Num
        return not
    }

    // Integer arithmetic stays `int`; anything else numeric is `number`.
    fn arith(op: PrimOp, a: LE, b: LE, why: string[]) -> LE {
        if (isIntTy(a.ty) && isIntTy(b.ty)) return prim2E(op, a, b, Type.Int, why)
        return prim2E(op, a, b, numTy(a, b), why)
    }

    // `+` is concatenation when either side is a string, addition when both
    // are numbers; with an operand of unknown type the shim cannot resolve it.
    fn plusExpr(a: LE, b: LE, why: string[]) -> LE {
        if (isStrTy(a.ty) || isStrTy(b.ty)) return prim2E(PrimOp.Concat, a, b, Type.Str, why)
        if (isNumericTy(a.ty) && isNumericTy(b.ty)) return arith(PrimOp.Add, a, b, why)
        return notYetE("expr: `+` over an operand of unknown type")
    }

    // §45: `==` on scalars is EqPrim. The shim resolves only scalar equality.
    fn eqExpr(op: PrimOp, a: LE, b: LE, why: string[]) -> LE {
        if (isScalarTy(a.ty) || isScalarTy(b.ty)) return prim2E(op, a, b, Type.Bool, why)
        return notYetE("expr: `==` over non-scalar or untyped operands")
    }

    fn unaryExpr(cx: Cx, n: INode) -> LE {
        const why: string[] = unmapped(n, "unary", ["kind", "op", "argument", "prefix"], [])
        const op: string | not = strAt(n, "op")
        if (op is not) return notYetE("expr: unary without op")
        if (!flagAt(n, "prefix")) return notYetE("expr: postfix " + op)
        const a: LE = lowerExprAt(cx, n, "argument")
        return match op {
            "!" :> prim1E(PrimOp.Not, a, Type.Bool, why)
            "-" :> prim1E(PrimOp.Neg, a, a.ty, why)
            else :> notYetE("expr: unary " + op)
        }
    }

    // L7: `c ? a : b` → a Match over a bool with `true` / `false` arms.
    fn ternaryExpr(cx: Cx, n: INode) -> LE {
        const why: string[] = unmapped(n, "ternary", ["kind", "condition", "consequent", "alternate"], [])
        const c: LE = lowerExprAt(cx, n, "condition")
        const a: LE = lowerExprAt(cx, n, "consequent")
        const b: LE = lowerExprAt(cx, n, "alternate")
        const arms: MatchArm[] = [boolArm(true, a.e), boolArm(false, b.e)]
        return okE(Expr.Match(c.e, arms), sameTy(a.ty, b.ty), why.concat(c.why).concat(a.why).concat(b.why))
    }

    fn boolArm(v: boolean, body: Expr) -> MatchArm {
        return { pat: Pattern.PLit(Literal.Bool(v)), body: body }
    }

    fn memberExpr(cx: Cx, n: INode) -> LE {
        const why: string[] = unmapped(n, "member", ["kind", "object", "property", "optional"], [])
        if (flagAt(n, "optional")) return notYetE("expr: optional member access `?.`")
        const prop: string | not = strAt(n, "property")
        const o: LE = lowerExprAt(cx, n, "object")
        if (prop == "length") {
            if (hasLength(o.ty)) return okE(Expr.Prim(PrimOp.Length, [o.e]), Type.Int, why.concat(o.why))
        }
        return notYetE("expr: member access (other than `.length` of a string or sequence)")
    }

    fn callExpr(cx: Cx, n: INode) -> LE {
        const why0: string[] = unmapped(n, "call", ["kind", "callee", "args", "optional"], [])
        if (flagAt(n, "optional")) return notYetE("expr: optional call `?.()`")
        const callee: INode | not = nodeAt(n, "callee")
        if (callee is not) return notYetE("expr: call without callee")
        if (kindAt(callee) != "ident") return notYetE("expr: call of a non-identifier (method / builtin)")
        const name: string | not = strAt(callee, "name")
        if (name is not) return notYetE("expr: call without callee name")
        const f: FnInfo | not = findFnInfo(cx, name)
        if (f is not) return notYetE("expr: call of a function that is not a program function")
        const args: INode[] = nodesAt(n, "args")
        if (args.length != f.arity) return notYetE("expr: call arity differs from the declaration")
        let es: Expr[] = []
        let why: string[] = why0
        for (const a of args) {
            if (kindAt(a) == "spread") return notYetE("expr: spread argument")
            const x: LE = lowerExpr(cx, a)
            es = es.concat([x.e])
            why = why.concat(x.why)
        }
        return okE(Expr.Call(f.sym, es), not, why)
    }

    // =========================================================================
    // Statements (function bodies and handler bodies).
    // =========================================================================
    fn lowerStmts(cx: Cx, ns: INode[]) -> LS {
        let out: Stmt[] = []
        let why: string[] = []
        let c: Cx = cx
        for (const n of ns) {
            const r: LS = lowerStmt(c, n)
            out = out.concat(r.stmts)
            why = why.concat(r.why)
            c = r.cx
        }
        return { stmts: out, cx: c, why: why }
    }

    fn stmtsOf(cx: Cx, ss: Stmt[], why: string[]) -> LS { return { stmts: ss, cx: cx, why: why } }
    fn notYetS(cx: Cx, why: string) -> LS { return { stmts: [], cx: cx, why: [why] } }

    fn lowerStmt(cx: Cx, n: INode) -> LS {
        const k: string = kindAt(n)
        return match k {
            "state-decl" :> cellWriteStmt(cx, n)
            "bare-expr" :> bareExprStmt(cx, n)
            "let-decl" :> localDecl(cx, n, true)
            "const-decl" :> localDecl(cx, n, false)
            "if-stmt" :> ifStmt(cx, n)
            "return-stmt" :> returnStmt(cx, n)
            "comment" :> stmtsOf(cx, [], [])
            else :> notYetS(cx, "stmt: " + k)
        }
    }

    // `@x = e` in a body: impl#1 carries it as a `state-decl` marked
    // `_isReactiveAssign`. A write through x's capability (.Replace).
    fn cellWriteStmt(cx: Cx, n: INode) -> LS {
        if (!flagAt(n, "_isReactiveAssign")) return notYetS(cx, "stmt: cell declaration inside a body")
        let why: string[] = unmapped(n, "cell write", ["kind", "name", "initExpr", "shape",
            "structuralForm", "isConst", "_isReactiveAssign", "__enclosingFnCanFail"], ["id", "init"])
        if (strAt(n, "shape") != "plain") why = why.concat(["stmt: cell write of a non-plain shape"])
        if (flagAt(n, "structuralForm")) why = why.concat(["stmt: `<x> = v` form in statement position"])
        if (flagAt(n, "isConst")) why = why.concat(["stmt: `const` cell write"])
        if (flagAt(n, "__enclosingFnCanFail")) why = why.concat(["stmt: cell write inside a failable function"])
        const name: string | not = strAt(n, "name")
        if (name is not) return notYetS(cx, "stmt: cell write without a name")
        const f: FieldInfo | not = findField(cx, name)
        if (f is not) return notYetS(cx, "stmt: write to a name that is not a program cell")
        const v: LE = lowerExprAt(cx, n, "initExpr")
        return writeOf(cx, f, v.e, why.concat(v.why))
    }

    fn writeOf(cx: Cx, f: FieldInfo, v: Expr, why: string[]) -> LS {
        const cap: Sym | not = f.wcap
        if (cap is not) return notYetS(cx, "stmt: write to a locked (const) cell")
        return stmtsOf(cx, [Stmt.Write(cap, cx.inst, EditKind.Replace, v, Check.Static)], why)
    }

    fn bareExprStmt(cx: Cx, n: INode) -> LS {
        const why: string[] = unmapped(n, "bare-expr", ["kind", "exprNode"], ["id", "expr"])
        const e: INode | not = nodeAt(n, "exprNode")
        if (e is not) return notYetS(cx, "stmt: bare-expr without a structured exprNode")
        const r: LS = exprStmt(cx, e)
        return stmtsOf(r.cx, r.stmts, why.concat(r.why))
    }

    // An expression in statement position: a call, an assignment, a reset.
    fn exprStmt(cx: Cx, e: INode) -> LS {
        const k: string = kindAt(e)
        return match k {
            "call" :> evalStmt(cx, e)
            "assign" :> assignStmt(cx, e)
            "reset-expr" :> resetStmt(cx, e)
            else :> notYetS(cx, "stmt: expression statement " + k)
        }
    }

    fn evalStmt(cx: Cx, e: INode) -> LS {
        const x: LE = lowerExpr(cx, e)
        return stmtsOf(cx, [Stmt.Eval(x.e)], x.why)
    }

    // `x = v` / `x += v` / `x -= v` on a local or a program cell.
    fn assignStmt(cx: Cx, e: INode) -> LS {
        const why0: string[] = unmapped(e, "assign", ["kind", "op", "target", "value"], [])
        const op: string | not = strAt(e, "op")
        const t: INode | not = nodeAt(e, "target")
        if (op is not) return notYetS(cx, "stmt: assign without op")
        if (t is not) return notYetS(cx, "stmt: assign without target")
        if (kindAt(t) != "ident") return notYetS(cx, "stmt: assignment to a member / index path")
        const name: string | not = strAt(t, "name")
        if (name is not) return notYetS(cx, "stmt: assign target without a name")
        const cur: LE = identExpr(cx, t)
        const v: LE = lowerExprAt(cx, e, "value")
        const next: LE = compound(op, cur, v)
        const why: string[] = why0.concat(cur.why).concat(next.why)
        if (name.startsWith("@")) {
            const f: FieldInfo | not = findField(cx, name.slice(1))
            if (f is not) return notYetS(cx, "stmt: write to a name that is not a program cell")
            return writeOf(cx, f, next.e, why)
        }
        const l: LocalInfo | not = findLocal(cx, name)
        if (l is not) return notYetS(cx, "stmt: assignment to a free identifier")
        return stmtsOf(cx, [Stmt.Assign(l.sym, next.e)], why)
    }

    fn compound(op: string, cur: LE, v: LE) -> LE {
        return match op {
            "=" :> v
            "+=" :> plusExpr(cur, v, v.why)
            "-=" :> arith(PrimOp.Sub, cur, v, v.why)
            "*=" :> arith(PrimOp.Mul, cur, v, v.why)
            else :> notYetE("stmt: compound assignment " + op)
        }
    }

    // L4 / D15: `reset(@x)` writes x's construction initializer again.
    fn resetStmt(cx: Cx, e: INode) -> LS {
        const why: string[] = unmapped(e, "reset", ["kind", "target"], [])
        const t: INode | not = nodeAt(e, "target")
        if (t is not) return notYetS(cx, "stmt: reset without a target")
        const name: string | not = strAt(t, "name")
        if (kindAt(t) != "ident") return notYetS(cx, "stmt: reset of a non-cell expression")
        if (name is not) return notYetS(cx, "stmt: reset target without a name")
        if (!name.startsWith("@")) return notYetS(cx, "stmt: reset of a non-cell expression")
        const f: FieldInfo | not = findField(cx, name.slice(1))
        if (f is not) return notYetS(cx, "stmt: reset of a name that is not a program cell")
        return writeOf(cx, f, Expr.InitOf(cx.prog, cx.inst, f.idx), why)
    }

    fn localDecl(cx: Cx, n: INode, mutable: boolean) -> LS {
        const why0: string[] = unmapped(n, "local declaration", ["kind", "id", "name", "initExpr"], ["init"])
        const name: string | not = strAt(n, "name")
        if (name is not) return notYetS(cx, "stmt: destructuring declaration")
        const id: number | not = numAt(n, "id")
        if (id is not) return notYetS(cx, "stmt: declaration without a node id")
        const v: LE = lowerExprAt(cx, n, "initExpr")
        const sym: Sym = mkSym(cx.localBase + id, name)
        const why: string[] = why0.concat(v.why)
        return stmtsOf(withLocal(cx, { name: name, sym: sym, ty: v.ty }), [Stmt.Let(sym, v.e)], why)
    }

    fn ifStmt(cx: Cx, n: INode) -> LS {
        const why0: string[] = unmapped(n, "if-stmt", ["kind", "condExpr", "consequent", "alternate"], ["id", "condition"])
        const c: LE = lowerExprAt(cx, n, "condExpr")
        const t: LS = lowerStmts(cx, nodesAt(n, "consequent"))
        const alt: IVal = getVal(n, "alternate")
        const why: string[] = why0.concat(c.why).concat(t.why)
        if (!carries(alt)) return stmtsOf(cx, [Stmt.If(c.e, block(t.stmts), not)], why)
        const e: LS = lowerStmts(cx, nodesIn(valList(alt)))
        return stmtsOf(cx, [Stmt.If(c.e, block(t.stmts), block(e.stmts))], why.concat(e.why))
    }

    fn returnStmt(cx: Cx, n: INode) -> LS {
        const why0: string[] = unmapped(n, "return-stmt", ["kind", "exprNode"], ["id", "expr"])
        const e: INode | not = nodeAt(n, "exprNode")
        if (e is not) return stmtsOf(cx, [Stmt.Return(placeholder())], why0)
        const x: LE = lowerExpr(cx, e)
        return stmtsOf(cx, [Stmt.Return(x.e)], why0.concat(x.why))
    }

    // =========================================================================
    // Markup → views.
    // =========================================================================
    fn lowerViews(cx: Cx, ns: INode[]) -> LV {
        let out: View[] = []
        let why: string[] = []
        for (const n of ns) {
            const r: LV = lowerView(cx, n)
            out = out.concat(r.views)
            why = why.concat(r.why)
        }
        return { views: out, why: why }
    }

    fn viewsOf(vs: View[], why: string[]) -> LV { return { views: vs, why: why } }
    fn notYetV(why: string) -> LV { return { views: [], why: [why] } }

    fn lowerView(cx: Cx, n: INode) -> LV {
        const k: string = kindAt(n)
        return match k {
            "text" :> textNode(n)
            "comment" :> viewsOf([], [])
            "logic" :> interpolation(cx, n)
            "markup" :> element(cx, n)
            else :> notYetV("markup: " + k)
        }
    }

    // L13: whitespace-only text containing a newline is dropped; other text is
    // kept verbatim.
    fn textNode(n: INode) -> LV {
        const v: string | not = strAt(n, "value")
        if (v is not) return viewsOf([], [])
        if (v.trim() == "" && v.includes("\n")) return viewsOf([], [])
        return viewsOf([View.Text(v)], [])
    }

    // `${ e }` in markup: every statement must be an expression (a Dyn each).
    fn interpolation(cx: Cx, n: INode) -> LV {
        let why: string[] = unmapped(n, "interpolation", ["kind", "body"], ["id"])
        let out: View[] = []
        for (const s of nodesAt(n, "body")) {
            if (kindAt(s) != "bare-expr") return notYetV("markup: `${}` block containing " + kindAt(s))
            why = why.concat(unmapped(s, "bare-expr", ["kind", "exprNode"], ["id", "expr"]))
            const x: LE = lowerExprAt(cx, s, "exprNode")
            out = out.concat([View.Dyn(x.e)])
            why = why.concat(x.why)
        }
        return viewsOf(out, why)
    }

    fn element(cx: Cx, n: INode) -> LV {
        const tag: string | not = strAt(n, "tag")
        if (tag is not) return notYetV("markup: element without a tag")
        const rk: string | not = strAt(n, "resolvedKind")
        if (flagAt(n, "isComponent")) return notYetV("markup: component use (components → declarations, §66.15)")
        // An element with no name resolution was synthesized AFTER NR (impl#1's component
        // expansion, or a meta emit). Mapping it would grade impl#1's expansion, not a §66
        // declaration (components → declarations, §66.15): not-yet.
        if (rk is not) return notYetV("markup: element synthesized after name resolution (component expansion / meta emit)")
        if (rk != "html-builtin") return notYetV("markup: <" + tag + "> (" + rk + ")")
        let why0: string[] = unmapped(n, "element", ["kind", "tag", "attrs", "children", "isComponent",
            "resolvedKind", "resolvedCategory"], ["id", "selfClosing", "closerForm", "openerHadSpaceAfterLt"])
        if (strAt(n, "resolvedCategory") != "html") why0 = why0.concat(["markup: html-builtin element of a non-html category"])
        const a: LA = lowerAttrs(cx, nodesAt(n, "attrs"))
        const kids: LV = lowerViews(cx, nodesAt(n, "children"))
        const el: View = View.El(tag, a.attrs, kids.views)
        const why: string[] = why0.concat(a.why).concat(kids.why)
        const test: Expr | not = a.test
        if (test is not) return viewsOf([el], why)
        // L5: `if=` on an element → a one-arm Cond around it.
        return viewsOf([View.Cond([condArm(test, [el])])], why)
    }

    fn condArm(test: Expr, body: View[]) -> CondArm { return { test: test, body: body } }

    fn kindOrNone(k: string | not) -> string {
        if (k is not) return "unresolved"
        return k
    }

    // Attribute names with a structural meaning the shim does not map yet.
    fn reservedAttr(name: string) -> boolean {
        return match name {
            "else" :> true
            "else-if" :> true
            "key" :> true
            "ref" :> true
            "slot" :> true
            "as" :> true
            "each" :> true
            "bind" :> true
            else :> false
        }
    }

    fn lowerAttrs(cx: Cx, attrNodes: INode[]) -> LA {
        let out: Attr[] = []
        let why: string[] = []
        let test: Expr | not = not
        for (const a of attrNodes) {
            const name: string | not = strAt(a, "name")
            const v: INode | not = nodeAt(a, "value")
            if (name is not) return { attrs: [], test: not, why: ["attr: without a name"] }
            if (v is not) return { attrs: [], test: not, why: ["attr: without a value"] }
            why = why.concat(unmapped(a, "attr", ["name", "value"], []))
            if (name.includes(":")) {
                why = why.concat(["attr: `" + name.split(":")[0] + ":` directive"])
            } else if (reservedAttr(name)) {
                why = why.concat(["attr: `" + name + "=`"])
            } else if (name == "if") {
                const t: LE = attrExpr(cx, v)
                test = t.e
                why = why.concat(t.why)
            } else if (name.startsWith("on")) {
                const h: LS = handler(cx, v)
                out = out.concat([Attr.On(name.slice(2), block(h.stmts))])
                why = why.concat(h.why)
            } else {
                const r: LA = plainAttr(cx, name, v)
                out = out.concat(r.attrs)
                why = why.concat(r.why)
            }
        }
        return { attrs: out, test: test, why: why }
    }

    fn oneAttr(a: Attr, why: string[]) -> LA { return { attrs: [a], test: not, why: why } }
    fn notYetA(why: string) -> LA { return { attrs: [], test: not, why: [why] } }

    fn plainAttr(cx: Cx, name: string, v: INode) -> LA {
        const k: string = kindAt(v)
        return match k {
            "string-literal" :> staticAttrOf(name, v)
            "absent" :> oneAttr(Attr.Static(name, ""), [])
            "variable-ref" :> boundAttr(cx, name, v)
            "expr" :> boundAttr(cx, name, v)
            else :> notYetA("attr: value kind " + k)
        }
    }

    fn staticAttrOf(name: string, v: INode) -> LA {
        const s: string | not = strAt(v, "value")
        if (s is not) return oneAttr(Attr.Static(name, ""), [])
        return oneAttr(Attr.Static(name, s), [])
    }

    fn boundAttr(cx: Cx, name: string, v: INode) -> LA {
        const x: LE = attrExpr(cx, v)
        return oneAttr(Attr.Bound(name, x.e), x.why)
    }

    // The structured expression of a `variable-ref` / `expr` attribute value.
    fn attrExpr(cx: Cx, v: INode) -> LE {
        const why: string[] = unmapped(v, "attr value", ["kind", "exprNode"], ["name", "raw", "refs"])
        const e: LE = lowerExprAt(cx, v, "exprNode")
        return okE(e.e, e.ty, why.concat(e.why))
    }

    // An event attribute's value → the handler's statements.
    fn handler(cx: Cx, v: INode) -> LS {
        const k: string = kindAt(v)
        return match k {
            "call-ref" :> callRefHandler(cx, v)
            "expr" :> exprHandler(cx, v)
            else :> notYetS(cx, "handler: " + k)
        }
    }

    // `onclick=f(a, b)`: carried as a name + structured argument nodes.
    fn callRefHandler(cx: Cx, v: INode) -> LS {
        const why0: string[] = unmapped(v, "call-ref handler", ["kind", "name", "argExprNodes"], ["args"])
        const name: string | not = strAt(v, "name")
        if (name is not) return notYetS(cx, "handler: call-ref without a name")
        const f: FnInfo | not = findFnInfo(cx, name)
        if (f is not) return notYetS(cx, "handler: calls a function that is not a program function")
        const argNodes: INode[] = nodesAt(v, "argExprNodes")
        if (argNodes.length != listAt(v, "args").length) return notYetS(cx, "handler: call-ref arguments carried only as text")
        if (argNodes.length != f.arity) return notYetS(cx, "handler: call arity differs from the declaration")
        let es: Expr[] = []
        let why: string[] = why0
        for (const a of argNodes) {
            const x: LE = lowerExpr(cx, a)
            es = es.concat([x.e])
            why = why.concat(x.why)
        }
        return stmtsOf(cx, [Stmt.Eval(Expr.Call(f.sym, es))], why)
    }

    fn exprHandler(cx: Cx, v: INode) -> LS {
        const why: string[] = unmapped(v, "expr handler", ["kind", "exprNode"], ["raw", "refs"])
        const e: INode | not = nodeAt(v, "exprNode")
        if (e is not) return notYetS(cx, "handler: carried only as text")
        const r: LS = exprStmt(cx, e)
        return stmtsOf(cx, r.stmts, why.concat(r.why))
    }

    // =========================================================================
    // The file: declarations (fields, functions) and the program's renders.
    // =========================================================================
    // A top-level item, before lowering: a cell, a function, or markup.
    type CellDecl:struct = { n: INode, name: string, isConst: boolean }
    type FnDecl:struct = { n: INode, name: string }
    type Items:struct = { cells: CellDecl[], fnDecls: FnDecl[], markup: INode[], why: string[] }

    fn noItems() -> Items { return { cells: [], fnDecls: [], markup: [], why: [] } }

    fn joinItems(a: Items, b: Items) -> Items {
        return {
            cells: a.cells.concat(b.cells), fnDecls: a.fnDecls.concat(b.fnDecls),
            markup: a.markup.concat(b.markup), why: a.why.concat(b.why),
        }
    }

    fn itemsWhy(why: string) -> Items { return { cells: [], fnDecls: [], markup: [], why: [why] } }
    fn itemsMarkup(n: INode) -> Items { return { cells: [], fnDecls: [], markup: [n], why: [] } }

    // The file's top level: `${}` blocks declare; `<program>` wraps; markup renders.
    fn collect(ns: INode[]) -> Items {
        let out: Items = noItems()
        for (const n of ns) { out = joinItems(out, collectOne(n)) }
        return out
    }

    fn collectOne(n: INode) -> Items {
        const k: string = kindAt(n)
        if (k == "logic") return collectLogic(n)
        if (k == "markup") {
            if (strAt(n, "tag") == "program") return collectProgram(n)
        }
        return itemsMarkup(n)
    }

    fn collectProgram(n: INode) -> Items {
        let why: string[] = []
        for (const a of nodesAt(n, "attrs")) {
            const an: string | not = strAt(a, "name")
            why = why.concat(["program: `<program " + kindOrNone(an) + "=…>`"])
        }
        const inner: Items = collect(nodesAt(n, "children"))
        return { cells: inner.cells, fnDecls: inner.fnDecls, markup: inner.markup, why: why.concat(inner.why) }
    }

    fn collectLogic(n: INode) -> Items {
        let out: Items = { cells: [], fnDecls: [], markup: [], why: unmapped(n, "top-level `${}`",
            ["kind", "body"], ["id", "_synthetic"]) }
        // `_synthetic` (syntax): the parser wrapped a `<program>` body's bare declarations in
        // this block — they are the program's declarations exactly as in an authored block.
        // The hoisted `imports` / `exports` / `typeDecls` / `components` lists are NOT listed:
        // non-empty, each is a not-yet.
        for (const s of nodesAt(n, "body")) { out = joinItems(out, collectDecl(s)) }
        return out
    }

    fn collectDecl(s: INode) -> Items {
        const k: string = kindAt(s)
        return match k {
            "state-decl" :> cellItem(s)
            "function-decl" :> fnItem(s)
            "comment" :> noItems()
            else :> itemsWhy("decl: " + k)
        }
    }

    fn cellItem(s: INode) -> Items {
        const name: string | not = strAt(s, "name")
        if (name is not) return itemsWhy("decl: cell without a name")
        if (!flagAt(s, "structuralForm")) return itemsWhy("decl: `@x = v` declaration form")
        let why: string[] = unmapped(s, "cell declaration", ["kind", "name", "initExpr",
            "structuralForm", "isConst", "shape", "typeAnnotation"], ["id", "init"])
        // `shape` must agree with the form: `plain` for `<x> = v`, `derived` for `const <x> = e`.
        const shape: string | not = strAt(s, "shape")
        if (flagAt(s, "isConst")) {
            if (shape != "derived") why = why.concat(["decl: `const` cell of shape " + kindOrNone(shape)])
        } else if (shape != "plain") {
            why = why.concat(["decl: cell of shape " + kindOrNone(shape)])
        }
        const cell: CellDecl = { n: s, name: name, isConst: flagAt(s, "isConst") }
        return { cells: [cell], fnDecls: [], markup: [], why: why }
    }

    fn fnItem(s: INode) -> Items {
        const name: string | not = strAt(s, "name")
        if (name is not) return itemsWhy("decl: function without a name")
        const why: string[] = unmapped(s, "function", ["kind", "name", "params", "body", "fnKind",
            "isServer", "isGenerator", "canFail", "isHandleEscapeHatch"], ["id"])
        let more: string[] = []
        const fk: string | not = strAt(s, "fnKind")
        if (fk != "fn" && fk != "function") more = more.concat(["decl: function of kind " + kindOrNone(fk)])
        if (flagAt(s, "isHandleEscapeHatch")) more = more.concat(["decl: `handle()` escape hatch"])
        if (flagAt(s, "isServer")) more = more.concat(["decl: server function"])
        if (flagAt(s, "isGenerator")) more = more.concat(["decl: generator function"])
        if (flagAt(s, "canFail")) more = more.concat(["decl: failable function (`!`)"])
        const f: FnDecl = { n: s, name: name }
        return { cells: [], fnDecls: [f], markup: [], why: why.concat(more) }
    }

    // ---- fields ----
    // §66.12.4: the transitional all-permissions grant of a legacy `<x> = v`.
    fn allGrant(ty: Type) -> GrantSet {
        return match ty {
            .Seq(elem: e) :> seqAllGrant()
            .Int :> replaceOnly()
            .Num :> replaceOnly()
            .Str :> replaceOnly()
            .Bool :> replaceOnly()
            .Named(sym: s) :> replaceOnly()
            .Maybe(inner: i) :> replaceOnly()
        }
    }

    fn replaceOnly() -> GrantSet { return { replace: true, edits: [] } }
    fn seqAllGrant() -> GrantSet {
        return { replace: true, edits: [EditKind.Append, EditKind.Prepend, EditKind.Anywhere, EditKind.PositionWrite] }
    }

    // Does a Core expression read a cell (so a `const` is DERIVED, §66.9)?
    fn readsCell(e: Expr) -> boolean {
        for (const n of allNodes(Node.NExpr(e))) {
            if (isCellPlace(n)) return true
        }
        return false
    }

    fn hasCall(e: Expr) -> boolean {
        for (const n of allNodes(Node.NExpr(e))) {
            if (isCallNode(n)) return true
        }
        return false
    }

    fn isCallNode(n: Node) -> boolean {
        return match n {
            .NExpr(e: e) :> isCallExpr(e)
            .NProgram(p: x) :> false
            .NDecl(d: x) :> false
            .NField(f: x) :> false
            .NFn(f: x) :> false
            .NServerFn(f: x) :> false
            .NBlock(b: x) :> false
            .NStmt(s: x) :> false
            .NPlace(pl: x) :> false
            .NInst(i: x) :> false
            .NPattern(pat: x) :> false
            .NEdit(k: x) :> false
            .NView(v: x) :> false
            .NAttr(a: x) :> false
        }
    }

    fn isCallExpr(e: Expr) -> boolean {
        return match e {
            .Call(callee: x) :> true
            .Lit(lit: x) :> false
            .Local(sym: x) :> false
            .Read(place: x) :> false
            .Prim(op: x) :> false
            .Match(scrut: x) :> false
            .ArrayOf(elems: x) :> false
            .StructOf(ty: x) :> false
            .Handle(inst: x) :> false
            .InitOf(decl: x) :> false
            .Host(call: x) :> false
            .Lambda(params: x) :> false
            .SeqCall(op: x) :> false
            .Validity(of: x) :> false
        }
    }

    fn isCellPlace(n: Node) -> boolean {
        return match n {
            .NPlace(pl: pl) :> isCell(pl)
            .NProgram(p: x) :> false
            .NDecl(d: x) :> false
            .NField(f: x) :> false
            .NFn(f: x) :> false
            .NServerFn(f: x) :> false
            .NBlock(b: x) :> false
            .NStmt(s: x) :> false
            .NExpr(e: x) :> false
            .NInst(i: x) :> false
            .NPattern(pat: x) :> false
            .NEdit(k: x) :> false
            .NView(v: x) :> false
            .NAttr(a: x) :> false
        }
    }

    fn isCell(pl: Place) -> boolean {
        return match pl {
            .Cell(decl: d) :> true
            .LocalPath(sym: s) :> false
        }
    }

    type Fields:struct = { infos: FieldInfo[], fields: Field[], why: string[] }

    // Fields in source order; a field's initializer sees the fields before it
    // (a forward reference is not-yet — the legacy form's order semantics are
    // not mapped).
    fn lowerFields(base: Cx, cells: CellDecl[]) -> Fields {
        let infos: FieldInfo[] = []
        let fields: Field[] = []
        let why: string[] = []
        const nF: int = cells.length
        let i = 0
        for (const c of cells) {
            const cx: Cx = {
                prog: base.prog, fields: infos, fnInfos: base.fnInfos, locals: [],
                inst: InstRef.Lexical(0), localBase: base.localBase,
            }
            const v: LE = lowerExprAt(cx, c.n, "initExpr")
            why = why.concat(v.why)
            const ann: string | not = strAt(c.n, "typeAnnotation")
            // `<x>: T = v` (§66.21 row 1): the annotation is the field's type.
            let ty: Type | not = v.ty
            if (ann is some) {
                ty = primTy(ann)
                if (ty is not) why = why.concat(["decl: a cell annotated with a non-primitive type"])
            }
            if (ty is not) {
                if (ann is not) why = why.concat(["decl: a cell whose type the shim cannot infer from its initializer"])
            } else {
                const sym: Sym = mkSym(1 + i, c.name)
                if (c.isConst) {
                    // §66.9: derived exactly when the initializer reads a cell. The shim
                    // cannot see through a call, so a `const` whose initializer calls a
                    // function is declined, not classified.
                    if (hasCall(v.e)) why = why.concat(["decl: `const` initializer calls a function (derived-ness not provable through the call, §66.9)"])
                    const mode: FieldMode = constMode(v.e)
                    infos = infos.concat([{ name: c.name, idx: i, sym: sym, wcap: not, ty: ty }])
                    fields = fields.concat([mkField(sym, ty, v.e, mode, noGrants(), not)])
                } else {
                    const cap: Sym = mkSym(1 + nF + i, c.name)
                    infos = infos.concat([{ name: c.name, idx: i, sym: sym, wcap: cap, ty: ty }])
                    fields = fields.concat([mkField(sym, ty, v.e, FieldMode.Let, allGrant(ty), cap)])
                }
            }
            i = i + 1
        }
        return { infos: infos, fields: fields, why: why }
    }

    fn constMode(init: Expr) -> FieldMode {
        if (readsCell(init)) return FieldMode.Derived
        return FieldMode.Locked
    }

    fn mkField(sym: Sym, ty: Type, init: Expr, mode: FieldMode, grants: GrantSet, cap: Sym | not) -> Field {
        return {
            sym: sym, ty: ty, init: init, mode: mode, role: FieldRole.Child, grants: grants,
            graph: not, exported: false, wcap: cap, vals: [], persist: not,
        }
    }

    // ---- functions ----
    type PInfo:struct = { params: Param[], locals: LocalInfo[], why: string[] }

    // A primitive type annotation. impl#1 carries annotations as their spelling;
    // only the four primitive names are mapped — an exact word match, not a parse.
    fn primTy(ann: string) -> Type | not {
        return match ann {
            "int" :> Type.Int
            "number" :> Type.Num
            "string" :> Type.Str
            "boolean" :> Type.Bool
            "bool" :> Type.Bool
            else :> not
        }
    }

    // D14: Core parameters are typed; an unannotated parameter is not-yet
    // rather than given an invented type.
    fn lowerParams(fnNode: INode, firstId: int) -> PInfo {
        let ps: Param[] = []
        let ls: LocalInfo[] = []
        let why: string[] = []
        let id: int = firstId
        for (const p of nodesAt(fnNode, "params")) {
            why = why.concat(unmapped(p, "parameter", ["name", "typeAnnotation"], []))
            const name: string | not = strAt(p, "name")
            const ann: string | not = strAt(p, "typeAnnotation")
            if (name is not) {
                why = why.concat(["decl: destructured parameter"])
            } else if (ann is not) {
                why = why.concat(["decl: unannotated parameter (Core parameters are typed, D14)"])
            } else {
                const ty: Type | not = primTy(ann)
                if (ty is not) {
                    why = why.concat(["decl: parameter of a non-primitive type"])
                } else {
                    const sym: Sym = mkSym(id, name)
                    ps = ps.concat([{ sym: sym, ty: ty }])
                    ls = ls.concat([{ name: name, sym: sym, ty: ty }])
                }
            }
            id = id + 1
        }
        return { params: ps, locals: ls, why: why }
    }

    // The program: one `single` declaration whose fields are the top-level
    // cells and whose renders is the page (R4 / L14).
    export type Ingested:struct = { core: CoreProgram, why: string[] }

    export fn ingest(files: IFile[]) -> Ingested {
        const prog: Sym = mkSym(0, "program")
        const empty: CoreProgram = { program: prog, decls: [], types: [], fns: [], server: [], dbs: [], reset: false, sqlError: not }   // the hybrid's stylesheet is css-ingest's (slice-m3)
        if (files.length != 1) return { core: empty, why: ["file: a multi-file program (imports)"] }
        const ast: INode = files[0].ast
        // `filePath` is identity (the path arrives as IFile.path); the `has*` flags and
        // `fileShape` summarize nodes mapped one by one; `precgTopLevelProgramSpan` is
        // identity (impl#1's PRECG records which <program> node it configured, by span — S445 F2). The hoisted lists (`imports`,
        // `exports`, `components`, `typeDecls`, `machineDecls`, `channelDecls`) and the
        // configs (`authConfig`, `middlewareConfig`, `mcpConfig`) are NOT listed: non-empty,
        // each is a not-yet.
        const fileWhy: string[] = unmapped(ast, "file", ["nodes"], ["filePath", "hasProgramRoot", "hasResetExpr",
            "hasEqualityExpr", "hasChunkedMarkupTag", "hasForStmt", "fileShape", "precgTopLevelProgramSpan"])
        const items: Items = collect(nodesAt(ast, "nodes"))

        // Pass 1: every declaration gets its Sym before any body is lowered.
        const nF: int = items.cells.length
        let fnInfos: FnInfo[] = []
        let j = 0
        for (const f of items.fnDecls) {
            fnInfos = fnInfos.concat([{ name: f.name, sym: mkSym(1 + 2 * nF + j, f.name), arity: nodesAt(f.n, "params").length }])
            j = j + 1
        }
        let paramCount = 0
        for (const f of items.fnDecls) { paramCount = paramCount + nodesAt(f.n, "params").length }
        const firstParam: int = 1 + 2 * nF + items.fnDecls.length
        const localBase: int = firstParam + paramCount
        const base: Cx = { prog: prog, fields: [], fnInfos: fnInfos, locals: [], inst: InstRef.Lexical(0), localBase: localBase }

        // Pass 2: fields (their initializers are in the program's own scope).
        const fs: Fields = lowerFields(base, items.cells)
        let why: string[] = fileWhy.concat(items.why).concat(fs.why)

        // Pass 3: functions (top-level functions reach cells through the
        // shared instance, L1).
        let fns: Fn[] = []
        let nextParam: int = firstParam
        j = 0
        for (const f of items.fnDecls) {
            const pi: PInfo = lowerParams(f.n, nextParam)
            nextParam = nextParam + nodesAt(f.n, "params").length
            const fcx: Cx = {
                prog: prog, fields: fs.infos, fnInfos: fnInfos, locals: pi.locals,
                inst: InstRef.Shared(prog), localBase: localBase,
            }
            const body: LS = lowerStmts(fcx, nodesAt(f.n, "body"))
            why = why.concat(pi.why).concat(body.why)
            fns = fns.concat([{ sym: fnInfos[j].sym, params: pi.params, body: block(body.stmts), pure: strAt(f.n, "fnKind") == "fn", err: not }])
            j = j + 1
        }

        // Pass 4: the renders (inside the program declaration, L2).
        const vcx: Cx = { prog: prog, fields: fs.infos, fnInfos: fnInfos, locals: [], inst: InstRef.Lexical(0), localBase: localBase }
        const vs: LV = lowerViews(vcx, items.markup)
        why = why.concat(vs.why)

        const decl: Decl = {
            sym: prog, kind: DeclKind.Program, single: true, fields: fs.fields,
            renders: vs.views, wiring: [], handles: [],
        }
        const core: CoreProgram = { program: prog, decls: [decl], types: [], fns: fns, server: [], dbs: [], reset: false, sqlError: not }   // the hybrid's stylesheet is css-ingest's (slice-m3)
        return { core: core, why: dedupeStr(why) }
    }

    fn dedupeStr(xs: string[]) -> string[] {
        let out: string[] = []
        for (const x of xs) {
            if (!hasStr(out, x)) out = out.concat([x])
        }
        return out
    }

    // =========================================================================
    // The FOOTPRINT (dpa-051 §8.2): the Core constructs a program uses, named
    // "Family.Variant" (measure.kindOf, the same names the size measure uses),
    // refined by operator and literal kind — derived by `match`, never listed.
    // =========================================================================
    export fn footprint(p: CoreProgram) -> string[] {
        let out: string[] = []
        for (const n of allNodes(Node.NProgram(p))) {
            const c: string = constructOf(n)
            if (!hasStr(out, c)) out = out.concat([c])
        }
        return out
    }

    fn constructOf(n: Node) -> string {
        return match n {
            .NExpr(e: e) :> exprConstruct(e)
            .NField(f: f) :> "Field." + modeName(f.mode)
            .NProgram(p: x) :> kindOf(n)
            .NDecl(d: x) :> kindOf(n)
            .NFn(f: x) :> kindOf(n)
            .NServerFn(f: x) :> kindOf(n)
            .NBlock(b: x) :> kindOf(n)
            .NStmt(s: x) :> kindOf(n)
            .NPlace(pl: x) :> kindOf(n)
            .NInst(i: x) :> kindOf(n)
            .NPattern(pat: x) :> kindOf(n)
            .NEdit(k: x) :> kindOf(n)
            .NView(v: x) :> kindOf(n)
            .NAttr(a: x) :> kindOf(n)
        }
    }

    fn exprConstruct(e: Expr) -> string {
        return match e {
            .Prim(op: op) :> "Expr.Prim." + opName(op)
            .Lit(lit: l) :> "Expr.Lit." + litName(l)
            .Local(sym: x) :> "Expr.Local"
            .Read(place: x) :> "Expr.Read"
            .Call(callee: x) :> "Expr.Call"
            .Match(scrut: x) :> "Expr.Match"
            .ArrayOf(elems: x) :> "Expr.ArrayOf"
            .StructOf(ty: x) :> "Expr.StructOf"
            .Handle(inst: x) :> "Expr.Handle"
            .InitOf(decl: x) :> "Expr.InitOf"
            .Host(call: x) :> "Expr.Host"
            .Lambda(params: x) :> "Expr.Lambda"
            .SeqCall(op: x) :> "Expr.SeqCall"
            .Validity(of: x) :> "Expr.Validity"
        }
    }

    fn modeName(m: FieldMode) -> string {
        return match m {
            .Locked :> "Locked"
            .Let :> "Let"
            .Derived :> "Derived"
            .Seeded :> "Seeded"
        }
    }

    fn litName(l: Literal) -> string {
        return match l {
            .Int(v: x) :> "Int"
            .Num(v: x) :> "Num"
            .Str(v: x) :> "Str"
            .Bool(v: x) :> "Bool"
            .Variant(enumSym: x) :> "Variant"
            .Absent :> "Absent"
        }
    }

    fn opName(op: PrimOp) -> string {
        return match op {
            .Add :> "Add"
            .Sub :> "Sub"
            .Mul :> "Mul"
            .Div :> "Div"
            .Mod :> "Mod"
            .Neg :> "Neg"
            .Not :> "Not"
            .And :> "And"
            .Or :> "Or"
            .Lt :> "Lt"
            .Le :> "Le"
            .Gt :> "Gt"
            .Ge :> "Ge"
            .EqPrim :> "EqPrim"
            .NeqPrim :> "NeqPrim"
            .EqStruct :> "EqStruct"
            .NeqStruct :> "NeqStruct"
            .IsSome :> "IsSome"
            .IsNot :> "IsNot"
            .Concat :> "Concat"
            .Length :> "Length"
        }
    }
}
