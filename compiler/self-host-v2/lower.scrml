// =============================================================================
// self-host-v2 / lower.scrml — TypedProgram → CoreProgram (bootstrap impl#2,
// slice M2). The fourth phase of the S233 re-cut, and the dpa-051 Fork-A
// claim: a THIN Core is producible by a real `lower` (R2, ruled S437).
//
// `lower` DECIDES NOTHING. Every name is already a Sym, every `@x` an InstRef,
// every write a classified WriteFact, every operator resolved (analyze.scrml,
// one tables record keyed by NodeId). What lower does is the DESUGAR — the L
// decisions recorded when M1's Core was built by hand (slice-m1/progress.md):
//   L4  reset(@x)          → Write(.Replace, x's initializer, re-evaluated)
//   L5  if= on an element / a use → a one-arm View.Cond around it
//   L7  c ? a : b          → Match over a bool with `true` / `false` arms
//   L9  <each> w/o key=    → key: not
//   L11 given c = @h :> {} → Let c = Handle(h); If(IsSome(c), {…})
//   L13 RETIRED (dpa-045 follow-up 4, RULED S442 — SPEC §4.18.5): every
//       free-text run is kept verbatim, whitespace-only runs (a newline +
//       indentation between two elements) included; comments are gone
//       already (the parser drops them, keeping the bytes around them)
//   L14 the program's markup is its renders; `type`s → CoreProgram.types
//   L15 one CoreProgram per LINKED program (files in link order)
//   L17 field order (analyze built it); L18 graph fields (analyze); L19 int
//   and compound opener literals → Lit / ArrayOf / StructOf
//   O58 (b) the spread `@x = { ...@x, f: v }` → one FieldAt Write per override
// L1/L2/L3/L6/L8/L10/L12/L16 are facts analyze computed; lower copies them.
//
// Every traversal is a total `match` over the AST enums with no default arm
// (dpa-051 §3.4). impl#1 workarounds: F4, F11, F16, F17 (an arm whose
// body is an object literal loses its bindings — constructors instead).
// =============================================================================
${
    import { Sym, Type, TypeDef, FieldRef, InstRef, Place, Literal, PrimOp, Pattern, Expr, MatchArm, SeqFn, BindKind,
             EditKind, Check, Stmt, Block, Attr, ConstructAttr, CondArm, View, EffectDep, FieldMode, FieldRole,
             GrantSet, TransitionGraph, Field, DeclKind, WiringAttr, Decl, Param, Fn, CoreProgram, Validator, SurfaceProp, ValidityOf, Persist,
             block, litStr } from "./core.scrml"
    import { ASpan, BinOp, UnOp, AExpr, AProp, AExprK, AStmt, ABlock, AStmtK, AEffect, AType, AParam, AFn,
             AAttrValue, AAttr, AElem, ANode, ANodeK, ADecl, AProgram, AItem, AItemK, FileAst, Diag,
             mkSpan } from "./ast.scrml"
    import { Node, allNodes } from "./walk.scrml"
    import { FieldInfo, DeclInfo, HandleInfo, TypeInfo, FnInfo, WriteFact, SpreadWrite, SnapField, AttrKind, HtmlAttrPair, ValInfo, GateInfo,
             NameFact, ValueFact, EffectFact, BindFact, ElemFact, StateArm, StateView, InlineView, SeqSnap, Tables, TypedProgram, ResetOnInfo, PersistInfo,
             nameFact, valueFact, effectFact, bindFact, elemFact, attrFact, declInfo, presenceTest } from "./analyze.scrml"

    // s451 — THE DIAGNOSTICS GATE. `core` is `not` whenever the analysis
    // reported an ERROR (an `E-` code — §34: severity is "carried by the `E-`
    // prefix per the §34 diagnostic-stream convention"; `W-` notes in `diags`
    // are non-fatal and do not close it). A Core is the only thing the printer
    // takes, so a compile with an error has NO artifact to print — by
    // construction, for every code, not a per-code refusal list. Before s451
    // `lower` returned a Core unconditionally and the printer emitted a
    // runnable program over a tree analysis had rejected
    // (g-bootstrap-defer-scope-001-and-runs-anyway: `defer` reported as
    // E-SCOPE-001, then run in place).
    export type Lowered:struct = { core: CoreProgram | not, diags: Diag[] }

    // Does the compile hold an error — an `E-` code from the analysis, or any
    // parse diagnostic (the parser reports only `E-PARSE-*`-family errors; a
    // file carries their spans in `errs`, the codes go to the driver)?
    export fn hasError(tp: TypedProgram) -> boolean {
        for (const d of tp.diags) { if (d.code.startsWith("E-")) return true }
        for (const f of tp.files) { if (f.errs.length > 0) return true }
        return false
    }

    // The lowering context: the tables, the file (for diagnostics), and — while
    // lowering a field initializer for `reset` (L4) — the instance being reset,
    // which is what `.Lexical(0)` inside an initializer means there.
    // `snap` — while lowering a spread's override values (RULED S440, strict
    // snapshot): a read of the spread target's place (`decl` / `inst` / `path`,
    // or a place under it) reads a snapshot local instead of the live cell —
    // the per-FIELD local of the field it reads (`fields`), or `whole` for a
    // read of the whole target value.
    type SnapB:struct = { decl: Sym, inst: InstRef, path: FieldRef[], whole: Sym, fields: SnapField[] }
    type LC:struct = { t: Tables, file: string, subst: InstRef | not, snap: SnapB | not }

    // Lowering is total over the facts analyze produced; a node with a missing
    // or mismatched fact means analyze reported an error, and lower emits a
    // visible placeholder rather than guess (the program is not runnable then).
    fn missing() -> Expr { return Expr.Lit(Literal.Absent) }

    fn instOf(c: LC, i: InstRef) -> InstRef {
        const s: InstRef | not = c.subst
        if (s is not) return i
        return match i {
            .Lexical(depth: d) :> lexicalOr(d, s, i)
            .Shared(decl: x) :> i
            .Alias(sym: x) :> i
            .Narrowed(sym: x) :> i
        }
    }

    fn lexicalOr(d: int, s: InstRef, i: InstRef) -> InstRef {
        if (d == 0) return s
        return i
    }

    // A read of a declaration field / whole instance: the live cell — or, while
    // lowering a spread's override values, the statement's snapshot when the
    // place is the spread target or under it (RULED S440).
    fn cellRead(c: LC, d: Sym, i: InstRef, path: FieldRef[]) -> Expr {
        const s: SnapB | not = c.snap
        if (s is some) {
            if (s.decl.id == d.id && instKey(s.inst) == instKey(i) && hasPrefix(path, s.path)) {
                let rest: FieldRef[] = []
                let k: int = s.path.length
                while (k < path.length) {
                    rest = rest.concat([path[k]])
                    k = k + 1
                }
                if (rest.length == 0) return Expr.Local(s.whole)
                const f: SnapField | not = snapFieldOf(s.fields, rest[0])
                if (f is not) return Expr.Read(Place.LocalPath(s.whole, rest))
                if (rest.length == 1) return Expr.Local(f.local)
                return Expr.Read(Place.LocalPath(f.local, dropFirst(rest)))
            }
        }
        return Expr.Read(Place.Cell(d, i, path))
    }

    fn dropFirst(path: FieldRef[]) -> FieldRef[] {
        let out: FieldRef[] = []
        let k = 1
        while (k < path.length) {
            out = out.concat([path[k]])
            k = k + 1
        }
        return out
    }

    fn snapFieldOf(fs: SnapField[], r: FieldRef) -> SnapField | not {
        for (const f of fs) {
            if (f.ref.owner.id == r.owner.id && f.ref.idx == r.idx) return f
        }
        return not
    }

    fn hasPrefix(path: FieldRef[], pre: FieldRef[]) -> boolean {
        if (path.length < pre.length) return false
        let k = 0
        while (k < pre.length) {
            if (path[k].owner.id != pre[k].owner.id || path[k].idx != pre[k].idx) return false
            k = k + 1
        }
        return true
    }

    // Two instance references name the same instance iff they are spelled the same.
    fn instKey(i: InstRef) -> string {
        return match i {
            .Shared(decl: d) :> "S" + d.id
            .Lexical(depth: k) :> "L" + k
            .Alias(sym: s) :> "A" + s.id
            .Narrowed(sym: s) :> "N" + s.id
        }
    }

    // The snapshot binding for a spread whose operand lowered to `op` (a cell read).
    fn snapOf(op: Expr, whole: Sym, fields: SnapField[]) -> SnapB | not {
        return match op {
            .Read(place: pl) :> snapOfPlace(pl, whole, fields)
            .Lit(lit: x) :> not
            .Local(sym: x) :> not
            .Call(callee: x) :> not
            .Prim(op: x) :> not
            .Match(scrut: x) :> not
            .ArrayOf(elems: x) :> not
            .StructOf(ty: x) :> not
            .Handle(inst: x) :> not
            .InitOf(decl: x) :> not
            .Host(call: x) :> not
            .Lambda(params: x) :> not
            .SeqCall(op: x) :> not
            .Validity(of: x) :> not
        }
    }

    fn snapOfPlace(pl: Place, whole: Sym, fields: SnapField[]) -> SnapB | not {
        return match pl {
            .Cell(decl: d, inst: i, path: path) :> snapB(d, i, path, whole, fields)
            .LocalPath(sym: x) :> not
        }
    }

    // The spread operand's cell read, re-addressed through the instance local.
    fn throughInst(op: Expr, one: InstRef) -> Expr {
        return match op {
            .Read(place: pl) :> Expr.Read(placeThrough(pl, one))
            .Lit(lit: x) :> op
            .Local(sym: x) :> op
            .Call(callee: x) :> op
            .Prim(op: x) :> op
            .Match(scrut: x) :> op
            .ArrayOf(elems: x) :> op
            .StructOf(ty: x) :> op
            .Handle(inst: x) :> op
            .InitOf(decl: x) :> op
            .Host(call: x) :> op
            .Lambda(params: x) :> op
            .SeqCall(op: x) :> op
            .Validity(of: x) :> op
        }
    }

    fn placeThrough(pl: Place, one: InstRef) -> Place {
        return match pl {
            .Cell(decl: d, inst: i, path: path) :> Place.Cell(d, one, path)
            .LocalPath(sym: s, path: path) :> pl
        }
    }

    fn snapB(d: Sym, i: InstRef, path: FieldRef[], whole: Sym, fields: SnapField[]) -> SnapB {
        return { decl: d, inst: i, path: path, whole: whole, fields: fields }
    }

    // Does `e` read the local `s` (as a whole, or along a path)?
    fn readsLocal(e: Expr, s: Sym) -> boolean {
        for (const n of allNodes(Node.NExpr(e))) {
            if (nodeReadsLocal(n, s)) return true
        }
        return false
    }

    fn nodeReadsLocal(n: Node, s: Sym) -> boolean {
        return match n {
            .NExpr(e: x) :> exprIsLocal(x, s)
            .NPlace(pl: pl) :> placeIsLocal(pl, s)
            .NProgram(p: x) :> false
            .NDecl(d: x) :> false
            .NField(f: x) :> false
            .NFn(f: x) :> false
            .NServerFn(f: x) :> false
            .NBlock(b: x) :> false
            .NStmt(s: x) :> false
            .NInst(i: x) :> false
            .NPattern(pat: x) :> false
            .NEdit(k: x) :> false
            .NView(v: x) :> false
            .NAttr(a: x) :> false
        }
    }

    fn exprIsLocal(e: Expr, s: Sym) -> boolean {
        return match e {
            .Local(sym: y) :> y.id == s.id
            .Lit(lit: x) :> false
            .Read(place: x) :> false
            .Call(callee: x) :> false
            .Prim(op: x) :> false
            .Match(scrut: x) :> false
            .ArrayOf(elems: x) :> false
            .StructOf(ty: x) :> false
            .Handle(inst: x) :> false
            .InitOf(decl: x) :> false
            .Host(call: x) :> false
            .Lambda(params: x) :> false
            .SeqCall(op: x) :> false
            .Validity(of: x) :> false
        }
    }

    fn placeIsLocal(pl: Place, s: Sym) -> boolean {
        return match pl {
            .LocalPath(sym: y) :> y.id == s.id
            .Cell(decl: x) :> false
        }
    }

    // =========================================================================
    // Expressions.
    // =========================================================================
    fn lowerExprs(c: LC, es: AExpr[]) -> Expr[] {
        let out: Expr[] = []
        for (const e of es) { out = out.concat([lowerExpr(c, e)]) }
        return out
    }

    // A condition the typer recorded as a PRESENCE TEST (a `T | not` value in
    // an `if` / `if=` / ternary test — RULED S440, truthiness Q1: "the compiler
    // emits an absence check, never JS truthiness") lowers to `IsSome(x)`.
    // (s442 — additive; the decision is the typer's `Typing.presence`.)
    export fn lowerExpr(c: LC, e: AExpr) -> Expr {
        if (presenceTest(c.t, e.nid)) return Expr.Prim(PrimOp.IsSome, [presenceOperand(c, e)])
        return lowerExprK(c, e)
    }

    // (s442 r4 (b)) A presence test of a HANDLE tests the handle, not a
    // snapshot of its (possibly unmounted) instance — as `given` does (L11).
    fn presenceOperand(c: LC, e: AExpr) -> Expr {
        const f: NameFact | not = nameFact(c.t.names, e.nid)
        const i: InstRef | not = aliasInst(f)
        if (i is some) return Expr.Handle(instOf(c, i))
        return lowerExprK(c, e)
    }

    fn aliasInst(f: NameFact | not) -> InstRef | not {
        return match f {
            .NInst(decl: d, inst: i) :> aliasOnly(i)
            .NLocal(sym: s) :> not
            .NField(decl: d) :> not
            .NStruct(owner: o) :> not
            .NFn(sym: s) :> not
            .NLength :> not
            .NSurface(of: x) :> not
            not :> not
        }
    }

    fn aliasOnly(i: InstRef) -> InstRef | not {
        return match i {
            .Alias(sym: s) :> i
            .Shared(decl: d) :> not
            .Lexical(depth: n) :> not
            .Narrowed(sym: s) :> not
        }
    }

    fn lowerExprK(c: LC, e: AExpr) -> Expr {
        const k: AExprK = e.k
        return match k {
            .Name(name: n) :> readName(c, nameFact(c.t.names, e.nid))
            .At(name: n) :> readName(c, nameFact(c.t.names, e.nid))
            .AtItem :> readName(c, nameFact(c.t.names, e.nid))
            .Num(raw: r) :> valueExpr(c, valueFact(c.t.values, e.nid), [])
            .Str(v: s) :> valueExpr(c, valueFact(c.t.values, e.nid), [])
            .Bool(v: b) :> valueExpr(c, valueFact(c.t.values, e.nid), [])
            .NotLit :> valueExpr(c, valueFact(c.t.values, e.nid), [])
            .Recovered :> Expr.Lit(Literal.Absent)
            .Variant(name: n) :> valueExpr(c, valueFact(c.t.values, e.nid), [])
            .Member(obj: o, name: n) :> memberExpr(c, nameFact(c.t.names, e.nid), o)

            .Call(callee: cal, args: args) :> callOrBuiltin(c, e, cal, args)
            .Unary(op: o, e: x) :> Expr.Prim(opOf(valueFact(c.t.values, e.nid)), [lowerExpr(c, x)])
            .Binary(op: o, l: l, r: r) :> Expr.Prim(opOf(valueFact(c.t.values, e.nid)), [lowerExpr(c, l), lowerExpr(c, r)])
            .Ternary(test: t, yes: y, no: n) :> boolMatch(lowerExpr(c, t), lowerExpr(c, y), lowerExpr(c, n))
            .Assign(target: t) :> missing()
            .ArrayLit(elems: es) :> Expr.ArrayOf(lowerExprs(c, es))
            .ObjectLit(props: ps) :> valueExpr(c, valueFact(c.t.values, e.nid), ps)
            .Spread(e: sx) :> missing()
            .Index(obj: ix) :> missing()
            .Lambda(params: lp, body: lb) :> lambdaExpr(c, valueFact(c.t.values, e.nid), lb)
        }
    }

    // s444 — a call: a host call / a sequence function (the binder's value
    // fact on the call), else a call of a named function.
    fn callOrBuiltin(c: LC, e: AExpr, cal: AExpr, args: AExpr[]) -> Expr {
        const f: ValueFact | not = valueFact(c.t.values, e.nid)
        return match f {
            .VHost(call: h) :> Expr.Host(h)
            .VSeqCall(op: o) :> seqCallExpr(c, o, cal, args)
            .VLit(lit: l) :> callExpr(c, nameFact(c.t.names, cal.nid), args)
            .VVariant(enumSym: x) :> callExpr(c, nameFact(c.t.names, cal.nid), args)
            .VStructOf(ty: x) :> callExpr(c, nameFact(c.t.names, cal.nid), args)
            .VOp(op: x) :> callExpr(c, nameFact(c.t.names, cal.nid), args)
            .VLambda(params: x) :> callExpr(c, nameFact(c.t.names, cal.nid), args)
            not :> callExpr(c, nameFact(c.t.names, cal.nid), args)
        }
    }

    fn seqCallExpr(c: LC, o: SeqFn, cal: AExpr, args: AExpr[]) -> Expr {
        const obj: AExpr | not = calleeObj(cal)
        if (obj is not || args.length != 1) return missing()
        return Expr.SeqCall(o, lowerExpr(c, obj), lowerExpr(c, args[0]))
    }

    fn calleeObj(cal: AExpr) -> AExpr | not {
        const k: AExprK = cal.k
        return match k {
            .Member(obj: o) :> o
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: x) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Call(callee: x) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .Assign(target: t) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: x) :> not
            .Index(obj: x) :> not
            .Lambda(params: ps) :> not
        }
    }

    fn lambdaExpr(c: LC, f: ValueFact | not, body: AExpr) -> Expr {
        return match f {
            .VLambda(params: ps) :> Expr.Lambda(ps, lowerExpr(c, body))
            .VLit(lit: l) :> missing()
            .VVariant(enumSym: x) :> missing()
            .VStructOf(ty: x) :> missing()
            .VOp(op: x) :> missing()
            .VHost(call: x) :> missing()
            .VSeqCall(op: x) :> missing()
            not :> missing()
        }
    }

    // A name / `@x` / `@.`: a local, a field read, or a whole instance value.
    fn readName(c: LC, f: NameFact | not) -> Expr {
        return match f {
            .NLocal(sym: s) :> Expr.Local(s)
            .NField(decl: d, inst: i, idx: x) :> cellRead(c, d, instOf(c, i), [{ owner: d, idx: x }])
            .NInst(decl: d, inst: i) :> cellRead(c, d, instOf(c, i), [])
            .NStruct(owner: o) :> missing()
            .NFn(sym: s) :> missing()
            .NLength :> missing()
            .NSurface(of: x) :> missing()
            not :> missing()
        }
    }

    // A constant the binder resolved: a literal, a variant, or a struct value
    // in DECLARED field order (analyze's `order`: the prop index of each
    // declared field; `ps` are the object literal's props). L19.
    fn valueExpr(c: LC, f: ValueFact | not, ps: AProp[]) -> Expr {
        return match f {
            .VLit(lit: l) :> Expr.Lit(l)
            .VVariant(enumSym: s, idx: i) :> Expr.Lit(Literal.Variant(s, i))
            .VStructOf(ty: t, order: order) :> Expr.StructOf(t, orderedProps(c, ps, order))
            .VOp(op: o) :> missing()
            .VHost(call: h) :> missing()
            .VSeqCall(op: x) :> missing()
            .VLambda(params: x) :> missing()
            not :> missing()
        }
    }

    fn opOf(f: ValueFact | not) -> PrimOp {
        return match f {
            .VOp(op: o) :> o
            .VLit(lit: l) :> PrimOp.Not
            .VVariant(enumSym: s) :> PrimOp.Not
            .VStructOf(ty: t) :> PrimOp.Not
            .VHost(call: h) :> PrimOp.Not
            .VSeqCall(op: x) :> PrimOp.Not
            .VLambda(params: x) :> PrimOp.Not
            not :> PrimOp.Not
        }
    }

    // `a.b`: a field of an instance (the fact says which), a struct step
    // appended to the place the object reads, or `.length`.
    fn memberExpr(c: LC, f: NameFact | not, obj: AExpr) -> Expr {
        return match f {
            .NLength :> Expr.Prim(PrimOp.Length, [lowerExpr(c, obj)])
            .NSurface(of: v, prop: pr) :> Expr.Validity(validityOf(c, v), pr)
            .NField(decl: d, inst: i, idx: x) :> cellRead(c, d, instOf(c, i), [{ owner: d, idx: x }])
            .NStruct(owner: o, idx: x) :> stepInto(lowerExpr(c, obj), { owner: o, idx: x })
            .NLocal(sym: s) :> missing()
            .NInst(decl: d) :> missing()
            .NFn(sym: s) :> missing()
            not :> missing()
        }
    }

    // D6: a whole local is `Local`; a path through it is `LocalPath`; a path
    // through a cell extends the cell's place.
    fn stepInto(base: Expr, step: FieldRef) -> Expr {
        return match base {
            .Local(sym: s) :> Expr.Read(Place.LocalPath(s, [step]))
            .Read(place: p) :> Expr.Read(extendPlace(p, step))
            .Lit(lit: l) :> missing()
            .Call(callee: x) :> missing()
            .Prim(op: o) :> missing()
            .Match(scrut: s) :> missing()
            .ArrayOf(elems: es) :> missing()
            .StructOf(ty: t) :> missing()
            .Handle(inst: i) :> missing()
            .InitOf(decl: d) :> missing()
            .Host(call: x) :> missing()
            .Lambda(params: x) :> missing()
            .SeqCall(op: x) :> missing()
            .Validity(of: x) :> missing()
        }
    }

    fn extendPlace(p: Place, step: FieldRef) -> Place {
        return match p {
            .Cell(decl: d, inst: i, path: path) :> Place.Cell(d, i, path.concat([step]))
            .LocalPath(sym: s, path: path) :> Place.LocalPath(s, path.concat([step]))
        }
    }

    // A call of a named function (the callee's fact names it).
    fn callExpr(c: LC, f: NameFact | not, args: AExpr[]) -> Expr {
        return match f {
            .NFn(sym: s) :> Expr.Call(s, lowerExprs(c, args))
            .NLocal(sym: s) :> missing()
            .NField(decl: d) :> missing()
            .NInst(decl: d) :> missing()
            .NStruct(owner: o) :> missing()
            .NLength :> missing()
            .NSurface(of: x) :> missing()
            not :> missing()
        }
    }

    // L7: `c ? a : b` → a Match over a bool, `true` arm first.
    fn boolMatch(test: Expr, yes: Expr, no: Expr) -> Expr {
        const tArm: MatchArm = { pat: Pattern.PLit(Literal.Bool(true)), body: yes }
        const fArm: MatchArm = { pat: Pattern.PLit(Literal.Bool(false)), body: no }
        return Expr.Match(test, [tArm, fArm])
    }
    fn orderedProps(c: LC, ps: AProp[], order: int[]) -> Expr[] {
        let out: Expr[] = []
        for (const j of order) {
            if (j >= 0 && j < ps.length) {
                out = out.concat([lowerExpr(c, ps[j].value)])
            } else {
                out = out.concat([missing()])
            }
        }
        return out
    }

    // An initializer / construction value: `"…"` is a string literal (L19).
    fn lowerValue(c: LC, v: AAttrValue) -> Expr | not {
        return match v {
            .Quoted(v: s) :> litStr(s)
            .Bare(e: e) :> lowerExpr(c, e)
            .Paren(e: e) :> lowerExpr(c, e)
            .NoValue :> not
            .Braced(b: b) :> not
        }
    }

    // =========================================================================
    // Statements.
    // =========================================================================
    fn lowerBlock(c: LC, b: ABlock) -> Block {
        let out: Stmt[] = []
        for (const s of b.stmts) { out = out.concat(lowerStmt(c, s)) }
        return block(out)
    }

    fn lowerStmt(c: LC, s: AStmt) -> Stmt[] {
        const k: AStmtK = s.k
        return match k {
            .Eval(e: e) :> exprStmt(c, e)
            .Local(name: n, mutable: m, init: i) :> letStmt(c, s, i)
            .Return(e: e) :> [Stmt.Return(returnValue(c, e))]
            .If(cond: x, thenB: t, elseB: el) :> [Stmt.If(lowerExpr(c, x), lowerBlock(c, t), maybeBlock(c, el))]
            .Given(name: n, subject: sub, body: b) :> givenStmts(c, s, b)
            .EffectStmt(w: w) :> []              // analyze refused it (E-LIFECYCLE-016 / E-BOOTSTRAP-UNSUPPORTED)
            .Defer(body: b) :> [Stmt.Defer(lowerBlock(c, b))]   // s451 (§19.16)
        }
    }

    fn returnValue(c: LC, e: AExpr | not) -> Expr {
        if (e is not) return Expr.Lit(Literal.Absent)
        return lowerExpr(c, e)
    }

    fn maybeBlock(c: LC, b: ABlock | not) -> Block | not {
        if (b is not) return not
        return lowerBlock(c, b)
    }

    fn letStmt(c: LC, s: AStmt, init: AExpr) -> Stmt[] {
        const sym: Sym | not = letSym(bindFact(c.t.binds, s.nid))
        if (sym is not) return []
        return [Stmt.Let(sym, lowerExpr(c, init))]
    }

    fn letSym(f: BindFact | not) -> Sym | not {
        return match f {
            .BBind(sym: s) :> s
            .BParam(sym: x) :> not
            .BGiven(sym: x) :> not
            not :> not
        }
    }

    // L11: `given c = @h :> { … }` → Let c = Handle(h); If(IsSome(c), { … }).
    fn givenStmts(c: LC, s: AStmt, body: ABlock) -> Stmt[] {
        const f: BindFact | not = bindFact(c.t.binds, s.nid)
        return match f {
            .BGiven(sym: sym, inst: i) :> [
                Stmt.Let(sym, Expr.Handle(i)),
                Stmt.If(Expr.Prim(PrimOp.IsSome, [Expr.Local(sym)]), lowerBlock(c, body), not),
            ]
            .BBind(sym: x) :> []
            .BParam(sym: x) :> []
            not :> []
        }
    }

    // An expression in statement position: a classified write, a local
    // rebinding, a reset, or an evaluated call.
    fn exprStmt(c: LC, e: AExpr) -> Stmt[] {
        const f: EffectFact | not = effectFact(c.t.effects, e.nid)
        const k: AExprK = e.k
        const value: AExpr | not = assignedValue(k)
        return match f {
            .EWrite(w: w) :> writeStmt(c, w, value)
            .ESpread(ws: ws, inst: si, snap: sn, fields: sf) :> spreadStmts(c, ws, si, sn, sf, value)
            .EReset(w: w, decl: d, idx: i) :> resetStmt(c, w, d, i)
            .EAssignLocal(sym: s) :> assignLocal(c, s, value)
            .EEdits(w: w, elems: es, tmps: ts, snap: sn) :> editStmts(c, w, es, ts, sn)
            .ERemove(w: w) :> [Stmt.Write(w.cap, instOf(c, w.inst), w.edit, Expr.Lit(Literal.Int(1)), w.check)]
            .EElemAt(cap: cap, inst: i, index: ix, path: path) :> elemAtStmt(c, cap, i, ix, path, value)
            not :> [Stmt.Eval(lowerExpr(c, e))]
        }
    }

    // s444 — `@xs[i].f = v` → Write(cap, inst, ElemAt(i, path), v): the index
    // and the value are lowered here; the element field's contract was judged
    // by analyze (dpa-052 Q3) and is re-checked in Core (check.scrml C3).
    fn elemAtStmt(c: LC, cap: Sym, i: InstRef, ix: AExpr, path: FieldRef[], value: AExpr | not) -> Stmt[] {
        if (value is not) return []
        return [Stmt.Write(cap, instOf(c, i), EditKind.ElemAt(lowerExpr(c, ix), path), lowerExpr(c, value), Check.Static)]
    }
    // The value a write stores: an assignment's right side, or the element of
    // an edit method call (`@x.push(v)`).
    fn assignedValue(k: AExprK) -> AExpr | not {
        return match k {
            .Assign(target: t, value: v) :> v
            .Call(callee: x, args: args) :> firstArg(args)
            .Name(name: n) :> not
            .At(name: n) :> not
            .AtItem :> not
            .Num(raw: r) :> not
            .Str(v: s) :> not
            .Bool(v: b) :> not
            .NotLit :> not
            .Recovered :> not
            .Variant(name: n) :> not
            .Member(obj: o) :> not
            .Unary(op: o) :> not
            .Binary(op: o) :> not
            .Ternary(test: t) :> not
            .ArrayLit(elems: es) :> not
            .ObjectLit(props: ps) :> not
            .Spread(e: sx) :> not
            .Index(obj: ix) :> not
            .Lambda(params: lp) :> not
        }
    }

    fn firstArg(args: AExpr[]) -> AExpr | not {
        if (args.length == 0) return not
        return args[0]
    }

    fn writeStmt(c: LC, w: WriteFact, value: AExpr | not) -> Stmt[] {
        if (value is not) return []
        return [Stmt.Write(w.cap, instOf(c, w.inst), w.edit, lowerExpr(c, value), w.check)]
    }

    // s442 / r1 F5 F6 — a recognized sequence shape (§66.11.2): `@x = [...@x, a, b]`
    // is the end-appends of `a` then `b` (the same edits as `@x.push(a);
    // @x.push(b)`); `@x = [a, b, ...@x]` the front-prepends that leave the
    // result reading `[a, b, …]`. The array literal is ONE value: every new
    // element is evaluated, LEFT TO RIGHT, into its local (analyze minted
    // `tmps`) before any write, so no element sees another's edit (`at:
    // @x.length` twice reads the same length). Two or more writes form one
    // Commit (all-or-nothing, batched); one element needs no local — its value
    // is evaluated before its own single write.
    // r2 (RULED S442, "sequence spreads use one snapshot"): every `@x` read
    // inside the elements reads the value from BEFORE the statement — the one
    // snapshot, a Let emitted only when some element reads it (as the struct
    // spread's, S440). The edit itself is still the classified append /
    // prepend onto the target (a write a called function made to `@x` while
    // the elements were evaluated survives, as a struct spread keeps a write
    // to a field it does not override).
    fn editStmts(c: LC, w: WriteFact, elems: AExpr[], tmps: Sym[], sn: SeqSnap) -> Stmt[] {
        const target: InstRef = instOf(c, w.inst)
        const place: FieldRef[] = [{ owner: sn.decl, idx: sn.idx }]
        const sc: LC = { t: c.t, file: c.file, subst: c.subst, snap: { decl: sn.decl, inst: target, path: place, whole: sn.local, fields: [] } }
        let values: Expr[] = []
        for (const x of elems) { values = values.concat([lowerExpr(sc, x)]) }
        let pre: Stmt[] = []
        if (anyReads(values, sn.local)) pre = [Stmt.Let(sn.local, Expr.Read(Place.Cell(sn.decl, target, place)))]
        if (values.length == 1) return pre.concat([Stmt.Write(w.cap, target, w.edit, values[0], w.check)])
        let lets: Stmt[] = pre
        let k = 0
        for (const v of values) {
            lets = lets.concat([Stmt.Let(tmps[k], v)])
            k = k + 1
        }
        const prepend: boolean = w.edit == EditKind.Prepend
        let writes: Stmt[] = []
        if (prepend) {
            let j: int = tmps.length - 1
            while (j >= 0) {
                writes = writes.concat([Stmt.Write(w.cap, target, w.edit, Expr.Local(tmps[j]), w.check)])
                j = j - 1
            }
        } else {
            for (const t of tmps) {
                writes = writes.concat([Stmt.Write(w.cap, target, w.edit, Expr.Local(t), w.check)])
            }
        }
        const edit: Stmt = Stmt.Commit(writes)
        return lets.concat([edit])
    }

    fn assignLocal(c: LC, s: Sym, value: AExpr | not) -> Stmt[] {
        if (value is not) return []
        return [Stmt.Assign(s, lowerExpr(c, value))]
    }

    // O58 (b): `@x = { ...@x, f: v }` → one contract-checked Write per override.
    // The literal is ONE value built from one snapshot (§66.10 item 1), so with
    // two or more overrides every value is evaluated into its local (analyze
    // minted `tmp`) before the first write — `{ ...@p, x: @p.y, y: @p.x }`
    // swaps, as the genuine replace does (§66.11.3 item 1). The writes are ONE
    // edit: they form a Commit — every override's contract is checked before
    // any is applied, and a refusal applies none (RULED S440: "Should a spread
    // write be all-or-nothing on a runtime refusal? Yes."). A lone override
    // needs neither: its value is evaluated before its own write, and one
    // checked write is already all-or-nothing.
    // Every override writes the SAME instance: it is resolved once, into the
    // local analyze minted (`Let inst = Handle(…)`), and every Write of the
    // Commit goes through `Narrowed(inst)` — the Commit never re-resolves a
    // handle between its writes.
    // STRICT SNAPSHOT (RULED S440): the spread operand `...@x` — the value from
    // BEFORE the statement — is read ONCE into the local analyze minted (`snap`),
    // before any override value is evaluated, and every read of `@x` (or under
    // it) inside the override values reads that local. So a call in one
    // override that writes `@x` is invisible to the others:
    // `{ ...@p, x: bump(), y: @p.z }` with bump writing `@p.z = 99` gives y =
    // the pre-statement z. (bump's own write to a field NOT overridden survives:
    // the Commit writes only the overridden fields.) The snapshot Let is emitted
    // only when some override value reads it.
    fn spreadStmts(c: LC, ws: SpreadWrite[], inst: Sym, snap: Sym, fields: SnapField[], value: AExpr | not) -> Stmt[] {
        if (value is not) return []
        const ps: AProp[] = objectProps(value)
        // `@x = { ...@x }`: no override — the same value; nothing to write
        if (ws.length == 0) return []
        const operand: Expr = lowerExpr(c, ps[0].value)
        const sc: LC = { t: c.t, file: c.file, subst: c.subst, snap: snapOf(operand, snap, fields) }
        let values: Expr[] = []
        for (const sw of ws) { values = values.concat([lowerExpr(sc, ps[sw.prop].value)]) }
        if (ws.length == 1) {
            const w0: WriteFact = ws[0].w
            return snapLets(operand, snap, fields, values).concat([Stmt.Write(w0.cap, instOf(c, w0.inst), w0.edit, values[0], w0.check)])
        }
        const one: InstRef = InstRef.Narrowed(inst)
        let lets: Stmt[] = [Stmt.Let(inst, Expr.Handle(instOf(c, ws[0].w.inst)))]
        // the snapshot reads through the instance local too (one resolution)
        lets = lets.concat(snapLets(throughInst(operand, one), snap, fields, values))
        let writes: Stmt[] = []
        let k = 0
        for (const sw of ws) {
            const w: WriteFact = sw.w
            const t: Sym | not = sw.tmp
            if (t is some) {
                lets = lets.concat([Stmt.Let(t, values[k])])
                writes = writes.concat([Stmt.Write(w.cap, one, w.edit, Expr.Local(t), w.check)])
            }
            k = k + 1
        }
        return lets.concat([Stmt.Commit(writes)])
    }

    // The snapshot Lets (RULED S440 strict snapshot, narrowed by S440 re-review
    // N1): ONLY the fields some override value reads lexically, each read once
    // exactly as that lexical read would have read it (a tracked `.get()` of the
    // field — so the reactive read set is the lexical one, never wider), and the
    // whole value only if a value reads the whole `@x`. `operand` is the spread
    // operand's cell read (already re-addressed through the instance local when
    // there is a Commit).
    fn snapLets(operand: Expr, whole: Sym, fields: SnapField[], values: Expr[]) -> Stmt[] {
        let out: Stmt[] = []
        if (anyReads(values, whole)) out = [Stmt.Let(whole, operand)]
        for (const f of fields) {
            if (anyReads(values, f.local)) out = out.concat([Stmt.Let(f.local, fieldOf(operand, f.ref))])
        }
        return out
    }

    fn anyReads(values: Expr[], s: Sym) -> boolean {
        for (const v of values) {
            if (readsLocal(v, s)) return true
        }
        return false
    }

    // A read of field `r` under the operand's place.
    fn fieldOf(op: Expr, r: FieldRef) -> Expr {
        return match op {
            .Read(place: pl) :> Expr.Read(extendPlace(pl, r))
            .Lit(lit: x) :> missing()
            .Local(sym: x) :> missing()
            .Call(callee: x) :> missing()
            .Prim(op: x) :> missing()
            .Match(scrut: x) :> missing()
            .ArrayOf(elems: x) :> missing()
            .StructOf(ty: x) :> missing()
            .Handle(inst: x) :> missing()
            .InitOf(decl: x) :> missing()
            .Host(call: x) :> missing()
            .Lambda(params: x) :> missing()
            .SeqCall(op: x) :> missing()
            .Validity(of: x) :> missing()
        }
    }

    fn objectProps(e: AExpr) -> AProp[] {
        const k: AExprK = e.k
        return match k {
            .ObjectLit(props: ps) :> ps
            .Spread(e: sx) :> []
            .Index(obj: ix) :> []
            .Lambda(params: lp) :> []
            .Name(name: n) :> []
            .At(name: n) :> []
            .AtItem :> []
            .Num(raw: r) :> []
            .Str(v: s) :> []
            .Bool(v: b) :> []
            .NotLit :> []
            .Recovered :> []
            .Variant(name: n) :> []
            .Member(obj: o) :> []
            .Call(callee: x) :> []
            .Unary(op: o) :> []
            .Binary(op: o) :> []
            .Ternary(test: t) :> []
            .Assign(target: t) :> []
            .ArrayLit(elems: es) :> []
        }
    }

    // L4: `reset(@x)` → Write(.Replace, THAT INSTANCE's initializer). A user
    // declaration's instance may have been constructed with a use-site value
    // (L6 / §66.9 — the use-site attribute IS its initializer), so its reset
    // writes `InitOf` (D15, re-run at runtime). The program (R4) is a `single`
    // with no use site: its initializer is the declared one, lowered inline
    // with `.Lexical(0)` meaning the instance being reset.
    fn resetStmt(c: LC, w: WriteFact, d: Sym, idx: int) -> Stmt[] {
        const di: DeclInfo | not = declInfo(c.t, d)
        if (di is not) return []
        const target: InstRef = instOf(c, w.inst)
        const surf: Stmt[] = surfaceReset(di, target, idx).concat(unpersistReset(c.t, di, target, idx))
        if (!isProgramKind(di.kind)) return [Stmt.Write(w.cap, target, w.edit, Expr.InitOf(d, target, idx), w.check)].concat(surf)
        const ic: LC = { t: c.t, file: c.file, subst: target, snap: not }
        const init: Expr | not = lowerValue(ic, di.fields[idx].init)
        if (init is not) return []
        return [Stmt.Write(w.cap, target, w.edit, init, w.check)].concat(surf)
    }

    // s449 — §55.13: `reset(@x)` "clears synthesized validity state in
    // addition to resetting the underlying value" — the field's surface, when
    // it has one (every field of a user declaration, §55.6; a top-level value
    // that carries validators, §55.5.1).
    fn surfaceReset(di: DeclInfo, inst: InstRef, idx: int) -> Stmt[] {
        if (idx < 0 || idx >= di.fields.length) return []
        if (isProgramKind(di.kind) && di.fields[idx].vals.length == 0) return []
        return [Stmt.ResetSurface(ValidityOf.OfField(di.sym, inst, idx))]
    }

    // s449 — one View.ResetOn per accepted `reset-on=` rule (§6.8.4): the
    // triggers as cells of the program instance, and the reset as ONE Write of
    // the cell's initializer — a replace, or a Static transition for a cell with
    // a `rule=` graph (analyze proved every state admits the target, rule 6).
    fn resetOnViews(c: LC, d: DeclInfo) -> View[] {
        let out: View[] = []
        for (const r of c.t.resets) {
            const reset: Stmt[] = resetWrite(c, d, r.target)
            if (reset.length >= 1) {
                let triggers: EffectDep[] = []
                for (const t of r.triggers) { triggers = triggers.concat([mkEffectDep(d.sym, InstRef.Lexical(0), t)]) }
                out = out.concat([View.ResetOn(triggers, block(reset), r.rank)])
            }
        }
        return out
    }

    fn resetWrite(c: LC, d: DeclInfo, idx: int) -> Stmt[] {
        if (idx < 0 || idx >= d.fields.length) return []
        const f: FieldInfo = d.fields[idx]
        const cap: Sym | not = f.wcap
        if (cap is not) return []
        const ic: LC = { t: c.t, file: c.file, subst: InstRef.Lexical(0), snap: not }
        const init: Expr | not = lowerValue(ic, f.init)
        if (init is not) return []
        let edit: EditKind = EditKind.Replace
        if (f.graph is some) edit = EditKind.Transition
        return [Stmt.Write(cap, InstRef.Lexical(0), edit, init, Check.Static)].concat(surfaceReset(d, InstRef.Lexical(0), idx)).concat(unpersistReset(c.t, d, InstRef.Lexical(0), idx))
    }

    fn isProgramKind(k: DeclKind) -> boolean {
        return match k {
            .Program :> true
            .User :> false
            .Predefined :> false
        }
    }

    // =========================================================================
    // Views.
    // =========================================================================
    fn lowerNodes(c: LC, ns: ANode[]) -> View[] {
        let out: View[] = []
        let i = 0
        while (i < ns.length) {
            const j: int = chainEnd(ns, i)          // s451: an if-chain (§17.1.1) starting here
            if (j > i + 1) {
                out = out.concat([chainView(c, ns, i, j)])
                i = j
            } else {
                out = out.concat(lowerNode(c, ns[i]))
                i = i + 1
            }
        }
        return out
    }

    // ---- s451: if-chains (§17.1.1) -------------------------------------------
    // "An if-chain desugars to a single `${ if / else if / else }` block" — ONE
    // View.Cond whose arms are the members in declaration order (the runtime's
    // `cond` renders the FIRST arm whose test holds, so exactly one member is
    // in the DOM, reactively). An `else` arm's test is `true`. Each member is
    // lowered as the bare element: "the structural attributes are consumed
    // during desugaring and do not appear on the lifted element". Whitespace-
    // only text between members is consumed with them (§17.1.1: it does not
    // break a chain). analyze (chainCheck) refused every malformed chain; a lone
    // `if=` is not a chain here — condWrap wraps it (L5).
    fn elemOf(n: ANode) -> AElem | not {
        const k: ANodeK = n.k
        return match k {
            .Elem(e: e) :> e
            .Text(text: t) :> not
            .Interp(e: e) :> not
            .DeclNode(d: d) :> not
            .Effect(w: w) :> not
        }
    }

    fn blankText(n: ANode) -> boolean {
        const k: ANodeK = n.k
        return match k {
            .Text(text: t) :> t.trim() == ""
            .Elem(e: e) :> false
            .Interp(e: e) :> false
            .DeclNode(d: d) :> false
            .Effect(w: w) :> false
        }
    }

    fn hasAttrNamed(e: AElem, name: string) -> boolean {
        for (const a of e.attrs) {
            if (a.name == name) return true
        }
        return false
    }

    // The index just past the last member of the chain opened by ns[i] (an
    // element carrying `if=`), or i + 1 when ns[i] opens none.
    fn chainEnd(ns: ANode[], i: int) -> int {
        const first: AElem | not = elemOf(ns[i])
        if (first is not) return i + 1
        if (!hasAttrNamed(first, "if")) return i + 1
        let end: int = i + 1
        let k: int = i + 1
        let open = true
        while (open && k < ns.length) {
            const e: AElem | not = elemOf(ns[k])
            if (e is some) {
                if (hasAttrNamed(e, "if")) {
                    open = false
                } else if (hasAttrNamed(e, "else-if")) {
                    end = k + 1
                } else if (hasAttrNamed(e, "else")) {
                    end = k + 1
                    open = false
                } else {
                    open = false
                }
            } else if (!blankText(ns[k])) {
                open = false
            }
            k = k + 1
        }
        return end
    }

    fn chainView(c: LC, ns: ANode[], i: int, j: int) -> View {
        let arms: CondArm[] = []
        let k: int = i
        while (k < j) {
            const e: AElem | not = elemOf(ns[k])
            if (e is some) arms = arms.concat([{ test: chainTest(c, e), body: bareElem(c, e) }])
            k = k + 1
        }
        return View.Cond(arms)
    }

    // A member's test: its `if=` / `else-if=` condition; `else` → true. A
    // condition that does not lower (analyze reported it) is `false` — the
    // branch never renders (fail closed), and the arms after it keep their
    // place in the order.
    fn chainTest(c: LC, e: AElem) -> Expr {
        for (const a of e.attrs) {
            if (a.name == "if" || a.name == "else-if") {
                const t: Expr | not = lowerValue(c, a.value)
                if (t is some) return t
                return Expr.Lit(Literal.Bool(false))
            }
        }
        return Expr.Lit(Literal.Bool(true))
    }

    // The element without its condition (the chain's arm carries it).
    fn bareElem(c: LC, e: AElem) -> View[] {
        const f: ElemFact | not = elemFact(c.t.elems, e.nid)
        return match f {
            .MHtml :> [htmlView(c, e)]
            .MUse(decl: d, alias: a) :> [useView(c, e, d, a)]
            .MEach(bind: b, handles: hs) :> lowerElem(c, e)
            .MSlot :> lowerElem(c, e)
            .MErrors(of: v, all: a) :> lowerElem(c, e)
            .MStateView(v: v) :> lowerElem(c, e)
            .MInline(v: v) :> lowerElem(c, e)
            .MStar(decl: d, inst: x) :> lowerElem(c, e)
            not :> []
        }
    }

    fn htmlView(c: LC, e: AElem) -> View {
        return View.El(e.tag, noValidate(c, e).concat(htmlAttrs(c, e.attrs)), lowerNodes(c, e.kids))
    }

    fn useView(c: LC, e: AElem, d: Sym, a: Sym | not) -> View {
        return View.Instance(d, constructAttrs(c, e.attrs), lowerNodes(c, e.kids), a)
    }

    fn lowerNode(c: LC, n: ANode) -> View[] {
        const k: ANodeK = n.k
        return match k {
            .Text(text: t) :> textViews(t)
            .Interp(e: e) :> [View.Dyn(lowerExpr(c, e))]
            .Elem(e: e) :> lowerElem(c, e)
            .DeclNode(d: d) :> []
            .Effect(w: w) :> [effectView(c, w)]
        }
    }

    // s449 — an effect → View.Effect: each dependency's field fact (analyze
    // resolved it, or reported E-LIFECYCLE-007 and left no fact — then the
    // program does not run). Both spellings lower alike (§6.7.4 "Parses
    // identically").
    fn effectView(c: LC, w: AEffect) -> View {
        let deps: EffectDep[] = []
        for (const d of w.deps) { deps = deps.concat(effectDep(c, nameFact(c.t.names, d.nid))) }
        return View.Effect(deps, lowerBlock(c, w.body))
    }

    fn effectDep(c: LC, f: NameFact | not) -> EffectDep[] {
        return match f {
            .NField(decl: d, inst: i, idx: x) :> [mkEffectDep(d, instOf(c, i), x)]
            .NLocal(sym: s) :> []
            .NInst(decl: d) :> []
            .NStruct(owner: o) :> []
            .NFn(sym: s) :> []
            .NLength :> []
            .NSurface(of: x) :> []
            not :> []
        }
    }

    fn mkEffectDep(d: Sym, i: InstRef, x: int) -> EffectDep { return { decl: d, inst: i, idx: x } }

    // dpa-045 follow-up 4 (RULED S442; SPEC §4.18.5 "whitespace-only text
    // between elements is kept exactly too"): a Text node is free-text content
    // (a code-default body never builds one for its formatting whitespace —
    // parseCodeBody skips it) or a display-text literal segment — both
    // verbatim. Only the parser's empty placeholder ("") renders nothing.
    fn textViews(t: string) -> View[] {
        if (t == "") return []
        return [View.Text(t)]
    }

    fn lowerElem(c: LC, e: AElem) -> View[] {
        const f: ElemFact | not = elemFact(c.t.elems, e.nid)
        return match f {
            .MHtml :> condWrap(c, e, [htmlView(c, e)])
            .MUse(decl: d, alias: a) :> condWrap(c, e, [useView(c, e, d, a)])
            .MEach(bind: b, handles: hs) :> [eachView(c, e, b, hs)]
            .MSlot :> [View.Slot]
            .MErrors(of: v, all: a) :> [View.Errors(validityOf(c, v), a)]
            .MStateView(v: v) :> [stateView(c, v)]
            .MInline(v: v) :> inlineViews(c, v)
            .MStar(decl: d, inst: i) :> [View.Star(d, instOf(c, i))]
            not :> []
        }
    }

    // s449 — a surface analyze resolved, its instance reference made Core's
    // (the same `instOf` every cell read goes through).
    fn validityOf(c: LC, v: ValidityOf) -> ValidityOf {
        return match v {
            .OfField(decl: d, inst: i, idx: x) :> ValidityOf.OfField(d, instOf(c, i), x)
            .OfDecl(decl: d, inst: i) :> ValidityOf.OfDecl(d, instOf(c, i))
        }
    }

    // s444 Phase B (RULED S442 (3): "the compiler adds `novalidate` to any form
    // carrying lowered attributes") — analyze listed the forms.
    // s449 — and the compiler submit gate (§55.17.3) on every gated form,
    // first among the form's attributes: analyze listed the gated forms and
    // the values that gate each (§55.17.6 names them).
    fn noValidate(c: LC, e: AElem) -> Attr[] {
        let out: Attr[] = []
        for (const g of c.t.gated) {
            if (g.form == e.nid) out = out.concat([Attr.Gate(g.values, [])])
        }
        if (c.t.novalidate.indexOf(e.nid) >= 0) out = out.concat([Attr.Static("novalidate", "")])
        return out
    }

    // s442 — `<*x/>` by inlining (analyze's InlineView): the markup, lowered in
    // place; when it is a declaration's renders for its SHARED instance, its
    // `.Lexical(0)` means that instance (`subst`, as L4's reset does).
    fn inlineViews(c: LC, v: InlineView) -> View[] {
        const s: InstRef | not = v.subst
        if (s is not) return lowerNodes(c, v.nodes)
        const ic: LC = { t: c.t, file: c.file, subst: s, snap: not }
        return lowerNodes(ic, v.nodes)
    }

    // s442 — `<*f/>` of a graph field (O5 (1i)): a View.Cond with one arm per
    // state-child body, each shown while the field holds that variant. The
    // test reads the field (a nullary-variant compare, EqPrim — §45) through
    // the instance analyze resolved; the bodies are lowered in place.
    fn stateView(c: LC, v: StateView) -> View {
        const read: Expr = cellRead(c, v.decl, instOf(c, v.inst), [{ owner: v.decl, idx: v.idx }])
        let arms: CondArm[] = []
        for (const a of v.arms) {
            const test: Expr = Expr.Prim(PrimOp.EqPrim, [read, Expr.Lit(Literal.Variant(v.enumSym, a.variant))])
            arms = arms.concat([{ test: test, body: lowerNodes(c, a.body) }])
        }
        return View.Cond(arms)
    }

    fn attrKind(c: LC, a: AAttr) -> AttrKind | not {
        return attrFact(c.t.attrs, a.nid)
    }
    fn isIf(k: AttrKind) -> boolean {
        return match k {
            .AIf :> true
            .AShow :> false
            .AOn(event: ev) :> false
            .AConstruct(field: x) :> false
            .AStatic :> false
            .ABound :> false
            .AAs :> false
            .AEachIn :> false
            .AEachKey :> false
            .AEachAs :> false
            .ABind(kind: k) :> false
        }
    }

    // L5: `if=` on an element or a use → a one-arm Cond around it.
    fn condWrap(c: LC, e: AElem, vs: View[]) -> View[] {
        for (const a of e.attrs) {
            const k: AttrKind | not = attrKind(c, a)
            if (k is some) {
                if (isIf(k)) {
                    const test: Expr | not = lowerValue(c, a.value)
                    if (test is some) return [View.Cond([{ test: test, body: vs }])]
                }
            }
        }
        return vs
    }

    fn htmlAttrs(c: LC, attrs: AAttr[]) -> Attr[] {
        let out: Attr[] = []
        for (const a of attrs) {
            const k: AttrKind | not = attrKind(c, a)
            if (k is some) out = out.concat(htmlAttr(c, a, k))
        }
        return out
    }

    fn htmlAttr(c: LC, a: AAttr, k: AttrKind) -> Attr[] {
        return match k {
            .AStatic :> [Attr.Static(a.name, quotedText(a.value))]
            .ABound :> boundAttr(c, a)
            .AOn(event: ev) :> [Attr.On(ev, handlerBlock(c, a.value))]
            .AIf :> []
            .AShow :> showAttr(c, a)
            .AConstruct(field: x) :> []
            .AAs :> []
            .AEachIn :> []
            .AEachKey :> []
            .AEachAs :> []
            .ABind(kind: bk, w: w, decl: d, idx: x, sink: sk, vattrs: vs) :> [bindAttr(c, bk, w, d, x, sk)].concat(validatorAttrs(vs))
        }
    }

    // s451 — `show=cond` (§17.2) → Attr.Show: the element stays in the DOM and
    // is hidden (`display: none`) while the condition is false. Inside an
    // if-chain arm it composes (§17.1.1): the arm decides presence, this
    // decides visibility. A condition that does not lower (analyze reported
    // it) hides the element (fail closed).
    fn showAttr(c: LC, a: AAttr) -> Attr[] {
        const t: Expr | not = lowerValue(c, a.value)
        if (t is some) return [Attr.Show(t)]
        return [Attr.Show(Expr.Lit(Literal.Bool(false)))]
    }

    // s444 Phase B (dpa-058, RULED S442 (2)) — the bound field's validators'
    // HTML-native attributes (analyze computed them for THIS element).
    fn validatorAttrs(vs: HtmlAttrPair[]) -> Attr[] {
        let out: Attr[] = []
        for (const v of vs) { out = out.concat([Attr.Static(v.name, v.value)]) }
        return out
    }

    // s444 — `bind:value=@p` / `bind:checked=@p` → Attr.Bind: the read of the
    // place (field `idx` of `decl` through the write's instance, then the
    // write's FieldAt path) and ONE write of the event-value local `sink`
    // (check.scrml C8 pins the pair to one place).
    fn bindAttr(c: LC, k: BindKind, w: WriteFact, d: Sym, idx: int, sink: Sym) -> Attr {
        const inst: InstRef = instOf(c, w.inst)
        const read: Expr = cellRead(c, d, inst, [{ owner: d, idx: idx }].concat(editPath(w.edit)))
        return Attr.Bind(k, read, sink, block([Stmt.Write(w.cap, inst, w.edit, Expr.Local(sink), w.check)]))
    }

    fn editPath(k: EditKind) -> FieldRef[] {
        return match k {
            .FieldAt(path: p) :> p
            .Replace :> []
            .Append :> []
            .Prepend :> []
            .Anywhere :> []
            .PositionWrite :> []
            .Transition :> []
            .RemoveEnd :> []
            .RemoveFront :> []
            .RemoveAnywhere :> []
            .ElemAt(index: x) :> []
        }
    }

    fn quotedText(v: AAttrValue) -> string {
        return match v {
            .Quoted(v: s) :> s
            .NoValue :> ""
            .Bare(e: e) :> ""
            .Paren(e: e) :> ""
            .Braced(b: b) :> ""
        }
    }

    fn boundAttr(c: LC, a: AAttr) -> Attr[] {
        const e: Expr | not = lowerValue(c, a.value)
        if (e is not) return []
        return [Attr.Bound(a.name, e)]
    }

    // A handler value is one statement (`f()`, `(@x = …)`) or a braced block.
    fn handlerBlock(c: LC, v: AAttrValue) -> Block {
        return match v {
            .Bare(e: e) :> block(exprStmt(c, e))
            .Paren(e: e) :> block(exprStmt(c, e))
            .Braced(b: b) :> lowerBlock(c, b)
            .Quoted(v: s) :> block([])
            .NoValue :> block([])
        }
    }

    // L6 / O60: a use's attributes are construction values, IN FIELD-INDEX ORDER
    // (canonical — the Core of a use does not depend on how its attributes were
    // ordered in the source; review INFO).
    fn constructAttrs(c: LC, attrs: AAttr[]) -> ConstructAttr[] {
        const raw: ConstructAttr[] = sourceConstructAttrs(c, attrs)
        let out: ConstructAttr[] = []
        let idx = 0
        let remaining: int = raw.length
        while (remaining > 0) {
            for (const a of raw) {
                if (a.field == idx) {
                    out = out.concat([a])
                    remaining = remaining - 1
                }
            }
            idx = idx + 1
        }
        return out
    }

    fn sourceConstructAttrs(c: LC, attrs: AAttr[]) -> ConstructAttr[] {
        let out: ConstructAttr[] = []
        for (const a of attrs) {
            const k: AttrKind | not = attrKind(c, a)
            if (k is some) {
                const idx: int = constructField(k)
                if (idx >= 0) {
                    const v: Expr | not = lowerValue(c, a.value)
                    if (v is some) out = out.concat([{ field: idx, value: v }])
                }
            }
        }
        return out
    }

    fn constructField(k: AttrKind) -> int {
        return match k {
            .AConstruct(field: i) :> i
            .AOn(event: ev) :> -1
            .AStatic :> -1
            .ABound :> -1
            .AIf :> -1
            .AShow :> -1
            .AAs :> -1
            .AEachIn :> -1
            .AEachKey :> -1
            .AEachAs :> -1
            .ABind(kind: k) :> -1
        }
    }

    // `<each in= key= as>` → View.Each (L9: no key → not; L16: the row binding
    // is a per-row local; handles are the row's, §66.7.4).
    fn eachView(c: LC, e: AElem, bind: Sym, hs: Sym[]) -> View {
        let src: Expr = missing()
        let key: Expr | not = not
        for (const a of e.attrs) {
            const k: AttrKind | not = attrKind(c, a)
            if (k is some) {
                const role: int = eachRole(k)
                if (role == 1) {
                    const s: Expr | not = lowerValue(c, a.value)
                    if (s is some) src = s
                }
                if (role == 2) key = lowerValue(c, a.value)
            }
        }
        return View.Each(src, bind, key, hs, lowerNodes(c, e.kids))
    }

    // 1 = in=, 2 = key=, 0 = anything else.
    fn eachRole(k: AttrKind) -> int {
        return match k {
            .AEachIn :> 1
            .AEachKey :> 2
            .AOn(event: ev) :> 0
            .AStatic :> 0
            .ABound :> 0
            .AIf :> 0
            .AShow :> 0
            .AConstruct(field: x) :> 0
            .AAs :> 0
            .AEachAs :> 0
            .ABind(kind: k) :> 0
        }
    }

    // =========================================================================
    // Declarations, types, functions — the linked program (L15).
    // =========================================================================
    fn lowerField(c: LC, f: FieldInfo) -> Field {
        return {
            sym: f.sym, ty: f.ty, init: lowerValue(c, f.init), mode: f.mode, role: f.role,
            grants: f.grants, graph: f.graph, exported: f.exported, wcap: f.wcap, vals: valCores(f.vals),
            persist: persistOf(c.t, f.sym),
        }
    }

    // s451 — the field's accepted `persist=` (§6.14; analyze persistPass).
    fn persistOf(t: Tables, s: Sym) -> Persist | not {
        for (const p of t.persists) {
            if (p.sym.id == s.id) return p.persist
        }
        return not
    }

    // s451 — §6.14.2 rule 9: a reset of a persisted field "SHALL **remove** the
    // cell's storage key instead of storing that value" — an Unpersist after
    // the reset's Write (and its ResetSurface).
    fn unpersistReset(t: Tables, di: DeclInfo, inst: InstRef, idx: int) -> Stmt[] {
        if (idx < 0 || idx >= di.fields.length) return []
        if (persistOf(t, di.fields[idx].sym) is not) return []
        return [Stmt.Unpersist(di.sym, inst, idx)]
    }

    // s449 — the field's validators as Core carries them (§55.1, declaration order).
    fn valCores(vs: ValInfo[]) -> Validator[] {
        let out: Validator[] = []
        for (const v of vs) { out = out.concat([v.core]) }
        return out
    }

    // The syntax of every declaration, by nid (user declarations: the ADecl; the
    // program: its body's markup).
    type DeclSyntax:struct = { nid: int, file: string, renders: ANode[], hasRenders: boolean }

    fn declSyntaxes(files: FileAst[]) -> DeclSyntax[] {
        let out: DeclSyntax[] = []
        for (const f of files) {
            for (const it of f.items) { out = out.concat(itemSyntax(f.path, it)) }
        }
        return out
    }

    fn itemSyntax(file: string, it: AItem) -> DeclSyntax[] {
        const k: AItemK = it.k
        return match k {
            .DeclItem(d: d) :> [userSyntax(file, d)]
            .ProgramItem(p: p) :> [{ nid: p.nid, file: file, renders: programMarkup(p.items), hasRenders: true }].concat(nestedSyntaxes(file, p.items))
            .ImportItem(i: i) :> []
            .TypeItem(t: t) :> []
            .FnItem(f: f) :> []
            .MarkupItem(n: n) :> []
        }
    }

    fn userSyntax(file: string, d: ADecl) -> DeclSyntax {
        const r: AElem | not = d.renders
        if (r is not) return { nid: d.nid, file: file, renders: [], hasRenders: false }
        const node: ANode = { nid: -1, span: r.span, k: ANodeK.Elem(r) }
        return { nid: d.nid, file: file, renders: [node], hasRenders: true }
    }

    // s442: the declarations written inside `<program>` (a nested user
    // declaration's renders is its own; a program cell's is none — syntaxOf
    // is keyed by the declaration's nid, so a cell's entry is never asked for).
    fn nestedSyntaxes(file: string, items: AItem[]) -> DeclSyntax[] {
        let out: DeclSyntax[] = []
        for (const it of items) {
            const k: AItemK = it.k
            out = out.concat(nestedDeclSyntax(file, k))
        }
        return out
    }

    fn nestedDeclSyntax(file: string, k: AItemK) -> DeclSyntax[] {
        return match k {
            .DeclItem(d: d) :> [userSyntax(file, d)]
            .MarkupItem(n: n) :> []
            .ImportItem(i: i) :> []
            .TypeItem(t: t) :> []
            .FnItem(f: f) :> []
            .ProgramItem(p: p) :> []
        }
    }

    fn programMarkup(items: AItem[]) -> ANode[] {
        let out: ANode[] = []
        for (const it of items) {
            const k: AItemK = it.k
            out = out.concat(markupItemNode(k))
        }
        return out
    }

    fn markupItemNode(k: AItemK) -> ANode[] {
        return match k {
            .MarkupItem(n: n) :> [n]
            .ImportItem(i: i) :> []
            .TypeItem(t: t) :> []
            .FnItem(f: f) :> []
            .DeclItem(d: d) :> []
            .ProgramItem(p: p) :> []
        }
    }

    fn syntaxOf(ss: DeclSyntax[], nid: int) -> DeclSyntax | not {
        for (const s of ss) {
            if (s.nid == nid) return s
        }
        return not
    }

    // The element node of a renders: the renders AElem was wrapped in a node
    // with nid -1 (it has no ANode of its own), so its FACT is on the AElem.
    fn lowerRenders(c: LC, s: DeclSyntax) -> View[] | not {
        if (!s.hasRenders) return not
        return lowerNodes(c, s.renders)
    }

    fn lowerDecl(t: Tables, ss: DeclSyntax[], d: DeclInfo) -> Decl {
        const c: LC = { t: t, file: d.file, subst: not, snap: not }
        let fields: Field[] = []
        for (const f of d.fields) { fields = fields.concat([lowerField(c, f)]) }
        let renders: View[] | not = not
        const s: DeclSyntax | not = syntaxOf(ss, d.nid)
        if (s is some) renders = lowerRenders(c, s)
        // s449: the program cells' `reset-on=` rules are registered with the
        // program's scope, ahead of its markup (§6.8.4)
        if (isProgramKind(d.kind)) {
            const rv: View[] | not = renders
            if (rv is some) renders = resetOnViews(c, d).concat(rv)
        }
        const wiring: WiringAttr[] = []
        return { sym: d.sym, kind: d.kind, single: d.single, fields: fields, renders: renders, wiring: wiring, handles: d.handles }
    }

    type FnSyntax:struct = { nid: int, f: AFn }

    fn fnSyntaxes(files: FileAst[]) -> FnSyntax[] {
        let out: FnSyntax[] = []
        for (const f of files) {
            for (const af of fnsIn(f.items)) { out = out.concat([{ nid: af.nid, f: af }]) }
        }
        return out
    }

    fn fnsIn(items: AItem[]) -> AFn[] {
        let out: AFn[] = []
        for (const it of items) {
            const k: AItemK = it.k
            out = out.concat(fnOfItem(k))
        }
        return out
    }

    fn fnOfItem(k: AItemK) -> AFn[] {
        return match k {
            .FnItem(f: f) :> [f]
            .ProgramItem(p: p) :> fnsIn(p.items)
            .ImportItem(i: i) :> []
            .TypeItem(t: t) :> []
            .DeclItem(d: d) :> []
            .MarkupItem(n: n) :> []
        }
    }

    fn paramOf(f: BindFact | not) -> Param[] {
        return match f {
            .BParam(sym: s, ty: ty) :> [{ sym: s, ty: ty }]
            .BBind(sym: s) :> []
            .BGiven(sym: s) :> []
            not :> []
        }
    }
    fn lowerFn(t: Tables, fs: FnSyntax[], info: FnInfo) -> Fn | not {
        for (const s of fs) {
            if (s.nid == info.nid) {
                const c: LC = { t: t, file: info.file, subst: not, snap: not }
                let params: Param[] = []
                for (const p of s.f.params) { params = params.concat(paramOf(bindFact(t.binds, p.nid))) }
                return { sym: info.sym, params: params, body: lowerBlock(c, s.f.body), pure: info.pure }
            }
        }
        return not
    }

    // s451 — §65.3.4: "Opt out via `<program reset=\"none\">` — drops the whole
    // `reset` layer." analyze accepts `reset="none"` and refuses any other value,
    // so here the program's opener has either no `reset=` or exactly that one.
    fn resetShips(files: FileAst[], t: Tables) -> boolean {
        let nid = -1
        for (const d of t.decls) { if (d.sym.id == t.program.id) nid = d.nid }
        for (const f of files) {
            for (const it of f.items) {
                const k: AItemK = it.k
                const p: AProgram | not = match k {
                    .ProgramItem(p: p) :> p
                    .DeclItem(d: d) :> not
                    .ImportItem(i: i) :> not
                    .TypeItem(t: tx) :> not
                    .FnItem(f: fx) :> not
                    .MarkupItem(n: n) :> not
                }
                if (p is some && p.nid == nid) {
                    for (const a of p.attrs) { if (a.name == "reset") return false }
                }
            }
        }
        return true
    }

    export fn lower(tp: TypedProgram) -> Lowered {
        if (hasError(tp)) return { core: not, diags: tp.diags }   // s451: the diagnostics gate
        const t: Tables = tp.tables
        const ss: DeclSyntax[] = declSyntaxes(tp.files)
        let decls: Decl[] = []
        for (const d of t.decls) { decls = decls.concat([lowerDecl(t, ss, d)]) }
        let types: TypeDef[] = []
        for (const ti of t.types) { types = types.concat([ti.def]) }
        const fsx: FnSyntax[] = fnSyntaxes(tp.files)
        let fns: Fn[] = []
        for (const info of t.fns) {
            const f: Fn | not = lowerFn(t, fsx, info)
            if (f is some) fns = fns.concat([f])
        }
        const reset: boolean = resetShips(tp.files, t)
        const pre: CoreProgram = { program: t.program, decls: decls, types: types, fns: fns, server: [], reset: reset }
        const core: CoreProgram = { program: t.program, decls: gateDecls(pre), types: types, fns: fns, server: [], reset: reset }
        return { core: core, diags: tp.diags }
    }

    // =========================================================================
    // s449 — THE GATE'S STATIC REACH (§55.17.3). "Mark `touched = true` on
    // every bound validated value of the form — every value that carries
    // validators … whose `bind:` is on a native control inside the form (the
    // §55.17.2 rule 1 composed subtree)". The composed subtree is STATIC: a
    // value bound in an `if=` region or a state-view arm gates the submit
    // whether or not that region is mounted (a multi-step form submitted at
    // step 2 is blocked by an empty step-1 field). Once the whole program is
    // lowered, each form's Gate is given the fields its subtree NAMES — its own
    // markup, Cond arms, slot content written in it, and `<*x/>` Stars (whose
    // renders' `.Lexical(0)` is the Star's instance). An `<each>` row, a use's
    // instance and a slot's filler instance are not nameable here; the runtime
    // finds them on the live form (runtime.gate).
    // =========================================================================
    fn gateDecls(p: CoreProgram) -> Decl[] {
        let out: Decl[] = []
        for (const d of p.decls) {
            const rs: View[] | not = d.renders
            if (rs is some) {
                out = out.concat([{ sym: d.sym, kind: d.kind, single: d.single, fields: d.fields, renders: gateViews(p, rs),
                                    wiring: d.wiring, handles: d.handles }])
            } else {
                out = out.concat([d])
            }
        }
        return out
    }

    fn gateViews(p: CoreProgram, vs: View[]) -> View[] {
        let out: View[] = []
        for (const v of vs) { out = out.concat([gateView(p, v)]) }
        return out
    }

    fn gateView(p: CoreProgram, v: View) -> View {
        return match v {
            .El(tag: tag, attrs: attrs, kids: ks) :> View.El(tag, gateAttrs(p, attrs, ks), gateViews(p, ks))
            .Cond(arms: arms) :> View.Cond(gateArms(p, arms))
            .Each(src: s, bind: b, key: k, handles: hs, row: row) :> View.Each(s, b, k, hs, gateViews(p, row))
            .Instance(decl: d, attrs: a, slot: sl, alias: al) :> View.Instance(d, a, gateViews(p, sl), al)
            .Text(text: x) :> v
            .Dyn(e: x) :> v
            .Slot :> v
            .Star(decl: x) :> v
            .Effect(deps: x) :> v
            .ResetOn(triggers: x) :> v
            .Errors(of: x) :> v
        }
    }

    fn gateArms(p: CoreProgram, arms: CondArm[]) -> CondArm[] {
        let out: CondArm[] = []
        for (const a of arms) { out = out.concat([{ test: a.test, body: gateViews(p, a.body) }]) }
        return out
    }

    fn gateAttrs(p: CoreProgram, attrs: Attr[], ks: View[]) -> Attr[] {
        let out: Attr[] = []
        for (const a of attrs) { out = out.concat([gateAttr(p, a, ks)]) }
        return out
    }

    fn gateAttr(p: CoreProgram, a: Attr, ks: View[]) -> Attr {
        return match a {
            .Gate(values: vs) :> Attr.Gate(vs, namedFields(p, ks, not, []))
            .Static(name: x) :> a
            .Bound(name: x) :> a
            .Show(test: x) :> a
            .On(event: x) :> a
            .Bind(kind: x) :> a
        }
    }

    // The bound surfaced fields `vs` names, each once, in document order.
    // `subst`: inside a Star's renders, the Star's instance (what `.Lexical(0)`
    // means there); `seen`: the declarations being expanded (a renders may
    // reach itself through a Star).
    fn namedFields(p: CoreProgram, vs: View[], subst: InstRef | not, seen: int[]) -> ValidityOf[] {
        let out: ValidityOf[] = []
        for (const v of vs) { out = addFields(out, viewFields(p, v, subst, seen)) }
        return out
    }

    fn addFields(xs: ValidityOf[], ys: ValidityOf[]) -> ValidityOf[] {
        let out: ValidityOf[] = xs
        for (const y of ys) {
            let dup = false
            for (const x of out) {
                if (fieldKey(x) == fieldKey(y)) dup = true
            }
            if (!dup) out = out.concat([y])
        }
        return out
    }

    fn fieldKey(v: ValidityOf) -> string {
        return match v {
            .OfField(decl: d, inst: i, idx: x) :> d.id + "/" + instKey(i) + "/" + x
            .OfDecl(decl: d, inst: i) :> d.id + "/" + instKey(i)
        }
    }

    fn viewFields(p: CoreProgram, v: View, subst: InstRef | not, seen: int[]) -> ValidityOf[] {
        return match v {
            .El(attrs: attrs, kids: ks) :> addFields(attrFields(p, attrs, subst), namedFields(p, ks, subst, seen))
            .Cond(arms: arms) :> armFields(p, arms, subst, seen)
            .Instance(slot: sl) :> namedFields(p, sl, subst, seen)
            .Star(decl: d, inst: i) :> starFields(p, d, i, subst, seen)
            .Each(src: x) :> []
            .Text(text: x) :> []
            .Dyn(e: x) :> []
            .Slot :> []
            .Effect(deps: x) :> []
            .ResetOn(triggers: x) :> []
            .Errors(of: x) :> []
        }
    }

    fn armFields(p: CoreProgram, arms: CondArm[], subst: InstRef | not, seen: int[]) -> ValidityOf[] {
        let out: ValidityOf[] = []
        for (const a of arms) { out = addFields(out, namedFields(p, a.body, subst, seen)) }
        return out
    }

    fn starFields(p: CoreProgram, d: Sym, i: InstRef, subst: InstRef | not, seen: int[]) -> ValidityOf[] {
        if (seen.indexOf(d.id) >= 0) return []
        const inner: InstRef | not = nameable(i, subst)
        if (inner is not) return []
        for (const x of p.decls) {
            if (x.sym.id == d.id) {
                const rs: View[] | not = x.renders
                if (rs is some) return namedFields(p, rs, inner, seen.concat([d.id]))
            }
        }
        return []
    }

    fn attrFields(p: CoreProgram, attrs: Attr[], subst: InstRef | not) -> ValidityOf[] {
        let out: ValidityOf[] = []
        for (const a of attrs) { out = addFields(out, bindField(p, a, subst)) }
        return out
    }

    fn bindField(p: CoreProgram, a: Attr, subst: InstRef | not) -> ValidityOf[] {
        return match a {
            .Bind(read: r) :> bindReadField(p, r, subst)
            .Static(name: x) :> []
            .Bound(name: x) :> []
            .Show(test: x) :> []
            .On(event: x) :> []
            .Gate(values: x) :> []
        }
    }

    fn bindReadField(p: CoreProgram, r: Expr, subst: InstRef | not) -> ValidityOf[] {
        return match r {
            .Read(place: pl) :> placeField(p, pl, subst)
            .Lit(lit: x) :> []
            .Local(sym: x) :> []
            .Call(callee: x) :> []
            .Prim(op: x) :> []
            .Match(scrut: x) :> []
            .ArrayOf(elems: x) :> []
            .StructOf(ty: x) :> []
            .Handle(inst: x) :> []
            .InitOf(decl: x) :> []
            .Host(call: x) :> []
            .Lambda(params: x) :> []
            .SeqCall(op: x) :> []
            .Validity(of: x) :> []
        }
    }

    // A bind of a field's WHOLE value, when the field has a surface (every
    // field of a user declaration; a top-level value only with validators).
    fn placeField(p: CoreProgram, pl: Place, subst: InstRef | not) -> ValidityOf[] {
        return match pl {
            .Cell(decl: d, inst: i, path: path) :> cellField(p, d, i, path, subst)
            .LocalPath(sym: x) :> []
        }
    }

    fn cellField(p: CoreProgram, d: Sym, i: InstRef, path: FieldRef[], subst: InstRef | not) -> ValidityOf[] {
        if (path.length != 1) return []
        const inst: InstRef | not = nameable(i, subst)
        if (inst is not) return []
        for (const x of p.decls) {
            if (x.sym.id == d.id) {
                const idx: int = path[0].idx
                if (idx < 0 || idx >= x.fields.length) return []
                if (isProgramKind(x.kind) && x.fields[idx].vals.length == 0) return []
                return [ValidityOf.OfField(d, inst, idx)]
            }
        }
        return []
    }

    // An instance reference the form's render can evaluate at submit: a
    // shared instance, or the enclosing instance. An `as=` handle or a
    // `given` local may name no instance by then — those binds are found on
    // the live form instead. Inside a Star's renders, `.Lexical(0)` is the
    // Star's own instance (`subst`).
    fn nameable(i: InstRef, subst: InstRef | not) -> InstRef | not {
        return match i {
            .Shared(decl: d) :> i
            .Lexical(depth: k) :> lexicalThrough(k, i, subst)
            .Alias(sym: s) :> not
            .Narrowed(sym: s) :> not
        }
    }

    fn lexicalThrough(k: int, i: InstRef, subst: InstRef | not) -> InstRef | not {
        if (subst is not) return i
        if (k == 0) return subst
        return not
    }
}
