<program>
    type Pt:struct = { x: int, y: number, label: string, on: boolean }
    type Color:enum = { Red, Green, Blue }
    type Box:struct = { p: Pt | not, ps: Pt[], color: Color, note: string | not }
    type Node:struct = { v: int, kids: Node[], next: Node | not }
    type Shape:enum = { Circle(r: number), Square }
    type Holder:struct = { s: Shape }
    type Res:enum = { Done, Conflict(current: int, note: string | not), Moved(to: Pt, via: Shape[]), Wrapped(inner: Shape | not, tint: Color) }
    let <n:int=0/>
    <main><p>${@n}</p></main>
</program>
