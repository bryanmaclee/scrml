// test-006-test-sql.scrml
// Testing SQL queries. Tests: ~{} alongside db state.

< db src="test.db" tables="items">
    ${
        server function getItems() {
            return ?{`SELECT * FROM items`} !{ _ :> [] }
        }
    }
</>

~{ "sql queries"
    test "getItems exists" { assert true }
}
