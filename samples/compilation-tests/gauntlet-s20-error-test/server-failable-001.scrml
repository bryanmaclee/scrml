// Phase 7: server + ! modifiers coexist (§19.4.4)
// Should compile clean.

< db src="./test.db" tables="users">
${
  type UserError:enum = { NotFound, Forbidden }

  server function getUser(id)! -> UserError {
    let user = ?{`SELECT id, name FROM users WHERE id = ${id}`}.get()
    if user is not {
      fail UserError.NotFound
    }
    return user
  }

  // §19.4.3 — the handler must handle getUser's failure (E-ERROR-002 in
  // every handler form, S440); a non-failable wrapper catches it with !{}.
  function load() {
    getUser(1) !{
      | .NotFound :> @status = "not found"
      | .Forbidden :> @status = "forbidden"
    }
  }

  <status> = ""
}
<div>
  <button onclick=load()>Load</>
  <p>${@status}</>
</div>
</>
