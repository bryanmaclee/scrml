// presence test, single var — `if (x is given) { body }` (was the S462-deprecated `given x => { body }`; migrated by `scrml fix`)
${
    let name: string | not = "alice"
    if (name is given) {
        let upper = name.toUpperCase()
        log(upper)
    }
    function log(s: string) { let _ = s }
}
<program>
    <p>ok</>
</>
