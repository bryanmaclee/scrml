// 02a-derived.scrml — derived state recomputes whenever its inputs change.

<program>

  let <count:int=0/>
  <doubled:int=(@count * 2)/>
  <parity:string=(@count % 2 == 0 ? "even" : "odd")/>

  function inc() { @count = @count + 1; }

  <div>
    <p>Count: ${@count}</p>
    <p>Doubled: ${@doubled}</p>
    <p>Parity: ${@parity}</p>
    <button onclick=inc()>+</button>
  </div>

</program>
