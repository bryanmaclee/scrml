${
    <a> : number = 0
    <seen> : string = ""
    server fn one(n: number) : number {
        return n + 1
    }
    server fn two(n: number) : number {
        return n * 10
    }
    function readA() {
        return @a
    }
    function go() {
        @a = one(1)
        const x = two(readA())
        @seen = "a=" + @a + " x=" + x
    }
}
<button id="b" onclick=go()>b</>
<p id="s">${@seen}</>
