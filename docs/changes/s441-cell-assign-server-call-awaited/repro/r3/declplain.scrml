${
    <a> : number = 0
    const <dbl> = @a * 2
    <seen> : string = ""
    server fn one(n: number) : number {
        return n + 1
    }
    server fn two(n: number) : number {
        return n * 10
    }
    function go() {
        @a = one(1)
        const y = @dbl
        @seen = "a=" + @a + " y=" + y
    }
}
<button id="b" onclick=go()>b</>
<p id="s">${@seen}</>
