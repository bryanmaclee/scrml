${
    <out> : number = 0
    <seen> : number = -1
    <final> : number = -1
    server fn double(n: number) : number {
        return n * 2
    }
    function go() {
        @out = double(21)
        @seen = @out
    }
    function seq() {
        @out = double(1)
        @out = double(2)
        @out = @out + 100
        @final = @out
    }
}
<button id="go" onclick=go()>Go</>
<button id="seq" onclick=seq()>Seq</>
<p id="seen">${@seen}</>
<p id="final">${@final}</>
