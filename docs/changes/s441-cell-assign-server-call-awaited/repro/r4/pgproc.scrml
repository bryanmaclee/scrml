<program db="postgres://u:p@localhost:5432/app">
${
    <orderId> : number = 0
    <count> : number = 0
    server function placeOrder(qty: number) {
        const r = ?{`SELECT place_order(${qty}) AS id`}.get()
        return r.id
    }
    server function orderCount() {
        const r = ?{`SELECT count(*) AS c FROM orders`}.get()
        return r.c
    }
    function go() {
        @orderId = placeOrder(5)
        @count = orderCount()
    }
}
<button id="b" onclick=go()>b</>
<p id="s">${@orderId} ${@count}</>
</program>
