<program db="d.db">
<schema>
    items { id: integer primary key
            qty: integer }
</>
<n> = 1
function qtyOf(id) { return ?{`SELECT qty FROM items WHERE id = ${id}`}.get() }
const <d> = qtyOf(@n)
<p>${@d}</p>
</program>
