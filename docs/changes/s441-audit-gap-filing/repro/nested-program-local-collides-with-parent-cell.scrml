// S441 reproducer — addendum item 25: a `let` local inside a nested worker <program> is rejected because a
// PARENT <program> declares a state cell with the same name.
// Compiler SHA: cf62b4154 (origin/main at dispatch)
// Command: bun compiler/bin/scrml.js compile docs/changes/s441-audit-gap-filing/repro/nested-program-local-collides-with-parent-cell.scrml --output-dir <scratch>
// Expected: compiles. §4.12.1 "No lexical binding, reactive variable, or type declaration from the parent
//           `<program>` SHALL be accessible inside a nested `<program>`"; §43.3 shared-nothing. The parent's
//           cell is not in the worker's scope, so it cannot be shadowed there.
// Actual:   exit 1, `error [E-NAME-COLLIDES-STATE]: local `let total` shadows registered state cell `<total>` …
//           (V5-strict, SPEC §6.1.3)` (twice: the declaration and the write), stage SYM.
<program>
    <program name="stats">
        ${
            function sumOfSquares(n: number) -> number {
                let total = 0
                for (let i = 1; i <= n; i++) {
                    total = total + i * i
                }
                return total
            }
            when message(data) {
                send({ total: sumOfSquares(data.n) })
            }
        }
    </>
    <total> = 0
    <p>${@total}</p>
</program>
