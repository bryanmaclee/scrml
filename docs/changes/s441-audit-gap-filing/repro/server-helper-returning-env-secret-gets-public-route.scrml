// S441 reproducer — addendum item 22 (SECURITY, ruling-gated): a server-escalated helper whose return value holds
// a `process.env` secret, called from a CLIENT-placed function, gets a public route and the secret object is
// shipped to the browser.
// Compiler SHA: cf62b4154 (origin/main at dispatch)
// Command: bun compiler/bin/scrml.js compile docs/changes/s441-audit-gap-filing/repro/server-helper-returning-env-secret-gets-public-route.scrml --output-dir <scratch>
// Expected: RULING-GATED. §12.5 "Server-escalated functions MAY return values to the client"; §12.2 Trigger 5
//           escalates by inheritance only when ALL callers are server-classified. The impl follows that text;
//           the question is placement (min-cut) and/or an egress rule for env-derived values.
// Actual:   exit 0, zero diagnostics. server.js: route `/_scrml/__ri_route_<helper>_1` whose handler returns
//           `{apiKey: process.env.API_SECRET}`; client.js: `return (await _scrml_fetch_<helper>_4()).apiKey.length;`.
//           EXECUTED as an outside caller (own double-submit cookie + matching X-CSRF-Token header, body `{}`):
//           HTTP 200 `{"apiKey":"sk-live-TOPSECRET"}`.
<program>
function secretConfig() {
    return { apiKey: process.env.API_SECRET }
}
function keyLength() {
    return secretConfig().apiKey.length
}
<n> = 0
function check() { @n = keyLength() }
<button onclick=check()>Check</button>
<p>${@n}</p>
</program>
