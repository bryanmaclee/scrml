<program title="d1">
<count> = 0
<msg> = ""
<items> = [1, 2, 3]
type Phase:enum = { Idle, Busy }
<phase>: Phase = .Idle

function track(name) { @msg = name }

<button onclick={ @count = @count + 1; @msg = "hi" }>one-line</button>
<button onclick={
    const next = @count + 1
    @count = next
    if (next > 2) { @msg = "big" }
}>multi-line</button>
<button onclick={ track("a"); track("b") }>calls</button>
<each in=@items as item>
    <button onclick={ @count = item; @msg = "row" }>row</button>
</each>
<match on=@phase>
    <Idle><button onclick={ @phase = .Busy; @msg = "go" }>arm</button></>
    <Busy><p>busy</p></>
</match>
<p>${@count} ${@msg}</p>
</program>
