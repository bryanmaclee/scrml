<program>
<out> = 0
server function double(n) { return n * 2 }
server function isOk(n) { return n > 100 }
function go() {
  function inner(x) { return isOk(x) } const any = [1, 2, 3].some(x => inner(x)); console.log("client some via local helper (expect false)", any)
}
<p>${@out}</p>
<button onclick=go()>go</button>
</program>
