>     fn seqFixed(t: Type) -> boolean {
>         return match t {
>             .Seq(elem: el, grants: g) :> isFixedLength(g.length)
>             .Int :> false
>             .Num :> false
>             .Str :> false
>             .Bool :> false
>             .Named(sym: x) :> false
>             .Maybe(inner: i) :> false
>         }
>     }
