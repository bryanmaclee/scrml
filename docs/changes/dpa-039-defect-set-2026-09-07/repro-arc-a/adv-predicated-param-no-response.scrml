<program db="./app.db">
  <schema>
    ?{`CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, passwordHash TEXT)`}
  </schema>
  <db src="app.db" protect="passwordHash" tables="users">
    ${
      server function bump(n: int(>0)) {
        let r = ?{`SELECT id, name FROM users WHERE id = ${n}`}.get()
        return r
      }
    }
  </db>
  <button onclick=${ bump(1) }>go</button>
</program>
