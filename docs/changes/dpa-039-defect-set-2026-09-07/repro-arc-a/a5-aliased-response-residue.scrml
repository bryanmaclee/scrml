<program db="./app.db">
  <schema>
    ?{`CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, passwordHash TEXT)`}
  </schema>
  <db src="app.db" protect="passwordHash" tables="users">
    ${
      function getUser(id) {
        let u = ?{`SELECT * FROM users WHERE id = ${id}`}.get()
        let R = Response
        return new R(JSON.stringify(u), { status: 200, headers: { "Content-Type": "application/json" } })
      }
    }
  </db>
  <div><p>hi</p></div>
</program>
