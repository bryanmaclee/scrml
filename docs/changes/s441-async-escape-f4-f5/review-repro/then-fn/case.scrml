<program>
<verdict> = "unset"
server function isOk(n) { return n > 100 }
function refresh() { @verdict = isOk(1) ? "accepted" : "rejected" }
function go() { isOk(1).then((ok) => { @verdict = ok ? "accepted" : "rejected" }) }
<button id="go" onclick=go()>go</button>
<p id="out">${@verdict}</p>
</program>
