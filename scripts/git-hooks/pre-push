#!/bin/bash
# scrml pre-push hook — test suite (unit+integration+conformance) + gauntlet quick check
#                       + generated-doc currency + release-tag snippet gate
#
# Source-controlled baseline. Install via `bash scripts/git-hooks/install.sh`
# from the repo root.
#
# Snippet gate (S101, re-pointed S280): runs `scripts/snippet-gate.js` ONLY when the
# push payload contains a release-tag ref (`refs/tags/v*`). Regular pushes
# skip it (CI `gate` runs snippet-gate on every push). Rationale: public code
# samples are the community-facing reference for scrml; release-tag pushes are
# the cut points where accuracy must be verified.

set -e

# Read pre-push stdin protocol: one line per ref being pushed:
#   <local-ref> <local-sha> <remote-ref> <remote-sha>
# Detect any release-tag push (refs/tags/v*) in the payload.
PUSHING_RELEASE_TAG=0
PUSHED_REFS=""
HAS_UPDATE=0
# S301: implement the S254 relaxation this hook already DOCUMENTED at step 2.5 but never
# applied at step 1 — a NEW-REF (feature-branch) push defers the suite to the cloud `gate`
# on the PR, which is the authoritative full run under PR-flow. An update to an EXISTING
# remote ref (incl. a forced push) and any release tag still run it locally.
RUN_SUITE=0
while read local_ref local_sha remote_ref remote_sha; do
  PUSHED_REFS="$PUSHED_REFS $local_ref"
  # S292: a non-deletion ref means there is something to currency-check.
  if [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then HAS_UPDATE=1; fi
  # A zero remote_sha is a ref that does not exist upstream yet = NEW REF.
  if [ "$local_sha" != "0000000000000000000000000000000000000000" ] \
     && [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
    RUN_SUITE=1
  fi
  case "$local_ref" in
    refs/tags/v*)
      PUSHING_RELEASE_TAG=1
      RUN_SUITE=1
      ;;
  esac
done

echo "=== scrml pre-push: full validation ==="

# 0. Refresh browser-test fixtures — the browser suite (part of the full run below)
#    readFileSync's PRE-COMPILED samples from samples/compilation-tests/dist/. A stale or
#    absent dist grades the current runtime against old codegen → phantom browser failures
#    (S250 2026-07-11: stale Jul-8 fixtures faked ~9 fails vs the current runtime). Compile-all
#    returns non-zero on the intentional error-fixtures, so `|| true` (the real gate is the run).
echo "--- Refreshing browser-test fixtures (samples/compilation-tests/) ---"
bun run compiler/src/cli.js compile samples/compilation-tests/ >/dev/null 2>&1 || true

# 1. Test suite
#
#    SCOPE (S301) — unit + integration + conformance, i.e. the SAME subset the pre-commit
#    hook and the cloud `gate` (unit+conformance+gauntlet) run. It is NOT the whole of
#    compiler/tests/, and that is deliberate:
#
#      browser / lsp / self-host / commands carry a DOCUMENTED FAILURE BASELINE (~42 at
#      2026-07-30) that is assessed by comparing failure-NAME SETS, not counts. An
#      exit-code gate cannot express "the same names as before", so pointing this step at
#      the full tree made it structurally unpassable — every push blocked, on every clone,
#      for a baseline no change caused. That is the pa-base §8 cry-wolf shape, and a gate
#      that cannot pass is bypassed and then deleted. The overlay already names these four
#      tiers as the pre-commit exclusion set; this aligns pre-push with it.
#
#    Verified at S301: this subset is 21597 pass / 0 fail on a clean checkout, so the gate
#    CAN go red for a real regression and green otherwise — which is the whole point.
#
#    S313 UPDATE — the premise above ("an exit-code gate cannot express 'the same names as
#    before'") is now only half true. `bun scripts/browser-baseline.ts --check` expresses
#    exactly that for the BROWSER tier: it exits 0 while the failure NAME SET is unchanged
#    and 1 the moment a name joins or leaves it, so the tier is assertable without being
#    structurally unpassable. It runs in CI `tracking` today. Adding it HERE, or requiring
#    it in the blocking `gate`, is a deliberate promotion decision and is bryan's to make —
#    NOT taken unilaterally, because promoting a whole always-red job is the cry-wolf
#    retrofit S302 explicitly ruled out. lsp / commands / self-host still have no name-set
#    assertion; extending the same shape to them is mechanical once this is proven in anger.
if [ "$RUN_SUITE" = "1" ]; then
echo "--- Running test suite (unit + integration + conformance) ---"
# `set -e` is active: a bare `VAR=$(failing-cmd)` aborts the script HERE, before any of the
# reporting below runs. That is exactly what happened at S301 — a blocked push printed only
# "--- Running full test suite ---" and exited 1, with the diagnostic on lines below it dead
# code. `|| EXIT_CODE=$?` keeps the assignment from tripping set -e so the hook can say why.
EXIT_CODE=0
TEST_OUTPUT=$(bun test compiler/tests/unit compiler/tests/integration compiler/tests/conformance 2>&1) || EXIT_CODE=$?

PASS_COUNT=$(echo "$TEST_OUTPUT" | grep -oP '\d+ pass' | head -1)
FAIL_COUNT=$(echo "$TEST_OUTPUT" | grep -oP '\d+ fail' | head -1)
SKIP_COUNT=$(echo "$TEST_OUTPUT" | grep -oP '\d+ skip' | head -1)
echo "Tests: $PASS_COUNT, $FAIL_COUNT, $SKIP_COUNT"

if [ "$EXIT_CODE" -ne 0 ]; then
    echo ""
    echo "❌ Tests failed — push blocked."
    echo "$TEST_OUTPUT" | grep "^(fail)" | head -20
    exit 1
fi
else
echo "--- test suite SKIPPED (new-ref push; cloud \`gate\` on the PR is authority — S254) ---"
fi

# 2. Gauntlet quick check (TodoMVC) — every push
echo ""
echo "--- Gauntlet quick check (TodoMVC) ---"
if [ -f benchmarks/todomvc/app.scrml ]; then
    bun run compiler/src/cli.js compile benchmarks/todomvc/app.scrml --convert-legacy-css 2>/dev/null
    if [ -f benchmarks/todomvc/dist/app.client.js ]; then
        if node --check benchmarks/todomvc/dist/app.client.js 2>/dev/null; then
            echo "TodoMVC JS: PASS"
        else
            echo "⚠ TodoMVC JS: FAIL (node --check)"
            echo "❌ Push blocked — gauntlet check failed."
            exit 1
        fi
    fi
fi

# 2.5 GENERATED-DOC CURRENCY (S292) — mirror the cloud `gate`'s CHEAP currency checks
#     so a stale generated artifact is caught HERE instead of ~3 minutes later in CI.
#
#     WHY THIS EXISTS: at S292 the FACTS gate rejected three separate pushes in ONE
#     session, every time for the same reason — regenerate, then edit compiler/src or
#     SPEC.md again, then push. Nothing local refused the push, so the loop was always
#     push -> wait for CI -> red -> regen -> push again. That is a MISSING GATE, not a
#     memory failure. (bryan authorized this hook change at S292.)
#
#     SCOPE IS DELIBERATE — only the checks that are actually cheap. Measured here:
#         bun scripts/facts.ts --check              200ms
#         bun run scripts/regen-spec-index.ts --check 61ms
#         bun scripts/snippet-gate.js            48,000ms   <-- NOT here, stays CI-only
#     A hook that costs 48s per push gets bypassed, and a bypassed gate gets deleted
#     (pa-base SS8, the cry-wolf failure mode). 261ms does not get bypassed.
#
#     Runs on EVERY push — including the feature-branch pushes the S254 relaxation
#     exempts from the full suite, which are exactly the ones that were failing.
#     Skipped when the payload is deletions only (nothing to check).
if [ "$HAS_UPDATE" = "1" ]; then
  echo ""
  echo "--- generated-doc currency (mirrors the cloud gate; ~0.3s) ---"
  CURRENCY_FAILED=0
  if ! bun scripts/facts.ts --check; then CURRENCY_FAILED=1; fi
  if ! bun run scripts/regen-spec-index.ts --check >/dev/null 2>&1; then
    echo "  STALE  SPEC-INDEX totals (compiler/SPEC-INDEX.md)"
    CURRENCY_FAILED=1
  fi
  if [ "$CURRENCY_FAILED" = "1" ]; then
    echo ""
    echo "X Generated docs are stale — push blocked (the cloud gate would reject this)."
    echo "   Fix:  bun scripts/facts.ts --write && bun run scripts/regen-spec-index.ts"
    echo "   Then amend or add a commit with the regenerated file(s)."
    echo "   NOTE: regenerate AFTER your last content commit, not before it — regenerating"
    echo "         early and then editing compiler/src again is what this gate exists to catch."
    exit 1
  fi
fi

# 3. Public snippet gate (ONLY on release-tag pushes — S101, re-pointed S280)
#    Supersedes the S101 README fence gate: public code samples are now REAL
#    .scrml files under the snippet corpus, and README's blocks are excerpts of
#    them. `scripts/snippet-gate.js` also runs in CI `gate` on every push; this
#    is the release-tag second net.
if [ "$PUSHING_RELEASE_TAG" = "1" ]; then
    echo ""
    echo "--- public snippet gate (release-tag push detected) ---"
    if bun run scripts/snippet-gate.js; then
        :
    else
        echo ""
        echo "❌ Snippet gate failed — release-tag push blocked."
        echo "   A public document cites each corpus file; fix the snippet,"
        echo "   or fix the document if the feature genuinely changed."
        exit 1
    fi
fi

echo ""
echo "✓ All checks passed — pushing."
